[
  {
    "surah_id": 91,
    "ayah_number": 1,
    "global_ayah_id": 6044,
    "translation": "태양과 그 빛을 두고 맹세하사"
  },
  {
    "surah_id": 91,
    "ayah_number": 2,
    "global_ayah_id": 6045,
    "translation": "그 뒤를 이은 달을 두고 맹세하며"
  },
  {
    "surah_id": 91,
    "ayah_number": 3,
    "global_ayah_id": 6046,
    "translation": "태양의 영광을 보여주는 낮을두고 맹세하며"
  },
  {
    "surah_id": 91,
    "ayah_number": 4,
    "global_ayah_id": 6047,
    "translation": "그것을 숨기는 밤을 두고 맹 세하며"
  },
  {
    "surah_id": 91,
    "ayah_number": 5,
    "global_ayah_id": 6048,
    "translation": "하늘과 그것을 세운 주님을 두고 맹세하사"
  },
  {
    "surah_id": 91,
    "ayah_number": 6,
    "global_ayah_id": 6049,
    "translation": "대지와 그것을 펼쳐 놓으신 주님을 두고 맹세하며"
  },
  {
    "surah_id": 91,
    "ayah_number": 7,
    "global_ayah_id": 6050,
    "translation": "인간과 그것을 창조한 주님을두고 맹세하사"
  },
  {
    "surah_id": 91,
    "ayah_number": 8,
    "global_ayah_id": 6051,
    "translation": "선과 악이 무엇인가를 이해하 도록 하셨나니"
  },
  {
    "surah_id": 91,
    "ayah_number": 9,
    "global_ayah_id": 6052,
    "translation": "스스로를 순결하게 하는 자가 승리자이며"
  },
  {
    "surah_id": 91,
    "ayah_number": 10,
    "global_ayah_id": 6053,
    "translation": "스스로를 불결하게 하는 자 실패한 자라"
  },
  {
    "surah_id": 91,
    "ayah_number": 11,
    "global_ayah_id": 6054,
    "translation": "사무드 백성은 그들의 오만 으로 예언자를 거역하였으매"
  },
  {
    "surah_id": 91,
    "ayah_number": 12,
    "global_ayah_id": 6055,
    "translation": "그들 중 가장 사악한 자가 일어섰을 때"
  },
  {
    "surah_id": 91,
    "ayah_number": 13,
    "global_ayah_id": 6056,
    "translation": "선지자가 그들에게 말하길 그것은 하나님의 암낙타이니 그것 이 물을 마시매 방해하지 말라 하 였으나"
  },
  {
    "surah_id": 91,
    "ayah_number": 14,
    "global_ayah_id": 6057,
    "translation": "그들은 그를 거역한 후 그 암낙타를 살해하였으니 그 죄악으 로 인하여 주님은 그들을 멸망케 하사 구별없이 완전 멸망케 하셨 노라"
  },
  {
    "surah_id": 91,
    "ayah_number": 15,
    "global_ayah_id": 6058,
    "translation": "실로 그분은 그 결과에 대하여 조금도 염려하지 아니 하시니라"
  }
]