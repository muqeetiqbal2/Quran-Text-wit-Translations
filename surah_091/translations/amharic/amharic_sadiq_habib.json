[
  {
    "surah_id": 91,
    "ayah_number": 1,
    "global_ayah_id": 6044,
    "translation": "በፀሐይና በብርሃኗ እምላለሁ፡፡"
  },
  {
    "surah_id": 91,
    "ayah_number": 2,
    "global_ayah_id": 6045,
    "translation": "በጨረቃም በተከተላት ጊዜ፤"
  },
  {
    "surah_id": 91,
    "ayah_number": 3,
    "global_ayah_id": 6046,
    "translation": "በቀኑም (ፀሐይን) በገለጻት ጊዜ፤"
  },
  {
    "surah_id": 91,
    "ayah_number": 4,
    "global_ayah_id": 6047,
    "translation": "በሌሊቱም በሸፈናት ጊዜ፤"
  },
  {
    "surah_id": 91,
    "ayah_number": 5,
    "global_ayah_id": 6048,
    "translation": "በሰማይቱም በገነባትም (ጌታ)፤"
  },
  {
    "surah_id": 91,
    "ayah_number": 6,
    "global_ayah_id": 6049,
    "translation": "በምድሪቱም በዘረጋትም፤"
  },
  {
    "surah_id": 91,
    "ayah_number": 7,
    "global_ayah_id": 6050,
    "translation": "በነፍስም ባስተካከላትም፤"
  },
  {
    "surah_id": 91,
    "ayah_number": 8,
    "global_ayah_id": 6051,
    "translation": "አመጽዋንና ፍርሃትዋንም ባሳወቃት (አምላክ እምላለሁ)፡፡"
  },
  {
    "surah_id": 91,
    "ayah_number": 9,
    "global_ayah_id": 6052,
    "translation": "(ከኀጢኣት) ያጠራት ሰው ፍላጎቱን በእርግጥ አገኘ፡፡"
  },
  {
    "surah_id": 91,
    "ayah_number": 10,
    "global_ayah_id": 6053,
    "translation": "(በኀጢኣት) የሸፈናትም ሰው በእውነት አፈረ፡፡"
  },
  {
    "surah_id": 91,
    "ayah_number": 11,
    "global_ayah_id": 6054,
    "translation": "ሠሙድ ወሰን በማለፍዋ አስተባበለች፡፡"
  },
  {
    "surah_id": 91,
    "ayah_number": 12,
    "global_ayah_id": 6055,
    "translation": "ጠማማዋ በተንቀሳቀሰ ጊዜ፡፡"
  },
  {
    "surah_id": 91,
    "ayah_number": 13,
    "global_ayah_id": 6056,
    "translation": "ለእነርሱም የአላህ መልክተኛ (ሷሊህ) «የአላህን ግመል የመጠጥ ተራዋንም (ተጠንቀቁ)» አላቸው፡፡"
  },
  {
    "surah_id": 91,
    "ayah_number": 14,
    "global_ayah_id": 6057,
    "translation": "አስተባበሉትም፡፡ (ቋንጃዋን) ወጓትም፡፡ በኀጢኣታቸውም ምክንያት ጌታቸው (ቅጣትን) በእነርሱ ላይ ደመደመባቸው፤ አስተካከላትም፡፡"
  },
  {
    "surah_id": 91,
    "ayah_number": 15,
    "global_ayah_id": 6058,
    "translation": "ፍጻሜዋንም (የምታስከትለውን) አያፈራም፡፡"
  }
]