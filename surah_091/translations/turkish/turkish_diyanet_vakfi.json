[
  {
    "surah_id": 91,
    "ayah_number": 1,
    "global_ayah_id": 6044,
    "translation": "Güneşe ve kuşluk vaktindeki aydınlığına"
  },
  {
    "surah_id": 91,
    "ayah_number": 2,
    "global_ayah_id": 6045,
    "translation": "Güneşi takip ettiğinde Ay'a,"
  },
  {
    "surah_id": 91,
    "ayah_number": 3,
    "global_ayah_id": 6046,
    "translation": "Onu açığa çıkarttığında gündüze,"
  },
  {
    "surah_id": 91,
    "ayah_number": 4,
    "global_ayah_id": 6047,
    "translation": "Onu örttüğünde geceye,"
  },
  {
    "surah_id": 91,
    "ayah_number": 5,
    "global_ayah_id": 6048,
    "translation": "Gökyüzüne ve onu bina edene,"
  },
  {
    "surah_id": 91,
    "ayah_number": 6,
    "global_ayah_id": 6049,
    "translation": "Yere ve onu yapıp döşeyene,"
  },
  {
    "surah_id": 91,
    "ayah_number": 7,
    "global_ayah_id": 6050,
    "translation": "Nefse ve ona birtakım kabiliyetler verene,"
  },
  {
    "surah_id": 91,
    "ayah_number": 8,
    "global_ayah_id": 6051,
    "translation": "Sonra da ona iyilik ve kötülükleri ilham edene yemin ederim ki,"
  },
  {
    "surah_id": 91,
    "ayah_number": 9,
    "global_ayah_id": 6052,
    "translation": "Nefsini kötülüklerden arındıran kurtuluşa ermiştir,"
  },
  {
    "surah_id": 91,
    "ayah_number": 10,
    "global_ayah_id": 6053,
    "translation": "Onu kötülüklere gömen de ziyan etmiştir."
  },
  {
    "surah_id": 91,
    "ayah_number": 11,
    "global_ayah_id": 6054,
    "translation": "Semud kavmi azgınlığı yüzünden (Allah'ın elçisini) yalanladı."
  },
  {
    "surah_id": 91,
    "ayah_number": 12,
    "global_ayah_id": 6055,
    "translation": "Onların en bedbahtı (deveyi kesmek için) atıldığında,"
  },
  {
    "surah_id": 91,
    "ayah_number": 13,
    "global_ayah_id": 6056,
    "translation": "Allah'ın Resulü onlara: \"Allah'ın devesine ve onun su hakkına dokunmayın!\" dedi."
  },
  {
    "surah_id": 91,
    "ayah_number": 14,
    "global_ayah_id": 6057,
    "translation": "Ama onlar, onu yalanladılar ve deveyi kestiler. Bunun üzerine Rableri günahları sebebiyle onlara büyük bir felaket gönderdi de hepsini helak etti."
  },
  {
    "surah_id": 91,
    "ayah_number": 15,
    "global_ayah_id": 6058,
    "translation": "(Allah, bu şekilde azap etmenin) akıbetinden korkacak değil ya!"
  }
]