[
  {
    "surah_id": 91,
    "ayah_number": 1,
    "global_ayah_id": 6044,
    "translation": "¡Por el sol y su claridad!"
  },
  {
    "surah_id": 91,
    "ayah_number": 2,
    "global_ayah_id": 6045,
    "translation": "¡Por la luna cuando le sigue!"
  },
  {
    "surah_id": 91,
    "ayah_number": 3,
    "global_ayah_id": 6046,
    "translation": "¡Por el día cuando lo muestra brillante!"
  },
  {
    "surah_id": 91,
    "ayah_number": 4,
    "global_ayah_id": 6047,
    "translation": "¡Por la noche cuando lo vela!"
  },
  {
    "surah_id": 91,
    "ayah_number": 5,
    "global_ayah_id": 6048,
    "translation": "¡Por el cielo y Quien lo ha edificado!"
  },
  {
    "surah_id": 91,
    "ayah_number": 6,
    "global_ayah_id": 6049,
    "translation": "¡Por la tierra y Quien la ha extentido!"
  },
  {
    "surah_id": 91,
    "ayah_number": 7,
    "global_ayah_id": 6050,
    "translation": "¡Por el alma y Quien le ha dado forma armoniosa,"
  },
  {
    "surah_id": 91,
    "ayah_number": 8,
    "global_ayah_id": 6051,
    "translation": "instruyéndole sobre su propensión al pecado y su temor de Dios!"
  },
  {
    "surah_id": 91,
    "ayah_number": 9,
    "global_ayah_id": 6052,
    "translation": "¡Bienaventurado quien la purifique!"
  },
  {
    "surah_id": 91,
    "ayah_number": 10,
    "global_ayah_id": 6053,
    "translation": "¡Decepcionado, empero, quien la corrompa!"
  },
  {
    "surah_id": 91,
    "ayah_number": 11,
    "global_ayah_id": 6054,
    "translation": "Los tamudeos, en su arrogancia, desmintieron."
  },
  {
    "surah_id": 91,
    "ayah_number": 12,
    "global_ayah_id": 6055,
    "translation": "Cuando el más miserable de entre ellos se alzó."
  },
  {
    "surah_id": 91,
    "ayah_number": 13,
    "global_ayah_id": 6056,
    "translation": "El enviado de Dios les dijo: «¡Dejad a la camella de Dios y que beba!»"
  },
  {
    "surah_id": 91,
    "ayah_number": 14,
    "global_ayah_id": 6057,
    "translation": "Le desmintieron y la desjarretaron. Su Señor, entonces, les aniquiló por su pecado, a todos por igual,"
  },
  {
    "surah_id": 91,
    "ayah_number": 15,
    "global_ayah_id": 6058,
    "translation": "sin temer las consecuencias de ello."
  }
]