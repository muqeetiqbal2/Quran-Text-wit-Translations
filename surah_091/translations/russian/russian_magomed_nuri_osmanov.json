[
  {
    "surah_id": 91,
    "ayah_number": 1,
    "global_ayah_id": 6044,
    "translation": "Клянусь солнцем и его сиянием!"
  },
  {
    "surah_id": 91,
    "ayah_number": 2,
    "global_ayah_id": 6045,
    "translation": "Клянусь луной, когда она движется вслед за ним,"
  },
  {
    "surah_id": 91,
    "ayah_number": 3,
    "global_ayah_id": 6046,
    "translation": "клянусь днем, когда он освещает мир,"
  },
  {
    "surah_id": 91,
    "ayah_number": 4,
    "global_ayah_id": 6047,
    "translation": "клянусь ночью, когда она застилает мир,"
  },
  {
    "surah_id": 91,
    "ayah_number": 5,
    "global_ayah_id": 6048,
    "translation": "клянусь небом и Тем, кто его воздвиг,"
  },
  {
    "surah_id": 91,
    "ayah_number": 6,
    "global_ayah_id": 6049,
    "translation": "клянусь землей и Тем, кто ее простер!"
  },
  {
    "surah_id": 91,
    "ayah_number": 7,
    "global_ayah_id": 6050,
    "translation": "Клянусь душой [человеческой] и Тем, кто ее сотворил и придал ей соразмерность,"
  },
  {
    "surah_id": 91,
    "ayah_number": 8,
    "global_ayah_id": 6051,
    "translation": "кто внушил ей и ее грехи, и ее благочестие."
  },
  {
    "surah_id": 91,
    "ayah_number": 9,
    "global_ayah_id": 6052,
    "translation": "Преуспел тот, кто очистился душой."
  },
  {
    "surah_id": 91,
    "ayah_number": 10,
    "global_ayah_id": 6053,
    "translation": "Понес урон тот, кто сокрыл [злое] в душе."
  },
  {
    "surah_id": 91,
    "ayah_number": 11,
    "global_ayah_id": 6054,
    "translation": "Самудиты отвергли [посланника], [пребывая] в нечестии,"
  },
  {
    "surah_id": 91,
    "ayah_number": 12,
    "global_ayah_id": 6055,
    "translation": "когда несчастнейший из них вознамерился [убить верблюдицу]."
  },
  {
    "surah_id": 91,
    "ayah_number": 13,
    "global_ayah_id": 6056,
    "translation": "Тогда посланник Аллаха (т. е. Салих) сказал им: \"[Не трогайте] верблюдицу Аллаха и [не гоните] ее от водопоя\"."
  },
  {
    "surah_id": 91,
    "ayah_number": 14,
    "global_ayah_id": 6057,
    "translation": "Однако они не послушались его и подрезали ей поджилки, и Господь подверг их гибели за грехи, не различая, [где стар, где млад],"
  },
  {
    "surah_id": 91,
    "ayah_number": 15,
    "global_ayah_id": 6058,
    "translation": "не опасаясь последствий этого."
  }
]