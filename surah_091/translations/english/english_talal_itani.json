[
  {
    "surah_id": 91,
    "ayah_number": 1,
    "global_ayah_id": 6044,
    "translation": "By the sun and its radiance."
  },
  {
    "surah_id": 91,
    "ayah_number": 2,
    "global_ayah_id": 6045,
    "translation": "And the moon as it follows it."
  },
  {
    "surah_id": 91,
    "ayah_number": 3,
    "global_ayah_id": 6046,
    "translation": "And the day as it reveals it."
  },
  {
    "surah_id": 91,
    "ayah_number": 4,
    "global_ayah_id": 6047,
    "translation": "And the night as it conceals it."
  },
  {
    "surah_id": 91,
    "ayah_number": 5,
    "global_ayah_id": 6048,
    "translation": "And the sky and He who built it."
  },
  {
    "surah_id": 91,
    "ayah_number": 6,
    "global_ayah_id": 6049,
    "translation": "And the earth and He who spread it."
  },
  {
    "surah_id": 91,
    "ayah_number": 7,
    "global_ayah_id": 6050,
    "translation": "And the soul and He who proportioned it."
  },
  {
    "surah_id": 91,
    "ayah_number": 8,
    "global_ayah_id": 6051,
    "translation": "And inspired it with its wickedness and its righteousness."
  },
  {
    "surah_id": 91,
    "ayah_number": 9,
    "global_ayah_id": 6052,
    "translation": "Successful is he who purifies it."
  },
  {
    "surah_id": 91,
    "ayah_number": 10,
    "global_ayah_id": 6053,
    "translation": "Failing is he who corrupts it."
  },
  {
    "surah_id": 91,
    "ayah_number": 11,
    "global_ayah_id": 6054,
    "translation": "Thamood denied in its pride."
  },
  {
    "surah_id": 91,
    "ayah_number": 12,
    "global_ayah_id": 6055,
    "translation": "When it followed its most wicked."
  },
  {
    "surah_id": 91,
    "ayah_number": 13,
    "global_ayah_id": 6056,
    "translation": "The messenger of God said to them, “This is the she-camel of God, so let her drink.”"
  },
  {
    "surah_id": 91,
    "ayah_number": 14,
    "global_ayah_id": 6057,
    "translation": "But they called him a liar, and hamstrung her. So their Lord crushed them for their sin, and leveled it."
  },
  {
    "surah_id": 91,
    "ayah_number": 15,
    "global_ayah_id": 6058,
    "translation": "And He does not fear its sequel."
  }
]