[
  {
    "surah_id": 91,
    "ayah_number": 1,
    "global_ayah_id": 6044,
    "translation": "Eebe wuxuu ku dhaartay Qorraxda iyo Barqinkeeda."
  },
  {
    "surah_id": 91,
    "ayah_number": 2,
    "global_ayah_id": 6045,
    "translation": "Iyo Dayuxu markuu Qorraxda raaco."
  },
  {
    "surah_id": 91,
    "ayah_number": 3,
    "global_ayah_id": 6046,
    "translation": "Iyo Maalintu markay ifiso."
  },
  {
    "surah_id": 91,
    "ayah_number": 4,
    "global_ayah_id": 6047,
    "translation": "Iyo Habeenku markuu daboolo (madoobaado)."
  },
  {
    "surah_id": 91,
    "ayah_number": 5,
    "global_ayah_id": 6048,
    "translation": "Iyo Samada iyo say u dhisantahay."
  },
  {
    "surah_id": 91,
    "ayah_number": 6,
    "global_ayah_id": 6049,
    "translation": "Iyo Dhulka iyo suu u fidsanyahay."
  },
  {
    "surah_id": 91,
    "ayah_number": 7,
    "global_ayah_id": 6050,
    "translation": "Iyo Nafta iyo sida Eebe u ekeeyay."
  },
  {
    "surah_id": 91,
    "ayah_number": 8,
    "global_ayah_id": 6051,
    "translation": "Una tusiyay Jidka xun iyo ka Eebe kayaabiddaba."
  },
  {
    "surah_id": 91,
    "ayah_number": 9,
    "global_ayah_id": 6052,
    "translation": "Ee waxaa liibaanay Ruxii Naftiisa Daarhiriya."
  },
  {
    "surah_id": 91,
    "ayah_number": 10,
    "global_ayah_id": 6053,
    "translation": "Waxaana khasaaray Ruuxii Naftiisa xumaan dhex galiya."
  },
  {
    "surah_id": 91,
    "ayah_number": 11,
    "global_ayah_id": 6054,
    "translation": "Thamuud waxay beeniyeen (xaqii) kibir dartiis."
  },
  {
    "surah_id": 91,
    "ayah_number": 12,
    "global_ayah_id": 6055,
    "translation": "Marku tagay koodi xumaa (si uu hasha u dilo)."
  },
  {
    "surah_id": 91,
    "ayah_number": 13,
    "global_ayah_id": 6056,
    "translation": "Oo Rasuulkii Eebana ku yidhi, iska daaya Hasha Eebe iyo Cabbideeda."
  },
  {
    "surah_id": 91,
    "ayah_number": 14,
    "global_ayah_id": 6057,
    "translation": "Wayna beeniyeen Rasuulkii Hashiina way Dileen markaasaa Eebe si daran u caddibay Dambigooda dartiis."
  },
  {
    "surah_id": 91,
    "ayah_number": 15,
    "global_ayah_id": 6058,
    "translation": "Isagoon Eebe ka yaabaynin cidhib (iyo wax yeello)"
  }
]