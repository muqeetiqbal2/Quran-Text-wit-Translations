[
  {
    "surah_id": 99,
    "ayah_number": 1,
    "global_ayah_id": 6139,
    "translation": "大地が激しく揺れ，"
  },
  {
    "surah_id": 99,
    "ayah_number": 2,
    "global_ayah_id": 6140,
    "translation": "大地がその重荷を投げ出し，"
  },
  {
    "surah_id": 99,
    "ayah_number": 3,
    "global_ayah_id": 6141,
    "translation": "「かれ（大地）に何事が起ったのか。」と人が言う時。"
  },
  {
    "surah_id": 99,
    "ayah_number": 4,
    "global_ayah_id": 6142,
    "translation": "その日（大地は）凡ての消息を語ろう，"
  },
  {
    "surah_id": 99,
    "ayah_number": 5,
    "global_ayah_id": 6143,
    "translation": "あなたの主が啓示されたことを。"
  },
  {
    "surah_id": 99,
    "ayah_number": 6,
    "global_ayah_id": 6144,
    "translation": "その日，人びとは分別された集団となって（地中から）進み出て，かれらの行ったことが示されるであろう。"
  },
  {
    "surah_id": 99,
    "ayah_number": 7,
    "global_ayah_id": 6145,
    "translation": "一微塵の重さでも，善を行った者はそれを見る。"
  },
  {
    "surah_id": 99,
    "ayah_number": 8,
    "global_ayah_id": 6146,
    "translation": "一微塵の重さでも，悪を行った者はそれを見る。"
  }
]