[
  {
    "surah_id": 99,
    "ayah_number": 1,
    "global_ayah_id": 6139,
    "translation": "Yerküre kendine has sarsıntısıyla sallandığı,"
  },
  {
    "surah_id": 99,
    "ayah_number": 2,
    "global_ayah_id": 6140,
    "translation": "Toprak ağırlıklarını dışarı çıkardığı,"
  },
  {
    "surah_id": 99,
    "ayah_number": 3,
    "global_ayah_id": 6141,
    "translation": "Ve insan \"Ne oluyor buna!\" dediği vakit,"
  },
  {
    "surah_id": 99,
    "ayah_number": 4,
    "global_ayah_id": 6142,
    "translation": "İşte o gün (yer) haberlerini anlatır,"
  },
  {
    "surah_id": 99,
    "ayah_number": 5,
    "global_ayah_id": 6143,
    "translation": "Rabbinin ona bildirmesiyle."
  },
  {
    "surah_id": 99,
    "ayah_number": 6,
    "global_ayah_id": 6144,
    "translation": "O gün insanlar amellerini görmeleri (karşılığını almaları) için darmadağınık geri dönüp gelirler."
  },
  {
    "surah_id": 99,
    "ayah_number": 7,
    "global_ayah_id": 6145,
    "translation": "Kim zerre miktarı hayır yapmışsa onu görür."
  },
  {
    "surah_id": 99,
    "ayah_number": 8,
    "global_ayah_id": 6146,
    "translation": "Kim de zerre miktarı şer işlemişse onu görür."
  }
]