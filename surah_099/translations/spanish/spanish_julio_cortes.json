[
  {
    "surah_id": 99,
    "ayah_number": 1,
    "global_ayah_id": 6139,
    "translation": "Cuando sea sacudida la tierra por su terremoto,"
  },
  {
    "surah_id": 99,
    "ayah_number": 2,
    "global_ayah_id": 6140,
    "translation": "expulse la tierra su carga"
  },
  {
    "surah_id": 99,
    "ayah_number": 3,
    "global_ayah_id": 6141,
    "translation": "y el hombre se pregunte: «¿Qué es lo que le pasa?»,"
  },
  {
    "surah_id": 99,
    "ayah_number": 4,
    "global_ayah_id": 6142,
    "translation": "ese día contará sus noticias,"
  },
  {
    "surah_id": 99,
    "ayah_number": 5,
    "global_ayah_id": 6143,
    "translation": "según lo que tu Señor le inspire."
  },
  {
    "surah_id": 99,
    "ayah_number": 6,
    "global_ayah_id": 6144,
    "translation": "Ese día los hombres surgirán en grupos, para que se les muestren sus obras."
  },
  {
    "surah_id": 99,
    "ayah_number": 7,
    "global_ayah_id": 6145,
    "translation": "Quien haya hecho el peso de un átomo de bien, lo verá."
  },
  {
    "surah_id": 99,
    "ayah_number": 8,
    "global_ayah_id": 6146,
    "translation": "Y quien haya hecho el peso de un átomo de mal, lo verá."
  }
]