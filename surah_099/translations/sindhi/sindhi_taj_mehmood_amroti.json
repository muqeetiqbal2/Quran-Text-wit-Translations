  {
    "surah_id": 99,
    "ayah_number": 1,
    "global_ayah_id": 6139,
    "translation": "جڏھن زمين پنھنجي سخت ڌوڏجڻ سان ڌوڏبي."
  },
  {
    "surah_id": 99,
    "ayah_number": 2,
    "global_ayah_id": 6140,
    "translation": "۽ زمين پنھنجا بار ٻاھر ڪڍندي."
  },
  {
    "surah_id": 99,
    "ayah_number": 3,
    "global_ayah_id": 6141,
    "translation": "۽ ماڻھو چوندو ته زمين کي ڇا ٿيو آھي."
  },
  {
    "surah_id": 99,
    "ayah_number": 4,
    "global_ayah_id": 6142,
    "translation": "اُن ڏينھن (اُھا) پنھنجيون سڀ خبرون بيان ڪندي."
  },
  {
    "surah_id": 99,
    "ayah_number": 5,
    "global_ayah_id": 6143,
    "translation": "ھن ڪري جو تنھنجي پالڻھار ڏانھس حُڪم ڪيو."
  },
  {
    "surah_id": 99,
    "ayah_number": 6,
    "global_ayah_id": 6144,
    "translation": "اُن ڏينھن ماڻھو ڌار ڌار ٿي ورندا، ته سندس ڪم کين ڏيکارجن."
  },
  {
    "surah_id": 99,
    "ayah_number": 7,
    "global_ayah_id": 6145,
    "translation": "پوءِ جنھن ذري جيترو چڱو ڪم ڪيو ھوندو سو اُن کي ڏسندو."
  },
  {
    "surah_id": 99,
    "ayah_number": 8,
    "global_ayah_id": 6146,
    "translation": "۽ جنھن ذري جيترو بد ڪم ڪيو ھوندو سو اُن کي ڏسندو."
  }
]