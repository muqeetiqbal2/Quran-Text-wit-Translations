[
  {
    "surah_id": 99,
    "ayah_number": 1,
    "global_ayah_id": 6139,
    "translation": "當大地猛烈地震動,"
  },
  {
    "surah_id": 99,
    "ayah_number": 2,
    "global_ayah_id": 6140,
    "translation": "拋其重擔,"
  },
  {
    "surah_id": 99,
    "ayah_number": 3,
    "global_ayah_id": 6141,
    "translation": "說\"大地怎麼啦?\""
  },
  {
    "surah_id": 99,
    "ayah_number": 4,
    "global_ayah_id": 6142,
    "translation": "在那日, 大地將報告它的消息。"
  },
  {
    "surah_id": 99,
    "ayah_number": 5,
    "global_ayah_id": 6143,
    "translation": "因為你的主已啟示了它;"
  },
  {
    "surah_id": 99,
    "ayah_number": 6,
    "global_ayah_id": 6144,
    "translation": "在那日, 人們將紛紛地離散,"
  },
  {
    "surah_id": 99,
    "ayah_number": 7,
    "global_ayah_id": 6145,
    "translation": "以便他們得見自己行為的報應。"
  },
  {
    "surah_id": 99,
    "ayah_number": 8,
    "global_ayah_id": 6146,
    "translation": "行一個小螞蟻重的善事者, 將見其善報; 作一個小螞蟻重的惡事者, 將見其惡報。"
  }
]