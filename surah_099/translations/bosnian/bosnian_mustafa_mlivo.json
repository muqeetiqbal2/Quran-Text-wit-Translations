[
  {
    "surah_id": 99,
    "ayah_number": 1,
    "global_ayah_id": 6139,
    "translation": "Kad se zatrese Zemlja potresom svojim,"
  },
  {
    "surah_id": 99,
    "ayah_number": 2,
    "global_ayah_id": 6140,
    "translation": "I izbaci Zemlja terete svoje,"
  },
  {
    "surah_id": 99,
    "ayah_number": 3,
    "global_ayah_id": 6141,
    "translation": "I rekne čovjek: \"Šta joj je?\""
  },
  {
    "surah_id": 99,
    "ayah_number": 4,
    "global_ayah_id": 6142,
    "translation": "Tog dana kazivat će vijesti svoje,"
  },
  {
    "surah_id": 99,
    "ayah_number": 5,
    "global_ayah_id": 6143,
    "translation": "Jer će joj Gospodar tvoj objaviti."
  },
  {
    "surah_id": 99,
    "ayah_number": 6,
    "global_ayah_id": 6144,
    "translation": "Tog dana pojaviće se ljudi odvojeni, da im se pokažu djela njihova."
  },
  {
    "surah_id": 99,
    "ayah_number": 7,
    "global_ayah_id": 6145,
    "translation": "Pa ko je uradio težinu atoma dobrog, vidjeće ga,"
  },
  {
    "surah_id": 99,
    "ayah_number": 8,
    "global_ayah_id": 6146,
    "translation": "A ko je uradio težinu atoma zla, vidjeće ga."
  }
]