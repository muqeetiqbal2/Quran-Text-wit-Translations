[
  {
    "surah_id": 74,
    "ayah_number": 1,
    "global_ayah_id": 5496,
    "translation": "О завернувшийся!"
  },
  {
    "surah_id": 74,
    "ayah_number": 2,
    "global_ayah_id": 5497,
    "translation": "Встань и увещевай,"
  },
  {
    "surah_id": 74,
    "ayah_number": 3,
    "global_ayah_id": 5498,
    "translation": "превозноси своего Господа,"
  },
  {
    "surah_id": 74,
    "ayah_number": 4,
    "global_ayah_id": 5499,
    "translation": "очисти одежды свои,"
  },
  {
    "surah_id": 74,
    "ayah_number": 5,
    "global_ayah_id": 5500,
    "translation": "избегай скверны,"
  },
  {
    "surah_id": 74,
    "ayah_number": 6,
    "global_ayah_id": 5501,
    "translation": "не оказывай милости в надежде получить большее"
  },
  {
    "surah_id": 74,
    "ayah_number": 7,
    "global_ayah_id": 5502,
    "translation": "и терпи [притеснения неверных] ради твоего Господа."
  },
  {
    "surah_id": 74,
    "ayah_number": 8,
    "global_ayah_id": 5503,
    "translation": "Когда же протрубят в трубу,"
  },
  {
    "surah_id": 74,
    "ayah_number": 9,
    "global_ayah_id": 5504,
    "translation": "то тот день будет тяжким,"
  },
  {
    "surah_id": 74,
    "ayah_number": 10,
    "global_ayah_id": 5505,
    "translation": "нелегким для неверных."
  },
  {
    "surah_id": 74,
    "ayah_number": 11,
    "global_ayah_id": 5506,
    "translation": "Оставь Меня наедине с тем, кого Я сотворил,"
  },
  {
    "surah_id": 74,
    "ayah_number": 12,
    "global_ayah_id": 5507,
    "translation": "кому Я даровал несметное состояние"
  },
  {
    "surah_id": 74,
    "ayah_number": 13,
    "global_ayah_id": 5508,
    "translation": "и сыновей, не разлученных [с ним],"
  },
  {
    "surah_id": 74,
    "ayah_number": 14,
    "global_ayah_id": 5509,
    "translation": "и кому Я даровал [власть и богатство]."
  },
  {
    "surah_id": 74,
    "ayah_number": 15,
    "global_ayah_id": 5510,
    "translation": "Однако он жаждет, чтобы Я добавил ему."
  },
  {
    "surah_id": 74,
    "ayah_number": 16,
    "global_ayah_id": 5511,
    "translation": "Так нет же! Ведь он упрямо отрицает Наши знамения."
  },
  {
    "surah_id": 74,
    "ayah_number": 17,
    "global_ayah_id": 5512,
    "translation": "Скоро Я подвергну его тяжкому наказанию."
  },
  {
    "surah_id": 74,
    "ayah_number": 18,
    "global_ayah_id": 5513,
    "translation": "Ведь он обдумал и [все] предусмотрел."
  },
  {
    "surah_id": 74,
    "ayah_number": 19,
    "global_ayah_id": 5514,
    "translation": "Да сгинет он! Как это он предусмотрел?!"
  },
  {
    "surah_id": 74,
    "ayah_number": 20,
    "global_ayah_id": 5515,
    "translation": "Да сгинет он дважды! Как же он предусмотрел!"
  },
  {
    "surah_id": 74,
    "ayah_number": 21,
    "global_ayah_id": 5516,
    "translation": "Потом он огляделся,"
  },
  {
    "surah_id": 74,
    "ayah_number": 22,
    "global_ayah_id": 5517,
    "translation": "затем нахмурился и посмотрел сердито,"
  },
  {
    "surah_id": 74,
    "ayah_number": 23,
    "global_ayah_id": 5518,
    "translation": "потом отвернулся надменно"
  },
  {
    "surah_id": 74,
    "ayah_number": 24,
    "global_ayah_id": 5519,
    "translation": "и сказал: \"Это (т. е. Коран) не что иное, как пересказанное чародейство."
  },
  {
    "surah_id": 74,
    "ayah_number": 25,
    "global_ayah_id": 5520,
    "translation": "Это всего-навсего - речи людские\"."
  },
  {
    "surah_id": 74,
    "ayah_number": 26,
    "global_ayah_id": 5521,
    "translation": "Я скоро сожгу его адским пламенем."
  },
  {
    "surah_id": 74,
    "ayah_number": 27,
    "global_ayah_id": 5522,
    "translation": "А откуда тебе знать, что такое адское пламя,"
  },
  {
    "surah_id": 74,
    "ayah_number": 28,
    "global_ayah_id": 5523,
    "translation": "[ничего] не щадящее и не оставляющее,"
  },
  {
    "surah_id": 74,
    "ayah_number": 29,
    "global_ayah_id": 5524,
    "translation": "сжигающее кожу людей?"
  },
  {
    "surah_id": 74,
    "ayah_number": 30,
    "global_ayah_id": 5525,
    "translation": "А [истопников] для него - девятнадцать [ангелов]."
  },
  {
    "surah_id": 74,
    "ayah_number": 31,
    "global_ayah_id": 5526,
    "translation": "Истопниками при адском пламени Мы приставили только ангелов, а количество их определили только ради испытания неверных, чтобы удостоверились [в истине] люди Писания, усилилась вера у верующих, чтобы они не впали в сомнение и чтобы те, в чьих сердцах недуг [сомнения], а также неверные спросили: \"Что хотел Аллах [доказать] этой притчей?\"Так Аллах вводит в заблуждение или ведет прямым путем того, кого пожелает. И каково воинство твоего Господа, никто не знает, кроме Него. И это - лишь наставление для людей."
  },
  {
    "surah_id": 74,
    "ayah_number": 32,
    "global_ayah_id": 5527,
    "translation": "О да! Клянусь луной,"
  },
  {
    "surah_id": 74,
    "ayah_number": 33,
    "global_ayah_id": 5528,
    "translation": "и ночью, когда она отступает,"
  },
  {
    "surah_id": 74,
    "ayah_number": 34,
    "global_ayah_id": 5529,
    "translation": "и зарей, когда она забрезжит,"
  },
  {
    "surah_id": 74,
    "ayah_number": 35,
    "global_ayah_id": 5530,
    "translation": "что оно (т. е. адское пламя) - из величайших кар,"
  },
  {
    "surah_id": 74,
    "ayah_number": 36,
    "global_ayah_id": 5531,
    "translation": "[ниспосланных] в назидание людям -"
  },
  {
    "surah_id": 74,
    "ayah_number": 37,
    "global_ayah_id": 5532,
    "translation": "тем из вас, кто хочет продвигаться [к добру] или отступить [ко злу]."
  },
  {
    "surah_id": 74,
    "ayah_number": 38,
    "global_ayah_id": 5533,
    "translation": "Каждый человек - в ответе за свои деяния,"
  },
  {
    "surah_id": 74,
    "ayah_number": 39,
    "global_ayah_id": 5534,
    "translation": "кроме тех, кто идет [путем] правой руки,"
  },
  {
    "surah_id": 74,
    "ayah_number": 40,
    "global_ayah_id": 5535,
    "translation": "которые расспрашивают в [райских] садах друг друга"
  },
  {
    "surah_id": 74,
    "ayah_number": 41,
    "global_ayah_id": 5536,
    "translation": "о грешниках."
  },
  {
    "surah_id": 74,
    "ayah_number": 42,
    "global_ayah_id": 5537,
    "translation": "[Потом они поворачиваются к ним и спрашивают]: \"Что привело вас в адское пламя?\""
  },
  {
    "surah_id": 74,
    "ayah_number": 43,
    "global_ayah_id": 5538,
    "translation": "Они ответят: \"Мы не творили обрядовую молитву,"
  },
  {
    "surah_id": 74,
    "ayah_number": 44,
    "global_ayah_id": 5539,
    "translation": "не кормили бедных,"
  },
  {
    "surah_id": 74,
    "ayah_number": 45,
    "global_ayah_id": 5540,
    "translation": "заблуждались вместе с заблудшими"
  },
  {
    "surah_id": 74,
    "ayah_number": 46,
    "global_ayah_id": 5541,
    "translation": "и отрицали Судный день,"
  },
  {
    "surah_id": 74,
    "ayah_number": 47,
    "global_ayah_id": 5542,
    "translation": "пока не постигла нас смерть\"."
  },
  {
    "surah_id": 74,
    "ayah_number": 48,
    "global_ayah_id": 5543,
    "translation": "Но не поможет им ничье заступничество."
  },
  {
    "surah_id": 74,
    "ayah_number": 49,
    "global_ayah_id": 5544,
    "translation": "Что же с ними? Почему они уклоняются от наставления,"
  },
  {
    "surah_id": 74,
    "ayah_number": 50,
    "global_ayah_id": 5545,
    "translation": "словно они - напуганные ослы,"
  },
  {
    "surah_id": 74,
    "ayah_number": 51,
    "global_ayah_id": 5546,
    "translation": "бежавшие от [льва] неустрашимого?"
  },
  {
    "surah_id": 74,
    "ayah_number": 52,
    "global_ayah_id": 5547,
    "translation": "Так нет же! Каждый из них хочет получить развернутые свитки."
  },
  {
    "surah_id": 74,
    "ayah_number": 53,
    "global_ayah_id": 5548,
    "translation": "Но нет! Они не страшатся будущей жизни."
  },
  {
    "surah_id": 74,
    "ayah_number": 54,
    "global_ayah_id": 5549,
    "translation": "Так нет же! Ведь это (т. е. Коран) - назидание,"
  },
  {
    "surah_id": 74,
    "ayah_number": 55,
    "global_ayah_id": 5550,
    "translation": "и запомнит его тот, кто захочет."
  },
  {
    "surah_id": 74,
    "ayah_number": 56,
    "global_ayah_id": 5551,
    "translation": "Но они не запомнят, если только не захочет Аллах. Он - тот, кого надлежит бояться и кто прощает."
  }
]