[
  {
    "surah_id": 74,
    "ayah_number": 1,
    "global_ayah_id": 5496,
    "translation": "О ты, укрывшийся плащом!"
  },
  {
    "surah_id": 74,
    "ayah_number": 2,
    "global_ayah_id": 5497,
    "translation": "Встань и неси предупрежденье"
  },
  {
    "surah_id": 74,
    "ayah_number": 3,
    "global_ayah_id": 5498,
    "translation": "И славь Владыку своего!"
  },
  {
    "surah_id": 74,
    "ayah_number": 4,
    "global_ayah_id": 5499,
    "translation": "И в чистоте блюди свои одежды,"
  },
  {
    "surah_id": 74,
    "ayah_number": 5,
    "global_ayah_id": 5500,
    "translation": "От мерзости беги"
  },
  {
    "surah_id": 74,
    "ayah_number": 6,
    "global_ayah_id": 5501,
    "translation": "И (благ) не раздавай В надежде получить (с лихвой) обратно."
  },
  {
    "surah_id": 74,
    "ayah_number": 7,
    "global_ayah_id": 5502,
    "translation": "В Господнем деле проявляй терпенье."
  },
  {
    "surah_id": 74,
    "ayah_number": 8,
    "global_ayah_id": 5503,
    "translation": "Когда раздастся трубный глас,"
  },
  {
    "surah_id": 74,
    "ayah_number": 9,
    "global_ayah_id": 5504,
    "translation": "Настанет День - день тяжкий,"
  },
  {
    "surah_id": 74,
    "ayah_number": 10,
    "global_ayah_id": 5505,
    "translation": "День, нелегкий для неверных."
  },
  {
    "surah_id": 74,
    "ayah_number": 11,
    "global_ayah_id": 5506,
    "translation": "И одного Меня оставь с тем (человеком), Кого Я одиноким создал,"
  },
  {
    "surah_id": 74,
    "ayah_number": 12,
    "global_ayah_id": 5507,
    "translation": "Потом пространное богатство даровал"
  },
  {
    "surah_id": 74,
    "ayah_number": 13,
    "global_ayah_id": 5508,
    "translation": "И сыновей, стоящих рядом (в радости и в горе),"
  },
  {
    "surah_id": 74,
    "ayah_number": 14,
    "global_ayah_id": 5509,
    "translation": "И гладко перед ним простер (дорогу жизни)."
  },
  {
    "surah_id": 74,
    "ayah_number": 15,
    "global_ayah_id": 5510,
    "translation": "И все же жадничает он."
  },
  {
    "surah_id": 74,
    "ayah_number": 16,
    "global_ayah_id": 5511,
    "translation": "Увы! К знаменьям Нашим он упрям и дерзок."
  },
  {
    "surah_id": 74,
    "ayah_number": 17,
    "global_ayah_id": 5512,
    "translation": "Я возложу (как наказанье) на него подъем, -"
  },
  {
    "surah_id": 74,
    "ayah_number": 18,
    "global_ayah_id": 5513,
    "translation": "Ведь он замыслил все и рассчитал."
  },
  {
    "surah_id": 74,
    "ayah_number": 19,
    "global_ayah_id": 5514,
    "translation": "Да будет убиен он! Как он все устроил!"
  },
  {
    "surah_id": 74,
    "ayah_number": 20,
    "global_ayah_id": 5515,
    "translation": "И вновь - пусть будет он убит! Как рассчитал он все!"
  },
  {
    "surah_id": 74,
    "ayah_number": 21,
    "global_ayah_id": 5516,
    "translation": "Затем он поглядел вокруг,"
  },
  {
    "surah_id": 74,
    "ayah_number": 22,
    "global_ayah_id": 5517,
    "translation": "Затем нахмурился и сдвинул брови,"
  },
  {
    "surah_id": 74,
    "ayah_number": 23,
    "global_ayah_id": 5518,
    "translation": "Затем спиною встал и возгордился,"
  },
  {
    "surah_id": 74,
    "ayah_number": 24,
    "global_ayah_id": 5519,
    "translation": "Затем сказал: \"Сие - не боле колдовства, Пришедшего с времен далеких;"
  },
  {
    "surah_id": 74,
    "ayah_number": 25,
    "global_ayah_id": 5520,
    "translation": "Не боле чем людская речь!\""
  },
  {
    "surah_id": 74,
    "ayah_number": 26,
    "global_ayah_id": 5521,
    "translation": "Я в сАкаре его сожгу!"
  },
  {
    "surah_id": 74,
    "ayah_number": 27,
    "global_ayah_id": 5522,
    "translation": "Как объяснить тебе, что \"сАкар\" значит?"
  },
  {
    "surah_id": 74,
    "ayah_number": 28,
    "global_ayah_id": 5523,
    "translation": "Его нельзя ни вытерпеть и ни покинуть,"
  },
  {
    "surah_id": 74,
    "ayah_number": 29,
    "global_ayah_id": 5524,
    "translation": "Сжигает (кожу человека) он,"
  },
  {
    "surah_id": 74,
    "ayah_number": 30,
    "global_ayah_id": 5525,
    "translation": "Над ним же - девятнадцать (стражей)."
  },
  {
    "surah_id": 74,
    "ayah_number": 31,
    "global_ayah_id": 5526,
    "translation": "Мы во властители Огня лишь ангелов призвали, Назначив точно их число Для искушения неверных, Чтоб убедить людей Писания (Уверовать в пророка и Коран), Чтобы усилить веру в тех, кто верует, И чтобы никаких сомнений не осталось Ни в праведных сердцах, ни у людей Писаний, И чтоб неверные и те, Сердца которых недугом объяты, Сказать могли: \"Какую ж суть Аллах нам этой притчей выражает?\" Так позволяет Он (в грехах) блуждать тому, кто этого захочет, И ясною стезей ведет того, кто мил Ему. И никому, кроме Него, не знать (числа) Его воИнств. И сей (Огонь) - не что иное, Как увещанье для людей."
  },
  {
    "surah_id": 74,
    "ayah_number": 32,
    "global_ayah_id": 5527,
    "translation": "В знак (Моего знамения) - луны,"
  },
  {
    "surah_id": 74,
    "ayah_number": 33,
    "global_ayah_id": 5528,
    "translation": "И уходящей ночи,"
  },
  {
    "surah_id": 74,
    "ayah_number": 34,
    "global_ayah_id": 5529,
    "translation": "И пламенеющей зари, -"
  },
  {
    "surah_id": 74,
    "ayah_number": 35,
    "global_ayah_id": 5530,
    "translation": "Ведь это - (всего) один из величайших (Моих знаков)"
  },
  {
    "surah_id": 74,
    "ayah_number": 36,
    "global_ayah_id": 5531,
    "translation": "И увещанье для людей,"
  },
  {
    "surah_id": 74,
    "ayah_number": 37,
    "global_ayah_id": 5532,
    "translation": "Для тех, кто во главе (к добру) идет, (А равно) и для тех, кто остается сзади."
  },
  {
    "surah_id": 74,
    "ayah_number": 38,
    "global_ayah_id": 5533,
    "translation": "Ведь каждая душа заложницей своих деяний будет, -"
  },
  {
    "surah_id": 74,
    "ayah_number": 39,
    "global_ayah_id": 5534,
    "translation": "Помимо (братьев) правой стороны."
  },
  {
    "surah_id": 74,
    "ayah_number": 40,
    "global_ayah_id": 5535,
    "translation": "Вступая в сад (прекрасный Рая), Они друг друга воспрошают"
  },
  {
    "surah_id": 74,
    "ayah_number": 41,
    "global_ayah_id": 5536,
    "translation": "И грешникам (вопрос свой задают):"
  },
  {
    "surah_id": 74,
    "ayah_number": 42,
    "global_ayah_id": 5537,
    "translation": "Что привело вас в сАкар?"
  },
  {
    "surah_id": 74,
    "ayah_number": 43,
    "global_ayah_id": 5538,
    "translation": "Они ответят: \"Мы не были средь тех, Кто совершал молитву,"
  },
  {
    "surah_id": 74,
    "ayah_number": 44,
    "global_ayah_id": 5539,
    "translation": "И не были средь тех, Кто бедняков кормил."
  },
  {
    "surah_id": 74,
    "ayah_number": 45,
    "global_ayah_id": 5540,
    "translation": "Мы пустословьем с болтунами занимались"
  },
  {
    "surah_id": 74,
    "ayah_number": 46,
    "global_ayah_id": 5541,
    "translation": "И ложью нарекали Судный День,"
  },
  {
    "surah_id": 74,
    "ayah_number": 47,
    "global_ayah_id": 5542,
    "translation": "Пока нас не постигла смерть\"."
  },
  {
    "surah_id": 74,
    "ayah_number": 48,
    "global_ayah_id": 5543,
    "translation": "И тут ничье заступничество им не поможет."
  },
  {
    "surah_id": 74,
    "ayah_number": 49,
    "global_ayah_id": 5544,
    "translation": "Так что ж от увещаний Наших Их заставляет отвернуться,"
  },
  {
    "surah_id": 74,
    "ayah_number": 50,
    "global_ayah_id": 5545,
    "translation": "Подобно перепуганным ослам,"
  },
  {
    "surah_id": 74,
    "ayah_number": 51,
    "global_ayah_id": 5546,
    "translation": "От льва спасающихся бегством?"
  },
  {
    "surah_id": 74,
    "ayah_number": 52,
    "global_ayah_id": 5547,
    "translation": "Поистине, любой из них хотел бы, Чтобы (Аллах) лишь одному ему послал Развернутые свитки Откровений."
  },
  {
    "surah_id": 74,
    "ayah_number": 53,
    "global_ayah_id": 5548,
    "translation": "Увы! В них страха нет перед последней жизнью."
  },
  {
    "surah_id": 74,
    "ayah_number": 54,
    "global_ayah_id": 5549,
    "translation": "Да будет так! Ведь сей (Коран), поистине, Является напоминаньем."
  },
  {
    "surah_id": 74,
    "ayah_number": 55,
    "global_ayah_id": 5550,
    "translation": "И кто захочет, тот его услышит,"
  },
  {
    "surah_id": 74,
    "ayah_number": 56,
    "global_ayah_id": 5551,
    "translation": "Но не услышит ни один из них, Если Аллах того не пожелает. Лишь Он достоин, чтобы (в почитании Его) Страшились (Его гнева). Вершитель всепрощенья - только Он!"
  }
]