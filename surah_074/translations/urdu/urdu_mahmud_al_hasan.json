[
  {
    "surah_id": 74,
    "ayah_number": 0,
    "global_ayah_id": 5568,
    "translation": "اللہ کے نام سے جو رحمان و رحیم ہے"
  },
  {
    "surah_id": 74,
    "ayah_number": 1,
    "global_ayah_id": 5569,
    "translation": "اے لحاف میں لپٹنے والے"
  },
  {
    "surah_id": 74,
    "ayah_number": 2,
    "global_ayah_id": 5570,
    "translation": "کھڑا ہو پھر ڈر سنا دے"
  },
  {
    "surah_id": 74,
    "ayah_number": 3,
    "global_ayah_id": 5571,
    "translation": "اور اپنے رب کی بڑائی بول"
  },
  {
    "surah_id": 74,
    "ayah_number": 4,
    "global_ayah_id": 5572,
    "translation": "اور اپنے کپڑے پاک رکھ"
  },
  {
    "surah_id": 74,
    "ayah_number": 5,
    "global_ayah_id": 5573,
    "translation": "اور گندگی سے دور رہ"
  },
  {
    "surah_id": 74,
    "ayah_number": 6,
    "global_ayah_id": 5574,
    "translation": "اور ایسا نہ کر کہ احسان کرے اور بدلا بہت چاہے"
  },
  {
    "surah_id": 74,
    "ayah_number": 7,
    "global_ayah_id": 5575,
    "translation": "اور اپنے رب سے امید رکھ"
  },
  {
    "surah_id": 74,
    "ayah_number": 8,
    "global_ayah_id": 5576,
    "translation": "پھر جب بجنے لگے وہ کھوکھری چیز"
  },
  {
    "surah_id": 74,
    "ayah_number": 9,
    "global_ayah_id": 5577,
    "translation": "پھر وہ اس دن مشکل دن ہے"
  },
  {
    "surah_id": 74,
    "ayah_number": 10,
    "global_ayah_id": 5578,
    "translation": "منکروں پر نہیں آسان"
  },
  {
    "surah_id": 74,
    "ayah_number": 11,
    "global_ayah_id": 5579,
    "translation": "چھوڑ دے مجھ کو اور اُس کو جسکو میں نے بنایا انکا"
  },
  {
    "surah_id": 74,
    "ayah_number": 12,
    "global_ayah_id": 5580,
    "translation": "اور دیا میں نے اُسکو مال پھیلا کر"
  },
  {
    "surah_id": 74,
    "ayah_number": 13,
    "global_ayah_id": 5581,
    "translation": "اور بیٹے مجلس میں بیٹھنے والے"
  },
  {
    "surah_id": 74,
    "ayah_number": 14,
    "global_ayah_id": 5582,
    "translation": "اور تیاری کر دی اُسکے لئے خوب تیاری"
  },
  {
    "surah_id": 74,
    "ayah_number": 15,
    "global_ayah_id": 5583,
    "translation": "پھر لالچ رکھتا ہے کہ اور بھی دوں"
  },
  {
    "surah_id": 74,
    "ayah_number": 16,
    "global_ayah_id": 5584,
    "translation": "ہرگز نہیں وہ ہے ہماری آیتوں کا مخالف"
  },
  {
    "surah_id": 74,
    "ayah_number": 17,
    "global_ayah_id": 5585,
    "translation": "اب اُسی سے چڑھواؤں گا بڑی چڑھائی"
  },
  {
    "surah_id": 74,
    "ayah_number": 18,
    "global_ayah_id": 5586,
    "translation": "اُس نے فکر کیا اور دل میں ٹھہرا لیا"
  },
  {
    "surah_id": 74,
    "ayah_number": 19,
    "global_ayah_id": 5587,
    "translation": "سو مارا جائیو کیسا ٹھہرایا"
  },
  {
    "surah_id": 74,
    "ayah_number": 20,
    "global_ayah_id": 5588,
    "translation": "پھر مارا جائیو کیسا ٹھہرایا"
  },
  {
    "surah_id": 74,
    "ayah_number": 21,
    "global_ayah_id": 5589,
    "translation": "پھر نگاہ کی"
  },
  {
    "surah_id": 74,
    "ayah_number": 22,
    "global_ayah_id": 5590,
    "translation": "پھر تیوری چڑھائی اور منہ تھتھایا"
  },
  {
    "surah_id": 74,
    "ayah_number": 23,
    "global_ayah_id": 5591,
    "translation": "پھر پیٹھ پھیری اور غرور کیا"
  },
  {
    "surah_id": 74,
    "ayah_number": 24,
    "global_ayah_id": 5592,
    "translation": "پھر بولا اور کچھ نہیں یہ جادو ہے چلا آتا"
  },
  {
    "surah_id": 74,
    "ayah_number": 25,
    "global_ayah_id": 5593,
    "translation": "اور کچھ نہیں یہ کہا ہوا ہے آدمی کا"
  },
  {
    "surah_id": 74,
    "ayah_number": 26,
    "global_ayah_id": 5594,
    "translation": "اب اُسکو ڈالوں گا آگ میں"
  },
  {
    "surah_id": 74,
    "ayah_number": 27,
    "global_ayah_id": 5595,
    "translation": "اور تو کیا سمجھا کیسی ہے وہ آگ"
  },
  {
    "surah_id": 74,
    "ayah_number": 28,
    "global_ayah_id": 5596,
    "translation": "نہ باقی رکھے اور نہ چھوڑے"
  },
  {
    "surah_id": 74,
    "ayah_number": 29,
    "global_ayah_id": 5597,
    "translation": "جلا دینے والی ہے آدمیوں کو"
  },
  {
    "surah_id": 74,
    "ayah_number": 30,
    "global_ayah_id": 5598,
    "translation": "اُس پر مقرر ہیں انیس فرشتے"
  },
  {
    "surah_id": 74,
    "ayah_number": 31,
    "global_ayah_id": 5599,
    "translation": "اور ہم نے جو رکھے ہیں دوزخ پر داروغہ وہ فرشتے ہی ہیں اور اُنکی جو گنتی رکھی ہے سو جانچنے کو منکروں کے تاکہ یقین کر لیں وہ لوگ جنکو ملی ہے کتاب اور بڑھے ایمانداروں کا ایمان اور دھوکا نہ کھائیں جنکو ملی ہے کتاب اور مسلمان اور تاکہ کہیں وہ لوگ کہ جنکے دل میں روگ ہے اور منکر کیا غرض تھی اللہ کو اس مثل سے یوں بچلاتا ہے اللہ جسکو چاہے اور راہ دیتا ہے جسکو چاہے اور کوئی نہیں جانتا تیرے رب کے لشکر مگر خود ہی اور وہ تو سمجھانا ہے لوگوں کے واسطے"
  },
  {
    "surah_id": 74,
    "ayah_number": 32,
    "global_ayah_id": 5600,
    "translation": "سچ کہتا ہوں اور قسم ہے چاند کی"
  },
  {
    "surah_id": 74,
    "ayah_number": 33,
    "global_ayah_id": 5601,
    "translation": "اور رات کی جب پیٹھ پھیرے"
  },
  {
    "surah_id": 74,
    "ayah_number": 34,
    "global_ayah_id": 5602,
    "translation": "اور صبح کی جب روشن ہووے"
  },
  {
    "surah_id": 74,
    "ayah_number": 35,
    "global_ayah_id": 5603,
    "translation": "وہ ایک ہے بڑی چیزوں میں کی"
  },
  {
    "surah_id": 74,
    "ayah_number": 36,
    "global_ayah_id": 5604,
    "translation": "ڈرانے والی ہے لوگوں کو"
  },
  {
    "surah_id": 74,
    "ayah_number": 37,
    "global_ayah_id": 5605,
    "translation": "جو کوئی چاہے تم میں سے کہ آگے بڑھے یا پیچھے رہے"
  },
  {
    "surah_id": 74,
    "ayah_number": 38,
    "global_ayah_id": 5606,
    "translation": "ہر ایک جی اپنے کئے کاموں میں پھنسا ہوا ہے"
  },
  {
    "surah_id": 74,
    "ayah_number": 39,
    "global_ayah_id": 5607,
    "translation": "مگر داہنی طرف والے"
  },
  {
    "surah_id": 74,
    "ayah_number": 40,
    "global_ayah_id": 5608,
    "translation": "باغوں میں ہیں مل کر پوچھتے ہیں"
  },
  {
    "surah_id": 74,
    "ayah_number": 41,
    "global_ayah_id": 5609,
    "translation": "گنہگاروں کا حال"
  },
  {
    "surah_id": 74,
    "ayah_number": 42,
    "global_ayah_id": 5610,
    "translation": "تم کاہے سے جا پڑے دوزخ میں"
  },
  {
    "surah_id": 74,
    "ayah_number": 43,
    "global_ayah_id": 5611,
    "translation": "وہ بولے ہم نہ تھے نماز پڑھتے"
  },
  {
    "surah_id": 74,
    "ayah_number": 44,
    "global_ayah_id": 5612,
    "translation": "اور نہ تھے کھانا کھلاتے محتاج کو"
  },
  {
    "surah_id": 74,
    "ayah_number": 45,
    "global_ayah_id": 5613,
    "translation": "اور ہم تھے باتوں میں دھنستے دھنسنے والوں کے ساتھ"
  },
  {
    "surah_id": 74,
    "ayah_number": 46,
    "global_ayah_id": 5614,
    "translation": "اور ہم تھے جھٹلاتے انصاف کے دن کو"
  },
  {
    "surah_id": 74,
    "ayah_number": 47,
    "global_ayah_id": 5615,
    "translation": "یہاں تک یہ آ پہنچی ہم پر وہ یقینی بات"
  },
  {
    "surah_id": 74,
    "ayah_number": 48,
    "global_ayah_id": 5616,
    "translation": "پھر کام نہ آئے گی اُنکے سفارش سفارش کرنے والوں کی"
  },
  {
    "surah_id": 74,
    "ayah_number": 49,
    "global_ayah_id": 5617,
    "translation": "پھر کیا ہوا ہے انکو کہ نصیحت سے منہ موڑتے ہیں"
  },
  {
    "surah_id": 74,
    "ayah_number": 50,
    "global_ayah_id": 5618,
    "translation": "گویا کہ وہ گدھے ہیں بدکنے والے"
  },
  {
    "surah_id": 74,
    "ayah_number": 51,
    "global_ayah_id": 5619,
    "translation": "بھاگے ہیں غل مچانے سے"
  },
  {
    "surah_id": 74,
    "ayah_number": 52,
    "global_ayah_id": 5620,
    "translation": "بلکہ چاہتا ہے ہر ایک مرد اُن میں کا کہ ملیں اُسکو ورق کھلے ہوئے"
  },
  {
    "surah_id": 74,
    "ayah_number": 53,
    "global_ayah_id": 5621,
    "translation": "ہرگز نہیں پر وہ ڈرتے نہیں آخرت سے"
  },
  {
    "surah_id": 74,
    "ayah_number": 54,
    "global_ayah_id": 5622,
    "translation": "کوئی نہیں یہ تو نصیحت ہے"
  },
  {
    "surah_id": 74,
    "ayah_number": 55,
    "global_ayah_id": 5623,
    "translation": "پھر جو کوئی چاہے اُسکو یاد کرے"
  },
  {
    "surah_id": 74,
    "ayah_number": 56,
    "global_ayah_id": 5624,
    "translation": "اور وہ یاد جبھی کریں کہ چاہے اللہ وہی ہے جس سے ڈرناچاہیے اور وہی ہے بخشنے کے لائق"
  }
]