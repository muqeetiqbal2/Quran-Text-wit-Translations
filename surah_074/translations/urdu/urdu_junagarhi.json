  {
    "surah_id": 74,
    "ayah_number": 38,
    "global_ayah_id": 5606,
    "translation": " ہر شخص اپنے «<a href=42> اعمال </a>» کے بدلے میں «<a href=525> گروی\n</a>» ہے ۔ "
