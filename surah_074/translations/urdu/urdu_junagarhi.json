  },
  {
    "surah_id": 74,
    "ayah_number": 22,
    "global_ayah_id": 5590,
    "translation": " پھر «<a href=216> تیوری </a>» چڑھائی اور «<a href=597> منہ </a>» بنایا\n۔ "
