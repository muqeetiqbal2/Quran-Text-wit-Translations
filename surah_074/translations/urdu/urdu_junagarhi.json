    "ayah_number": 40,
    "global_ayah_id": 5608,
    "translation": " کہ وہ بہشتوں میں ( بیٹھے ہوئے )، «<a href=531> گناہ </a>» گاروں سےسوال\nکرتے ہوں گے "
