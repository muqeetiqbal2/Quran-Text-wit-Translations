  {
    "surah_id": 74,
    "ayah_number": 53,
    "global_ayah_id": 5621,
    "translation": " ہرگز ایسا نہیں ( ہو سکتا بلکہ ) یہ «<a href=476> قیامت </a>» سے بے خوف\nہیں ۔ "
  },
  {
    "surah_id": 74,
    "ayah_number": 54,
    "global_ayah_id": 5622,
    "translation": " سچی «<a href=71> بات </a>» تو یہ ہے کہ یہ ( «<a href=470> قرآن </a>» )\nایک «<a href=622> نصیحت </a>» ہے ۔ "
