[
  {
    "surah_id": 74,
    "ayah_number": 1,
    "global_ayah_id": 5496,
    "translation": "O pokriveni!"
  },
  {
    "surah_id": 74,
    "ayah_number": 2,
    "global_ayah_id": 5497,
    "translation": "Ustani pa upozoravaj!"
  },
  {
    "surah_id": 74,
    "ayah_number": 3,
    "global_ayah_id": 5498,
    "translation": "I Gospodara svog tad veličaj!"
  },
  {
    "surah_id": 74,
    "ayah_number": 4,
    "global_ayah_id": 5499,
    "translation": "I odjeću svoju tad očisti!"
  },
  {
    "surah_id": 74,
    "ayah_number": 5,
    "global_ayah_id": 5500,
    "translation": "I prljavštine se tad kloni!"
  },
  {
    "surah_id": 74,
    "ayah_number": 6,
    "global_ayah_id": 5501,
    "translation": "I ne prigovaraj da je mnogo!"
  },
  {
    "surah_id": 74,
    "ayah_number": 7,
    "global_ayah_id": 5502,
    "translation": "I radi Gospodara tvog se tad strpi!"
  },
  {
    "surah_id": 74,
    "ayah_number": 8,
    "global_ayah_id": 5503,
    "translation": "Pa kad se puhne u nakur,"
  },
  {
    "surah_id": 74,
    "ayah_number": 9,
    "global_ayah_id": 5504,
    "translation": "Pa to će tad biti Dan težak,"
  },
  {
    "surah_id": 74,
    "ayah_number": 10,
    "global_ayah_id": 5505,
    "translation": "Za nevjernike lahak neće biti."
  },
  {
    "surah_id": 74,
    "ayah_number": 11,
    "global_ayah_id": 5506,
    "translation": "Ostavi Mene i kog sam stvorio sam,"
  },
  {
    "surah_id": 74,
    "ayah_number": 12,
    "global_ayah_id": 5507,
    "translation": "I načinio mu imetak ogroman,"
  },
  {
    "surah_id": 74,
    "ayah_number": 13,
    "global_ayah_id": 5508,
    "translation": "I sinove prisutnim (dao),"
  },
  {
    "surah_id": 74,
    "ayah_number": 14,
    "global_ayah_id": 5509,
    "translation": "I olakšao mu lahkoćom:"
  },
  {
    "surah_id": 74,
    "ayah_number": 15,
    "global_ayah_id": 5510,
    "translation": "Ponovo žudi da uvećam!"
  },
  {
    "surah_id": 74,
    "ayah_number": 16,
    "global_ayah_id": 5511,
    "translation": "Nikako! Uistinu, on je ajetima Našim prkosan,"
  },
  {
    "surah_id": 74,
    "ayah_number": 17,
    "global_ayah_id": 5512,
    "translation": "Opteretiću ga (teškim) usponom,"
  },
  {
    "surah_id": 74,
    "ayah_number": 18,
    "global_ayah_id": 5513,
    "translation": "Zaista je on smišljao i računao,"
  },
  {
    "surah_id": 74,
    "ayah_number": 19,
    "global_ayah_id": 5514,
    "translation": "Pa proklet bio kako je odredio,"
  },
  {
    "surah_id": 74,
    "ayah_number": 20,
    "global_ayah_id": 5515,
    "translation": "Ponovo, proklet bio kako je odredio!"
  },
  {
    "surah_id": 74,
    "ayah_number": 21,
    "global_ayah_id": 5516,
    "translation": "Zatim je pogledao,"
  },
  {
    "surah_id": 74,
    "ayah_number": 22,
    "global_ayah_id": 5517,
    "translation": "Onda se namrštio i smrknuo,"
  },
  {
    "surah_id": 74,
    "ayah_number": 23,
    "global_ayah_id": 5518,
    "translation": "Potom se okrenuo i uzoholio,"
  },
  {
    "surah_id": 74,
    "ayah_number": 24,
    "global_ayah_id": 5519,
    "translation": "Pa rekao: \"Ovo je samo sihr, prenosi se;"
  },
  {
    "surah_id": 74,
    "ayah_number": 25,
    "global_ayah_id": 5520,
    "translation": "Ovo je samo govor smrtnika.\""
  },
  {
    "surah_id": 74,
    "ayah_number": 26,
    "global_ayah_id": 5521,
    "translation": "Bacit ću ga sekaru!"
  },
  {
    "surah_id": 74,
    "ayah_number": 27,
    "global_ayah_id": 5522,
    "translation": "A šta znaš ti šta je Sekar?"
  },
  {
    "surah_id": 74,
    "ayah_number": 28,
    "global_ayah_id": 5523,
    "translation": "Neće poštediti, niti ostaviti,"
  },
  {
    "surah_id": 74,
    "ayah_number": 29,
    "global_ayah_id": 5524,
    "translation": "Palitelj je za smrtnika,"
  },
  {
    "surah_id": 74,
    "ayah_number": 30,
    "global_ayah_id": 5525,
    "translation": "Nad njim je devetnaest."
  },
  {
    "surah_id": 74,
    "ayah_number": 31,
    "global_ayah_id": 5526,
    "translation": "I učinili smo nadzornicima vatre samo meleke, i broj njihov učinili samo iskušenjem za one koji ne vjeruju: da se uvjere oni kojima je data Knjiga, i onima koji vjeruju poveća vjerovanje; i da ne sumnjaju oni kojima je data Knjiga i vjernici; i da kažu oni u srcima čijim je bolest i nevjernici: \"Šta želi Allah ovim primjerom?\" Tako zabluđuje Allah koga hoće, a upućuje koga hoće. A zna vojske Gospodara tvoga samo On; i ovo je samo opomena smrtnicima."
  },
  {
    "surah_id": 74,
    "ayah_number": 32,
    "global_ayah_id": 5527,
    "translation": "Nikako! Tako mi Mjeseca,"
  },
  {
    "surah_id": 74,
    "ayah_number": 33,
    "global_ayah_id": 5528,
    "translation": "I noći kad mine,"
  },
  {
    "surah_id": 74,
    "ayah_number": 34,
    "global_ayah_id": 5529,
    "translation": "I jutra kad zasjaji -"
  },
  {
    "surah_id": 74,
    "ayah_number": 35,
    "global_ayah_id": 5530,
    "translation": "Zaista je on jedan najveći,"
  },
  {
    "surah_id": 74,
    "ayah_number": 36,
    "global_ayah_id": 5531,
    "translation": "Upozorenje smrtnicima,"
  },
  {
    "surah_id": 74,
    "ayah_number": 37,
    "global_ayah_id": 5532,
    "translation": "Onom od vas ko hoće da napreduje ili zaostane."
  },
  {
    "surah_id": 74,
    "ayah_number": 38,
    "global_ayah_id": 5533,
    "translation": "Svaka duša je onom što je zaslužila - zalog,"
  },
  {
    "surah_id": 74,
    "ayah_number": 39,
    "global_ayah_id": 5534,
    "translation": "Osim drugova zdesna."
  },
  {
    "surah_id": 74,
    "ayah_number": 40,
    "global_ayah_id": 5535,
    "translation": "U baščama će se raspitivati,"
  },
  {
    "surah_id": 74,
    "ayah_number": 41,
    "global_ayah_id": 5536,
    "translation": "O prestupnicima:"
  },
  {
    "surah_id": 74,
    "ayah_number": 42,
    "global_ayah_id": 5537,
    "translation": "\"Šta vas je dovelo u sekar?\""
  },
  {
    "surah_id": 74,
    "ayah_number": 43,
    "global_ayah_id": 5538,
    "translation": "Reći će: \"Nismo bili od musallija,"
  },
  {
    "surah_id": 74,
    "ayah_number": 44,
    "global_ayah_id": 5539,
    "translation": "Niti smo hranili siromaha,"
  },
  {
    "surah_id": 74,
    "ayah_number": 45,
    "global_ayah_id": 5540,
    "translation": "I dangubili smo s dangubama,"
  },
  {
    "surah_id": 74,
    "ayah_number": 46,
    "global_ayah_id": 5541,
    "translation": "I poricali Dan sudnji,"
  },
  {
    "surah_id": 74,
    "ayah_number": 47,
    "global_ayah_id": 5542,
    "translation": "Dok nam nije došlo zagarantovano.\""
  },
  {
    "surah_id": 74,
    "ayah_number": 48,
    "global_ayah_id": 5543,
    "translation": "Tad im neće koristiti posredovanje posrednika."
  },
  {
    "surah_id": 74,
    "ayah_number": 49,
    "global_ayah_id": 5544,
    "translation": "Pa šta im je?, od Opomene su odvraćeni,"
  },
  {
    "surah_id": 74,
    "ayah_number": 50,
    "global_ayah_id": 5545,
    "translation": "Kao da su oni magarci preplašeni,"
  },
  {
    "surah_id": 74,
    "ayah_number": 51,
    "global_ayah_id": 5546,
    "translation": "Pobjegli od lava."
  },
  {
    "surah_id": 74,
    "ayah_number": 52,
    "global_ayah_id": 5547,
    "translation": "Naprotiv, svaki čovjek od njih želi da mu se daju listovi rašireni."
  },
  {
    "surah_id": 74,
    "ayah_number": 53,
    "global_ayah_id": 5548,
    "translation": "Nikako! Naprotiv! Ne plaše se Ahireta."
  },
  {
    "surah_id": 74,
    "ayah_number": 54,
    "global_ayah_id": 5549,
    "translation": "Nikako! Zaista je on Pouka,"
  },
  {
    "surah_id": 74,
    "ayah_number": 55,
    "global_ayah_id": 5550,
    "translation": "Pa ko htjedne imaće ga na umu,"
  },
  {
    "surah_id": 74,
    "ayah_number": 56,
    "global_ayah_id": 5551,
    "translation": "A poučit će se samo ako htjedne Allah. On je Vlasnik bogobojaznosti i Vlasnik oprosta."
  }
]