[
  {
    "surah_id": 74,
    "ayah_number": 1,
    "global_ayah_id": 5496,
    "translation": "망투를 걸친 자여"
  },
  {
    "surah_id": 74,
    "ayah_number": 2,
    "global_ayah_id": 5497,
    "translation": "일어나서 경고하라"
  },
  {
    "surah_id": 74,
    "ayah_number": 3,
    "global_ayah_id": 5498,
    "translation": "그리고 그대 주님만을 찬양하고"
  },
  {
    "surah_id": 74,
    "ayah_number": 4,
    "global_ayah_id": 5499,
    "translation": "그대의 망투를 청결케 할 것 이며"
  },
  {
    "surah_id": 74,
    "ayah_number": 5,
    "global_ayah_id": 5500,
    "translation": "부정한 것을 피하고"
  },
  {
    "surah_id": 74,
    "ayah_number": 6,
    "global_ayah_id": 5501,
    "translation": "필요 이상의 것을 주지 말며"
  },
  {
    "surah_id": 74,
    "ayah_number": 7,
    "global_ayah_id": 5502,
    "translation": "주님을 위해 인내하라"
  },
  {
    "surah_id": 74,
    "ayah_number": 8,
    "global_ayah_id": 5503,
    "translation": "나팔이 부는 그때"
  },
  {
    "surah_id": 74,
    "ayah_number": 9,
    "global_ayah_id": 5504,
    "translation": "그날은 곧 재앙의 날이 될 것이라"
  },
  {
    "surah_id": 74,
    "ayah_number": 10,
    "global_ayah_id": 5505,
    "translation": "그것은 불신자들을 위한 것 으로 평탄한 것이 아니라"
  },
  {
    "surah_id": 74,
    "ayah_number": 11,
    "global_ayah_id": 5506,
    "translation": "내가 홀로 창조한 그를 내게맡기라"
  },
  {
    "surah_id": 74,
    "ayah_number": 12,
    "global_ayah_id": 5507,
    "translation": "실로 나는 그에게 풍성함을 베풀어 주었고"
  },
  {
    "surah_id": 74,
    "ayah_number": 13,
    "global_ayah_id": 5508,
    "translation": "자손들이 그와 함께 거주하 게 하였으니"
  },
  {
    "surah_id": 74,
    "ayah_number": 14,
    "global_ayah_id": 5509,
    "translation": "내가 그에게 안락한 생활을 베풀었노라"
  },
  {
    "surah_id": 74,
    "ayah_number": 15,
    "global_ayah_id": 5510,
    "translation": "그런데도 그는 내가 더하여 주기를 바라고 있느뇨"
  },
  {
    "surah_id": 74,
    "ayah_number": 16,
    "global_ayah_id": 5511,
    "translation": "결코 그렇게 될 수 없나니 하나님의 예증들을 거역하였노라"
  },
  {
    "surah_id": 74,
    "ayah_number": 17,
    "global_ayah_id": 5512,
    "translation": "곧 내가 그에게 산더미 같은재앙들을 가져다 주리라"
  },
  {
    "surah_id": 74,
    "ayah_number": 18,
    "global_ayah_id": 5513,
    "translation": "그는 숙고하고서도 음모하 였으니"
  },
  {
    "surah_id": 74,
    "ayah_number": 19,
    "global_ayah_id": 5514,
    "translation": "음모한 그에게 재앙이 있으 리라"
  },
  {
    "surah_id": 74,
    "ayah_number": 20,
    "global_ayah_id": 5515,
    "translation": "그러하니라 음모하는 자에게재앙이 있을 것이라"
  },
  {
    "surah_id": 74,
    "ayah_number": 21,
    "global_ayah_id": 5516,
    "translation": "그런 후 그는 생각하고"
  },
  {
    "surah_id": 74,
    "ayah_number": 22,
    "global_ayah_id": 5517,
    "translation": "눈살을 찌푸리고 불쾌한 표 정을 하더라"
  },
  {
    "surah_id": 74,
    "ayah_number": 23,
    "global_ayah_id": 5518,
    "translation": "외면하며 오만해 하더라"
  },
  {
    "surah_id": 74,
    "ayah_number": 24,
    "global_ayah_id": 5519,
    "translation": "이것은 옛 선조들로부터 유 래된 마술에 불과하다고 말하고"
  },
  {
    "surah_id": 74,
    "ayah_number": 25,
    "global_ayah_id": 5520,
    "translation": "이것은 한 인간의 말에 불과하다고 하였더라"
  },
  {
    "surah_id": 74,
    "ayah_number": 26,
    "global_ayah_id": 5521,
    "translation": "그러므로 내가 곧 그를 볼지옥으로 이르게 하리라"
  },
  {
    "surah_id": 74,
    "ayah_number": 27,
    "global_ayah_id": 5522,
    "translation": "그 불지옥이 무엇인지 무엇 이 그대에게 설명하여 주리요"
  },
  {
    "surah_id": 74,
    "ayah_number": 28,
    "global_ayah_id": 5523,
    "translation": "그것은 아무것도 남기지 아 니하면 어느 누구도 남겨두지 아 니한 곳으로"
  },
  {
    "surah_id": 74,
    "ayah_number": 29,
    "global_ayah_id": 5524,
    "translation": "인간을 그슬러 버리며"
  },
  {
    "surah_id": 74,
    "ayah_number": 30,
    "global_ayah_id": 5525,
    "translation": "그 위에는 열 아홉이 있노라"
  },
  {
    "surah_id": 74,
    "ayah_number": 31,
    "global_ayah_id": 5526,
    "translation": "하나님은 천사들을 불지옥의수호자들로 두었노라 그 숫자를 둔 것은 믿지 아니한 불신자들을 위한 시련으로써 그리고 성서의 백성들을 확신시키고 믿는 사람들의 신앙을 더하며 성서의 백성들 과 믿는 신도들이 의심하지 아니 하고 마음이 병든 자들과 불신자 들이 하나님은 이 비유로 무엇을 의도하려 하느뇨 라고 말하는 그 들을 시험하기 위해서라 이렇듯 하나님은 그분이 원하는 자를 방 황케 하사 그분이 원하는 자를 인도하시니 그분 외에는 어느 누구 도 주님의 수호자들을 알 수 없 노라 이것은 인간을 위한 교훈에 불과하니라"
  },
  {
    "surah_id": 74,
    "ayah_number": 32,
    "global_ayah_id": 5527,
    "translation": "달을 두고 맹세하사"
  },
  {
    "surah_id": 74,
    "ayah_number": 33,
    "global_ayah_id": 5528,
    "translation": "사라져 가는 밤을 두고 맹세하며"
  },
  {
    "surah_id": 74,
    "ayah_number": 34,
    "global_ayah_id": 5529,
    "translation": "빛나는 아침을 두고 맹세하 나니"
  },
  {
    "surah_id": 74,
    "ayah_number": 35,
    "global_ayah_id": 5530,
    "translation": "실로 그것은 가장 중대한 재앙 중의 하나라"
  },
  {
    "surah_id": 74,
    "ayah_number": 36,
    "global_ayah_id": 5531,
    "translation": "그것은 인간을 위한 하나의 경고로"
  },
  {
    "surah_id": 74,
    "ayah_number": 37,
    "global_ayah_id": 5532,
    "translation": "너희 중에 앞서려는 자와 유예하려는 자들을 위한 것이라"
  },
  {
    "surah_id": 74,
    "ayah_number": 38,
    "global_ayah_id": 5533,
    "translation": "모든 인간은 그가 행한 행위 에 의해 저당이 되나"
  },
  {
    "surah_id": 74,
    "ayah_number": 39,
    "global_ayah_id": 5534,
    "translation": "우편의 동료들은 제외로"
  },
  {
    "surah_id": 74,
    "ayah_number": 40,
    "global_ayah_id": 5535,
    "translation": "이들은 천국으로 들어가 서 로가 서로에게 질문을 하며"
  },
  {
    "surah_id": 74,
    "ayah_number": 41,
    "global_ayah_id": 5536,
    "translation": "죄인들에 관하여 묻고"
  },
  {
    "surah_id": 74,
    "ayah_number": 42,
    "global_ayah_id": 5537,
    "translation": "무엇이 너희로 하여금 불지 옥에 들게 하였느뇨 라고 물으니"
  },
  {
    "surah_id": 74,
    "ayah_number": 43,
    "global_ayah_id": 5538,
    "translation": "그들은 대답하길 저희는 예 배하는 자 중에 있지 아니하였으 며"
  },
  {
    "surah_id": 74,
    "ayah_number": 44,
    "global_ayah_id": 5539,
    "translation": "가난한 사람들에게 자선을 베풀지 아니하고"
  },
  {
    "surah_id": 74,
    "ayah_number": 45,
    "global_ayah_id": 5540,
    "translation": "무익한 잡담을 하는 자들과 공론을 하곤 했으며"
  },
  {
    "surah_id": 74,
    "ayah_number": 46,
    "global_ayah_id": 5541,
    "translation": "심판의 날을 믿지 않고"
  },
  {
    "surah_id": 74,
    "ayah_number": 47,
    "global_ayah_id": 5542,
    "translation": "심판의 날이 온다는 것을 부 인하였습니까"
  },
  {
    "surah_id": 74,
    "ayah_number": 48,
    "global_ayah_id": 5543,
    "translation": "그리하여 어떤 중재자들의 중재도 그들에게 유용하지 못하리라"
  },
  {
    "surah_id": 74,
    "ayah_number": 49,
    "global_ayah_id": 5544,
    "translation": "교훈을 거역한 그들이 어떻 게 되었느뇨"
  },
  {
    "surah_id": 74,
    "ayah_number": 50,
    "global_ayah_id": 5545,
    "translation": "그들은 마치 놀란 당나귀들 이"
  },
  {
    "surah_id": 74,
    "ayah_number": 51,
    "global_ayah_id": 5546,
    "translation": "한마리의 사자에 놀라 도망 치는 것과 같더라"
  },
  {
    "surah_id": 74,
    "ayah_number": 52,
    "global_ayah_id": 5547,
    "translation": "실로 이들 각자는 펼쳐진 성서가 그들에게도 내려지기를 원하고 있느뇨"
  },
  {
    "surah_id": 74,
    "ayah_number": 53,
    "global_ayah_id": 5548,
    "translation": "그것은 불가능한 것으로 그 들은 내세를 두려워 하지 않노라"
  },
  {
    "surah_id": 74,
    "ayah_number": 54,
    "global_ayah_id": 5549,
    "translation": "실로 이것이 교훈이니"
  },
  {
    "surah_id": 74,
    "ayah_number": 55,
    "global_ayah_id": 5550,
    "translation": "그것을 지키려 하는 자 그것을 기억케 하리라"
  },
  {
    "surah_id": 74,
    "ayah_number": 56,
    "global_ayah_id": 5551,
    "translation": "그러나 하나님이 원하는 자 외에는 어느 누구도 그것을 기억 하려 하지 아니 하리라 그분은 두려워 해야 할 주님이요 관용의 주님이시라"
  }
]