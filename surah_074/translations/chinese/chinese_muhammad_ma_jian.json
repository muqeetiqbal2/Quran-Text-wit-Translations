[
  {
    "surah_id": 74,
    "ayah_number": 1,
    "global_ayah_id": 5496,
    "translation": "蓋被的人啊！"
  },
  {
    "surah_id": 74,
    "ayah_number": 2,
    "global_ayah_id": 5497,
    "translation": "你應當起來，你應當警告，"
  },
  {
    "surah_id": 74,
    "ayah_number": 3,
    "global_ayah_id": 5498,
    "translation": "你應當頌揚你的主宰，"
  },
  {
    "surah_id": 74,
    "ayah_number": 4,
    "global_ayah_id": 5499,
    "translation": "你應當洗滌你的衣服，"
  },
  {
    "surah_id": 74,
    "ayah_number": 5,
    "global_ayah_id": 5500,
    "translation": "你應當遠離污穢，"
  },
  {
    "surah_id": 74,
    "ayah_number": 6,
    "global_ayah_id": 5501,
    "translation": "你不要施恩而求厚報，"
  },
  {
    "surah_id": 74,
    "ayah_number": 7,
    "global_ayah_id": 5502,
    "translation": "你應當為你的主而堅忍。"
  },
  {
    "surah_id": 74,
    "ayah_number": 8,
    "global_ayah_id": 5503,
    "translation": "當號角被吹嚮的時候，"
  },
  {
    "surah_id": 74,
    "ayah_number": 9,
    "global_ayah_id": 5504,
    "translation": "在那時，將有一個艱難的日子。"
  },
  {
    "surah_id": 74,
    "ayah_number": 10,
    "global_ayah_id": 5505,
    "translation": "那個日子對不信道的人們，是不容易渡過的。"
  },
  {
    "surah_id": 74,
    "ayah_number": 11,
    "global_ayah_id": 5506,
    "translation": "你讓我獨自處治我所創造的那個人吧！"
  },
  {
    "surah_id": 74,
    "ayah_number": 12,
    "global_ayah_id": 5507,
    "translation": "我賞賜他豐富的財產，"
  },
  {
    "surah_id": 74,
    "ayah_number": 13,
    "global_ayah_id": 5508,
    "translation": "和在跟前的子嗣，"
  },
  {
    "surah_id": 74,
    "ayah_number": 14,
    "global_ayah_id": 5509,
    "translation": "我提高了他的聲望，"
  },
  {
    "surah_id": 74,
    "ayah_number": 15,
    "global_ayah_id": 5510,
    "translation": "而他還冀望我再多加賞賜。"
  },
  {
    "surah_id": 74,
    "ayah_number": 16,
    "global_ayah_id": 5511,
    "translation": "絕不然，他確實是反對我的跡象的，"
  },
  {
    "surah_id": 74,
    "ayah_number": 17,
    "global_ayah_id": 5512,
    "translation": "我將使他遭受苦難。"
  },
  {
    "surah_id": 74,
    "ayah_number": 18,
    "global_ayah_id": 5513,
    "translation": "他碓已思考，確已計劃。"
  },
  {
    "surah_id": 74,
    "ayah_number": 19,
    "global_ayah_id": 5514,
    "translation": "但無論他怎樣計劃，他是被棄絕的。"
  },
  {
    "surah_id": 74,
    "ayah_number": 20,
    "global_ayah_id": 5515,
    "translation": "無論他怎樣計劃，他終是被棄絕的。"
  },
  {
    "surah_id": 74,
    "ayah_number": 21,
    "global_ayah_id": 5516,
    "translation": "他看一看，"
  },
  {
    "surah_id": 74,
    "ayah_number": 22,
    "global_ayah_id": 5517,
    "translation": "然後皺眉蹙額，"
  },
  {
    "surah_id": 74,
    "ayah_number": 23,
    "global_ayah_id": 5518,
    "translation": "然後高傲地轉過身去，"
  },
  {
    "surah_id": 74,
    "ayah_number": 24,
    "global_ayah_id": 5519,
    "translation": "而且說：「這只是傳習的魔術，"
  },
  {
    "surah_id": 74,
    "ayah_number": 25,
    "global_ayah_id": 5520,
    "translation": "這只是凡人的言辭。」"
  },
  {
    "surah_id": 74,
    "ayah_number": 26,
    "global_ayah_id": 5521,
    "translation": "我將使他墮入火獄，"
  },
  {
    "surah_id": 74,
    "ayah_number": 27,
    "global_ayah_id": 5522,
    "translation": "你怎能知道火獄是什麼？"
  },
  {
    "surah_id": 74,
    "ayah_number": 28,
    "global_ayah_id": 5523,
    "translation": "它不讓任何物存在，不許任何物留下，"
  },
  {
    "surah_id": 74,
    "ayah_number": 29,
    "global_ayah_id": 5524,
    "translation": "它燒灼肌膚。"
  },
  {
    "surah_id": 74,
    "ayah_number": 30,
    "global_ayah_id": 5525,
    "translation": "管理它的，共計十九名。"
  },
  {
    "surah_id": 74,
    "ayah_number": 31,
    "global_ayah_id": 5526,
    "translation": "我只將管理火獄的成天神，我只以他們的數目，考驗不信道的人們，以便曾受天經的人們認清，而信道的人們更加篤信；以免曾受天經的人們和信道的人們懷疑；以便心中有病者和不信道者說：「真主設這個譬喻做什麼？」真主這樣使他所意欲的人誤入迷途，使他所意欲的人遵循正路。只有你的主，能知道他的軍隊，這只是人類的教訓。"
  },
  {
    "surah_id": 74,
    "ayah_number": 32,
    "global_ayah_id": 5527,
    "translation": "真的，以月亮盟誓，"
  },
  {
    "surah_id": 74,
    "ayah_number": 33,
    "global_ayah_id": 5528,
    "translation": "以逝去的黑夜盟誓，"
  },
  {
    "surah_id": 74,
    "ayah_number": 34,
    "global_ayah_id": 5529,
    "translation": "以顯照的黎明盟誓，"
  },
  {
    "surah_id": 74,
    "ayah_number": 35,
    "global_ayah_id": 5530,
    "translation": "火獄確是一個大難，"
  },
  {
    "surah_id": 74,
    "ayah_number": 36,
    "global_ayah_id": 5531,
    "translation": "可以警告人類，"
  },
  {
    "surah_id": 74,
    "ayah_number": 37,
    "global_ayah_id": 5532,
    "translation": "警告你們中欲前進者或欲後退者；"
  },
  {
    "surah_id": 74,
    "ayah_number": 38,
    "global_ayah_id": 5533,
    "translation": "各人將因自己的營謀而作抵押，"
  },
  {
    "surah_id": 74,
    "ayah_number": 39,
    "global_ayah_id": 5534,
    "translation": "惟幸福的人們除外。"
  },
  {
    "surah_id": 74,
    "ayah_number": 40,
    "global_ayah_id": 5535,
    "translation": "他們在樂園中互相詢問，"
  },
  {
    "surah_id": 74,
    "ayah_number": 41,
    "global_ayah_id": 5536,
    "translation": "問犯罪人們的情狀，"
  },
  {
    "surah_id": 74,
    "ayah_number": 42,
    "global_ayah_id": 5537,
    "translation": "「你們為什麼墮入火獄呢？」"
  },
  {
    "surah_id": 74,
    "ayah_number": 43,
    "global_ayah_id": 5538,
    "translation": "他們說：「我們沒有禮拜，"
  },
  {
    "surah_id": 74,
    "ayah_number": 44,
    "global_ayah_id": 5539,
    "translation": "也沒有濟貧，"
  },
  {
    "surah_id": 74,
    "ayah_number": 45,
    "global_ayah_id": 5540,
    "translation": "我們與妄言的人們一道妄言，"
  },
  {
    "surah_id": 74,
    "ayah_number": 46,
    "global_ayah_id": 5541,
    "translation": "我們否認報應日，"
  },
  {
    "surah_id": 74,
    "ayah_number": 47,
    "global_ayah_id": 5542,
    "translation": "一直到死亡降臨了我們。」"
  },
  {
    "surah_id": 74,
    "ayah_number": 48,
    "global_ayah_id": 5543,
    "translation": "說情者的說情，將無益於他們。"
  },
  {
    "surah_id": 74,
    "ayah_number": 49,
    "global_ayah_id": 5544,
    "translation": "他們怎麼退避這教訓呢？"
  },
  {
    "surah_id": 74,
    "ayah_number": 50,
    "global_ayah_id": 5545,
    "translation": "他們好像一群驚慌的驢子，"
  },
  {
    "surah_id": 74,
    "ayah_number": 51,
    "global_ayah_id": 5546,
    "translation": "剛逃避了一隻獅子一樣。"
  },
  {
    "surah_id": 74,
    "ayah_number": 52,
    "global_ayah_id": 5547,
    "translation": "不然，他們中的每個人都希望獲得一些展開的天經。"
  },
  {
    "surah_id": 74,
    "ayah_number": 53,
    "global_ayah_id": 5548,
    "translation": "絕不然，他們不畏懼後世！"
  },
  {
    "surah_id": 74,
    "ayah_number": 54,
    "global_ayah_id": 5549,
    "translation": "真的，這《古蘭經》確是一個教誨！"
  },
  {
    "surah_id": 74,
    "ayah_number": 55,
    "global_ayah_id": 5550,
    "translation": "誰願意，誰記憶它，"
  },
  {
    "surah_id": 74,
    "ayah_number": 56,
    "global_ayah_id": 5551,
    "translation": "他們只因真主的意欲而記憶它。他是應受敬畏的，他是宜於赦宥的。"
  }
]