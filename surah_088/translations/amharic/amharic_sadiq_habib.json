[
  {
    "surah_id": 88,
    "ayah_number": 1,
    "global_ayah_id": 5968,
    "translation": "የሸፋኝቱ (ትንሣኤ) ወሬ መጣህን?"
  },
  {
    "surah_id": 88,
    "ayah_number": 2,
    "global_ayah_id": 5969,
    "translation": "ፊቶች በዚያ ቀን ተዋራጆች ናቸው፡፡"
  },
  {
    "surah_id": 88,
    "ayah_number": 3,
    "global_ayah_id": 5970,
    "translation": "ሠሪዎች ለፊዎች ናቸው፡፡"
  },
  {
    "surah_id": 88,
    "ayah_number": 4,
    "global_ayah_id": 5971,
    "translation": "ተኳሳን እሳት ይገባሉ፡፡"
  },
  {
    "surah_id": 88,
    "ayah_number": 5,
    "global_ayah_id": 5972,
    "translation": "በጣም ከፈላች ምንጭ ይጋታሉ፡፡"
  },
  {
    "surah_id": 88,
    "ayah_number": 6,
    "global_ayah_id": 5973,
    "translation": "ለእነርሱ ዶሪዕ ከሚባል (እሾሃም) ዛፍ እንጅ ሌላ ምግብ የላቸውም፡፡"
  },
  {
    "surah_id": 88,
    "ayah_number": 7,
    "global_ayah_id": 5974,
    "translation": "የማያሰባ ከረኃብም የማያብቃቃ ከኾነው፡፡"
  },
  {
    "surah_id": 88,
    "ayah_number": 8,
    "global_ayah_id": 5975,
    "translation": "ፊቶች በዚያ ቀን ተቀማጣዮች ናቸው፡፡"
  },
  {
    "surah_id": 88,
    "ayah_number": 9,
    "global_ayah_id": 5976,
    "translation": "ለሥራቸው ተደሳቾች ናቸው፡፡"
  },
  {
    "surah_id": 88,
    "ayah_number": 10,
    "global_ayah_id": 5977,
    "translation": "በከፍተኛ ገነት ውስጥ ናቸው፡፡"
  },
  {
    "surah_id": 88,
    "ayah_number": 11,
    "global_ayah_id": 5978,
    "translation": "በውስጧ ውድቅን ነገር አይሰሙም፡፡"
  },
  {
    "surah_id": 88,
    "ayah_number": 12,
    "global_ayah_id": 5979,
    "translation": "በውስጧ ፈሳሾች ምንጮች አልሉ፡፡"
  },
  {
    "surah_id": 88,
    "ayah_number": 13,
    "global_ayah_id": 5980,
    "translation": "በውስጧ ከፍ የተደረጉ አልጋዎች አልሉ፡፡"
  },
  {
    "surah_id": 88,
    "ayah_number": 14,
    "global_ayah_id": 5981,
    "translation": "በተርታ የተኖሩ ብርጭቆዎችም፡፡"
  },
  {
    "surah_id": 88,
    "ayah_number": 15,
    "global_ayah_id": 5982,
    "translation": "የተደረደሩ መከዳዎችም፡፡"
  },
  {
    "surah_id": 88,
    "ayah_number": 16,
    "global_ayah_id": 5983,
    "translation": "የተነጠፉ ስጋጃዎችም (አልሉ)፡፡"
  },
  {
    "surah_id": 88,
    "ayah_number": 17,
    "global_ayah_id": 5984,
    "translation": "(ከሓዲዎች) አይመለከቱምን? ወደ ግመል እንዴት እነደተፈጠረች!"
  },
  {
    "surah_id": 88,
    "ayah_number": 18,
    "global_ayah_id": 5985,
    "translation": "ወደ ሰማይም እንዴት ከፍ እንደ ተደረገች!"
  },
  {
    "surah_id": 88,
    "ayah_number": 19,
    "global_ayah_id": 5986,
    "translation": "ወደ ተራራዎችም እንዴት እንደ ተቸከሉ!"
  },
  {
    "surah_id": 88,
    "ayah_number": 20,
    "global_ayah_id": 5987,
    "translation": "ወደ ምድርም እንዴ እንደተዘረጋች (አይመለከቱምን?)"
  },
  {
    "surah_id": 88,
    "ayah_number": 21,
    "global_ayah_id": 5988,
    "translation": "አስታውስም፤ አንተ አስታዋሽ ብቻ ነህና፡፡"
  },
  {
    "surah_id": 88,
    "ayah_number": 22,
    "global_ayah_id": 5989,
    "translation": "በእነርሱ ላይ ተሿሚ (አስገዳጅ) አይደለህም፡፡"
  },
  {
    "surah_id": 88,
    "ayah_number": 23,
    "global_ayah_id": 5990,
    "translation": "ግን (ከእውነት) የዞረና የካደ ሰው፤"
  },
  {
    "surah_id": 88,
    "ayah_number": 24,
    "global_ayah_id": 5991,
    "translation": "አላህ ታላቁን ቅጣት ይቀጣዋል፡፡"
  },
  {
    "surah_id": 88,
    "ayah_number": 25,
    "global_ayah_id": 5992,
    "translation": "መመለሻቸው ወደእኛ ብቻ ነው፡፡"
  },
  {
    "surah_id": 88,
    "ayah_number": 26,
    "global_ayah_id": 5993,
    "translation": "ከዚያም ምርመራቸው በእኛ ላይ ብቻ ነው፡፡"
  }
]