[
  {
    "surah_id": 88,
    "ayah_number": 1,
    "global_ayah_id": 5968,
    "translation": "저항할 수 없는 재앙의 소식이 그대에게 이르렀느뇨"
  },
  {
    "surah_id": 88,
    "ayah_number": 2,
    "global_ayah_id": 5969,
    "translation": "그날 굴욕을 맛볼 얼굴들이 있나니"
  },
  {
    "surah_id": 88,
    "ayah_number": 3,
    "global_ayah_id": 5970,
    "translation": "심한 노동으로 지친 상태에서"
  },
  {
    "surah_id": 88,
    "ayah_number": 4,
    "global_ayah_id": 5971,
    "translation": "그들이 불지윽으로 들어가니"
  },
  {
    "surah_id": 88,
    "ayah_number": 5,
    "global_ayah_id": 5972,
    "translation": "끓고 있는 화염의 물을 마시 게 되도다"
  },
  {
    "surah_id": 88,
    "ayah_number": 6,
    "global_ayah_id": 5973,
    "translation": "모진 가시 외에는 그들을 위 한 음식도 없으니"
  },
  {
    "surah_id": 88,
    "ayah_number": 7,
    "global_ayah_id": 5974,
    "translation": "영양이 없어 굶주림에 무익할뿐이라"
  },
  {
    "surah_id": 88,
    "ayah_number": 8,
    "global_ayah_id": 5975,
    "translation": "그러나 그날 기쁨을 만끽할 얼굴들이 있나니"
  },
  {
    "surah_id": 88,
    "ayah_number": 9,
    "global_ayah_id": 5976,
    "translation": "그들은 그들의 노력으로 기뻐하며"
  },
  {
    "surah_id": 88,
    "ayah_number": 10,
    "global_ayah_id": 5977,
    "translation": "높이 있는 천국으로 들어가매"
  },
  {
    "surah_id": 88,
    "ayah_number": 11,
    "global_ayah_id": 5978,
    "translation": "그들은 무익한 말한마디 듣 지 아니하며"
  },
  {
    "surah_id": 88,
    "ayah_number": 12,
    "global_ayah_id": 5979,
    "translation": "그곳에는 흐르는 샘물이 있고"
  },
  {
    "surah_id": 88,
    "ayah_number": 13,
    "global_ayah_id": 5980,
    "translation": "높은 곳에 있는 안락 의자에 앉으니"
  },
  {
    "surah_id": 88,
    "ayah_number": 14,
    "global_ayah_id": 5981,
    "translation": "이미 준비된 잔들이 있노라"
  },
  {
    "surah_id": 88,
    "ayah_number": 15,
    "global_ayah_id": 5982,
    "translation": "안락한 베개들이 줄지어 있고"
  },
  {
    "surah_id": 88,
    "ayah_number": 16,
    "global_ayah_id": 5983,
    "translation": "화려한 융단이 펼쳐져 있노라"
  },
  {
    "surah_id": 88,
    "ayah_number": 17,
    "global_ayah_id": 5984,
    "translation": "낙타가 어떻게 창조되었는지 그들은 숙고하지 않느뇨"
  },
  {
    "surah_id": 88,
    "ayah_number": 18,
    "global_ayah_id": 5985,
    "translation": "하늘은 어떻게 높이 올려졌 으며"
  },
  {
    "surah_id": 88,
    "ayah_number": 19,
    "global_ayah_id": 5986,
    "translation": "산들은 어떻게 고정되었고"
  },
  {
    "surah_id": 88,
    "ayah_number": 20,
    "global_ayah_id": 5987,
    "translation": "대지는 어떻게 펼쳐졌는가를 숙고하지 않느뇨"
  },
  {
    "surah_id": 88,
    "ayah_number": 21,
    "global_ayah_id": 5988,
    "translation": "경고하라 실로 그대는 경고 자일 뿐으로"
  },
  {
    "surah_id": 88,
    "ayah_number": 22,
    "global_ayah_id": 5989,
    "translation": "인간을 감독하며 강요하는 자가 아니라"
  },
  {
    "surah_id": 88,
    "ayah_number": 23,
    "global_ayah_id": 5990,
    "translation": "그러나 외면하고 하나님을 불신한 자 있다면"
  },
  {
    "surah_id": 88,
    "ayah_number": 24,
    "global_ayah_id": 5991,
    "translation": "하나님께서 그에게 큰 벌을내리실 것이요"
  },
  {
    "surah_id": 88,
    "ayah_number": 25,
    "global_ayah_id": 5992,
    "translation": "그들이 하나님에게 돌아오하니"
  },
  {
    "surah_id": 88,
    "ayah_number": 26,
    "global_ayah_id": 5993,
    "translation": "그들을 불러 계산하리라"
  }
]