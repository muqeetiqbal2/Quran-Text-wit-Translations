    "translation": "Цхьа яххьаш оцу дийнахь сийсаза хир ю‚"
  },
  {
    "surah_id": 88,
    "ayah_number": 3,
    "global_ayah_id": 5970,
    "translation": "Болх беш‚ кIадъелла‚"
  },
  {
    "surah_id": 88,
    "ayah_number": 4,
    "global_ayah_id": 5971,
    "translation": "Евхачу цIергахь егаш‚"
  },
  {
    "surah_id": 88,
    "ayah_number": 5,
    "global_ayah_id": 5972,
    "translation": "Шайна цIийдинчу хьастера хи малош."
  },
  {
    "surah_id": 88,
    "ayah_number": 6,
    "global_ayah_id": 5973,
    "translation": "Даар хир дац царна кIохцалех бен."
  },
  {
    "surah_id": 88,
    "ayah_number": 7,
