  {
    "surah_id": 88,
    "ayah_number": 21,
    "global_ayah_id": 5988,
    "translation": "Хьахаде /хIай Мухьаммад/! Хьо баккъалла а, хьехамча ма ву-й!"
  },
  {
    "surah_id": 88,
    "ayah_number": 22,
    "global_ayah_id": 5989,
    "translation": "Хьо царна тIе хIоттина хьекам ма вац."
  },
  {
    "surah_id": 88,
    "ayah_number": 23,
    "global_ayah_id": 5990,
    "translation": "Ша дIавирзинарг /хьехамах/‚ керстаналла динарг а воцучунна /хьехам бе/."
  },
  {
    "surah_id": 88,
    "ayah_number": 24,
    "global_ayah_id": 5991,
    "translation": "Цуна Дала Iазап дийр ду вуно доккхачу Iазапаца."
  },
  {
    "surah_id": 88,
    "ayah_number": 25,
    "global_ayah_id": 5992,
    "translation": "Баккъалла а, Тхуна тIе церан дIаберзар ду."
  },
  {
    "surah_id": 88,
    "ayah_number": 26,
