  {
    "surah_id": 88,
    "ayah_number": 1,
    "global_ayah_id": 5968,
    "translation": "Хьоьга деъний /хIай Мухьаммад/ дIалоцучун хабар?"
  },
  {
    "surah_id": 88,
    "ayah_number": 2,
