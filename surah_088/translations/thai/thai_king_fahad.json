[
  {
    "surah_id": 88,
    "ayah_number": 1,
    "global_ayah_id": 5968,
    "translation": "ข่าวคราวของการครอบงำ (แห่งความรุนแรง) ได้มายังเจ้าแล้วมิใช่หรือ ?"
  },
  {
    "surah_id": 88,
    "ayah_number": 2,
    "global_ayah_id": 5969,
    "translation": "ในวันนั้นมีหลายใบหน้าที่ต่ำต้อย"
  },
  {
    "surah_id": 88,
    "ayah_number": 3,
    "global_ayah_id": 5970,
    "translation": "ใบหน้าที่ทำงานหนัก ระกำใจ"
  },
  {
    "surah_id": 88,
    "ayah_number": 4,
    "global_ayah_id": 5971,
    "translation": "เข้าไปเผาไหม้ในไฟอันร้อนแรง"
  },
  {
    "surah_id": 88,
    "ayah_number": 5,
    "global_ayah_id": 5972,
    "translation": "จะถูกให้ดื่มจากน้ำพุที่ร้อนจัด"
  },
  {
    "surah_id": 88,
    "ayah_number": 6,
    "global_ayah_id": 5973,
    "translation": "ไม่มีอาหารอื่นนอกจากต้นหนามแห้ง"
  },
  {
    "surah_id": 88,
    "ayah_number": 7,
    "global_ayah_id": 5974,
    "translation": "มันจะไม่ทำให้อ้วน และไม่ทำให้หายหิว"
  },
  {
    "surah_id": 88,
    "ayah_number": 8,
    "global_ayah_id": 5975,
    "translation": "ในวันนั้นมีหลายใบหน้าที่เบิกบาน"
  },
  {
    "surah_id": 88,
    "ayah_number": 9,
    "global_ayah_id": 5976,
    "translation": "พึงพอใจเพราะการกระทำของพวกเขา"
  },
  {
    "surah_id": 88,
    "ayah_number": 10,
    "global_ayah_id": 5977,
    "translation": "อยู่ในสวนสวรรค์อันสูงตระหง่าน"
  },
  {
    "surah_id": 88,
    "ayah_number": 11,
    "global_ayah_id": 5978,
    "translation": "จะไม่ได้ยินเรื่องไร้สาระในนั้น"
  },
  {
    "surah_id": 88,
    "ayah_number": 12,
    "global_ayah_id": 5979,
    "translation": "ในนั้นมีตาน้ำไหลริน"
  },
  {
    "surah_id": 88,
    "ayah_number": 13,
    "global_ayah_id": 5980,
    "translation": "ในนั้นมีเตียงที่ถูกยกไว้สูงเด่น"
  },
  {
    "surah_id": 88,
    "ayah_number": 14,
    "global_ayah_id": 5981,
    "translation": "และมีแก้วน้ำถูกวางไว้"
  },
  {
    "surah_id": 88,
    "ayah_number": 15,
    "global_ayah_id": 5982,
    "translation": "และมีหมอนอิงถูกเรียงไว้เป็นแถว"
  },
  {
    "surah_id": 88,
    "ayah_number": 16,
    "global_ayah_id": 5983,
    "translation": "และมีพรมอย่างดีเลิศถูกปูไว้"
  },
  {
    "surah_id": 88,
    "ayah_number": 17,
    "global_ayah_id": 5984,
    "translation": "พวกเขาไม่พิจารณาดูอูฐดอกหรือว่า มันถูกบังเกิดมาอย่างไร ?"
  },
  {
    "surah_id": 88,
    "ayah_number": 18,
    "global_ayah_id": 5985,
    "translation": "และยังท้องฟ้าบ้างหรือว่ามันถูกยกให้สูงขึ้นอย่างไร ?"
  },
  {
    "surah_id": 88,
    "ayah_number": 19,
    "global_ayah_id": 5986,
    "translation": "และยังภูเขาบ้างหรือว่า มันถูกปักตั้งไว้อย่างไร ?"
  },
  {
    "surah_id": 88,
    "ayah_number": 20,
    "global_ayah_id": 5987,
    "translation": "และยังแผ่นดินบ้างหรือว่ามันถูกแผ่ลาดไว้อย่างไร ?"
  },
  {
    "surah_id": 88,
    "ayah_number": 21,
    "global_ayah_id": 5988,
    "translation": "ดังนั้นจงตักเตือนเถิด เพราะแท้จริงเจ้าเป็นเพียงผู้ตักเตือนเท่านั้น"
  },
  {
    "surah_id": 88,
    "ayah_number": 22,
    "global_ayah_id": 5989,
    "translation": "เจ้ามิใช่ผู้มีอำนาจเหนือพวกเขา"
  },
  {
    "surah_id": 88,
    "ayah_number": 23,
    "global_ayah_id": 5990,
    "translation": "นอกจากผู้ที่ผินหลังให้และปฏิเสธศรัทธาเท่านั้น"
  },
  {
    "surah_id": 88,
    "ayah_number": 24,
    "global_ayah_id": 5991,
    "translation": "อัลลอฮฺจะทรงลงโทษเขาซึ่งการลงโทษอันมหันต์"
  },
  {
    "surah_id": 88,
    "ayah_number": 25,
    "global_ayah_id": 5992,
    "translation": "แท้จริง ยังเราเท่านั้นคือการกลับมาของพวกเขา"
  },
  {
    "surah_id": 88,
    "ayah_number": 26,
    "global_ayah_id": 5993,
    "translation": "แล้วก็แท้จริง หน้าที่ของเรานั้นคือ การชำระพวกเขา"
  }
]