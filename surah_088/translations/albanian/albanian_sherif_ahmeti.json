[
  {
    "surah_id": 88,
    "ayah_number": 1,
    "global_ayah_id": 5968,
    "translation": "A të erdhi ty lajmi për belanë që kaplon (kijameti)?"
  },
  {
    "surah_id": 88,
    "ayah_number": 2,
    "global_ayah_id": 5969,
    "translation": "Atë ditë sheh fytyra të përulura,"
  },
  {
    "surah_id": 88,
    "ayah_number": 3,
    "global_ayah_id": 5970,
    "translation": "Të lodhura e të rraskapitura (nga mundimi)."
  },
  {
    "surah_id": 88,
    "ayah_number": 4,
    "global_ayah_id": 5971,
    "translation": "Ato hyjnë në zjarrin të ndezur fort,"
  },
  {
    "surah_id": 88,
    "ayah_number": 5,
    "global_ayah_id": 5972,
    "translation": "U jepet të pijnë prej një kroi të valë."
  },
  {
    "surah_id": 88,
    "ayah_number": 6,
    "global_ayah_id": 5973,
    "translation": "Ata kanë ushqim tjetër pos një barishte me ferra helmuese."
  },
  {
    "surah_id": 88,
    "ayah_number": 7,
    "global_ayah_id": 5974,
    "translation": "Që as nuk jep fuqi, as nuk largon uri."
  },
  {
    "surah_id": 88,
    "ayah_number": 8,
    "global_ayah_id": 5975,
    "translation": "Atë ditë dheh fytyra të ndritshme,"
  },
  {
    "surah_id": 88,
    "ayah_number": 9,
    "global_ayah_id": 5976,
    "translation": "Të kënaqura për veprimet e veta,"
  },
  {
    "surah_id": 88,
    "ayah_number": 10,
    "global_ayah_id": 5977,
    "translation": "Në Xhennet të shkallës së lartë,"
  },
  {
    "surah_id": 88,
    "ayah_number": 11,
    "global_ayah_id": 5978,
    "translation": "Aty nuk dëgjojnë fjalë të pakëndshme,"
  },
  {
    "surah_id": 88,
    "ayah_number": 12,
    "global_ayah_id": 5979,
    "translation": "Aty ka kroje që rrjedhin,"
  },
  {
    "surah_id": 88,
    "ayah_number": 13,
    "global_ayah_id": 5980,
    "translation": "Aty kanë shtretër të lartë,"
  },
  {
    "surah_id": 88,
    "ayah_number": 14,
    "global_ayah_id": 5981,
    "translation": "Aty kanë shtretër të lartë,"
  },
  {
    "surah_id": 88,
    "ayah_number": 15,
    "global_ayah_id": 5982,
    "translation": "Edhe jastekë të renduar për mbështetje,"
  },
  {
    "surah_id": 88,
    "ayah_number": 16,
    "global_ayah_id": 5983,
    "translation": "Edhe qilima të shtruar."
  },
  {
    "surah_id": 88,
    "ayah_number": 17,
    "global_ayah_id": 5984,
    "translation": "A nuk i shikojnë devet se si janë krijuar?"
  },
  {
    "surah_id": 88,
    "ayah_number": 18,
    "global_ayah_id": 5985,
    "translation": "Edhe qiellin se si është ngritur lart!"
  },
  {
    "surah_id": 88,
    "ayah_number": 19,
    "global_ayah_id": 5986,
    "translation": "Edhe kodrat se si janë venduar!"
  },
  {
    "surah_id": 88,
    "ayah_number": 20,
    "global_ayah_id": 5987,
    "translation": "Edhe tokën se si është shtruar!"
  },
  {
    "surah_id": 88,
    "ayah_number": 21,
    "global_ayah_id": 5988,
    "translation": "E ti pra, këshillo, se je vetëm përkujtues,"
  },
  {
    "surah_id": 88,
    "ayah_number": 22,
    "global_ayah_id": 5989,
    "translation": "Ti ndaj tyre nuk je mbizotërues!"
  },
  {
    "surah_id": 88,
    "ayah_number": 23,
    "global_ayah_id": 5990,
    "translation": "Përveç atij zbrapset e nuk beson,"
  },
  {
    "surah_id": 88,
    "ayah_number": 24,
    "global_ayah_id": 5991,
    "translation": "All-llahu atë me vuajtje e dënon."
  },
  {
    "surah_id": 88,
    "ayah_number": 25,
    "global_ayah_id": 5992,
    "translation": "Vetëm te Ne kthimin e kanë."
  },
  {
    "surah_id": 88,
    "ayah_number": 26,
    "global_ayah_id": 5993,
    "translation": "Dhe vetëm detyrë Jona është llogaira e tyre."
  }
]