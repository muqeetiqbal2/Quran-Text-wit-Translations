[
  {
    "surah_id": 88,
    "ayah_number": 0,
    "global_ayah_id": 6054,
    "translation": "अल्लाह के नाम से जो बड़ा कृपालु और अत्यन्त दयावान है।"
  },
  {
    "surah_id": 88,
    "ayah_number": 1,
    "global_ayah_id": 6055,
    "translation": "क्या तुम्हें उस छा जाने वाली की ख़बर पहुँची है?"
  },
  {
    "surah_id": 88,
    "ayah_number": 2,
    "global_ayah_id": 6056,
    "translation": "उस दिन कितने ही चेहरे गिरे हुए होंगे,"
  },
  {
    "surah_id": 88,
    "ayah_number": 3,
    "global_ayah_id": 6057,
    "translation": "कठिन परिश्रम में पड़े, थके-हारे"
  },
  {
    "surah_id": 88,
    "ayah_number": 4,
    "global_ayah_id": 6058,
    "translation": "दहकती आग में प्रवेश करेंगे"
  },
  {
    "surah_id": 88,
    "ayah_number": 5,
    "global_ayah_id": 6059,
    "translation": "खौलते हुए स्रोत से पिएँगे,"
  },
  {
    "surah_id": 88,
    "ayah_number": 6,
    "global_ayah_id": 6060,
    "translation": "उन के लिए कोई खाना न होगा सिवाय एक प्रकार के ज़री के,"
  },
  {
    "surah_id": 88,
    "ayah_number": 7,
    "global_ayah_id": 6061,
    "translation": "जो न पुष्ट करे और न भूख मिटाए"
  },
  {
    "surah_id": 88,
    "ayah_number": 8,
    "global_ayah_id": 6062,
    "translation": "उस दिन कितने ही चेहरे प्रफुल्लित और सौम्य होंगे,"
  },
  {
    "surah_id": 88,
    "ayah_number": 9,
    "global_ayah_id": 6063,
    "translation": "अपने प्रयास पर प्रसन्न,"
  },
  {
    "surah_id": 88,
    "ayah_number": 10,
    "global_ayah_id": 6064,
    "translation": "उच्च जन्नत में,"
  },
  {
    "surah_id": 88,
    "ayah_number": 11,
    "global_ayah_id": 6065,
    "translation": "जिस में कोई व्यर्थ बात न सुनेंगे"
  },
  {
    "surah_id": 88,
    "ayah_number": 12,
    "global_ayah_id": 6066,
    "translation": "उस में स्रोत प्रवाहित होगा,"
  },
  {
    "surah_id": 88,
    "ayah_number": 13,
    "global_ayah_id": 6067,
    "translation": "उस में ऊँची-ऊँची मसनदें होगी,"
  },
  {
    "surah_id": 88,
    "ayah_number": 14,
    "global_ayah_id": 6068,
    "translation": "प्याले ढंग से रखे होंगे,"
  },
  {
    "surah_id": 88,
    "ayah_number": 15,
    "global_ayah_id": 6069,
    "translation": "क्रम से गाव तकिए लगे होंगे,"
  },
  {
    "surah_id": 88,
    "ayah_number": 16,
    "global_ayah_id": 6070,
    "translation": "और हर ओर क़ालीने बिछी होंगी"
  },
  {
    "surah_id": 88,
    "ayah_number": 17,
    "global_ayah_id": 6071,
    "translation": "फिर क्या वे ऊँट की ओर नहीं देखते कि कैसा बनाया गया?"
  },
  {
    "surah_id": 88,
    "ayah_number": 18,
    "global_ayah_id": 6072,
    "translation": "और आकाश की ओर कि कैसा ऊँचा किया गया?"
  },
  {
    "surah_id": 88,
    "ayah_number": 19,
    "global_ayah_id": 6073,
    "translation": "और पहाड़ो की ओर कि कैसे खड़े किए गए?"
  },
  {
    "surah_id": 88,
    "ayah_number": 20,
    "global_ayah_id": 6074,
    "translation": "और धरती की ओर कि कैसी बिछाई गई?"
  },
  {
    "surah_id": 88,
    "ayah_number": 21,
    "global_ayah_id": 6075,
    "translation": "अच्छा तो नसीहत करो! तुम तो बस एक नसीहत करने वाले हो"
  },
  {
    "surah_id": 88,
    "ayah_number": 22,
    "global_ayah_id": 6076,
    "translation": "तुम उन पर कोई दरोग़ा नही हो"
  },
  {
    "surah_id": 88,
    "ayah_number": 23,
    "global_ayah_id": 6077,
    "translation": "किन्तु जिस किसी ने मुँह फेरा और इनकार किया,"
  },
  {
    "surah_id": 88,
    "ayah_number": 24,
    "global_ayah_id": 6078,
    "translation": "तो अल्लाह उसे बड़ी यातना देगा"
  },
  {
    "surah_id": 88,
    "ayah_number": 25,
    "global_ayah_id": 6079,
    "translation": "निस्संदेह हमारी ओर ही है उन का लौटना,"
  },
  {
    "surah_id": 88,
    "ayah_number": 26,
    "global_ayah_id": 6080,
    "translation": "फिर हमारे ही ज़िम्मे है उन का हिसाब लेना"
  }
]