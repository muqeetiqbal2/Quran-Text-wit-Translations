[
  {
    "surah_id": 88,
    "ayah_number": 1,
    "global_ayah_id": 5968,
    "translation": "भला तुमको ढाँप लेने वाली मुसीबत (क़यामत) का हाल मालुम हुआ है"
  },
  {
    "surah_id": 88,
    "ayah_number": 2,
    "global_ayah_id": 5969,
    "translation": "उस दिन बहुत से चेहरे ज़लील रूसवा होंगे"
  },
  {
    "surah_id": 88,
    "ayah_number": 3,
    "global_ayah_id": 5970,
    "translation": "(तौक़ व जंज़ीर से) मयक्क़त करने वाले"
  },
  {
    "surah_id": 88,
    "ayah_number": 4,
    "global_ayah_id": 5971,
    "translation": "थके माँदे दहकती हुई आग में दाखिल होंगे"
  },
  {
    "surah_id": 88,
    "ayah_number": 5,
    "global_ayah_id": 5972,
    "translation": "उन्हें एक खौलते हुए चशमें का पानी पिलाया जाएगा"
  },
  {
    "surah_id": 88,
    "ayah_number": 6,
    "global_ayah_id": 5973,
    "translation": "ख़ारदार झाड़ी के सिवा उनके लिए कोई खाना नहीं"
  },
  {
    "surah_id": 88,
    "ayah_number": 7,
    "global_ayah_id": 5974,
    "translation": "जो मोटाई पैदा करे न भूख में कुछ काम आएगा"
  },
  {
    "surah_id": 88,
    "ayah_number": 8,
    "global_ayah_id": 5975,
    "translation": "(और) बहुत से चेहरे उस दिन तरो ताज़ा होंगे"
  },
  {
    "surah_id": 88,
    "ayah_number": 9,
    "global_ayah_id": 5976,
    "translation": "अपनी कोशिश (के नतीजे) पर शादमान"
  },
  {
    "surah_id": 88,
    "ayah_number": 10,
    "global_ayah_id": 5977,
    "translation": "एक आलीशान बाग़ में"
  },
  {
    "surah_id": 88,
    "ayah_number": 11,
    "global_ayah_id": 5978,
    "translation": "वहाँ कोई लग़ो बात सुनेंगे ही नहीं"
  },
  {
    "surah_id": 88,
    "ayah_number": 12,
    "global_ayah_id": 5979,
    "translation": "उसमें चश्में जारी होंगें"
  },
  {
    "surah_id": 88,
    "ayah_number": 13,
    "global_ayah_id": 5980,
    "translation": "उसमें ऊँचे ऊँचे तख्त बिछे होंगे"
  },
  {
    "surah_id": 88,
    "ayah_number": 14,
    "global_ayah_id": 5981,
    "translation": "और (उनके किनारे) गिलास रखे होंगे"
  },
  {
    "surah_id": 88,
    "ayah_number": 15,
    "global_ayah_id": 5982,
    "translation": "और गाँव तकिए क़तार की क़तार लगे होंगे"
  },
  {
    "surah_id": 88,
    "ayah_number": 16,
    "global_ayah_id": 5983,
    "translation": "और नफ़ीस मसनदे बिछी हुई"
  },
  {
    "surah_id": 88,
    "ayah_number": 17,
    "global_ayah_id": 5984,
    "translation": "तो क्या ये लोग ऊँट की तरह ग़ौर नहीं करते कि कैसा अजीब पैदा किया गया है"
  },
  {
    "surah_id": 88,
    "ayah_number": 18,
    "global_ayah_id": 5985,
    "translation": "और आसमान की तरफ कि क्या बुलन्द बनाया गया है"
  },
  {
    "surah_id": 88,
    "ayah_number": 19,
    "global_ayah_id": 5986,
    "translation": "और पहाड़ों की तरफ़ कि किस तरह खड़े किए गए हैं"
  },
  {
    "surah_id": 88,
    "ayah_number": 20,
    "global_ayah_id": 5987,
    "translation": "और ज़मीन की तरफ कि किस तरह बिछायी गयी है"
  },
  {
    "surah_id": 88,
    "ayah_number": 21,
    "global_ayah_id": 5988,
    "translation": "तो तुम नसीहत करते रहो तुम तो बस नसीहत करने वाले हो"
  },
  {
    "surah_id": 88,
    "ayah_number": 22,
    "global_ayah_id": 5989,
    "translation": "तुम कुछ उन पर दरोग़ा तो हो नहीं"
  },
  {
    "surah_id": 88,
    "ayah_number": 23,
    "global_ayah_id": 5990,
    "translation": "हाँ जिसने मुँह फेर लिया"
  },
  {
    "surah_id": 88,
    "ayah_number": 24,
    "global_ayah_id": 5991,
    "translation": "और न माना तो ख़ुदा उसको बहुत बड़े अज़ाब की सज़ा देगा"
  },
  {
    "surah_id": 88,
    "ayah_number": 25,
    "global_ayah_id": 5992,
    "translation": "बेशक उनको हमारी तरफ़ लौट कर आना है"
  },
  {
    "surah_id": 88,
    "ayah_number": 26,
    "global_ayah_id": 5993,
    "translation": "फिर उनका हिसाब हमारे ज़िम्मे है"
  }
]