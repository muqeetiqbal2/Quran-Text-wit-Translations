    "ayah_number": 0,
    "global_ayah_id": 6054,
    "translation": "اللہ کے «<a href=614> نام </a>» سے «<a href=416> شروع </a>» جو بڑا «<a href=600> مہربان </a>» نہایت رحم فرمانے والا ہے"
  },
  {
    "surah_id": 88,
    "ayah_number": 1,
    "global_ayah_id": 6055,
    "translation": "کیا آپ کے «<a href=141> پاس </a>» چھا جانے والی (قیامت) کی «<a href=293> خبر </a>» پہنچی ہے؟"
  },
  {
    "surah_id": 88,
    "ayah_number": 2,
    "global_ayah_id": 6056,
    "translation": "کئی چہرے اس «<a href=326> دن </a>» «<a href=354> ذلیل </a>» ہوں گے۔"
  },
  {
    "surah_id": 88,
    "ayah_number": 3,
    "global_ayah_id": 6057,
    "translation": "محنت کرنے والے (اور) مشقّت اُٹھانے والے ہوں گے۔"
  },
  {
    "surah_id": 88,
    "ayah_number": 4,
    "global_ayah_id": 6058,
    "translation": "وہ بھڑکتی ہوئی «<a href=12> آگ </a>» میں جھلس رہے ہوں گے۔"
  },
  {
    "surah_id": 88,
    "ayah_number": 5,
    "global_ayah_id": 6059,
    "translation": "اُنہیں کھولتے ہوئے «<a href=260> چشمہ </a>» سے «<a href=144> پانی </a>» پلایا جائے گا۔"
  },
  {
    "surah_id": 88,
    "ayah_number": 6,
    "global_ayah_id": 6060,
    "translation": "ان کے لئے کانٹے دار «<a href=301> خشک </a>» زہریلے «<a href=319> درخت </a>» کے سوا (کچھ) «<a href=508> کھانا </a>» نہ ہوگا۔"
  },
  {
    "surah_id": 88,
    "ayah_number": 7,
    "global_ayah_id": 6061,
    "translation": "نہ (یہ کھانا) موٹا کرے گا اور نہ ہی «<a href=122> بھوک </a>» «<a href=294> ختم </a>» کرے گا۔"
  },
  {
    "surah_id": 88,
    "ayah_number": 8,
    "global_ayah_id": 6062,
    "translation": "۔(جب کہ) اس «<a href=326> دن </a>» کئی چہرے تر و «<a href=187> تازہ </a>» ہوں گے۔"
  },
  {
    "surah_id": 88,
    "ayah_number": 9,
    "global_ayah_id": 6063,
    "translation": "اپنی (نیک) کوششوں کی وجہ سے «<a href=308> خوش </a>» ہوں گے۔"
  },
  {
    "surah_id": 88,
    "ayah_number": 10,
    "global_ayah_id": 6064,
    "translation": "عالی شان جنّت میں ہوں گے۔"
  },
  {
    "surah_id": 88,
    "ayah_number": 11,
    "global_ayah_id": 6065,
    "translation": "وہ اس (جنت) میں کوئی «<a href=136> بےکار </a>» «<a href=71> بات </a>» نہیں سنیں گے۔"
  },
  {
    "surah_id": 88,
    "ayah_number": 12,
    "global_ayah_id": 6066,
    "translation": "اس میں بہتا «<a href=654> ہوا </a>» «<a href=260> چشمہ </a>» ہے۔"
  },
  {
    "surah_id": 88,
    "ayah_number": 13,
    "global_ayah_id": 6067,
    "translation": "اس میں اُونچے اُونچے «<a href=190> تخت </a>» ہوں گے۔"
  },
  {
    "surah_id": 88,
    "ayah_number": 14,
    "global_ayah_id": 6068,
    "translation": "اور رکھے ہوئے پیالے ہوں گے۔"
  },
  {
    "surah_id": 88,
    "ayah_number": 15,
    "global_ayah_id": 6069,
    "translation": "اور قطاروں میں لگے ہوئے تکیے ہوں گے۔"
  },
  {
    "surah_id": 88,
    "ayah_number": 16,
    "global_ayah_id": 6070,
    "translation": "اور بچھے ہوئے قالین ہوں گے۔"
  },
  {
    "surah_id": 88,
    "ayah_number": 17,
    "global_ayah_id": 6071,
    "translation": "کیا وہ (منکرین قدرت) اونٹ کی طرف نہیں دیکھتے وہ کیسے بنایا گیا؟"
  },
  {
    "surah_id": 88,
    "ayah_number": 18,
    "global_ayah_id": 6072,
    "translation": "اور «<a href=10> آسمان </a>» کی طرف وہ کیسے «<a href=106> بلند </a>» کیا گیا ہے؟"
  },
  {
    "surah_id": 88,
    "ayah_number": 19,
    "global_ayah_id": 6073,
    "translation": "اور پہاڑوں کی طرف وہ کیسے گاڑے گئے ہیں؟"
  },
  {
    "surah_id": 88,
    "ayah_number": 20,
    "global_ayah_id": 6074,
    "translation": "اور «<a href=379> زمین </a>» کی طرف وہ کیسے بچھائی گئی ہے؟"
  },
  {
    "surah_id": 88,
    "ayah_number": 21,
    "global_ayah_id": 6075,
    "translation": "تو آپ(صلی اللہ علیہ وآلہ وسلم)نصیحت فرماتےرہیں بےشک آپ(صلی اللہ علیہ وآلہ وسلم) تو «<a href=622> نصیحت </a>» ہی فرمانے والے ہیں۔"
  },
  {
    "surah_id": 88,
    "ayah_number": 22,
    "global_ayah_id": 6076,
    "translation": "آپ(صلی اللہ علیہ وآلہ وسلم) ان پر جبر کرنے والے نہیں ہیں۔"
  },
  {
    "surah_id": 88,
    "ayah_number": 23,
    "global_ayah_id": 6077,
    "translation": "مگر جس نے «<a href=597> منہ </a>» موڑا اور کفر کیا۔"
  },
  {
    "surah_id": 88,
    "ayah_number": 24,
    "global_ayah_id": 6078,
    "translation": "تو اللہ اسے بڑا (سخت) «<a href=440> عذاب </a>» دے گا۔"
  },
  {
    "surah_id": 88,
    "ayah_number": 25,
    "global_ayah_id": 6079,
    "translation": "بےشک اُنہیں ہماری ہی طرف واپس آنا ہے۔"
  },
  {
    "surah_id": 88,
    "ayah_number": 26,
    "global_ayah_id": 6080,
    "translation": "پھر بےشک ہمارے ہی ذمہ ان کا حساب لینا ہے۔"
  }
]