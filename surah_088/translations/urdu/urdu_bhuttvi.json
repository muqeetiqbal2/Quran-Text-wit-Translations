    "global_ayah_id": 6054,
    "translation": " اللہ تعالیٰ کے «<a href=614> نام </a>» سے جو وسیع رحمت والا ، نہایت رحم والا ہے ۔\n "
  },
  {
    "surah_id": 88,
    "ayah_number": 1,
    "global_ayah_id": 6055,
    "translation": " کیا تمہارے «<a href=141> پاس </a>» ڈھانپ لینے والی ( «<a href=476> قیامت </a>» )\nکی «<a href=293> خبر </a>» آئی ہے ؟ "
  },
  {
    "surah_id": 88,
    "ayah_number": 2,
    "global_ayah_id": 6056,
    "translation": " کئی چہرے اُس «<a href=326> دن </a>» «<a href=354> ذلیل </a>» ہوں گے ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 3,
    "global_ayah_id": 6057,
    "translation": " محنت کرنے والے ، تھک جانے والے ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 4,
    "global_ayah_id": 6058,
    "translation": " وہ دہکتی «<a href=12> آگ </a>» میں «<a href=313> داخل </a>» ہوں گے ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 5,
    "global_ayah_id": 6059,
    "translation": " کھولتے ہوئے چشمے سے اُنہیں «<a href=144> پانی </a>» پلایا جائے گا "
  },
  {
    "surah_id": 88,
    "ayah_number": 6,
    "global_ayah_id": 6060,
    "translation": " سُوکھی خاردار جھاڑی کے سوا اُن کے لیے کوئی «<a href=508> کھانا </a>» نہ ہو گا ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 7,
    "global_ayah_id": 6061,
    "translation": " جو نہ موٹا کرے گا اور نہ «<a href=122> بھوک </a>» میں «<a href=480> کافی </a>» ہو\nگا ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 8,
    "global_ayah_id": 6062,
    "translation": " کئی چہرے اُس «<a href=326> دن </a>» تروتازہ ہوں گے ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 9,
    "global_ayah_id": 6063,
    "translation": " اپنی «<a href=501> کوشش </a>» پر «<a href=308> خوش </a>» ہوں گے ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 10,
    "global_ayah_id": 6064,
    "translation": " عالی مقام «<a href=237> جنت </a>» میں ہوں گے ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 11,
    "global_ayah_id": 6065,
    "translation": " اس میں وہ کوئی لغو «<a href=71> بات </a>» نہ سنیں گے ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 12,
    "global_ayah_id": 6066,
    "translation": " اُس میں بہنے والا «<a href=260> چشمہ </a>» ہو گا ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 13,
    "global_ayah_id": 6067,
    "translation": " اُس میں اونچے اونچے «<a href=190> تخت </a>» ہوں گے ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 14,
    "global_ayah_id": 6068,
    "translation": " اور رکھے ہوئے ساغر ہوں گے ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 15,
    "global_ayah_id": 6069,
    "translation": " اور گاؤ تکیے قطاروں میں لگے ہوئے ہوں گے ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 16,
    "global_ayah_id": 6070,
    "translation": " اور مخملی قالین بچھائے ہوئے ہوں گے ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 17,
    "global_ayah_id": 6071,
    "translation": " تو کیا وہ اُونٹوں کی طرف نہیں دیکھتے کہ کیسے وہ «<a href=180> پیدا </a>» کیے گئے\nہیں ؟ "
  },
  {
    "surah_id": 88,
    "ayah_number": 18,
    "global_ayah_id": 6072,
    "translation": " اور «<a href=10> آسمان </a>» کی طرف کہ کیسے وہ «<a href=106> بلند </a>» کیا گیا ؟\n "
  },
  {
    "surah_id": 88,
    "ayah_number": 19,
    "global_ayah_id": 6073,
    "translation": " اور پہاڑوں کی طرف کہ کیسے وہ گاڑے گئے ؟ "
  },
  {
    "surah_id": 88,
    "ayah_number": 20,
    "global_ayah_id": 6074,
    "translation": " اور «<a href=379> زمین </a>» کی طرف کہ کیسے وہ بچھائی گئی ؟ "
  },
  {
    "surah_id": 88,
    "ayah_number": 21,
    "global_ayah_id": 6075,
    "translation": " پس آپ «<a href=622> نصیحت </a>» کریں ، یقیناً آپ «<a href=622> نصیحت </a>» کرنے\nوالے ہی ہیں ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 22,
    "global_ayah_id": 6076,
    "translation": " آپ اُن پر ہرگز کوئی «<a href=585> مسلط </a>» کیے ہوئے نہیں ہیں ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 23,
    "global_ayah_id": 6077,
    "translation": " مگر جس نے «<a href=597> منہ </a>» موڑا اور کفر کیا ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 24,
    "global_ayah_id": 6078,
    "translation": " تو اللہ تعالیٰ اُس کو «<a href=440> عذاب </a>» دے گا ، بہت بڑا «<a href=440> عذاب\n</a>» ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 25,
    "global_ayah_id": 6079,
    "translation": " یقیناً اُنہیں ہماری «<a href=227> جانب </a>» ہی لوٹ کر آنا ہے ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 26,
    "global_ayah_id": 6080,
    "translation": " پھر یقیناً اُن کا حساب بھی ہمارے ہی ذمے ہے ۔ "
  }
]