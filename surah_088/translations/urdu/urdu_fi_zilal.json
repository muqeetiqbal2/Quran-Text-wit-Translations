[
  {
    "surah_id": 88,
    "ayah_number": 0,
    "global_ayah_id": 6054,
    "translation": "اللہ کے «<a href=614> نام </a>» سے جو بےانتہا «<a href=600> مہربان </a>» اور رحم فرمانے والا ہے"
  },
  {
    "surah_id": 88,
    "ayah_number": 1,
    "global_ayah_id": 6055,
    "translation": "کیا تمہیں اس چھاجانے والی آفت (یعنی قیامت) کی «<a href=293> خبر </a>» پہنچی ہے ؟"
  },
  {
    "surah_id": 88,
    "ayah_number": 2,
    "global_ayah_id": 6056,
    "translation": "کچھ چہرے اس روز خوفزدہ ہوں گے"
  },
  {
    "surah_id": 88,
    "ayah_number": 3,
    "global_ayah_id": 6057,
    "translation": "سخت «<a href=587> مشقت </a>» کر رہے ہوں گے"
  },
  {
    "surah_id": 88,
    "ayah_number": 4,
    "global_ayah_id": 6058,
    "translation": "تھکے جاتے ہوں گے ، شدید «<a href=12> آگ </a>» میں جھلس رہے ہوں گے"
  },
  {
    "surah_id": 88,
    "ayah_number": 5,
    "global_ayah_id": 6059,
    "translation": "کھولتے ہوئے چشمے کا «<a href=144> پانی </a>» انہیں پینے کو دیا جائے گا"
  },
  {
    "surah_id": 88,
    "ayah_number": 6,
    "global_ayah_id": 6060,
    "translation": "خاردار سوکھی گھاس کے سوا کوئی «<a href=508> کھانا </a>» ان کے لیے نہ ہوگا"
  },
  {
    "surah_id": 88,
    "ayah_number": 7,
    "global_ayah_id": 6061,
    "translation": "جو نہ موٹا کرے نہ «<a href=122> بھوک </a>» مٹائے"
  },
  {
    "surah_id": 88,
    "ayah_number": 8,
    "global_ayah_id": 6062,
    "translation": "کچھ چہرے اس روز بارونق ہوں گے ،"
  },
  {
    "surah_id": 88,
    "ayah_number": 9,
    "global_ayah_id": 6063,
    "translation": "اپنی کا گزاری پر «<a href=308> خوش </a>» ہوں گے"
  },
  {
    "surah_id": 88,
    "ayah_number": 10,
    "global_ayah_id": 6064,
    "translation": "عالی مقام «<a href=237> جنت </a>» میں ہوں گے"
  },
  {
    "surah_id": 88,
    "ayah_number": 11,
    "global_ayah_id": 6065,
    "translation": "کوئی بیہودہ «<a href=71> بات </a>» وہ وہاں نہ سنیں گے"
  },
  {
    "surah_id": 88,
    "ayah_number": 12,
    "global_ayah_id": 6066,
    "translation": "اس میں چشمے رواں ہوں گے"
  },
  {
    "surah_id": 88,
    "ayah_number": 13,
    "global_ayah_id": 6067,
    "translation": "اس کے «<a href=57> اندر </a>» اونچی مسندیں ہوں گی"
  },
  {
    "surah_id": 88,
    "ayah_number": 14,
    "global_ayah_id": 6068,
    "translation": "ساغررکھے ہوئے ہوں گے"
  },
  {
    "surah_id": 88,
    "ayah_number": 15,
    "global_ayah_id": 6069,
    "translation": "گاؤ تکیوں کی قطاریں لگی ہوں گی"
  },
  {
    "surah_id": 88,
    "ayah_number": 16,
    "global_ayah_id": 6070,
    "translation": "اور نفیس فرش بچھے ہوئے ہوں گے"
  },
  {
    "surah_id": 88,
    "ayah_number": 17,
    "global_ayah_id": 6071,
    "translation": "(یہ لوگ نہیں مانتے) تو کیا یہ اونٹوں کو نہیں دیکھتے کہ کیسے بنائے گئے ؟"
  },
  {
    "surah_id": 88,
    "ayah_number": 18,
    "global_ayah_id": 6072,
    "translation": "آسمان کو نہیں دیکھتے کہ کیسے اٹھایا گیا ؟"
  },
  {
    "surah_id": 88,
    "ayah_number": 19,
    "global_ayah_id": 6073,
    "translation": "پہاڑوں کو نہیں دیکھتے کہ کیسے جمائے گئے ؟"
  },
  {
    "surah_id": 88,
    "ayah_number": 20,
    "global_ayah_id": 6074,
    "translation": "اور «<a href=379> زمین </a>» کو نہیں دیکھتے کہ کیسے بچھائی گئی ؟"
  },
  {
    "surah_id": 88,
    "ayah_number": 21,
    "global_ayah_id": 6075,
    "translation": "اچھا تو (اے نبی) «<a href=622> نصیحت </a>» کیے جاؤ، تم بس «<a href=622> نصیحت </a>» ہی کرنے والے ہو"
  },
  {
    "surah_id": 88,
    "ayah_number": 22,
    "global_ayah_id": 6076,
    "translation": "کچھ ان پر جبر کرنے والے نہیں ہو"
  },
  {
    "surah_id": 88,
    "ayah_number": 23,
    "global_ayah_id": 6077,
    "translation": "البتہ جو شخص «<a href=597> منہ </a>» موڑے گا ، اور «<a href=60> انکار </a>» کرے گا"
  },
  {
    "surah_id": 88,
    "ayah_number": 24,
    "global_ayah_id": 6078,
    "translation": "تو اللہ اس کو بھاری سزا دے گا"
  },
  {
    "surah_id": 88,
    "ayah_number": 25,
    "global_ayah_id": 6079,
    "translation": "ان لوگوں کو پلٹنا ہماری طرف ہی ہے"
  },
  {
    "surah_id": 88,
    "ayah_number": 26,
    "global_ayah_id": 6080,
    "translation": "پھر ان کا حساب لینا ہمارے ہی ذمہ ہے"
  }
]