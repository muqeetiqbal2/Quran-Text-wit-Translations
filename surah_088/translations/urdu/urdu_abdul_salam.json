[
  {
    "surah_id": 88,
    "ayah_number": 0,
    "global_ayah_id": 6054,
    "translation": "اللہ کے «<a href=614> نام </a>» سے جو بےحد رحم والا، نہایت «<a href=600> مہربان </a>» ہے۔ [1]"
  },
  {
    "surah_id": 88,
    "ayah_number": 1,
    "global_ayah_id": 6055,
    "translation": "کیا تیرے «<a href=141> پاس </a>» ڈھانپ لینے والی کی «<a href=293> خبر </a>» پہنچی؟ [1]"
  },
  {
    "surah_id": 88,
    "ayah_number": 2,
    "global_ayah_id": 6056,
    "translation": "اس «<a href=326> دن </a>» کئی چہرے «<a href=354> ذلیل </a>» ہوں گے۔ [2]"
  },
  {
    "surah_id": 88,
    "ayah_number": 3,
    "global_ayah_id": 6057,
    "translation": "محنت کرنے والے، تھک جانے والے ۔ [3]"
  },
  {
    "surah_id": 88,
    "ayah_number": 4,
    "global_ayah_id": 6058,
    "translation": "گرم «<a href=12> آگ </a>» میں «<a href=313> داخل </a>» ہوں گے ۔ [4]"
  },
  {
    "surah_id": 88,
    "ayah_number": 5,
    "global_ayah_id": 6059,
    "translation": "وہ ایک کھولتے ہوئے چشمے سے پلائے جائیں گے۔ [5]"
  },
  {
    "surah_id": 88,
    "ayah_number": 6,
    "global_ayah_id": 6060,
    "translation": "ان کے لیے کوئی «<a href=508> کھانا </a>» نہیں ہوگا مگر ضریع سے۔ [6]"
  },
  {
    "surah_id": 88,
    "ayah_number": 7,
    "global_ayah_id": 6061,
    "translation": "جو نہ موٹا کرے گا اور نہ «<a href=122> بھوک </a>» سے کچھ «<a href=452> فائدہ </a>» دے گا۔ [7]"
  },
  {
    "surah_id": 88,
    "ayah_number": 8,
    "global_ayah_id": 6062,
    "translation": "کئی چہرے اس «<a href=326> دن </a>» ترو «<a href=187> تازہ </a>» ہوں گے۔ [8]"
  },
  {
    "surah_id": 88,
    "ayah_number": 9,
    "global_ayah_id": 6063,
    "translation": "اپنی «<a href=501> کوشش </a>» پر خوش۔ [9]"
  },
  {
    "surah_id": 88,
    "ayah_number": 10,
    "global_ayah_id": 6064,
    "translation": "بلند «<a href=237> جنت </a>» میں ہوں گے۔ [10]"
  },
  {
    "surah_id": 88,
    "ayah_number": 11,
    "global_ayah_id": 6065,
    "translation": "وہ اس میں بے ہودگی والی کوئی «<a href=71> بات </a>» نہیں سنیں گے۔ [11]"
  },
  {
    "surah_id": 88,
    "ayah_number": 12,
    "global_ayah_id": 6066,
    "translation": "اس میں ایک بہنے والا «<a href=260> چشمہ </a>» ہے۔ [12]"
  },
  {
    "surah_id": 88,
    "ayah_number": 13,
    "global_ayah_id": 6067,
    "translation": "اس میں اونچے اونچے «<a href=190> تخت </a>» ہیں ۔ [13]"
  },
  {
    "surah_id": 88,
    "ayah_number": 14,
    "global_ayah_id": 6068,
    "translation": "اور رکھے ہوئے آبخورے ہیں ۔ [14]"
  },
  {
    "surah_id": 88,
    "ayah_number": 15,
    "global_ayah_id": 6069,
    "translation": "اور قطاروں میں لگے ہوئے گاؤ تکیے ہیں۔ [15]"
  },
  {
    "surah_id": 88,
    "ayah_number": 16,
    "global_ayah_id": 6070,
    "translation": "اور بچھائے ہوئے مخملی قالین ہیں۔ [16]"
  },
  {
    "surah_id": 88,
    "ayah_number": 17,
    "global_ayah_id": 6071,
    "translation": "تو کیا وہ اونٹوں کی طرف نہیں دیکھتے کہ وہ کیسے «<a href=180> پیدا </a>» کیے گئے۔ [17]"
  },
  {
    "surah_id": 88,
    "ayah_number": 18,
    "global_ayah_id": 6072,
    "translation": "اور «<a href=10> آسمان </a>» کی طرف کہ وہ کیسے «<a href=106> بلند </a>» کیا گیا ۔ [18]"
  },
  {
    "surah_id": 88,
    "ayah_number": 19,
    "global_ayah_id": 6073,
    "translation": "اور پہاڑوں کی طرف کہ وہ کیسے نصب کیے گئے۔ [19]"
  },
  {
    "surah_id": 88,
    "ayah_number": 20,
    "global_ayah_id": 6074,
    "translation": "اور «<a href=379> زمین </a>» کی طرف کہ وہ کیسے بچھائی گئی۔ [20]"
  },
  {
    "surah_id": 88,
    "ayah_number": 21,
    "global_ayah_id": 6075,
    "translation": "پس تو «<a href=622> نصیحت </a>» کر، تو صرف «<a href=622> نصیحت </a>» کرنے والا ہے۔ [21]"
  },
  {
    "surah_id": 88,
    "ayah_number": 22,
    "global_ayah_id": 6076,
    "translation": "تو ہرگز ان پر کوئی «<a href=585> مسلط </a>» کیا «<a href=654> ہوا </a>» نہیں ہے۔ [22]"
  },
  {
    "surah_id": 88,
    "ayah_number": 23,
    "global_ayah_id": 6077,
    "translation": "مگر جس نے «<a href=597> منہ </a>» موڑا اور «<a href=60> انکار </a>» کیا ۔ [23]"
  },
  {
    "surah_id": 88,
    "ayah_number": 24,
    "global_ayah_id": 6078,
    "translation": "تو اسے اللہ «<a href=440> عذاب </a>» دے گا، سب سے بڑا عذاب۔ [24]"
  },
  {
    "surah_id": 88,
    "ayah_number": 25,
    "global_ayah_id": 6079,
    "translation": "یقینا ہماری ہی طرف ان کا لوٹ کر آنا ہے ۔ [25]"
  },
  {
    "surah_id": 88,
    "ayah_number": 26,
    "global_ayah_id": 6080,
    "translation": "پھر بے «<a href=420> شک </a>» ہمارے ہی ذمے ان کا حساب ہے ۔ [26]"
  }
]