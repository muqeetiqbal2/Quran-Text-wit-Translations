[
  {
    "surah_id": 88,
    "ayah_number": 0,
    "global_ayah_id": 6054,
    "translation": "شروع اللہ کے «<a href=614> نام </a>» سے جو بڑا «<a href=600> مہربان </a>» اور نہایت رحم کرنے والا ہے"
  },
  {
    "surah_id": 88,
    "ayah_number": 1,
    "global_ayah_id": 6055,
    "translation": "( اے نبی )  آپکواس «<a href=476> قیامت </a>» کی خبرپہنچ چکی ہے جس کی ہولناکی ہرچیزکوڈھانپ لے گی"
  },
  {
    "surah_id": 88,
    "ayah_number": 2,
    "global_ayah_id": 6056,
    "translation": "اس «<a href=326> دن </a>» کچھ چہرے «<a href=353> ذلت </a>» و رسوائی کے مارے جھکے ہوں گے"
  },
  {
    "surah_id": 88,
    "ayah_number": 3,
    "global_ayah_id": 6057,
    "translation": "سخت «<a href=573> محنت </a>» میں مبتلا تھکے ماندے ہوں گے"
  },
  {
    "surah_id": 88,
    "ayah_number": 4,
    "global_ayah_id": 6058,
    "translation": "دہکتی «<a href=12> آگ </a>» میں «<a href=313> داخل </a>» ہوں گے"
  },
  {
    "surah_id": 88,
    "ayah_number": 5,
    "global_ayah_id": 6059,
    "translation": "انہیں کھولتے ہوئے «<a href=144> پانی </a>» کے چشمے سے پینے کو دیاجائے گا"
  },
  {
    "surah_id": 88,
    "ayah_number": 6,
    "global_ayah_id": 6060,
    "translation": "ان کے لئے سوائے کانٹے داردرختوں کے  او رکچھ کھانانہ ہوگا"
  },
  {
    "surah_id": 88,
    "ayah_number": 7,
    "global_ayah_id": 6061,
    "translation": "جونہ موٹاکرے گانہ «<a href=122> بھوک </a>» «<a href=328> دور </a>» کرے گا"
  },
  {
    "surah_id": 88,
    "ayah_number": 8,
    "global_ayah_id": 6062,
    "translation": "بہت سے چہرے اس «<a href=326> دن </a>» تروتازہ ہوں گے"
  },
  {
    "surah_id": 88,
    "ayah_number": 9,
    "global_ayah_id": 6063,
    "translation": "اپنی کارکردگی پر «<a href=308> خوش </a>» ہوں گے"
  },
  {
    "surah_id": 88,
    "ayah_number": 10,
    "global_ayah_id": 6064,
    "translation": "بلندوبالا جنتوں میں ہوں گے"
  },
  {
    "surah_id": 88,
    "ayah_number": 11,
    "global_ayah_id": 6065,
    "translation": "جہاں وہ کوئی بیہودہ «<a href=71> بات </a>» نہ سنیں گے"
  },
  {
    "surah_id": 88,
    "ayah_number": 12,
    "global_ayah_id": 6066,
    "translation": "جہاں بہتاہواچشمہ ہوگا"
  },
  {
    "surah_id": 88,
    "ayah_number": 13,
    "global_ayah_id": 6067,
    "translation": "اور اس میں اونچے رکھے ہوئے «<a href=190> تخت </a>» ہوں گے"
  },
  {
    "surah_id": 88,
    "ayah_number": 14,
    "global_ayah_id": 6068,
    "translation": "اور پیالے قرینے سے رکھے ہوں گے"
  },
  {
    "surah_id": 88,
    "ayah_number": 15,
    "global_ayah_id": 6069,
    "translation": "گائوتکیے قطارمیں لگے ہوں گے"
  },
  {
    "surah_id": 88,
    "ayah_number": 16,
    "global_ayah_id": 6070,
    "translation": "اور مخملی فرش بچھے ہوں گے"
  },
  {
    "surah_id": 88,
    "ayah_number": 17,
    "global_ayah_id": 6071,
    "translation": "کیا وہ اونٹ کی طرف نہیں دیکھتے کہ وہ کس طرح «<a href=180> پیدا </a>» کیا گیا"
  },
  {
    "surah_id": 88,
    "ayah_number": 18,
    "global_ayah_id": 6072,
    "translation": "اور وہ «<a href=10> آسمان </a>» کی طرف نہیں دیکھتے کے کس طرح اوپر اٹھا دیا گیا ہے"
  },
  {
    "surah_id": 88,
    "ayah_number": 19,
    "global_ayah_id": 6073,
    "translation": "اور پہاڑوں کی طرف نہیں دیکھتے کہ وہ کیسے نصب کئے گئے ہیں"
  },
  {
    "surah_id": 88,
    "ayah_number": 20,
    "global_ayah_id": 6074,
    "translation": "اور «<a href=379> زمین </a>» کی طرف نہیں دیکھتے کہ کیسے بچھائی گئی ہے"
  },
  {
    "surah_id": 88,
    "ayah_number": 21,
    "global_ayah_id": 6075,
    "translation": "بس آپ «<a href=622> نصیحت </a>» کرتے رہوآپ توبس «<a href=622> نصیحت </a>» کرنے والے ہی ہیں"
  },
  {
    "surah_id": 88,
    "ayah_number": 22,
    "global_ayah_id": 6076,
    "translation": "آپ ان پر محاسب نہیں ہیں  ( یعنی انکاحساب اللہ کے ذمہ ہے )"
  },
  {
    "surah_id": 88,
    "ayah_number": 23,
    "global_ayah_id": 6077,
    "translation": "البتہ جو شخص «<a href=597> منہ </a>» موڑے گا اور کفر کرے گا"
  },
  {
    "surah_id": 88,
    "ayah_number": 24,
    "global_ayah_id": 6078,
    "translation": "تواللہ اسے بہت بڑی سزادے گا"
  },
  {
    "surah_id": 88,
    "ayah_number": 25,
    "global_ayah_id": 6079,
    "translation": "بلا شبہ انہیں ہماری طرف ہی واپس آنا ہے"
  },
  {
    "surah_id": 88,
    "ayah_number": 26,
    "global_ayah_id": 6080,
    "translation": "پھرانکاحساب لیناہمارے ہی ذمہ ہے"
  }
]