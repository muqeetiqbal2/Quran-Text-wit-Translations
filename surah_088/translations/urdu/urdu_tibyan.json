[
  {
    "surah_id": 88,
    "ayah_number": 0,
    "global_ayah_id": 6054,
    "translation": "اللہ ہی کے «<a href=614> نام </a>» سے  (  «<a href=416> شروع </a>» کرتا ہوں )  جو نہایت رحم فرمانے والا بہت «<a href=600> مہربان </a>» ہے"
  },
  {
    "surah_id": 88,
    "ayah_number": 1,
    "global_ayah_id": 6055,
    "translation": "بیشک آپ کے «<a href=141> پاس </a>» ڈھانپنے والی چیز کی «<a href=293> خبر </a>» آچکی ہے"
  },
  {
    "surah_id": 88,
    "ayah_number": 2,
    "global_ayah_id": 6056,
    "translation": "اس «<a href=326> دن </a>» بہت چہرے «<a href=354> ذلیل </a>» ہوں گے"
  },
  {
    "surah_id": 88,
    "ayah_number": 3,
    "global_ayah_id": 6057,
    "translation": "کام کرنے والے، «<a href=587> مشقت </a>» «<a href=100> برداشت </a>» کرنے والے"
  },
  {
    "surah_id": 88,
    "ayah_number": 4,
    "global_ayah_id": 6058,
    "translation": "وہ بھڑکتی ہوئی «<a href=12> آگ </a>» میں جھونکے جائیں گے"
  },
  {
    "surah_id": 88,
    "ayah_number": 5,
    "global_ayah_id": 6059,
    "translation": "انہیں کھولتے ہوئے «<a href=260> چشمہ </a>»  (  کے «<a href=144> پانی </a>» )  سے پلایا جائے گا"
  },
  {
    "surah_id": 88,
    "ayah_number": 6,
    "global_ayah_id": 6060,
    "translation": "ان کا «<a href=508> کھانا </a>» صرف خاردار «<a href=301> خشک </a>» زہریلے «<a href=319> درخت </a>» سے ہوگا"
  },
  {
    "surah_id": 88,
    "ayah_number": 7,
    "global_ayah_id": 6061,
    "translation": "جو نہ فربہ کرے گا نہ «<a href=122> بھوک </a>» «<a href=328> دور </a>» کرے گا"
  },
  {
    "surah_id": 88,
    "ayah_number": 8,
    "global_ayah_id": 6062,
    "translation": "بہت چہرے اس «<a href=326> دن </a>» «<a href=308> خوش </a>» و خرم ہوں گے"
  },
  {
    "surah_id": 88,
    "ayah_number": 9,
    "global_ayah_id": 6063,
    "translation": "اپنے «<a href=634> نیک </a>» «<a href=42> اعمال </a>» پر شاداں ہوں گے"
  },
  {
    "surah_id": 88,
    "ayah_number": 10,
    "global_ayah_id": 6064,
    "translation": "بلند «<a href=237> جنت </a>» میں"
  },
  {
    "surah_id": 88,
    "ayah_number": 11,
    "global_ayah_id": 6065,
    "translation": "جس میں کوئی شخص بےہودہ «<a href=71> بات </a>» نہیں سنے گا"
  },
  {
    "surah_id": 88,
    "ayah_number": 12,
    "global_ayah_id": 6066,
    "translation": "اس میں بہتے ہوئے چشمے ہوں گے"
  },
  {
    "surah_id": 88,
    "ayah_number": 13,
    "global_ayah_id": 6067,
    "translation": "اس میں «<a href=106> بلند </a>» مسندیں ہوں گی"
  },
  {
    "surah_id": 88,
    "ayah_number": 14,
    "global_ayah_id": 6068,
    "translation": "اور ترتیب سے رکھے ہوئے جام ہوں گے"
  },
  {
    "surah_id": 88,
    "ayah_number": 15,
    "global_ayah_id": 6069,
    "translation": "اور صف بہ صف گاؤ تکیے رکھے ہوں گے"
  },
  {
    "surah_id": 88,
    "ayah_number": 16,
    "global_ayah_id": 6070,
    "translation": "اور بہترین فرش بچھے ہوں گے"
  },
  {
    "surah_id": 88,
    "ayah_number": 17,
    "global_ayah_id": 6071,
    "translation": "کیا یہ لوگ اونٹ کو نہیں دیکھتے کہ وہ کیسے بنایا گیا ہے"
  },
  {
    "surah_id": 88,
    "ayah_number": 18,
    "global_ayah_id": 6072,
    "translation": "اور «<a href=10> آسمان </a>» کو کہ وہ کیسے «<a href=106> بلند </a>» کیا گیا ہے"
  },
  {
    "surah_id": 88,
    "ayah_number": 19,
    "global_ayah_id": 6073,
    "translation": "اور پہاڑوں کو کہ وہ کیسے نصب کیے گئے ہیں"
  },
  {
    "surah_id": 88,
    "ayah_number": 20,
    "global_ayah_id": 6074,
    "translation": "اور «<a href=379> زمین </a>» کو کہ وہ کیسے پھیلائی گئی ہے"
  },
  {
    "surah_id": 88,
    "ayah_number": 21,
    "global_ayah_id": 6075,
    "translation": "سو آپ «<a href=622> نصیحت </a>» کرتے رہیں، آپ ہی «<a href=622> نصیحت </a>» کرنے والے ہیں"
  },
  {
    "surah_id": 88,
    "ayah_number": 22,
    "global_ayah_id": 6076,
    "translation": "آپ ان  (  کافروں )  کو جبراً مسلمان کرنے والے نہیں ہیں"
  },
  {
    "surah_id": 88,
    "ayah_number": 23,
    "global_ayah_id": 6077,
    "translation": "مگر جو حق سے «<a href=177> پشت </a>» پھیرے اور کفر کرے"
  },
  {
    "surah_id": 88,
    "ayah_number": 24,
    "global_ayah_id": 6078,
    "translation": "تو اللہ اس کو بہت بڑا «<a href=440> عذاب </a>» دے گا"
  },
  {
    "surah_id": 88,
    "ayah_number": 25,
    "global_ayah_id": 6079,
    "translation": "بیشک ہماری ہی طرف ان کا لوٹنا ہے"
  },
  {
    "surah_id": 88,
    "ayah_number": 26,
    "global_ayah_id": 6080,
    "translation": "پھر بیشک ہم پر ہی ان کا حساب ہے"
  }
]