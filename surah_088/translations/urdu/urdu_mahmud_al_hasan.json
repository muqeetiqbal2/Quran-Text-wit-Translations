[
  {
    "surah_id": 88,
    "ayah_number": 0,
    "global_ayah_id": 6054,
    "translation": "اللہ کے نام سے جو رحمان و رحیم ہے"
  },
  {
    "surah_id": 88,
    "ayah_number": 1,
    "global_ayah_id": 6055,
    "translation": "کچھ پہنچی تجھ کو بات اُس چھپا لینے والی کی"
  },
  {
    "surah_id": 88,
    "ayah_number": 2,
    "global_ayah_id": 6056,
    "translation": "کتنے منہ اُس دن ذلیل ہونے والے ہیں"
  },
  {
    "surah_id": 88,
    "ayah_number": 3,
    "global_ayah_id": 6057,
    "translation": "محنت کرنے والے تھکے ہوئے"
  },
  {
    "surah_id": 88,
    "ayah_number": 4,
    "global_ayah_id": 6058,
    "translation": "گریں گے دہکتی ہوئی آگ میں"
  },
  {
    "surah_id": 88,
    "ayah_number": 5,
    "global_ayah_id": 6059,
    "translation": "پانی ملے گا ایک چشمے کھولتے ہوئے کا"
  },
  {
    "surah_id": 88,
    "ayah_number": 6,
    "global_ayah_id": 6060,
    "translation": "نہیں اُنکے پاس کھانا مگر جھاڑ کانٹوں والا"
  },
  {
    "surah_id": 88,
    "ayah_number": 7,
    "global_ayah_id": 6061,
    "translation": "نہ موٹا کرے اور نہ کام آئے بھوک میں"
  },
  {
    "surah_id": 88,
    "ayah_number": 8,
    "global_ayah_id": 6062,
    "translation": "کتنے منہ اُس دن تروتازہ ہیں"
  },
  {
    "surah_id": 88,
    "ayah_number": 9,
    "global_ayah_id": 6063,
    "translation": "اپنی کمائی سے راضی"
  },
  {
    "surah_id": 88,
    "ayah_number": 10,
    "global_ayah_id": 6064,
    "translation": "اونچے باغ میں"
  },
  {
    "surah_id": 88,
    "ayah_number": 11,
    "global_ayah_id": 6065,
    "translation": "نہیں سنتے اُس میں بکواس"
  },
  {
    "surah_id": 88,
    "ayah_number": 12,
    "global_ayah_id": 6066,
    "translation": "اُس میں ایک چشمہ ہے بہتا"
  },
  {
    "surah_id": 88,
    "ayah_number": 13,
    "global_ayah_id": 6067,
    "translation": "اُس میں تخت ہیں اونچے بچھے ہوئے"
  },
  {
    "surah_id": 88,
    "ayah_number": 14,
    "global_ayah_id": 6068,
    "translation": "اور آبخورے سامنے چنے ہوئے"
  },
  {
    "surah_id": 88,
    "ayah_number": 15,
    "global_ayah_id": 6069,
    "translation": "اور غالیچے برابر بچھے ہوئے"
  },
  {
    "surah_id": 88,
    "ayah_number": 16,
    "global_ayah_id": 6070,
    "translation": "اور مخمل کے نہالچے جگہ جگہ پھیلے ہوئے"
  },
  {
    "surah_id": 88,
    "ayah_number": 17,
    "global_ayah_id": 6071,
    "translation": "بھلا کیا نظر نہیں کرتے اونٹوں پر کہ کیسے بنائے ہیں"
  },
  {
    "surah_id": 88,
    "ayah_number": 18,
    "global_ayah_id": 6072,
    "translation": "اور آسمان پر کہ کیسا اُس کو بلند کیا ہے"
  },
  {
    "surah_id": 88,
    "ayah_number": 19,
    "global_ayah_id": 6073,
    "translation": "اور پہاڑوں پر کہ کیسے کھڑے کر دیے ہیں"
  },
  {
    "surah_id": 88,
    "ayah_number": 20,
    "global_ayah_id": 6074,
    "translation": "اور زمین پر کہ کیسی صاف بچھائی ہے"
  },
  {
    "surah_id": 88,
    "ayah_number": 21,
    "global_ayah_id": 6075,
    "translation": "سو تو سمجھائے جا تیرا کام تو یہی سمجھانا ہے"
  },
  {
    "surah_id": 88,
    "ayah_number": 22,
    "global_ayah_id": 6076,
    "translation": "تو نہیں اُن پر داروغہ"
  },
  {
    "surah_id": 88,
    "ayah_number": 23,
    "global_ayah_id": 6077,
    "translation": "مگر جس نے منہ موڑا اور منکر ہو گیا"
  },
  {
    "surah_id": 88,
    "ayah_number": 24,
    "global_ayah_id": 6078,
    "translation": "تو عذاب کرے گا اُس پر اللہ وہ بڑا عذاب"
  },
  {
    "surah_id": 88,
    "ayah_number": 25,
    "global_ayah_id": 6079,
    "translation": "بیشک ہمارے پاس ہے اُنکو پھر آنا"
  },
  {
    "surah_id": 88,
    "ayah_number": 26,
    "global_ayah_id": 6080,
    "translation": "پھر بیشک ہمارا ذمہ ہے اُن سے حساب لینا"
  }
]