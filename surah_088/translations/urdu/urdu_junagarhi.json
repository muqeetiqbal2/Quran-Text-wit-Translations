    "global_ayah_id": 6054,
    "translation": " «<a href=416> شروع </a>» کرتا ہوں اللہ تعا لٰی کے «<a href=614> نام\n</a>» سے جو بڑا «<a href=600> مہربان </a>» نہایت رحم والا ہے ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 1,
    "global_ayah_id": 6055,
    "translation": " کیا تجھے بھی چھپا لینے والی ( «<a href=476> قیامت </a>» ) کی «<a\n  href=293> خبر </a>» پہنچی ہے ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 2,
    "global_ayah_id": 6056,
    "translation": " اس «<a href=326> دن </a>» بہت سے چہرے «<a href=354> ذلیل </a>» ہونگے ۔\n "
  },
  {
    "surah_id": 88,
    "ayah_number": 3,
    "global_ayah_id": 6057,
    "translation": " ۔ ( اور ) «<a href=573> محنت </a>» کرنے والے تھکے ہوئے ہونگے ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 4,
    "global_ayah_id": 6058,
    "translation": " وہ دہکتی ہوئی «<a href=12> آگ </a>» میں جائیں گے ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 5,
    "global_ayah_id": 6059,
    "translation": " اور نہایت گرم چشمے کا «<a href=144> پانی </a>» ان کو پلایا جائے گا ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 6,
    "global_ayah_id": 6060,
    "translation": " ان کے لئے سوائے کانٹے دار درختوں کے اور کچھ «<a href=508> کھانا </a>»\nنہ ہوگا ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 7,
    "global_ayah_id": 6061,
    "translation": " جو نہ موٹا کرے گا نہ «<a href=122> بھوک </a>» مٹائے گا ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 8,
    "global_ayah_id": 6062,
    "translation": " بہت سے چہرے اس «<a href=326> دن </a>» تروتازہ اور ( آسودہ حال ) ہونگے\n۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 9,
    "global_ayah_id": 6063,
    "translation": " اپنی «<a href=501> کوشش </a>» پر «<a href=308> خوش </a>» ہونگے ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 10,
    "global_ayah_id": 6064,
    "translation": " «<a href=106> بلند </a>» و بالا جنتوں میں ہونگے ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 11,
    "global_ayah_id": 6065,
    "translation": " جہاں کوئی بیہودہ «<a href=71> بات </a>» نہیں سنیں گے ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 12,
    "global_ayah_id": 6066,
    "translation": " جہاں بہتا «<a href=654> ہوا </a>» «<a href=260> چشمہ </a>» ہوگا ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 13,
    "global_ayah_id": 6067,
    "translation": " ۔ ( اور ) اس میں اونچے اونچے «<a href=190> تخت </a>» ہونگے ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 14,
    "global_ayah_id": 6068,
    "translation": " اور آبخورے رکھے ہوئے ( ہونگے ) ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 15,
    "global_ayah_id": 6069,
    "translation": " اور ایک قطار میں لگے ہوئے تکیے ہونگے ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 16,
    "global_ayah_id": 6070,
    "translation": " اور مخملی مسندیں پھیلی پڑی ہونگی ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 17,
    "global_ayah_id": 6071,
    "translation": " کیا یہ اونٹوں کو نہیں دیکھتے کہ وہ کس طرح «<a href=180> پیدا </a>» کئے\nگئے ہیں ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 18,
    "global_ayah_id": 6072,
    "translation": " اور «<a href=10> آسمان </a>» کو کہ کس طرح اونچا کیا گیا ہے ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 19,
    "global_ayah_id": 6073,
    "translation": " اور پہاڑوں کی طرف کہ کس طرح گاڑھ دیئے گئے ہیں ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 20,
    "global_ayah_id": 6074,
    "translation": " اور «<a href=379> زمین </a>» کی طرف کہ کس طرح بچھائی گئی ہے ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 21,
    "global_ayah_id": 6075,
    "translation": " پس آپ «<a href=622> نصیحت </a>» کر دیا کریں ( کیونکہ ) آپ صرف «<a\n  href=622> نصیحت </a>» کرنے والے ہیں ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 22,
    "global_ayah_id": 6076,
    "translation": " آپ کچھ ان پر «<a href=314> داروغہ </a>» نہیں ہیں ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 23,
    "global_ayah_id": 6077,
    "translation": " ہاں! جو شخص روگردانی کرے اور کفر کرے ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 24,
    "global_ayah_id": 6078,
    "translation": " اسے اللہ تعا لٰی بہت بڑا «<a href=440> عذاب </a>» دے گا ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 25,
    "global_ayah_id": 6079,
    "translation": " بیشک ہماری طرف ان کا لوٹنا ہے ۔ "
  },
  {
    "surah_id": 88,
    "ayah_number": 26,
    "global_ayah_id": 6080,
    "translation": " پھر بیشک ہمارے ذمہ ہے ان سے حساب لینا ۔ "
  }
