[
  {
    "surah_id": 88,
    "ayah_number": 1,
    "global_ayah_id": 5968,
    "translation": "(اي پيغمبر) تو وٽ ڍڪيندڙ (قيامت) جي خبر پھتي آھي ڇا؟"
  },
  {
    "surah_id": 88,
    "ayah_number": 2,
    "global_ayah_id": 5969,
    "translation": "اُن ڏينھن ڪيترائي مُنھن خوار ھوندا."
  },
  {
    "surah_id": 88,
    "ayah_number": 3,
    "global_ayah_id": 5970,
    "translation": "ڪمائيندڙ ڏک ڀوڳيندا ھوندا."
  },
  {
    "surah_id": 88,
    "ayah_number": 4,
    "global_ayah_id": 5971,
    "translation": "ٻرندڙ باھ ۾ پوندا."
  },
  {
    "surah_id": 88,
    "ayah_number": 5,
    "global_ayah_id": 5972,
    "translation": "بلڪل تتي چشمي مان پاڻي پياربن."
  },
  {
    "surah_id": 88,
    "ayah_number": 6,
    "global_ayah_id": 5973,
    "translation": "ڪنڊن واري گاھ کانسواءِ (ٻيو) ڪو کاڄ انھن لاءِ نه ھوندو."
  },
  {
    "surah_id": 88,
    "ayah_number": 7,
    "global_ayah_id": 5974,
    "translation": "(جو اُھو) نڪي (کين) ڀُلھو ڪندو ۽ نڪي بُک لاھيندو."
  },
  {
    "surah_id": 88,
    "ayah_number": 8,
    "global_ayah_id": 5975,
    "translation": "ڪيئي مُنھن اُن ڏينھن تازا ھوندا."
  },
  {
    "surah_id": 88,
    "ayah_number": 9,
    "global_ayah_id": 5976,
    "translation": "پنھنجي ڪمائيءَ کان راضي ھوندا."
  },
  {
    "surah_id": 88,
    "ayah_number": 10,
    "global_ayah_id": 5977,
    "translation": "مٿاھين بھشت ۾ ھوندا."
  },
  {
    "surah_id": 88,
    "ayah_number": 11,
    "global_ayah_id": 5978,
    "translation": "اتي ڪا اجائي ڳالھ نه ٻڌندين."
  },
  {
    "surah_id": 88,
    "ayah_number": 12,
    "global_ayah_id": 5979,
    "translation": "اُتي چشما وھندڙ آھن."
  },
  {
    "surah_id": 88,
    "ayah_number": 13,
    "global_ayah_id": 5980,
    "translation": "اُتي وڏا تخت مٿي وڇايل."
  },
  {
    "surah_id": 88,
    "ayah_number": 14,
    "global_ayah_id": 5981,
    "translation": "۽ آبخورا رکيل."
  },
  {
    "surah_id": 88,
    "ayah_number": 15,
    "global_ayah_id": 5982,
    "translation": "۽ وھاڻا قطار ڪري رکيل."
  },
  {
    "surah_id": 88,
    "ayah_number": 16,
    "global_ayah_id": 5983,
    "translation": "۽ غاليچا وڇايل آھن."
  },
  {
    "surah_id": 88,
    "ayah_number": 17,
    "global_ayah_id": 5984,
    "translation": "(ماڻھو) اُٺن ڏانھن نه ڏسندا آھن ڇا؟ ته ڪيئن خلقيا ويا."
  },
  {
    "surah_id": 88,
    "ayah_number": 18,
    "global_ayah_id": 5985,
    "translation": "۽ آسمان ڏانھن ته ڪيئن مٿي ڪيو ويو."
  },
  {
    "surah_id": 88,
    "ayah_number": 19,
    "global_ayah_id": 5986,
    "translation": "۽ جبلن ڏانھن ته ڪيئن کڙا ڪيا ويا."
  },
  {
    "surah_id": 88,
    "ayah_number": 20,
    "global_ayah_id": 5987,
    "translation": "۽ زمين ڏانھن ته ڪيئن وڇائي وئي."
  },
  {
    "surah_id": 88,
    "ayah_number": 21,
    "global_ayah_id": 5988,
    "translation": "پوءِ (اي پيغمبر) تون، رڳو نصيحت ڪرڻ وارو آھين."
  },
  {
    "surah_id": 88,
    "ayah_number": 22,
    "global_ayah_id": 5989,
    "translation": "تون مٿن ڪو داروغو نه آھين."
  },
  {
    "surah_id": 88,
    "ayah_number": 23,
    "global_ayah_id": 5990,
    "translation": "پر جنھن مُنھن موڙيو ۽ ڪُفر ڪيو."
  },
  {
    "surah_id": 88,
    "ayah_number": 24,
    "global_ayah_id": 5991,
    "translation": "تنھن کي الله وڏي عذاب جي سزا ڏيندو."
  },
  {
    "surah_id": 88,
    "ayah_number": 25,
    "global_ayah_id": 5992,
    "translation": "بيشڪ اسان ڏانھن سندن موٽڻ آھي."
  },
  {
    "surah_id": 88,
    "ayah_number": 26,
    "global_ayah_id": 5993,
    "translation": "وري بيشڪ سندن حساب وٺڻ اسان جي ذمي آھي."
  }
]