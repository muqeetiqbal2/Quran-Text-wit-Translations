[
  {
    "surah_id": 88,
    "ayah_number": 1,
    "global_ayah_id": 5968,
    "translation": "آیا خبر حادثه‌ی فراگیر به تو رسیده است؟"
  },
  {
    "surah_id": 88,
    "ayah_number": 2,
    "global_ayah_id": 5969,
    "translation": "در آن روز، چهره‌هایی خوار و زبونند."
  },
  {
    "surah_id": 88,
    "ayah_number": 3,
    "global_ayah_id": 5970,
    "translation": "[با آن که] تلاش کرده‌اند و رنج برده‌اند،"
  },
  {
    "surah_id": 88,
    "ayah_number": 4,
    "global_ayah_id": 5971,
    "translation": "[امّا] به آتشی سوزان درآیند."
  },
  {
    "surah_id": 88,
    "ayah_number": 5,
    "global_ayah_id": 5972,
    "translation": "از چشمه‌ای جوشان نوشانده شوند."
  },
  {
    "surah_id": 88,
    "ayah_number": 6,
    "global_ayah_id": 5973,
    "translation": "و خوراکی جز خار خشک و تلخ ندارند."
  },
  {
    "surah_id": 88,
    "ayah_number": 7,
    "global_ayah_id": 5974,
    "translation": "که نه فربه کند و نه گرسنگی را از میان برد."
  },
  {
    "surah_id": 88,
    "ayah_number": 8,
    "global_ayah_id": 5975,
    "translation": "در چنین روزی چهره‌هایی خرّم و شادابند."
  },
  {
    "surah_id": 88,
    "ayah_number": 9,
    "global_ayah_id": 5976,
    "translation": "از کوشش خود خشنودند."
  },
  {
    "surah_id": 88,
    "ayah_number": 10,
    "global_ayah_id": 5977,
    "translation": "در بهشت برین [جای دارند]."
  },
  {
    "surah_id": 88,
    "ayah_number": 11,
    "global_ayah_id": 5978,
    "translation": "آنجا سخن بیهوده‌ای نشنوند."
  },
  {
    "surah_id": 88,
    "ayah_number": 12,
    "global_ayah_id": 5979,
    "translation": "در آنجا چشمه‌ای جاری است."
  },
  {
    "surah_id": 88,
    "ayah_number": 13,
    "global_ayah_id": 5980,
    "translation": "در آنجا تخت‌هایی است پرارج و برافراشته."
  },
  {
    "surah_id": 88,
    "ayah_number": 14,
    "global_ayah_id": 5981,
    "translation": "و سبوهایی چیده شده،"
  },
  {
    "surah_id": 88,
    "ayah_number": 15,
    "global_ayah_id": 5982,
    "translation": "و بالش‌هایی ردیف شده،"
  },
  {
    "surah_id": 88,
    "ayah_number": 16,
    "global_ayah_id": 5983,
    "translation": "و فرش‌هایی گرانبها که گسترده شده است."
  },
  {
    "surah_id": 88,
    "ayah_number": 17,
    "global_ayah_id": 5984,
    "translation": "پس آیا به شتر نمی‌نگرند که چگونه آفریده شده؟"
  },
  {
    "surah_id": 88,
    "ayah_number": 18,
    "global_ayah_id": 5985,
    "translation": "و به آسمان که چگونه برافراشته شده؟"
  },
  {
    "surah_id": 88,
    "ayah_number": 19,
    "global_ayah_id": 5986,
    "translation": "و به کوه‌ها که چگونه برپا داشته شده؟"
  },
  {
    "surah_id": 88,
    "ayah_number": 20,
    "global_ayah_id": 5987,
    "translation": "و به زمین که چگونه گسترده شده است؟"
  },
  {
    "surah_id": 88,
    "ayah_number": 21,
    "global_ayah_id": 5988,
    "translation": "پس یادآوری کن که تو فقط یادآوری کننده‌ای."
  },
  {
    "surah_id": 88,
    "ayah_number": 22,
    "global_ayah_id": 5989,
    "translation": "تو بر آنان تسلّطی نداری [که به ایمان آوردن مجبورشان کنی]."
  },
  {
    "surah_id": 88,
    "ayah_number": 23,
    "global_ayah_id": 5990,
    "translation": "ولی آن کس که روی گرداند و کفر ورزید،"
  },
  {
    "surah_id": 88,
    "ayah_number": 24,
    "global_ayah_id": 5991,
    "translation": "پس خداوند او را به بزرگ‌ترین عذاب مجازات می‌کند."
  },
  {
    "surah_id": 88,
    "ayah_number": 25,
    "global_ayah_id": 5992,
    "translation": "بازگشت آنان به سوی ماست."
  },
  {
    "surah_id": 88,
    "ayah_number": 26,
    "global_ayah_id": 5993,
    "translation": "سپس حسابشان [نیز] بر عهده‌ی ماست."
  }
]