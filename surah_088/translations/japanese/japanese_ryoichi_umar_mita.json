[
  {
    "surah_id": 88,
    "ayah_number": 1,
    "global_ayah_id": 5968,
    "translation": "圧倒的（事態の）消息が，あなたに達したか。"
  },
  {
    "surah_id": 88,
    "ayah_number": 2,
    "global_ayah_id": 5969,
    "translation": "（或る者の）顔はその日項垂れ，"
  },
  {
    "surah_id": 88,
    "ayah_number": 3,
    "global_ayah_id": 5970,
    "translation": "骨折り疲れ切って，"
  },
  {
    "surah_id": 88,
    "ayah_number": 4,
    "global_ayah_id": 5971,
    "translation": "燃えさかる獄火で焼かれ，"
  },
  {
    "surah_id": 88,
    "ayah_number": 5,
    "global_ayah_id": 5972,
    "translation": "煮えたぎる泉水を飲まされる。"
  },
  {
    "surah_id": 88,
    "ayah_number": 6,
    "global_ayah_id": 5973,
    "translation": "かれらには苦い茨の外に，食物はなく，"
  },
  {
    "surah_id": 88,
    "ayah_number": 7,
    "global_ayah_id": 5974,
    "translation": "それは栄養にもならず，飢えも癒せない。"
  },
  {
    "surah_id": 88,
    "ayah_number": 8,
    "global_ayah_id": 5975,
    "translation": "（外の或る者たちの）顔は，その日歓喜し，"
  },
  {
    "surah_id": 88,
    "ayah_number": 9,
    "global_ayah_id": 5976,
    "translation": "かれらは努力して心充ち足り，"
  },
  {
    "surah_id": 88,
    "ayah_number": 10,
    "global_ayah_id": 5977,
    "translation": "高い楽園の中に置り，"
  },
  {
    "surah_id": 88,
    "ayah_number": 11,
    "global_ayah_id": 5978,
    "translation": "そこで，虚しい（言葉）を聞かない。"
  },
  {
    "surah_id": 88,
    "ayah_number": 12,
    "global_ayah_id": 5979,
    "translation": "そこには，流れる泉があり，"
  },
  {
    "surah_id": 88,
    "ayah_number": 13,
    "global_ayah_id": 5980,
    "translation": "高く上げられた（位階の）寝床があり，"
  },
  {
    "surah_id": 88,
    "ayah_number": 14,
    "global_ayah_id": 5981,
    "translation": "大杯が備えられ，"
  },
  {
    "surah_id": 88,
    "ayah_number": 15,
    "global_ayah_id": 5982,
    "translation": "褥は数列に並べられ，"
  },
  {
    "surah_id": 88,
    "ayah_number": 16,
    "global_ayah_id": 5983,
    "translation": "敷物が敷きつめられている。"
  },
  {
    "surah_id": 88,
    "ayah_number": 17,
    "global_ayah_id": 5984,
    "translation": "かれらは骼駝に就いて，如何に創られたかを考えてみないのか。"
  },
  {
    "surah_id": 88,
    "ayah_number": 18,
    "global_ayah_id": 5985,
    "translation": "また天に就いて，如何に高く掲げられたか，"
  },
  {
    "surah_id": 88,
    "ayah_number": 19,
    "global_ayah_id": 5986,
    "translation": "また山々に就いて，如何に据え付けられているか，"
  },
  {
    "surah_id": 88,
    "ayah_number": 20,
    "global_ayah_id": 5987,
    "translation": "また大地に就いて，如何に広げられているかを。"
  },
  {
    "surah_id": 88,
    "ayah_number": 21,
    "global_ayah_id": 5988,
    "translation": "だからあなたは訓戒しなさい。本当にあなたは一人の訓戒者に外ならない。"
  },
  {
    "surah_id": 88,
    "ayah_number": 22,
    "global_ayah_id": 5989,
    "translation": "かれらのための，支配者ではない。"
  },
  {
    "surah_id": 88,
    "ayah_number": 23,
    "global_ayah_id": 5990,
    "translation": "だが誰でも，背き去って信仰を拒否するならば，"
  },
  {
    "surah_id": 88,
    "ayah_number": 24,
    "global_ayah_id": 5991,
    "translation": "アッラーは最大の懲罰でかれらを罰される。"
  },
  {
    "surah_id": 88,
    "ayah_number": 25,
    "global_ayah_id": 5992,
    "translation": "本当にわれの許に，かれらは婦り来るのである。"
  },
  {
    "surah_id": 88,
    "ayah_number": 26,
    "global_ayah_id": 5993,
    "translation": "かれらの清算は，本当にわれの任である。"
  }
]