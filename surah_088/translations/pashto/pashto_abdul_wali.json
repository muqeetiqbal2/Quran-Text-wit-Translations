[
  {
    "surah_id": 88,
    "ayah_number": 1,
    "global_ayah_id": 5968,
    "translation": "ایا تا ته (يعنې خلقو لره) د پټوونكي (قیامت) خبر راغلى دى؟"
  },
  {
    "surah_id": 88,
    "ayah_number": 2,
    "global_ayah_id": 5969,
    "translation": "څه مخونه به په دغې ورځ كې خوار (او) وېرېدونكي وي"
  },
  {
    "surah_id": 88,
    "ayah_number": 3,
    "global_ayah_id": 5970,
    "translation": "سخت كار كوونكي، ستړي كېدونكي به وي"
  },
  {
    "surah_id": 88,
    "ayah_number": 4,
    "global_ayah_id": 5971,
    "translation": "ډېر ګرم اور ته به ننوځي"
  },
  {
    "surah_id": 88,
    "ayah_number": 5,
    "global_ayah_id": 5972,
    "translation": "په دوى به له ډېرې ګرمې چېنې نه اوبه څښولى شي"
  },
  {
    "surah_id": 88,
    "ayah_number": 6,
    "global_ayah_id": 5973,
    "translation": "د دوى لپاره به طعام نه وي مګر له اغزنې ترخې ونې نه"
  },
  {
    "surah_id": 88,
    "ayah_number": 7,
    "global_ayah_id": 5974,
    "translation": "چې نه څربول كوي او نه هېڅ لوږه لرې كوي"
  },
  {
    "surah_id": 88,
    "ayah_number": 8,
    "global_ayah_id": 5975,
    "translation": "څه مخونه به په دغې ورځ كې تروتازه وي"
  },
  {
    "surah_id": 88,
    "ayah_number": 9,
    "global_ayah_id": 5976,
    "translation": "په خپل كوشش به راضي (خوشاله) وي"
  },
  {
    "surah_id": 88,
    "ayah_number": 10,
    "global_ayah_id": 5977,
    "translation": "په اوچت جنت كې به وي"
  },
  {
    "surah_id": 88,
    "ayah_number": 11,
    "global_ayah_id": 5978,
    "translation": "دوى به په دغه (جنت) كې هېڅ بېكاره خبره نه اوري"
  },
  {
    "surah_id": 88,
    "ayah_number": 12,
    "global_ayah_id": 5979,
    "translation": "په دغه (جنت) كې روانه چینه ده"
  },
  {
    "surah_id": 88,
    "ayah_number": 13,
    "global_ayah_id": 5980,
    "translation": "په دغه (جنت) كې اوچت تختونه دي"
  },
  {
    "surah_id": 88,
    "ayah_number": 14,
    "global_ayah_id": 5981,
    "translation": "او (په اندازې سره) ایښودل شوي جامونه دي"
  },
  {
    "surah_id": 88,
    "ayah_number": 15,
    "global_ayah_id": 5982,
    "translation": "او په قطار كې ایښودل شوي بالښتونه دي"
  },
  {
    "surah_id": 88,
    "ayah_number": 16,
    "global_ayah_id": 5983,
    "translation": "او غوړول شوي اعلی فرشونه دي"
  },
  {
    "surah_id": 88,
    "ayah_number": 17,
    "global_ayah_id": 5984,
    "translation": "ایا نو دوى اوښانو ته نه ګوري چې دوى څرنګه پیدا كړى شوي دي؟"
  },
  {
    "surah_id": 88,
    "ayah_number": 18,
    "global_ayah_id": 5985,
    "translation": "او اسمان ته چې دى څنګه اوچت كړى شوى دى؟"
  },
  {
    "surah_id": 88,
    "ayah_number": 19,
    "global_ayah_id": 5986,
    "translation": "او غرونو ته چې دوى څنګه ودرول شوي دي؟"
  },
  {
    "surah_id": 88,
    "ayah_number": 20,
    "global_ayah_id": 5987,
    "translation": "او ځمكې ته چې څنګه غوړول شوې ده؟"
  },
  {
    "surah_id": 88,
    "ayah_number": 21,
    "global_ayah_id": 5988,
    "translation": "نو ته پند وركړه، بېشكه ته خو يواځې پند وركوونكى يې"
  },
  {
    "surah_id": 88,
    "ayah_number": 22,
    "global_ayah_id": 5989,
    "translation": "ته په دوى باندې مسلط كړى شوى نه يې"
  },
  {
    "surah_id": 88,
    "ayah_number": 23,
    "global_ayah_id": 5990,
    "translation": "مګر هغه څوك چې (له ایمانه) وګرځي او كافر شي"
  },
  {
    "surah_id": 88,
    "ayah_number": 24,
    "global_ayah_id": 5991,
    "translation": "نو الله به ده ته عذاب وركړي تر ټولو لوى عذاب"
  },
  {
    "surah_id": 88,
    "ayah_number": 25,
    "global_ayah_id": 5992,
    "translation": "بېشكه خاص مونږ ته د دوى بېرته راتګ دى"
  },
  {
    "surah_id": 88,
    "ayah_number": 26,
    "global_ayah_id": 5993,
    "translation": "بیا یقینًا د دوى حساب زمونږ په غاړه دى"
  }
]