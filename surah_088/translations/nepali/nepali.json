[
  {
    "surah_id": 88,
    "ayah_number": 0,
    "global_ayah_id": 6054,
    "translation": "शुरु अत्यन्त करुणामय, परम दयालु अल्लाहको नामबाट ।"
  },
  {
    "surah_id": 88,
    "ayah_number": 1,
    "global_ayah_id": 6055,
    "translation": "के तिमीकहाँ ढपक्कै ढाक्ने विपत्तिको खबर पुगेको छ ?"
  },
  {
    "surah_id": 88,
    "ayah_number": 2,
    "global_ayah_id": 6056,
    "translation": "त्यस दिन कतिपय अनुहारहरू भयभीत हुनेछन् ।"
  },
  {
    "surah_id": 88,
    "ayah_number": 3,
    "global_ayah_id": 6057,
    "translation": "परिश्रम गरिरहेका थकित हुनेछन् ।"
  },
  {
    "surah_id": 88,
    "ayah_number": 4,
    "global_ayah_id": 6058,
    "translation": "तिनीहरू दन्कँदो अग्निमा जाकिनेछन ।"
  },
  {
    "surah_id": 88,
    "ayah_number": 5,
    "global_ayah_id": 6059,
    "translation": "उम्लँदो मुहानबाट खुवाइनेछ ।"
  },
  {
    "surah_id": 88,
    "ayah_number": 6,
    "global_ayah_id": 6060,
    "translation": "सुकेको काँडैकाँडा बाहेक अरू कुनै खाद्यान्न तिनीहरूले पाउने छैनन् ।"
  },
  {
    "surah_id": 88,
    "ayah_number": 7,
    "global_ayah_id": 6061,
    "translation": "जसले न पोषण दिन्छ न भोक नै मार्छ ।"
  },
  {
    "surah_id": 88,
    "ayah_number": 8,
    "global_ayah_id": 6062,
    "translation": "कतिपय अनुहारहरू त्यसदिन प्रफुल्लित हुनेछन् ।"
  },
  {
    "surah_id": 88,
    "ayah_number": 9,
    "global_ayah_id": 6063,
    "translation": "आफ्नो परिश्रमप्रति सन्तुष्ट हुनेछन् ।"
  },
  {
    "surah_id": 88,
    "ayah_number": 10,
    "global_ayah_id": 6064,
    "translation": "उच्च स्वर्गमा हुनेछन् ।"
  },
  {
    "surah_id": 88,
    "ayah_number": 11,
    "global_ayah_id": 6065,
    "translation": "जहाँ कुनै अशिष्ट र व्यर्थ कुरा सुन्ने छैनन् ।"
  },
  {
    "surah_id": 88,
    "ayah_number": 12,
    "global_ayah_id": 6066,
    "translation": "जहाँ बगिरहेका मुहानहरू हुनेछन् ।"
  },
  {
    "surah_id": 88,
    "ayah_number": 13,
    "global_ayah_id": 6067,
    "translation": "त्यहाँ उच्च आसनहरू हुनेछन् ।"
  },
  {
    "surah_id": 88,
    "ayah_number": 14,
    "global_ayah_id": 6068,
    "translation": "र, जाम राखिएका हुनेछन् ।"
  },
  {
    "surah_id": 88,
    "ayah_number": 15,
    "global_ayah_id": 6069,
    "translation": "र, सिरानीहरू पंक्तिहरूमा लगाइएका हुनेछन् ।"
  },
  {
    "surah_id": 88,
    "ayah_number": 16,
    "global_ayah_id": 6070,
    "translation": "र, मखमली गलैंचाहरू विछ्याइएका हुनेछन् ।"
  },
  {
    "surah_id": 88,
    "ayah_number": 17,
    "global_ayah_id": 6071,
    "translation": "के यिनीहरू ऊँटतिर हेर्दैनन् कि कसरी त्यसको सृष्टि गरियो ।"
  },
  {
    "surah_id": 88,
    "ayah_number": 18,
    "global_ayah_id": 6072,
    "translation": "र, आकाशतिर कि त्यो कसरी उच्च पारियो ?"
  },
  {
    "surah_id": 88,
    "ayah_number": 19,
    "global_ayah_id": 6073,
    "translation": "र, पहाडहरूतिर कि कसरी गाडिए ?"
  },
  {
    "surah_id": 88,
    "ayah_number": 20,
    "global_ayah_id": 6074,
    "translation": "र, पृथ्वीतिर कि कसरी विछ्याइयो ?"
  },
  {
    "surah_id": 88,
    "ayah_number": 21,
    "global_ayah_id": 6075,
    "translation": "अतः (हे सन्देष्टा !) उपदेश देऊ । तिमी एउटा उपदेशक मात्र हौ ।"
  },
  {
    "surah_id": 88,
    "ayah_number": 22,
    "global_ayah_id": 6076,
    "translation": "तिनीहरूमाथि हवल्दार होइनौ ।"
  },
  {
    "surah_id": 88,
    "ayah_number": 23,
    "global_ayah_id": 6077,
    "translation": "अँ, जो विमुख हुन्छ र कुफ्र गर्छ"
  },
  {
    "surah_id": 88,
    "ayah_number": 24,
    "global_ayah_id": 6078,
    "translation": "उसलाई अल्लाहले ठुलो यातना दिनेछन् ।"
  },
  {
    "surah_id": 88,
    "ayah_number": 25,
    "global_ayah_id": 6079,
    "translation": "निस्सन्देह हामीतिर नै तिनीहरू फर्कनुछ ।"
  },
  {
    "surah_id": 88,
    "ayah_number": 26,
    "global_ayah_id": 6080,
    "translation": "र, तिनीहरूको हिसाब हाम्रै जिम्मा छ ।"
  }
]