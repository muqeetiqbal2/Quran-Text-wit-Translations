[
  {
    "surah_id": 88,
    "ayah_number": 0,
    "global_ayah_id": 6054,
    "translation": "﻿अल्लाहच्या नावाने, जो अत्यंत दयावंत व असीम कृपावंत आहे."
  },
  {
    "surah_id": 88,
    "ayah_number": 1,
    "global_ayah_id": 6055,
    "translation": "काय तुम्हाला त्या व्यापून टाकणार्‍या आपत्ती (म्हणजे पुनरुत्थानाची) खबर पोहचली आहे?"
  },
  {
    "surah_id": 88,
    "ayah_number": 2,
    "global_ayah_id": 6056,
    "translation": "काही चेहरे त्या दिवशी भयभीत असतील,"
  },
  {
    "surah_id": 88,
    "ayah_number": 3,
    "global_ayah_id": 6057,
    "translation": "कठोर परिश्रम करीत असतील. थकून जात असतील."
  },
  {
    "surah_id": 88,
    "ayah_number": 4,
    "global_ayah_id": 6058,
    "translation": "तीप आगीत होरपळून निघत असतील."
  },
  {
    "surah_id": 88,
    "ayah_number": 5,
    "global_ayah_id": 6059,
    "translation": "उकळत्या झर्‍याचे पाणी त्यांना पिण्यास दिले जाईल."
  },
  {
    "surah_id": 88,
    "ayah_number": 6,
    "global_ayah_id": 6060,
    "translation": "काटेरी वाळलेल्या गवताशिवाय कोणतेही भोजन त्यांच्यासाठी असणार नाही"
  },
  {
    "surah_id": 88,
    "ayah_number": 7,
    "global_ayah_id": 6061,
    "translation": "जे ना पुष्ट करील, जे ना भूक शमवील."
  },
  {
    "surah_id": 88,
    "ayah_number": 8,
    "global_ayah_id": 6062,
    "translation": "काही चेहरे त्या दिवशी प्रफुल्लीत असतील."
  },
  {
    "surah_id": 88,
    "ayah_number": 9,
    "global_ayah_id": 6063,
    "translation": "आपल्या कामगिरीवर आनंदीत असतील,"
  },
  {
    "surah_id": 88,
    "ayah_number": 10,
    "global_ayah_id": 6064,
    "translation": "उच्चकोटीच्या स्वर्गामध्ये असतील."
  },
  {
    "surah_id": 88,
    "ayah_number": 11,
    "global_ayah_id": 6065,
    "translation": "कोणतीही वाह्यात गोष्ट ते तेथे ऐकणार नाहीत"
  },
  {
    "surah_id": 88,
    "ayah_number": 12,
    "global_ayah_id": 6066,
    "translation": "त्यात झरे प्रवाहित असतील,"
  },
  {
    "surah_id": 88,
    "ayah_number": 13,
    "global_ayah_id": 6067,
    "translation": "त्याच्यात उच्च आसने असतील,"
  },
  {
    "surah_id": 88,
    "ayah_number": 14,
    "global_ayah_id": 6068,
    "translation": "पेले ठेवलेले असतील,"
  },
  {
    "surah_id": 88,
    "ayah_number": 15,
    "global_ayah_id": 6069,
    "translation": "लोडांच्या रांगा लावलेल्या असतील,"
  },
  {
    "surah_id": 88,
    "ayah_number": 16,
    "global_ayah_id": 6070,
    "translation": "आणि उत्कृष्ट बिछाने  अंथरलेले  असतील."
  },
  {
    "surah_id": 88,
    "ayah_number": 17,
    "global_ayah_id": 6071,
    "translation": "(हे लोक मानीत नाहीत) तर काय हे उंटांना पाहात नाहीत की कसे बनविले गेलेत?"
  },
  {
    "surah_id": 88,
    "ayah_number": 18,
    "global_ayah_id": 6072,
    "translation": "आकाशाला पहात नाहीत की कसे उभारले गेले?"
  },
  {
    "surah_id": 88,
    "ayah_number": 19,
    "global_ayah_id": 6073,
    "translation": "पर्वतांना पहात नाहीत की कसे दृढ केले गेलेत?"
  },
  {
    "surah_id": 88,
    "ayah_number": 20,
    "global_ayah_id": 6074,
    "translation": "आणि पृथ्वीला पहात नाहीत की कशी अंथरली गेली?"
  },
  {
    "surah_id": 88,
    "ayah_number": 21,
    "global_ayah_id": 6075,
    "translation": "बरे तर (हे पैगंबर (स.)), उपदेश करीत रहा, तुम्ही केवळ उपदेशच करणारे आहात,"
  },
  {
    "surah_id": 88,
    "ayah_number": 22,
    "global_ayah_id": 6076,
    "translation": "यांच्यावर जबरदस्ती करणारे नाहीत."
  },
  {
    "surah_id": 88,
    "ayah_number": 23,
    "global_ayah_id": 6077,
    "translation": "तथापि जो इसम विमुख होईल आणि इन्कार करील"
  },
  {
    "surah_id": 88,
    "ayah_number": 24,
    "global_ayah_id": 6078,
    "translation": "तर अल्लाह त्याला भारी शिक्षा देईल."
  },
  {
    "surah_id": 88,
    "ayah_number": 25,
    "global_ayah_id": 6079,
    "translation": "या लोकांना परतावयाचे आमच्याकडे आहे,"
  },
  {
    "surah_id": 88,
    "ayah_number": 26,
    "global_ayah_id": 6080,
    "translation": "मग त्यांचा हिशोब घेणे आमच्याकडेच आहे."
  }
]