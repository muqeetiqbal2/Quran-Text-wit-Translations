[
  {
    "surah_id": 88,
    "ayah_number": 0,
    "global_ayah_id": 6054,
    "translation": "اللہ دے ناں نال ( شروع ) جیہڑا حدوں مہربان ، بوہت رحم والا اے ۔"
  },
  {
    "surah_id": 88,
    "ayah_number": 1,
    "global_ayah_id": 6055,
    "translation": "بھلا تہانوں کج لین والی ( آفت ) دی خبر اپڑی اے ؟"
  },
  {
    "surah_id": 88,
    "ayah_number": 2,
    "global_ayah_id": 6056,
    "translation": "اوس دیہاڑے کئی بُوتھے خوار ہون گے"
  },
  {
    "surah_id": 88,
    "ayah_number": 3,
    "global_ayah_id": 6057,
    "translation": "کھیچل کرن والے تھک جان والے"
  },
  {
    "surah_id": 88,
    "ayah_number": 4,
    "global_ayah_id": 6058,
    "translation": "بھکھدی اگ جھیلن گے"
  },
  {
    "surah_id": 88,
    "ayah_number": 5,
    "global_ayah_id": 6059,
    "translation": "اوہناں نوں بلدے پانی دے چشمے توں پلایا جائے گا"
  },
  {
    "surah_id": 88,
    "ayah_number": 6,
    "global_ayah_id": 6060,
    "translation": "اوہناں دا کھاج کنڈیالی بوٹی سوا کجھ نئیں ہووے گا"
  },
  {
    "surah_id": 88,
    "ayah_number": 7,
    "global_ayah_id": 6061,
    "translation": "( جیہڑی ) نہ موٹا کرے گی تے نہ بھکھ ہٹاوے گی"
  },
  {
    "surah_id": 88,
    "ayah_number": 8,
    "global_ayah_id": 6062,
    "translation": "اوس دیہاڑے کئی چہرے کھِڑدے ہون گے"
  },
  {
    "surah_id": 88,
    "ayah_number": 9,
    "global_ayah_id": 6063,
    "translation": "اپنی کوشش تے راضی"
  },
  {
    "surah_id": 88,
    "ayah_number": 10,
    "global_ayah_id": 6064,
    "translation": "عالی باغ بہشت وچ"
  },
  {
    "surah_id": 88,
    "ayah_number": 11,
    "global_ayah_id": 6065,
    "translation": "اوہدے وچ کوئی فضول گل نئیں سنن گے"
  },
  {
    "surah_id": 88,
    "ayah_number": 12,
    "global_ayah_id": 6066,
    "translation": "اوہدے وچ اک وگدا چشمہ ہووے گا"
  },
  {
    "surah_id": 88,
    "ayah_number": 13,
    "global_ayah_id": 6067,
    "translation": "اوہدے وچ اُچے تخت ہون گے"
  },
  {
    "surah_id": 88,
    "ayah_number": 14,
    "global_ayah_id": 6068,
    "translation": "تے قرینے نال ٹکائے ہوئے بے دستہ کوزے"
  },
  {
    "surah_id": 88,
    "ayah_number": 15,
    "global_ayah_id": 6069,
    "translation": "تے قطاراں وچ گاؤ تکیے ہون گے"
  },
  {
    "surah_id": 88,
    "ayah_number": 16,
    "global_ayah_id": 6070,
    "translation": "تے وچھائے ہوئے مخملی وچھونے"
  },
  {
    "surah_id": 88,
    "ayah_number": 17,
    "global_ayah_id": 6071,
    "translation": "بھلا فیر اوہ اُوٹھاں ول نئیں ویکھدے اوہ کینویں پیدا کیتے گئے نیں ؟"
  },
  {
    "surah_id": 88,
    "ayah_number": 18,
    "global_ayah_id": 6072,
    "translation": "تے اسمان ول اوہ کینویں اُچا کیتا گیا اے ؟"
  },
  {
    "surah_id": 88,
    "ayah_number": 19,
    "global_ayah_id": 6073,
    "translation": "تے پہاڑاں ول اوہ کینویں گڈے گئے نیں ؟"
  },
  {
    "surah_id": 88,
    "ayah_number": 20,
    "global_ayah_id": 6074,
    "translation": "تے زمین ول اوہ کینویں وچھائی گئی اے ؟"
  },
  {
    "surah_id": 88,
    "ayah_number": 21,
    "global_ayah_id": 6075,
    "translation": "سو نصیحت کرو بیشک تسی نصیحت کرن والے ای او"
  },
  {
    "surah_id": 88,
    "ayah_number": 22,
    "global_ayah_id": 6076,
    "translation": "تسی اوہناں دے ٹھیکیدار ہرگز نئیں جے"
  },
  {
    "surah_id": 88,
    "ayah_number": 23,
    "global_ayah_id": 6077,
    "translation": "پر جنھے مونھ موڑیا تے کفر کیتا"
  },
  {
    "surah_id": 88,
    "ayah_number": 24,
    "global_ayah_id": 6078,
    "translation": "فیر اوہنوں اللہ سب توں وڈے عذاب نال سزا دیوے گا"
  },
  {
    "surah_id": 88,
    "ayah_number": 25,
    "global_ayah_id": 6079,
    "translation": "بیشک ساڈے ول ای اوہناں دا پرتنا اے"
  },
  {
    "surah_id": 88,
    "ayah_number": 26,
    "global_ayah_id": 6080,
    "translation": "مڑ ساڈے ذمے ای بیشک اوہناں دا حساب لینا"
  }
]