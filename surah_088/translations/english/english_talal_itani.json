[
  {
    "surah_id": 88,
    "ayah_number": 1,
    "global_ayah_id": 5968,
    "translation": "Has there come to you the news of the overwhelming?"
  },
  {
    "surah_id": 88,
    "ayah_number": 2,
    "global_ayah_id": 5969,
    "translation": "Faces on that Day will be shamed."
  },
  {
    "surah_id": 88,
    "ayah_number": 3,
    "global_ayah_id": 5970,
    "translation": "Laboring and exhausted."
  },
  {
    "surah_id": 88,
    "ayah_number": 4,
    "global_ayah_id": 5971,
    "translation": "Roasting in a scorching Fire."
  },
  {
    "surah_id": 88,
    "ayah_number": 5,
    "global_ayah_id": 5972,
    "translation": "Given to drink from a flaming spring."
  },
  {
    "surah_id": 88,
    "ayah_number": 6,
    "global_ayah_id": 5973,
    "translation": "They will have no food except thorns."
  },
  {
    "surah_id": 88,
    "ayah_number": 7,
    "global_ayah_id": 5974,
    "translation": "That neither nourishes, nor satisfies hunger."
  },
  {
    "surah_id": 88,
    "ayah_number": 8,
    "global_ayah_id": 5975,
    "translation": "Faces on that Day will be joyful."
  },
  {
    "surah_id": 88,
    "ayah_number": 9,
    "global_ayah_id": 5976,
    "translation": "Satisfied with their endeavor."
  },
  {
    "surah_id": 88,
    "ayah_number": 10,
    "global_ayah_id": 5977,
    "translation": "In a lofty Garden."
  },
  {
    "surah_id": 88,
    "ayah_number": 11,
    "global_ayah_id": 5978,
    "translation": "In it you will hear no nonsense."
  },
  {
    "surah_id": 88,
    "ayah_number": 12,
    "global_ayah_id": 5979,
    "translation": "In it is a flowing spring."
  },
  {
    "surah_id": 88,
    "ayah_number": 13,
    "global_ayah_id": 5980,
    "translation": "In it are raised beds."
  },
  {
    "surah_id": 88,
    "ayah_number": 14,
    "global_ayah_id": 5981,
    "translation": "And cups set in place."
  },
  {
    "surah_id": 88,
    "ayah_number": 15,
    "global_ayah_id": 5982,
    "translation": "And cushions set in rows."
  },
  {
    "surah_id": 88,
    "ayah_number": 16,
    "global_ayah_id": 5983,
    "translation": "And carpets spread around."
  },
  {
    "surah_id": 88,
    "ayah_number": 17,
    "global_ayah_id": 5984,
    "translation": "Do they not look at the camels—how they are created?"
  },
  {
    "surah_id": 88,
    "ayah_number": 18,
    "global_ayah_id": 5985,
    "translation": "And at the sky—how it is raised?"
  },
  {
    "surah_id": 88,
    "ayah_number": 19,
    "global_ayah_id": 5986,
    "translation": "And at the mountains—how they are installed?"
  },
  {
    "surah_id": 88,
    "ayah_number": 20,
    "global_ayah_id": 5987,
    "translation": "And at the earth—how it is spread out?"
  },
  {
    "surah_id": 88,
    "ayah_number": 21,
    "global_ayah_id": 5988,
    "translation": "So remind. You are only a reminder."
  },
  {
    "surah_id": 88,
    "ayah_number": 22,
    "global_ayah_id": 5989,
    "translation": "You have no control over them."
  },
  {
    "surah_id": 88,
    "ayah_number": 23,
    "global_ayah_id": 5990,
    "translation": "But whoever turns away and disbelieves."
  },
  {
    "surah_id": 88,
    "ayah_number": 24,
    "global_ayah_id": 5991,
    "translation": "God will punish him with the greatest punishment."
  },
  {
    "surah_id": 88,
    "ayah_number": 25,
    "global_ayah_id": 5992,
    "translation": "To Us is their return."
  },
  {
    "surah_id": 88,
    "ayah_number": 26,
    "global_ayah_id": 5993,
    "translation": "Then upon Us rests their reckoning."
  }
]