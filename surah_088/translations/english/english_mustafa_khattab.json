  },
  {
    "surah_id": 88,
    "ayah_number": 1,
    "global_ayah_id": 6055,
    "translation": "Has the news of the Overwhelming Event reached you ˹O Prophet˺"
  },
  {
    "surah_id": 88,
    "ayah_number": 2,
