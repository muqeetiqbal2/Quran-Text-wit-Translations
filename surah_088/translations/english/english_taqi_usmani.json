[
  {
    "surah_id": 88,
    "ayah_number": 0,
    "global_ayah_id": 6054,
    "translation": "In the name of Allah, the Most Gracious, the Most Merciful."
  },
  {
    "surah_id": 88,
    "ayah_number": 1,
    "global_ayah_id": 6055,
    "translation": "Has there come to you the description of the Overwhelming Event?"
  },
  {
    "surah_id": 88,
    "ayah_number": 2,
    "global_ayah_id": 6056,
    "translation": "Many faces that day will be humbled,"
  },
  {
    "surah_id": 88,
    "ayah_number": 3,
    "global_ayah_id": 6057,
    "translation": "laboring, exhausted."
  },
  {
    "surah_id": 88,
    "ayah_number": 4,
    "global_ayah_id": 6058,
    "translation": "They will enter into the scorching fire."
  },
  {
    "surah_id": 88,
    "ayah_number": 5,
    "global_ayah_id": 6059,
    "translation": "They will be made to drink water from a boiling spring."
  },
  {
    "surah_id": 88,
    "ayah_number": 6,
    "global_ayah_id": 6060,
    "translation": "There will be no food for them except from a thorny plant"
  },
  {
    "surah_id": 88,
    "ayah_number": 7,
    "global_ayah_id": 6061,
    "translation": "that will neither nourish, nor satisfy hunger."
  },
  {
    "surah_id": 88,
    "ayah_number": 8,
    "global_ayah_id": 6062,
    "translation": "Many faces that day will be full of glamour,"
  },
  {
    "surah_id": 88,
    "ayah_number": 9,
    "global_ayah_id": 6063,
    "translation": "well pleased with their endeavor,"
  },
  {
    "surah_id": 88,
    "ayah_number": 10,
    "global_ayah_id": 6064,
    "translation": "in a lofty garden,"
  },
  {
    "surah_id": 88,
    "ayah_number": 11,
    "global_ayah_id": 6065,
    "translation": "in which they will not hear any absurd talk."
  },
  {
    "surah_id": 88,
    "ayah_number": 12,
    "global_ayah_id": 6066,
    "translation": "In it there is a flowing spring."
  },
  {
    "surah_id": 88,
    "ayah_number": 13,
    "global_ayah_id": 6067,
    "translation": "In it there are elevated couches"
  },
  {
    "surah_id": 88,
    "ayah_number": 14,
    "global_ayah_id": 6068,
    "translation": "and goblets, well placed,"
  },
  {
    "surah_id": 88,
    "ayah_number": 15,
    "global_ayah_id": 6069,
    "translation": "and cushions, arrayed"
  },
  {
    "surah_id": 88,
    "ayah_number": 16,
    "global_ayah_id": 6070,
    "translation": "and carpets, spread around."
  },
  {
    "surah_id": 88,
    "ayah_number": 17,
    "global_ayah_id": 6071,
    "translation": "So, do they not look at the camels how they are created,"
  },
  {
    "surah_id": 88,
    "ayah_number": 18,
    "global_ayah_id": 6072,
    "translation": "and at the sky, how it is raised high,"
  },
  {
    "surah_id": 88,
    "ayah_number": 19,
    "global_ayah_id": 6073,
    "translation": "and at the mountains, how they are installed,"
  },
  {
    "surah_id": 88,
    "ayah_number": 20,
    "global_ayah_id": 6074,
    "translation": "and at the earth, how it is spread out?"
  },
  {
    "surah_id": 88,
    "ayah_number": 21,
    "global_ayah_id": 6075,
    "translation": "So, (O Prophet,) keep on preaching; you are only a preacher."
  },
  {
    "surah_id": 88,
    "ayah_number": 22,
    "global_ayah_id": 6076,
    "translation": "You are not a taskmaster set up over them,"
  },
  {
    "surah_id": 88,
    "ayah_number": 23,
    "global_ayah_id": 6077,
    "translation": "but whoever turns away and disbelieves,"
  },
  {
    "surah_id": 88,
    "ayah_number": 24,
    "global_ayah_id": 6078,
    "translation": "Allah will punish him with the greatest torment."
  },
  {
    "surah_id": 88,
    "ayah_number": 25,
    "global_ayah_id": 6079,
    "translation": "Surely towards Us they have to return,"
  },
  {
    "surah_id": 88,
    "ayah_number": 26,
    "global_ayah_id": 6080,
    "translation": "then it is Our job to call them to account."
  }
]