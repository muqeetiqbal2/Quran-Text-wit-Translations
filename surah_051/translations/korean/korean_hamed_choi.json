[
  {
    "surah_id": 51,
    "ayah_number": 1,
    "global_ayah_id": 4676,
    "translation": "분산케 하는 바람으로 맹세하며"
  },
  {
    "surah_id": 51,
    "ayah_number": 2,
    "global_ayah_id": 4677,
    "translation": "무거운 것을 운반하는 구름으 로 맹세하며"
  },
  {
    "surah_id": 51,
    "ayah_number": 3,
    "global_ayah_id": 4678,
    "translation": "순항하는 배로써 맹세하며"
  },
  {
    "surah_id": 51,
    "ayah_number": 4,
    "global_ayah_id": 4679,
    "translation": "하나님의 명령에 따라 축복을분배하여 주는 천사로써 맹세하 노니"
  },
  {
    "surah_id": 51,
    "ayah_number": 5,
    "global_ayah_id": 4680,
    "translation": "실로 너희에게 약속된 것은 진실이라"
  },
  {
    "surah_id": 51,
    "ayah_number": 6,
    "global_ayah_id": 4681,
    "translation": "심판이 곧 오리라"
  },
  {
    "surah_id": 51,
    "ayah_number": 7,
    "global_ayah_id": 4682,
    "translation": "완전한 궤도를 가진 하늘로 맹세하나니"
  },
  {
    "surah_id": 51,
    "ayah_number": 8,
    "global_ayah_id": 4683,
    "translation": "실로 너희는 일치하지 않는 논쟁을 일삼는 자들이라"
  },
  {
    "surah_id": 51,
    "ayah_number": 9,
    "global_ayah_id": 4684,
    "translation": "진실로부터 멀어져 현혹된 자 마찬가지로 유흑되노라"
  },
  {
    "surah_id": 51,
    "ayah_number": 10,
    "global_ayah_id": 4685,
    "translation": "거짓하는 자들 위에 저주가 있으리니"
  },
  {
    "surah_id": 51,
    "ayah_number": 11,
    "global_ayah_id": 4686,
    "translation": "그들은 혼란의 홍수 속에서 무관심했던 자들로"
  },
  {
    "surah_id": 51,
    "ayah_number": 12,
    "global_ayah_id": 4687,
    "translation": "심판의 날이 언제 오느뇨 라고 물으매"
  },
  {
    "surah_id": 51,
    "ayah_number": 13,
    "global_ayah_id": 4688,
    "translation": "그들이 불지옥에 들어가 태 워지는 날이라"
  },
  {
    "surah_id": 51,
    "ayah_number": 14,
    "global_ayah_id": 4689,
    "translation": "이 벌을 맛보라 너희가 서둘 러 재촉했던 것이라"
  },
  {
    "surah_id": 51,
    "ayah_number": 15,
    "global_ayah_id": 4690,
    "translation": "그러나 의로운 자들은 샘이 있는 천국에서 거주하며"
  },
  {
    "surah_id": 51,
    "ayah_number": 16,
    "global_ayah_id": 4691,
    "translation": "주님께서 부여한 은혜속에서 기뻐하나니 이는 그들이 의롭게 살았기 때문이라"
  },
  {
    "surah_id": 51,
    "ayah_number": 17,
    "global_ayah_id": 4692,
    "translation": "그들은 밤에도 많은 잠을 자 지 아니하고"
  },
  {
    "surah_id": 51,
    "ayah_number": 18,
    "global_ayah_id": 4693,
    "translation": "이른 새벽부터"
  },
  {
    "surah_id": 51,
    "ayah_number": 19,
    "global_ayah_id": 4694,
    "translation": "그가 가진 재산중에서 필요 로 한 자와 요구하지 못한 자에게 일정한 몫을 베푸는 자라"
  },
  {
    "surah_id": 51,
    "ayah_number": 20,
    "global_ayah_id": 4695,
    "translation": "대지 위에는 믿음이 확고한 자들을 위한 예증들이 있으며"
  },
  {
    "surah_id": 51,
    "ayah_number": 21,
    "global_ayah_id": 4696,
    "translation": "너희 마음속에도 있거늘 너 희는 알지 못하느뇨"
  },
  {
    "surah_id": 51,
    "ayah_number": 22,
    "global_ayah_id": 4697,
    "translation": "하늘에는 너희가 일용할 양 식이 있으며 또한 너희에게 약속 된 것도 있노라"
  },
  {
    "surah_id": 51,
    "ayah_number": 23,
    "global_ayah_id": 4698,
    "translation": "하늘과 대지의 주님으로 맹 세하사 이것은 너희가 서로에게 말하고 있는 것처럼 진리라"
  },
  {
    "surah_id": 51,
    "ayah_number": 24,
    "global_ayah_id": 4699,
    "translation": "아브라함의 존경받는 손님의얘기가 그대에게 이르렀느뇨"
  },
  {
    "surah_id": 51,
    "ayah_number": 25,
    "global_ayah_id": 4700,
    "translation": "그들이 그에게 평안하소서 라고 인사하니 그도 평안하소서라고 알지 못한 그들에게 인사하더 라"
  },
  {
    "surah_id": 51,
    "ayah_number": 26,
    "global_ayah_id": 4701,
    "translation": "그때는 재빨리 그의 집안으 로 들어가 살찐 송아지 한마리를 가져와"
  },
  {
    "surah_id": 51,
    "ayah_number": 27,
    "global_ayah_id": 4702,
    "translation": "그것을 그들 앞에 놓으면서 드시지 않겠습니까 라고 말하였더라"
  },
  {
    "surah_id": 51,
    "ayah_number": 28,
    "global_ayah_id": 4703,
    "translation": "그들이 먹지 아니하자 그는 그들을 두려워 하였노라 이때 그 들이 두려워 하지 말라고 말하며 그에게 총명한 아들이 있을 것이 라는 기쁜 소식을 전하였더라"
  },
  {
    "surah_id": 51,
    "ayah_number": 29,
    "global_ayah_id": 4704,
    "translation": "이때 크게 웃으며 그의 아내가 다가와 그녀의 이마를 때리며 늙고 불임의 여성이 애를 갖는단 말이요 라고 말하매"
  },
  {
    "surah_id": 51,
    "ayah_number": 30,
    "global_ayah_id": 4705,
    "translation": "그들은 주님께서 그렇게 말 씀이 있었으니 실로 그분은 지혜 와 아심으로 충만하심이라 대답하였더라"
  },
  {
    "surah_id": 51,
    "ayah_number": 31,
    "global_ayah_id": 4706,
    "translation": "그가 사자들이여 당신들 의 용무는 무엇입니까 물으니"
  },
  {
    "surah_id": 51,
    "ayah_number": 32,
    "global_ayah_id": 4707,
    "translation": "그들이 말하길 우리는 죄악 에 빠진 백성에게 보내어져"
  },
  {
    "surah_id": 51,
    "ayah_number": 33,
    "global_ayah_id": 4708,
    "translation": "그들 위에 찰흙의 돌을 빗발처럼 보내니"
  },
  {
    "surah_id": 51,
    "ayah_number": 34,
    "global_ayah_id": 4709,
    "translation": "그것은 죄지은 자들에게 주 님의 표시가 쩍혀 보내진 것이라 하더라"
  },
  {
    "surah_id": 51,
    "ayah_number": 35,
    "global_ayah_id": 4710,
    "translation": "그때 하나님은 그곳에 있었던 믿음을 가진 신도들을 구하노라"
  },
  {
    "surah_id": 51,
    "ayah_number": 36,
    "global_ayah_id": 4711,
    "translation": "그러나 하나님은 한 가정 외에는 어떤 무슬림도 발견치 못하여"
  },
  {
    "surah_id": 51,
    "ayah_number": 37,
    "global_ayah_id": 4712,
    "translation": "무서운 징벌을 두려워 하는 그들을 위해 그곳에 예증을 남겨 두었노라"
  },
  {
    "surah_id": 51,
    "ayah_number": 38,
    "global_ayah_id": 4713,
    "translation": "모세의 이야기 속에도 예증 이 있나니 보라 하나님은 그에게 명백한 권능을 주어 파라오에게 보냈노라"
  },
  {
    "surah_id": 51,
    "ayah_number": 39,
    "global_ayah_id": 4714,
    "translation": "그러나 그는 그의 군대와 더불어 외면하며 그는 마술사인가 아니면 미친 자인가 라고 말하였 더라"
  },
  {
    "surah_id": 51,
    "ayah_number": 40,
    "global_ayah_id": 4715,
    "translation": "그리하여 하나님은 그와 그 리고 그의 군대를 포획하여 바다 속에 던졌으매 그에 대한 비난은 당연했더라"
  },
  {
    "surah_id": 51,
    "ayah_number": 41,
    "global_ayah_id": 4716,
    "translation": "아드의 백성 속에서도 예증 이 있나니 보라 하나님이 그들에 게 파멸의 바람을 보냈으니"
  },
  {
    "surah_id": 51,
    "ayah_number": 42,
    "global_ayah_id": 4717,
    "translation": "바람이 불었던 곳에는 아무것도 남겨진 것없이 재처럼 파괴 되어 버렸더라"
  },
  {
    "surah_id": 51,
    "ayah_number": 43,
    "global_ayah_id": 4718,
    "translation": "사무드 백성 속에서도 예증 이 있었으니 보라 잠시동안 향락 하고자 하였으되"
  },
  {
    "surah_id": 51,
    "ayah_number": 44,
    "global_ayah_id": 4719,
    "translation": "그들은 주님의 명령을 거역 하였으매 지켜보던 징벌의 광음이그들을 멸망케 하였더라"
  },
  {
    "surah_id": 51,
    "ayah_number": 45,
    "global_ayah_id": 4720,
    "translation": "그들은 일어설 수도 없었고 스스로를 보호할 수도 없었노라"
  },
  {
    "surah_id": 51,
    "ayah_number": 46,
    "global_ayah_id": 4721,
    "translation": "그들 이전의 노아의 백성도 그랬으니 그들도 사악한 백성들이었노라"
  },
  {
    "surah_id": 51,
    "ayah_number": 47,
    "global_ayah_id": 4722,
    "translation": "하나님께서 하늘을 두사 권 능과 능력으로 높이 두고 넓게 두셨으며"
  },
  {
    "surah_id": 51,
    "ayah_number": 48,
    "global_ayah_id": 4723,
    "translation": "대지를 두되 넓게 펼쳤으너 얼마나 아름답게 펼쳐 졌느뇨"
  },
  {
    "surah_id": 51,
    "ayah_number": 49,
    "global_ayah_id": 4724,
    "translation": "하나님이 모든 것을 창조하 시되 자웅을 두었으니 이로 하여 너희가 교훈을 얻도록 함이라"
  },
  {
    "surah_id": 51,
    "ayah_number": 50,
    "global_ayah_id": 4725,
    "translation": "그러므로 서둘러 하나님께로오라 실로 나는 그분께서 너희에 게 보낸 분명한 선지자라"
  },
  {
    "surah_id": 51,
    "ayah_number": 51,
    "global_ayah_id": 4726,
    "translation": "하나님과 더불어 다른 것을 숭배하지 말라 실로 내가 그분으 로부터 너희에게 온 분명한 선지 자라"
  },
  {
    "surah_id": 51,
    "ayah_number": 52,
    "global_ayah_id": 4727,
    "translation": "그들 이전에도 선지자가 백성들에게 왔으되 그들 또한 그는 마 술사요 아니면 미친자라 말했더라"
  },
  {
    "surah_id": 51,
    "ayah_number": 53,
    "global_ayah_id": 4728,
    "translation": "그들이 서로에게 상속한 유 산이라도 된단 말인가 실로 그들 은 오만한 백성들이라"
  },
  {
    "surah_id": 51,
    "ayah_number": 54,
    "global_ayah_id": 4729,
    "translation": "그러므로 그들을 멀리하라 그리하면 문책받지 않을 것이라"
  },
  {
    "surah_id": 51,
    "ayah_number": 55,
    "global_ayah_id": 4730,
    "translation": "그러나 그대의 메세지를 가르치라 믿는 신도들에게 유익하니라"
  },
  {
    "surah_id": 51,
    "ayah_number": 56,
    "global_ayah_id": 4731,
    "translation": "내가 영마와 인간을 창조함은그들이 나를 섬기게 하려 함이라"
  },
  {
    "surah_id": 51,
    "ayah_number": 57,
    "global_ayah_id": 4732,
    "translation": "내가 그들에게 일용할 양식 을 구하지 아니하며 또한 나를 부 양하길 바라지도 않노라"
  },
  {
    "surah_id": 51,
    "ayah_number": 58,
    "global_ayah_id": 4733,
    "translation": "실로 하나님은 권능과 힘의 주님으로서 일용할 양식을 베푸는 수여자이시라"
  },
  {
    "surah_id": 51,
    "ayah_number": 59,
    "global_ayah_id": 4734,
    "translation": "죄지은 무리는 그들 동료의 무리와 유사한 벌을 받노라 그러 므로 나에게 서둘러 구하지 않도 록 하라"
  },
  {
    "surah_id": 51,
    "ayah_number": 60,
    "global_ayah_id": 4735,
    "translation": "그들이 약속받은 그날을 믿지 아니한 자들에게 재앙이 있으리라"
  }
]