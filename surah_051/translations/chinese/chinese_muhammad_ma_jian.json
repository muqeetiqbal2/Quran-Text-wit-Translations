[
  {
    "surah_id": 51,
    "ayah_number": 1,
    "global_ayah_id": 4676,
    "translation": "誓以播種者，"
  },
  {
    "surah_id": 51,
    "ayah_number": 2,
    "global_ayah_id": 4677,
    "translation": "載重者，"
  },
  {
    "surah_id": 51,
    "ayah_number": 3,
    "global_ayah_id": 4678,
    "translation": "飄流者，"
  },
  {
    "surah_id": 51,
    "ayah_number": 4,
    "global_ayah_id": 4679,
    "translation": "分配者，"
  },
  {
    "surah_id": 51,
    "ayah_number": 5,
    "global_ayah_id": 4680,
    "translation": "警告你們的事確是真實的，"
  },
  {
    "surah_id": 51,
    "ayah_number": 6,
    "global_ayah_id": 4681,
    "translation": "報應確是要發生的。"
  },
  {
    "surah_id": 51,
    "ayah_number": 7,
    "global_ayah_id": 4682,
    "translation": "以有軌道的諸天盟誓，"
  },
  {
    "surah_id": 51,
    "ayah_number": 8,
    "global_ayah_id": 4683,
    "translation": "你們確是各執一說的，"
  },
  {
    "surah_id": 51,
    "ayah_number": 9,
    "global_ayah_id": 4684,
    "translation": "原被阻遏者，將被阻遏，而不得到達他。"
  },
  {
    "surah_id": 51,
    "ayah_number": 10,
    "global_ayah_id": 4685,
    "translation": "願常常說謊者被棄絕！"
  },
  {
    "surah_id": 51,
    "ayah_number": 11,
    "global_ayah_id": 4686,
    "translation": "他們浸沉在愚昧之中，他們是昏憒的。"
  },
  {
    "surah_id": 51,
    "ayah_number": 12,
    "global_ayah_id": 4687,
    "translation": "他們問報應日在什麼時候，"
  },
  {
    "surah_id": 51,
    "ayah_number": 13,
    "global_ayah_id": 4688,
    "translation": "那是他們在火刑上受刑之日。"
  },
  {
    "surah_id": 51,
    "ayah_number": 14,
    "global_ayah_id": 4689,
    "translation": "你們嘗試你們的刑罰吧！這就是你們要求早日實現的。"
  },
  {
    "surah_id": 51,
    "ayah_number": 15,
    "global_ayah_id": 4690,
    "translation": "敬畏的人們必定在許多樂園中，在許多泉源畔，"
  },
  {
    "surah_id": 51,
    "ayah_number": 16,
    "global_ayah_id": 4691,
    "translation": "接受他們的主所賞賜的。他們在生前確是行善的，"
  },
  {
    "surah_id": 51,
    "ayah_number": 17,
    "global_ayah_id": 4692,
    "translation": "他們在夜間只稍稍睡一下，"
  },
  {
    "surah_id": 51,
    "ayah_number": 18,
    "global_ayah_id": 4693,
    "translation": "他們在黎明時向主求饒，"
  },
  {
    "surah_id": 51,
    "ayah_number": 19,
    "global_ayah_id": 4694,
    "translation": "他們的財產中，有乞丐和貧民的權利。"
  },
  {
    "surah_id": 51,
    "ayah_number": 20,
    "global_ayah_id": 4695,
    "translation": "在大地上對於篤信的人們，有許多跡象；"
  },
  {
    "surah_id": 51,
    "ayah_number": 21,
    "global_ayah_id": 4696,
    "translation": "在你們自身中也有許多跡象，難道你們看不見嗎？"
  },
  {
    "surah_id": 51,
    "ayah_number": 22,
    "global_ayah_id": 4697,
    "translation": "在天上，有你們的給養，也有應許你們的賞罰。"
  },
  {
    "surah_id": 51,
    "ayah_number": 23,
    "global_ayah_id": 4698,
    "translation": "以天地的主盟誓，這確是真實的，猶如你們能說話一樣。"
  },
  {
    "surah_id": 51,
    "ayah_number": 24,
    "global_ayah_id": 4699,
    "translation": "關於易卜拉欣的受優待的賓客的故事，已來臨你了嗎？"
  },
  {
    "surah_id": 51,
    "ayah_number": 25,
    "global_ayah_id": 4700,
    "translation": "當時，他們進去見他，他們說：「祝你平安！」他說：「祝你們平安！」他想這些是生客。"
  },
  {
    "surah_id": 51,
    "ayah_number": 26,
    "global_ayah_id": 4701,
    "translation": "於是他悄悄地走到他的家屬那裡，拿來一頭肥嫩的牛犢，"
  },
  {
    "surah_id": 51,
    "ayah_number": 27,
    "global_ayah_id": 4702,
    "translation": "他把那牛犢送到客人面前，說：「你們怎麼不吃呢！」"
  },
  {
    "surah_id": 51,
    "ayah_number": 28,
    "global_ayah_id": 4703,
    "translation": "他為他們而心懷恐懼。他們說：「你不要恐懼。」他們以一個有學識的兒童向他報喜。"
  },
  {
    "surah_id": 51,
    "ayah_number": 29,
    "global_ayah_id": 4704,
    "translation": "他的女人便喊叫著走來，她打自己的臉，說：「我是一個不能生育的老婦人。」"
  },
  {
    "surah_id": 51,
    "ayah_number": 30,
    "global_ayah_id": 4705,
    "translation": "他們說：「你的主是這樣說的，他確是至睿的，確是全知的。」"
  },
  {
    "surah_id": 51,
    "ayah_number": 31,
    "global_ayah_id": 4706,
    "translation": "他說：「諸位使者啊！你們有什麼差事呢？」"
  },
  {
    "surah_id": 51,
    "ayah_number": 32,
    "global_ayah_id": 4707,
    "translation": "他們說：「我們確已奉派去懲治一群犯罪的民眾，"
  },
  {
    "surah_id": 51,
    "ayah_number": 33,
    "global_ayah_id": 4708,
    "translation": "我們將因毀滅他們而降下黏土變成的石頭，"
  },
  {
    "surah_id": 51,
    "ayah_number": 34,
    "global_ayah_id": 4709,
    "translation": "那是從你的主那裡為過分者而發出的。」"
  },
  {
    "surah_id": 51,
    "ayah_number": 35,
    "global_ayah_id": 4710,
    "translation": "我把城裡所有的信士都救了出來，"
  },
  {
    "surah_id": 51,
    "ayah_number": 36,
    "global_ayah_id": 4711,
    "translation": "我在城裡只發現一家歸順者。"
  },
  {
    "surah_id": 51,
    "ayah_number": 37,
    "global_ayah_id": 4712,
    "translation": "我曾在城裡留下一種跡象，以便畏懼痛苦的刑罰的人們用作鑒戒。"
  },
  {
    "surah_id": 51,
    "ayah_number": 38,
    "global_ayah_id": 4713,
    "translation": "在穆薩的故事裡也有一種跡象。當時，我曾派遣他帶著一件明証去見法老。"
  },
  {
    "surah_id": 51,
    "ayah_number": 39,
    "global_ayah_id": 4714,
    "translation": "但法老因有勢力故背棄穆薩，他說：「這是一個術士，或是一個瘋人。」"
  },
  {
    "surah_id": 51,
    "ayah_number": 40,
    "global_ayah_id": 4715,
    "translation": "所以我懲治他和他的軍隊，而將他們投入海中，他是受責備的。"
  },
  {
    "surah_id": 51,
    "ayah_number": 41,
    "global_ayah_id": 4716,
    "translation": "在阿德人的故事裡，也有一種跡象。當時，我曾使無益的暴風去毀滅他們，"
  },
  {
    "surah_id": 51,
    "ayah_number": 42,
    "global_ayah_id": 4717,
    "translation": "凡經那暴風吹過的東西，無一不變成破碎的。"
  },
  {
    "surah_id": 51,
    "ayah_number": 43,
    "global_ayah_id": 4718,
    "translation": "在賽莫德人的故事裡，也有一種跡象。當時，有人對他們說：「你們暫時享受吧！」"
  },
  {
    "surah_id": 51,
    "ayah_number": 44,
    "global_ayah_id": 4719,
    "translation": "他們曾違抗他們主的命令，故疾雷毀滅了他們，同時，他們眼見刑罰降臨，"
  },
  {
    "surah_id": 51,
    "ayah_number": 45,
    "global_ayah_id": 4720,
    "translation": "他們未能站起，他們也未能自衛。"
  },
  {
    "surah_id": 51,
    "ayah_number": 46,
    "global_ayah_id": 4721,
    "translation": "以前，我毀滅了努哈的宗族，他們確是悖逆的民眾。"
  },
  {
    "surah_id": 51,
    "ayah_number": 47,
    "global_ayah_id": 4722,
    "translation": "天，我曾以權力建造它，我確是大能的；"
  },
  {
    "surah_id": 51,
    "ayah_number": 48,
    "global_ayah_id": 4723,
    "translation": "地，我曾鋪張它。美哉鋪張者！"
  },
  {
    "surah_id": 51,
    "ayah_number": 49,
    "global_ayah_id": 4724,
    "translation": "我將每種物造成配偶，以便你們覺悟。"
  },
  {
    "surah_id": 51,
    "ayah_number": 50,
    "global_ayah_id": 4725,
    "translation": "你說：「你們應當逃歸真主，我對於你們確是一個坦率的警告者。"
  },
  {
    "surah_id": 51,
    "ayah_number": 51,
    "global_ayah_id": 4726,
    "translation": "你們不要以別的神靈與真主同受崇拜，我對於你們確是一個坦率的警告者。」"
  },
  {
    "surah_id": 51,
    "ayah_number": 52,
    "global_ayah_id": 4727,
    "translation": "他們以前的各民族也象這樣，每有一個使者來臨他們，他們就說：「他是一個術士，或是一個瘋人。」"
  },
  {
    "surah_id": 51,
    "ayah_number": 53,
    "global_ayah_id": 4728,
    "translation": "難道他們曾以此話互相囑咐嗎？不然，他們都是悖逆的民眾。"
  },
  {
    "surah_id": 51,
    "ayah_number": 54,
    "global_ayah_id": 4729,
    "translation": "你應當退避他們，你絕不是受責備的。"
  },
  {
    "surah_id": 51,
    "ayah_number": 55,
    "global_ayah_id": 4730,
    "translation": "你應當教誨眾人，因為教誨對於信士們確是有益的。"
  },
  {
    "surah_id": 51,
    "ayah_number": 56,
    "global_ayah_id": 4731,
    "translation": "我創造精靈和人類，只為要他們崇拜我。"
  },
  {
    "surah_id": 51,
    "ayah_number": 57,
    "global_ayah_id": 4732,
    "translation": "我不望他們的供給，我也不望他們的奉養。"
  },
  {
    "surah_id": 51,
    "ayah_number": 58,
    "global_ayah_id": 4733,
    "translation": "真主確是供給萬物的，確是有權力的，確是堅定的。"
  },
  {
    "surah_id": 51,
    "ayah_number": 59,
    "global_ayah_id": 4734,
    "translation": "不義的人們，和他們的朋友一樣，必得一份刑罰，所以叫他們不要催促我。"
  },
  {
    "surah_id": 51,
    "ayah_number": 60,
    "global_ayah_id": 4735,
    "translation": "傷哉不信道的人們！當他們被警告的日子來臨的時候。"
  }
]