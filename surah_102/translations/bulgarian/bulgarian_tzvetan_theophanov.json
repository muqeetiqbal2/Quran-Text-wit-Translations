[
  {
    "surah_id": 102,
    "ayah_number": 1,
    "global_ayah_id": 6169,
    "translation": "Увлича ви преумножаването,"
  },
  {
    "surah_id": 102,
    "ayah_number": 2,
    "global_ayah_id": 6170,
    "translation": "додето легнете в гробовете."
  },
  {
    "surah_id": 102,
    "ayah_number": 3,
    "global_ayah_id": 6171,
    "translation": "Ала не! Ще узнаете."
  },
  {
    "surah_id": 102,
    "ayah_number": 4,
    "global_ayah_id": 6172,
    "translation": "И пак не! Ще узнаете."
  },
  {
    "surah_id": 102,
    "ayah_number": 5,
    "global_ayah_id": 6173,
    "translation": "Ала не, ако знаете с достоверното знание -"
  },
  {
    "surah_id": 102,
    "ayah_number": 6,
    "global_ayah_id": 6174,
    "translation": "ще видите Ада."
  },
  {
    "surah_id": 102,
    "ayah_number": 7,
    "global_ayah_id": 6175,
    "translation": "После ще го видите с достоверен поглед."
  },
  {
    "surah_id": 102,
    "ayah_number": 8,
    "global_ayah_id": 6176,
    "translation": "После ще бъдете питани в този Ден за насладите [на земята]."
  }
]