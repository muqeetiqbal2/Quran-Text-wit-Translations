[
  {
    "surah_id": 102,
    "ayah_number": 1,
    "global_ayah_id": 6169,
    "translation": "Çokluk kuruntusu sizi o derece oyaladı ki,"
  },
  {
    "surah_id": 102,
    "ayah_number": 2,
    "global_ayah_id": 6170,
    "translation": "Nihayet kabirleri ziyaret ettiniz."
  },
  {
    "surah_id": 102,
    "ayah_number": 3,
    "global_ayah_id": 6171,
    "translation": "Hayır! Yakında bileceksiniz!"
  },
  {
    "surah_id": 102,
    "ayah_number": 4,
    "global_ayah_id": 6172,
    "translation": "Elbette yakında bileceksiniz!"
  },
  {
    "surah_id": 102,
    "ayah_number": 5,
    "global_ayah_id": 6173,
    "translation": "Gerçek öyle değil! Kesin bilgi ile bilmiş olsaydınız,"
  },
  {
    "surah_id": 102,
    "ayah_number": 6,
    "global_ayah_id": 6174,
    "translation": "Mutlaka cehennem ateşini görürdünüz."
  },
  {
    "surah_id": 102,
    "ayah_number": 7,
    "global_ayah_id": 6175,
    "translation": "Sonra ahirette onu çıplak gözle göreceksiniz."
  },
  {
    "surah_id": 102,
    "ayah_number": 8,
    "global_ayah_id": 6176,
    "translation": "Nihayet o gün (dünyada yararlandığınız) nimetlerden elbette ve elbette hesaba çekileceksiniz."
  }
]