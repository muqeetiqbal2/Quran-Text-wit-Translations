[
  {
    "surah_id": 102,
    "ayah_number": 1,
    "global_ayah_id": 6169,
    "translation": "Çokluk yarışı, sizi oyaladı,"
  },
  {
    "surah_id": 102,
    "ayah_number": 2,
    "global_ayah_id": 6170,
    "translation": "Nihayet kabirleri ziyaret ettiniz (kabre girinceye kadar mal artırmağa çalıştınız)."
  },
  {
    "surah_id": 102,
    "ayah_number": 3,
    "global_ayah_id": 6171,
    "translation": "Hayır (olmaz bu), yakında bileceksiniz (hatanızı)!"
  },
  {
    "surah_id": 102,
    "ayah_number": 4,
    "global_ayah_id": 6172,
    "translation": "Yine hayır, yakında bileceksiniz (hatanızı)!"
  },
  {
    "surah_id": 102,
    "ayah_number": 5,
    "global_ayah_id": 6173,
    "translation": "Hayır, (gerçeği) kesin bilgi ile bilseydiniz;"
  },
  {
    "surah_id": 102,
    "ayah_number": 6,
    "global_ayah_id": 6174,
    "translation": "Mutlaka cehennemi görür (oun varlığını gözle görmüş gibi kabul eder)diniz."
  },
  {
    "surah_id": 102,
    "ayah_number": 7,
    "global_ayah_id": 6175,
    "translation": "Sonra onu kesin olarak gözle göreceksiniz."
  },
  {
    "surah_id": 102,
    "ayah_number": 8,
    "global_ayah_id": 6176,
    "translation": "Sonra o gün, (size verilen) ni'metten sorulacaksınız."
  }
]