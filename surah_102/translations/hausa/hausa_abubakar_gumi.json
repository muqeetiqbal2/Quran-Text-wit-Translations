  {
    "surah_id": 102,
    "ayah_number": 1,
    "global_ayah_id": 6169,
    "translation": "Alfahari da yawan dũkiya da dangi ya shagaltar da ku (dagaibada mai amfaninku)."
  },
  {
    "surah_id": 102,
    "ayah_number": 2,
    "global_ayah_id": 6170,
    "translation": "Har kuka ziyarci kaburbura."
  },
  {
    "surah_id": 102,
    "ayah_number": 3,
    "global_ayah_id": 6171,
    "translation": "A'aha! (Nan gaba) zã ku sani."
  },
  {
    "surah_id": 102,
    "ayah_number": 4,
    "global_ayah_id": 6172,
    "translation": "Sa'an nan, tabbas, zã ku sani."
  },
  {
    "surah_id": 102,
    "ayah_number": 5,
    "global_ayah_id": 6173,
    "translation": "Haƙĩƙa, da kuna da sani sani na yaƙĩni."
  },
  {
    "surah_id": 102,
    "ayah_number": 6,
    "global_ayah_id": 6174,
    "translation": "Lalle ne da kuna ganin Jahĩm."
  },
  {
    "surah_id": 102,
    "ayah_number": 7,
    "global_ayah_id": 6175,
    "translation": "Sa'an nan lalle ne za ku gan ta, da idanu, bayyane."
  },
  {
    "surah_id": 102,
    "ayah_number": 8,
    "global_ayah_id": 6176,
    "translation": "Sa'an nan lalle ne za a tambaye ku, a rãnar nan lãbãrin ni'imar (da aka yi muku)."
  }
]