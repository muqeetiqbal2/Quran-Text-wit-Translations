  },
  {
    "surah_id": 102,
    "ayah_number": 8,
    "global_ayah_id": 6277,
    "translation": "अनि त्यस दिन तिमीहरूलाई प्राप्त सुख–सामग्रीबारे अवश्य सोधिनेछ ।"
  }
