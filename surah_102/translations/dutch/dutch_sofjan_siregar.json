    "ayah_number": 1,
    "global_ayah_id": 6169,
    "translation": "Jullie gaan op in de wedijver om meer."
  },
  {
    "surah_id": 102,
    "ayah_number": 2,
    "global_ayah_id": 6170,
    "translation": "Totdat jullie in de graven terechtkomen."
  },
  {
    "surah_id": 102,
    "ayah_number": 3,
    "global_ayah_id": 6171,
    "translation": "Nee, jullie zullen het weten."
  },
  {
    "surah_id": 102,
    "ayah_number": 4,
    "global_ayah_id": 6172,
    "translation": "Nogmaals, nee! Jullie zullen het weten."
  },
  {
    "surah_id": 102,
    "ayah_number": 5,
    "global_ayah_id": 6173,
    "translation": "Nee! Als jullie het maar met zekere kennis zouden weten!"
  },
  {
    "surah_id": 102,
    "ayah_number": 6,
    "global_ayah_id": 6174,
    "translation": "Jullie zullen zeker de Hel zien."
  },
  {
    "surah_id": 102,
    "ayah_number": 7,
    "global_ayah_id": 6175,
    "translation": "Nogmaals, jullie zullen haar met een zeker oog zien."
  },
  {
    "surah_id": 102,
    "ayah_number": 8,
    "global_ayah_id": 6176,
    "translation": "Dan zullen jullie op die Dag ondervraagd worden over de genietingen."
  }
