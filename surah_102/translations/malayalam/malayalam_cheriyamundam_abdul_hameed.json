[
  {
    "surah_id": 102,
    "ayah_number": 1,
    "global_ayah_id": 6169,
    "translation": "പരസ്പരം പെരുമനടിക്കുക എന്ന കാര്യം നിങ്ങളെ അശ്രദ്ധയിലാക്കിയിരിക്കുന്നു."
  },
  {
    "surah_id": 102,
    "ayah_number": 2,
    "global_ayah_id": 6170,
    "translation": "നിങ്ങള്‍ ശവകുടീരങ്ങള്‍ സന്ദര്‍ശിക്കുന്നത് വരേക്കും."
  },
  {
    "surah_id": 102,
    "ayah_number": 3,
    "global_ayah_id": 6171,
    "translation": "നിസ്സംശയം, നിങ്ങള്‍ വഴിയെ അറിഞ്ഞ് കൊള്ളും."
  },
  {
    "surah_id": 102,
    "ayah_number": 4,
    "global_ayah_id": 6172,
    "translation": "പിന്നെയും നിസ്സംശയം നിങ്ങള്‍ വഴിയെ അറിഞ്ഞ് കൊള്ളും."
  },
  {
    "surah_id": 102,
    "ayah_number": 5,
    "global_ayah_id": 6173,
    "translation": "നിസ്സംശയം, നിങ്ങള്‍ ദൃഢമായ അറിവ് അറിയുമായിരുന്നെങ്കില്‍"
  },
  {
    "surah_id": 102,
    "ayah_number": 6,
    "global_ayah_id": 6174,
    "translation": "ജ്വലിക്കുന്ന നരകത്തെ നിങ്ങള്‍ കാണുക തന്നെ ചെയ്യും."
  },
  {
    "surah_id": 102,
    "ayah_number": 7,
    "global_ayah_id": 6175,
    "translation": "പിന്നെ തീര്‍ച്ചയായും നിങ്ങള്‍ അതിനെ ദൃഢമായും കണ്ണാല്‍ കാണുക തന്നെ ചെയ്യും."
  },
  {
    "surah_id": 102,
    "ayah_number": 8,
    "global_ayah_id": 6176,
    "translation": "പിന്നീട് ആ ദിവസത്തില്‍ സുഖാനുഭവങ്ങളെ പറ്റി തീര്‍ച്ചയായും നിങ്ങള്‍ ചോദ്യം ചെയ്യപ്പെടുകതന്നെ ചെയ്യും."
  }
]