    "global_ayah_id": 6169,
    "translation": "تفاخر به بيشترداشتن، شما را غافل داشت."
  },
  {
    "surah_id": 102,
    "ayah_number": 2,
    "global_ayah_id": 6170,
    "translation": "تا كارتان [و پايتان‌] به گورستان رسيد."
  },
  {
    "surah_id": 102,
    "ayah_number": 3,
    "global_ayah_id": 6171,
    "translation": "نه چنين است، زودا كه بدانيد."
  },
  {
    "surah_id": 102,
    "ayah_number": 4,
    "global_ayah_id": 6172,
    "translation": "باز هم نه چنين است، زودا كه بدانيد."
  },
  {
    "surah_id": 102,
    "ayah_number": 5,
    "global_ayah_id": 6173,
    "translation": "هرگز چنين نيست، اگر علم‌اليقين داشتيد!"
  },
  {
