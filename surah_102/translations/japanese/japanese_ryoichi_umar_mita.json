[
  {
    "surah_id": 102,
    "ayah_number": 1,
    "global_ayah_id": 6169,
    "translation": "あなたがたは（財産や息子などの）多いことを張り合って，現を抜かす。"
  },
  {
    "surah_id": 102,
    "ayah_number": 2,
    "global_ayah_id": 6170,
    "translation": "墓に追い立てられるまでも。"
  },
  {
    "surah_id": 102,
    "ayah_number": 3,
    "global_ayah_id": 6171,
    "translation": "いや，やがて（死後）あなたがたは（その真実を）知ろう。"
  },
  {
    "surah_id": 102,
    "ayah_number": 4,
    "global_ayah_id": 6172,
    "translation": "もう一度言おうか，いや，やがてあなたがたは知ろう。"
  },
  {
    "surah_id": 102,
    "ayah_number": 5,
    "global_ayah_id": 6173,
    "translation": "いや，あなたがたは（今に）はっきり知るとよいのである。"
  },
  {
    "surah_id": 102,
    "ayah_number": 6,
    "global_ayah_id": 6174,
    "translation": "あなたがたは必ず獄火を見よう。"
  },
  {
    "surah_id": 102,
    "ayah_number": 7,
    "global_ayah_id": 6175,
    "translation": "その時あなたがたはそれを明確に目で見ることであろう。"
  },
  {
    "surah_id": 102,
    "ayah_number": 8,
    "global_ayah_id": 6176,
    "translation": "その日あなたがたは，（現を抜かしていた）享楽に就いて，必ず問われるであろう。"
  }
]