[
  {
    "surah_id": 102,
    "ayah_number": 1,
    "global_ayah_id": 6169,
    "translation": "Ба ғафлат кашид шуморо фахр кардан ба бисёрии молу фарзанд,"
  },
  {
    "surah_id": 102,
    "ayah_number": 2,
    "global_ayah_id": 6170,
    "translation": "то ба гӯрҳо расидед."
  },
  {
    "surah_id": 102,
    "ayah_number": 3,
    "global_ayah_id": 6171,
    "translation": "Ҳаққо, ки ба зудӣ хоҳед донист."
  },
  {
    "surah_id": 102,
    "ayah_number": 4,
    "global_ayah_id": 6172,
    "translation": "Боз ҳам ҳаққо, ки ба зудӣ хоҳед донист."
  },
  {
    "surah_id": 102,
    "ayah_number": 5,
    "global_ayah_id": 6173,
    "translation": "Ҳаққо агар аз рӯи яқин бидонед,"
  },
  {
    "surah_id": 102,
    "ayah_number": 6,
    "global_ayah_id": 6174,
    "translation": "албатта, ҷаҳаннамро хоҳед дид."
  },
  {
    "surah_id": 102,
    "ayah_number": 7,
    "global_ayah_id": 6175,
    "translation": "Сипас ба чашми яқинаш хоҳед дид,"
  },
  {
    "surah_id": 102,
    "ayah_number": 8,
    "global_ayah_id": 6176,
    "translation": "сипас дар он рӯз шуморо аз неъматҳои дунявӣ бозхост мекунанд."
  }
]