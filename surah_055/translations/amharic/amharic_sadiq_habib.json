[
  {
    "surah_id": 55,
    "ayah_number": 1,
    "global_ayah_id": 4902,
    "translation": "አል-ረሕማን፤"
  },
  {
    "surah_id": 55,
    "ayah_number": 2,
    "global_ayah_id": 4903,
    "translation": "ቁርኣንን አስተማረ፡፡"
  },
  {
    "surah_id": 55,
    "ayah_number": 3,
    "global_ayah_id": 4904,
    "translation": "ሰውን ፈጠረ፡፡"
  },
  {
    "surah_id": 55,
    "ayah_number": 4,
    "global_ayah_id": 4905,
    "translation": "መናገርን አስተማረው፡፡"
  },
  {
    "surah_id": 55,
    "ayah_number": 5,
    "global_ayah_id": 4906,
    "translation": "ፀሐይና ጨረቃ በተወሰነ ልክ (ይኼዳሉ)፡፡"
  },
  {
    "surah_id": 55,
    "ayah_number": 6,
    "global_ayah_id": 4907,
    "translation": "ሐረግና ዛፍም (ለእርሱ) ይሰግዳሉ፡፡"
  },
  {
    "surah_id": 55,
    "ayah_number": 7,
    "global_ayah_id": 4908,
    "translation": "ሰማይንም አጓናት፡፡ ትክክለኛነትንም ደነገገ፡፡"
  },
  {
    "surah_id": 55,
    "ayah_number": 8,
    "global_ayah_id": 4909,
    "translation": "በሚዛን (ስትመዝኑ) እንዳትበድሉ፡፡"
  },
  {
    "surah_id": 55,
    "ayah_number": 9,
    "global_ayah_id": 4910,
    "translation": "መመዘንንም በትክክል መዝኑ፡፡ ተመዛኙንም አታጉድሉ፡፡"
  },
  {
    "surah_id": 55,
    "ayah_number": 10,
    "global_ayah_id": 4911,
    "translation": "ምድርንም ለፍጡሩ አደላደላት፡፡"
  },
  {
    "surah_id": 55,
    "ayah_number": 11,
    "global_ayah_id": 4912,
    "translation": "በውስጧ እሸት ባለ ሺፋኖች የኾኑ ዘንባባዎችም ያሉባት ስትኾን፡፡"
  },
  {
    "surah_id": 55,
    "ayah_number": 12,
    "global_ayah_id": 4913,
    "translation": "የገለባ ባለቤት የኾነ ቅንጣትም፡፡ ባለ መልካም መዐዛ ቅጠሎችም (ያሉባት ስትኾን)፡፡"
  },
  {
    "surah_id": 55,
    "ayah_number": 13,
    "global_ayah_id": 4914,
    "translation": "(ሰዎችና ጋኔኖች ሆይ!) ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"
  },
  {
    "surah_id": 55,
    "ayah_number": 14,
    "global_ayah_id": 4915,
    "translation": "ሰውን እንደ ሸክላ ከሚቅጨለጨል ደረቅ ጭቃ ፈጠረው፡፡"
  },
  {
    "surah_id": 55,
    "ayah_number": 15,
    "global_ayah_id": 4916,
    "translation": "ጃንንም ከእሳት ከኾነ ነበልባል ፈጠረው፡፡"
  },
  {
    "surah_id": 55,
    "ayah_number": 16,
    "global_ayah_id": 4917,
    "translation": "ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"
  },
  {
    "surah_id": 55,
    "ayah_number": 17,
    "global_ayah_id": 4918,
    "translation": "የሁለቱ ምሥራቆች ጌታ፤ የሁለቱ ምዕራቦችም ጌታ ነው፡፡"
  },
  {
    "surah_id": 55,
    "ayah_number": 18,
    "global_ayah_id": 4919,
    "translation": "ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"
  },
  {
    "surah_id": 55,
    "ayah_number": 19,
    "global_ayah_id": 4920,
    "translation": "ሁለቱን ባሕሮች የሚገናኙ ሲኾኑ ለቀቃቸው፡፡"
  },
  {
    "surah_id": 55,
    "ayah_number": 20,
    "global_ayah_id": 4921,
    "translation": "(እንዳይዋሐዱ) በመካከላቸው ጋራጅ አልለ፡፡ (አንዱ ባንዱ ላይ) ወሰን አያልፉም፡፡"
  },
  {
    "surah_id": 55,
    "ayah_number": 21,
    "global_ayah_id": 4922,
    "translation": "ከጌታችሁም ጸጋዎች በየትኛው ታሰተባብላላችሁ?›"
  },
  {
    "surah_id": 55,
    "ayah_number": 22,
    "global_ayah_id": 4923,
    "translation": "ሉልና መርጃን ከሁለቱ ይወጣል፡፡"
  },
  {
    "surah_id": 55,
    "ayah_number": 23,
    "global_ayah_id": 4924,
    "translation": "ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"
  },
  {
    "surah_id": 55,
    "ayah_number": 24,
    "global_ayah_id": 4925,
    "translation": "እንደ ጋራዎች ኾነው በባሕር ውስጥ የተሠሩት ተንሻለዮቹም (ታንኳዎች) የእርሱ ናቸው፡፡"
  },
  {
    "surah_id": 55,
    "ayah_number": 25,
    "global_ayah_id": 4926,
    "translation": "ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"
  },
  {
    "surah_id": 55,
    "ayah_number": 26,
    "global_ayah_id": 4927,
    "translation": "በእርሷ (በምድር) ላይ ያለው ሁሉ ጠፊ ነው፡፡"
  },
  {
    "surah_id": 55,
    "ayah_number": 27,
    "global_ayah_id": 4928,
    "translation": "የልቅናና የልግሥና ባለቤት የኾነው የጌታህ ፊትም ይቀራል፡፡ (አይጠፋም)፡፡"
  },
  {
    "surah_id": 55,
    "ayah_number": 28,
    "global_ayah_id": 4929,
    "translation": "ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"
  },
  {
    "surah_id": 55,
    "ayah_number": 29,
    "global_ayah_id": 4930,
    "translation": "በሰማያትና በምድር ውስጥ ያሉት ሁሉ ይለምኑታል፡፡ በየቀኑ ሁሉ እርሱ በሥራ ላይ ነው፡፡"
  },
  {
    "surah_id": 55,
    "ayah_number": 30,
    "global_ayah_id": 4931,
    "translation": "ከጌታችሁም ጸጋዎች በየትኛው ታሰተባብላላችሁ?›"
  },
  {
    "surah_id": 55,
    "ayah_number": 31,
    "global_ayah_id": 4932,
    "translation": "እናንተ ሁለት ከባዶች (ሰዎችና ጋኔኖች) ሆይ! ለእናንተ (መቆጣጠር) በእርግጥ እናስባለን፡፡"
  },
  {
    "surah_id": 55,
    "ayah_number": 32,
    "global_ayah_id": 4933,
    "translation": "ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"
  },
  {
    "surah_id": 55,
    "ayah_number": 33,
    "global_ayah_id": 4934,
    "translation": "የጋኔንና የሰው ጭፍሮች ሆይ! ከሰማያትና ከምድር ቀበሌዎች መውጣትን ብትችሉ ውጡ፡፡ በስልጣን እንጅ አትወጡም፡፡ (ግን ስልጣን የላችሁም)"
  },
  {
    "surah_id": 55,
    "ayah_number": 34,
    "global_ayah_id": 4935,
    "translation": "ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"
  },
  {
    "surah_id": 55,
    "ayah_number": 35,
    "global_ayah_id": 4936,
    "translation": "በሁለታችሁም ላይ ከእሳት ነበልባል፣ ጭስም ይላክባችኋል፡፡ (ሁለታችሁም) አትርረዱምም፡፡"
  },
  {
    "surah_id": 55,
    "ayah_number": 36,
    "global_ayah_id": 4937,
    "translation": "ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"
  },
  {
    "surah_id": 55,
    "ayah_number": 37,
    "global_ayah_id": 4938,
    "translation": "ሰማይም በተሰነጠቀችና እንደ ጽጌረዳ፣ እንደታረበ ቆዳ በኾነች ጊዜ፤ (ጭንቁን ምን አበረታው)፡፡"
  },
  {
    "surah_id": 55,
    "ayah_number": 38,
    "global_ayah_id": 4939,
    "translation": "ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"
  },
  {
    "surah_id": 55,
    "ayah_number": 39,
    "global_ayah_id": 4940,
    "translation": "በዚያም ቀን ሰውም ጃንም ከኃጢኣቱ ገና አይጠየቅም፡፡"
  },
  {
    "surah_id": 55,
    "ayah_number": 40,
    "global_ayah_id": 4941,
    "translation": "ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"
  },
  {
    "surah_id": 55,
    "ayah_number": 41,
    "global_ayah_id": 4942,
    "translation": "ከሓዲዎች በምልክታቸው ይታወቃሉ፡፡ አናቶቻቸውንና ጫማዎቻቸውንም ይያዛሉ፡፡"
  },
  {
    "surah_id": 55,
    "ayah_number": 42,
    "global_ayah_id": 4943,
    "translation": "ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ፡፡"
  },
  {
    "surah_id": 55,
    "ayah_number": 43,
    "global_ayah_id": 4944,
    "translation": "ይህቺ ያቺ አመጸኞች በእርሷ ያስተባብሉባት የነበረችው ገሀነም ናት (ይባላሉ)፡፡"
  },
  {
    "surah_id": 55,
    "ayah_number": 44,
    "global_ayah_id": 4945,
    "translation": "በእርሷና በጣም ሞቃት በኾነ ፍል ውሃ መካከል ይመላለሳሉ፡፡"
  },
  {
    "surah_id": 55,
    "ayah_number": 45,
    "global_ayah_id": 4946,
    "translation": "ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"
  },
  {
    "surah_id": 55,
    "ayah_number": 46,
    "global_ayah_id": 4947,
    "translation": "በጌታውም ፊት መቆምን ለፈራ ሰው ሁለት ገነቶች አልሉት፡፡"
  },
  {
    "surah_id": 55,
    "ayah_number": 47,
    "global_ayah_id": 4948,
    "translation": "ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"
  },
  {
    "surah_id": 55,
    "ayah_number": 48,
    "global_ayah_id": 4949,
    "translation": "የቀንዘሎች ባለ ቤቶች የኾኑ (ገነቶች አልሉት)፡፡"
  },
  {
    "surah_id": 55,
    "ayah_number": 49,
    "global_ayah_id": 4950,
    "translation": "ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"
  },
  {
    "surah_id": 55,
    "ayah_number": 50,
    "global_ayah_id": 4951,
    "translation": "በሁለቱ ውስጥ የሚፈስሱ ሁለት ምንጮች አልሉ፡፡"
  },
  {
    "surah_id": 55,
    "ayah_number": 51,
    "global_ayah_id": 4952,
    "translation": "ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"
  },
  {
    "surah_id": 55,
    "ayah_number": 52,
    "global_ayah_id": 4953,
    "translation": "በሁለቱ ውስጥ ከፍራፍሬዎች ሁሉ ሁለት ዓይነቶች (እርጥብና ደረቅ) አልሉ፡፡"
  },
  {
    "surah_id": 55,
    "ayah_number": 53,
    "global_ayah_id": 4954,
    "translation": "ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"
  },
  {
    "surah_id": 55,
    "ayah_number": 54,
    "global_ayah_id": 4955,
    "translation": "የውስጥ ጉስጉሳቸው ከወፍራም ሐር በኾኑ ምንጣፎች ላይ የተመቻቹ ሲኾኑ (ይንፈላሰሳሉ)፡፡ የሁለቱም ገነቶች ፍሬ (ለለቃሚ) ቅርብ ነው፡፡"
  },
  {
    "surah_id": 55,
    "ayah_number": 55,
    "global_ayah_id": 4956,
    "translation": "ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"
  },
  {
    "surah_id": 55,
    "ayah_number": 56,
    "global_ayah_id": 4957,
    "translation": "በውስጣቸው ከበፊታቸው (ከባሎቻቸው በፊት) ሰውም ጃንም ያልገሰሳቸው ዓይኖቻቸውን (በባሎቻቸው ላይ) አሳጣሪዎች (ሴቶች) አልሉ፡፡"
  },
  {
    "surah_id": 55,
