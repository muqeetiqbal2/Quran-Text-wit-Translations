[
  {
    "surah_id": 55,
    "ayah_number": 1,
    "global_ayah_id": 4902,
    "translation": "Çok merhametli (Allah),"
  },
  {
    "surah_id": 55,
    "ayah_number": 2,
    "global_ayah_id": 4903,
    "translation": "Kur'an'ı öğretti."
  },
  {
    "surah_id": 55,
    "ayah_number": 3,
    "global_ayah_id": 4904,
    "translation": "İnsanı yarattı."
  },
  {
    "surah_id": 55,
    "ayah_number": 4,
    "global_ayah_id": 4905,
    "translation": "Ona beyanı (konuşup, düşüncelerini açıklamayı) öğretti."
  },
  {
    "surah_id": 55,
    "ayah_number": 5,
    "global_ayah_id": 4906,
    "translation": "Güneş de, Ay da bir hesap ile(cereyan etmekte)dir."
  },
  {
    "surah_id": 55,
    "ayah_number": 6,
    "global_ayah_id": 4907,
    "translation": "Necm (bitkiler, yıldızlar) ve ağaçlar (Allah'a) secde etmektedirler."
  },
  {
    "surah_id": 55,
    "ayah_number": 7,
    "global_ayah_id": 4908,
    "translation": "Göğü yükseltti ve mizanı koydu."
  },
  {
    "surah_id": 55,
    "ayah_number": 8,
    "global_ayah_id": 4909,
    "translation": "Tartıda taşkınlık edip dengeyi bozmayın."
  },
  {
    "surah_id": 55,
    "ayah_number": 9,
    "global_ayah_id": 4910,
    "translation": "Tartıyı adaletle yapın, terazide eksiklik yapmayın."
  },
  {
    "surah_id": 55,
    "ayah_number": 10,
    "global_ayah_id": 4911,
    "translation": "(Allah) Yeri halk için koydu."
  },
  {
    "surah_id": 55,
    "ayah_number": 11,
    "global_ayah_id": 4912,
    "translation": "Onda meyva(lar) ve salkımlı hurmalar var."
  },
  {
    "surah_id": 55,
    "ayah_number": 12,
    "global_ayah_id": 4913,
    "translation": "Saplı ve yapraklı dane(ler) ve hoş kokulu bitkiler var."
  },
  {
    "surah_id": 55,
    "ayah_number": 13,
    "global_ayah_id": 4914,
    "translation": "(Ey cinler ve insanlar topluluğu) Şimdi Rabbinizin hangi ni'metlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 14,
    "global_ayah_id": 4915,
    "translation": "İnsanı kiremit gibi pişmiş çamurdan yarattı."
  },
  {
    "surah_id": 55,
    "ayah_number": 15,
    "global_ayah_id": 4916,
    "translation": "Cin'i de halis ateşten yarattı."
  },
  {
    "surah_id": 55,
    "ayah_number": 16,
    "global_ayah_id": 4917,
    "translation": "Şimdi Rabbinizin hangi ni'metlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 17,
    "global_ayah_id": 4918,
    "translation": "İki doğunun ve iki batının Rabbidir."
  },
  {
    "surah_id": 55,
    "ayah_number": 18,
    "global_ayah_id": 4919,
    "translation": "Şimdi Rabbinizin hangi ni'metlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 19,
    "global_ayah_id": 4920,
    "translation": "İki denizi salıverdi, birbirine kavuşuyorlar,"
  },
  {
    "surah_id": 55,
    "ayah_number": 20,
    "global_ayah_id": 4921,
    "translation": "Aralarında bir engel vardır, birbirine geçip karışmıyorlar."
  },
  {
    "surah_id": 55,
    "ayah_number": 21,
    "global_ayah_id": 4922,
    "translation": "Şimdi Rabbinizin hangi ni'metlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 22,
    "global_ayah_id": 4923,
    "translation": "İkisinden de inci ve mercan çıkar."
  },
  {
    "surah_id": 55,
    "ayah_number": 23,
    "global_ayah_id": 4924,
    "translation": "Şimdi Rabbinizin hangi ni'metlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 24,
    "global_ayah_id": 4925,
    "translation": "Denizde koca dağlar gibi akıp giden kocaman gemiler de O'nundur."
  },
  {
    "surah_id": 55,
    "ayah_number": 25,
    "global_ayah_id": 4926,
    "translation": "Şimdi Rabbinizin hangi ni'metlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 26,
    "global_ayah_id": 4927,
    "translation": "(Yer) Üzerinde bulunan her şey yok olacaktır."
  },
  {
    "surah_id": 55,
    "ayah_number": 27,
    "global_ayah_id": 4928,
    "translation": "Yalnız Rabbinin celal ve ikram sahibi yüzü baki kalacaktır."
  },
  {
    "surah_id": 55,
    "ayah_number": 28,
    "global_ayah_id": 4929,
    "translation": "Şimdi Rabbinizin hangi ni'metlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 29,
    "global_ayah_id": 4930,
    "translation": "Göklerde ve yerde bulunanlar (her şeyi) O'ndan isterler. O, her gün (her an) yeni bir iştedir."
  },
  {
    "surah_id": 55,
    "ayah_number": 30,
    "global_ayah_id": 4931,
    "translation": "Şimdi Rabbinizin hangi ni'metlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 31,
    "global_ayah_id": 4932,
    "translation": "Ey iki sekal, sizin için de boş vaktimiz olacak (sizin de hesabınızı göreceğiz)."
  },
  {
    "surah_id": 55,
    "ayah_number": 32,
    "global_ayah_id": 4933,
    "translation": "Şimdi Rabbinizin hangi ni'metlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 33,
    "global_ayah_id": 4934,
    "translation": "Ey cinler ve insanlar topluluğu, göklerin ve yerin bucaklarından geçip gitmeğe gücünüz yeterse geçin gidin. Ancak kudretle geçebilirsiniz."
  },
  {
    "surah_id": 55,
    "ayah_number": 34,
    "global_ayah_id": 4935,
    "translation": "Şimdi Rabbinizin hangi ni'metlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 35,
    "global_ayah_id": 4936,
    "translation": "İkinizin de üzerine, ateşten yalın alev ve kıpkızıl bir duman (yahut erimiş bakır) gönderilir, başaramazsınız."
  },
  {
    "surah_id": 55,
    "ayah_number": 36,
    "global_ayah_id": 4937,
    "translation": "Şimdi Rabbinizin hangi ni'metlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 37,
    "global_ayah_id": 4938,
    "translation": "Gök yarılıp da erimiş yağ gibi kıpkırmızı bir gül olduğu zaman..."
  },
  {
    "surah_id": 55,
    "ayah_number": 38,
    "global_ayah_id": 4939,
    "translation": "Şimdi Rabbinizin hangi ni'metlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 39,
    "global_ayah_id": 4940,
    "translation": "O gün ne insana, ne de cin'e günahından sorulur."
  },
  {
    "surah_id": 55,
    "ayah_number": 40,
    "global_ayah_id": 4941,
    "translation": "Şimdi Rabbinizin hangi ni'metlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 41,
    "global_ayah_id": 4942,
    "translation": "Suçlular, simalarından tanınır, alınlar(ın)dan ve ayaklar(ın)dan tutulur."
  },
  {
    "surah_id": 55,
    "ayah_number": 42,
    "global_ayah_id": 4943,
    "translation": "Şimdi Rabbinizin hangi ni'metlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 43,
    "global_ayah_id": 4944,
    "translation": "İşte bu, suçluların yalanladığı cehennemdir!"
  },
  {
    "surah_id": 55,
    "ayah_number": 44,
    "global_ayah_id": 4945,
    "translation": "Onunla kaynar su arasında dolaşırlar."
  },
  {
    "surah_id": 55,
    "ayah_number": 45,
    "global_ayah_id": 4946,
    "translation": "Şimdi Rabbinizin hangi ni'metlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 46,
    "global_ayah_id": 4947,
    "translation": "Rabbinin divanında dur(up hesap ver)mekten korkan kimseye iki cennet var."
  },
  {
    "surah_id": 55,
    "ayah_number": 47,
    "global_ayah_id": 4948,
    "translation": "Şimdi Rabbinizin hangi ni'metlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 48,
    "global_ayah_id": 4949,
    "translation": "İkisinin de çeşitli ağaçları, meyvaları var."
  },
  {
    "surah_id": 55,
    "ayah_number": 49,
    "global_ayah_id": 4950,
    "translation": "Şimdi Rabbinizin hangi ni'metlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 50,
    "global_ayah_id": 4951,
    "translation": "İkisinde de akıp giden iki kaynak var."
  },
  {
    "surah_id": 55,
    "ayah_number": 51,
    "global_ayah_id": 4952,
    "translation": "Şimdi Rabbinizin hangi ni'metlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 52,
    "global_ayah_id": 4953,
    "translation": "İkisinde de her meyvadan iki çift var."
  },
  {
    "surah_id": 55,
    "ayah_number": 53,
    "global_ayah_id": 4954,
    "translation": "Şimdi Rabbinizin hangi ni'metlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 54,
    "global_ayah_id": 4955,
    "translation": "(Orada) Astarları kalın atlastan yataklara yaslanırlar. İki cennetin de devşirmesi yakındır."
  },
  {
    "surah_id": 55,
    "ayah_number": 55,
    "global_ayah_id": 4956,
    "translation": "Şimdi Rabbinizin hangi ni'metlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 56,
    "global_ayah_id": 4957,
    "translation": "Onlarda bakışları kısa (yalnız kocalarına bakan) öyle dilberler de var ki, bunlardan önce onları ne insan, ne de cin kanatmamıştır."
  },
  {
    "surah_id": 55,
    "ayah_number": 57,
    "global_ayah_id": 4958,
    "translation": "Şimdi Rabbinizin hangi ni'metlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 58,
    "global_ayah_id": 4959,
    "translation": "Sanki onlar yakut ve mercandırlar."
  },
  {
    "surah_id": 55,
    "ayah_number": 59,
    "global_ayah_id": 4960,
    "translation": "Şimdi Rabbinizin hangi ni'metlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 60,
    "global_ayah_id": 4961,
    "translation": "İyiliğin karşılığı, yalnız iyilik değil midir?"
  },
  {
    "surah_id": 55,
    "ayah_number": 61,
    "global_ayah_id": 4962,
    "translation": "Şimdi Rabbinizin hangi ni'metlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 62,
    "global_ayah_id": 4963,
    "translation": "Bu ikisinin ötesinde iki cennet daha var."
  },
  {
    "surah_id": 55,
    "ayah_number": 63,
    "global_ayah_id": 4964,
    "translation": "Şimdi Rabbinizin hangi ni'metlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 64,
    "global_ayah_id": 4965,
    "translation": "Yemyeşildirler."
  },
  {
    "surah_id": 55,
    "ayah_number": 65,
    "global_ayah_id": 4966,
    "translation": "Şimdi Rabbinizin hangi ni'metlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 66,
    "global_ayah_id": 4967,
    "translation": "İkisinde de fışkıran iki kaynak var."
  },
  {
    "surah_id": 55,
    "ayah_number": 67,
    "global_ayah_id": 4968,
    "translation": "Şimdi Rabbinizin hangi ni'metlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 68,
    "global_ayah_id": 4969,
    "translation": "İkisinde de meyva, hurma ve nar var."
  },
  {
    "surah_id": 55,
    "ayah_number": 69,
    "global_ayah_id": 4970,
    "translation": "Şimdi Rabbinizin hangi ni'metlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 70,
    "global_ayah_id": 4971,
    "translation": "Onlarda da iyi huylu, güzel kadınlar var."
  },
  {
    "surah_id": 55,
    "ayah_number": 71,
    "global_ayah_id": 4972,
    "translation": "Şimdi Rabbinizin hangi ni'metlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 72,
    "global_ayah_id": 4973,
    "translation": "Çadırlara kapanmış huriler."
  },
  {
    "surah_id": 55,
    "ayah_number": 73,
    "global_ayah_id": 4974,
    "translation": "Şimdi Rabbinizin hangi ni'metlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 74,
    "global_ayah_id": 4975,
    "translation": "Bunlardan önce onları ne insan, ne de cin kanatmamıştır."
  },
  {
    "surah_id": 55,
    "ayah_number": 75,
    "global_ayah_id": 4976,
    "translation": "Şimdi Rabbinizin hangi ni'metlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 76,
    "global_ayah_id": 4977,
    "translation": "(Cennettekiler) Yeşil yastıklara ve harikulade güzel işlemeli döşeklere yaslanırlar."
  },
  {
    "surah_id": 55,
    "ayah_number": 77,
    "global_ayah_id": 4978,
    "translation": "Şimdi Rabbinizin hangi ni'metlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 78,
    "global_ayah_id": 4979,
    "translation": "Büyüklük ve ikram sahibi Rabbinin adı ne yücedir!"
  }
]