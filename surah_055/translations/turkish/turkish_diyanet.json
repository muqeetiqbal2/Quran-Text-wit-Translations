[
  {
    "surah_id": 55,
    "ayah_number": 1,
    "global_ayah_id": 4902,
    "translation": "Rahman olan Allah Kuran'ı öğretti;"
  },
  {
    "surah_id": 55,
    "ayah_number": 2,
    "global_ayah_id": 4903,
    "translation": "Rahman olan Allah Kuran'ı öğretti;"
  },
  {
    "surah_id": 55,
    "ayah_number": 3,
    "global_ayah_id": 4904,
    "translation": "İnsanı yarattı, ona konuşmayı öğretti."
  },
  {
    "surah_id": 55,
    "ayah_number": 4,
    "global_ayah_id": 4905,
    "translation": "İnsanı yarattı, ona konuşmayı öğretti."
  },
  {
    "surah_id": 55,
    "ayah_number": 5,
    "global_ayah_id": 4906,
    "translation": "Güneş ve ayın hareketleri bir hesaba göredir."
  },
  {
    "surah_id": 55,
    "ayah_number": 6,
    "global_ayah_id": 4907,
    "translation": "Bitkiler ve ağaçlar O'nun buyruğuna boyun eğerler."
  },
  {
    "surah_id": 55,
    "ayah_number": 7,
    "global_ayah_id": 4908,
    "translation": "O, göğü yükseltmiştir; tartıyı koymuştur."
  },
  {
    "surah_id": 55,
    "ayah_number": 8,
    "global_ayah_id": 4909,
    "translation": "Artık tartıda tecavüz etmeyin."
  },
  {
    "surah_id": 55,
    "ayah_number": 9,
    "global_ayah_id": 4910,
    "translation": "Tartmayı doğru yapın, tartıyı eksik tutmayın."
  },
  {
    "surah_id": 55,
    "ayah_number": 10,
    "global_ayah_id": 4911,
    "translation": "Allah, yeri yaratıkları için meydana getirmiştir."
  },
  {
    "surah_id": 55,
    "ayah_number": 11,
    "global_ayah_id": 4912,
    "translation": "Orada meyveler, salkımlı hurma ağaçları, kabuklu taneler, güzel kokulu otlar vardır."
  },
  {
    "surah_id": 55,
    "ayah_number": 12,
    "global_ayah_id": 4913,
    "translation": "Orada meyveler, salkımlı hurma ağaçları, kabuklu taneler, güzel kokulu otlar vardır."
  },
  {
    "surah_id": 55,
    "ayah_number": 13,
    "global_ayah_id": 4914,
    "translation": "Ey insanlar ve cinler! Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?"
  },
  {
    "surah_id": 55,
    "ayah_number": 14,
    "global_ayah_id": 4915,
    "translation": "O, insanı pişmiş çamur gibi kuru balçıktan yaratmıştır."
  },
  {
    "surah_id": 55,
    "ayah_number": 15,
    "global_ayah_id": 4916,
    "translation": "Cinleri de yalın bir alevden yaratmıştır."
  },
  {
    "surah_id": 55,
    "ayah_number": 16,
    "global_ayah_id": 4917,
    "translation": "Öyleyken; Rabbinizin nimetlerinden hangisini yalanlarsınız?"
  },
  {
    "surah_id": 55,
    "ayah_number": 17,
    "global_ayah_id": 4918,
    "translation": "O, iki doğunun Rabbidir, iki batının Rabbidir."
  },
  {
    "surah_id": 55,
    "ayah_number": 18,
    "global_ayah_id": 4919,
    "translation": "Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?"
  },
  {
    "surah_id": 55,
    "ayah_number": 19,
    "global_ayah_id": 4920,
    "translation": "Acı ve tatlı sulu iki denizi birbirine kavuşmamak üzere salıvermiştir."
  },
  {
    "surah_id": 55,
    "ayah_number": 20,
    "global_ayah_id": 4921,
    "translation": "Aralarında bir engel vardır; birbirinin sınırını aşamazlar."
  },
  {
    "surah_id": 55,
    "ayah_number": 21,
    "global_ayah_id": 4922,
    "translation": "Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?"
  },
  {
    "surah_id": 55,
    "ayah_number": 22,
    "global_ayah_id": 4923,
    "translation": "Bu iki denizden de inci ve mercan çıkar."
  },
  {
    "surah_id": 55,
    "ayah_number": 23,
    "global_ayah_id": 4924,
    "translation": "Öyleyken Rabbinizin nimetlerinden hangisini yalanlarsınız?"
  },
  {
    "surah_id": 55,
    "ayah_number": 24,
    "global_ayah_id": 4925,
    "translation": "Denizde yürüyen dağlar gibi gemiler O'nundur."
  },
  {
    "surah_id": 55,
    "ayah_number": 25,
    "global_ayah_id": 4926,
    "translation": "Öyleyken Rabbinizin nimetlerinden hangisini yalanlarsınız?"
  },
  {
    "surah_id": 55,
    "ayah_number": 26,
    "global_ayah_id": 4927,
    "translation": "Yeryüzünde bulunan her şey fanidir."
  },
  {
    "surah_id": 55,
    "ayah_number": 27,
    "global_ayah_id": 4928,
    "translation": "Ancak, yüce ve cömert olan Rabbinin varlığı bakidir."
  },
  {
    "surah_id": 55,
    "ayah_number": 28,
    "global_ayah_id": 4929,
    "translation": "Öyleyken Rabbinizin nimetlerinden hangisini yalanlarsınız?"
  },
  {
    "surah_id": 55,
    "ayah_number": 29,
    "global_ayah_id": 4930,
    "translation": "Göklerde ve yerde olan kimseler her şeyi O'ndan isterler; O her an kainata tasarruf etmektedir."
  },
  {
    "surah_id": 55,
    "ayah_number": 30,
    "global_ayah_id": 4931,
    "translation": "Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?"
  },
  {
    "surah_id": 55,
    "ayah_number": 31,
    "global_ayah_id": 4932,
    "translation": "Ey insan ve cin toplulukları! Sizin de hesabınızı ele alacağız."
  },
  {
    "surah_id": 55,
    "ayah_number": 32,
    "global_ayah_id": 4933,
    "translation": "Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?"
  },
  {
    "surah_id": 55,
    "ayah_number": 33,
    "global_ayah_id": 4934,
    "translation": "Ey cin ve insan toplulukları! Göklerin ve yerin çevresini aşıp geçmeye gücünüz yetiyorsa geçin! Ama Allah'ın verdiği bir güç olmaksızın geçemezsiniz ki!"
  },
  {
    "surah_id": 55,
    "ayah_number": 34,
    "global_ayah_id": 4935,
    "translation": "Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?"
  },
  {
    "surah_id": 55,
    "ayah_number": 35,
    "global_ayah_id": 4936,
    "translation": "Ey insanlar ve cinler! Üzerinize dumansız bir alev ve ateşsiz bir duman gönderilir de kurtulamazsınız."
  },
  {
    "surah_id": 55,
    "ayah_number": 36,
    "global_ayah_id": 4937,
    "translation": "Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?"
  },
  {
    "surah_id": 55,
    "ayah_number": 37,
    "global_ayah_id": 4938,
    "translation": "Gök yarılıp da, gül gibi kızardığı, yağ gibi eridiği zaman haliniz nice olur?"
  },
  {
    "surah_id": 55,
    "ayah_number": 38,
    "global_ayah_id": 4939,
    "translation": "Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?"
  },
  {
    "surah_id": 55,
    "ayah_number": 39,
    "global_ayah_id": 4940,
    "translation": "O gün ne insana ve ne cine suçu sorulur."
  },
  {
    "surah_id": 55,
    "ayah_number": 40,
    "global_ayah_id": 4941,
    "translation": "Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?"
  },
  {
    "surah_id": 55,
    "ayah_number": 41,
    "global_ayah_id": 4942,
    "translation": "Suçlular simalarından tanınırlar da, alın saçlarından ve ayaklarından yakalanırlar."
  },
  {
    "surah_id": 55,
    "ayah_number": 42,
    "global_ayah_id": 4943,
    "translation": "Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?"
  },
  {
    "surah_id": 55,
    "ayah_number": 43,
    "global_ayah_id": 4944,
    "translation": "İşte suçluların yalanladıkları cehennem budur."
  },
  {
    "surah_id": 55,
    "ayah_number": 44,
    "global_ayah_id": 4945,
    "translation": "Onlar, cehennem ateşiyle kaynar su arasında dolaşır dururlar."
  },
  {
    "surah_id": 55,
    "ayah_number": 45,
    "global_ayah_id": 4946,
    "translation": "Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?"
  },
  {
    "surah_id": 55,
    "ayah_number": 46,
    "global_ayah_id": 4947,
    "translation": "Rabbine karşı durmaktan korkan kimseye iki cennet vardır."
  },
  {
    "surah_id": 55,
    "ayah_number": 47,
    "global_ayah_id": 4948,
    "translation": "Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?"
  },
  {
    "surah_id": 55,
    "ayah_number": 48,
    "global_ayah_id": 4949,
    "translation": "Bu iki cennet türlü ağaçlarla doludur."
  },
  {
    "surah_id": 55,
    "ayah_number": 49,
    "global_ayah_id": 4950,
    "translation": "Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?"
  },
  {
    "surah_id": 55,
    "ayah_number": 50,
    "global_ayah_id": 4951,
    "translation": "Bu cennetlerden akan iki kaynak vardır."
  },
  {
    "surah_id": 55,
    "ayah_number": 51,
    "global_ayah_id": 4952,
    "translation": "Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?"
  },
  {
    "surah_id": 55,
    "ayah_number": 52,
    "global_ayah_id": 4953,
    "translation": "Bu cennetlerde türlü meyveden çift çift vardır."
  },
  {
    "surah_id": 55,
    "ayah_number": 53,
    "global_ayah_id": 4954,
    "translation": "Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?"
  },
  {
    "surah_id": 55,
    "ayah_number": 54,
    "global_ayah_id": 4955,
    "translation": "Orada, örtüleri parlak atlastan yataklara yaslanırlar; iki cennetin meyvelerini de kolayca toplarlar."
  },
  {
    "surah_id": 55,
    "ayah_number": 55,
    "global_ayah_id": 4956,
    "translation": "Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?"
  },
  {
    "surah_id": 55,
    "ayah_number": 56,
    "global_ayah_id": 4957,
    "translation": "Orada, bakışlarını yalnız eşlerine çevirmiş, daha önce ne insan ve ne de cinlerin dokunmuş olduğu eşler vardır."
  },
  {
    "surah_id": 55,
    "ayah_number": 57,
    "global_ayah_id": 4958,
    "translation": "Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?"
  },
  {
    "surah_id": 55,
    "ayah_number": 58,
    "global_ayah_id": 4959,
    "translation": "Onlar yakut ve mercan gibidirler."
  },
  {
    "surah_id": 55,
    "ayah_number": 59,
    "global_ayah_id": 4960,
    "translation": "Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?"
  },
  {
    "surah_id": 55,
    "ayah_number": 60,
    "global_ayah_id": 4961,
    "translation": "İyiliğin karşılığı ancak iyilik değil midir?"
  },
  {
    "surah_id": 55,
    "ayah_number": 61,
    "global_ayah_id": 4962,
    "translation": "Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?"
  },
  {
    "surah_id": 55,
    "ayah_number": 62,
    "global_ayah_id": 4963,
    "translation": "Bu iki cennetten başka iki cennet daha vardır."
  },
  {
    "surah_id": 55,
    "ayah_number": 63,
    "global_ayah_id": 4964,
    "translation": "Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?"
  },
  {
    "surah_id": 55,
    "ayah_number": 64,
    "global_ayah_id": 4965,
    "translation": "Renkleri koyu yeşildir."
  },
  {
    "surah_id": 55,
    "ayah_number": 65,
    "global_ayah_id": 4966,
    "translation": "Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?"
  },
  {
    "surah_id": 55,
    "ayah_number": 66,
    "global_ayah_id": 4967,
    "translation": "İkisinde de durmadan fışkıran iki kaynak vardır."
  },
  {
    "surah_id": 55,
    "ayah_number": 67,
    "global_ayah_id": 4968,
    "translation": "Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?"
  },
  {
    "surah_id": 55,
    "ayah_number": 68,
    "global_ayah_id": 4969,
    "translation": "İkisinde de türlü türlü meyveler, hurmalıklar ve nar ağaçları vardır."
  },
  {
    "surah_id": 55,
    "ayah_number": 69,
    "global_ayah_id": 4970,
    "translation": "Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?"
  },
  {
    "surah_id": 55,
    "ayah_number": 70,
    "global_ayah_id": 4971,
    "translation": "Oralarda iyi huylu güzel kadınlar vardır."
  },
  {
    "surah_id": 55,
    "ayah_number": 71,
    "global_ayah_id": 4972,
    "translation": "Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?"
  },
  {
    "surah_id": 55,
    "ayah_number": 72,
    "global_ayah_id": 4973,
    "translation": "Çadırlar içinde ceylan gözlüler vardır."
  },
  {
    "surah_id": 55,
    "ayah_number": 73,
    "global_ayah_id": 4974,
    "translation": "Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?"
  },
  {
    "surah_id": 55,
    "ayah_number": 74,
    "global_ayah_id": 4975,
    "translation": "Onlara daha önce insan da, cin de dokunmamıştır."
  },
  {
    "surah_id": 55,
    "ayah_number": 75,
    "global_ayah_id": 4976,
    "translation": "Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?"
  },
  {
    "surah_id": 55,
    "ayah_number": 76,
    "global_ayah_id": 4977,
    "translation": "Cennetlikler orada yeşil yastıklara ve harikulade işlemeli döşeklere yaslanırlar."
  },
  {
    "surah_id": 55,
    "ayah_number": 77,
    "global_ayah_id": 4978,
    "translation": "Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?"
  },
  {
    "surah_id": 55,
    "ayah_number": 78,
    "global_ayah_id": 4979,
    "translation": "Büyük ve pek cömert olan Rabbinin adı ne yücedir!"
  }
]