[
  {
    "surah_id": 55,
    "ayah_number": 1,
    "global_ayah_id": 4902,
    "translation": "Rahmân (çok merhametli olan Allah)"
  },
  {
    "surah_id": 55,
    "ayah_number": 2,
    "global_ayah_id": 4903,
    "translation": "Kurân'ı öğretti."
  },
  {
    "surah_id": 55,
    "ayah_number": 3,
    "global_ayah_id": 4904,
    "translation": "İnsanı yarattı."
  },
  {
    "surah_id": 55,
    "ayah_number": 4,
    "global_ayah_id": 4905,
    "translation": "Ona beyanı öğretti."
  },
  {
    "surah_id": 55,
    "ayah_number": 5,
    "global_ayah_id": 4906,
    "translation": "Güneş de ay da bir hesab iledir."
  },
  {
    "surah_id": 55,
    "ayah_number": 6,
    "global_ayah_id": 4907,
    "translation": "Bitkiler ve ağaçlar secde etmektedirler."
  },
  {
    "surah_id": 55,
    "ayah_number": 7,
    "global_ayah_id": 4908,
    "translation": "Göğü yükseltti ve mizanı koydu."
  },
  {
    "surah_id": 55,
    "ayah_number": 8,
    "global_ayah_id": 4909,
    "translation": "Sakın tartıda taşkınlık etmeyin."
  },
  {
    "surah_id": 55,
    "ayah_number": 9,
    "global_ayah_id": 4910,
    "translation": "Tartıyı adaletle yapın, terazide eksiklik yapmayın."
  },
  {
    "surah_id": 55,
    "ayah_number": 10,
    "global_ayah_id": 4911,
    "translation": "(Allah) yeri mahlukat için (aşağıya) koydu."
  },
  {
    "surah_id": 55,
    "ayah_number": 11,
    "global_ayah_id": 4912,
    "translation": "Orada meyvalar ve salkımlı hurma ağaçları vardır."
  },
  {
    "surah_id": 55,
    "ayah_number": 12,
    "global_ayah_id": 4913,
    "translation": "Yapraklı taneler ve hoş kokulu bitkiler vardır."
  },
  {
    "surah_id": 55,
    "ayah_number": 13,
    "global_ayah_id": 4914,
    "translation": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 14,
    "global_ayah_id": 4915,
    "translation": "Allah insanı, pişmiş bir çamura benzeyen bir balçıktan yarattı."
  },
  {
    "surah_id": 55,
    "ayah_number": 15,
    "global_ayah_id": 4916,
    "translation": "Cinleri de hâlis ateşten yarattı."
  },
  {
    "surah_id": 55,
    "ayah_number": 16,
    "global_ayah_id": 4917,
    "translation": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 17,
    "global_ayah_id": 4918,
    "translation": "(O) iki doğunun ve iki batının Rabbidir."
  },
  {
    "surah_id": 55,
    "ayah_number": 18,
    "global_ayah_id": 4919,
    "translation": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 19,
    "global_ayah_id": 4920,
    "translation": "(Acı ve tatlı) iki denizi salıverdi birbirine kavuşuyorlar."
  },
  {
    "surah_id": 55,
    "ayah_number": 20,
    "global_ayah_id": 4921,
    "translation": "Fakat aralarında bir engel vardır, birbirlerine geçip karışmıyorlar."
  },
  {
    "surah_id": 55,
    "ayah_number": 21,
    "global_ayah_id": 4922,
    "translation": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 22,
    "global_ayah_id": 4923,
    "translation": "İkisinden de inci ve mercan çıkar."
  },
  {
    "surah_id": 55,
    "ayah_number": 23,
    "global_ayah_id": 4924,
    "translation": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 24,
    "global_ayah_id": 4925,
    "translation": "Denizde koca dağlar gibi yükselen gemiler de onundur."
  },
  {
    "surah_id": 55,
    "ayah_number": 25,
    "global_ayah_id": 4926,
    "translation": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 26,
    "global_ayah_id": 4927,
    "translation": "Yer üzerinde bulunan her şey fânidir."
  },
  {
    "surah_id": 55,
    "ayah_number": 27,
    "global_ayah_id": 4928,
    "translation": "Yalnız celâl ve ikram sahibi Rabbinin yüzü (zâtı) baki kalacaktır."
  },
  {
    "surah_id": 55,
    "ayah_number": 28,
    "global_ayah_id": 4929,
    "translation": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 29,
    "global_ayah_id": 4930,
    "translation": "Göklerde ve yerde bulunanlar, O'ndan isterler. O, her gün yeni bir iştedir."
  },
  {
    "surah_id": 55,
    "ayah_number": 30,
    "global_ayah_id": 4931,
    "translation": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 31,
    "global_ayah_id": 4932,
    "translation": "Ey insan ve cin! sizin de hesabınızı ele alacağız."
  },
  {
    "surah_id": 55,
    "ayah_number": 32,
    "global_ayah_id": 4933,
    "translation": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 33,
    "global_ayah_id": 4934,
    "translation": "Ey cin ve insan toplulukları! Göklerin ve yerin çevresinden geçmeye gücünüz yeterse geçin gidin. Allah'ın verdiği bir güç olmadan geçemezsiniz."
  },
  {
    "surah_id": 55,
    "ayah_number": 34,
    "global_ayah_id": 4935,
    "translation": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 35,
    "global_ayah_id": 4936,
    "translation": "Üzerinize ateşten alev ve duman gönderilir, kendinizi savunamazsınız."
  },
  {
    "surah_id": 55,
    "ayah_number": 36,
    "global_ayah_id": 4937,
    "translation": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz"
  },
  {
    "surah_id": 55,
    "ayah_number": 37,
    "global_ayah_id": 4938,
    "translation": "Gök yarılıp da, erimiş yağ gibi kıpkırmızı bir gül olduğu zaman..."
  },
  {
    "surah_id": 55,
    "ayah_number": 38,
    "global_ayah_id": 4939,
    "translation": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 39,
    "global_ayah_id": 4940,
    "translation": "İşte o gün, ne insana ne de cinne günahından sorulmaz."
  },
  {
    "surah_id": 55,
    "ayah_number": 40,
    "global_ayah_id": 4941,
    "translation": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 41,
    "global_ayah_id": 4942,
    "translation": "Suçlular simalarından tanınır, alınlarından ve ayaklarından tutulur."
  },
  {
    "surah_id": 55,
    "ayah_number": 42,
    "global_ayah_id": 4943,
    "translation": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 43,
    "global_ayah_id": 4944,
    "translation": "İşte bu, suçluların yalanladığı cehennemdir."
  },
  {
    "surah_id": 55,
    "ayah_number": 44,
    "global_ayah_id": 4945,
    "translation": "Onunla kaynar su arasında dolaşırlar."
  },
  {
    "surah_id": 55,
    "ayah_number": 45,
    "global_ayah_id": 4946,
    "translation": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 46,
    "global_ayah_id": 4947,
    "translation": "Rabbinin makamından korkan kimselere iki cennet vardır."
  },
  {
    "surah_id": 55,
    "ayah_number": 47,
    "global_ayah_id": 4948,
    "translation": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 48,
    "global_ayah_id": 4949,
    "translation": "İkisinin de çeşitli ağaçları, meyvaları vardır."
  },
  {
    "surah_id": 55,
    "ayah_number": 49,
    "global_ayah_id": 4950,
    "translation": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 50,
    "global_ayah_id": 4951,
    "translation": "İkisinde de akıp giden iki kaynak vardır."
  },
  {
    "surah_id": 55,
    "ayah_number": 51,
    "global_ayah_id": 4952,
    "translation": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 52,
    "global_ayah_id": 4953,
    "translation": "İkisinde de her türlü meyvadan çift çift vardır."
  },
  {
    "surah_id": 55,
    "ayah_number": 53,
    "global_ayah_id": 4954,
    "translation": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 54,
    "global_ayah_id": 4955,
    "translation": "Astarları atlastan yataklara yaslanırlar. İki cennetin de devşirmesi yakındır."
  },
  {
    "surah_id": 55,
    "ayah_number": 55,
    "global_ayah_id": 4956,
    "translation": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 56,
    "global_ayah_id": 4957,
    "translation": "Oralarda gözlerini yalnız eşlerine çevirmiş dilberler var ki, bunlardan önce onlara ne insan ne de cin dokunmuştur."
  },
  {
    "surah_id": 55,
    "ayah_number": 57,
    "global_ayah_id": 4958,
    "translation": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 58,
    "global_ayah_id": 4959,
    "translation": "Sanki onlar yâkut ve mercandırlar."
  },
  {
    "surah_id": 55,
    "ayah_number": 59,
    "global_ayah_id": 4960,
    "translation": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 60,
    "global_ayah_id": 4961,
    "translation": "İyiliğin karşılığı, yalnız iyilik değil midir?"
  },
  {
    "surah_id": 55,
    "ayah_number": 61,
    "global_ayah_id": 4962,
    "translation": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 62,
    "global_ayah_id": 4963,
    "translation": "Bu ikisinden başka iki cennet daha vardır."
  },
  {
    "surah_id": 55,
    "ayah_number": 63,
    "global_ayah_id": 4964,
    "translation": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 64,
    "global_ayah_id": 4965,
    "translation": "(Bu cennetler) yemyeşildirler."
  },
  {
    "surah_id": 55,
    "ayah_number": 65,
    "global_ayah_id": 4966,
    "translation": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 66,
    "global_ayah_id": 4967,
    "translation": "İkisinde de fışkıran iki kaynak vardır."
  },
  {
    "surah_id": 55,
    "ayah_number": 67,
    "global_ayah_id": 4968,
    "translation": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 68,
    "global_ayah_id": 4969,
    "translation": "İkisinde de her türlü meyva, hurma ve nar vardır."
  },
  {
    "surah_id": 55,
    "ayah_number": 69,
    "global_ayah_id": 4970,
    "translation": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 70,
    "global_ayah_id": 4971,
    "translation": "İçlerinde güzel huylu, güzel yüzlü kadınlar vardır."
  },
  {
    "surah_id": 55,
    "ayah_number": 71,
    "global_ayah_id": 4972,
    "translation": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 72,
    "global_ayah_id": 4973,
    "translation": "Çadırlar içerisinde gözlerini yalnız kocalarına çevirmiş hûriler vardır."
  },
  {
    "surah_id": 55,
    "ayah_number": 73,
    "global_ayah_id": 4974,
    "translation": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 74,
    "global_ayah_id": 4975,
    "translation": "Bunlardan önce onlara ne insan ne de cin dokunmuştur."
  },
  {
    "surah_id": 55,
    "ayah_number": 75,
    "global_ayah_id": 4976,
    "translation": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 76,
    "global_ayah_id": 4977,
    "translation": "Yeşil yastıklara ve hârikulâde güzel işlemeli döşeklere yaslanırlar."
  },
  {
    "surah_id": 55,
    "ayah_number": 77,
    "global_ayah_id": 4978,
    "translation": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"
  },
  {
    "surah_id": 55,
    "ayah_number": 78,
    "global_ayah_id": 4979,
    "translation": "Büyüklük ve ikram sahibi Rabbinin adı ne yücedir!"
  }
]