[
  {
    "surah_id": 55,
    "ayah_number": 1,
    "global_ayah_id": 4902,
    "translation": "至仁主，"
  },
  {
    "surah_id": 55,
    "ayah_number": 2,
    "global_ayah_id": 4903,
    "translation": "曾教授《古蘭經》，"
  },
  {
    "surah_id": 55,
    "ayah_number": 3,
    "global_ayah_id": 4904,
    "translation": "他創造了人，"
  },
  {
    "surah_id": 55,
    "ayah_number": 4,
    "global_ayah_id": 4905,
    "translation": "並教人修辭。"
  },
  {
    "surah_id": 55,
    "ayah_number": 5,
    "global_ayah_id": 4906,
    "translation": "日月是依定數而運行的。"
  },
  {
    "surah_id": 55,
    "ayah_number": 6,
    "global_ayah_id": 4907,
    "translation": "草木是順從他的意旨的。"
  },
  {
    "surah_id": 55,
    "ayah_number": 7,
    "global_ayah_id": 4908,
    "translation": "他曾將天升起。他曾規定公平，"
  },
  {
    "surah_id": 55,
    "ayah_number": 8,
    "global_ayah_id": 4909,
    "translation": "以免你們用稱不公。"
  },
  {
    "surah_id": 55,
    "ayah_number": 9,
    "global_ayah_id": 4910,
    "translation": "你們應當秉公地僅守衡度，你們不要使所稱之物份量不足。"
  },
  {
    "surah_id": 55,
    "ayah_number": 10,
    "global_ayah_id": 4911,
    "translation": "他為眾生而將大地放下。"
  },
  {
    "surah_id": 55,
    "ayah_number": 11,
    "global_ayah_id": 4912,
    "translation": "大地上有水果，和有花篦的海棗，"
  },
  {
    "surah_id": 55,
    "ayah_number": 12,
    "global_ayah_id": 4913,
    "translation": "與有稈的五穀和香草。"
  },
  {
    "surah_id": 55,
    "ayah_number": 13,
    "global_ayah_id": 4914,
    "translation": "你們究竟否認你們的主的哪一件恩典呢？"
  },
  {
    "surah_id": 55,
    "ayah_number": 14,
    "global_ayah_id": 4915,
    "translation": "他曾用陶器般的乾土創造人，"
  },
  {
    "surah_id": 55,
    "ayah_number": 15,
    "global_ayah_id": 4916,
    "translation": "他用火焰創造精靈。"
  },
  {
    "surah_id": 55,
    "ayah_number": 16,
    "global_ayah_id": 4917,
    "translation": "你們究竟否認你們的主的哪一件恩典呢？"
  },
  {
    "surah_id": 55,
    "ayah_number": 17,
    "global_ayah_id": 4918,
    "translation": "他是兩個東方的主，也是兩個西方的主。"
  },
  {
    "surah_id": 55,
    "ayah_number": 18,
    "global_ayah_id": 4919,
    "translation": "你們究竟否認你們的主的哪一件恩典呢？"
  },
  {
    "surah_id": 55,
    "ayah_number": 19,
    "global_ayah_id": 4920,
    "translation": "他曾任兩海相交而會合，"
  },
  {
    "surah_id": 55,
    "ayah_number": 20,
    "global_ayah_id": 4921,
    "translation": "兩海之間，有一個堤防，兩海互不侵犯。"
  },
  {
    "surah_id": 55,
    "ayah_number": 21,
    "global_ayah_id": 4922,
    "translation": "你們究竟否認你們的主的哪一件恩典呢？"
  },
  {
    "surah_id": 55,
    "ayah_number": 22,
    "global_ayah_id": 4923,
    "translation": "他從兩海中取出大珍珠和小珍珠。"
  },
  {
    "surah_id": 55,
    "ayah_number": 23,
    "global_ayah_id": 4924,
    "translation": "你們究竟否認你們的主的哪一件恩典呢？"
  },
  {
    "surah_id": 55,
    "ayah_number": 24,
    "global_ayah_id": 4925,
    "translation": "在海中桅帆高舉，狀如山巒的船舶，只是他的。"
  },
  {
    "surah_id": 55,
    "ayah_number": 25,
    "global_ayah_id": 4926,
    "translation": "你們究竟否認你們的主的哪一件恩典呢？"
  },
  {
    "surah_id": 55,
    "ayah_number": 26,
    "global_ayah_id": 4927,
    "translation": "凡在大地上的，都要毀滅；"
  },
  {
    "surah_id": 55,
    "ayah_number": 27,
    "global_ayah_id": 4928,
    "translation": "惟有你的主的本體，具有尊嚴與大德，將永恆存在。"
  },
  {
    "surah_id": 55,
    "ayah_number": 28,
    "global_ayah_id": 4929,
    "translation": "你們究竟否認你們的主的哪一件恩典呢？"
  },
  {
    "surah_id": 55,
    "ayah_number": 29,
    "global_ayah_id": 4930,
    "translation": "凡在天地間的都仰求他；他時時都有事物。"
  },
  {
    "surah_id": 55,
    "ayah_number": 30,
    "global_ayah_id": 4931,
    "translation": "你們究竟否認你們的主的哪一件恩典呢？"
  },
  {
    "surah_id": 55,
    "ayah_number": 31,
    "global_ayah_id": 4932,
    "translation": "精靈和人類啊！我將專心應付你們。"
  },
  {
    "surah_id": 55,
    "ayah_number": 32,
    "global_ayah_id": 4933,
    "translation": "你們究竟否認你們的主的哪一件恩典呢？"
  },
  {
    "surah_id": 55,
    "ayah_number": 33,
    "global_ayah_id": 4934,
    "translation": "精靈和人類的群眾啊！如果你們能通過天地的境界，你們就通過吧！你們必須憑據一種權柄，才能通過。"
  },
  {
    "surah_id": 55,
    "ayah_number": 34,
    "global_ayah_id": 4935,
    "translation": "你們究竟否認你們的主的哪一件恩典呢？"
  },
  {
    "surah_id": 55,
    "ayah_number": 35,
    "global_ayah_id": 4936,
    "translation": "火焰和火煙將被降於你們，而你們不能自衛。"
  },
  {
    "surah_id": 55,
    "ayah_number": 36,
    "global_ayah_id": 4937,
    "translation": "你們究竟否認你們的主的哪一件恩典呢？"
  },
  {
    "surah_id": 55,
    "ayah_number": 37,
    "global_ayah_id": 4938,
    "translation": "當天破離的時候，天將變成玫瑰色，好像紅皮一樣。"
  },
  {
    "surah_id": 55,
    "ayah_number": 38,
    "global_ayah_id": 4939,
    "translation": "你們究竟否認你們的主的哪一件恩典呢？"
  },
  {
    "surah_id": 55,
    "ayah_number": 39,
    "global_ayah_id": 4940,
    "translation": "在那日，任何人和精靈都不因罪過而受審問。"
  },
  {
    "surah_id": 55,
    "ayah_number": 40,
    "global_ayah_id": 4941,
    "translation": "你們究竟否認你們的主的哪一件恩典呢？"
  },
  {
    "surah_id": 55,
    "ayah_number": 41,
    "global_ayah_id": 4942,
    "translation": "犯罪者將因他們的形跡而被認識，他們的額髮將被繫在腳掌上。"
  },
  {
    "surah_id": 55,
    "ayah_number": 42,
    "global_ayah_id": 4943,
    "translation": "你們究竟否認你們的主的哪一件恩典呢？"
  },
  {
    "surah_id": 55,
    "ayah_number": 43,
    "global_ayah_id": 4944,
    "translation": "這是犯罪者所否認的火獄。"
  },
  {
    "surah_id": 55,
    "ayah_number": 44,
    "global_ayah_id": 4945,
    "translation": "他們將往來於火獄和沸水之間。"
  },
  {
    "surah_id": 55,
    "ayah_number": 45,
    "global_ayah_id": 4946,
    "translation": "你們究竟否認你們的主的哪一件恩典呢？"
  },
  {
    "surah_id": 55,
    "ayah_number": 46,
    "global_ayah_id": 4947,
    "translation": "凡怕站在主的御前受審問者，都得享受兩座樂園。"
  },
  {
    "surah_id": 55,
    "ayah_number": 47,
    "global_ayah_id": 4948,
    "translation": "你們究竟否認你們的主的哪一件恩典呢？"
  },
  {
    "surah_id": 55,
    "ayah_number": 48,
    "global_ayah_id": 4949,
    "translation": "那兩座樂園，是有各種果樹的。"
  },
  {
    "surah_id": 55,
    "ayah_number": 49,
    "global_ayah_id": 4950,
    "translation": "你們究竟否認你們的主的哪一件恩典呢？"
  },
  {
    "surah_id": 55,
    "ayah_number": 50,
    "global_ayah_id": 4951,
    "translation": "在那兩座樂園裡，有兩洞流行的泉源。"
  },
  {
    "surah_id": 55,
    "ayah_number": 51,
    "global_ayah_id": 4952,
    "translation": "你們究竟否認你們的主的哪一件恩典呢？"
  },
  {
    "surah_id": 55,
    "ayah_number": 52,
    "global_ayah_id": 4953,
    "translation": "在那兩座樂園裡，每種水果，都有兩樣。"
  },
  {
    "surah_id": 55,
    "ayah_number": 53,
    "global_ayah_id": 4954,
    "translation": "你們究竟否認你們的主的哪一件恩典呢？"
  },
  {
    "surah_id": 55,
    "ayah_number": 54,
    "global_ayah_id": 4955,
    "translation": "他們靠在用錦緞做裡子的坐褥上，那兩座樂園的水果，都是手所能及的。"
  },
  {
    "surah_id": 55,
    "ayah_number": 55,
    "global_ayah_id": 4956,
    "translation": "你們究竟否認你們的主的哪一件恩典呢？"
  },
  {
    "surah_id": 55,
    "ayah_number": 56,
    "global_ayah_id": 4957,
    "translation": "在那些樂園中，有不視非禮的妻子；在他們的妻子之前，任何人和任何精靈都未與她們交接過。"
  },
  {
    "surah_id": 55,
    "ayah_number": 57,
    "global_ayah_id": 4958,
    "translation": "你們究竟否認你們的主的哪一件恩典呢？"
  },
  {
    "surah_id": 55,
    "ayah_number": 58,
    "global_ayah_id": 4959,
    "translation": "她們好像紅寶石和小珍珠一樣。"
  },
  {
    "surah_id": 55,
    "ayah_number": 59,
    "global_ayah_id": 4960,
    "translation": "你們究竟否認你們的主的哪一件恩典呢？"
  },
  {
    "surah_id": 55,
    "ayah_number": 60,
    "global_ayah_id": 4961,
    "translation": "行善者，只受善報。"
  },
  {
    "surah_id": 55,
    "ayah_number": 61,
    "global_ayah_id": 4962,
    "translation": "你們究竟否認你們的主的哪一件恩典呢？"
  },
  {
    "surah_id": 55,
    "ayah_number": 62,
    "global_ayah_id": 4963,
    "translation": "次於那兩座樂園的，還有兩座樂園。"
  },
  {
    "surah_id": 55,
    "ayah_number": 63,
    "global_ayah_id": 4964,
    "translation": "你們究竟否認你們的主的哪一件恩典呢？"
  },
  {
    "surah_id": 55,
    "ayah_number": 64,
    "global_ayah_id": 4965,
    "translation": "那兩座樂園都是蒼翠的。"
  },
  {
    "surah_id": 55,
    "ayah_number": 65,
    "global_ayah_id": 4966,
    "translation": "你們究竟否認你們的主的哪一件恩典呢？"
  },
  {
    "surah_id": 55,
    "ayah_number": 66,
    "global_ayah_id": 4967,
    "translation": "在那兩座樂園裡，有兩洞湧出的泉源。"
  },
  {
    "surah_id": 55,
    "ayah_number": 67,
    "global_ayah_id": 4968,
    "translation": "你們究竟否認你們的主的哪一件恩典呢？"
  },
  {
    "surah_id": 55,
    "ayah_number": 68,
    "global_ayah_id": 4969,
    "translation": "在那兩座樂園裡，有水果，有海棗，有石榴。"
  },
  {
    "surah_id": 55,
    "ayah_number": 69,
    "global_ayah_id": 4970,
    "translation": "你們究竟否認你們的主的哪一件恩典呢？"
  },
  {
    "surah_id": 55,
    "ayah_number": 70,
    "global_ayah_id": 4971,
    "translation": "在那些樂園裡，有許多賢淑佳麗的女子。"
  },
  {
    "surah_id": 55,
    "ayah_number": 71,
    "global_ayah_id": 4972,
    "translation": "你們究竟否認你們的主的哪一件恩典呢？"
  },
  {
    "surah_id": 55,
    "ayah_number": 72,
    "global_ayah_id": 4973,
    "translation": "她們是白皙的，是蟄居於帳幕中的。"
  },
  {
    "surah_id": 55,
    "ayah_number": 73,
    "global_ayah_id": 4974,
    "translation": "你們究竟否認你們的主的哪一件恩典呢？"
  },
  {
    "surah_id": 55,
    "ayah_number": 74,
    "global_ayah_id": 4975,
    "translation": "在他們的妻子之前，任何人或精靈，都未曾與她們交接過。"
  },
  {
    "surah_id": 55,
    "ayah_number": 75,
    "global_ayah_id": 4976,
    "translation": "你們究竟否認你們的主的哪一件恩典呢？"
  },
  {
    "surah_id": 55,
    "ayah_number": 76,
    "global_ayah_id": 4977,
    "translation": "他們靠在翠綠的坐褥和美麗的花毯上。"
  },
  {
    "surah_id": 55,
    "ayah_number": 77,
    "global_ayah_id": 4978,
    "translation": "你們究竟否認你們的主的哪一件恩典呢？"
  },
  {
    "surah_id": 55,
    "ayah_number": 78,
    "global_ayah_id": 4979,
    "translation": "多福哉，你具尊嚴和大德的主的名號！"
  }
]