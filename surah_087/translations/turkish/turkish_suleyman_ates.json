[
  {
    "surah_id": 87,
    "ayah_number": 1,
    "global_ayah_id": 5949,
    "translation": "Rabbinin yüce adını tesbih et (O'nun eksikliklerden uzak olduğunu an)."
  },
  {
    "surah_id": 87,
    "ayah_number": 2,
    "global_ayah_id": 5950,
    "translation": "O ki (her şeyi) yarattı, düzenledi."
  },
  {
    "surah_id": 87,
    "ayah_number": 3,
    "global_ayah_id": 5951,
    "translation": "Ve O ki herşeyin miktarını, biçimini belirleyip hedefini gösterdi."
  },
  {
    "surah_id": 87,
    "ayah_number": 4,
    "global_ayah_id": 5952,
    "translation": "Ve O ki otlağı çıkardı,"
  },
  {
    "surah_id": 87,
    "ayah_number": 5,
    "global_ayah_id": 5953,
    "translation": "Sonra da onu kupkuru, siyah bir çöpe çevirdi."
  },
  {
    "surah_id": 87,
    "ayah_number": 6,
    "global_ayah_id": 5954,
    "translation": "Sana (Kur'an'ı), okutacağız, unutmayacaksın."
  },
  {
    "surah_id": 87,
    "ayah_number": 7,
    "global_ayah_id": 5955,
    "translation": "Yalnız Allah'ın dilediğini unutursun. O, açığı da bilir, gizli olanı da."
  },
  {
    "surah_id": 87,
    "ayah_number": 8,
    "global_ayah_id": 5956,
    "translation": "Seni en kolay yola muvaffak edeceğiz."
  },
  {
    "surah_id": 87,
    "ayah_number": 9,
    "global_ayah_id": 5957,
    "translation": "O halde eğer hatırlatmak yarar verirse hatırlat, öğüt ver."
  },
  {
    "surah_id": 87,
    "ayah_number": 10,
    "global_ayah_id": 5958,
    "translation": "(Allah'a) Saygılı olan hatırlar (öğüt alır)."
  },
  {
    "surah_id": 87,
    "ayah_number": 11,
    "global_ayah_id": 5959,
    "translation": "Bahtsız olan da ondan kaçınır."
  },
  {
    "surah_id": 87,
    "ayah_number": 12,
    "global_ayah_id": 5960,
    "translation": "O da en büyük ateşe girer."
  },
  {
    "surah_id": 87,
    "ayah_number": 13,
    "global_ayah_id": 5961,
    "translation": "Sonra orada ne ölür, ne de yaşar."
  },
  {
    "surah_id": 87,
    "ayah_number": 14,
    "global_ayah_id": 5962,
    "translation": "Doğrusu, mutluluğa ermiştir zekat veren;"
  },
  {
    "surah_id": 87,
    "ayah_number": 15,
    "global_ayah_id": 5963,
    "translation": "Rabbinin adını anıp namaz kılan."
  },
  {
    "surah_id": 87,
    "ayah_number": 16,
    "global_ayah_id": 5964,
    "translation": "Ama siz, şu yakın hayatı yeğliyorsunuz."
  },
  {
    "surah_id": 87,
    "ayah_number": 17,
    "global_ayah_id": 5965,
    "translation": "Oysa ahiret daha iyi ve daha kalıcıdır."
  },
  {
    "surah_id": 87,
    "ayah_number": 18,
    "global_ayah_id": 5966,
    "translation": "Bu (hükümler), elbette ilk sahifelerde de vardı:"
  },
  {
    "surah_id": 87,
    "ayah_number": 19,
    "global_ayah_id": 5967,
    "translation": "İbrahim'in ve Musa'nn sayfalarında."
  }
]