[
  {
    "surah_id": 87,
    "ayah_number": 0,
    "global_ayah_id": 6034,
    "translation": "اللہ کے نام سے جو رحمان و رحیم ہے"
  },
  {
    "surah_id": 87,
    "ayah_number": 1,
    "global_ayah_id": 6035,
    "translation": "پاکی بیان کر اپنے رب کے نام کی جو سب سے اوپر"
  },
  {
    "surah_id": 87,
    "ayah_number": 2,
    "global_ayah_id": 6036,
    "translation": "جس نے بنایا پھر ٹھیک کیا"
  },
  {
    "surah_id": 87,
    "ayah_number": 3,
    "global_ayah_id": 6037,
    "translation": "اور جس نے ٹھہرا دیا پھر راہ بتلائی"
  },
  {
    "surah_id": 87,
    "ayah_number": 4,
    "global_ayah_id": 6038,
    "translation": "اور جس نے نکالا چارا"
  },
  {
    "surah_id": 87,
    "ayah_number": 5,
    "global_ayah_id": 6039,
    "translation": "پھر کر ڈالا اُسکو کُوڑا سیاہ"
  },
  {
    "surah_id": 87,
    "ayah_number": 6,
    "global_ayah_id": 6040,
    "translation": "البتہ ہم پڑھائیں گے تجھ کو پھر تو نہ بھولے گا"
  },
  {
    "surah_id": 87,
    "ayah_number": 7,
    "global_ayah_id": 6041,
    "translation": "مگر جو چاہے اللہ وہ جانتا ہے پکارنے کو اور جو چھپا ہوا ہے"
  },
  {
    "surah_id": 87,
    "ayah_number": 8,
    "global_ayah_id": 6042,
    "translation": "اور سہج سہج پہنچائیں گے ہم تجھ کو آسانی تک"
  },
  {
    "surah_id": 87,
    "ayah_number": 9,
    "global_ayah_id": 6043,
    "translation": "سو تو سمجھا دے اگر فائدہ کرے سمجھانا"
  },
  {
    "surah_id": 87,
    "ayah_number": 10,
    "global_ayah_id": 6044,
    "translation": "سمجھ جائے گا جس کو ڈر ہو گا"
  },
  {
    "surah_id": 87,
    "ayah_number": 11,
    "global_ayah_id": 6045,
    "translation": "اور یکسو رہے گا اُس سے بڑا بدقسمت"
  },
  {
    "surah_id": 87,
    "ayah_number": 12,
    "global_ayah_id": 6046,
    "translation": "وہ جو داخل ہو گا بڑی آگ میں"
  },
  {
    "surah_id": 87,
    "ayah_number": 13,
    "global_ayah_id": 6047,
    "translation": "پھر نہ مرے گا اُس میں اور نہ جئے گا"
  },
  {
    "surah_id": 87,
    "ayah_number": 14,
    "global_ayah_id": 6048,
    "translation": "بیشک بھلا ہوا اُس کا جو سنورا"
  },
  {
    "surah_id": 87,
    "ayah_number": 15,
    "global_ayah_id": 6049,
    "translation": "اورلیا اُس نے نام اپنے رب کا پھر نماز پڑھی"
  },
  {
    "surah_id": 87,
    "ayah_number": 16,
    "global_ayah_id": 6050,
    "translation": "کوئی نہیں تم بڑھاتے ہو دنیا کے جینے کو"
  },
  {
    "surah_id": 87,
    "ayah_number": 17,
    "global_ayah_id": 6051,
    "translation": "اور پچھلا گھر بہتر ہے اور باقی رہنے والا"
  },
  {
    "surah_id": 87,
    "ayah_number": 18,
    "global_ayah_id": 6052,
    "translation": "یہ لکھا ہوا ہے پہلے ورقوں میں"
  },
  {
    "surah_id": 87,
    "ayah_number": 19,
    "global_ayah_id": 6053,
    "translation": "صحیفوں میں ابراہیم کے اور موسٰی کے"
  }
]