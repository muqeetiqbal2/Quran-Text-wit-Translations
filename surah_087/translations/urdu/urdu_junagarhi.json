    "global_ayah_id": 6034,
    "translation": " «<a href=416> شروع </a>» کرتا ہوں اللہ تعا لٰی کے «<a href=614> نام\n</a>» سے جو بڑا «<a href=600> مہربان </a>» نہایت رحم والا ہے ۔ "
  },
  {
    "surah_id": 87,
    "ayah_number": 1,
    "global_ayah_id": 6035,
    "translation": " اپنے بہت ہی «<a href=106> بلند </a>» اللہ کے «<a href=614> نام </a>»\nکی «<a href=196> پاکیزگی </a>» «<a href=126> بیان </a>» کر ۔ "
  },
  {
    "surah_id": 87,
    "ayah_number": 2,
    "global_ayah_id": 6036,
    "translation": " جس نے «<a href=180> پیدا </a>» کیا اور صحیح سالم بنایا ۔ "
  },
  {
    "surah_id": 87,
    "ayah_number": 3,
    "global_ayah_id": 6037,
    "translation": " اور جس نے ( ٹھیک ٹھاک ) «<a href=56> اندازہ </a>» کیا اور پھر راہ\nدکھائی ۔ "
  },
  {
    "surah_id": 87,
    "ayah_number": 4,
    "global_ayah_id": 6038,
    "translation": " اور جس نے «<a href=187> تازہ </a>» گھاس «<a href=180> پیدا </a>» کی ۔\n "
  },
  {
    "surah_id": 87,
    "ayah_number": 5,
    "global_ayah_id": 6039,
    "translation": " پھر اس نے اس کو ( سکھا کر ) سیاہ «<a href=500> کوڑا </a>» کر دیا ۔ "
  },
  {
    "surah_id": 87,
    "ayah_number": 6,
    "global_ayah_id": 6040,
    "translation": " ہم تجھے پڑھائیں گے پھر تو نہ بھولے گا ۔ "
  },
  {
    "surah_id": 87,
    "ayah_number": 7,
    "global_ayah_id": 6041,
    "translation": " مگر جو کچھ اللہ چاہے ، وہ «<a href=435> ظاہر </a>» اور پوشیدہ کو جانتا\nہے ۔ "
  },
  {
    "surah_id": 87,
    "ayah_number": 8,
    "global_ayah_id": 6042,
    "translation": " ہم آپ کیلئے آسانی «<a href=180> پیدا </a>» کر دیں گے ۔ "
  },
  {
    "surah_id": 87,
    "ayah_number": 9,
    "global_ayah_id": 6043,
    "translation": " تو آپ «<a href=622> نصیحت </a>» کرتے رہیں اگر «<a href=622> نصیحت\n</a>» کچھ «<a href=452> فائدہ </a>» دے ۔ "
  },
  {
    "surah_id": 87,
    "ayah_number": 10,
    "global_ayah_id": 6044,
    "translation": " ڈرنے والا تو «<a href=622> نصیحت </a>» لے گا ۔ "
  },
  {
    "surah_id": 87,
    "ayah_number": 11,
    "global_ayah_id": 6045,
    "translation": " ۔ ( ہاں ) بد بخت اس سے گریز کرے گا ۔ "
  },
  {
    "surah_id": 87,
    "ayah_number": 12,
    "global_ayah_id": 6046,
    "translation": " جو بڑی «<a href=12> آگ </a>» میں جائے گا ۔ "
  },
  {
    "surah_id": 87,
    "ayah_number": 13,
    "global_ayah_id": 6047,
    "translation": " جہاں پھر نہ وہ مرے گا نہ جئیے گا ( بلکہ «<a href=280> حالت </a>» نزع\nمیں پڑا رہے گا ) ۔ "
  },
  {
    "surah_id": 87,
    "ayah_number": 14,
    "global_ayah_id": 6048,
    "translation": " بیشک اس نے فلاح پائی جو «<a href=142> پاک </a>» ہوگیا ۔ "
  },
  {
    "surah_id": 87,
    "ayah_number": 15,
    "global_ayah_id": 6049,
    "translation": " اور جس نے اپنے رب کا «<a href=614> نام </a>» «<a href=657> یاد </a>»\nرکھا اور نماز پڑھتا رہا ۔ "
  },
  {
    "surah_id": 87,
    "ayah_number": 16,
    "global_ayah_id": 6050,
    "translation": " لیکن تم تو «<a href=327> دنیا </a>» کی زندگی کو ترجیح دیتے ہو ۔ "
  },
  {
    "surah_id": 87,
    "ayah_number": 17,
    "global_ayah_id": 6051,
    "translation": " اور «<a href=2> آخرت </a>» بہت بہتر اور بہت بقا والی ہے ۔ "
  },
  {
    "surah_id": 87,
    "ayah_number": 18,
    "global_ayah_id": 6052,
    "translation": " یہ باتیں پہلی کتابوں میں بھی ہیں ۔ "
  },
  {
    "surah_id": 87,
    "ayah_number": 19,
    "global_ayah_id": 6053,
    "translation": " ۔ ( یعنی ) ابراہیم اور موسیٰ کی کتابوں میں ۔ "
  }
]