[
  {
    "surah_id": 87,
    "ayah_number": 1,
    "global_ayah_id": 5949,
    "translation": "Praise the name of thy Lord the Most High,"
  },
  {
    "surah_id": 87,
    "ayah_number": 2,
    "global_ayah_id": 5950,
    "translation": "Who createth, then disposeth;"
  },
  {
    "surah_id": 87,
    "ayah_number": 3,
    "global_ayah_id": 5951,
    "translation": "Who measureth, then guideth;"
  },
  {
    "surah_id": 87,
    "ayah_number": 4,
    "global_ayah_id": 5952,
    "translation": "Who bringeth forth the pasturage,"
  },
  {
    "surah_id": 87,
    "ayah_number": 5,
    "global_ayah_id": 5953,
    "translation": "Then turneth it to russet stubble."
  },
  {
    "surah_id": 87,
    "ayah_number": 6,
    "global_ayah_id": 5954,
    "translation": "We shall make thee read (O Muhammad) so that thou shalt not forget"
  },
  {
    "surah_id": 87,
    "ayah_number": 7,
    "global_ayah_id": 5955,
    "translation": "Save that which Allah willeth. Lo! He knoweth the disclosed and that which still is hidden;"
  },
  {
    "surah_id": 87,
    "ayah_number": 8,
    "global_ayah_id": 5956,
    "translation": "And We shall ease thy way unto the state of ease."
  },
  {
    "surah_id": 87,
    "ayah_number": 9,
    "global_ayah_id": 5957,
    "translation": "Therefor remind (men), for of use is the reminder."
  },
  {
    "surah_id": 87,
    "ayah_number": 10,
    "global_ayah_id": 5958,
    "translation": "He will heed who feareth,"
  },
  {
    "surah_id": 87,
    "ayah_number": 11,
    "global_ayah_id": 5959,
    "translation": "But the most hapless will flout it,"
  },
  {
    "surah_id": 87,
    "ayah_number": 12,
    "global_ayah_id": 5960,
    "translation": "He who will be flung to the great Fire"
  },
  {
    "surah_id": 87,
    "ayah_number": 13,
    "global_ayah_id": 5961,
    "translation": "Wherein he will neither die nor live."
  },
  {
    "surah_id": 87,
    "ayah_number": 14,
    "global_ayah_id": 5962,
    "translation": "He is successful who groweth,"
  },
  {
    "surah_id": 87,
    "ayah_number": 15,
    "global_ayah_id": 5963,
    "translation": "And remembereth the name of his Lord, so prayeth,"
  },
  {
    "surah_id": 87,
    "ayah_number": 16,
    "global_ayah_id": 5964,
    "translation": "But ye prefer the life of the world"
  },
  {
    "surah_id": 87,
    "ayah_number": 17,
    "global_ayah_id": 5965,
    "translation": "Although the Hereafter is better and more lasting."
  },
  {
    "surah_id": 87,
    "ayah_number": 18,
    "global_ayah_id": 5966,
    "translation": "Lo! This is in the former scrolls."
  },
  {
    "surah_id": 87,
    "ayah_number": 19,
    "global_ayah_id": 5967,
    "translation": "The Books of Abraham and Moses."
  }
]