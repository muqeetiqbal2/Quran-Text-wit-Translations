[
  {
    "surah_id": 87,
    "ayah_number": 1,
    "global_ayah_id": 5949,
    "translation": "Slăveşte numele Domnului tău, Prea-Înaltul,"
  },
  {
    "surah_id": 87,
    "ayah_number": 2,
    "global_ayah_id": 5950,
    "translation": "Cel ce plăsmuieşte şi şlefuieşte,"
  },
  {
    "surah_id": 87,
    "ayah_number": 3,
    "global_ayah_id": 5951,
    "translation": "Cel ce sorteşte şi călăuzeşte,"
  },
  {
    "surah_id": 87,
    "ayah_number": 4,
    "global_ayah_id": 5952,
    "translation": "Cel ce păşunea o face ivită"
  },
  {
    "surah_id": 87,
    "ayah_number": 5,
    "global_ayah_id": 5953,
    "translation": "şi o preface apoi în fâneaţă înnegrită."
  },
  {
    "surah_id": 87,
    "ayah_number": 6,
    "global_ayah_id": 5954,
    "translation": "Noi te vom pune să citeşti şi nu vei uita,"
  },
  {
    "surah_id": 87,
    "ayah_number": 7,
    "global_ayah_id": 5955,
    "translation": "decât ceea ce Dumnezeu voieşte, căci El cunoaşte cele dezvăluite şi cele tăinuite."
  },
  {
    "surah_id": 87,
    "ayah_number": 8,
    "global_ayah_id": 5956,
    "translation": "Pe tine te vom înlesni întru înlesnire."
  },
  {
    "surah_id": 87,
    "ayah_number": 9,
    "global_ayah_id": 5957,
    "translation": "Adu-le aminte, căci aducerea aminte este de folos."
  },
  {
    "surah_id": 87,
    "ayah_number": 10,
    "global_ayah_id": 5958,
    "translation": "Cel care se teme îşi va aduce aminte,"
  },
  {
    "surah_id": 87,
    "ayah_number": 11,
    "global_ayah_id": 5959,
    "translation": "însă cel preanemernic se va da la o parte."
  },
  {
    "surah_id": 87,
    "ayah_number": 12,
    "global_ayah_id": 5960,
    "translation": "Acela va fi aruncat în Focul cel Mare,"
  },
  {
    "surah_id": 87,
    "ayah_number": 13,
    "global_ayah_id": 5961,
    "translation": "unde nici nu va muri şi nici nu va trăi."
  },
  {
    "surah_id": 87,
    "ayah_number": 14,
    "global_ayah_id": 5962,
    "translation": "Fericit va fi cel care se mântuie,"
  },
  {
    "surah_id": 87,
    "ayah_number": 15,
    "global_ayah_id": 5963,
    "translation": "cel care aminteşte numele Domnului său şi se roagă."
  },
  {
    "surah_id": 87,
    "ayah_number": 16,
    "global_ayah_id": 5964,
    "translation": "Voi sunteţi legaţi de Viaţa de Acum,"
  },
  {
    "surah_id": 87,
    "ayah_number": 17,
    "global_ayah_id": 5965,
    "translation": "însă Viaţa de Apoi este mai bună şi mai trainică.."
  },
  {
    "surah_id": 87,
    "ayah_number": 18,
    "global_ayah_id": 5966,
    "translation": "Aşa este şi în sulurile cele dintâi,"
  },
  {
    "surah_id": 87,
    "ayah_number": 19,
    "global_ayah_id": 5967,
    "translation": "sulurile lui Abraham şi ale lui Moise"
  }
]