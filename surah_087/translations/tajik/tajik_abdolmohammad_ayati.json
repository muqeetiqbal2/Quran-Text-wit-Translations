[
  {
    "surah_id": 87,
    "ayah_number": 1,
    "global_ayah_id": 5949,
    "translation": "Номи Парвардигори бузурги худро ба покӣ ёд кун,"
  },
  {
    "surah_id": 87,
    "ayah_number": 2,
    "global_ayah_id": 5950,
    "translation": "он ки офарид ва дурустандом кард,"
  },
  {
    "surah_id": 87,
    "ayah_number": 3,
    "global_ayah_id": 5951,
    "translation": "Ва он ки андоза муъайян кард. Сипас роҳ намуд."
  },
  {
    "surah_id": 87,
    "ayah_number": 4,
    "global_ayah_id": 5952,
    "translation": "Ва он ки чарогоҳҳоро рӯёнид,"
  },
  {
    "surah_id": 87,
    "ayah_number": 5,
    "global_ayah_id": 5953,
    "translation": "сипас хушку сиёҳ гардонид."
  },
  {
    "surah_id": 87,
    "ayah_number": 6,
    "global_ayah_id": 5954,
    "translation": "Ба зудӣ барои ту бихонем, мабод, ки фаромӯш кунӣ."
  },
  {
    "surah_id": 87,
    "ayah_number": 7,
    "global_ayah_id": 5955,
    "translation": "ғайри он чи Худо бихоҳад. Ӯст, ки ошкорову ниҳонро медонад."
  },
  {
    "surah_id": 87,
    "ayah_number": 8,
    "global_ayah_id": 5956,
    "translation": "Ва туро ба дини осон тавфиқ диҳем."
  },
  {
    "surah_id": 87,
    "ayah_number": 9,
    "global_ayah_id": 5957,
    "translation": "Агар панд, доданат суд кунад, панд деҳ."
  },
  {
    "surah_id": 87,
    "ayah_number": 10,
    "global_ayah_id": 5958,
    "translation": "Он ки метарсад, панд мегирад."
  },
  {
    "surah_id": 87,
    "ayah_number": 11,
    "global_ayah_id": 5959,
    "translation": "Ва бадбахт аз он дурӣ мегирад,"
  },
  {
    "surah_id": 87,
    "ayah_number": 12,
    "global_ayah_id": 5960,
    "translation": "он ки ба оташи бузурги ҷаҳаннам дарафтад"
  },
  {
    "surah_id": 87,
    "ayah_number": 13,
    "global_ayah_id": 5961,
    "translation": "ва дар он ҷо на бимирад ва на зинда бошад."
  },
  {
    "surah_id": 87,
    "ayah_number": 14,
    "global_ayah_id": 5962,
    "translation": "Албатта покон наҷот ёфтанд,"
  },
  {
    "surah_id": 87,
    "ayah_number": 15,
    "global_ayah_id": 5963,
    "translation": "онон, ки номи Парвардигори худро бар забон оварданд ва намоз гузориданд."
  },
  {
    "surah_id": 87,
    "ayah_number": 16,
    "global_ayah_id": 5964,
    "translation": "Оре, шумо зиндагии ин ҷаҳонро ихтиёр мекунед,"
  },
  {
    "surah_id": 87,
    "ayah_number": 17,
    "global_ayah_id": 5965,
    "translation": "ҳол он ки охират беҳтару пояндатар аст."
  },
  {
    "surah_id": 87,
    "ayah_number": 18,
    "global_ayah_id": 5966,
    "translation": "Ин сухан дар саҳифаҳои нахустин аст,"
  },
  {
    "surah_id": 87,
    "ayah_number": 19,
    "global_ayah_id": 5967,
    "translation": "саҳифаҳои Иброҳиму Мӯсо!"
  }
]