[
  {
    "surah_id": 87,
    "ayah_number": 1,
    "global_ayah_id": 5949,
    "translation": "ऐ रसूल अपने आलीशान परवरदिगार के नाम की तस्बीह करो"
  },
  {
    "surah_id": 87,
    "ayah_number": 2,
    "global_ayah_id": 5950,
    "translation": "जिसने (हर चीज़ को) पैदा किया"
  },
  {
    "surah_id": 87,
    "ayah_number": 3,
    "global_ayah_id": 5951,
    "translation": "और दुरूस्त किया और जिसने (उसका) अन्दाज़ा मुक़र्रर किया फिर राह बतायी"
  },
  {
    "surah_id": 87,
    "ayah_number": 4,
    "global_ayah_id": 5952,
    "translation": "और जिसने (हैवानात के लिए) चारा उगाया"
  },
  {
    "surah_id": 87,
    "ayah_number": 5,
    "global_ayah_id": 5953,
    "translation": "फिर ख़ुश्क उसे सियाह रंग का कूड़ा कर दिया"
  },
  {
    "surah_id": 87,
    "ayah_number": 6,
    "global_ayah_id": 5954,
    "translation": "हम तुम्हें (ऐसा) पढ़ा देंगे कि कभी भूलो ही नहीं"
  },
  {
    "surah_id": 87,
    "ayah_number": 7,
    "global_ayah_id": 5955,
    "translation": "मगर जो ख़ुदा चाहे (मन्सूख़ कर दे) बेशक वह खुली बात को भी जानता है और छुपे हुए को भी"
  },
  {
    "surah_id": 87,
    "ayah_number": 8,
    "global_ayah_id": 5956,
    "translation": "और हम तुमको आसान तरीके की तौफ़ीक़ देंगे"
  },
  {
    "surah_id": 87,
    "ayah_number": 9,
    "global_ayah_id": 5957,
    "translation": "तो जहाँ तक समझाना मुफ़ीद हो समझते रहो"
  },
  {
    "surah_id": 87,
    "ayah_number": 10,
    "global_ayah_id": 5958,
    "translation": "जो खौफ रखता हो वह तो फौरी समझ जाएगा"
  },
  {
    "surah_id": 87,
    "ayah_number": 11,
    "global_ayah_id": 5959,
    "translation": "और बदबख्त उससे पहलू तही करेगा"
  },
  {
    "surah_id": 87,
    "ayah_number": 12,
    "global_ayah_id": 5960,
    "translation": "जो (क़यामत में) बड़ी (तेज़) आग में दाख़िल होगा"
  },
  {
    "surah_id": 87,
    "ayah_number": 13,
    "global_ayah_id": 5961,
    "translation": "फिर न वहाँ मरेगा ही न जीयेगा"
  },
  {
    "surah_id": 87,
    "ayah_number": 14,
    "global_ayah_id": 5962,
    "translation": "वह यक़ीनन मुराद दिली को पहुँचा जो (शिर्क से) पाक हो"
  },
  {
    "surah_id": 87,
    "ayah_number": 15,
    "global_ayah_id": 5963,
    "translation": "और अपने परवरदिगार का ज़िक्र करता और नमाज़ पढ़ता रहा"
  },
  {
    "surah_id": 87,
    "ayah_number": 16,
    "global_ayah_id": 5964,
    "translation": "मगर तुम लोग दुनियावी ज़िन्दगी को तरजीह देते हो"
  },
  {
    "surah_id": 87,
    "ayah_number": 17,
    "global_ayah_id": 5965,
    "translation": "हालॉकि आख़ोरत कहीं बेहतर और देर पा है"
  },
  {
    "surah_id": 87,
    "ayah_number": 18,
    "global_ayah_id": 5966,
    "translation": "बेशक यही बात अगले सहीफ़ों"
  },
  {
    "surah_id": 87,
    "ayah_number": 19,
    "global_ayah_id": 5967,
    "translation": "इबराहीम और मूसा के सहीफ़ों में भी है"
  }
]