[
  {
    "surah_id": 87,
    "ayah_number": 1,
    "global_ayah_id": 5949,
    "translation": "तसबीह करो, अपने सर्वाच्च रब के नाम की,"
  },
  {
    "surah_id": 87,
    "ayah_number": 2,
    "global_ayah_id": 5950,
    "translation": "जिसने पैदा किया, फिर ठीक-ठाक किया,"
  },
  {
    "surah_id": 87,
    "ayah_number": 3,
    "global_ayah_id": 5951,
    "translation": "जिसने निर्धारित किया, फिर मार्ग दिखाया,"
  },
  {
    "surah_id": 87,
    "ayah_number": 4,
    "global_ayah_id": 5952,
    "translation": "जिसने वनस्पति उगाई,"
  },
  {
    "surah_id": 87,
    "ayah_number": 5,
    "global_ayah_id": 5953,
    "translation": "फिर उसे ख़ूब घना और हरा-भरा कर दिया"
  },
  {
    "surah_id": 87,
    "ayah_number": 6,
    "global_ayah_id": 5954,
    "translation": "हम तुम्हें पढ़ा देंगे, फिर तुम भूलोगे नहीं"
  },
  {
    "surah_id": 87,
    "ayah_number": 7,
    "global_ayah_id": 5955,
    "translation": "बात यह है कि अल्लाह की इच्छा ही क्रियान्वित है। निश्चय ही वह जानता है खुले को भी और उसे भी जो छिपा रहे"
  },
  {
    "surah_id": 87,
    "ayah_number": 8,
    "global_ayah_id": 5956,
    "translation": "हम तुम्हें सहज ढंग से उस चीज़ की पात्र बना देंगे जो सहज एवं मृदुल (आरामदायक) है"
  },
  {
    "surah_id": 87,
    "ayah_number": 9,
    "global_ayah_id": 5957,
    "translation": "अतः नसीहत करो, यदि नसीहत लाभप्रद हो!"
  },
  {
    "surah_id": 87,
    "ayah_number": 10,
    "global_ayah_id": 5958,
    "translation": "नसीहत हासिल कर लेगा जिसको डर होगा,"
  },
  {
    "surah_id": 87,
    "ayah_number": 11,
    "global_ayah_id": 5959,
    "translation": "किन्तु उससे कतराएगा वह अत्यन्त दुर्भाग्यवाला,"
  },
  {
    "surah_id": 87,
    "ayah_number": 12,
    "global_ayah_id": 5960,
    "translation": "जो बड़ी आग में पड़ेगा,"
  },
  {
    "surah_id": 87,
    "ayah_number": 13,
    "global_ayah_id": 5961,
    "translation": "फिर वह उसमें न मरेगा न जिएगा"
  },
  {
    "surah_id": 87,
    "ayah_number": 14,
    "global_ayah_id": 5962,
    "translation": "सफल हो गया वह जिसने अपने आपको निखार लिया,"
  },
  {
    "surah_id": 87,
    "ayah_number": 15,
    "global_ayah_id": 5963,
    "translation": "और अपने रब के नाम का स्मरण किया, अतः नमाज़ अदा की"
  },
  {
    "surah_id": 87,
    "ayah_number": 16,
    "global_ayah_id": 5964,
    "translation": "नहीं, बल्कि तुम तो सांसारिक जीवन को प्राथमिकता देते हो,"
  },
  {
    "surah_id": 87,
    "ayah_number": 17,
    "global_ayah_id": 5965,
    "translation": "हालाँकि आख़िरत अधिक उत्तम और शेष रहनेवाली है"
  },
  {
    "surah_id": 87,
    "ayah_number": 18,
    "global_ayah_id": 5966,
    "translation": "निस्संदेह यही बात पहले की किताबों में भी है;"
  },
  {
    "surah_id": 87,
    "ayah_number": 19,
    "global_ayah_id": 5967,
    "translation": "इबराईम और मूसा की किताबों में"
  }
]