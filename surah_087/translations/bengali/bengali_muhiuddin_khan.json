[
  {
    "surah_id": 87,
    "ayah_number": 1,
    "global_ayah_id": 5949,
    "translation": "আপনি আপনার মহান পালনকর্তার নামের পবিত্রতা বর্ণনা করুন"
  },
  {
    "surah_id": 87,
    "ayah_number": 2,
    "global_ayah_id": 5950,
    "translation": "যিনি সৃষ্টি করেছেন ও সুবিন্যস্ত করেছেন।"
  },
  {
    "surah_id": 87,
    "ayah_number": 3,
    "global_ayah_id": 5951,
    "translation": "এবং যিনি সুপরিমিত করেছেন ও পথ প্রদর্শন করেছেন"
  },
  {
    "surah_id": 87,
    "ayah_number": 4,
    "global_ayah_id": 5952,
    "translation": "এবং যিনি তৃণাদি উৎপন্ন করেছেন,"
  },
  {
    "surah_id": 87,
    "ayah_number": 5,
    "global_ayah_id": 5953,
    "translation": "অতঃপর করেছেন তাকে কাল আবর্জনা।"
  },
  {
    "surah_id": 87,
    "ayah_number": 6,
    "global_ayah_id": 5954,
    "translation": "আমি আপনাকে পাঠ করাতে থাকব, ফলে আপনি বিস্মৃত হবেন না"
  },
  {
    "surah_id": 87,
    "ayah_number": 7,
    "global_ayah_id": 5955,
    "translation": "আল্লাহ যা ইচ্ছা করেন তা ব্যতীত। নিশ্চয় তিনি জানেন প্রকাশ্য ও গোপন বিষয়।"
  },
  {
    "surah_id": 87,
    "ayah_number": 8,
    "global_ayah_id": 5956,
    "translation": "আমি আপনার জন্যে সহজ শরীয়ত সহজতর করে দেবো।"
  },
  {
    "surah_id": 87,
    "ayah_number": 9,
    "global_ayah_id": 5957,
    "translation": "উপদেশ ফলপ্রসূ হলে উপদেশ দান করুন,"
  },
  {
    "surah_id": 87,
    "ayah_number": 10,
    "global_ayah_id": 5958,
    "translation": "যে ভয় করে, সে উপদেশ গ্রহণ করবে,"
  },
  {
    "surah_id": 87,
    "ayah_number": 11,
    "global_ayah_id": 5959,
    "translation": "আর যে, হতভাগা, সে তা উপেক্ষা করবে,"
  },
  {
    "surah_id": 87,
    "ayah_number": 12,
    "global_ayah_id": 5960,
    "translation": "সে মহা-অগ্নিতে প্রবেশ করবে।"
  },
  {
    "surah_id": 87,
    "ayah_number": 13,
    "global_ayah_id": 5961,
    "translation": "অতঃপর সেখানে সে মরবেও না, জীবিতও থাকবে না।"
  },
  {
    "surah_id": 87,
    "ayah_number": 14,
    "global_ayah_id": 5962,
    "translation": "নিশ্চয় সাফল্য লাভ করবে সে, যে শুদ্ধ হয়"
  },
  {
    "surah_id": 87,
    "ayah_number": 15,
    "global_ayah_id": 5963,
    "translation": "এবং তার পালনকর্তার নাম স্মরণ করে, অতঃপর নামায আদায় করে।"
  },
  {
    "surah_id": 87,
    "ayah_number": 16,
    "global_ayah_id": 5964,
    "translation": "বস্তুতঃ তোমরা পার্থিব জীবনকে অগ্রাধিকার দাও,"
  },
  {
    "surah_id": 87,
    "ayah_number": 17,
    "global_ayah_id": 5965,
    "translation": "অথচ পরকালের জীবন উৎকৃষ্ট ও স্থায়ী।"
  },
  {
    "surah_id": 87,
    "ayah_number": 18,
    "global_ayah_id": 5966,
    "translation": "এটা লিখিত রয়েছে পূর্ববতী কিতাবসমূহে;"
  },
  {
    "surah_id": 87,
    "ayah_number": 19,
    "global_ayah_id": 5967,
    "translation": "ইব্রাহীম ও মূসার কিতাবসমূহে।"
  }
]