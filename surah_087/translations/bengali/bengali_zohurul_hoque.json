[
  {
    "surah_id": 87,
    "ayah_number": 1,
    "global_ayah_id": 5949,
    "translation": "মহিমা ঘোষণা করো তোমার সর্বোন্নত প্রভুর নামের, --"
  },
  {
    "surah_id": 87,
    "ayah_number": 2,
    "global_ayah_id": 5950,
    "translation": "যিনি সৃষ্টি করেন, তারপর সুঠাম করেন,"
  },
  {
    "surah_id": 87,
    "ayah_number": 3,
    "global_ayah_id": 5951,
    "translation": "আর যিনি সুসমঞ্জস করেন, তারপর পথ দেখিয়ে নেন,"
  },
  {
    "surah_id": 87,
    "ayah_number": 4,
    "global_ayah_id": 5952,
    "translation": "আর যিনি তৃণলতা উদ্‌গত করেন,"
  },
  {
    "surah_id": 87,
    "ayah_number": 5,
    "global_ayah_id": 5953,
    "translation": "তারপর তাকে শুকিয়ে পাঁশুটে বানিয়ে ফেলেন।"
  },
  {
    "surah_id": 87,
    "ayah_number": 6,
    "global_ayah_id": 5954,
    "translation": "আমরা যথাশীঘ্র তোমাকে পড়াবো, ফলে তুমি ভুলবে না, --"
  },
  {
    "surah_id": 87,
    "ayah_number": 7,
    "global_ayah_id": 5955,
    "translation": "শুধু যা-কিছু আল্লাহ্ ইচ্ছা করেন তা ব্যতীত। নিশ্চয় তিনি জানেন প্রকাশ্য এবং যা গুপ্ত রয়েছে।"
  },
  {
    "surah_id": 87,
    "ayah_number": 8,
    "global_ayah_id": 5956,
    "translation": "আর আমরা তোমার জন্য সহজ করে দেব সহজকরনের জন্য।"
  },
  {
    "surah_id": 87,
    "ayah_number": 9,
    "global_ayah_id": 5957,
    "translation": "অতএব তুমি স্মরণ করিয়ে চলোচ নিশ্চয় স্মরণ করানোতে সুফল রয়েছে।"
  },
  {
    "surah_id": 87,
    "ayah_number": 10,
    "global_ayah_id": 5958,
    "translation": "যে ভয় করে সে যথাসত্বর উপদেশ গ্রহণ করবে,"
  },
  {
    "surah_id": 87,
    "ayah_number": 11,
    "global_ayah_id": 5959,
    "translation": "কিন্ত এটি এড়িয়ে চলবে নেহাত দুশ্চরিত্র, --"
  },
  {
    "surah_id": 87,
    "ayah_number": 12,
    "global_ayah_id": 5960,
    "translation": "যে বিরাট আগুনে ঢোকে পড়বে,"
  },
  {
    "surah_id": 87,
    "ayah_number": 13,
    "global_ayah_id": 5961,
    "translation": "তখন সে সেখানে মরবে না, আর বাঁচবেও না।"
  },
  {
    "surah_id": 87,
    "ayah_number": 14,
    "global_ayah_id": 5962,
    "translation": "সে-ই যথার্থ সফলকাম হবে যে নিজেকে পবিত্র করেছে,"
  },
  {
    "surah_id": 87,
    "ayah_number": 15,
    "global_ayah_id": 5963,
    "translation": "এবং তার প্রভুর নাম স্মরণ করে, আর নামায পড়ে।"
  },
  {
    "surah_id": 87,
    "ayah_number": 16,
    "global_ayah_id": 5964,
    "translation": "না, তোমরা দুনিয়ার জীবনকে প্রাধান্য দাও,"
  },
  {
    "surah_id": 87,
    "ayah_number": 17,
    "global_ayah_id": 5965,
    "translation": "অথচ পরকালই বেশি ভাল ও দীর্ঘস্থায়ী।"
  },
  {
    "surah_id": 87,
    "ayah_number": 18,
    "global_ayah_id": 5966,
    "translation": "নিঃসন্দেহ এইসব আছে পূর্ববর্তী ধর্মগ্রন্থে --"
  },
  {
    "surah_id": 87,
    "ayah_number": 19,
    "global_ayah_id": 5967,
    "translation": "ইব্রাহীম ও মূসার ধর্মগ্রন্থে।"
  }
]