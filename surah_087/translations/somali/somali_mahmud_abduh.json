[
  {
    "surah_id": 87,
    "ayah_number": 1,
    "global_ayah_id": 5949,
    "translation": "Waynee Magaca Eebe ee Sarreeya."
  },
  {
    "surah_id": 87,
    "ayah_number": 2,
    "global_ayah_id": 5950,
    "translation": "Eebaha abuuray khalqiga ekeeyayna."
  },
  {
    "surah_id": 87,
    "ayah_number": 3,
    "global_ayah_id": 5951,
    "translation": "Eebaha wax walba qaddaray Jidkana tusiyey."
  },
  {
    "surah_id": 87,
    "ayah_number": 4,
    "global_ayah_id": 5952,
    "translation": "Eebaha soo bixiya Daaqa."
  },
  {
    "surah_id": 87,
    "ayah_number": 5,
    "global_ayah_id": 5953,
    "translation": "Kana dhiga markaas ka dib caws ingagagan oo Madow."
  },
  {
    "surah_id": 87,
    "ayah_number": 6,
    "global_ayah_id": 5954,
    "translation": "Waxaan kuu akhriyaynaa Quraanka halmaaminamaysid."
  },
  {
    "surah_id": 87,
    "ayah_number": 7,
    "global_ayah_id": 5955,
    "translation": "Wuxuu Eebe doono mooyee, Eebana waa ogyahay waxa muuqda iyo waxa qarsoonba."
  },
  {
    "surah_id": 87,
    "ayah_number": 8,
    "global_ayah_id": 5956,
    "translation": "Waxaana kuu fududaynhaynaa Waddo fiican."
  },
  {
    "surah_id": 87,
    "ayah_number": 9,
    "global_ayah_id": 5957,
    "translation": "Ee wax waani (Nabiyow) markay wax tari waanadu."
  },
  {
    "surah_id": 87,
    "ayah_number": 10,
    "global_ayah_id": 5958,
    "translation": "Waxaa waantoobi Ruuxa Eebe ka yaabee."
  },
  {
    "surah_id": 87,
    "ayah_number": 11,
    "global_ayah_id": 5959,
    "translation": "Waxaana ka fogaan waanada Ruuxa xune."
  },
  {
    "surah_id": 87,
    "ayah_number": 12,
    "global_ayah_id": 5960,
    "translation": "Ee ah mid gali Naar wayn."
  },
  {
    "surah_id": 87,
    "ayah_number": 13,
    "global_ayah_id": 5961,
    "translation": "Oon kuna dhimanayn dhexdeeda kuna noolanayn."
  },
  {
    "surah_id": 87,
    "ayah_number": 14,
    "global_ayah_id": 5962,
    "translation": "Waxaana liibaanay Ruuxii Daahir noqda."
  },
  {
    "surah_id": 87,
    "ayah_number": 15,
    "global_ayah_id": 5963,
    "translation": "magaca Eebana Xusa, Salaaddana tukada."
  },
  {
    "surah_id": 87,
    "ayah_number": 16,
    "global_ayah_id": 5964,
    "translation": "Saas ma'aha ee Dadku wuxuu doortay nolosha Adduunyo ee dhaw."
  },
  {
    "surah_id": 87,
    "ayah_number": 17,
    "global_ayah_id": 5965,
    "translation": "Aakhiraase khayr badan baaqina ah (hadhi)."
  },
  {
    "surah_id": 87,
    "ayah_number": 18,
    "global_ayah_id": 5966,
    "translation": "Arrintaasuna waxay ku sugantahay Kutubtii hore."
  },
  {
    "surah_id": 87,
    "ayah_number": 19,
    "global_ayah_id": 5967,
    "translation": "Kutubtii (Nabi) Ibraahim iyo (Nabi) Muuse."
  }
]