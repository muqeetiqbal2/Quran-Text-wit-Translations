[
  {
    "surah_id": 87,
    "ayah_number": 1,
    "global_ayah_id": 5949,
    "translation": "نام پروردگار بلندمرتبه‌ات را به پاکی یاد کن!"
  },
  {
    "surah_id": 87,
    "ayah_number": 2,
    "global_ayah_id": 5950,
    "translation": "همان که آفرید و سامان بخشید."
  },
  {
    "surah_id": 87,
    "ayah_number": 3,
    "global_ayah_id": 5951,
    "translation": "و آن که [هر چیز را] اندازه نهاد و هدایت کرد."
  },
  {
    "surah_id": 87,
    "ayah_number": 4,
    "global_ayah_id": 5952,
    "translation": "و آن که چراگاه را رویانید."
  },
  {
    "surah_id": 87,
    "ayah_number": 5,
    "global_ayah_id": 5953,
    "translation": "و پس [از چندی] آن را خشک و تیره کرد."
  },
  {
    "surah_id": 87,
    "ayah_number": 6,
    "global_ayah_id": 5954,
    "translation": "ما [قرآن را] بر تو می‌خوانیم، پس فراموش نخواهی کرد."
  },
  {
    "surah_id": 87,
    "ayah_number": 7,
    "global_ayah_id": 5955,
    "translation": "مگر آنچه را خدا بخواهد که او بی‌گمان آشکار و نهان را می‌داند."
  },
  {
    "surah_id": 87,
    "ayah_number": 8,
    "global_ayah_id": 5956,
    "translation": "و ما تو را برای آسان‌ترین [راه دعوت] آماده می‌سازیم."
  },
  {
    "surah_id": 87,
    "ayah_number": 9,
    "global_ayah_id": 5957,
    "translation": "پس پند بده، اگر پند دادن سودمند باشد."
  },
  {
    "surah_id": 87,
    "ayah_number": 10,
    "global_ayah_id": 5958,
    "translation": "به زودی آن که [از خدا] می‌ترسد، پند گیرد."
  },
  {
    "surah_id": 87,
    "ayah_number": 11,
    "global_ayah_id": 5959,
    "translation": "و بدبخت‌ترینِ افراد از آن دوری کند."
  },
  {
    "surah_id": 87,
    "ayah_number": 12,
    "global_ayah_id": 5960,
    "translation": "همان کس که به آتش بزرگ‌تر درمی‌آید."
  },
  {
    "surah_id": 87,
    "ayah_number": 13,
    "global_ayah_id": 5961,
    "translation": "سپس در آنجا نه بمیرد و نه زندگی کند."
  },
  {
    "surah_id": 87,
    "ayah_number": 14,
    "global_ayah_id": 5962,
    "translation": "به راستی رستگار شد آن کس که خود را پاک گردانید."
  },
  {
    "surah_id": 87,
    "ayah_number": 15,
    "global_ayah_id": 5963,
    "translation": "و نام پروردگارش را یاد کرد و نماز گزارد."
  },
  {
    "surah_id": 87,
    "ayah_number": 16,
    "global_ayah_id": 5964,
    "translation": "[بلکه شما منکران لجوج] زندگی دنیا را ترجیح می‌دهید."
  },
  {
    "surah_id": 87,
    "ayah_number": 17,
    "global_ayah_id": 5965,
    "translation": "و حال آن که آخرت بهتر و ماندگارتر است."
  },
  {
    "surah_id": 87,
    "ayah_number": 18,
    "global_ayah_id": 5966,
    "translation": "این [سخن] در کتاب‌های آسمانی پیشین نیزآمده است،"
  },
  {
    "surah_id": 87,
    "ayah_number": 19,
    "global_ayah_id": 5967,
    "translation": "کتاب‌های ابراهیم و موسی."
  }
]