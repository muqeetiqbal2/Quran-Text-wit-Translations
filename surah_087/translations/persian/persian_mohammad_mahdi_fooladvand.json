[
  {
    "surah_id": 87,
    "ayah_number": 1,
    "global_ayah_id": 5949,
    "translation": "نام پروردگار والاى خود را به پاكى بستاى:"
  },
  {
    "surah_id": 87,
    "ayah_number": 2,
    "global_ayah_id": 5950,
    "translation": "همان كه آفريد و هماهنگى بخشيد."
  },
  {
    "surah_id": 87,
    "ayah_number": 3,
    "global_ayah_id": 5951,
    "translation": "و آنكه اندازه‌گيرى كرد و راه نمود."
  },
  {
    "surah_id": 87,
    "ayah_number": 4,
    "global_ayah_id": 5952,
    "translation": "و آنكه چمنزار را برآورد؛"
  },
  {
    "surah_id": 87,
    "ayah_number": 5,
    "global_ayah_id": 5953,
    "translation": "و پس [از چندى‌] آن را خاشاكى تيره‌گون گردانيد."
  },
  {
    "surah_id": 87,
    "ayah_number": 6,
    "global_ayah_id": 5954,
    "translation": "ما بزودى [آيات خود را به وسيله سروش غيبى‌] بر تو خواهيم خواند، تا فراموش نكنى؛"
  },
  {
    "surah_id": 87,
    "ayah_number": 7,
    "global_ayah_id": 5955,
    "translation": "جز آنچه خدا خواهد، كه او آشكار و آنچه را كه نهان است مى‌داند."
  },
  {
    "surah_id": 87,
    "ayah_number": 8,
    "global_ayah_id": 5956,
    "translation": "و براى تو آسانترين [راه‌] را فراهم مى‌گردانيم."
  },
  {
    "surah_id": 87,
    "ayah_number": 9,
    "global_ayah_id": 5957,
    "translation": "پس پند ده، اگر پند سود بخشد."
  },
  {
    "surah_id": 87,
    "ayah_number": 10,
    "global_ayah_id": 5958,
    "translation": "آن كس كه ترسد، بزودى عبرت گيرد."
  },
  {
    "surah_id": 87,
    "ayah_number": 11,
    "global_ayah_id": 5959,
    "translation": "و نگون‌بخت، خود را از آن دور مى‌دارد؛"
  },
  {
    "surah_id": 87,
    "ayah_number": 12,
    "global_ayah_id": 5960,
    "translation": "همان كس كه در آتشى بزرگ در آيد؛"
  },
  {
    "surah_id": 87,
    "ayah_number": 13,
    "global_ayah_id": 5961,
    "translation": "آنگاه نه در آن مى‌ميرد و نه زندگانى مى‌يابد."
  },
  {
    "surah_id": 87,
    "ayah_number": 14,
    "global_ayah_id": 5962,
    "translation": "رستگار آن كس كه خود را پاك گردانيد؛"
  },
  {
    "surah_id": 87,
    "ayah_number": 15,
    "global_ayah_id": 5963,
    "translation": "و نام پروردگارش را ياد كرد و نماز گزارد."
  },
  {
    "surah_id": 87,
    "ayah_number": 16,
    "global_ayah_id": 5964,
    "translation": "ليكن [شما] زندگى دنيا را بر مى‌گزينيد؛"
  },
  {
    "surah_id": 87,
    "ayah_number": 17,
    "global_ayah_id": 5965,
    "translation": "با آنكه [جهان‌] آخرت نيكوتر و پايدارتر است."
  },
  {
    "surah_id": 87,
    "ayah_number": 18,
    "global_ayah_id": 5966,
    "translation": "قطعاً در صحيفه‌هاى گذشته اين [معنى‌] هست،"
  },
  {
    "surah_id": 87,
    "ayah_number": 19,
    "global_ayah_id": 5967,
    "translation": "صحيفه‌هاى ابراهيم و موسى."
  }
]