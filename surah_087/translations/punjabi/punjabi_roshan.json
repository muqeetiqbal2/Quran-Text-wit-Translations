[
  {
    "surah_id": 87,
    "ayah_number": 0,
    "global_ayah_id": 6034,
    "translation": "اللہ دے ناں نال ( شروع ) جیہڑا حدوں مہربان ، بوہت رحم والا اے ۔"
  },
  {
    "surah_id": 87,
    "ayah_number": 1,
    "global_ayah_id": 6035,
    "translation": "اپنے سب توں اُچے رب دے ناں دی پاکی بول"
  },
  {
    "surah_id": 87,
    "ayah_number": 2,
    "global_ayah_id": 6036,
    "translation": "اوہ ( ہستی ) جیس ( انسان نوں ) بنایا فیر ٹھیک کیتا"
  },
  {
    "surah_id": 87,
    "ayah_number": 3,
    "global_ayah_id": 6037,
    "translation": "تے اوہ جنھے اندازہ لایا فیر ہدایت دتی"
  },
  {
    "surah_id": 87,
    "ayah_number": 4,
    "global_ayah_id": 6038,
    "translation": "تے اوہ جنھے سبزہ اگایا"
  },
  {
    "surah_id": 87,
    "ayah_number": 5,
    "global_ayah_id": 6039,
    "translation": "فیر اوہنے اوہنوں کالا سُکا کوڑا کر دتا"
  },
  {
    "surah_id": 87,
    "ayah_number": 6,
    "global_ayah_id": 6040,
    "translation": "اسیں لازمی تینوں پڑھاواں گے ، فیر تسی نہ بُھلو گے"
  },
  {
    "surah_id": 87,
    "ayah_number": 7,
    "global_ayah_id": 6041,
    "translation": "پر جو اللہ چاہے بیشک اوہ ظاہر گل نوں وی جان دا اے تے چھپی نوں وی"
  },
  {
    "surah_id": 87,
    "ayah_number": 8,
    "global_ayah_id": 6042,
    "translation": "تے اسیں تہانوں آسان راہ دی توفیق دیاں گے"
  },
  {
    "surah_id": 87,
    "ayah_number": 9,
    "global_ayah_id": 6043,
    "translation": "سو نصیحت کرو جے نصیحت فیدہ دیوے"
  },
  {
    "surah_id": 87,
    "ayah_number": 10,
    "global_ayah_id": 6044,
    "translation": "جیہڑا ڈردا اے اوہ چھیتی نصیحت دا اثر لوے گا"
  },
  {
    "surah_id": 87,
    "ayah_number": 11,
    "global_ayah_id": 6045,
    "translation": "تے وڈا بدبخت ایہدے توں لامبھے رہوے گا"
  },
  {
    "surah_id": 87,
    "ayah_number": 12,
    "global_ayah_id": 6046,
    "translation": "جیہڑا سب توں وڈی اگ وچ سڑے گا"
  },
  {
    "surah_id": 87,
    "ayah_number": 13,
    "global_ayah_id": 6047,
    "translation": "مڑ کے اوہدے وچ نہ اوہ مرے گا تے نہ جیوے گا"
  },
  {
    "surah_id": 87,
    "ayah_number": 14,
    "global_ayah_id": 6048,
    "translation": "بلاشبہ مراد پا گیا جیہڑا پاک ہویا"
  },
  {
    "surah_id": 87,
    "ayah_number": 15,
    "global_ayah_id": 6049,
    "translation": "تے یاد کیتا اپنے رب دا ناں فیر اوس نماز پڑھی"
  },
  {
    "surah_id": 87,
    "ayah_number": 16,
    "global_ayah_id": 6050,
    "translation": "سگوں تسی دنیا دی حیاتی نوں اگے رکھدے او"
  },
  {
    "surah_id": 87,
    "ayah_number": 17,
    "global_ayah_id": 6051,
    "translation": "حالاں آخرت کِتے بہتر تے بوہتا باقی رہن والی اے"
  },
  {
    "surah_id": 87,
    "ayah_number": 18,
    "global_ayah_id": 6052,
    "translation": "بیشک ایہہ ( گل ) ضرور پہلیاں صحیفیاں وچ وی اے"
  },
  {
    "surah_id": 87,
    "ayah_number": 19,
    "global_ayah_id": 6053,
    "translation": "ابراہیم تے موسیٰ دے صحیفیاں وچ"
  }
]