[
  {
    "surah_id": 87,
    "ayah_number": 1,
    "global_ayah_id": 5949,
    "translation": "가장 위에 계시는 주님의 이름을 찬미하라"
  },
  {
    "surah_id": 87,
    "ayah_number": 2,
    "global_ayah_id": 5950,
    "translation": "그분은 인간을 창조하사 가장아름다운 형상으로 지으셨으며"
  },
  {
    "surah_id": 87,
    "ayah_number": 3,
    "global_ayah_id": 5951,
    "translation": "모든 것에 특징을 두사 그것 으로 유용케 하였으며"
  },
  {
    "surah_id": 87,
    "ayah_number": 4,
    "global_ayah_id": 5952,
    "translation": "그분은 목초를 생성케 하시고"
  },
  {
    "surah_id": 87,
    "ayah_number": 5,
    "global_ayah_id": 5953,
    "translation": "그것을 갈색의 마른 풀로 하 시도다"
  },
  {
    "surah_id": 87,
    "ayah_number": 6,
    "global_ayah_id": 5954,
    "translation": "하나님이 그대에게 말씀을 계시하니 암기하여 잊지 말라"
  },
  {
    "surah_id": 87,
    "ayah_number": 7,
    "global_ayah_id": 5955,
    "translation": "그러나 하나님이 원하는 것은제외라 실로 그분은 있는 것과 숨겨진 모든 것을 알고 계시니라"
  },
  {
    "surah_id": 87,
    "ayah_number": 8,
    "global_ayah_id": 5956,
    "translation": "하나님은 그것이 그대에게 쉽도록 하여 주었으니"
  },
  {
    "surah_id": 87,
    "ayah_number": 9,
    "global_ayah_id": 5957,
    "translation": "그 교훈을 전달하여 듣는 자 들에게 유익하도록 하라"
  },
  {
    "surah_id": 87,
    "ayah_number": 10,
    "global_ayah_id": 5958,
    "translation": "하나님을 두려워 하는 자들 은 그 교훈을 받아들일 것이며"
  },
  {
    "surah_id": 87,
    "ayah_number": 11,
    "global_ayah_id": 5959,
    "translation": "불행한 불신자들은 그것을 회피하니"
  },
  {
    "surah_id": 87,
    "ayah_number": 12,
    "global_ayah_id": 5960,
    "translation": "큰 불지옥으로 들어가"
  },
  {
    "surah_id": 87,
    "ayah_number": 13,
    "global_ayah_id": 5961,
    "translation": "그곳에서 죽지도 아니하고 살지도 못하리라"
  },
  {
    "surah_id": 87,
    "ayah_number": 14,
    "global_ayah_id": 5962,
    "translation": "그러나 스스로를 청결케 한 자 번성하리니"
  },
  {
    "surah_id": 87,
    "ayah_number": 15,
    "global_ayah_id": 5963,
    "translation": "주님의 이름을 찬미하고 기 도하라"
  },
  {
    "surah_id": 87,
    "ayah_number": 16,
    "global_ayah_id": 5964,
    "translation": "그래도 너희가 현세의 삶을 좋아하나"
  },
  {
    "surah_id": 87,
    "ayah_number": 17,
    "global_ayah_id": 5965,
    "translation": "내세가 더 좋으며 영원하니 라"
  },
  {
    "surah_id": 87,
    "ayah_number": 18,
    "global_ayah_id": 5966,
    "translation": "실로 이것은 옛 성서에도 계 시되어 있으며"
  },
  {
    "surah_id": 87,
    "ayah_number": 19,
    "global_ayah_id": 5967,
    "translation": "아브라함과 모세의 성서에도그러하니라"
  }
]