[
  {
    "surah_id": 87,
    "ayah_number": 1,
    "global_ayah_id": 5949,
    "translation": "Олий қадар бўлган Роббинг исмини поклаб ёд эт."
  },
  {
    "surah_id": 87,
    "ayah_number": 2,
    "global_ayah_id": 5950,
    "translation": "У яратган ва мутаносиб қилган зотдир."
  },
  {
    "surah_id": 87,
    "ayah_number": 3,
    "global_ayah_id": 5951,
    "translation": "У ўлчовли қилган ва ҳидоятга бошлаган зотдир."
  },
  {
    "surah_id": 87,
    "ayah_number": 4,
    "global_ayah_id": 5952,
    "translation": "У ўт-ўланни чиқарган зотдир."
  },
  {
    "surah_id": 87,
    "ayah_number": 5,
    "global_ayah_id": 5953,
    "translation": "Бас, У уни қорайган хашак қилган зотдир."
  },
  {
    "surah_id": 87,
    "ayah_number": 6,
    "global_ayah_id": 5954,
    "translation": "Биз сенга қироат қилдирамиз, бас, эсдан чиқармайссан."
  },
  {
    "surah_id": 87,
    "ayah_number": 7,
    "global_ayah_id": 5955,
    "translation": "Магар Аллоҳ хоҳлаганини. Албатта, У ошкорни ҳам, махфий нарсани ҳам биладир."
  },
  {
    "surah_id": 87,
    "ayah_number": 8,
    "global_ayah_id": 5956,
    "translation": "Ва сени осон йўлга муяссар қилармиз."
  },
  {
    "surah_id": 87,
    "ayah_number": 9,
    "global_ayah_id": 5957,
    "translation": "Бас, агар эслатиш манфаат берса, эслатгин."
  },
  {
    "surah_id": 87,
    "ayah_number": 10,
    "global_ayah_id": 5958,
    "translation": "Албатта, қўрққан эсга оладир."
  },
  {
    "surah_id": 87,
    "ayah_number": 11,
    "global_ayah_id": 5959,
    "translation": "Ва бадбахт ундан четда бўладир."
  },
  {
    "surah_id": 87,
    "ayah_number": 12,
    "global_ayah_id": 5960,
    "translation": "У катта оловга кирадир."
  },
  {
    "surah_id": 87,
    "ayah_number": 13,
    "global_ayah_id": 5961,
    "translation": "Сўнгра унинг ичида ўлмай ҳам, тирилмай ҳам қоладир."
  },
  {
    "surah_id": 87,
    "ayah_number": 14,
    "global_ayah_id": 5962,
    "translation": "Батаҳқиқ, ким пок бўлса, ютуқ топадир."
  },
  {
    "surah_id": 87,
    "ayah_number": 15,
    "global_ayah_id": 5963,
    "translation": "Ва Роббиси исмини зикр қилса ва намоз ўқиса ҳамдир."
  },
  {
    "surah_id": 87,
    "ayah_number": 16,
    "global_ayah_id": 5964,
    "translation": "Лекин, сизлар дунё ҳаётини устун қўясизлар."
  },
  {
    "surah_id": 87,
    "ayah_number": 17,
    "global_ayah_id": 5965,
    "translation": "Ҳолбуки, охират яхшироқ ва боқийроқдир."
  },
  {
    "surah_id": 87,
    "ayah_number": 18,
    "global_ayah_id": 5966,
    "translation": "Албатта, бу аввалги саҳифаларда бордир."
  },
  {
    "surah_id": 87,
    "ayah_number": 19,
    "global_ayah_id": 5967,
    "translation": "Иброҳим ва Мусо саҳифаларидадир."
  }
]