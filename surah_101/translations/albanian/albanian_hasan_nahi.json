[
  {
    "surah_id": 101,
    "ayah_number": 1,
    "global_ayah_id": 6158,
    "translation": "Goditja e tmerrshme (Kijameti)!"
  },
  {
    "surah_id": 101,
    "ayah_number": 2,
    "global_ayah_id": 6159,
    "translation": "Ç’është Goditja e tmerrshme!"
  },
  {
    "surah_id": 101,
    "ayah_number": 3,
    "global_ayah_id": 6160,
    "translation": "Kush të tregon ty për Goditjen e tmerrshme?"
  },
  {
    "surah_id": 101,
    "ayah_number": 4,
    "global_ayah_id": 6161,
    "translation": "Njerëzit, atë Ditë do të jenë të shpërndarë si fluturat,"
  },
  {
    "surah_id": 101,
    "ayah_number": 5,
    "global_ayah_id": 6162,
    "translation": "kurse malet – si leshi i shprishur."
  },
  {
    "surah_id": 101,
    "ayah_number": 6,
    "global_ayah_id": 6163,
    "translation": "Atij (njeriut), veprat e mira të të cilit rëndojnë në peshojë"
  },
  {
    "surah_id": 101,
    "ayah_number": 7,
    "global_ayah_id": 6164,
    "translation": "ai do të jetë në jetën e kënaqur (në jetën e përhershme),"
  },
  {
    "surah_id": 101,
    "ayah_number": 8,
    "global_ayah_id": 6165,
    "translation": "e atij (njeriu), veprat e mira të të cilit nuk rëndojnë në peshojë,"
  },
  {
    "surah_id": 101,
    "ayah_number": 9,
    "global_ayah_id": 6166,
    "translation": "strehimi i tij do të jetë gremina e Skëterrës."
  },
  {
    "surah_id": 101,
    "ayah_number": 10,
    "global_ayah_id": 6167,
    "translation": "E, kush të tregon ty se ç’është gremina e Skëterrës?"
  },
  {
    "surah_id": 101,
    "ayah_number": 11,
    "global_ayah_id": 6168,
    "translation": "(Ajo është) zjarr i vrullshëm."
  }
]