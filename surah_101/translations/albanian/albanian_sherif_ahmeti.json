[
  {
    "surah_id": 101,
    "ayah_number": 1,
    "global_ayah_id": 6158,
    "translation": "Krisma e kijametit."
  },
  {
    "surah_id": 101,
    "ayah_number": 2,
    "global_ayah_id": 6159,
    "translation": "Ç'ka është krisma?"
  },
  {
    "surah_id": 101,
    "ayah_number": 3,
    "global_ayah_id": 6160,
    "translation": "Dhe ç’të mësoi ty se ç’është krisma?"
  },
  {
    "surah_id": 101,
    "ayah_number": 4,
    "global_ayah_id": 6161,
    "translation": "Ajo është ditë kur njerëzit bëhen si insekte të shpërndara."
  },
  {
    "surah_id": 101,
    "ayah_number": 5,
    "global_ayah_id": 6162,
    "translation": "Dhe kodrat bëhen si leshi i shprishur."
  },
  {
    "surah_id": 101,
    "ayah_number": 6,
    "global_ayah_id": 6163,
    "translation": "E sa i përket atij që i rëndohet peshoja e veprave të tij,"
  },
  {
    "surah_id": 101,
    "ayah_number": 7,
    "global_ayah_id": 6164,
    "translation": "Ai është në një jetë të këndshme."
  },
  {
    "surah_id": 101,
    "ayah_number": 8,
    "global_ayah_id": 6165,
    "translation": "Ndërsa, atij që ka peshojën e lehtë të veprave të tij,"
  },
  {
    "surah_id": 101,
    "ayah_number": 9,
    "global_ayah_id": 6166,
    "translation": "Vendi i tij do të jetë në Havije."
  },
  {
    "surah_id": 101,
    "ayah_number": 10,
    "global_ayah_id": 6167,
    "translation": "E ç’është ajo që të njoftoi ç’është ai (Havije)?"
  },
  {
    "surah_id": 101,
    "ayah_number": 11,
    "global_ayah_id": 6168,
    "translation": "Është zjarri me nxehtësi shumë të lartë."
  }
]