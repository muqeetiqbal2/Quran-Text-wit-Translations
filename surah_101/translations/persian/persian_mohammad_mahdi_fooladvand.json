    "global_ayah_id": 6158,
    "translation": "كوبنده،"
  },
  {
    "surah_id": 101,
    "ayah_number": 2,
    "global_ayah_id": 6159,
    "translation": "چيست كوبنده؟"
  },
  {
    "surah_id": 101,
    "ayah_number": 3,
    "global_ayah_id": 6160,
    "translation": "و تو چه دانى كه كوبنده چيست؟"
  },
  {
    "surah_id": 101,
    "ayah_number": 4,
    "global_ayah_id": 6161,
    "translation": "روزى كه مردم چون پروانه‌[هاى‌] پراكنده گردند،"
  },
  {
    "surah_id": 101,
    "ayah_number": 5,
    "global_ayah_id": 6162,
    "translation": "و كوه‌ها مانند پشم زده‌شده رنگين شود."
  },
  {
    "surah_id": 101,
    "ayah_number": 6,
    "global_ayah_id": 6163,
    "translation": "اما هر كه سنجيده‌هايش سنگين برآيد،"
  },
  {
    "surah_id": 101,
    "ayah_number": 7,
    "global_ayah_id": 6164,
    "translation": "پس وى در زندگى خوشى خواهد بود!"
  },
  {
    "surah_id": 101,
    "ayah_number": 8,
    "global_ayah_id": 6165,
    "translation": "و اما هر كه سنجيده‌هايش سبك بر آيد،"
  },
  {
    "surah_id": 101,
    "ayah_number": 9,
    "global_ayah_id": 6166,
    "translation": "پس جايش «هاويه» باشد."
  },
  {
    "surah_id": 101,
    "ayah_number": 10,
    "global_ayah_id": 6167,
    "translation": "و تو چه دانى كه آن چيست؟"
  },
  {
    "surah_id": 101,
    "ayah_number": 11,
    "global_ayah_id": 6168,
    "translation": "آتشى است سوزنده."
  }
]