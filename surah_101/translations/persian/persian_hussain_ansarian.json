    "ayah_number": 1,
    "global_ayah_id": 6158,
    "translation": "آن کوبنده"
  },
  {
    "surah_id": 101,
    "ayah_number": 2,
    "global_ayah_id": 6159,
    "translation": "چیست آن کوبنده؟"
  },
  {
    "surah_id": 101,
    "ayah_number": 3,
    "global_ayah_id": 6160,
    "translation": "و تو چه می دانی آن کوبنده چیست؟"
  },
  {
    "surah_id": 101,
    "ayah_number": 4,
    "global_ayah_id": 6161,
    "translation": "روزی که مردم [در سراسیمگی] چون پروانه های پراکنده اند"
  },
  {
    "surah_id": 101,
    "ayah_number": 5,
    "global_ayah_id": 6162,
    "translation": "و کوه ها مانند پشم رنگین حلاجی شده گردد!"
  },
  {
    "surah_id": 101,
    "ayah_number": 6,
    "global_ayah_id": 6163,
    "translation": "اما هرکس اعمال وزن شده اش سنگین و باارزش است؛"
  },
  {
    "surah_id": 101,
    "ayah_number": 7,
    "global_ayah_id": 6164,
    "translation": "پس او در یک زندگی خوش و پسندیده ای است،"
  },
  {
    "surah_id": 101,
    "ayah_number": 8,
    "global_ayah_id": 6165,
    "translation": "و اما هرکساعمال وزن شده اش سبک و بی ارزش است،"
  },
  {
    "surah_id": 101,
    "ayah_number": 9,
    "global_ayah_id": 6166,
    "translation": "پس جایگاه و پناهگاهش هاویه است،"
  },
  {
    "surah_id": 101,
    "ayah_number": 10,
    "global_ayah_id": 6167,
    "translation": "و تو چه می دانی هاویه چیست؟"
  },
  {
    "surah_id": 101,
    "ayah_number": 11,
    "global_ayah_id": 6168,
    "translation": "آتشی بسیار داغ و سوزاناست."
  }
]