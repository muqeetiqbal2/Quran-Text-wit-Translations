[
  {
    "surah_id": 101,
    "ayah_number": 1,
    "global_ayah_id": 6158,
    "translation": "[EN DAG skall ni höra] det dundrande slaget!"
  },
  {
    "surah_id": 101,
    "ayah_number": 2,
    "global_ayah_id": 6159,
    "translation": "Vad betyder det dundrande slaget"
  },
  {
    "surah_id": 101,
    "ayah_number": 3,
    "global_ayah_id": 6160,
    "translation": "Vad kan låta dig förstå vad detta dundrande slag betyder"
  },
  {
    "surah_id": 101,
    "ayah_number": 4,
    "global_ayah_id": 6161,
    "translation": "[Det skall dåna] en Dag då människorna myllrar och svärmar som mott och mal,"
  },
  {
    "surah_id": 101,
    "ayah_number": 5,
    "global_ayah_id": 6162,
    "translation": "och då bergen [förvandlas] till högar av kardad ull."
  },
  {
    "surah_id": 101,
    "ayah_number": 6,
    "global_ayah_id": 6163,
    "translation": "Då skall den vars vågskål [med goda handlingar] väger tungt"
  },
  {
    "surah_id": 101,
    "ayah_number": 7,
    "global_ayah_id": 6164,
    "translation": "gå till ett liv i lycksalighet,"
  },
  {
    "surah_id": 101,
    "ayah_number": 8,
    "global_ayah_id": 6165,
    "translation": "men den vars vågskål väger lätt"
  },
  {
    "surah_id": 101,
    "ayah_number": 9,
    "global_ayah_id": 6166,
    "translation": "skall se sig innesluten i en avgrund."
  },
  {
    "surah_id": 101,
    "ayah_number": 10,
    "global_ayah_id": 6167,
    "translation": "Och vad kan låta dig förstå vad denna [avgrund] betyder"
  },
  {
    "surah_id": 101,
    "ayah_number": 11,
    "global_ayah_id": 6168,
    "translation": "En [famn av] het eld!"
  }
]