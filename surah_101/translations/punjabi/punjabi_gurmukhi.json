[
  {
    "surah_id": 101,
    "ayah_number": 0,
    "global_ayah_id": 6257,
    "translation": "ਸ਼ੁਰੂ (ਕਰਦਾ ਹਾਂ) ਅੱਲਾਹ ਦੇ ਨਾਂ ਨਾਲ ਜਿਹੜਾ ਅਤਿਅੰਤ ਮਿਹਰਬਾਨ ਅਤੇ ਰਹਿਮ ਫ਼ਰਮਾਉਣ ਵਾਲਾ ਹੈ।"
  },
  {
    "surah_id": 101,
    "ayah_number": 1,
    "global_ayah_id": 6258,
    "translation": "ਖੜਖੜਾ ਦੇਣ ਵਾਲੀ (ਆਫ਼ਤ ਜ਼ਰੂਰ ਆਵੇਗੀ)।"
  },
  {
    "surah_id": 101,
    "ayah_number": 2,
    "global_ayah_id": 6259,
    "translation": "ਭਲਾ ਕੀ ਹੈ ਉਹ ਖੜਖੜਾ ਦੇਣ ਵਾਲੀ (ਘਟਨਾ)?"
  },
  {
    "surah_id": 101,
    "ayah_number": 3,
    "global_ayah_id": 6260,
    "translation": "ਅਤੇ ਤੁਸੀਂ ਕੀ ਜਾਣੋਂ ਕਿ ਉਹ ਖੜਖੜਾ ਦੇਣ ਵਾਲੀ (ਆਫ਼ਤ) ਕੀ ਹੈ?"
  },
  {
    "surah_id": 101,
    "ayah_number": 4,
    "global_ayah_id": 6261,
    "translation": "(ਇਹ ਉਹ ਦਿਨ ਹੈ) ਜਦੋਂ ਲੋਕੀ (ਐਵੇਂ) ਹੋ ਜਾਣਗੇ, ਜਿਵੇਂ ਖਿੱਲਰੇ ਹੋਏ ਭਮੱਕੜ।"
  },
  {
    "surah_id": 101,
    "ayah_number": 5,
    "global_ayah_id": 6262,
    "translation": "ਅਤੇ ਪਹਾੜ ਪਿੰਜੀ ਹੋਈ ਰੰਗ–ਬਰੰਗੀ ਉੱਨ ਵਾਂਗ ਹੋ ਜਾਣਗੇ।"
  },
  {
    "surah_id": 101,
    "ayah_number": 6,
    "global_ayah_id": 6263,
    "translation": "ਅਤੇ ਫੇਰ (ਉਸ ਦਿਨ) ਜਿਸ ਵਿਅਕਤੀ ਦਾ ਪਲੜਾ (ਨੇਕ ਅਮਲਾਂ ਨਾਲ) ਭਾਰੀ ਹੋਵੇਗਾ।"
  },
  {
    "surah_id": 101,
    "ayah_number": 7,
    "global_ayah_id": 6264,
    "translation": "ਉਹ (ਸਵਰਗ ਵਿੱਚ) ਆਪਣੀ ਮਨ ਭਾਉਂਦੀ ਜ਼ਿੰਦਗੀ ਵਿੱਚ ਹੋਵੇਗਾ।"
  },
  {
    "surah_id": 101,
    "ayah_number": 8,
    "global_ayah_id": 6265,
    "translation": "ਅਤੇ ਜਿਸ ਵਿਅਕਤੀ ਦੇ ਪਲੜੇ ਹਲਕੇ ਹੋਣਗੇ।"
  },
  {
    "surah_id": 101,
    "ayah_number": 9,
    "global_ayah_id": 6266,
    "translation": "ਤਾਂ ਉਸ ਦਾ ਟਿਕਾਣਾ ‘ਹਾਵੀਆ’ ਹੋਵੇਗਾ।"
  },
  {
    "surah_id": 101,
    "ayah_number": 10,
    "global_ayah_id": 6267,
    "translation": "ਅਤੇ ਤੁਹਾਨੂੰ ਕੀ ਖ਼ਬਰ ਕਿ ਇਹ (ਹਾਵੀਆ) ਕੀ ਹੈ?"
  },
  {
    "surah_id": 101,
    "ayah_number": 11,
    "global_ayah_id": 6268,
    "translation": "ਉਹ ਇੱਕ ਦਹਿਕਦੀ ਹੋਈ (ਨਰਕ ਦੀ) ਅੱਗ ਹੈ।"
  }
]