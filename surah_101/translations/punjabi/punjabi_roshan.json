[
  {
    "surah_id": 101,
    "ayah_number": 0,
    "global_ayah_id": 6257,
    "translation": "اللہ دے ناں نال ( شروع ) جیہڑا حدوں مہربان ، بوہت رحم والا اے ۔"
  },
  {
    "surah_id": 101,
    "ayah_number": 1,
    "global_ayah_id": 6258,
    "translation": "کھٹکھٹاؤن والی ( قیامت )"
  },
  {
    "surah_id": 101,
    "ayah_number": 2,
    "global_ayah_id": 6259,
    "translation": "کیہہ اے اوہ کھٹکھٹاؤن والی !"
  },
  {
    "surah_id": 101,
    "ayah_number": 3,
    "global_ayah_id": 6260,
    "translation": "تے تہانوں کیہہ پتا ہووے کھٹکھٹاؤن والی کیہہ اے ؟"
  },
  {
    "surah_id": 101,
    "ayah_number": 4,
    "global_ayah_id": 6261,
    "translation": "جیس دیہاڑے لوک ( انج ) ہون گے جینویں کھِلرے ہوئے پبھکڑ"
  },
  {
    "surah_id": 101,
    "ayah_number": 5,
    "global_ayah_id": 6262,
    "translation": "تے پہاڑ ہون گے جینویں پنجی ہوئی رنگلی اُن"
  },
  {
    "surah_id": 101,
    "ayah_number": 6,
    "global_ayah_id": 6263,
    "translation": "فیر پر جیس بندے دے پلڑے بھارے ہو گئے"
  },
  {
    "surah_id": 101,
    "ayah_number": 7,
    "global_ayah_id": 6264,
    "translation": "فیر اوہ خوشی والی حیاتی وچ ہووے گا"
  },
  {
    "surah_id": 101,
    "ayah_number": 8,
    "global_ayah_id": 6265,
    "translation": "تے رہیا اوہ بندہ جیس دے پلڑے ہولے ہو گئے"
  },
  {
    "surah_id": 101,
    "ayah_number": 9,
    "global_ayah_id": 6266,
    "translation": "فیر اوہدا ٹھکانہ ہاویہ ( کھڈ ) اے"
  },
  {
    "surah_id": 101,
    "ayah_number": 10,
    "global_ayah_id": 6267,
    "translation": "تے تسی کیہہ جانو پئی اوہ ( ہاویہ ) کیہہ اے"
  },
  {
    "surah_id": 101,
    "ayah_number": 11,
    "global_ayah_id": 6268,
    "translation": "اک بھکھدی ہوئی اگ"
  }
]