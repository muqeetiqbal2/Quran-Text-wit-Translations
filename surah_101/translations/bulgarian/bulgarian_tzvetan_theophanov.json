[
  {
    "surah_id": 101,
    "ayah_number": 1,
    "global_ayah_id": 6158,
    "translation": "Бедствието!"
  },
  {
    "surah_id": 101,
    "ayah_number": 2,
    "global_ayah_id": 6159,
    "translation": "Какво е Бедствието?"
  },
  {
    "surah_id": 101,
    "ayah_number": 3,
    "global_ayah_id": 6160,
    "translation": "И откъде да знаеш ти какво е Бедствието?"
  },
  {
    "surah_id": 101,
    "ayah_number": 4,
    "global_ayah_id": 6161,
    "translation": "Деня, в който хората ще бъдат като пръснати пеперуди"
  },
  {
    "surah_id": 101,
    "ayah_number": 5,
    "global_ayah_id": 6162,
    "translation": "и планините ще бъдат като разпокъсана вълна..."
  },
  {
    "surah_id": 101,
    "ayah_number": 6,
    "global_ayah_id": 6163,
    "translation": "Онзи, чиито везни натежат,"
  },
  {
    "surah_id": 101,
    "ayah_number": 7,
    "global_ayah_id": 6164,
    "translation": "ще има живот в доволство,"
  },
  {
    "surah_id": 101,
    "ayah_number": 8,
    "global_ayah_id": 6165,
    "translation": "а онзи, чиито везни олекнат,"
  },
  {
    "surah_id": 101,
    "ayah_number": 9,
    "global_ayah_id": 6166,
    "translation": "завръщането му е бездна."
  },
  {
    "surah_id": 101,
    "ayah_number": 10,
    "global_ayah_id": 6167,
    "translation": "А откъде да знаеш ти какво е тя?"
  },
  {
    "surah_id": 101,
    "ayah_number": 11,
    "global_ayah_id": 6168,
    "translation": "Пламтящ огън."
  }
]