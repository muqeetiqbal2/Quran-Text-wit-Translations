[
  {
    "surah_id": 101,
    "ayah_number": 0,
    "global_ayah_id": 6257,
    "translation": "﻿अल्लाहच्या नावाने,जो अत्यंत दयावंत व असीम कृपावंत आहे."
  },
  {
    "surah_id": 101,
    "ayah_number": 1,
    "global_ayah_id": 6258,
    "translation": "प्रचंड घटना!"
  },
  {
    "surah_id": 101,
    "ayah_number": 2,
    "global_ayah_id": 6259,
    "translation": "काय आहे ती प्रचंड घटना?"
  },
  {
    "surah_id": 101,
    "ayah_number": 3,
    "global_ayah_id": 6260,
    "translation": "तुम्हाला काय ठाऊक की ती प्रचंड घटना काय आहे?"
  },
  {
    "surah_id": 101,
    "ayah_number": 4,
    "global_ayah_id": 6261,
    "translation": "तो दिवस जेव्हा लोक विखुरलेल्या पतंग्यांसमान"
  },
  {
    "surah_id": 101,
    "ayah_number": 5,
    "global_ayah_id": 6262,
    "translation": "आणि पर्वत रंगीबेरंगी पिंजलेल्या लोकरीप्रमाणे असतील."
  },
  {
    "surah_id": 101,
    "ayah_number": 6,
    "global_ayah_id": 6263,
    "translation": "मग ज्याचे पारडे जड असेल"
  },
  {
    "surah_id": 101,
    "ayah_number": 7,
    "global_ayah_id": 6264,
    "translation": "तो मनपसंत ऐश्वर्यात असेल,"
  },
  {
    "surah_id": 101,
    "ayah_number": 8,
    "global_ayah_id": 6265,
    "translation": "आणि ज्याचे पारडे हलके असेल"
  },
  {
    "surah_id": 101,
    "ayah_number": 9,
    "global_ayah_id": 6266,
    "translation": "त्याचे विश्रामधाम खोल खाई असेल,"
  },
  {
    "surah_id": 101,
    "ayah_number": 10,
    "global_ayah_id": 6267,
    "translation": "आणि तुम्हाला काय ठाऊक की ती वस्तू काय आहे?"
  },
  {
    "surah_id": 101,
    "ayah_number": 11,
    "global_ayah_id": 6268,
    "translation": "भडकणारा अग्नी."
  }
]