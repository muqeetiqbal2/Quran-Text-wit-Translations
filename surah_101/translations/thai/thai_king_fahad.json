    "translation": "อัลกอริอะฮ์"
  },
  {
    "surah_id": 101,
    "ayah_number": 2,
    "global_ayah_id": 6159,
    "translation": "อัลกอริอะฮ์นั้นคืออะไร?"
  },
  {
    "surah_id": 101,
    "ayah_number": 3,
    "global_ayah_id": 6160,
    "translation": "และอะไรที่ทำให้เจ้าได้รู้ว่าอัลกอรีอะฮฺนั้นคืออะไร?"
  },
  {
    "surah_id": 101,
    "ayah_number": 4,
    "global_ayah_id": 6161,
    "translation": "วันที่มนุษย์จะเป็นเช่นแมลงเม่าที่กระจายว่อน"
  },
  {
    "surah_id": 101,
    "ayah_number": 5,
    "global_ayah_id": 6162,
    "translation": "และบรรดาภูเขาจะเป็นเช่นขนสัตว์ที่ปลิวว่อน"
  },
  {
    "surah_id": 101,
    "ayah_number": 6,
    "global_ayah_id": 6163,
    "translation": "ส่วนผู้ที่ตราชูของเขาหนัก"
  },
  {
    "surah_id": 101,
    "ayah_number": 7,
    "global_ayah_id": 6164,
    "translation": "เขาก็จะอยู่ในการมีชีวิตที่ผาสุข"
  },
  {
    "surah_id": 101,
    "ayah_number": 8,
    "global_ayah_id": 6165,
    "translation": "และส่วนผู้ที่ตราชูของเขาเบา"
  },
  {
    "surah_id": 101,
    "ayah_number": 9,
    "global_ayah_id": 6166,
    "translation": "ที่พำนักของเขาก็คือเหวลึก (ฮาวิยะฮ์)"
  },
  {
    "surah_id": 101,
    "ayah_number": 10,
    "global_ayah_id": 6167,
    "translation": "และอะไรเล่าที่ทำให้เจ้ารู้ได้ว่าเหวลึกคืออะไร?"
  },
  {
    "surah_id": 101,
    "ayah_number": 11,
    "global_ayah_id": 6168,
    "translation": "คือไฟอันร้อนแรง"
  }
