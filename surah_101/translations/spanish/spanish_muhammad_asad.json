    "translation": "¡Que terrible la calamidad repentina!"
  },
  {
    "surah_id": 101,
    "ayah_number": 3,
    "global_ayah_id": 6160,
    "translation": "¿Y qué puede hacerte concebir lo que será esa calamidad repentina?"
  },
  {
    "surah_id": 101,
    "ayah_number": 4,
    "global_ayah_id": 6161,
    "translation": "[Ocurrirá] el Día en que los hombres parezcan polillas revoloteando confusas,"
  },
  {
    "surah_id": 101,
    "ayah_number": 5,
    "global_ayah_id": 6162,
    "translation": "y las montañas parezcan copos de lana cardada...."
  },
  {
    "surah_id": 101,
    "ayah_number": 6,
    "global_ayah_id": 6163,
    "translation": "Y entonces, aquel cuyo peso [de buenas acciones] sea grande en la balanza"
  },
  {
    "surah_id": 101,
    "ayah_number": 7,
    "global_ayah_id": 6164,
    "translation": "gozará de una vida placentera;"
  },
  {
    "surah_id": 101,
    "ayah_number": 8,
    "global_ayah_id": 6165,
    "translation": "pero aquel cuyo peso sea leve en la balanza"
  },
  {
    "surah_id": 101,
    "ayah_number": 9,
    "global_ayah_id": 6166,
    "translation": "se verá cercado por un abismo."
  },
  {
    "surah_id": 101,
    "ayah_number": 10,
    "global_ayah_id": 6167,
    "translation": "¿Y qué puede hacerte concebir lo que será ese [abismo]?"
  },
  {
    "surah_id": 101,
    "ayah_number": 11,
    "global_ayah_id": 6168,
    "translation": "¡Un fuego que arde intensamente!"
  }
