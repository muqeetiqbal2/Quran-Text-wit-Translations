[
  {
    "surah_id": 101,
    "ayah_number": 0,
    "global_ayah_id": 6257,
    "translation": "En el nombre de Dios, el Compasivo con toda la creación, el Misericordioso con los creyentes."
  },
  {
    "surah_id": 101,
    "ayah_number": 1,
    "global_ayah_id": 6258,
    "translation": "El evento repentino."
  },
  {
    "surah_id": 101,
    "ayah_number": 2,
    "global_ayah_id": 6259,
    "translation": "¿Qué es el evento repentino?"
  },
  {
    "surah_id": 101,
    "ayah_number": 3,
    "global_ayah_id": 6260,
    "translation": "¿Y qué te hará comprender la magnitud del evento repentino?"
  },
  {
    "surah_id": 101,
    "ayah_number": 4,
    "global_ayah_id": 6261,
    "translation": "Ese día la gente parecerá mariposas dispersas,"
  },
  {
    "surah_id": 101,
    "ayah_number": 5,
    "global_ayah_id": 6262,
    "translation": "y las montañas copos de lana cardada."
  },
  {
    "surah_id": 101,
    "ayah_number": 6,
    "global_ayah_id": 6263,
    "translation": "Aquel cuyas obras buenas sean más pesadas en la balanza"
  },
  {
    "surah_id": 101,
    "ayah_number": 7,
    "global_ayah_id": 6264,
    "translation": "gozará de una vida placentera."
  },
  {
    "surah_id": 101,
    "ayah_number": 8,
    "global_ayah_id": 6265,
    "translation": "En cambio, aquel cuyas obras buenas sean más livianas en la balanza,"
  },
  {
    "surah_id": 101,
    "ayah_number": 9,
    "global_ayah_id": 6266,
    "translation": "su morada estará en el abismo."
  },
  {
    "surah_id": 101,
    "ayah_number": 10,
    "global_ayah_id": 6267,
    "translation": "¿Y qué te hará comprender qué es el abismo?"
  },
  {
    "surah_id": 101,
    "ayah_number": 11,
    "global_ayah_id": 6268,
    "translation": "Es un fuego abrasador."
  }
]