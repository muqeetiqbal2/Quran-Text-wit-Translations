[
  {
    "surah_id": 101,
    "ayah_number": 0,
    "global_ayah_id": 6257,
    "translation": "అనంత కరుణామయుడు అపార కరుణాప్రదాత అయిన అల్లాహ్‌ పేరుతో"
  },
  {
    "surah_id": 101,
    "ayah_number": 1,
    "global_ayah_id": 6258,
    "translation": "ఆ! అదరగొట్టే మహా ఉపద్రవం!"
  },
  {
    "surah_id": 101,
    "ayah_number": 2,
    "global_ayah_id": 6259,
    "translation": "ఏమిటా అదరగొట్టే మహా ఉపద్రవం?"
  },
  {
    "surah_id": 101,
    "ayah_number": 3,
    "global_ayah_id": 6260,
    "translation": "మరియు ఆ అదరగొట్టే మహా ఉపద్రవం, అంటే ఏమిటో నీకేం తెలుసు?"
  },
  {
    "surah_id": 101,
    "ayah_number": 4,
    "global_ayah_id": 6261,
    "translation": "ఆ రోజు మానవులు చెల్లాచెదురైన చిమ్మెటల వలే అయిపోతారు."
  },
  {
    "surah_id": 101,
    "ayah_number": 5,
    "global_ayah_id": 6262,
    "translation": "మరియు పర్వతాలు రంగురంగుల ఏకిన దూదివలే అయిపోతాయి."
  },
  {
    "surah_id": 101,
    "ayah_number": 6,
    "global_ayah_id": 6263,
    "translation": "అప్పుడు ఎవడి త్రాసు పళ్ళాలు (సత్కా ర్యాలతో) బరువుగా ఉంటాయో!"
  },
  {
    "surah_id": 101,
    "ayah_number": 7,
    "global_ayah_id": 6264,
    "translation": "అతడు (స్వర్గంలో) సుఖవంతమైన జీవితం గడుపుతాడు."
  },
  {
    "surah_id": 101,
    "ayah_number": 8,
    "global_ayah_id": 6265,
    "translation": "మరియు ఎవడి (సత్కార్యాల) త్రాసు పళ్ళాలు తేలికగా ఉంటాయో!"
  },
  {
    "surah_id": 101,
    "ayah_number": 9,
    "global_ayah_id": 6266,
    "translation": "అతని నివాసం అధఃపాతాళమే."
  },
  {
    "surah_id": 101,
    "ayah_number": 10,
    "global_ayah_id": 6267,
    "translation": "మరియు అది ఏమిటో నీకేం తెలుసు?"
  },
  {
    "surah_id": 101,
    "ayah_number": 11,
    "global_ayah_id": 6268,
    "translation": "అదొక భగభగ మండే అగ్ని  (గుండం)."
  }
]