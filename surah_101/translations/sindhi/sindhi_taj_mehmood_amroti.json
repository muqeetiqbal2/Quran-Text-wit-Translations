  {
    "surah_id": 101,
    "ayah_number": 3,
    "global_ayah_id": 6160,
    "translation": "۽ ڪنھن سمجھايئي ته (اُھا) سخت ٺوڪيندڙ ڇا آھي؟"
  },
  {
    "surah_id": 101,
    "ayah_number": 4,
    "global_ayah_id": 6161,
    "translation": "جنھن ڏينھن ماڻھو پکيڙيلن پتنگن جان ھوندا."
  },
  {
    "surah_id": 101,
    "ayah_number": 5,
    "global_ayah_id": 6162,
    "translation": "۽ جبل تنبيل رڱيل اُن جان ھوندا."
  },
  {
    "surah_id": 101,
    "ayah_number": 6,
    "global_ayah_id": 6163,
    "translation": "پوءِ جنھن (جي عملن) جا ترارا ڳرا ٿيا."
  },
  {
    "surah_id": 101,
    "ayah_number": 7,
    "global_ayah_id": 6164,
    "translation": "سو دلپسند گذران ۾ ھوندو."
  },
  {
    "surah_id": 101,
    "ayah_number": 8,
    "global_ayah_id": 6165,
    "translation": "۽ جنھن (جي عملن) جا ترارا ھلڪا ٿيا."
  },
  {
    "surah_id": 101,
    "ayah_number": 9,
    "global_ayah_id": 6166,
    "translation": "تنھن (جي رھڻ) جي جاءِ ھاوِيَه آھي."
  },
  {
    "surah_id": 101,
    "ayah_number": 10,
    "global_ayah_id": 6167,
    "translation": "۽ ڪنھن سمجھايئي ته ھاويه ڇا آھي؟"
  },
  {
    "surah_id": 101,
    "ayah_number": 11,
    "global_ayah_id": 6168,
    "translation": "ھڪ ٻرندڙ باھ آھي."
  }
