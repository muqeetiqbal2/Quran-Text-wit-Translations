    "translation": "اللہ کے «<a href=614> نام </a>» سے جو بےحد رحم والا، نہایت «<a href=600> مہربان </a>» ہے۔ [1]"
  },
  {
    "surah_id": 101,
    "ayah_number": 1,
    "global_ayah_id": 6258,
    "translation": "وہ کھٹکھٹانے والی۔ [1]"
  },
  {
    "surah_id": 101,
    "ayah_number": 2,
    "global_ayah_id": 6259,
    "translation": "کیا ہے وہ کھٹکھٹانے والی؟ [2]"
  },
  {
    "surah_id": 101,
    "ayah_number": 3,
    "global_ayah_id": 6260,
    "translation": "اور تجھے کس چیز نے معلوم کروایا کہ وہ کھٹکھٹانے والی کیا ہے؟ [3]"
  },
  {
    "surah_id": 101,
    "ayah_number": 4,
    "global_ayah_id": 6261,
    "translation": "جس «<a href=326> دن </a>» لوگ بکھرے ہوئے پروانوں کی طرح ہو جائیں گے۔ [4]"
  },
  {
    "surah_id": 101,
    "ayah_number": 5,
    "global_ayah_id": 6262,
    "translation": "اور «<a href=160> پہاڑ </a>» دھنکی ہوئی رنگین اون کی طرح ہو جائیں گے۔ [5]"
  },
  {
    "surah_id": 101,
    "ayah_number": 6,
    "global_ayah_id": 6263,
    "translation": "تو لیکن وہ شخص جس کے پلڑے بھاری ہو گئے۔ [6]"
  },
  {
    "surah_id": 101,
    "ayah_number": 7,
    "global_ayah_id": 6264,
    "translation": "تو وہ خوشی کی زندگی میں ہو گا۔ [7]"
  },
  {
    "surah_id": 101,
    "ayah_number": 8,
    "global_ayah_id": 6265,
    "translation": "اور لیکن وہ شخص جس کے پلڑے ہلکے ہو گئے۔ [8]"
  },
  {
    "surah_id": 101,
    "ayah_number": 9,
    "global_ayah_id": 6266,
    "translation": "تو اس کی «<a href=565> ماں </a>» ہاویہ ہے۔ [9]"
