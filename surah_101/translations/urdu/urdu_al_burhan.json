  {
    "surah_id": 101,
    "ayah_number": 5,
    "global_ayah_id": 6262,
    "translation": "اور پہاڑ دھنکی ہوئی رنگین اون کی طرح ہوں گے ۔ 5 ۔"
  },
  {
    "surah_id": 101,
    "ayah_number": 6,
    "global_ayah_id": 6263,
    "translation": "پھر جس کے ( دنیاوی اعمال کے ) وزن بھاری ہوں گے ۔ 6 ۔"
  },
  {
    "surah_id": 101,
    "ayah_number": 7,
    "global_ayah_id": 6264,
    "translation": "وہ پسندیدہ عیش و آرام میں ہو گا ۔ 7 ۔"
  },
  {
    "surah_id": 101,
    "ayah_number": 8,
    "global_ayah_id": 6265,
    "translation": "اور جس کے ( اعمال کے ) وزن ہلکے ہوں گے ۔ 8 ۔"
  },
  {
    "surah_id": 101,
    "ayah_number": 9,
    "global_ayah_id": 6266,
    "translation": "تو اس کا ٹھکانا ؛ ھاویۃ ؛ ہو گا ۔ 9 ۔"
  },
  {
    "surah_id": 101,
    "ayah_number": 10,
    "global_ayah_id": 6267,
    "translation": "تمہیں کیا ادراک وہ ؛ ھاویۃ ؛ کیا ہے ۔ 10 ۔"
  },
  {
    "surah_id": 101,
    "ayah_number": 11,
    "global_ayah_id": 6268,
    "translation": "دہکتی ہوئی آگ ہے ۔ 11 ۔ ع ، نمبر 1 ۔ ( پ ، 26 ) ۔"
  }
