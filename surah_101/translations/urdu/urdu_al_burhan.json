  },
  {
    "surah_id": 101,
    "ayah_number": 2,
    "global_ayah_id": 6259,
    "translation": "کیا ہے القارعہ ؟ ۔ 2 ۔"
  },
  {
    "surah_id": 101,
    "ayah_number": 3,
    "global_ayah_id": 6260,
    "translation": "تم کیا جانو عظیم حادثہ کیا ہے ۔ 3 ۔"
  },
  {
    "surah_id": 101,
    "ayah_number": 4,
    "global_ayah_id": 6261,
    "translation": "جس دن لوگ بکھرے ہوئے پروانوں کی طرح ہوں گے ۔ 4 ۔"
