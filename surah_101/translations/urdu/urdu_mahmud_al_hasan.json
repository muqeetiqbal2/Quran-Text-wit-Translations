[
  {
    "surah_id": 101,
    "ayah_number": 0,
    "global_ayah_id": 6257,
    "translation": "اللہ کے نام سے جو رحمان و رحیم ہے"
  },
  {
    "surah_id": 101,
    "ayah_number": 1,
    "global_ayah_id": 6258,
    "translation": "وہ کھڑکھڑا ڈالنے والی"
  },
  {
    "surah_id": 101,
    "ayah_number": 2,
    "global_ayah_id": 6259,
    "translation": "کیا ہے وہ کھڑ کھڑا ڈالنے والی"
  },
  {
    "surah_id": 101,
    "ayah_number": 3,
    "global_ayah_id": 6260,
    "translation": "اور تو کیا سمجھا کیا ہے وہ کھڑ کھڑا ڈالنے والی"
  },
  {
    "surah_id": 101,
    "ayah_number": 4,
    "global_ayah_id": 6261,
    "translation": "جس دن ہوویں لوگ جیسے پتنگے بکھرے ہوئے"
  },
  {
    "surah_id": 101,
    "ayah_number": 5,
    "global_ayah_id": 6262,
    "translation": "اور ہوویں پہاڑ جیسے رنگی ہوئی اون دُھنی ہوئی"
  },
  {
    "surah_id": 101,
    "ayah_number": 6,
    "global_ayah_id": 6263,
    "translation": "سو جسکی بھاری ہوئیں تولیں"
  },
  {
    "surah_id": 101,
    "ayah_number": 7,
    "global_ayah_id": 6264,
    "translation": "تو وہ رہے گا من مانتے گذران میں"
  },
  {
    "surah_id": 101,
    "ayah_number": 8,
    "global_ayah_id": 6265,
    "translation": "اور جسکی ہلکی ہوئیں تولیں"
  },
  {
    "surah_id": 101,
    "ayah_number": 9,
    "global_ayah_id": 6266,
    "translation": "تو اُس کا ٹھکانہ گڑھا ہے"
  },
  {
    "surah_id": 101,
    "ayah_number": 10,
    "global_ayah_id": 6267,
    "translation": "اور تو کیا سمجھا وہ کیا ہے"
  },
  {
    "surah_id": 101,
    "ayah_number": 11,
    "global_ayah_id": 6268,
    "translation": "آگ ہے دہکتی ہوئی"
  }
]