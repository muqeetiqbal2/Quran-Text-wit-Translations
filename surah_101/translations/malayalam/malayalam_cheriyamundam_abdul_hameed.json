[
  {
    "surah_id": 101,
    "ayah_number": 1,
    "global_ayah_id": 6158,
    "translation": "ഭയങ്കരമായ ആ സംഭവം."
  },
  {
    "surah_id": 101,
    "ayah_number": 2,
    "global_ayah_id": 6159,
    "translation": "ഭയങ്കരമായ സംഭവം എന്നാല്‍ എന്താകുന്നു?"
  },
  {
    "surah_id": 101,
    "ayah_number": 3,
    "global_ayah_id": 6160,
    "translation": "ഭയങ്കരമായ സംഭവമെന്നാല്‍ എന്താണെന്ന് നിനക്കറിയുമോ?"
  },
  {
    "surah_id": 101,
    "ayah_number": 4,
    "global_ayah_id": 6161,
    "translation": "മനുഷ്യന്‍മാര്‍ ചിന്നിച്ചിതറിയ പാറ്റയെപ്പോലെ ആകുന്ന ദിവസം!"
  },
  {
    "surah_id": 101,
    "ayah_number": 5,
    "global_ayah_id": 6162,
    "translation": "പര്‍വ്വതങ്ങള്‍ കടഞ്ഞ ആട്ടിന്‍ രോമം പോലെയും"
  },
  {
    "surah_id": 101,
    "ayah_number": 6,
    "global_ayah_id": 6163,
    "translation": "അപ്പോള്‍ ഏതൊരാളുടെ തുലാസുകള്‍ ഘനം തൂങ്ങിയോ"
  },
  {
    "surah_id": 101,
    "ayah_number": 7,
    "global_ayah_id": 6164,
    "translation": "അവന്‍ സംതൃപ്തമായ ജീവിതത്തിലായിരിക്കും."
  },
  {
    "surah_id": 101,
    "ayah_number": 8,
    "global_ayah_id": 6165,
    "translation": "എന്നാല്‍ ഏതൊരാളുടെ തുലാസുകള്‍ തൂക്കം കുറഞ്ഞതായോ"
  },
  {
    "surah_id": 101,
    "ayah_number": 9,
    "global_ayah_id": 6166,
    "translation": "അവന്‍റെ സങ്കേതം ഹാവിയഃ ആയിരിക്കും."
  },
  {
    "surah_id": 101,
    "ayah_number": 10,
    "global_ayah_id": 6167,
    "translation": "ഹാവിയഃ എന്നാല്‍ എന്താണെന്ന് നിനക്കറിയുമോ?"
  },
  {
    "surah_id": 101,
    "ayah_number": 11,
    "global_ayah_id": 6168,
    "translation": "ചൂടേറിയ നരകാഗ്നിയത്രെ അത്‌."
  }
]