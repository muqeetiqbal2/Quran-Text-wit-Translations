    "translation": "वह खड़खड़ानेवाली!"
  },
  {
    "surah_id": 101,
    "ayah_number": 2,
    "global_ayah_id": 6159,
    "translation": "क्या है वह खड़खड़ानेवाली?"
  },
  {
    "surah_id": 101,
    "ayah_number": 3,
    "global_ayah_id": 6160,
    "translation": "और तुम्हें क्या मालूम कि क्या है वह खड़खड़ानेवाली?"
