[
  {
    "surah_id": 101,
    "ayah_number": 0,
    "global_ayah_id": 6257,
    "translation": "शुरू अल्लाह के नाम से जो सब पर मेहरबान है, बहुत मेहरबान है।"
  },
  {
    "surah_id": 101,
    "ayah_number": 1,
    "global_ayah_id": 6258,
    "translation": "(याद करो) वह वाक़िअ़ा जो दिल दहला कर रख देगा।"
  },
  {
    "surah_id": 101,
    "ayah_number": 2,
    "global_ayah_id": 6259,
    "translation": "क्या है वह दिल दहलाने वाला वाक़िअ़ा?"
  },
  {
    "surah_id": 101,
    "ayah_number": 3,
    "global_ayah_id": 6260,
    "translation": "और तुम्हें क्या मालूम वह दिल दहलाने वाला वाक़िअ़ा क्या है?"
  },
  {
    "surah_id": 101,
    "ayah_number": 4,
    "global_ayah_id": 6261,
    "translation": "जिस दिन सारे लोग फैले हुए परवानों की तरह हो जायेंगे,"
  },
  {
    "surah_id": 101,
    "ayah_number": 5,
    "global_ayah_id": 6262,
    "translation": "और पहाड़ धुनी हुई रंगीन ऊन की तरह हो जायेंगे।"
  },
  {
    "surah_id": 101,
    "ayah_number": 6,
    "global_ayah_id": 6263,
    "translation": "अब जिस शख़्स के पलड़े वज़नी होंगे"
  },
  {
    "surah_id": 101,
    "ayah_number": 7,
    "global_ayah_id": 6264,
    "translation": "तो वह मन-पसन्द ज़िन्दगी में होगा,"
  },
  {
    "surah_id": 101,
    "ayah_number": 8,
    "global_ayah_id": 6265,
    "translation": "और वह जिसके पलड़े हल्के होंगे,"
  },
  {
    "surah_id": 101,
    "ayah_number": 9,
    "global_ayah_id": 6266,
    "translation": "तो उसका ठिकाना एक गहरा गड्ढ़ा होगा।"
  },
  {
    "surah_id": 101,
    "ayah_number": 10,
    "global_ayah_id": 6267,
    "translation": "और तुम्हें क्या मालूम कि वह गहरा गड्ढ़ा क्या चीज़ है?"
  },
  {
    "surah_id": 101,
    "ayah_number": 11,
    "global_ayah_id": 6268,
    "translation": "एक दहकती हूई आग है।"
  }
]