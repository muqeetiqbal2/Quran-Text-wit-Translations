[
  {
    "surah_id": 101,
    "ayah_number": 0,
    "global_ayah_id": 6257,
    "translation": "(شروع) اللہ تعالیٰ کا ناں سنگ، جہڑو بہت مہربان نہایت رحم آلو ہے۔"
  },
  {
    "surah_id": 101,
    "ayah_number": 1,
    "global_ayah_id": 6258,
    "translation": "ایک کھڑکار آلی (قیامت)! [۱]"
  },
  {
    "surah_id": 101,
    "ayah_number": 2,
    "global_ayah_id": 6259,
    "translation": "کے ہے واہ کھڑکار آلی؟ [۲]"
  },
  {
    "surah_id": 101,
    "ayah_number": 3,
    "global_ayah_id": 6260,
    "translation": "خیر تم نا کے پتو جے کے ہے واہ کھڑکار آلی ! [۳]"
  },
  {
    "surah_id": 101,
    "ayah_number": 4,
    "global_ayah_id": 6261,
    "translation": "اُس دن لوک پتنگِیاں ہاروں پریشان کھِنڈیا وا ہویں گا۔ [۴]"
  },
  {
    "surah_id": 101,
    "ayah_number": 5,
    "global_ayah_id": 6262,
    "translation": "تے یہ پہاڑ پِنجی وی رنگ برنگی رُوں ہاروں (اُڈتا ) ہویں گا۔[۵]"
  },
  {
    "surah_id": 101,
    "ayah_number": 6,
    "global_ayah_id": 6263,
    "translation": "فر اُس دِن جس کا (نیک) عملاں گو،  پلّو بھارو ہویو،[۶]"
  },
  {
    "surah_id": 101,
    "ayah_number": 7,
    "global_ayah_id": 6264,
    "translation": "وہ من پسندعیش ما ہوے گو۔ [۷]"
  },
  {
    "surah_id": 101,
    "ayah_number": 8,
    "global_ayah_id": 6265,
    "translation": "(ور) جس کو پلو ہولو نکلیو! [۸]"
  },
  {
    "surah_id": 101,
    "ayah_number": 9,
    "global_ayah_id": 6266,
    "translation": "اُس کو ٹھِکانو ہاویہ (اک ڈُنگھی کھاہی) ہے [۹]"
  },
  {
    "surah_id": 101,
    "ayah_number": 10,
    "global_ayah_id": 6267,
    "translation": "خیرتم نا کے پتو واہ (ہاویہ) کیسی جگہ ہے[۱۰]"
  },
  {
    "surah_id": 101,
    "ayah_number": 11,
    "global_ayah_id": 6268,
    "translation": "بس بھکھتی اگ (کو بڑو تندور) ہے![۱۱]"
  }
]