[
  {
    "surah_id": 101,
    "ayah_number": 1,
    "global_ayah_id": 6158,
    "translation": "মহাসংকট!"
  },
  {
    "surah_id": 101,
    "ayah_number": 2,
    "global_ayah_id": 6159,
    "translation": "কী সে মহাসংকট?"
  },
  {
    "surah_id": 101,
    "ayah_number": 3,
    "global_ayah_id": 6160,
    "translation": "হায়, কিভাবে তোমাকে বোঝানো যাবে সেই মহাসংকট কি?"
  },
  {
    "surah_id": 101,
    "ayah_number": 4,
    "global_ayah_id": 6161,
    "translation": "সেইদিন মানুষরা হবে বিক্ষিপ্ত পঙ্গপালের মতো,"
  },
  {
    "surah_id": 101,
    "ayah_number": 5,
    "global_ayah_id": 6162,
    "translation": "আর পাহাড়গুলো হয়ে যাবে ধোনা পশমের মতো।"
  },
  {
    "surah_id": 101,
    "ayah_number": 6,
    "global_ayah_id": 6163,
    "translation": "সুতরাং তার ক্ষেত্রে যার পাল্লা ভারী হবে, --"
  },
  {
    "surah_id": 101,
    "ayah_number": 7,
    "global_ayah_id": 6164,
    "translation": "সে তো তখন হবে সন্তোষজনক জীবনযাপনে।"
  },
  {
    "surah_id": 101,
    "ayah_number": 8,
    "global_ayah_id": 6165,
    "translation": "কিন্ত তার ক্ষেত্রে যার পাল্লা হবে হাল্কা --"
  },
  {
    "surah_id": 101,
    "ayah_number": 9,
    "global_ayah_id": 6166,
    "translation": "তার মাতা হবে হাবিয়াহ্‌।"
  },
  {
    "surah_id": 101,
    "ayah_number": 10,
    "global_ayah_id": 6167,
    "translation": "হায়, কি করে তোমাকে বোঝানো যাবে কী সেই!"
  },
  {
    "surah_id": 101,
    "ayah_number": 11,
    "global_ayah_id": 6168,
    "translation": "জ্বলন্ত আগুন।"
  }
]