    "translation": "করাঘাতকারী,"
  },
  {
    "surah_id": 101,
    "ayah_number": 2,
    "global_ayah_id": 6159,
    "translation": "করাঘাতকারী কি?"
  },
  {
    "surah_id": 101,
    "ayah_number": 3,
    "global_ayah_id": 6160,
    "translation": "করাঘাতকারী সম্পর্কে আপনি কি জানেন ?"
  },
  {
    "surah_id": 101,
    "ayah_number": 4,
    "global_ayah_id": 6161,
    "translation": "যেদিন মানুষ হবে বিক্ষিপ্ত পতংগের মত"
  },
  {
    "surah_id": 101,
    "ayah_number": 5,
    "global_ayah_id": 6162,
    "translation": "এবং পর্বতমালা হবে ধুনিত রঙ্গীন পশমের মত।"
  },
  {
    "surah_id": 101,
    "ayah_number": 6,
    "global_ayah_id": 6163,
    "translation": "অতএব যার পাল্লা ভারী হবে,"
  },
  {
    "surah_id": 101,
    "ayah_number": 7,
    "global_ayah_id": 6164,
    "translation": "সে সুখীজীবন যাপন করবে।"
  },
  {
    "surah_id": 101,
    "ayah_number": 8,
    "global_ayah_id": 6165,
    "translation": "আর যার পাল্লা হালকা হবে,"
  },
  {
    "surah_id": 101,
    "ayah_number": 9,
    "global_ayah_id": 6166,
    "translation": "তার ঠিকানা হবে হাবিয়া।"
  },
  {
    "surah_id": 101,
    "ayah_number": 10,
    "global_ayah_id": 6167,
    "translation": "আপনি জানেন তা কি?"
  },
  {
    "surah_id": 101,
    "ayah_number": 11,
    "global_ayah_id": 6168,
    "translation": "প্রজ্জ্বলিত অগ্নি!"
  }
