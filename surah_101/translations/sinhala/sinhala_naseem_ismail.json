[
  {
    "surah_id": 101,
    "ayah_number": 1,
    "global_ayah_id": 6158,
    "translation": "(මරණයට පත් වූවන්ව) තිගැස්සීමට සලස්වන සිද්ධියයි!"
  },
  {
    "surah_id": 101,
    "ayah_number": 2,
    "global_ayah_id": 6159,
    "translation": "(එවැනි) තිගැස්සීමට සලස්වන සිද්ධිය කුමක්ද?"
  },
  {
    "surah_id": 101,
    "ayah_number": 3,
    "global_ayah_id": 6160,
    "translation": "(නබියේ!) එම සිද්ධිය අසවල් එක යයි ඔබ දන්නෙහිද?"
  },
  {
    "surah_id": 101,
    "ayah_number": 4,
    "global_ayah_id": 6161,
    "translation": "එදිනදී මිනිසුන් ඇවිස්සී විසිරී තිඛෙන මෙරු මෙන් බවට පත් වනු ඇත."
  },
  {
    "surah_id": 101,
    "ayah_number": 5,
    "global_ayah_id": 6162,
    "translation": "කඳු විසිරී දැමූ පුළුන් මෙන් පාවී යනු ඇත."
  },
  {
    "surah_id": 101,
    "ayah_number": 6,
    "global_ayah_id": 6163,
    "translation": "කවුරුන්ගේ පින් වල බර වැඩි වූවේද-"
  },
  {
    "surah_id": 101,
    "ayah_number": 7,
    "global_ayah_id": 6164,
    "translation": "ඔහු තෘප්තියට පත් ජීවිතයෙහි (සැපසේ) ජීවත්ව සිටිනු ඇත."
  },
  {
    "surah_id": 101,
    "ayah_number": 8,
    "global_ayah_id": 6165,
    "translation": "කවුරුන්ගේ (පින් වල) බර පහසු වී (පාපයන්හි බර වැඩි) වූවේද,"
  },
  {
    "surah_id": 101,
    "ayah_number": 9,
    "global_ayah_id": 6166,
    "translation": "ඔහු රැෙඳන ස්ථානය හාවියාය."
  },
  {
    "surah_id": 101,
    "ayah_number": 10,
    "global_ayah_id": 6167,
    "translation": "(එම) හාවියා අසවල් එක යයි (නබියේ!) ඔබ දන්නෙහිද?"
  },
  {
    "surah_id": 101,
    "ayah_number": 11,
    "global_ayah_id": 6168,
    "translation": "(එය) ඉදී තිඛෙන (නිරා) ගින්න වන්නේය."
  }
]