[
  {
    "surah_id": 101,
    "ayah_number": 1,
    "global_ayah_id": 6158,
    "translation": "Великое бедствие (День воскресения)!"
  },
  {
    "surah_id": 101,
    "ayah_number": 2,
    "global_ayah_id": 6159,
    "translation": "Что такое Великое бедствие (День воскресения)?"
  },
  {
    "surah_id": 101,
    "ayah_number": 3,
    "global_ayah_id": 6160,
    "translation": "Откуда ты мог знать, что такое Великое бедствие (День воскресения)?"
  },
  {
    "surah_id": 101,
    "ayah_number": 4,
    "global_ayah_id": 6161,
    "translation": "В тот день люди будут подобны рассеянным мотылькам,"
  },
  {
    "surah_id": 101,
    "ayah_number": 5,
    "global_ayah_id": 6162,
    "translation": "а горы будут подобны расчесанной шерсти."
  },
  {
    "surah_id": 101,
    "ayah_number": 6,
    "global_ayah_id": 6163,
    "translation": "Тогда тот, чья чаша Весов окажется тяжелой,"
  },
  {
    "surah_id": 101,
    "ayah_number": 7,
    "global_ayah_id": 6164,
    "translation": "обретет приятную жизнь."
  },
  {
    "surah_id": 101,
    "ayah_number": 8,
    "global_ayah_id": 6165,
    "translation": "Для того же, чья чаша Весов окажется легкой,"
  },
  {
    "surah_id": 101,
    "ayah_number": 9,
    "global_ayah_id": 6166,
    "translation": "матерью станет Пропасть (грешники будут искать убежище в Аду, подобно тому, как ребенок ищет убежище у своей матери; или грешники будут падать в Адскую Пропасть вниз головой)."
  },
  {
    "surah_id": 101,
    "ayah_number": 10,
    "global_ayah_id": 6167,
    "translation": "Откуда ты мог знать, что это такое?"
  },
  {
    "surah_id": 101,
    "ayah_number": 11,
    "global_ayah_id": 6168,
    "translation": "Это - жаркий Огонь!"
  }
]