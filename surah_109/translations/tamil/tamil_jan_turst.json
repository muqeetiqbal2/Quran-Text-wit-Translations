    "global_ayah_id": 6208,
    "translation": "(நபியே!) நீர் சொல்வீராக: \"காஃபிர்களே!"
  },
  {
    "surah_id": 109,
    "ayah_number": 2,
    "global_ayah_id": 6209,
    "translation": "நீங்கள் வணங்குபவற்றை நான் வணங்கமாட்டேன்."
  },
  {
    "surah_id": 109,
    "ayah_number": 3,
    "global_ayah_id": 6210,
    "translation": "இன்னும், நான் வணங்குகிறவனை நீங்கள் வணங்குகிறவர்களல்லர்."
  },
  {
    "surah_id": 109,
    "ayah_number": 4,
    "global_ayah_id": 6211,
    "translation": "அன்றியும், நீங்கள் வணங்குபவற்றை நான் வணங்குபவனல்லன்."
  },
  {
    "surah_id": 109,
    "ayah_number": 5,
    "global_ayah_id": 6212,
    "translation": "மேலும், நான் வணங்குபவனை நீங்கள் வணங்குபவர்கள் அல்லர்."
  },
  {
    "surah_id": 109,
    "ayah_number": 6,
    "global_ayah_id": 6213,
    "translation": "உங்களுக்கு உங்களுடைய மார்க்கம்; எனக்கு என்னுடைய மார்க்கம்.\""
  }
]