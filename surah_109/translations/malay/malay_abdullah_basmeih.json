[
  {
    "surah_id": 109,
    "ayah_number": 1,
    "global_ayah_id": 6208,
    "translation": "Katakanlah (wahai Muhammad): \"Hai orang-orang kafir!"
  },
  {
    "surah_id": 109,
    "ayah_number": 2,
    "global_ayah_id": 6209,
    "translation": "\"Aku tidak akan menyembah apa yang kamu sembah."
  },
  {
    "surah_id": 109,
    "ayah_number": 3,
    "global_ayah_id": 6210,
    "translation": "\"Dan kamu tidak mahu menyembah (Allah) yang aku sembah."
  },
  {
    "surah_id": 109,
    "ayah_number": 4,
    "global_ayah_id": 6211,
    "translation": "\"Dan aku tidak akan beribadat secara kamu beribadat."
  },
  {
    "surah_id": 109,
    "ayah_number": 5,
    "global_ayah_id": 6212,
    "translation": "\"Dan kamu pula tidak mahu beribadat secara aku beribadat."
  },
  {
    "surah_id": 109,
    "ayah_number": 6,
    "global_ayah_id": 6213,
    "translation": "\"Bagi kamu ugama kamu, dan bagiku ugamaku\"."
  }
]