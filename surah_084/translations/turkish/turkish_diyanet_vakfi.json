[
  {
    "surah_id": 84,
    "ayah_number": 1,
    "global_ayah_id": 5885,
    "translation": "Gök yarıldığı,"
  },
  {
    "surah_id": 84,
    "ayah_number": 2,
    "global_ayah_id": 5886,
    "translation": "Rabbine kulak verip boyun eğecek hale getirildiği zaman,"
  },
  {
    "surah_id": 84,
    "ayah_number": 3,
    "global_ayah_id": 5887,
    "translation": "Yer dümdüz edildiği,"
  },
  {
    "surah_id": 84,
    "ayah_number": 4,
    "global_ayah_id": 5888,
    "translation": "İçinde bulunanları atıp boşaldığı,"
  },
  {
    "surah_id": 84,
    "ayah_number": 5,
    "global_ayah_id": 5889,
    "translation": "Ve Rabb'ini dinleyip O'na hakkıyla itaata mecbur kılındığı vakit (insanoğlu yaptıkları ile karşılaşır)."
  },
  {
    "surah_id": 84,
    "ayah_number": 6,
    "global_ayah_id": 5890,
    "translation": "Ey insan! Şüphe yok ki sen Rabbine karşı çaba üstüne çaba göstermektesin; sonunda O'na varacaksın."
  },
  {
    "surah_id": 84,
    "ayah_number": 7,
    "global_ayah_id": 5891,
    "translation": "Kimin kitabı sağından verilirse,"
  },
  {
    "surah_id": 84,
    "ayah_number": 8,
    "global_ayah_id": 5892,
    "translation": "Kolay bir hesapla hesaba çekilecek;"
  },
  {
    "surah_id": 84,
    "ayah_number": 9,
    "global_ayah_id": 5893,
    "translation": "Ve sevinçli olarak ailesine dönecektir."
  },
  {
    "surah_id": 84,
    "ayah_number": 10,
    "global_ayah_id": 5894,
    "translation": "Kimin de kitabı arkasından verilirse,"
  },
  {
    "surah_id": 84,
    "ayah_number": 11,
    "global_ayah_id": 5895,
    "translation": "Derhal yok olmayı isteyecek,"
  },
  {
    "surah_id": 84,
    "ayah_number": 12,
    "global_ayah_id": 5896,
    "translation": "Ve alevli ateşe girecektir."
  },
  {
    "surah_id": 84,
    "ayah_number": 13,
    "global_ayah_id": 5897,
    "translation": "Zira o, (dünyada) ailesi içinde (mal-mülk sebebiyle) şımarmıştı."
  },
  {
    "surah_id": 84,
    "ayah_number": 14,
    "global_ayah_id": 5898,
    "translation": "O hiçbir zaman Rabbine dönmeyeceğini sandı."
  },
  {
    "surah_id": 84,
    "ayah_number": 15,
    "global_ayah_id": 5899,
    "translation": "Oysa gerçekten Rabbi onu görüyordu."
  },
  {
    "surah_id": 84,
    "ayah_number": 16,
    "global_ayah_id": 5900,
    "translation": "Hayır! Şafağa, yemin ederim ki,"
  },
  {
    "surah_id": 84,
    "ayah_number": 17,
    "global_ayah_id": 5901,
    "translation": "Geceye ve onda basan karanlığa,"
  },
  {
    "surah_id": 84,
    "ayah_number": 18,
    "global_ayah_id": 5902,
    "translation": "Dolunay olmuş aya,"
  },
  {
    "surah_id": 84,
    "ayah_number": 19,
    "global_ayah_id": 5903,
    "translation": "Ki, siz elbette halden hale geçeceksiniz."
  },
  {
    "surah_id": 84,
    "ayah_number": 20,
    "global_ayah_id": 5904,
    "translation": "Böyleyken onlar acaba neden iman etmezler?"
  },
  {
    "surah_id": 84,
    "ayah_number": 21,
    "global_ayah_id": 5905,
    "translation": "Onlar kendilerine Kur'an okununca secde de etmezler."
  },
  {
    "surah_id": 84,
    "ayah_number": 22,
    "global_ayah_id": 5906,
    "translation": "Aksine, kafirler yalanlıyorlar."
  },
  {
    "surah_id": 84,
    "ayah_number": 23,
    "global_ayah_id": 5907,
    "translation": "Halbuki Allah onların gizlediği şeyleri çok iyi bilir."
  },
  {
    "surah_id": 84,
    "ayah_number": 24,
    "global_ayah_id": 5908,
    "translation": "(Resulüm!) Onlara acı azabı müjdele!"
  },
  {
    "surah_id": 84,
    "ayah_number": 25,
    "global_ayah_id": 5909,
    "translation": "İman edip salih amel işleyenler başkadır; onlar için arkası kesilmeyen bir mükafat vardır."
  }
]