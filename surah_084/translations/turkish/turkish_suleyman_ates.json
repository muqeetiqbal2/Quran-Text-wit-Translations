[
  {
    "surah_id": 84,
    "ayah_number": 1,
    "global_ayah_id": 5885,
    "translation": "Gök yarıldığı,"
  },
  {
    "surah_id": 84,
    "ayah_number": 2,
    "global_ayah_id": 5886,
    "translation": "Kendisine yaraştığı üzere Rabbini(n buyruğunu) dinlediği zaman!"
  },
  {
    "surah_id": 84,
    "ayah_number": 3,
    "global_ayah_id": 5887,
    "translation": "Yer uzatıl(ıp dümdüz yapıl)dığı,"
  },
  {
    "surah_id": 84,
    "ayah_number": 4,
    "global_ayah_id": 5888,
    "translation": "İçindekileri dışarı atıp boşaldığı,"
  },
  {
    "surah_id": 84,
    "ayah_number": 5,
    "global_ayah_id": 5889,
    "translation": "Ve kendisine yaraştığı üzere Rabbini(n buyruğunu) dinlediği zaman!"
  },
  {
    "surah_id": 84,
    "ayah_number": 6,
    "global_ayah_id": 5890,
    "translation": "Ey insan, sen, Rabbine varan yolda çabalayıp durmaktasın, nihayet O'na varacaksın."
  },
  {
    "surah_id": 84,
    "ayah_number": 7,
    "global_ayah_id": 5891,
    "translation": "(O zaman) Kimin Kitabı sağından verilirse:"
  },
  {
    "surah_id": 84,
    "ayah_number": 8,
    "global_ayah_id": 5892,
    "translation": "O, kolay bir hesaba çekilecek,"
  },
  {
    "surah_id": 84,
    "ayah_number": 9,
    "global_ayah_id": 5893,
    "translation": "Ve sevinçli olarak ailesine dönecektir."
  },
  {
    "surah_id": 84,
    "ayah_number": 10,
    "global_ayah_id": 5894,
    "translation": "Kimin Kitabı arka tarafından verilirse."
  },
  {
    "surah_id": 84,
    "ayah_number": 11,
    "global_ayah_id": 5895,
    "translation": "O, ölümü çağıracak,"
  },
  {
    "surah_id": 84,
    "ayah_number": 12,
    "global_ayah_id": 5896,
    "translation": "Ve alevli ateşe girecektir."
  },
  {
    "surah_id": 84,
    "ayah_number": 13,
    "global_ayah_id": 5897,
    "translation": "Çünkü o, (dünyada) ailesi arasında (şımarık ve) sevinçli idi."
  },
  {
    "surah_id": 84,
    "ayah_number": 14,
    "global_ayah_id": 5898,
    "translation": "O, hiç (Rabbine) dönmeyeceğini sanmıştı."
  },
  {
    "surah_id": 84,
    "ayah_number": 15,
    "global_ayah_id": 5899,
    "translation": "Hayır, Rabbi O'nu görmekte idi."
  },
  {
    "surah_id": 84,
    "ayah_number": 16,
    "global_ayah_id": 5900,
    "translation": "Yoo, and içerim; akşamın alaca karanlığına,"
  },
  {
    "surah_id": 84,
    "ayah_number": 17,
    "global_ayah_id": 5901,
    "translation": "Geceye ve (gecenin bağrında) topladığı şeylere,"
  },
  {
    "surah_id": 84,
    "ayah_number": 18,
    "global_ayah_id": 5902,
    "translation": "Değirmileşen aya,"
  },
  {
    "surah_id": 84,
    "ayah_number": 19,
    "global_ayah_id": 5903,
    "translation": "Ki, siz, mutlaka tabakadan tabakaya bineceksiniz!"
  },
  {
    "surah_id": 84,
    "ayah_number": 20,
    "global_ayah_id": 5904,
    "translation": "Onların nesi var ki inanmıyorlar?"
  },
  {
    "surah_id": 84,
    "ayah_number": 21,
    "global_ayah_id": 5905,
    "translation": "Kendilerine Kur'an okunduğu zaman secde etmiyorlar?"
  },
  {
    "surah_id": 84,
    "ayah_number": 22,
    "global_ayah_id": 5906,
    "translation": "Tersine o nankörler yalanlıyorlar."
  },
  {
    "surah_id": 84,
    "ayah_number": 23,
    "global_ayah_id": 5907,
    "translation": "Allah onların, içlerinde gizledikleri (düşünceleri) biliyor."
  },
  {
    "surah_id": 84,
    "ayah_number": 24,
    "global_ayah_id": 5908,
    "translation": "Onlara acı bir azabı müjdele."
  },
  {
    "surah_id": 84,
    "ayah_number": 25,
    "global_ayah_id": 5909,
    "translation": "Ancak inanıp yararlı işler yapan kimseler için kesintisiz bir mükafat vardır."
  }
]