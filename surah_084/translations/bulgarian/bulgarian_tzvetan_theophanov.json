[
  {
    "surah_id": 84,
    "ayah_number": 1,
    "global_ayah_id": 5885,
    "translation": "Когато небето се разцепи"
  },
  {
    "surah_id": 84,
    "ayah_number": 2,
    "global_ayah_id": 5886,
    "translation": "и се вслуша в своя Господ, и се подчини,"
  },
  {
    "surah_id": 84,
    "ayah_number": 3,
    "global_ayah_id": 5887,
    "translation": "и когато земята бъде разстлана,"
  },
  {
    "surah_id": 84,
    "ayah_number": 4,
    "global_ayah_id": 5888,
    "translation": "и изхвърли онова, което е в нея, и се опразни,"
  },
  {
    "surah_id": 84,
    "ayah_number": 5,
    "global_ayah_id": 5889,
    "translation": "и се вслуша в своя Господ, и се подчини..."
  },
  {
    "surah_id": 84,
    "ayah_number": 6,
    "global_ayah_id": 5890,
    "translation": "О, човече, ти се напрягаш с усилие към своя Господ и ще Го срещнеш."
  },
  {
    "surah_id": 84,
    "ayah_number": 7,
    "global_ayah_id": 5891,
    "translation": "А от онзи, чиято книга [за делата] му се даде в десницата,"
  },
  {
    "surah_id": 84,
    "ayah_number": 8,
    "global_ayah_id": 5892,
    "translation": "ще се потърси лека сметка"
  },
  {
    "surah_id": 84,
    "ayah_number": 9,
    "global_ayah_id": 5893,
    "translation": "и ще се завърне при своите хора [в Рая] щастлив."
  },
  {
    "surah_id": 84,
    "ayah_number": 10,
    "global_ayah_id": 5894,
    "translation": "А онзи, чиято книга му се даде откъм гърба,"
  },
  {
    "surah_id": 84,
    "ayah_number": 11,
    "global_ayah_id": 5895,
    "translation": "той ще зове за [своето] унищожение"
  },
  {
    "surah_id": 84,
    "ayah_number": 12,
    "global_ayah_id": 5896,
    "translation": "и ще гори в пламъци."
  },
  {
    "surah_id": 84,
    "ayah_number": 13,
    "global_ayah_id": 5897,
    "translation": "Той бе сред своите хора щастлив [на земята],"
  },
  {
    "surah_id": 84,
    "ayah_number": 14,
    "global_ayah_id": 5898,
    "translation": "той предполагаше, че не ще се завърне [при Нас]."
  },
  {
    "surah_id": 84,
    "ayah_number": 15,
    "global_ayah_id": 5899,
    "translation": "Да, неговият Господ бе над него зрящ."
  },
  {
    "surah_id": 84,
    "ayah_number": 16,
    "global_ayah_id": 5900,
    "translation": "Но не! Кълна се в заревото"
  },
  {
    "surah_id": 84,
    "ayah_number": 17,
    "global_ayah_id": 5901,
    "translation": "и в нощта, и в онова, което тя събира,"
  },
  {
    "surah_id": 84,
    "ayah_number": 18,
    "global_ayah_id": 5902,
    "translation": "и в луната, когато се изпълни -"
  },
  {
    "surah_id": 84,
    "ayah_number": 19,
    "global_ayah_id": 5903,
    "translation": "ще преминавате от състояние в състояние."
  },
  {
    "surah_id": 84,
    "ayah_number": 20,
    "global_ayah_id": 5904,
    "translation": "Какво им е, та не вярват"
  },
  {
    "surah_id": 84,
    "ayah_number": 21,
    "global_ayah_id": 5905,
    "translation": "и когато им се чете Коранът, не свеждат чела до земята в суджуд?"
  },
  {
    "surah_id": 84,
    "ayah_number": 22,
    "global_ayah_id": 5906,
    "translation": "Да, онези, които не вярват, отричат."
  },
  {
    "surah_id": 84,
    "ayah_number": 23,
    "global_ayah_id": 5907,
    "translation": "Но Аллах най-добре знае какво потулват."
  },
  {
    "surah_id": 84,
    "ayah_number": 24,
    "global_ayah_id": 5908,
    "translation": "И възвести ги за болезнено мъчение,"
  },
  {
    "surah_id": 84,
    "ayah_number": 25,
    "global_ayah_id": 5909,
    "translation": "освен онези, които вярват и вършат праведни дела! За тях има безспирна награда."
  }
]