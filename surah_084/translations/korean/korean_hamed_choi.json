[
  {
    "surah_id": 84,
    "ayah_number": 1,
    "global_ayah_id": 5885,
    "translation": "하늘이 산산히 갈라지고"
  },
  {
    "surah_id": 84,
    "ayah_number": 2,
    "global_ayah_id": 5886,
    "translation": "주님께 순종하며 의무를 다하도다"
  },
  {
    "surah_id": 84,
    "ayah_number": 3,
    "global_ayah_id": 5887,
    "translation": "대지가 편편하게 펼쳐지고"
  },
  {
    "surah_id": 84,
    "ayah_number": 4,
    "global_ayah_id": 5888,
    "translation": "그안의 모든 것이 내던져지어 텅비게 되매"
  },
  {
    "surah_id": 84,
    "ayah_number": 5,
    "global_ayah_id": 5889,
    "translation": "주님께 순종하며 의무를 다하 도다"
  },
  {
    "surah_id": 84,
    "ayah_number": 6,
    "global_ayah_id": 5890,
    "translation": "인간들이여 실로 너희가 주님 을 향해 노력하나니 너희는 그분 을 만날 것이라"
  },
  {
    "surah_id": 84,
    "ayah_number": 7,
    "global_ayah_id": 5891,
    "translation": "그의 기록이 오른 손에 있는 자는"
  },
  {
    "surah_id": 84,
    "ayah_number": 8,
    "global_ayah_id": 5892,
    "translation": "그의 기록이 편안히 계산되니"
  },
  {
    "surah_id": 84,
    "ayah_number": 9,
    "global_ayah_id": 5893,
    "translation": "기뻐하며 그의 가족으로 돌아가노라"
  },
  {
    "surah_id": 84,
    "ayah_number": 10,
    "global_ayah_id": 5894,
    "translation": "그러나 그의 기록이 뒤에 있는 자는"
  },
  {
    "surah_id": 84,
    "ayah_number": 11,
    "global_ayah_id": 5895,
    "translation": "죽음을 향하여 소리칠 것이 니"
  },
  {
    "surah_id": 84,
    "ayah_number": 12,
    "global_ayah_id": 5896,
    "translation": "그는 타오르는 불지옥으로 들어가니라"
  },
  {
    "surah_id": 84,
    "ayah_number": 13,
    "global_ayah_id": 5897,
    "translation": "실로 그는 그의 무리들과 즐 거히 방황 했을 뿐"
  },
  {
    "surah_id": 84,
    "ayah_number": 14,
    "global_ayah_id": 5898,
    "translation": "하나님에게로 귀의하리라 생 각지 아니 했노라"
  },
  {
    "surah_id": 84,
    "ayah_number": 15,
    "global_ayah_id": 5899,
    "translation": "그렇지 않노라 실로 주님께 서는 인간을 지켜보고 계시니라"
  },
  {
    "surah_id": 84,
    "ayah_number": 16,
    "global_ayah_id": 5900,
    "translation": "해질 때의 황혼을 두고 맹 세하사"
  },
  {
    "surah_id": 84,
    "ayah_number": 17,
    "global_ayah_id": 5901,
    "translation": "밤과 모여든 모든 것을 두 고 맹세하며"
  },
  {
    "surah_id": 84,
    "ayah_number": 18,
    "global_ayah_id": 5902,
    "translation": "완전히 차오른 달을 두고 맹 세하나니"
  },
  {
    "surah_id": 84,
    "ayah_number": 19,
    "global_ayah_id": 5903,
    "translation": "실로 너희는 한 상황에서 다른 상황으로 옮겨 가니라"
  },
  {
    "surah_id": 84,
    "ayah_number": 20,
    "global_ayah_id": 5904,
    "translation": "그럼에도 그들이 믿지 아니 하려 한 것은 무슨 일이뇨"
  },
  {
    "surah_id": 84,
    "ayah_number": 21,
    "global_ayah_id": 5905,
    "translation": "꾸란이 그들에게 낭송되나 부복하여 경배하지 아니하며"
  },
  {
    "surah_id": 84,
    "ayah_number": 22,
    "global_ayah_id": 5906,
    "translation": "오히려 그것을 거짓이라 불 신하더라"
  },
  {
    "surah_id": 84,
    "ayah_number": 23,
    "global_ayah_id": 5907,
    "translation": "그러나 하나님은 그들의 심 중에 감추고 있는 모든 것을 아시 나니"
  },
  {
    "surah_id": 84,
    "ayah_number": 24,
    "global_ayah_id": 5908,
    "translation": "그들에게 고통스러운 벌이 있을 것이라는 것을 경고하라"
  },
  {
    "surah_id": 84,
    "ayah_number": 25,
    "global_ayah_id": 5909,
    "translation": "그러나 믿음으로 선을 행하 는 의로운 자들에게는 단절되지 않는 영원한 보상이 있을 것이라"
  }
]