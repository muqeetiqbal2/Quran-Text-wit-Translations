[
  {
    "surah_id": 84,
    "ayah_number": 0,
    "global_ayah_id": 5967,
    "translation": "اللہ کے نام سے جو رحمان و رحیم ہے"
  },
  {
    "surah_id": 84,
    "ayah_number": 1,
    "global_ayah_id": 5968,
    "translation": "جب آسمان پھٹ جائے"
  },
  {
    "surah_id": 84,
    "ayah_number": 2,
    "global_ayah_id": 5969,
    "translation": "اور سن لے حکم اپنے رب کا وہ آسمان اسی لائق ہے"
  },
  {
    "surah_id": 84,
    "ayah_number": 3,
    "global_ayah_id": 5970,
    "translation": "اور جب زمین پھیلا دی جائے"
  },
  {
    "surah_id": 84,
    "ayah_number": 4,
    "global_ayah_id": 5971,
    "translation": "اور نکال ڈالے جو کچھ اُس میں ہے اور خالی ہو جائے"
  },
  {
    "surah_id": 84,
    "ayah_number": 5,
    "global_ayah_id": 5972,
    "translation": "اور سن لے حکم اپنے رب کا اور وہ زمین اسی لائق ہے"
  },
  {
    "surah_id": 84,
    "ayah_number": 6,
    "global_ayah_id": 5973,
    "translation": "اے آدمی تجھ کو تکلیف اٹھانی ہے اپنے رب تک پہنچنے میں سہہ سہہ کر اُس سے ملنا ہے"
  },
  {
    "surah_id": 84,
    "ayah_number": 7,
    "global_ayah_id": 5974,
    "translation": "سو جس کو ملا اعمالنامہ اس کا داہنے ہاتھ میں"
  },
  {
    "surah_id": 84,
    "ayah_number": 8,
    "global_ayah_id": 5975,
    "translation": "تو اُس سے حساب لیں گے آسان حساب"
  },
  {
    "surah_id": 84,
    "ayah_number": 9,
    "global_ayah_id": 5976,
    "translation": "اور پھر کر آئے گا اپنے لوگوں کے پاس خوش ہو کر"
  },
  {
    "surah_id": 84,
    "ayah_number": 10,
    "global_ayah_id": 5977,
    "translation": "اور جس کو ملا اس کا اعمالنامہ پیٹھ کے پیچھے سے"
  },
  {
    "surah_id": 84,
    "ayah_number": 11,
    "global_ayah_id": 5978,
    "translation": "سو وہ پکارے گا موت موت"
  },
  {
    "surah_id": 84,
    "ayah_number": 12,
    "global_ayah_id": 5979,
    "translation": "اور پڑے گا آگ میں"
  },
  {
    "surah_id": 84,
    "ayah_number": 13,
    "global_ayah_id": 5980,
    "translation": "وہ رہا تھا اپنے گھر میں بے غم"
  },
  {
    "surah_id": 84,
    "ayah_number": 14,
    "global_ayah_id": 5981,
    "translation": "اُس نے خیال کیا تھا کہ پھر کر نہ جائے گا"
  },
  {
    "surah_id": 84,
    "ayah_number": 15,
    "global_ayah_id": 5982,
    "translation": "کیوں نہیں اُس کا رب اُسکو دیکھتا تھا"
  },
  {
    "surah_id": 84,
    "ayah_number": 16,
    "global_ayah_id": 5983,
    "translation": "سو قسم کھاتا ہوں شام کی سرخی کی"
  },
  {
    "surah_id": 84,
    "ayah_number": 17,
    "global_ayah_id": 5984,
    "translation": "اور رات کی اور جو چیزیں اُس میں سمٹ آتی ہیں"
  },
  {
    "surah_id": 84,
    "ayah_number": 18,
    "global_ayah_id": 5985,
    "translation": "اور چاند کی جب پورا بھر جائے"
  },
  {
    "surah_id": 84,
    "ayah_number": 19,
    "global_ayah_id": 5986,
    "translation": "کہ تم کو چڑھنا ہے سیڑھی پر سیڑھی"
  },
  {
    "surah_id": 84,
    "ayah_number": 20,
    "global_ayah_id": 5987,
    "translation": "پھر کیا ہوا ہے اُنکو جو یقین نہیں لاتے"
  },
  {
    "surah_id": 84,
    "ayah_number": 21,
    "global_ayah_id": 5988,
    "translation": "اور جب پڑھیے انکے پا س قرآن مجید وہ سجدہ نہیں کرتے"
  },
  {
    "surah_id": 84,
    "ayah_number": 22,
    "global_ayah_id": 5989,
    "translation": "اوپر سے اور یہ کہ منکر جھٹلاتے ہیں"
  },
  {
    "surah_id": 84,
    "ayah_number": 23,
    "global_ayah_id": 5990,
    "translation": "اور اللہ خوب جانتا ہے جو اندر بھر رکھتے ہیں"
  },
  {
    "surah_id": 84,
    "ayah_number": 24,
    "global_ayah_id": 5991,
    "translation": "سو خوشی سنا دے اُنکو عذاب دردناک کی"
  },
  {
    "surah_id": 84,
    "ayah_number": 25,
    "global_ayah_id": 5992,
    "translation": "مگر جو لوگ کہ یقین لائے اور کام کئے بھلے اُنکے لئے ثواب ہے بے انتہا"
  }
]