[
  {
    "surah_id": 84,
    "ayah_number": 1,
    "global_ayah_id": 5885,
    "translation": "Kad se nebo rascijepi"
  },
  {
    "surah_id": 84,
    "ayah_number": 2,
    "global_ayah_id": 5886,
    "translation": "i posluša Gospodara svoga, a ono će to dužno biti,"
  },
  {
    "surah_id": 84,
    "ayah_number": 3,
    "global_ayah_id": 5887,
    "translation": "i kada Zemlja bude rastegnuta"
  },
  {
    "surah_id": 84,
    "ayah_number": 4,
    "global_ayah_id": 5888,
    "translation": "i izbaci ono što je u njoj, i potpuno se isprazni,"
  },
  {
    "surah_id": 84,
    "ayah_number": 5,
    "global_ayah_id": 5889,
    "translation": "i posluša Gospodara svoga, a ona će dužna biti."
  },
  {
    "surah_id": 84,
    "ayah_number": 6,
    "global_ayah_id": 5890,
    "translation": "O čovječe, ti se trudiš idući svome Gospodaru, pa ćeš svoj trud naći!"
  },
  {
    "surah_id": 84,
    "ayah_number": 7,
    "global_ayah_id": 5891,
    "translation": "Onaj kome bude knjiga njegova u desnu ruku njegovu data,"
  },
  {
    "surah_id": 84,
    "ayah_number": 8,
    "global_ayah_id": 5892,
    "translation": "na lahak obračun naići će"
  },
  {
    "surah_id": 84,
    "ayah_number": 9,
    "global_ayah_id": 5893,
    "translation": "i svojima će se radostan vratiti;"
  },
  {
    "surah_id": 84,
    "ayah_number": 10,
    "global_ayah_id": 5894,
    "translation": "a onaj kome bude knjiga njegova iza leda njegovih data,"
  },
  {
    "surah_id": 84,
    "ayah_number": 11,
    "global_ayah_id": 5895,
    "translation": "propast će prizivati,"
  },
  {
    "surah_id": 84,
    "ayah_number": 12,
    "global_ayah_id": 5896,
    "translation": "i u Ognju će gorjeti."
  },
  {
    "surah_id": 84,
    "ayah_number": 13,
    "global_ayah_id": 5897,
    "translation": "Zaista je on sa porodicom svojom radostan bio,"
  },
  {
    "surah_id": 84,
    "ayah_number": 14,
    "global_ayah_id": 5898,
    "translation": "i mislio da se nikada neće vratiti,"
  },
  {
    "surah_id": 84,
    "ayah_number": 15,
    "global_ayah_id": 5899,
    "translation": "a hoće! Gospodar njegov o njemu, zaista, sve zna!"
  },
  {
    "surah_id": 84,
    "ayah_number": 16,
    "global_ayah_id": 5900,
    "translation": "Ali ne! Kunem se rumenilom večernjim,"
  },
  {
    "surah_id": 84,
    "ayah_number": 17,
    "global_ayah_id": 5901,
    "translation": "i noći, i onim što ona sakuplja,"
  },
  {
    "surah_id": 84,
    "ayah_number": 18,
    "global_ayah_id": 5902,
    "translation": "i Mjesecom kada se ispuni,"
  },
  {
    "surah_id": 84,
    "ayah_number": 19,
    "global_ayah_id": 5903,
    "translation": "vi ćete sigurno iz stanja u stanje prelaziti!"
  },
  {
    "surah_id": 84,
    "ayah_number": 20,
    "global_ayah_id": 5904,
    "translation": "Pa šta im je, da ne vjeruju"
  },
  {
    "surah_id": 84,
    "ayah_number": 21,
    "global_ayah_id": 5905,
    "translation": "i kad im se Kur'an uči na tlo licem ne padaju?!"
  },
  {
    "surah_id": 84,
    "ayah_number": 22,
    "global_ayah_id": 5906,
    "translation": "Naprotiv, oni koji ne vjeruju poriču,"
  },
  {
    "surah_id": 84,
    "ayah_number": 23,
    "global_ayah_id": 5907,
    "translation": "a Allah najbolje zna šta oni u sebi kriju,"
  },
  {
    "surah_id": 84,
    "ayah_number": 24,
    "global_ayah_id": 5908,
    "translation": "zato im navijesti patnju bolnu!"
  },
  {
    "surah_id": 84,
    "ayah_number": 25,
    "global_ayah_id": 5909,
    "translation": "A oni koji budu vjerovali i dobra djela činili, imat će nagradu neprekidnu."
  }
]