[
  {
    "surah_id": 84,
    "ayah_number": 1,
    "global_ayah_id": 5885,
    "translation": "آنگاه كه آسمان زهم بشكافد،"
  },
  {
    "surah_id": 84,
    "ayah_number": 2,
    "global_ayah_id": 5886,
    "translation": "و پروردگارش را فرمان برد و [چنين‌] سزد."
  },
  {
    "surah_id": 84,
    "ayah_number": 3,
    "global_ayah_id": 5887,
    "translation": "و آنگاه كه زمين كشيده شود،"
  },
  {
    "surah_id": 84,
    "ayah_number": 4,
    "global_ayah_id": 5888,
    "translation": "و آنچه را كه در آن است بيرون افكند و تهى شود،"
  },
  {
    "surah_id": 84,
    "ayah_number": 5,
    "global_ayah_id": 5889,
    "translation": "و پروردگارش را فرمان برد و [چنين‌] سزد."
  },
  {
    "surah_id": 84,
    "ayah_number": 6,
    "global_ayah_id": 5890,
    "translation": "اى انسان، حقاً كه تو به سوى پروردگار خود بسختى در تلاشى، و او را ملاقات خواهى كرد."
  },
  {
    "surah_id": 84,
    "ayah_number": 7,
    "global_ayah_id": 5891,
    "translation": "اما كسى كه كارنامه‌اش به دست راستش داده شود،"
  },
  {
    "surah_id": 84,
    "ayah_number": 8,
    "global_ayah_id": 5892,
    "translation": "بزودى‌اش حسابى بس آسان كنند،"
  },
  {
    "surah_id": 84,
    "ayah_number": 9,
    "global_ayah_id": 5893,
    "translation": "و شادمان به سوى كسانش باز گردد."
  },
  {
    "surah_id": 84,
    "ayah_number": 10,
    "global_ayah_id": 5894,
    "translation": "و اما كسى كه كارنامه‌اش از پشت سرش به او داده شود،"
  },
  {
    "surah_id": 84,
    "ayah_number": 11,
    "global_ayah_id": 5895,
    "translation": "زودا كه هلاك [خويش‌] خواهد،"
  },
  {
    "surah_id": 84,
    "ayah_number": 12,
    "global_ayah_id": 5896,
    "translation": "و در آتش افروخته درآيد."
  },
  {
    "surah_id": 84,
    "ayah_number": 13,
    "global_ayah_id": 5897,
    "translation": "او در [ميان‌] خانواده خود شادمان بود."
  },
  {
    "surah_id": 84,
    "ayah_number": 14,
    "global_ayah_id": 5898,
    "translation": "او مى‌پنداشت كه هرگز برنخواهد گشت."
  },
  {
    "surah_id": 84,
    "ayah_number": 15,
    "global_ayah_id": 5899,
    "translation": "آرى، در حقيقت، پروردگارش به او بينا بود."
  },
  {
    "surah_id": 84,
    "ayah_number": 16,
    "global_ayah_id": 5900,
    "translation": "نه، نه، سوگند به شفق،"
  },
  {
    "surah_id": 84,
    "ayah_number": 17,
    "global_ayah_id": 5901,
    "translation": "سوگند به شب و آنچه [شب‌] فروپوشاند،"
  },
  {
    "surah_id": 84,
    "ayah_number": 18,
    "global_ayah_id": 5902,
    "translation": "سوگند به ماه چون [بَدر] تمام شود،"
  },
  {
    "surah_id": 84,
    "ayah_number": 19,
    "global_ayah_id": 5903,
    "translation": "كه قطعاً از حالى به حالى برخواهيد نشست."
  },
  {
    "surah_id": 84,
    "ayah_number": 20,
    "global_ayah_id": 5904,
    "translation": "پس چرا آنان باور نمى‌دارند؟"
  },
  {
    "surah_id": 84,
    "ayah_number": 21,
    "global_ayah_id": 5905,
    "translation": "و چون بر آنان قرآن تلاوت مى‌شود چهره بر خاك نمى‌سايند؟"
  },
  {
    "surah_id": 84,
    "ayah_number": 22,
    "global_ayah_id": 5906,
    "translation": "[نه!] بلكه آنان كه كفر ورزيده‌اند، تكذيب مى‌كنند."
  },
  {
    "surah_id": 84,
    "ayah_number": 23,
    "global_ayah_id": 5907,
    "translation": "و خدا به آنچه در سينه دارند داناتر است."
  },
  {
    "surah_id": 84,
    "ayah_number": 24,
    "global_ayah_id": 5908,
    "translation": "پس آنان را از عذابى دردناك خبر ده،"
  },
  {
    "surah_id": 84,
    "ayah_number": 25,
    "global_ayah_id": 5909,
    "translation": "مگر كسانى كه گرويده و كارهاى شايسته كرده‌اند، كه آنان را پاداشى بى‌منّت خواهد بود."
  }
]