[
  {
    "surah_id": 84,
    "ayah_number": 1,
    "global_ayah_id": 5885,
    "translation": "當天綻裂，"
  },
  {
    "surah_id": 84,
    "ayah_number": 2,
    "global_ayah_id": 5886,
    "translation": "聽從主命，而且宜於聽從的時候；"
  },
  {
    "surah_id": 84,
    "ayah_number": 3,
    "global_ayah_id": 5887,
    "translation": "當地展開，"
  },
  {
    "surah_id": 84,
    "ayah_number": 4,
    "global_ayah_id": 5888,
    "translation": "並拋其所懷，而且變為空虛，"
  },
  {
    "surah_id": 84,
    "ayah_number": 5,
    "global_ayah_id": 5889,
    "translation": "聽從主命，而且宜於聽從的時候；"
  },
  {
    "surah_id": 84,
    "ayah_number": 6,
    "global_ayah_id": 5890,
    "translation": "人啊！你必定勉力工作，直到會見你的主，你將看到自己的勞績。"
  },
  {
    "surah_id": 84,
    "ayah_number": 7,
    "global_ayah_id": 5891,
    "translation": "至於用右手接過功過簿者，"
  },
  {
    "surah_id": 84,
    "ayah_number": 8,
    "global_ayah_id": 5892,
    "translation": "將受簡易的稽核，"
  },
  {
    "surah_id": 84,
    "ayah_number": 9,
    "global_ayah_id": 5893,
    "translation": "而興高采烈地返於他的家屬；"
  },
  {
    "surah_id": 84,
    "ayah_number": 10,
    "global_ayah_id": 5894,
    "translation": "至於從背後接受功過簿者，"
  },
  {
    "surah_id": 84,
    "ayah_number": 11,
    "global_ayah_id": 5895,
    "translation": "將叫苦連天，"
  },
  {
    "surah_id": 84,
    "ayah_number": 12,
    "global_ayah_id": 5896,
    "translation": "入於烈火之中，"
  },
  {
    "surah_id": 84,
    "ayah_number": 13,
    "global_ayah_id": 5897,
    "translation": "從前他在家屬間原是快樂的，"
  },
  {
    "surah_id": 84,
    "ayah_number": 14,
    "global_ayah_id": 5898,
    "translation": "他已猜想他絕不會歸於主。"
  },
  {
    "surah_id": 84,
    "ayah_number": 15,
    "global_ayah_id": 5899,
    "translation": "不然，他的主，原是鑒察他的。"
  },
  {
    "surah_id": 84,
    "ayah_number": 16,
    "global_ayah_id": 5900,
    "translation": "我以晚霞盟誓，"
  },
  {
    "surah_id": 84,
    "ayah_number": 17,
    "global_ayah_id": 5901,
    "translation": "以黑夜及其包羅萬象的盟誓，"
  },
  {
    "surah_id": 84,
    "ayah_number": 18,
    "global_ayah_id": 5902,
    "translation": "以圓滿時的月亮盟誓，"
  },
  {
    "surah_id": 84,
    "ayah_number": 19,
    "global_ayah_id": 5903,
    "translation": "你們必定遭遇重重的災難。"
  },
  {
    "surah_id": 84,
    "ayah_number": 20,
    "global_ayah_id": 5904,
    "translation": "他們怎能不信道呢？"
  },
  {
    "surah_id": 84,
    "ayah_number": 21,
    "global_ayah_id": 5905,
    "translation": "當別人對他們宣讀《古蘭經》的時候，他們怎麼不叩頭呢？"
  },
  {
    "surah_id": 84,
    "ayah_number": 22,
    "global_ayah_id": 5906,
    "translation": "不然，不信道的人們，是否認真理的，"
  },
  {
    "surah_id": 84,
    "ayah_number": 23,
    "global_ayah_id": 5907,
    "translation": "真主全知道他們心中隱藏的東西，"
  },
  {
    "surah_id": 84,
    "ayah_number": 24,
    "global_ayah_id": 5908,
    "translation": "故你當以一種痛苦的刑罰向他們報喜，"
  },
  {
    "surah_id": 84,
    "ayah_number": 25,
    "global_ayah_id": 5909,
    "translation": "惟信道而且行善的人們，將受不斷的報酬。"
  }
]