[
  {
    "surah_id": 78,
    "ayah_number": 1,
    "global_ayah_id": 5673,
    "translation": "О чем они друг друга вопрошают?"
  },
  {
    "surah_id": 78,
    "ayah_number": 2,
    "global_ayah_id": 5674,
    "translation": "О Превеликой Вести,"
  },
  {
    "surah_id": 78,
    "ayah_number": 3,
    "global_ayah_id": 5675,
    "translation": "Единого согласья о которой нет."
  },
  {
    "surah_id": 78,
    "ayah_number": 4,
    "global_ayah_id": 5676,
    "translation": "Поистине, познать им скоро предстоит!"
  },
  {
    "surah_id": 78,
    "ayah_number": 5,
    "global_ayah_id": 5677,
    "translation": "Поистине, поистине, познанье близко!"
  },
  {
    "surah_id": 78,
    "ayah_number": 6,
    "global_ayah_id": 5678,
    "translation": "Но разве Мы не разостлали землю вам Широкой колыбелью?"
  },
  {
    "surah_id": 78,
    "ayah_number": 7,
    "global_ayah_id": 5679,
    "translation": "Столпами горы не воздвигли?"
  },
  {
    "surah_id": 78,
    "ayah_number": 8,
    "global_ayah_id": 5680,
    "translation": "Мы пАрами создАли вас,"
  },
  {
    "surah_id": 78,
    "ayah_number": 9,
    "global_ayah_id": 5681,
    "translation": "А для покоя ниспослали сон,"
  },
  {
    "surah_id": 78,
    "ayah_number": 10,
    "global_ayah_id": 5682,
    "translation": "Защитным кровом ночь спустили,"
  },
  {
    "surah_id": 78,
    "ayah_number": 11,
    "global_ayah_id": 5683,
    "translation": "Для созиданий сотворили день."
  },
  {
    "surah_id": 78,
    "ayah_number": 12,
    "global_ayah_id": 5684,
    "translation": "Построили над вами семь твердей,"
  },
  {
    "surah_id": 78,
    "ayah_number": 13,
    "global_ayah_id": 5685,
    "translation": "И поместили в них пылающий светильник,"
  },
  {
    "surah_id": 78,
    "ayah_number": 14,
    "global_ayah_id": 5686,
    "translation": "И шлем из облаков обильные дожди,"
  },
  {
    "surah_id": 78,
    "ayah_number": 15,
    "global_ayah_id": 5687,
    "translation": "Что зелень и зерно взрастят,"
  },
  {
    "surah_id": 78,
    "ayah_number": 16,
    "global_ayah_id": 5688,
    "translation": "Прекрасные сады подымут."
  },
  {
    "surah_id": 78,
    "ayah_number": 17,
    "global_ayah_id": 5689,
    "translation": "Поистине, День Разделенья уж назначен -"
  },
  {
    "surah_id": 78,
    "ayah_number": 18,
    "global_ayah_id": 5690,
    "translation": "Тот День, Когда раздастся трубный глас И толпами пойдете вы;"
  },
  {
    "surah_id": 78,
    "ayah_number": 19,
    "global_ayah_id": 5691,
    "translation": "Вратами распахнутся небеса,"
  },
  {
    "surah_id": 78,
    "ayah_number": 20,
    "global_ayah_id": 5692,
    "translation": "Исчезнут горы, словно в мираже."
  },
  {
    "surah_id": 78,
    "ayah_number": 21,
    "global_ayah_id": 5693,
    "translation": "Поистине, засадою предстанет Ад,"
  },
  {
    "surah_id": 78,
    "ayah_number": 22,
    "global_ayah_id": 5694,
    "translation": "Обителью предназначенья для неверных."
  },
  {
    "surah_id": 78,
    "ayah_number": 23,
    "global_ayah_id": 5695,
    "translation": "И пребывать им там навечно,"
  },
  {
    "surah_id": 78,
    "ayah_number": 24,
    "global_ayah_id": 5696,
    "translation": "И не вкушать им там ни влаги, ни прохлады, \"Падите ниц в молитве (перед Богом)!\", Они не внемлют."
  },
  {
    "surah_id": 78,
    "ayah_number": 25,
    "global_ayah_id": 5697,
    "translation": "Помимо пития из жидкости кипящей И темного питья из нечистот,"
  },
  {
    "surah_id": 78,
    "ayah_number": 26,
    "global_ayah_id": 5698,
    "translation": "Что станет им достойным возданьем, -"
  },
  {
    "surah_id": 78,
    "ayah_number": 27,
    "global_ayah_id": 5699,
    "translation": "Ведь на расплату (за свои грехи) Они надежд не возлагали"
  },
  {
    "surah_id": 78,
    "ayah_number": 28,
    "global_ayah_id": 5700,
    "translation": "И, сея ложь, отвергли все знаменья Наши."
  },
  {
    "surah_id": 78,
    "ayah_number": 29,
    "global_ayah_id": 5701,
    "translation": "Мы ж все сочли и записали."
  },
  {
    "surah_id": 78,
    "ayah_number": 30,
    "global_ayah_id": 5702,
    "translation": "Вкусите же (награду за свои грехи) - И никакого усиления удач и благ Мы (в жизни этой) вам не предоставим, Помимо возрастания (в Аду) всех наказаний."
  },
  {
    "surah_id": 78,
    "ayah_number": 31,
    "global_ayah_id": 5703,
    "translation": "Поистине, для почитателей Аллаха В Раю - пристанище благое:"
  },
  {
    "surah_id": 78,
    "ayah_number": 32,
    "global_ayah_id": 5704,
    "translation": "Сады и виноградники,"
  },
  {
    "surah_id": 78,
    "ayah_number": 33,
    "global_ayah_id": 5705,
    "translation": "И девы-сверстницы с округлыми грудями,"
  },
  {
    "surah_id": 78,
    "ayah_number": 34,
    "global_ayah_id": 5706,
    "translation": "И чаши, полные до края."
  },
  {
    "surah_id": 78,
    "ayah_number": 35,
    "global_ayah_id": 5707,
    "translation": "Они не встретят там Ни пустословия, ни лжи -"
  },
  {
    "surah_id": 78,
    "ayah_number": 36,
    "global_ayah_id": 5708,
    "translation": "Как воздаянье Господа и дар Его (сполна) -"
  },
  {
    "surah_id": 78,
    "ayah_number": 37,
    "global_ayah_id": 5709,
    "translation": "От Господа земли и неба И того, что между ними суще, - От Милосердного! С Которым Речь держать они не смеют."
  },
  {
    "surah_id": 78,
    "ayah_number": 38,
    "global_ayah_id": 5710,
    "translation": "В тот День Рядами встанут ангелы и Дух Святой, И речь глаголать будут те, Кому дозволит Милосердный. И будут праведны их речи."
  },
  {
    "surah_id": 78,
    "ayah_number": 39,
    "global_ayah_id": 5711,
    "translation": "День этот - Истина (Господнего Завета), И тот, кто этого желает, Пойдет путем возврата к Богу своему!"
  },
  {
    "surah_id": 78,
    "ayah_number": 40,
    "global_ayah_id": 5712,
    "translation": "Поистине, предупрежденье было вам О наказанье близком (в Судный День), - В тот День, Когда вы сможете узреть Деянья те, что ваши руки совершили. А тот, кто верой пренебрег, воскликнет: \"О, горе мне! Уж лучше быть мне прахом!\""
  }
]