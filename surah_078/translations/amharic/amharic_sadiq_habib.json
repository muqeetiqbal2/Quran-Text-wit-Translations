[
  {
    "surah_id": 78,
    "ayah_number": 1,
    "global_ayah_id": 5673,
    "translation": "ከምን ነገር ይጠያየቃሉ?"
  },
  {
    "surah_id": 78,
    "ayah_number": 2,
    "global_ayah_id": 5674,
    "translation": "ከታላቁ ዜና (ከቁርኣን ይጠያየቃሉ)፡፡"
  },
  {
    "surah_id": 78,
    "ayah_number": 3,
    "global_ayah_id": 5675,
    "translation": "ከዚያ እነርሱ በእርሱ የተለያዩበት ከኾነው፡፡"
  },
  {
    "surah_id": 78,
    "ayah_number": 4,
    "global_ayah_id": 5676,
    "translation": "ይከልከሉ፤ ወደፊት (የሚደርስበቸውን) በእርግጥ ያውቃሉ፡፡"
  },
  {
    "surah_id": 78,
    "ayah_number": 5,
    "global_ayah_id": 5677,
    "translation": "ከዚያም ይከልከሉ፤ ወደፊት ያውቃሉ፡፡"
  },
  {
    "surah_id": 78,
    "ayah_number": 6,
    "global_ayah_id": 5678,
    "translation": "ምድርን ምንጣፍ አላደረግንምን?"
  },
  {
    "surah_id": 78,
    "ayah_number": 7,
    "global_ayah_id": 5679,
    "translation": "ጋራዎችንም ችካሎች አላደረግንምን?"
  },
  {
    "surah_id": 78,
    "ayah_number": 8,
    "global_ayah_id": 5680,
    "translation": "ብዙ ዓይነቶችም አድርገን ፈጠርናችሁ፡፡"
  },
  {
    "surah_id": 78,
    "ayah_number": 9,
    "global_ayah_id": 5681,
    "translation": "እንቅልፋችሁንም ዕረፍት አደረግን፡፡"
  },
  {
    "surah_id": 78,
    "ayah_number": 10,
    "global_ayah_id": 5682,
    "translation": "ሌሊቱንም ልባስ አደረግን፡፡"
  },
  {
    "surah_id": 78,
    "ayah_number": 11,
    "global_ayah_id": 5683,
    "translation": "ቀኑንም (ለኑሮ) መስሪያ አደረግን፡፡"
  },
  {
    "surah_id": 78,
    "ayah_number": 12,
    "global_ayah_id": 5684,
    "translation": "ከበላያችሁም ሰባትን ብርቱዎች (ሰማያት) ገነባን፡፡"
  },
  {
    "surah_id": 78,
    "ayah_number": 13,
    "global_ayah_id": 5685,
    "translation": "አንጸባራቂ ብርሃንንም አደረግን፡፡"
  },
  {
    "surah_id": 78,
    "ayah_number": 14,
    "global_ayah_id": 5686,
    "translation": "ከአረገዙት ደመናዎችም ተንቧቢ ውሃን አወረድን፡፡"
  },
  {
    "surah_id": 78,
    "ayah_number": 15,
    "global_ayah_id": 5687,
    "translation": "በእርሱ እኽልንና ቅጠላ ቅጠልን እናወጣ ዘንድ (አወረድን)፡፡"
  },
  {
    "surah_id": 78,
    "ayah_number": 16,
    "global_ayah_id": 5688,
    "translation": "የተቆላለፉ አትክልቶችንም፡፡"
  },
  {
    "surah_id": 78,
    "ayah_number": 17,
    "global_ayah_id": 5689,
    "translation": "የመለያው ቀን የተወሰነ ጊዜ ነው፡፡"
  },
  {
    "surah_id": 78,
    "ayah_number": 18,
    "global_ayah_id": 5690,
    "translation": "በቀንዱ በሚነፋና የተለያዩ ጭፍሮች ኾናችሁ በምትመጡ ቀን ነው፡፡"
  },
  {
    "surah_id": 78,
    "ayah_number": 19,
    "global_ayah_id": 5691,
    "translation": "ሰማይም በምትከፈትና (ባለ) ደጃፎችም በምትኾንበት፡፡"
  },
  {
    "surah_id": 78,
    "ayah_number": 20,
    "global_ayah_id": 5692,
    "translation": "ጋራዎችም በሚነዱበት (እንደ) ሲሪብዱም በሚኾኑበት (ቀን) ነው፡፡"
  },
  {
    "surah_id": 78,
    "ayah_number": 21,
    "global_ayah_id": 5693,
    "translation": "ገሀነም መጠባበቂያ (ስፍራ) ናት፡፡"
  },
  {
    "surah_id": 78,
    "ayah_number": 22,
    "global_ayah_id": 5694,
    "translation": "ለሕግ ተላላፊዎች መመለሻ ስትኾን፡፡"
  },
  {
    "surah_id": 78,
    "ayah_number": 23,
    "global_ayah_id": 5695,
    "translation": "በውስጧ ብዙን ዘመናት ነዋሪዎች ሲኾኑ፤"
  },
  {
    "surah_id": 78,
    "ayah_number": 24,
    "global_ayah_id": 5696,
    "translation": "በውስጧ ቅዝቃዜንም መጠጥንም አይቀምሱም፡፡"
  },
  {
    "surah_id": 78,
    "ayah_number": 25,
    "global_ayah_id": 5697,
    "translation": "ግን ሙቅ ውሃንና እዥን (ይቀምሳሉ)፡፡"
  },
  {
    "surah_id": 78,
    "ayah_number": 26,
    "global_ayah_id": 5698,
    "translation": "ተስማሚን ምንዳ ይምመነዳሉ፡፡"
  },
  {
    "surah_id": 78,
    "ayah_number": 27,
    "global_ayah_id": 5699,
    "translation": "እነርሱ ምርመራን የማይፈሩ ነበሩና፡፡"
  },
  {
    "surah_id": 78,
    "ayah_number": 28,
    "global_ayah_id": 5700,
    "translation": "በአንቀጾቻችንም ማስተባበልን አስተባበሉና፡፡"
  },
  {
    "surah_id": 78,
    "ayah_number": 29,
    "global_ayah_id": 5701,
    "translation": "ነገሩንም ሁሉ የተጻፈ ሲኾን አጠቃለልነው፡፡"
  },
  {
    "surah_id": 78,
    "ayah_number": 30,
    "global_ayah_id": 5702,
    "translation": "ቅመሱም ቅጣትንም እንጅ (ሌላን) አንጨምራችሁም (ይባላሉ)፡፡"
  },
  {
    "surah_id": 78,
    "ayah_number": 31,
    "global_ayah_id": 5703,
    "translation": "ለጥንቁቆቹ መዳኛ ስፍራ አልላቸው፡፡"
  },
  {
    "surah_id": 78,
    "ayah_number": 32,
    "global_ayah_id": 5704,
    "translation": "አትክልቶችና ወይኖችም፡፡"
  },
  {
    "surah_id": 78,
    "ayah_number": 33,
    "global_ayah_id": 5705,
    "translation": "እኩያዎች የኾኑ ጡተ ጉቻማዎችም፡፡"
  },
  {
    "surah_id": 78,
    "ayah_number": 34,
    "global_ayah_id": 5706,
    "translation": "የተሞሉ ብርጭቆዎችም፡፡"
  },
  {
    "surah_id": 78,
    "ayah_number": 35,
    "global_ayah_id": 5707,
    "translation": "በውስጧ ትርፍ ቃልንም ማስዋሸትንም አይሰሙም፡፡"
  },
  {
    "surah_id": 78,
    "ayah_number": 36,
    "global_ayah_id": 5708,
    "translation": "ከጌታህ የኾነን ምንዳ በቂ ስጦታን (ተሰጡ)፡፡"
  },
  {
    "surah_id": 78,
    "ayah_number": 37,
    "global_ayah_id": 5709,
    "translation": "የሰማያትና የምድር በመካከላቸውም ያለው ሁሉ ጌታ በጣም አዛኝ ከኾነው (ተመነዱ)፡፡ ከእርሱ ጋር መነጋገርን አይችሉም፡፡"
  },
  {
    "surah_id": 78,
    "ayah_number": 38,
    "global_ayah_id": 5710,
    "translation": "መንፈሱ (ጂብሪል) መላእክቶቹም የተሰለፉ ኾነው በሚቆሙ ቀን አል-ረሕማን ለእርሱ የፈቀደለትና ትክክለኛን ቃል ያለ ሰው ቢኾን እንጅ (መነጋገርን አይችሉም)፡፡"
  },
  {
    "surah_id": 78,
    "ayah_number": 39,
    "global_ayah_id": 5711,
    "translation": "ይህ የተረጋገጠው ቀን ነው፡፡ የሻም ሰው ወደ ጌታው መመለስን ይይዛል፡፡"
  },
  {
    "surah_id": 78,
    "ayah_number": 40,
    "global_ayah_id": 5712,
    "translation": "እኛ ሰው ሁሉ እጆቹ ያስቀደሙትን በሚያይበትና ከሓዲውም ዋ ምኞቴ! ምንነው ዐፈር በኾንኩ በሚልበት ቀን ቅርብ የኾነን ቅጣት አስጠነቀቅናችሁ፡፡"
  }
]