[
  {
    "surah_id": 78,
    "ayah_number": 1,
    "global_ayah_id": 5673,
    "translation": "이 말 이후에 그들은 어떤 메세지를 믿으려 하느뇨"
  },
  {
    "surah_id": 78,
    "ayah_number": 2,
    "global_ayah_id": 5674,
    "translation": "위대한 소식에 관하여 질문 하느뇨"
  },
  {
    "surah_id": 78,
    "ayah_number": 3,
    "global_ayah_id": 5675,
    "translation": "그것에 관하여 그들은 의견을달리하나"
  },
  {
    "surah_id": 78,
    "ayah_number": 4,
    "global_ayah_id": 5676,
    "translation": "실로 그들은 곧 알게 되리라"
  },
  {
    "surah_id": 78,
    "ayah_number": 5,
    "global_ayah_id": 5677,
    "translation": "실로 그들은 곧 알게 되리라"
  },
  {
    "surah_id": 78,
    "ayah_number": 6,
    "global_ayah_id": 5678,
    "translation": "하나님이 대지를 두매 넓다 랗게 두셨으며"
  },
  {
    "surah_id": 78,
    "ayah_number": 7,
    "global_ayah_id": 5679,
    "translation": "산들을 두매 기둥으로 두었고"
  },
  {
    "surah_id": 78,
    "ayah_number": 8,
    "global_ayah_id": 5680,
    "translation": "너희를 창조하매 자웅으로 두 셨으며"
  },
  {
    "surah_id": 78,
    "ayah_number": 9,
    "global_ayah_id": 5681,
    "translation": "수면을 두매 너희 휴식을 위 해 두었고"
  },
  {
    "surah_id": 78,
    "ayah_number": 10,
    "global_ayah_id": 5682,
    "translation": "밤을 두매 의상으로 두었으 며"
  },
  {
    "surah_id": 78,
    "ayah_number": 11,
    "global_ayah_id": 5683,
    "translation": "낮을 두매 일용할 양식을 얻도록 두었노라"
  },
  {
    "surah_id": 78,
    "ayah_number": 12,
    "global_ayah_id": 5684,
    "translation": "하나님은 너희위에 칠천을 두었으며"
  },
  {
    "surah_id": 78,
    "ayah_number": 13,
    "global_ayah_id": 5685,
    "translation": "그 안에 찬란한 빛을 두고"
  },
  {
    "surah_id": 78,
    "ayah_number": 14,
    "global_ayah_id": 5686,
    "translation": "풍부한 비구름을 보내어"
  },
  {
    "surah_id": 78,
    "ayah_number": 15,
    "global_ayah_id": 5687,
    "translation": "이로 하여 곡식과 채소들을 생산케 하고"
  },
  {
    "surah_id": 78,
    "ayah_number": 16,
    "global_ayah_id": 5688,
    "translation": "울창한 정원들이 되도록 하 지 아니 했더뇨"
  },
  {
    "surah_id": 78,
    "ayah_number": 17,
    "global_ayah_id": 5689,
    "translation": "실로 분류하는 그날은 정하 여진 것으로"
  },
  {
    "surah_id": 78,
    "ayah_number": 18,
    "global_ayah_id": 5690,
    "translation": "나팔이 울리는 그날 너희는 떼를 지어 앞으로 나오게 되며"
  },
  {
    "surah_id": 78,
    "ayah_number": 19,
    "global_ayah_id": 5691,
    "translation": "하늘은 문이 열리는 것처럼 열리고"
  },
  {
    "surah_id": 78,
    "ayah_number": 20,
    "global_ayah_id": 5692,
    "translation": "산들은 신기루처럼 사라지며"
  },
  {
    "surah_id": 78,
    "ayah_number": 21,
    "global_ayah_id": 5693,
    "translation": "지옥은 기다리고 있으니"
  },
  {
    "surah_id": 78,
    "ayah_number": 22,
    "global_ayah_id": 5694,
    "translation": "사악한 자들을 위한 목적지라"
  },
  {
    "surah_id": 78,
    "ayah_number": 23,
    "global_ayah_id": 5695,
    "translation": "그들은 그곳에서 영주하니라"
  },
  {
    "surah_id": 78,
    "ayah_number": 24,
    "global_ayah_id": 5696,
    "translation": "그들은 그곳에서 시원함도 맛보지 못할 것이며 마실 음료수 도 없으며"
  },
  {
    "surah_id": 78,
    "ayah_number": 25,
    "global_ayah_id": 5697,
    "translation": "오직 끓어 오르는 액체와 검 고 어두운 혹독한 액체 뿐으로"
  },
  {
    "surah_id": 78,
    "ayah_number": 26,
    "global_ayah_id": 5698,
    "translation": "이것이 그들을 위한 적절한 보상이라"
  },
  {
    "surah_id": 78,
    "ayah_number": 27,
    "global_ayah_id": 5699,
    "translation": "그들은 그들의 행위에 대한 어떤 계산도 두려워 하지 아니하 고"
  },
  {
    "surah_id": 78,
    "ayah_number": 28,
    "global_ayah_id": 5700,
    "translation": "하나님의 말씀을 거짓이라 부정하였으매"
  },
  {
    "surah_id": 78,
    "ayah_number": 29,
    "global_ayah_id": 5701,
    "translation": "하나님은 모든 것을 기륵보관 하시니라"
  },
  {
    "surah_id": 78,
    "ayah_number": 30,
    "global_ayah_id": 5702,
    "translation": "그러므로 너희 행위의 결과 들을 맛보라 응벌 외에는 너희에 게 더하여주지 아니 하리라"
  },
  {
    "surah_id": 78,
    "ayah_number": 31,
    "global_ayah_id": 5703,
    "translation": "그러나 의로운 자들은 승리 한 것이 있나니"
  },
  {
    "surah_id": 78,
    "ayah_number": 32,
    "global_ayah_id": 5704,
    "translation": "천국과 포도들이 있고"
  },
  {
    "surah_id": 78,
    "ayah_number": 33,
    "global_ayah_id": 5705,
    "translation": "나이가 같은 청순한 배우자 가 있으며"
  },
  {
    "surah_id": 78,
    "ayah_number": 34,
    "global_ayah_id": 5706,
    "translation": "넘치는 잔이 있도다"
  },
  {
    "surah_id": 78,
    "ayah_number": 35,
    "global_ayah_id": 5707,
    "translation": "그들은 그곳에서 어떤 무익 한 대화나 거짓된 말도 듣지 아니 하며"
  },
  {
    "surah_id": 78,
    "ayah_number": 36,
    "global_ayah_id": 5708,
    "translation": "주님의 계산에 따라 보상을 받노라"
  },
  {
    "surah_id": 78,
    "ayah_number": 37,
    "global_ayah_id": 5709,
    "translation": "하늘과 대지와 그 사이에 있 는 만물의 주님이신 가장 자비로 운 하나님께 어느 누구도 그분의 능력에 견주지 못하리라"
  },
  {
    "surah_id": 78,
    "ayah_number": 38,
    "global_ayah_id": 5710,
    "translation": "영혼과 천사들이 앞으로 줄 지어 서는 그날 자비로우신 하나님의 허락을 얻어 사실을 말할 자 외에는 어느 누구도 말할 수 없나니"
  },
  {
    "surah_id": 78,
    "ayah_number": 39,
    "global_ayah_id": 5711,
    "translation": "그날이 진리의 날이 될 것이라 그러므로 원하는 자는 그로 하여금 주님께 귀의토록 하리라"
  },
  {
    "surah_id": 78,
    "ayah_number": 40,
    "global_ayah_id": 5712,
    "translation": "실로 하나님께서 너희에게 다가올 응벌에 관하여 경고했나니인간은 그가 행한 그 행위들을 지켜볼 그날 불신자들은 저에게 재 앙이 있나니 차라리 \\xC3D으로 돌아 갔으면 하고 말하리라"
  }
]