[
  {
    "surah_id": 78,
    "ayah_number": 1,
    "global_ayah_id": 5673,
    "translation": "Нима ҳақида сўрашади?"
  },
  {
    "surah_id": 78,
    "ayah_number": 2,
    "global_ayah_id": 5674,
    "translation": "Улкан, муҳим хабар ҳақида (сўрашади)."
  },
  {
    "surah_id": 78,
    "ayah_number": 3,
    "global_ayah_id": 5675,
    "translation": "Шундай хабарки, у(мушрик)лар) унинг ҳақида ихтилоф қиларлар."
  },
  {
    "surah_id": 78,
    "ayah_number": 4,
    "global_ayah_id": 5676,
    "translation": "Йўқ! Улар тезда биларлар!"
  },
  {
    "surah_id": 78,
    "ayah_number": 5,
    "global_ayah_id": 5677,
    "translation": "Яна йўқ! Улар тезда биларлар! (Мушриклар азобни тортганларида қайта тирилиш нима эканлигини, унинг бўлиши ҳеч шубҳасиз ҳақ эканини албатта биладилар.)"
  },
  {
    "surah_id": 78,
    "ayah_number": 6,
    "global_ayah_id": 5678,
    "translation": "Ерни тўшаб қўймадикми?"
  },
  {
    "surah_id": 78,
    "ayah_number": 7,
    "global_ayah_id": 5679,
    "translation": "Ва тоғларни қозиқ (қилиб қўймадикми?)."
  },
  {
    "surah_id": 78,
    "ayah_number": 8,
    "global_ayah_id": 5680,
    "translation": "Ва сизларни жуфт қилиб яратдик."
  },
  {
    "surah_id": 78,
    "ayah_number": 9,
    "global_ayah_id": 5681,
    "translation": "Ва уйқуларингизни роҳат қилиб қўйдик."
  },
  {
    "surah_id": 78,
    "ayah_number": 10,
    "global_ayah_id": 5682,
    "translation": "Ва кечасини либос қилиб қўйдик."
  },
  {
    "surah_id": 78,
    "ayah_number": 11,
    "global_ayah_id": 5683,
    "translation": "Ва кундузни тириклик қилдик."
  },
  {
    "surah_id": 78,
    "ayah_number": 12,
    "global_ayah_id": 5684,
    "translation": "Тепаларнгизга етти мустаҳкам (осмон)ни бино қилдик."
  },
  {
    "surah_id": 78,
    "ayah_number": 13,
    "global_ayah_id": 5685,
    "translation": "Ва шуъла таратувчи чироқ ҳам қилдик."
  },
  {
    "surah_id": 78,
    "ayah_number": 14,
    "global_ayah_id": 5686,
    "translation": "Ва сиқилган(булут)лардан оқувчи сувлар туширдик."
  },
  {
    "surah_id": 78,
    "ayah_number": 15,
    "global_ayah_id": 5687,
    "translation": "У(сув) билан дон ва наботот чиқаришимиз учун."
  },
  {
    "surah_id": 78,
    "ayah_number": 16,
    "global_ayah_id": 5688,
    "translation": "Ва дарахтлари бир-бирига киришган бўстонлар."
  },
  {
    "surah_id": 78,
    "ayah_number": 17,
    "global_ayah_id": 5689,
    "translation": "Албатта, ажрим куни вақти белгиланган эди."
  },
  {
    "surah_id": 78,
    "ayah_number": 18,
    "global_ayah_id": 5690,
    "translation": "У кунда сурга пуфланур ва сизлар тўп-тўп бўлиб келурсизлар."
  },
  {
    "surah_id": 78,
    "ayah_number": 19,
    "global_ayah_id": 5691,
    "translation": "Осмон ёрилиб, эшик-эшиклар очилур."
  },
  {
    "surah_id": 78,
    "ayah_number": 20,
    "global_ayah_id": 5692,
    "translation": "Тоғлар ўрнидан кўчирилиб, саробга айланур."
  },
  {
    "surah_id": 78,
    "ayah_number": 21,
    "global_ayah_id": 5693,
    "translation": "Албатта, жаҳаннам пойлаб турувчи эди."
  },
  {
    "surah_id": 78,
    "ayah_number": 22,
    "global_ayah_id": 5694,
    "translation": "Туғёнга кетганларга қайтар жойдир."
  },
  {
    "surah_id": 78,
    "ayah_number": 23,
    "global_ayah_id": 5695,
    "translation": "Улар унда замонлар бўйи қолувчилардир."
  },
  {
    "surah_id": 78,
    "ayah_number": 24,
    "global_ayah_id": 5696,
    "translation": "Улар унда совуқни ҳам, шаробни ҳам татий олмаслар."
  },
  {
    "surah_id": 78,
    "ayah_number": 25,
    "global_ayah_id": 5697,
    "translation": "Магар қайноқ сув ва йирингни (татирлар)."
  },
  {
    "surah_id": 78,
    "ayah_number": 26,
    "global_ayah_id": 5698,
    "translation": "Мувофиқ жазо ўлароқ."
  },
  {
    "surah_id": 78,
    "ayah_number": 27,
    "global_ayah_id": 5699,
    "translation": "Чунки улар ҳисоб-китоб бўлишига ишонмасдилар."
  },
  {
    "surah_id": 78,
    "ayah_number": 28,
    "global_ayah_id": 5700,
    "translation": "Ва Бизнинг оятлариимизни ёлғон дейишган эди, ёлғон!."
  },
  {
    "surah_id": 78,
    "ayah_number": 29,
    "global_ayah_id": 5701,
    "translation": "Биз барча нарсани китобга жамлаб қўйганмиз."
  },
  {
    "surah_id": 78,
    "ayah_number": 30,
    "global_ayah_id": 5702,
    "translation": "Бас, татиб кўринглар, сизларга азобдан бошқа ҳеч нарсани зиёда қилмасмиз."
  },
  {
    "surah_id": 78,
    "ayah_number": 31,
    "global_ayah_id": 5703,
    "translation": "Албатта, тақводорларга ютуқ бордир:"
  },
  {
    "surah_id": 78,
    "ayah_number": 32,
    "global_ayah_id": 5704,
    "translation": "Боғ-роғлар, узумзорлар бордир."
  },
  {
    "surah_id": 78,
    "ayah_number": 33,
    "global_ayah_id": 5705,
    "translation": "Ва янги бўйи етган бир хил ёшдаги қизлар бордир."
  },
  {
    "surah_id": 78,
    "ayah_number": 34,
    "global_ayah_id": 5706,
    "translation": "Ва тўлдирилган қадаҳлар бордир."
  },
  {
    "surah_id": 78,
    "ayah_number": 35,
    "global_ayah_id": 5707,
    "translation": "У ерда бекорчи гапларни ҳам, ёлғон гапларни ҳам эшитмаслар."
  },
  {
    "surah_id": 78,
    "ayah_number": 36,
    "global_ayah_id": 5708,
    "translation": "Роббингдан мукофот, совға ҳисобидандир."
  },
  {
    "surah_id": 78,
    "ayah_number": 37,
    "global_ayah_id": 5709,
    "translation": "У осмонлар, ер ва уларнинг орасидаги барча нарсаларнинг Роббиси, Роҳмандир, Унинг ҳузурида ҳеч ким хитоб қилишга қодир бўлмас."
  },
  {
    "surah_id": 78,
    "ayah_number": 38,
    "global_ayah_id": 5710,
    "translation": "Ўша кунда Руҳ ва фаришталар саф бўлиб турадир. Роҳман изн берганлар ва тўғри сўзлаганлардан ўзгалар гапира олмаслар."
  },
  {
    "surah_id": 78,
    "ayah_number": 39,
    "global_ayah_id": 5711,
    "translation": "У ҳақ кундир. Ким хоҳласа, ўз Роббисига қайтар йўл оладир."
  },
  {
    "surah_id": 78,
    "ayah_number": 40,
    "global_ayah_id": 5712,
    "translation": "Албатта, Биз сизларни яқин келажакдаги азобдан қўрқитдик. У кунда, ҳар киши (қўли) тақдим қилган нарсага назар соладир. Ва кофир «кошки тупроқ бўлиб кетсам», –дейдир."
  }
]