[
  {
    "surah_id": 78,
    "ayah_number": 1,
    "global_ayah_id": 5673,
    "translation": "എന്തിനെപ്പറ്റിയാണ് അവര്‍ പരസ്പരം ചോദിച്ചു കൊണ്ടിരിക്കുന്നത്‌?"
  },
  {
    "surah_id": 78,
    "ayah_number": 2,
    "global_ayah_id": 5674,
    "translation": "ആ മഹത്തായ വൃത്താന്തത്തെപ്പറ്റി."
  },
  {
    "surah_id": 78,
    "ayah_number": 3,
    "global_ayah_id": 5675,
    "translation": "അവര്‍ ഏതൊരു കാര്യത്തില്‍ അഭിപ്രായവ്യത്യാസത്തിലായി ക്കൊണ്ടിരിക്കുന്നുവോ അതിനെപ്പറ്റി."
  },
  {
    "surah_id": 78,
    "ayah_number": 4,
    "global_ayah_id": 5676,
    "translation": "നിസ്സംശയം; അവര്‍ വഴിയെ അറിഞ്ഞു കൊള്ളും."
  },
  {
    "surah_id": 78,
    "ayah_number": 5,
    "global_ayah_id": 5677,
    "translation": "വീണ്ടും നിസ്സംശയം; അവര്‍ വഴിയെ അറിഞ്ഞു കൊള്ളും."
  },
  {
    "surah_id": 78,
    "ayah_number": 6,
    "global_ayah_id": 5678,
    "translation": "ഭൂമിയെ നാം ഒരു വിരിപ്പാക്കിയില്ലേ?"
  },
  {
    "surah_id": 78,
    "ayah_number": 7,
    "global_ayah_id": 5679,
    "translation": "പര്‍വ്വതങ്ങളെ ആണികളാക്കുകയും (ചെയ്തില്ലേ?)"
  },
  {
    "surah_id": 78,
    "ayah_number": 8,
    "global_ayah_id": 5680,
    "translation": "നിങ്ങളെ നാം ഇണകളായി സൃഷ്ടിക്കുകയും ചെയ്തിരിക്കുന്നു."
  },
  {
    "surah_id": 78,
    "ayah_number": 9,
    "global_ayah_id": 5681,
    "translation": "നിങ്ങളുടെ ഉറക്കത്തെ നാം വിശ്രമമാക്കുകയും ചെയ്തിരിക്കുന്നു."
  },
  {
    "surah_id": 78,
    "ayah_number": 10,
    "global_ayah_id": 5682,
    "translation": "രാത്രിയെ നാം ഒരു വസ്ത്രമാക്കുകയും,"
  },
  {
    "surah_id": 78,
    "ayah_number": 11,
    "global_ayah_id": 5683,
    "translation": "പകലിനെ നാം ജീവസന്ധാരണവേളയാക്കുകയും ചെയ്തിരിക്കുന്നു."
  },
  {
    "surah_id": 78,
    "ayah_number": 12,
    "global_ayah_id": 5684,
    "translation": "നിങ്ങള്‍ക്ക് മീതെ ബലിഷ്ഠമായ ഏഴു ആകാശങ്ങള്‍ നാം നിര്‍മിക്കുകയും"
  },
  {
    "surah_id": 78,
    "ayah_number": 13,
    "global_ayah_id": 5685,
    "translation": "കത്തിജ്വലിക്കുന്ന ഒരു വിളക്ക് നാം ഉണ്ടാക്കുകയും ചെയ്തിരിക്കുന്നു."
  },
  {
    "surah_id": 78,
    "ayah_number": 14,
    "global_ayah_id": 5686,
    "translation": "കാര്‍മേഘങ്ങളില്‍ നിന്ന് കുത്തി ഒഴുകുന്ന വെള്ളം നാം ഇറക്കുകയും ചെയ്തു."
  },
  {
    "surah_id": 78,
    "ayah_number": 15,
    "global_ayah_id": 5687,
    "translation": "അതു മുഖേന ധാന്യവും സസ്യവും നാം പുറത്തു കൊണ്ടു വരാന്‍ വേണ്ടി."
  },
  {
    "surah_id": 78,
    "ayah_number": 16,
    "global_ayah_id": 5688,
    "translation": "ഇടതൂര്‍ന്ന തോട്ടങ്ങളും"
  },
  {
    "surah_id": 78,
    "ayah_number": 17,
    "global_ayah_id": 5689,
    "translation": "തീര്‍ച്ചയായും തീരുമാനത്തിന്‍റെ ദിവസം സമയം നിര്‍ണയിക്കപ്പെട്ടതായിരിക്കുന്നു."
  },
  {
    "surah_id": 78,
    "ayah_number": 18,
    "global_ayah_id": 5690,
    "translation": "അതായത് കാഹളത്തില്‍ ഊതപ്പെടുകയും, നിങ്ങള്‍ കൂട്ടംകൂട്ടമായി വന്നെത്തുകയും ചെയ്യുന്ന ദിവസം."
  },
  {
    "surah_id": 78,
    "ayah_number": 19,
    "global_ayah_id": 5691,
    "translation": "ആകാശം തുറക്കപ്പെടുകയും എന്നിട്ടത് പല കവാടങ്ങളായി തീരുകയും ചെയ്യും."
  },
  {
    "surah_id": 78,
    "ayah_number": 20,
    "global_ayah_id": 5692,
    "translation": "പര്‍വ്വതങ്ങള്‍ സഞ്ചരിപ്പിക്കപ്പെടുകയും അങ്ങനെ അവ മരീചിക പോലെ ആയിത്തീരുകയും ചെയ്യും."
  },
  {
    "surah_id": 78,
    "ayah_number": 21,
    "global_ayah_id": 5693,
    "translation": "തീര്‍ച്ചയായും നരകം കാത്തിരിക്കുന്ന സ്ഥലമാകുന്നു."
  },
  {
    "surah_id": 78,
    "ayah_number": 22,
    "global_ayah_id": 5694,
    "translation": "അതിക്രമകാരികള്‍ക്ക് മടങ്ങിച്ചെല്ലാനുള്ള സ്ഥലം."
  },
  {
    "surah_id": 78,
    "ayah_number": 23,
    "global_ayah_id": 5695,
    "translation": "അവര്‍ അതില്‍ യുഗങ്ങളോളം താമസിക്കുന്നവരായിരിക്കും."
  },
  {
    "surah_id": 78,
    "ayah_number": 24,
    "global_ayah_id": 5696,
    "translation": "കുളിര്‍മയോ കുടിനീരോ അവര്‍ അവിടെ ആസ്വദിക്കുകയില്ല."
  },
  {
    "surah_id": 78,
    "ayah_number": 25,
    "global_ayah_id": 5697,
    "translation": "കൊടുംചൂടുള്ള വെള്ളവും കൊടും തണുപ്പുള്ള വെള്ളവുമല്ലാതെ"
  },
  {
    "surah_id": 78,
    "ayah_number": 26,
    "global_ayah_id": 5698,
    "translation": "അനുയോജ്യമായ പ്രതിഫലമത്രെ അത്‌."
  },
  {
    "surah_id": 78,
    "ayah_number": 27,
    "global_ayah_id": 5699,
    "translation": "തീര്‍ച്ചയായും അവര്‍ വിചാരണ പ്രതീക്ഷിക്കുന്നില്ലായിരുന്നു."
  },
  {
    "surah_id": 78,
    "ayah_number": 28,
    "global_ayah_id": 5700,
    "translation": "നമ്മുടെ ദൃഷ്ടാന്തങ്ങളെ അവര്‍ തീര്‍ത്തും നിഷേധിച്ചു തള്ളുകയും ചെയ്തു."
  },
  {
    "surah_id": 78,
    "ayah_number": 29,
    "global_ayah_id": 5701,
    "translation": "ഏതു കാര്യവും നാം എഴുതി തിട്ടപ്പെടുത്തിയിരിക്കുന്നു."
  },
  {
    "surah_id": 78,
    "ayah_number": 30,
    "global_ayah_id": 5702,
    "translation": "അതിനാല്‍ നിങ്ങള്‍ (ശിക്ഷ) ആസ്വദിച്ചു കൊള്ളുക. തീര്‍ച്ചയായും നാം നിങ്ങള്‍ക്കു ശിക്ഷയല്ലാതൊന്നും വര്‍ദ്ധിപ്പിച്ചു തരികയില്ല."
  },
  {
    "surah_id": 78,
    "ayah_number": 31,
    "global_ayah_id": 5703,
    "translation": "തീര്‍ച്ചയായും സൂക്ഷ്മത പാലിച്ചവര്‍ക്ക് വിജയമുണ്ട്‌."
  },
  {
    "surah_id": 78,
    "ayah_number": 32,
    "global_ayah_id": 5704,
    "translation": "അതായത് (സ്വര്‍ഗത്തിലെ) തോട്ടങ്ങളും മുന്തിരികളും,"
  },
  {
    "surah_id": 78,
    "ayah_number": 33,
    "global_ayah_id": 5705,
    "translation": "തുടുത്ത മാര്‍വിടമുള്ള സമപ്രായക്കാരായ തരുണികളും."
  },
  {
    "surah_id": 78,
    "ayah_number": 34,
    "global_ayah_id": 5706,
    "translation": "നിറഞ്ഞ പാനപാത്രങ്ങളും."
  },
  {
    "surah_id": 78,
    "ayah_number": 35,
    "global_ayah_id": 5707,
    "translation": "അവിടെ അനാവശ്യമായ ഒരു വാക്കോ ഒരു വ്യാജവാര്‍ത്തയോ അവര്‍ കേള്‍ക്കുകയില്ല."
  },
  {
    "surah_id": 78,
    "ayah_number": 36,
    "global_ayah_id": 5708,
    "translation": "(അത്‌) നിന്‍റെ രക്ഷിതാവിങ്കല്‍ നിന്നുള്ള ഒരു പ്രതിഫലവും, കണക്കൊത്ത ഒരു സമ്മാനവുമാകുന്നു."
  },
  {
    "surah_id": 78,
    "ayah_number": 37,
    "global_ayah_id": 5709,
    "translation": "ആകാശങ്ങളുടെയും ഭൂമിയുടെയും അവക്കിടയിലുള്ളതിന്‍റെയും രക്ഷിതാവും പരമകാരുണികനുമായുള്ളവന്‍റെ (സമ്മാനം.) അവനുമായി സംഭാഷണത്തില്‍ ഏര്‍പെടാന്‍ അവര്‍ക്കു സാധിക്കുകയില്ല."
  },
  {
    "surah_id": 78,
    "ayah_number": 38,
    "global_ayah_id": 5710,
    "translation": "റൂഹും മലക്കുകളും അണിയായി നില്‍ക്കുന്ന ദിവസം. പരമകാരുണികനായ അല്ലാഹു അനുവാദം നല്‍കിയിട്ടുള്ളവനും സത്യം പറഞ്ഞിട്ടുള്ളവനുമല്ലാതെ അന്ന് സംസാരിക്കുകയില്ല."
  },
  {
    "surah_id": 78,
    "ayah_number": 39,
    "global_ayah_id": 5711,
    "translation": "അതത്രെ യഥാര്‍ത്ഥമായ ദിവസം. അതിനാല്‍ വല്ലവനും ഉദ്ദേശിക്കുന്ന പക്ഷം തന്‍റെ രക്ഷിതാവിങ്കലേക്കുള്ള മടക്കത്തിന്‍റെ മാര്‍ഗം അവന്‍ സ്വീകരിക്കട്ടെ."
  },
  {
    "surah_id": 78,
    "ayah_number": 40,
    "global_ayah_id": 5712,
    "translation": "ആസന്നമായ ഒരു ശിക്ഷയെ പറ്റി തീര്‍ച്ചയായും നിങ്ങള്‍ക്കു നാം മുന്നറിയിപ്പ് നല്‍കിയിരിക്കുന്നു. മനുഷ്യന്‍ തന്‍റെ കൈകള്‍ മുന്‍കൂട്ടി ചെയ്തു വെച്ചത് നോക്കിക്കാണുകയും, അയ്യോ ഞാന്‍ മണ്ണായിരുന്നെങ്കില്‍ എത്ര നന്നായിരുന്നേനെ എന്ന് സത്യനിഷേധി പറയുകയും ചെയ്യുന്ന ദിവസം."
  }
]