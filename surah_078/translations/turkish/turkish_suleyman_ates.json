[
  {
    "surah_id": 78,
    "ayah_number": 1,
    "global_ayah_id": 5673,
    "translation": "Birbirlerine hangi şeyden soruyorlar?"
  },
  {
    "surah_id": 78,
    "ayah_number": 2,
    "global_ayah_id": 5674,
    "translation": "O büyük haberden mi?"
  },
  {
    "surah_id": 78,
    "ayah_number": 3,
    "global_ayah_id": 5675,
    "translation": "Ki onlar onda ayrılığa düşmektedirler."
  },
  {
    "surah_id": 78,
    "ayah_number": 4,
    "global_ayah_id": 5676,
    "translation": "Hayır (dedikleri gibi değil), yakında bilecekler."
  },
  {
    "surah_id": 78,
    "ayah_number": 5,
    "global_ayah_id": 5677,
    "translation": "Sonra hayır (dedikleri gibi değil), yakında bilecekler."
  },
  {
    "surah_id": 78,
    "ayah_number": 6,
    "global_ayah_id": 5678,
    "translation": "Yapmadık mı biz, Arzı bir beşik,"
  },
  {
    "surah_id": 78,
    "ayah_number": 7,
    "global_ayah_id": 5679,
    "translation": "Dağları birer kazık?"
  },
  {
    "surah_id": 78,
    "ayah_number": 8,
    "global_ayah_id": 5680,
    "translation": "Ve sizi çift çift yarattık."
  },
  {
    "surah_id": 78,
    "ayah_number": 9,
    "global_ayah_id": 5681,
    "translation": "Uykunuzu dinlenme yaptık."
  },
  {
    "surah_id": 78,
    "ayah_number": 10,
    "global_ayah_id": 5682,
    "translation": "Geceyi (sizi sarıp örten) bir giysi yaptık."
  },
  {
    "surah_id": 78,
    "ayah_number": 11,
    "global_ayah_id": 5683,
    "translation": "Gündüzü de geçim zamanı yaptık."
  },
  {
    "surah_id": 78,
    "ayah_number": 12,
    "global_ayah_id": 5684,
    "translation": "Üstünüzde yedi sağlam (gök) bina ettik."
  },
  {
    "surah_id": 78,
    "ayah_number": 13,
    "global_ayah_id": 5685,
    "translation": "Ve (orada) parıl parıl parlayan bir lamba yarattık."
  },
  {
    "surah_id": 78,
    "ayah_number": 14,
    "global_ayah_id": 5686,
    "translation": "Sıkışan(bulut)lardan şarıl şarıl su indirdik,"
  },
  {
    "surah_id": 78,
    "ayah_number": 15,
    "global_ayah_id": 5687,
    "translation": "Ki onunla çıkaralım: Dane(ler), bitki(ler),"
  },
  {
    "surah_id": 78,
    "ayah_number": 16,
    "global_ayah_id": 5688,
    "translation": "Ve (ağaçları) birbirine sarmaş dolaş bahçeler."
  },
  {
    "surah_id": 78,
    "ayah_number": 17,
    "global_ayah_id": 5689,
    "translation": "Muhakkak ki (haklının, haksızın ayırdedileceği) hüküm günü, belirlenmiş bir vakittir."
  },
  {
    "surah_id": 78,
    "ayah_number": 18,
    "global_ayah_id": 5690,
    "translation": "O gün Sur'a üflenir, bölük bölük gelirsiniz."
  },
  {
    "surah_id": 78,
    "ayah_number": 19,
    "global_ayah_id": 5691,
    "translation": "Gök açılmış, kapı kapı olmuştur."
  },
  {
    "surah_id": 78,
    "ayah_number": 20,
    "global_ayah_id": 5692,
    "translation": "Dağlar yürütülmüş, bir serab olmuştur."
  },
  {
    "surah_id": 78,
    "ayah_number": 21,
    "global_ayah_id": 5693,
    "translation": "Cehennem de gözetleme yeri olmuş(suçluları gözetleyip durmakta)dır."
  },
  {
    "surah_id": 78,
    "ayah_number": 22,
    "global_ayah_id": 5694,
    "translation": "Azgınların varacağı yerdir."
  },
  {
    "surah_id": 78,
    "ayah_number": 23,
    "global_ayah_id": 5695,
    "translation": "Orada çağlar boyu kalacalardır."
  },
  {
    "surah_id": 78,
    "ayah_number": 24,
    "global_ayah_id": 5696,
    "translation": "Orada ne bir serinlik, ne de içilecek bir şey tadarlar,"
  },
  {
    "surah_id": 78,
    "ayah_number": 25,
    "global_ayah_id": 5697,
    "translation": "Yalnız kaynar su ve irin (içerler);"
  },
  {
    "surah_id": 78,
    "ayah_number": 26,
    "global_ayah_id": 5698,
    "translation": "Yaptıklarına uygun bir ceza olarak."
  },
  {
    "surah_id": 78,
    "ayah_number": 27,
    "global_ayah_id": 5699,
    "translation": "Çünkü onlar bir hesap (görüleceğini) ummuyorlardı."
  },
  {
    "surah_id": 78,
    "ayah_number": 28,
    "global_ayah_id": 5700,
    "translation": "Ayetlerimizi de tamamen yalanlamışlardı."
  },
  {
    "surah_id": 78,
    "ayah_number": 29,
    "global_ayah_id": 5701,
    "translation": "Biz de her şeyi sayıp yazmıştık."
  },
  {
    "surah_id": 78,
    "ayah_number": 30,
    "global_ayah_id": 5702,
    "translation": "Şimdi tadın (yaptıklarınızın tadını), artık size azabdan başka bir şey artırmayacağız! \tSo taste (of that which ye have earned). No increase do We give you save of torment."
  },
  {
    "surah_id": 78,
    "ayah_number": 31,
    "global_ayah_id": 5703,
    "translation": "Korunanlar için de başarı ödülü vardır."
  },
  {
    "surah_id": 78,
    "ayah_number": 32,
    "global_ayah_id": 5704,
    "translation": "Bahçeler, bağlar,"
  },
  {
    "surah_id": 78,
    "ayah_number": 33,
    "global_ayah_id": 5705,
    "translation": "Göğüsleri tomurcuklanmış yaşıt kızlar."
  },
  {
    "surah_id": 78,
    "ayah_number": 34,
    "global_ayah_id": 5706,
    "translation": "Ve dolu kadeh(ler)."
  },
  {
    "surah_id": 78,
    "ayah_number": 35,
    "global_ayah_id": 5707,
    "translation": "Orada ne boş söz ne de yalan işitirler;"
  },
  {
    "surah_id": 78,
    "ayah_number": 36,
    "global_ayah_id": 5708,
    "translation": "Rabbinden bir karşılık, yeterli bir bağış olarak."
  },
  {
    "surah_id": 78,
    "ayah_number": 37,
    "global_ayah_id": 5709,
    "translation": "Göklerin, yerin ve ikisi arasında bulunanların Rabbi, çok merhametli (Rab). O'nun (izni olmadan) huzurunda konuşamazlar."
  },
  {
    "surah_id": 78,
    "ayah_number": 38,
    "global_ayah_id": 5710,
    "translation": "O gün Ruh ve melekler, sıra sıra dururlar. Ancak Rahman'ın izin verdiği konuşabilir, o da doğruyu söyler."
  },
  {
    "surah_id": 78,
    "ayah_number": 39,
    "global_ayah_id": 5711,
    "translation": "İşte bu, hak günüdür. Artık dileyen, Rabbine varan bir yol tutar."
  },
  {
    "surah_id": 78,
    "ayah_number": 40,
    "global_ayah_id": 5712,
    "translation": "Biz sizi yakın bir azab ile uyardık. O gün kişi, ellerinin (yapıp) öne sürdüğü işlere bakar ve kafir: \"Keşke ben, toprak olsaydım!\" der."
  }
]