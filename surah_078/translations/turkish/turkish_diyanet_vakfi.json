[
  {
    "surah_id": 78,
    "ayah_number": 1,
    "global_ayah_id": 5673,
    "translation": "Birbirlerine neyi soruyorlar?"
  },
  {
    "surah_id": 78,
    "ayah_number": 2,
    "global_ayah_id": 5674,
    "translation": "O büyük haberden mi?"
  },
  {
    "surah_id": 78,
    "ayah_number": 3,
    "global_ayah_id": 5675,
    "translation": "(İnanıp inanmamakta) ayrılığa düşmektedirler."
  },
  {
    "surah_id": 78,
    "ayah_number": 4,
    "global_ayah_id": 5676,
    "translation": "Hayır! Anlayacaklar!"
  },
  {
    "surah_id": 78,
    "ayah_number": 5,
    "global_ayah_id": 5677,
    "translation": "Yine hayır! Onlar anlayacaklar!"
  },
  {
    "surah_id": 78,
    "ayah_number": 6,
    "global_ayah_id": 5678,
    "translation": "Biz yeryüzünü bir döşek, yapmadık mı?"
  },
  {
    "surah_id": 78,
    "ayah_number": 7,
    "global_ayah_id": 5679,
    "translation": "Dağları da birer kazık."
  },
  {
    "surah_id": 78,
    "ayah_number": 8,
    "global_ayah_id": 5680,
    "translation": "Sizi çifter çifter yarattık."
  },
  {
    "surah_id": 78,
    "ayah_number": 9,
    "global_ayah_id": 5681,
    "translation": "Uykunuzu bir dinlenme kıldık."
  },
  {
    "surah_id": 78,
    "ayah_number": 10,
    "global_ayah_id": 5682,
    "translation": "Geceyi bir örtü yaptık."
  },
  {
    "surah_id": 78,
    "ayah_number": 11,
    "global_ayah_id": 5683,
    "translation": "Gündüzü de çalışıp kazanma zamanı kıldık."
  },
  {
    "surah_id": 78,
    "ayah_number": 12,
    "global_ayah_id": 5684,
    "translation": "Üstünüzde yedi kat sağlam göğü bina ettik."
  },
  {
    "surah_id": 78,
    "ayah_number": 13,
    "global_ayah_id": 5685,
    "translation": "(Orada) alev alev yanan bir kandil yarattık."
  },
  {
    "surah_id": 78,
    "ayah_number": 14,
    "global_ayah_id": 5686,
    "translation": "Sıkışan bulutlardan şarıl şarıl akan sular indirdik."
  },
  {
    "surah_id": 78,
    "ayah_number": 15,
    "global_ayah_id": 5687,
    "translation": "Size tohumlar, bitkiler, yetiştirmek için"
  },
  {
    "surah_id": 78,
    "ayah_number": 16,
    "global_ayah_id": 5688,
    "translation": "Ve ağaçları(birbirine) sarmaş dolaş bahçeler."
  },
  {
    "surah_id": 78,
    "ayah_number": 17,
    "global_ayah_id": 5689,
    "translation": "Şüphesiz hüküm günü vakit olarak belirlenmiştir."
  },
  {
    "surah_id": 78,
    "ayah_number": 18,
    "global_ayah_id": 5690,
    "translation": "Sur'a üflendiği gün, bölük bölük Allah'a gelirsiniz."
  },
  {
    "surah_id": 78,
    "ayah_number": 19,
    "global_ayah_id": 5691,
    "translation": "Gökyüzü açılır ve orada pek çok kapılar oluşur;"
  },
  {
    "surah_id": 78,
    "ayah_number": 20,
    "global_ayah_id": 5692,
    "translation": "Dağlar yürütülür, serap haline gelir."
  },
  {
    "surah_id": 78,
    "ayah_number": 21,
    "global_ayah_id": 5693,
    "translation": "Şüphesiz, cehennem pusuda beklemektedir."
  },
  {
    "surah_id": 78,
    "ayah_number": 22,
    "global_ayah_id": 5694,
    "translation": "Azgınların barınacağı yerdir (cehennem)."
  },
  {
    "surah_id": 78,
    "ayah_number": 23,
    "global_ayah_id": 5695,
    "translation": "(Azgınlar) orada çağlar boyu kalacaklar,"
  },
  {
    "surah_id": 78,
    "ayah_number": 24,
    "global_ayah_id": 5696,
    "translation": "Orada bir serinlik ya da (susuzluk gideren) bir içecek tatmazlar,"
  },
  {
    "surah_id": 78,
    "ayah_number": 25,
    "global_ayah_id": 5697,
    "translation": "Kaynar su ve irin (tadarlar)."
  },
  {
    "surah_id": 78,
    "ayah_number": 26,
    "global_ayah_id": 5698,
    "translation": "Ancak (dünyada yaptıklarına) uygun karşılık olarak."
  },
  {
    "surah_id": 78,
    "ayah_number": 27,
    "global_ayah_id": 5699,
    "translation": "Çünkü onlar hesap gününü (geleceğini) ummazlardı."
  },
  {
    "surah_id": 78,
    "ayah_number": 28,
    "global_ayah_id": 5700,
    "translation": "Bizim ayetlerimizi yalanladıkça yalanlamışlardı."
  },
  {
    "surah_id": 78,
    "ayah_number": 29,
    "global_ayah_id": 5701,
    "translation": "Biz ise her şeyi bir kitapta sayıp yazmışızdır."
  },
  {
    "surah_id": 78,
    "ayah_number": 30,
    "global_ayah_id": 5702,
    "translation": "Tadın! Bundan sonra yalnızca azabınızı arttıracağız."
  },
  {
    "surah_id": 78,
    "ayah_number": 31,
    "global_ayah_id": 5703,
    "translation": "Şüphesiz takva sahipleri için de başarı ödülü vardır."
  },
  {
    "surah_id": 78,
    "ayah_number": 32,
    "global_ayah_id": 5704,
    "translation": "Bahçeler, bağlar,"
  },
  {
    "surah_id": 78,
    "ayah_number": 33,
    "global_ayah_id": 5705,
    "translation": "Göğüsleri tomurcuk gibi kabarmış yaşıt kızlar,"
  },
  {
    "surah_id": 78,
    "ayah_number": 34,
    "global_ayah_id": 5706,
    "translation": "Ve içki dolu kase(ler)."
  },
  {
    "surah_id": 78,
    "ayah_number": 35,
    "global_ayah_id": 5707,
    "translation": "Onlar orada ne boş bir lakırdı ne de yalan işitirler."
  },
  {
    "surah_id": 78,
    "ayah_number": 36,
    "global_ayah_id": 5708,
    "translation": "Bunlar Rabbinin yeterli bir bağışı, mükafatıdır."
  },
  {
    "surah_id": 78,
    "ayah_number": 37,
    "global_ayah_id": 5709,
    "translation": "O, göklerin, yerin ve ikisi arasında bulunanların Rabbidir. O, rahmandır. O gün insanlar O'na karşı konuşmaya yetkili değillerdir."
  },
  {
    "surah_id": 78,
    "ayah_number": 38,
    "global_ayah_id": 5710,
    "translation": "Ruh (Cebrail) ve melekler saf saf olup durduğu gün, Rahman'ın izin verdiklerinden başkaları konuşmazlar; konuşan da doğruyu söyler."
  },
  {
    "surah_id": 78,
    "ayah_number": 39,
    "global_ayah_id": 5711,
    "translation": "İşte o, kesin olarak gelecek gündür. O halde dileyen Rabbine varan bir yol tutsun."
  },
  {
    "surah_id": 78,
    "ayah_number": 40,
    "global_ayah_id": 5712,
    "translation": "Biz, yakın bir azap ile sizi uyardık. O gün kişi önceden yaptıklarına bakacak ve inkarcı kişi: \"Keşke toprak olsaydım!\" diyecektir."
  }
]