[
  {
    "surah_id": 78,
    "ayah_number": 0,
    "global_ayah_id": 5749,
    "translation": "اللہ کے نام سے جو رحمان و رحیم ہے"
  },
  {
    "surah_id": 78,
    "ayah_number": 1,
    "global_ayah_id": 5750,
    "translation": "کیا بات پوچھتے ہیں لوگ آپس میں"
  },
  {
    "surah_id": 78,
    "ayah_number": 2,
    "global_ayah_id": 5751,
    "translation": "پوچھتے ہیں اُس بڑی خبر سے"
  },
  {
    "surah_id": 78,
    "ayah_number": 3,
    "global_ayah_id": 5752,
    "translation": "جس میں وہ مختلف ہیں"
  },
  {
    "surah_id": 78,
    "ayah_number": 4,
    "global_ayah_id": 5753,
    "translation": "ہرگز نہیں اب جان لیں گے"
  },
  {
    "surah_id": 78,
    "ayah_number": 5,
    "global_ayah_id": 5754,
    "translation": "پھر بھی ہر گز نہیں اب جان لیں گے"
  },
  {
    "surah_id": 78,
    "ayah_number": 6,
    "global_ayah_id": 5755,
    "translation": "کیا ہم نے نہیں بنایا زمین کو بچھونا"
  },
  {
    "surah_id": 78,
    "ayah_number": 7,
    "global_ayah_id": 5756,
    "translation": "اور پہاڑوں کو میخیں"
  },
  {
    "surah_id": 78,
    "ayah_number": 8,
    "global_ayah_id": 5757,
    "translation": "اور تم کو بنایا ہم نے جوڑے جوڑے"
  },
  {
    "surah_id": 78,
    "ayah_number": 9,
    "global_ayah_id": 5758,
    "translation": "اور بنایا نیند کو تمہاری تکان دفع کرنیکے لئے"
  },
  {
    "surah_id": 78,
    "ayah_number": 10,
    "global_ayah_id": 5759,
    "translation": "اور بنایا رات کو اوڑھنا"
  },
  {
    "surah_id": 78,
    "ayah_number": 11,
    "global_ayah_id": 5760,
    "translation": "اور بنایا دن کمائی کرنے کو"
  },
  {
    "surah_id": 78,
    "ayah_number": 12,
    "global_ayah_id": 5761,
    "translation": "اور چنی ہم نے تم سےاوپر سات چنائی مضبوط"
  },
  {
    "surah_id": 78,
    "ayah_number": 13,
    "global_ayah_id": 5762,
    "translation": "اور بنایا ایک چراغ چمکتا ہوا"
  },
  {
    "surah_id": 78,
    "ayah_number": 14,
    "global_ayah_id": 5763,
    "translation": "اور اتارا نچڑنے والی بدلیوں سے پانی کا ریلا"
  },
  {
    "surah_id": 78,
    "ayah_number": 15,
    "global_ayah_id": 5764,
    "translation": "تاکہ ہم نکالیں اس سے اناج اور سبزہ"
  },
  {
    "surah_id": 78,
    "ayah_number": 16,
    "global_ayah_id": 5765,
    "translation": "اور باغ پتوں میں لپٹے ہوئے"
  },
  {
    "surah_id": 78,
    "ayah_number": 17,
    "global_ayah_id": 5766,
    "translation": "بیشک دن فیصلے کا ہے ایک وقت ٹھہرا ہوا"
  },
  {
    "surah_id": 78,
    "ayah_number": 18,
    "global_ayah_id": 5767,
    "translation": "جس دن پھونکی جائے صور پھر تم چلے آؤ جٹ کے جٹ"
  },
  {
    "surah_id": 78,
    "ayah_number": 19,
    "global_ayah_id": 5768,
    "translation": "اور کھولا جائے آسمان تو ہو جائیں اس میں دروازے"
  },
  {
    "surah_id": 78,
    "ayah_number": 20,
    "global_ayah_id": 5769,
    "translation": "اور چلائے جائیں گے پہاڑ تو ہو جائیں گے چمکتا ریتا"
  },
  {
    "surah_id": 78,
    "ayah_number": 21,
    "global_ayah_id": 5770,
    "translation": "بیشک دوزخ ہے تاک میں"
  },
  {
    "surah_id": 78,
    "ayah_number": 22,
    "global_ayah_id": 5771,
    "translation": "شریروں کا ٹھکانا"
  },
  {
    "surah_id": 78,
    "ayah_number": 23,
    "global_ayah_id": 5772,
    "translation": "رہا کریں اُس میں قرنوں"
  },
  {
    "surah_id": 78,
    "ayah_number": 24,
    "global_ayah_id": 5773,
    "translation": "نہ چکھیں وہاں کچھ مزا ٹھنڈک کا اور نہ پینا ملے کچھ"
  },
  {
    "surah_id": 78,
    "ayah_number": 25,
    "global_ayah_id": 5774,
    "translation": "مگر گرم پانی اور بہتی پیپ"
  },
  {
    "surah_id": 78,
    "ayah_number": 26,
    "global_ayah_id": 5775,
    "translation": "بدلا ہے پورا"
  },
  {
    "surah_id": 78,
    "ayah_number": 27,
    "global_ayah_id": 5776,
    "translation": "اُنکو توقع نہ تھی حساب کی"
  },
  {
    "surah_id": 78,
    "ayah_number": 28,
    "global_ayah_id": 5777,
    "translation": "اور جھٹلاتے تھے ہماری آیتوں کو مکرا کر"
  },
  {
    "surah_id": 78,
    "ayah_number": 29,
    "global_ayah_id": 5778,
    "translation": "اور ہر چیز ہم نے گن رکھی ہے لکھ کر"
  },
  {
    "surah_id": 78,
    "ayah_number": 30,
    "global_ayah_id": 5779,
    "translation": "اب چکھو کہ ہم نہ بڑھاتے جائیں گے تم پر مگر عذاب"
  },
  {
    "surah_id": 78,
    "ayah_number": 31,
    "global_ayah_id": 5780,
    "translation": "بیشک ڈر والوں کو اُنکی مراد ملنی ہے"
  },
  {
    "surah_id": 78,
    "ayah_number": 32,
    "global_ayah_id": 5781,
    "translation": "باغ ہیں اور انگور"
  },
  {
    "surah_id": 78,
    "ayah_number": 33,
    "global_ayah_id": 5782,
    "translation": "اور نوجوان عورتیں ایک عمر کی سب"
  },
  {
    "surah_id": 78,
    "ayah_number": 34,
    "global_ayah_id": 5783,
    "translation": "اور پیالے چھلکتے ہوئے"
  },
  {
    "surah_id": 78,
    "ayah_number": 35,
    "global_ayah_id": 5784,
    "translation": "نہ سنیں گے وہاں بک بک اور نہ مکرانا"
  },
  {
    "surah_id": 78,
    "ayah_number": 36,
    "global_ayah_id": 5785,
    "translation": "بدلا ہے تیرے رب کا دیا ہوا حساب سے"
  },
  {
    "surah_id": 78,
    "ayah_number": 37,
    "global_ayah_id": 5786,
    "translation": "جو رب ہے آسمانوں کا اور زمین کا اور جو کچھ اُنکے بیچ میں ہے بڑی رحمت والا قدرت نہیں کہ کوئی اُس سے بات کرے"
  },
  {
    "surah_id": 78,
    "ayah_number": 38,
    "global_ayah_id": 5787,
    "translation": "جس دن کھڑی ہو روح اور فرشتے قطار باندھ کر کوئی نہیں بولتا مگر جس کو حکم دیا رحمٰن نے اور بولا بات ٹھیک"
  },
  {
    "surah_id": 78,
    "ayah_number": 39,
    "global_ayah_id": 5788,
    "translation": "وہ دن ہے برحق پھر جو کوئی چاہے بنا رکھے اپنے رب کے پاس ٹھکانا"
  },
  {
    "surah_id": 78,
    "ayah_number": 40,
    "global_ayah_id": 5789,
    "translation": "ہم نے خبر سنا دی تم کو ایک آفت نزدیک آنے والی کی جس دن دیکھ لے گا آدمی جو آگے بھیجا اُسکے ہاتھوں نے اور کہے گا کافر کسی طرح میں مٹی ہوتا"
  }
]