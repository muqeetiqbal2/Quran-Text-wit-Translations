  {
    "surah_id": 78,
    "ayah_number": 13,
    "global_ayah_id": 5762,
    "translation": "اور ہم نے سورج کو چمکتا «<a href=654> ہوا </a>» «<a href=257> چراغ </a>» بنایا"
  },
  {
    "surah_id": 78,
    "ayah_number": 14,
    "global_ayah_id": 5763,
    "translation": "اور ہم نے برسنے والے بادلوں سے زور دار «<a href=75> بارش </a>» نازل کی"
