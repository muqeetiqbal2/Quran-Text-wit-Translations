[
  {
    "surah_id": 78,
    "ayah_number": 0,
    "global_ayah_id": 5749,
    "translation": "اللہ ہی کے «<a href=614> نام </a>» سے  (  «<a href=416> شروع </a>» کرتا ہوں )  جو نہایت رحم فرمانے والا بہت «<a href=600> مہربان </a>» ہے"
  },
  {
    "surah_id": 78,
    "ayah_number": 1,
    "global_ayah_id": 5750,
    "translation": "یہ لوگ کس چیز کے متعلق ایک دوسرے سے سوال کر رہے ہیں ؟"
  },
  {
    "surah_id": 78,
    "ayah_number": 2,
    "global_ayah_id": 5751,
    "translation": "عظیم «<a href=293> خبر </a>» کے متعلق"
