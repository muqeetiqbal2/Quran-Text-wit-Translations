    "ayah_number": 11,
    "global_ayah_id": 5760,
    "translation": "اور ہم نے «<a href=326> دن </a>» کو روزی کمانے کا «<a href=639> وقت </a>» بنایا"
  },
  {
    "surah_id": 78,
    "ayah_number": 12,
    "global_ayah_id": 5761,
    "translation": "اور ہم نے تمہارے اوپر سات «<a href=590> مضبوط </a>»  (  «<a href=10> آسمان </a>» )  بنائے"
