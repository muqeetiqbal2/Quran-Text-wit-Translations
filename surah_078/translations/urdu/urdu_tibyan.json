  {
    "surah_id": 78,
    "ayah_number": 37,
    "global_ayah_id": 5786,
    "translation": "جو آسمانوں اور زمینوں اور ان کے «<a href=321> درمیان </a>» کی سب چیزوں کا رب ہے، نہایت رحم فرمانے والا ہے اس سے  (  بغیر «<a href=28> اجازت </a>» )  «<a href=71> بات </a>» کرنے کا کسی کو «<a href=34> اختیار </a>» نہ ہوگا"
  },
  {
    "surah_id": 78,
    "ayah_number": 38,
    "global_ayah_id": 5787,
    "translation": "جس «<a href=326> دن </a>» جبریل اور تمام فرشتے صف بستہ کھڑے ہوں گے، اس سے کوئی «<a href=71> بات </a>» نہیں کرسکے گا سوا اس کے جس کو رحمن نے «<a href=28> اجازت </a>» دی اور اس نے صحیح «<a href=71> بات </a>» کی"
  },
  {
    "surah_id": 78,
    "ayah_number": 39,
    "global_ayah_id": 5788,
    "translation": "وہ «<a href=326> دن </a>» برحق ہے، سو اب جو چاہے اپنے رب کی طرف ٹھکانہ بنا لے"
  },
  {
    "surah_id": 78,
    "ayah_number": 40,
    "global_ayah_id": 5789,
    "translation": "بیشک ہم نے تمہیں عنقریب آنے والے «<a href=440> عذاب </a>» سے ڈرادیا ہے، اس «<a href=326> دن </a>» آدمی وہ سب کچھ دیکھ لے گا جو اس کے ہاتھوں نے آگے بھیجا ہے اور کافر کہے گا : اے کاش ! میں «<a href=568> مٹی </a>» ہوجاتا"
  }
]