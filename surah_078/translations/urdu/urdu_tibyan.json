  {
    "surah_id": 78,
    "ayah_number": 17,
    "global_ayah_id": 5766,
    "translation": "بیشک «<a href=461> فیصلہ </a>» کا «<a href=326> دن </a>» «<a href=593> مقرر </a>» شدہ «<a href=639> وقت </a>» ہے"
  },
  {
