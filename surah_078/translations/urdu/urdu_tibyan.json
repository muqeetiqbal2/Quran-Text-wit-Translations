    "surah_id": 78,
    "ayah_number": 29,
    "global_ayah_id": 5778,
    "translation": "اور ہم نے ہر چیز کو گن کر لکھ رکھا ہے"
  },
  {
    "surah_id": 78,
    "ayah_number": 30,
    "global_ayah_id": 5779,
    "translation": "اب چکھو ہم تمہارا «<a href=440> عذاب </a>» بڑھاتے ہی رہیں گے۔"
