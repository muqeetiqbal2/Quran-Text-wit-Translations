    "ayah_number": 24,
    "global_ayah_id": 5773,
    "translation": "اس میں وہ نہ ٹھنڈک پائیں گے نہ کوئی مشروب"
  },
  {
    "surah_id": 78,
    "ayah_number": 25,
    "global_ayah_id": 5774,
    "translation": "سوا کھولتے ہوئے «<a href=144> پانی </a>» اور «<a href=176> پیپ </a>» کے"
  },
  {
    "surah_id": 78,
    "ayah_number": 26,
    "global_ayah_id": 5775,
    "translation": "یہ ان کے موافق «<a href=95> بدلہ </a>» ہے"
  },
  {
    "surah_id": 78,
    "ayah_number": 27,
    "global_ayah_id": 5776,
    "translation": "بیشک وہ کسی حساب کی «<a href=52> امید </a>» نہیں رکھتے تھے"
  },
  {
    "surah_id": 78,
    "ayah_number": 28,
    "global_ayah_id": 5777,
    "translation": "اور انہوں نے ہماری آیات کی پوری پوری تکذیب کی"
