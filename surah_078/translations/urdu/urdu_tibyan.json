  {
    "surah_id": 78,
    "ayah_number": 3,
    "global_ayah_id": 5752,
    "translation": "جس میں یہ اختلاف کر رہے ہیں"
  },
  {
    "surah_id": 78,
    "ayah_number": 4,
    "global_ayah_id": 5753,
    "translation": "ہرگز نہیں ! یہ عنقریب جان لیں گے"
  },
  {
    "surah_id": 78,
    "ayah_number": 5,
    "global_ayah_id": 5754,
    "translation": "پھر ہرگز نہیں ! یہ عنقریب جان لیں گے"
  },
  {
    "surah_id": 78,
    "ayah_number": 6,
    "global_ayah_id": 5755,
    "translation": "کیا ہم نے «<a href=379> زمین </a>» کو فرش نہیں بنایا ؟"
