    "ayah_number": 18,
    "global_ayah_id": 5767,
    "translation": "جس «<a href=326> دن </a>» صور میں پھونکا جائے گا تو تم فوج در فوج آؤ گے"
  },
  {
    "surah_id": 78,
    "ayah_number": 19,
    "global_ayah_id": 5768,
    "translation": "اور «<a href=10> آسمان </a>» کھول دیا جائے گا تو اس میں دروازے بن جائیں گے"
