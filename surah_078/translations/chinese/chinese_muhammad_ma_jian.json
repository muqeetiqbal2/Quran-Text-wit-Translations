[
  {
    "surah_id": 78,
    "ayah_number": 1,
    "global_ayah_id": 5673,
    "translation": "他們互相詢問，詢問什麼？"
  },
  {
    "surah_id": 78,
    "ayah_number": 2,
    "global_ayah_id": 5674,
    "translation": "詢問那重大的消息，"
  },
  {
    "surah_id": 78,
    "ayah_number": 3,
    "global_ayah_id": 5675,
    "translation": "就是他們所爭論的消息。"
  },
  {
    "surah_id": 78,
    "ayah_number": 4,
    "global_ayah_id": 5676,
    "translation": "絕不然！他們將來就知道了。"
  },
  {
    "surah_id": 78,
    "ayah_number": 5,
    "global_ayah_id": 5677,
    "translation": "絕不然，他們將來就知道了。"
  },
  {
    "surah_id": 78,
    "ayah_number": 6,
    "global_ayah_id": 5678,
    "translation": "難道我沒有使大地如搖籃，"
  },
  {
    "surah_id": 78,
    "ayah_number": 7,
    "global_ayah_id": 5679,
    "translation": "使山巒如木梉嗎？"
  },
  {
    "surah_id": 78,
    "ayah_number": 8,
    "global_ayah_id": 5680,
    "translation": "我曾把你們造成配偶，"
  },
  {
    "surah_id": 78,
    "ayah_number": 9,
    "global_ayah_id": 5681,
    "translation": "我曾使你們從睡眠中得到休息，"
  },
  {
    "surah_id": 78,
    "ayah_number": 10,
    "global_ayah_id": 5682,
    "translation": "我曾以黑夜為帷幕，"
  },
  {
    "surah_id": 78,
    "ayah_number": 11,
    "global_ayah_id": 5683,
    "translation": "我以白晝供謀生，"
  },
  {
    "surah_id": 78,
    "ayah_number": 12,
    "global_ayah_id": 5684,
    "translation": "我曾在你們上面建造了七層堅固的天，"
  },
  {
    "surah_id": 78,
    "ayah_number": 13,
    "global_ayah_id": 5685,
    "translation": "我創造一盞明燈，"
  },
  {
    "surah_id": 78,
    "ayah_number": 14,
    "global_ayah_id": 5686,
    "translation": "我從含水的雲裡，降下滂沱大雨，"
  },
  {
    "surah_id": 78,
    "ayah_number": 15,
    "global_ayah_id": 5687,
    "translation": "以便我借它而生出百谷和草木，"
  },
  {
    "surah_id": 78,
    "ayah_number": 16,
    "global_ayah_id": 5688,
    "translation": "以及茂密的園圃。"
  },
  {
    "surah_id": 78,
    "ayah_number": 17,
    "global_ayah_id": 5689,
    "translation": "判決之日，確是指定的日期，"
  },
  {
    "surah_id": 78,
    "ayah_number": 18,
    "global_ayah_id": 5690,
    "translation": "在那日，號角將被吹嚮，你們就成群而來；"
  },
  {
    "surah_id": 78,
    "ayah_number": 19,
    "global_ayah_id": 5691,
    "translation": "天將被開辟，有許多門戶；"
  },
  {
    "surah_id": 78,
    "ayah_number": 20,
    "global_ayah_id": 5692,
    "translation": "山巒將被移動，而變成幻影；"
  },
  {
    "surah_id": 78,
    "ayah_number": 21,
    "global_ayah_id": 5693,
    "translation": "火獄確是伺候著，"
  },
  {
    "surah_id": 78,
    "ayah_number": 22,
    "global_ayah_id": 5694,
    "translation": "它是悖逆者的歸宿；"
  },
  {
    "surah_id": 78,
    "ayah_number": 23,
    "global_ayah_id": 5695,
    "translation": "他們將在其中逗留長久的時期。"
  },
  {
    "surah_id": 78,
    "ayah_number": 24,
    "global_ayah_id": 5696,
    "translation": "他們在其中不能睡眠，不得飲料，"
  },
  {
    "surah_id": 78,
    "ayah_number": 25,
    "global_ayah_id": 5697,
    "translation": "只飲沸水和膿汁。"
  },
  {
    "surah_id": 78,
    "ayah_number": 26,
    "global_ayah_id": 5698,
    "translation": "那是一個很適當的報酬。"
  },
  {
    "surah_id": 78,
    "ayah_number": 27,
    "global_ayah_id": 5699,
    "translation": "他們的確不怕清算，"
  },
  {
    "surah_id": 78,
    "ayah_number": 28,
    "global_ayah_id": 5700,
    "translation": "他們曾否認我的跡象，"
  },
  {
    "surah_id": 78,
    "ayah_number": 29,
    "global_ayah_id": 5701,
    "translation": "我曾將萬事記錄在一本天經裡。"
  },
  {
    "surah_id": 78,
    "ayah_number": 30,
    "global_ayah_id": 5702,
    "translation": "（將對他們說：）「你們嘗試吧！我只增加你們所受的刑罰。」"
  },
  {
    "surah_id": 78,
    "ayah_number": 31,
    "global_ayah_id": 5703,
    "translation": "敬畏的人們必有一種收獲，"
  },
  {
    "surah_id": 78,
    "ayah_number": 32,
    "global_ayah_id": 5704,
    "translation": "許多園圃和葡萄，"
  },
  {
    "surah_id": 78,
    "ayah_number": 33,
    "global_ayah_id": 5705,
    "translation": "和兩乳圓潤，年齡劃一的少女，"
  },
  {
    "surah_id": 78,
    "ayah_number": 34,
    "global_ayah_id": 5706,
    "translation": "和滿杯的醴泉。"
  },
  {
    "surah_id": 78,
    "ayah_number": 35,
    "global_ayah_id": 5707,
    "translation": "他們在那裡面聽不到惡言和謊話。"
  },
  {
    "surah_id": 78,
    "ayah_number": 36,
    "global_ayah_id": 5708,
    "translation": "那是從你的主發出的報酬——充足的賞賜。"
  },
  {
    "surah_id": 78,
    "ayah_number": 37,
    "global_ayah_id": 5709,
    "translation": "他是天地萬物的主，是至仁的主，他們不敢向他陳說。"
  },
  {
    "surah_id": 78,
    "ayah_number": 38,
    "global_ayah_id": 5710,
    "translation": "在精神和眾天神排班肅立之日，他們不得說話，唯至仁主所特許而且能說正話的，才敢發言。"
  },
  {
    "surah_id": 78,
    "ayah_number": 39,
    "global_ayah_id": 5711,
    "translation": "那是必有的日子，誰意欲，誰就擇取一個向他的主的歸宿。"
  },
  {
    "surah_id": 78,
    "ayah_number": 40,
    "global_ayah_id": 5712,
    "translation": "我的確警告你們一種臨近的刑罰，在那日，各人將要看見自己所已做的工作，不信道的人們將要說：「啊！但願我原是塵土。」"
  }
]