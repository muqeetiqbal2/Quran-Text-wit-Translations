  },
  {
    "surah_id": 77,
    "ayah_number": 11,
    "global_ayah_id": 5709,
    "tafseer": "4: اللہ تعالیٰ نے آخرت کا ایک وقت مقرّر فرمایا ہے ہوا ہے جس میں تمام پیغمبر جمع ہو کر اپنی اپنی اُمت کے بارے میں گواہی دیں گے، یہاں وہی وقت مراد ہے۔"
  },
  {
    "surah_id": 77,
    "ayah_number": 12,
    "global_ayah_id": 5710,
    "tafseer": "5: یہ کافروں کا وہی سوال ہے جو وہ اکثر کیا کرتے تھے کہ اگر عذاب وثواب ہونا ہے تو ابھی کیوں نہیں ہوجاتا؟ دیر کیا ہے؟"
  },
  {
    "surah_id": 77,
    "ayah_number": 13,
    "global_ayah_id": 5711,
    "tafseer": ""
  },
