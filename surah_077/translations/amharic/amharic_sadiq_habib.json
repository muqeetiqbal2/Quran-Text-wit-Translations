[
  {
    "surah_id": 77,
    "ayah_number": 1,
    "global_ayah_id": 5623,
    "translation": "ተከታታይ ኾነው በተላኩት፣"
  },
  {
    "surah_id": 77,
    "ayah_number": 2,
    "global_ayah_id": 5624,
    "translation": "በኀይል መንፈስን ነፋሾች በኾኑትም፣"
  },
  {
    "surah_id": 77,
    "ayah_number": 3,
    "global_ayah_id": 5625,
    "translation": "መበተንን በታኞች በኾኑትም፤ (ነፋሶች)፣"
  },
  {
    "surah_id": 77,
    "ayah_number": 4,
    "global_ayah_id": 5626,
    "translation": "መለየትን ለይዎች በኾኑትም፣"
  },
  {
    "surah_id": 77,
    "ayah_number": 5,
    "global_ayah_id": 5627,
    "translation": "መገሠጫን (ወደ ነቢያት) ጣይዎች በኾኑትም፣"
  },
  {
    "surah_id": 77,
    "ayah_number": 6,
    "global_ayah_id": 5628,
    "translation": "ምክንያትን ለማስወገድ ወይም ለማስፈራራት (ጣይዎች በኾኑት መላእክት) እምላለሁ፡፡"
  },
  {
    "surah_id": 77,
    "ayah_number": 7,
    "global_ayah_id": 5629,
    "translation": "ያ የምትስፈራሩበት (ትንሣኤ) በእርግጥ ኋኝ ነው፡፡"
  },
  {
    "surah_id": 77,
    "ayah_number": 8,
    "global_ayah_id": 5630,
    "translation": "ከዋክብትም (ብርሃንዋ) በታበሰች ጊዜ፡፡"
  },
  {
    "surah_id": 77,
    "ayah_number": 9,
    "global_ayah_id": 5631,
    "translation": "ሰማይም በተከፈተች ጊዜ፡፡"
  },
  {
    "surah_id": 77,
    "ayah_number": 10,
    "global_ayah_id": 5632,
    "translation": "ጋራዎችም በተንኮተኮቱ ጊዜ፡፡"
  },
  {
    "surah_id": 77,
    "ayah_number": 11,
    "global_ayah_id": 5633,
    "translation": "መልክተኞቹም ወቅት በተደረገላቸው ጊዜ፡፡"
  },
  {
    "surah_id": 77,
    "ayah_number": 12,
    "global_ayah_id": 5634,
    "translation": "ለየትኛው ቀን ተቀጠሩ (የሚባል ሲኾን)፤"
  },
  {
    "surah_id": 77,
    "ayah_number": 13,
    "global_ayah_id": 5635,
    "translation": "ለመለያው ቀን (በተባለ ጊዜ፤ በፍጡሮች መካከል ይፈረዳል)፡፡"
  },
  {
    "surah_id": 77,
    "ayah_number": 14,
    "global_ayah_id": 5636,
    "translation": "የመለያውም ቀን ምን እንደኾነ ምን አሳወቀህ?"
  },
  {
    "surah_id": 77,
    "ayah_number": 15,
    "global_ayah_id": 5637,
    "translation": "ለአስተባባዮች በዚያ ቀን ወዮላቸው፡፡"
  },
  {
    "surah_id": 77,
    "ayah_number": 16,
    "global_ayah_id": 5638,
    "translation": "የፊተኞቹን (ሕዝቦች) አላጠፋንምን?"
  },
  {
    "surah_id": 77,
    "ayah_number": 17,
    "global_ayah_id": 5639,
    "translation": "ከዚያም የኋለኞቹን እናስከትላቸዋለን፡፡"
  },
  {
    "surah_id": 77,
    "ayah_number": 18,
    "global_ayah_id": 5640,
    "translation": "በአመጸኞች ሁሉ እንደዚሁ እንሠራለን፡፡"
  },
  {
    "surah_id": 77,
    "ayah_number": 19,
    "global_ayah_id": 5641,
    "translation": "ለአስተባባዮች በዚያ ቀን ወዮላቸው፡፡"
  },
  {
    "surah_id": 77,
    "ayah_number": 20,
    "global_ayah_id": 5642,
    "translation": "ከደካማ ውሃ አልፈጠርናችሁምን?"
  },
  {
    "surah_id": 77,
    "ayah_number": 21,
    "global_ayah_id": 5643,
    "translation": "በተጠበቀ መርጊያ ውስጥም (በማሕፀን) አደረግነው፡፡"
  },
  {
    "surah_id": 77,
    "ayah_number": 22,
    "global_ayah_id": 5644,
    "translation": "እስከ ታወቀ ልክ ድረስ፡፡ መጠንነውም፤ ምን ያማርንም"
  },
  {
    "surah_id": 77,
    "ayah_number": 23,
    "global_ayah_id": 5645,
    "translation": "መጣኞች ነን!"
  },
  {
    "surah_id": 77,
    "ayah_number": 24,
    "global_ayah_id": 5646,
    "translation": "ለአስተባባዮች በዚያ ቀን ወዮላቸው፡፡"
  },
  {
    "surah_id": 77,
    "ayah_number": 25,
    "global_ayah_id": 5647,
    "translation": "ምድርን ሰብሳቢ አላደረግናትምን?"
  },
  {
    "surah_id": 77,
    "ayah_number": 26,
    "global_ayah_id": 5648,
    "translation": "ሕያዋን ኾናችሁ ሙታንም ኾናችሁ፡፡"
  },
  {
    "surah_id": 77,
    "ayah_number": 27,
    "global_ayah_id": 5649,
    "translation": "በውስጧም ከፍተኛዎችን ተራራዎች አደረግን፡፡ ጣፋጭ ውሃንም አጠጣናችሁ፡፡"
  },
  {
    "surah_id": 77,
    "ayah_number": 28,
    "global_ayah_id": 5650,
    "translation": "ለአስተባባዮች በዚያ ቀን ወዮላቸው፡፡"
  },
  {
    "surah_id": 77,
    "ayah_number": 29,
    "global_ayah_id": 5651,
    "translation": "«ወደዚያ በእርሱ ታስተባብሉ ወደ ነበራችሁት (ቅጣት) አዝግሙ፡፡"
  },
  {
    "surah_id": 77,
    "ayah_number": 30,
    "global_ayah_id": 5652,
    "translation": "«ባለ ሦስት ቅርንጫፎች ወደ ኾነው ጥላ አዝግሙ፤» (ይባላሉ)፡፡"
  },
  {
    "surah_id": 77,
    "ayah_number": 31,
    "global_ayah_id": 5653,
    "translation": "አጠላይ ያልኾነ ከእሳቱም ላንቃ የማያድን ወደ ኾነው (አዝግሙ)፡፡"
  },
  {
    "surah_id": 77,
    "ayah_number": 32,
    "global_ayah_id": 5654,
    "translation": "እርሷ እንደ ታላላቅ ሕንጻ የኾኑን ቃንቄዎች ትወረውራለች፡፡"
  },
  {
    "surah_id": 77,
    "ayah_number": 33,
    "global_ayah_id": 5655,
    "translation": "(ቃንቄውም) ልክ ዳለቻዎች ግመሎችን ይመስላል፡፡"
  },
  {
    "surah_id": 77,
    "ayah_number": 34,
    "global_ayah_id": 5656,
    "translation": "ለአስተባባዮች በዚያ ቀን ወዮላቸው፡፡"
  },
  {
    "surah_id": 77,
    "ayah_number": 35,
    "global_ayah_id": 5657,
    "translation": "ይህ የማይናገሩበት ቀን ነው፡፡"
  },
  {
    "surah_id": 77,
    "ayah_number": 36,
    "global_ayah_id": 5658,
    "translation": "ይቅርታም ይጠይቁ ዘንድ፤ ለእነርሱ አይፈቀድላቸውም፡፡"
  },
  {
    "surah_id": 77,
    "ayah_number": 37,
    "global_ayah_id": 5659,
    "translation": "ለአስተባባዮች በዚያ ቀን ወዮላቸው፡፡"
  },
  {
    "surah_id": 77,
    "ayah_number": 38,
    "global_ayah_id": 5660,
    "translation": "ይህ መለያው ቀን ነው፡፡ እናንተንም የፊተኞቹንም ሰብሰብናችሁ፡፡"
  },
  {
    "surah_id": 77,
    "ayah_number": 39,
    "global_ayah_id": 5661,
    "translation": "ለናንተም (ለማምለጥ) ብልሃት እንዳላችሁ ተተናኮሉኝ፡፡"
  },
  {
    "surah_id": 77,
    "ayah_number": 40,
    "global_ayah_id": 5662,
    "translation": "ላስተባባዮች በዚያ ቀን ወዮላቸው፡፡"
  },
  {
    "surah_id": 77,
    "ayah_number": 41,
    "global_ayah_id": 5663,
    "translation": "ጥንቁቆቹ በጥላዎችና በምንጮች ውስጥ ናቸው፡፡"
  },
  {
    "surah_id": 77,
    "ayah_number": 42,
    "global_ayah_id": 5664,
    "translation": "ከሚከጅሉትም ሁሉ በፍራፍሬዎች ውስጥ ናቸው፡፡"
  },
  {
    "surah_id": 77,
    "ayah_number": 43,
    "global_ayah_id": 5665,
    "translation": "«ትሠሩት በነበራችሁት ዋጋ የምትደሰቱ ኾናችሁ ብሉ፣ ጠጡም፤» (ይባላሉ)፡፡"
  },
  {
    "surah_id": 77,
    "ayah_number": 44,
    "global_ayah_id": 5666,
    "translation": "እኛ እንደዚሁ መልካም ሠሪዎችን ሁሉ እንመነዳለን፡፡"
  },
  {
    "surah_id": 77,
    "ayah_number": 45,
    "global_ayah_id": 5667,
    "translation": "ለአስተባባዮች በዚያ ቀን ወዮላቸው፡፡"
  },
  {
    "surah_id": 77,
    "ayah_number": 46,
    "global_ayah_id": 5668,
    "translation": "ብሉ፤ ጥቂትንም (ጊዜ) ተጠቀሙ፡፡ እናንተ አመጸኞች ናችሁና፡፡"
  },
  {
    "surah_id": 77,
    "ayah_number": 47,
    "global_ayah_id": 5669,
    "translation": "ለአስተባባዮች በዚያ ቀን ወዮላቸው፡፡"
  },
  {
    "surah_id": 77,
    "ayah_number": 48,
    "global_ayah_id": 5670,
    "translation": "«ለእነርሱ ስገዱም» በተባሉ ጊዜ አይሰግዱም፡፡"
  },
  {
    "surah_id": 77,
    "ayah_number": 49,
    "global_ayah_id": 5671,
    "translation": "ለአስተባባዮች በዚያ ቀን ወዮላቸው፡፡"
  },
  {
    "surah_id": 77,
    "ayah_number": 50,
    "global_ayah_id": 5672,
    "translation": "ከእርሱም ሌላ በየትኛው ንግግር ያምናሉ?"
  }
]