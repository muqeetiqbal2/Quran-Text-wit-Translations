  },
  {
    "surah_id": 77,
    "ayah_number": 6,
    "global_ayah_id": 5628,
    "translation": "Gerek özür için olsun, gerek uyarı için,"
  },
  {
    "surah_id": 77,
    "ayah_number": 7,
