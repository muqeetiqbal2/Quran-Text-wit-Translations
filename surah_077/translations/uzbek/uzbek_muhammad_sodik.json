[
  {
    "surah_id": 77,
    "ayah_number": 1,
    "global_ayah_id": 5623,
    "translation": "Кет-кет юборилганлар билан қасам."
  },
  {
    "surah_id": 77,
    "ayah_number": 2,
    "global_ayah_id": 5624,
    "translation": "Қаттиқ эсувчи шамоллар билан қасам."
  },
  {
    "surah_id": 77,
    "ayah_number": 3,
    "global_ayah_id": 5625,
    "translation": "Ва (шариатни) таратувчилар билан қасам."
  },
  {
    "surah_id": 77,
    "ayah_number": 4,
    "global_ayah_id": 5626,
    "translation": "Фарқловчилар билан қасам."
  },
  {
    "surah_id": 77,
    "ayah_number": 5,
    "global_ayah_id": 5627,
    "translation": "Ваҳийни ташувчилар билан қасам."
  },
  {
    "surah_id": 77,
    "ayah_number": 6,
    "global_ayah_id": 5628,
    "translation": "Узрни ёки огоҳлантиришни (ҳам)."
  },
  {
    "surah_id": 77,
    "ayah_number": 7,
    "global_ayah_id": 5629,
    "translation": "Албатта, сизга ваъда қилинаётган нарса воқеъ бўлувчидир."
  },
  {
    "surah_id": 77,
    "ayah_number": 8,
    "global_ayah_id": 5630,
    "translation": "Бас, вақтики юлдузлар ўчирилса."
  },
  {
    "surah_id": 77,
    "ayah_number": 9,
    "global_ayah_id": 5631,
    "translation": "Ва вақтики, осмон ёрилса."
  },
  {
    "surah_id": 77,
    "ayah_number": 10,
    "global_ayah_id": 5632,
    "translation": "Ва вақтики, тоғлар кўчирилса."
  },
  {
    "surah_id": 77,
    "ayah_number": 11,
    "global_ayah_id": 5633,
    "translation": "Ва вақтики, Пайғамбарларга вақт белгиланса."
  },
  {
    "surah_id": 77,
    "ayah_number": 12,
    "global_ayah_id": 5634,
    "translation": "Қандоқ кунга сурилган-а?"
  },
  {
    "surah_id": 77,
    "ayah_number": 13,
    "global_ayah_id": 5635,
    "translation": "Ажратиш кунига."
  },
  {
    "surah_id": 77,
    "ayah_number": 14,
    "global_ayah_id": 5636,
    "translation": "Ажратиш кунини сенга нима билдирди?"
  },
  {
    "surah_id": 77,
    "ayah_number": 15,
    "global_ayah_id": 5637,
    "translation": "Ўшал кунда ёлғонга чиқарувчиларга вайл бўлсин!"
  },
  {
    "surah_id": 77,
    "ayah_number": 16,
    "global_ayah_id": 5638,
    "translation": "Аввалгиларни ҳалок қилмадикми?"
  },
  {
    "surah_id": 77,
    "ayah_number": 17,
    "global_ayah_id": 5639,
    "translation": "Сўнгра кейингиларини уларга эргаштирмадикми?"
  },
  {
    "surah_id": 77,
    "ayah_number": 18,
    "global_ayah_id": 5640,
    "translation": "Гуноҳкорларни шундоқ қиламиз."
  },
  {
    "surah_id": 77,
    "ayah_number": 19,
    "global_ayah_id": 5641,
    "translation": "Ўшал кунда ёлғонга чиқарувчиларга вайл бўлсин!"
  },
  {
    "surah_id": 77,
    "ayah_number": 20,
    "global_ayah_id": 5642,
    "translation": "Сизларни ҳақир сувдан яратмдикми?"
  },
  {
    "surah_id": 77,
    "ayah_number": 21,
    "global_ayah_id": 5643,
    "translation": "Бас, уни мустаҳкам қароргоҳга жойламадикми?"
  },
  {
    "surah_id": 77,
    "ayah_number": 22,
    "global_ayah_id": 5644,
    "translation": "Маълум вақтга қадар."
  },
  {
    "surah_id": 77,
    "ayah_number": 23,
    "global_ayah_id": 5645,
    "translation": "Бас, Биз қодир бўлдик ва қандоқ ҳам яхши қодир бўлувчимиз. (Юқорида айтилган ишларга қодир бўлдик, ниҳоятда ажойиб, инсоният тафаккуридан устун бир ҳолатда, қодир бўлдик, деяпти Парвардигор.)"
  },
  {
    "surah_id": 77,
    "ayah_number": 24,
    "global_ayah_id": 5646,
    "translation": "Ўшал кунда ёлғонга чиқавчиларга вайл бўлсин!"
  },
  {
    "surah_id": 77,
    "ayah_number": 25,
    "global_ayah_id": 5647,
    "translation": "Ерни ўзига тортувчи қилмадикми?"
  },
  {
    "surah_id": 77,
    "ayah_number": 26,
    "global_ayah_id": 5648,
    "translation": "Тирикларни ва ўликларни?"
  },
  {
    "surah_id": 77,
    "ayah_number": 27,
    "global_ayah_id": 5649,
    "translation": "Ва Биз унда юкасак тоғлар қилдик ва сизларни зилол сув билан суғордик."
  },
  {
    "surah_id": 77,
    "ayah_number": 28,
    "global_ayah_id": 5650,
    "translation": "Ўшал кунда ёлғонга чиқарувчиларга вайл бўлсин!"
  },
  {
    "surah_id": 77,
    "ayah_number": 29,
    "global_ayah_id": 5651,
    "translation": "Юрингиз! Ўзингиз ёлғонга чиқарган нарсага қараб."
  },
  {
    "surah_id": 77,
    "ayah_number": 30,
    "global_ayah_id": 5652,
    "translation": "Юрингиз! Учта шўъбаси бор «соя»га қараб."
  },
  {
    "surah_id": 77,
    "ayah_number": 31,
    "global_ayah_id": 5653,
    "translation": "У салқин қилувчимас ва оловни ҳам қайтармас."
  },
  {
    "surah_id": 77,
    "ayah_number": 32,
    "global_ayah_id": 5654,
    "translation": "Албатта у (жаҳаннам) қасрдек учқунларни отадир."
  },
  {
    "surah_id": 77,
    "ayah_number": 33,
    "global_ayah_id": 5655,
    "translation": "У (учқун) худди қорамтир-сарғиш туяларга ўхшайдир."
  },
  {
    "surah_id": 77,
    "ayah_number": 34,
    "global_ayah_id": 5656,
    "translation": "Ўшал кунда ёлғонга чиқарувчиларга вайл бўлсин!"
  },
  {
    "surah_id": 77,
    "ayah_number": 35,
    "global_ayah_id": 5657,
    "translation": "Бу улар гапира олмайдиган кундир."
  },
  {
    "surah_id": 77,
    "ayah_number": 36,
    "global_ayah_id": 5658,
    "translation": "Ва уларга узр айтишга изн берилмайдир."
  },
  {
    "surah_id": 77,
    "ayah_number": 37,
    "global_ayah_id": 5659,
    "translation": "Ўшал кунда ёлғонга чиқарувчиларга вайл бўлсин!"
  },
  {
    "surah_id": 77,
    "ayah_number": 38,
    "global_ayah_id": 5660,
    "translation": "Бу ажратиш куни, сизларни ва аввалгиларни жамладик."
  },
  {
    "surah_id": 77,
    "ayah_number": 39,
    "global_ayah_id": 5661,
    "translation": "Бас, сизларнинг ҳийлангиз бўлса, менга ишлатиб кўринг-чи?"
  },
  {
    "surah_id": 77,
    "ayah_number": 40,
    "global_ayah_id": 5662,
    "translation": "Ўшал кунда ёлғонга чиқарувчиларга вайл бўлсин!"
  },
  {
    "surah_id": 77,
    "ayah_number": 41,
    "global_ayah_id": 5663,
    "translation": "Албатта тақводорлар соялар ва булоқлардадир."
  },
  {
    "surah_id": 77,
    "ayah_number": 42,
    "global_ayah_id": 5664,
    "translation": "Ва ўзлари хоҳлаган мевалардадир."
  },
  {
    "surah_id": 77,
    "ayah_number": 43,
    "global_ayah_id": 5665,
    "translation": "Енглар ва ичинглар, ош бўлсин. Қилган амалларингиз сабабидандир."
  },
  {
    "surah_id": 77,
    "ayah_number": 44,
    "global_ayah_id": 5666,
    "translation": "Албатта, Биз муҳсинларни шундай мукофотлармиз."
  },
  {
    "surah_id": 77,
    "ayah_number": 45,
    "global_ayah_id": 5667,
    "translation": "Ўшал кунда ёлғонга чиқарувчиларга вайл бўлсин!"
  },
  {
    "surah_id": 77,
    "ayah_number": 46,
    "global_ayah_id": 5668,
    "translation": "Енглар ва мазза қилинглар, озгинагина. Албатта, сизлар гуноҳкорсизлар."
  },
  {
    "surah_id": 77,
    "ayah_number": 47,
    "global_ayah_id": 5669,
    "translation": "Ўшал кунда ёлғонга чиқавурчиларга вайл бўлсин!"
  },
  {
    "surah_id": 77,
    "ayah_number": 48,
    "global_ayah_id": 5670,
    "translation": "Ва агар уларга рукуъ қилинглар дейилса, рукуъ қилмаслар."
  },
  {
    "surah_id": 77,
    "ayah_number": 49,
    "global_ayah_id": 5671,
    "translation": "Ўшал кунда ёлғонга чиқарувчилварга вайл бўлсин!"
  },
  {
    "surah_id": 77,
    "ayah_number": 50,
    "global_ayah_id": 5672,
    "translation": "Бас, ундан кейин, қайси сўзга ишонарлар?!"
  }
]