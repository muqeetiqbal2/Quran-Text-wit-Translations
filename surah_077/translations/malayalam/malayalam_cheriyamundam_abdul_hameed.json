[
  {
    "surah_id": 77,
    "ayah_number": 1,
    "global_ayah_id": 5623,
    "translation": "തുടരെത്തുടരെ അയക്കപ്പെടുന്നവയും,"
  },
  {
    "surah_id": 77,
    "ayah_number": 2,
    "global_ayah_id": 5624,
    "translation": "ശക്തിയായി ആഞ്ഞടിക്കുന്നവയും,"
  },
  {
    "surah_id": 77,
    "ayah_number": 3,
    "global_ayah_id": 5625,
    "translation": "പരക്കെ വ്യാപിപ്പിക്കുന്നവയും,"
  },
  {
    "surah_id": 77,
    "ayah_number": 4,
    "global_ayah_id": 5626,
    "translation": "വേര്‍തിരിച്ചു വിവേചനം ചെയ്യുന്നവയും,"
  },
  {
    "surah_id": 77,
    "ayah_number": 5,
    "global_ayah_id": 5627,
    "translation": "ദിവ്യസന്ദേശം ഇട്ടുകൊടുക്കുന്നവയുമായിട്ടുള്ളവയെ തന്നെയാകുന്നു സത്യം;"
  },
  {
    "surah_id": 77,
    "ayah_number": 6,
    "global_ayah_id": 5628,
    "translation": "ഒരു ഒഴികഴിവായികൊണ്ടോ താക്കീതായിക്കൊണ്ടോ"
  },
  {
    "surah_id": 77,
    "ayah_number": 7,
    "global_ayah_id": 5629,
    "translation": "തീര്‍ച്ചയായും നിങ്ങളോട് താക്കീത് ചെയ്യപ്പെടുന്ന കാര്യം സംഭവിക്കുന്നതു തന്നെയാകുന്നു."
  },
  {
    "surah_id": 77,
    "ayah_number": 8,
    "global_ayah_id": 5630,
    "translation": "നക്ഷത്രങ്ങളുടെ പ്രകാശം മായ്ക്കപ്പെടുകയും,"
  },
  {
    "surah_id": 77,
    "ayah_number": 9,
    "global_ayah_id": 5631,
    "translation": "ആകാശം പിളര്‍ത്തപ്പെടുകയും,"
  },
  {
    "surah_id": 77,
    "ayah_number": 10,
    "global_ayah_id": 5632,
    "translation": "പര്‍വ്വതങ്ങള്‍ പൊടിക്കപ്പെടുകയും,"
  },
  {
    "surah_id": 77,
    "ayah_number": 11,
    "global_ayah_id": 5633,
    "translation": "ദൂതന്‍മാര്‍ക്ക് സമയം നിര്‍ണയിച്ചു കൊടുക്കപ്പെടുകയും ചെയ്താല്‍!"
  },
  {
    "surah_id": 77,
    "ayah_number": 12,
    "global_ayah_id": 5634,
    "translation": "ഏതൊരു ദിവസത്തേക്കാണ് അവര്‍ക്ക് അവധി നിശ്ചയിക്കപ്പെട്ടിരിക്കുന്നത്‌?"
  },
  {
    "surah_id": 77,
    "ayah_number": 13,
    "global_ayah_id": 5635,
    "translation": "തീരുമാനത്തിന്‍റെ ദിവസത്തേക്ക്‌!"
  },
  {
    "surah_id": 77,
    "ayah_number": 14,
    "global_ayah_id": 5636,
    "translation": "ആ തീരുമാനത്തിന്‍റെ ദിവസം എന്താണെന്ന് നിനക്കറിയുമോ?"
  },
  {
    "surah_id": 77,
    "ayah_number": 15,
    "global_ayah_id": 5637,
    "translation": "അന്നേ ദിവസം നിഷേധിച്ചു തള്ളിയവര്‍ക്കാകുന്നു നാശം."
  },
  {
    "surah_id": 77,
    "ayah_number": 16,
    "global_ayah_id": 5638,
    "translation": "പൂര്‍വ്വികന്‍മാരെ നാം നശിപ്പിച്ചു കളഞ്ഞില്ലേ?"
  },
  {
    "surah_id": 77,
    "ayah_number": 17,
    "global_ayah_id": 5639,
    "translation": "പിന്നീട് പിന്‍ഗാമികളെയും അവരുടെ പിന്നാലെ നാം അയക്കുന്നതാണ്‌."
  },
  {
    "surah_id": 77,
    "ayah_number": 18,
    "global_ayah_id": 5640,
    "translation": "അപ്രകാരമാണ് നാം കുറ്റവാളികളെക്കൊണ്ട് പ്രവര്‍ത്തിക്കുക."
  },
  {
    "surah_id": 77,
    "ayah_number": 19,
    "global_ayah_id": 5641,
    "translation": "അന്നേ ദിവസം നിഷേധിച്ചു തള്ളിയവര്‍ക്കായിരിക്കും നാശം."
  },
  {
    "surah_id": 77,
    "ayah_number": 20,
    "global_ayah_id": 5642,
    "translation": "നിസ്സാരപ്പെട്ട ഒരു ദ്രാവകത്തില്‍ നിന്ന് നിങ്ങളെ നാം സൃഷ്ടിച്ചില്ലേ?"
  },
  {
    "surah_id": 77,
    "ayah_number": 21,
    "global_ayah_id": 5643,
    "translation": "എന്നിട്ട് നാം അതിനെ ഭദ്രമായ ഒരു സങ്കേതത്തില്‍ വെച്ചു."
  },
  {
    "surah_id": 77,
    "ayah_number": 22,
    "global_ayah_id": 5644,
    "translation": "നിശ്ചിതമായ ഒരു അവധി വരെ."
  },
  {
    "surah_id": 77,
    "ayah_number": 23,
    "global_ayah_id": 5645,
    "translation": "അങ്ങനെ നാം (എല്ലാം) നിര്‍ണയിച്ചു. അപ്പോള്‍ നാം എത്ര നല്ല നിര്‍ണയക്കാരന്‍!"
  },
  {
    "surah_id": 77,
    "ayah_number": 24,
    "global_ayah_id": 5646,
    "translation": "അന്നേ ദിവസം നിഷേധിച്ചു തള്ളിയവര്‍ക്കാകുന്നു നാശം."
  },
  {
    "surah_id": 77,
    "ayah_number": 25,
    "global_ayah_id": 5647,
    "translation": "ഭൂമിയെ നാം ഉള്‍കൊള്ളുന്നതാക്കിയില്ലേ?"
  },
  {
    "surah_id": 77,
    "ayah_number": 26,
    "global_ayah_id": 5648,
    "translation": "മരിച്ചവരെയും ജീവിച്ചിരിക്കുന്നവരെയും."
  },
  {
    "surah_id": 77,
    "ayah_number": 27,
    "global_ayah_id": 5649,
    "translation": "അതില്‍ ഉന്നതങ്ങളായി ഉറച്ചുനില്‍ക്കുന്ന പര്‍വ്വതങ്ങളെ നാം വെക്കുകയും ചെയ്തിരിക്കുന്നു. നിങ്ങള്‍ക്കു നാം സ്വച്ഛജലം കുടിക്കാന്‍ തരികയും ചെയ്തിരിക്കുന്നു."
  },
  {
    "surah_id": 77,
    "ayah_number": 28,
    "global_ayah_id": 5650,
    "translation": "അന്നേ ദിവസം നിഷേധിച്ചു തള്ളിയവര്‍ക്കാകുന്നു നാശം."
  },
  {
    "surah_id": 77,
    "ayah_number": 29,
    "global_ayah_id": 5651,
    "translation": "(ഹേ, സത്യനിഷേധികളേ,) എന്തൊന്നിനെയായിരുന്നോ നിങ്ങള്‍ നിഷേധിച്ചു തള്ളിയിരുന്നത് അതിലേക്ക് നിങ്ങള്‍ പോയി ക്കൊള്ളുക."
  },
  {
    "surah_id": 77,
    "ayah_number": 30,
    "global_ayah_id": 5652,
    "translation": "മൂന്ന് ശാഖകളുള്ള ഒരു തരം തണലിലേക്ക് നിങ്ങള്‍ പോയിക്കൊള്ളുക."
  },
  {
    "surah_id": 77,
    "ayah_number": 31,
    "global_ayah_id": 5653,
    "translation": "അത് തണല്‍ നല്‍കുന്നതല്ല. തീജ്വാലയില്‍ നിന്ന് സംരക്ഷണം നല്‍കുന്നതുമല്ല."
  },
  {
    "surah_id": 77,
    "ayah_number": 32,
    "global_ayah_id": 5654,
    "translation": "തീര്‍ച്ചയായും അത് (നരകം) വലിയ കെട്ടിടം പോലെ ഉയരമുള്ള തീപ്പൊരി തെറിപ്പിച്ചു കൊണ്ടിരിക്കും."
  },
  {
    "surah_id": 77,
    "ayah_number": 33,
    "global_ayah_id": 5655,
    "translation": "അത് (തീപ്പൊരി) മഞ്ഞനിറമുള്ള ഒട്ടക കൂട്ടങ്ങളെപ്പോലെയായിരിക്കും."
  },
  {
    "surah_id": 77,
    "ayah_number": 34,
    "global_ayah_id": 5656,
    "translation": "അന്നേ ദിവസം നിഷേധിച്ചു തള്ളിയവര്‍ക്കാകുന്നു നാശം."
  },
  {
    "surah_id": 77,
    "ayah_number": 35,
    "global_ayah_id": 5657,
    "translation": "അവര്‍ മിണ്ടാത്തതായ ദിവസമാകുന്നു ഇത്‌."
  },
  {
    "surah_id": 77,
    "ayah_number": 36,
    "global_ayah_id": 5658,
    "translation": "അവര്‍ക്ക് ഒഴികഴിവു ബോധിപ്പിക്കാന്‍ അനുവാദം നല്‍കപ്പെടുകയുമില്ല."
  },
  {
    "surah_id": 77,
    "ayah_number": 37,
    "global_ayah_id": 5659,
    "translation": "അന്നേ ദിവസം നിഷേധിച്ചു തള്ളിയവര്‍ക്കാകുന്നു നാശം."
  },
  {
    "surah_id": 77,
    "ayah_number": 38,
    "global_ayah_id": 5660,
    "translation": "(അന്നവരോട് പറയപ്പെടും:) തീരുമാനത്തിന്‍റെ ദിവസമാണിത്‌. നിങ്ങളെയും പൂര്‍വ്വികന്‍മാരെയും നാം ഇതാ ഒരുമിച്ചുകൂട്ടിയിരിക്കുന്നു."
  },
  {
    "surah_id": 77,
    "ayah_number": 39,
    "global_ayah_id": 5661,
    "translation": "ഇനി നിങ്ങള്‍ക്ക് വല്ല തന്ത്രവും പ്രയോഗിക്കാനുണ്ടെങ്കില്‍ ആ തന്ത്രം പ്രയോഗിച്ചു കൊള്ളുക."
  },
  {
    "surah_id": 77,
    "ayah_number": 40,
    "global_ayah_id": 5662,
    "translation": "അന്നേ ദിവസം നിഷേധിച്ചു തള്ളിയവര്‍ക്കാകുന്നു നാശം."
  },
  {
    "surah_id": 77,
    "ayah_number": 41,
    "global_ayah_id": 5663,
    "translation": "തീര്‍ച്ചയായും സൂക്ഷ്മത പാലിച്ചവര്‍ (സ്വര്‍ഗത്തില്‍) തണലുകളിലും അരുവികള്‍ക്കിടയിലുമാകുന്നു."
  },
  {
    "surah_id": 77,
    "ayah_number": 42,
    "global_ayah_id": 5664,
    "translation": "അവര്‍ ഇഷ്ടപ്പെടുന്ന തരത്തിലുള്ള പഴവര്‍ഗങ്ങള്‍ക്കിടയിലും."
  },
  {
    "surah_id": 77,
    "ayah_number": 43,
    "global_ayah_id": 5665,
    "translation": "(അവരോട് പറയപ്പെടും:) നിങ്ങള്‍ പ്രവര്‍ത്തിച്ചിരുന്നതിന്‍റെ ഫലമായി ആഹ്ലാദത്തോടെ നിങ്ങള്‍ തിന്നുകയും കുടിക്കുകയും ചെയ്തുകൊള്ളുക."
  },
  {
    "surah_id": 77,
    "ayah_number": 44,
    "global_ayah_id": 5666,
    "translation": "തീര്‍ച്ചയായും നാം അപ്രകാരമാകുന്നു സദ്‌വൃത്തര്‍ക്ക് പ്രതിഫലം നല്‍കുന്നത്‌."
  },
  {
    "surah_id": 77,
    "ayah_number": 45,
    "global_ayah_id": 5667,
    "translation": "അന്നേ ദിവസം നിഷേധിച്ചു തള്ളിയവര്‍ക്കാകുന്നു നാശം."
  },
  {
    "surah_id": 77,
    "ayah_number": 46,
    "global_ayah_id": 5668,
    "translation": "(അവരോട് പറയപ്പെടും:) നിങ്ങള്‍ അല്‍പം തിന്നുകയും സുഖമനുഭവിക്കുകയും ചെയ്തു കൊള്ളുക. തീര്‍ച്ചയായും നിങ്ങള്‍ കുറ്റവാളികളാകുന്നു."
  },
  {
    "surah_id": 77,
    "ayah_number": 47,
    "global_ayah_id": 5669,
    "translation": "അന്നേ ദിവസം നിഷേധിച്ചു തള്ളിയവര്‍ക്കാകുന്നു നാശം."
  },
  {
    "surah_id": 77,
    "ayah_number": 48,
    "global_ayah_id": 5670,
    "translation": "അവരോട് കുമ്പിടൂ എന്ന് പറയപ്പെട്ടാല്‍ അവര്‍ കുമ്പിടുകയില്ല."
  },
  {
    "surah_id": 77,
    "ayah_number": 49,
    "global_ayah_id": 5671,
    "translation": "അന്നേ ദിവസം നിഷേധിച്ചു തള്ളിയവര്‍ക്കാകുന്നു നാശം."
  },
  {
    "surah_id": 77,
    "ayah_number": 50,
    "global_ayah_id": 5672,
    "translation": "ഇനി ഇതിന് (ഖുര്‍ആന്ന്‌) ശേഷം ഏതൊരു വര്‍ത്തമാനത്തിലാണ് അവര്‍ വിശ്വസിക്കുന്നത്‌?"
  }
]