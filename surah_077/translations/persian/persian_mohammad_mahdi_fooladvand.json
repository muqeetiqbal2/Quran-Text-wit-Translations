[
  {
    "surah_id": 77,
    "ayah_number": 1,
    "global_ayah_id": 5623,
    "translation": "سوگند به فرستادگان پى‌درپى،"
  },
  {
    "surah_id": 77,
    "ayah_number": 2,
    "global_ayah_id": 5624,
    "translation": "كه سخت توفنده‌اند."
  },
  {
    "surah_id": 77,
    "ayah_number": 3,
    "global_ayah_id": 5625,
    "translation": "و سوگند به افشانندگان افشانگر،"
  },
  {
    "surah_id": 77,
    "ayah_number": 4,
    "global_ayah_id": 5626,
    "translation": "كه [ميان حق و باطل‌] جداگرند،"
  },
  {
    "surah_id": 77,
    "ayah_number": 5,
    "global_ayah_id": 5627,
    "translation": "و القاكننده وحى‌اند."
  },
  {
    "surah_id": 77,
    "ayah_number": 6,
    "global_ayah_id": 5628,
    "translation": "خواه عذرى باشد يا هشدارى."
  },
  {
    "surah_id": 77,
    "ayah_number": 7,
    "global_ayah_id": 5629,
    "translation": "كه آنچه وعده يافته‌ايد قطعاً رخ خواهد داد."
  },
  {
    "surah_id": 77,
    "ayah_number": 8,
    "global_ayah_id": 5630,
    "translation": "پس وقتى كه ستارگان محو شوند،"
  },
  {
    "surah_id": 77,
    "ayah_number": 9,
    "global_ayah_id": 5631,
    "translation": "و آنگاه كه آسمان بشكافد،"
  },
  {
    "surah_id": 77,
    "ayah_number": 10,
    "global_ayah_id": 5632,
    "translation": "و آنگاه كه كوه‌ها از جا كنده شوند،"
  },
  {
    "surah_id": 77,
    "ayah_number": 11,
    "global_ayah_id": 5633,
    "translation": "و آنگاه كه پيمبران به ميقات آيند،"
  },
  {
    "surah_id": 77,
    "ayah_number": 12,
    "global_ayah_id": 5634,
    "translation": "براى چه روزى تعيين وقت شده است؟"
  },
  {
    "surah_id": 77,
    "ayah_number": 13,
    "global_ayah_id": 5635,
    "translation": "براى روز داورى."
  },
  {
    "surah_id": 77,
    "ayah_number": 14,
    "global_ayah_id": 5636,
    "translation": "و تو چه دانى كه روز داورى چيست؟"
  },
  {
    "surah_id": 77,
    "ayah_number": 15,
    "global_ayah_id": 5637,
    "translation": "آن روز واى بر تكذيب‌كنندگان!"
  },
  {
    "surah_id": 77,
    "ayah_number": 16,
    "global_ayah_id": 5638,
    "translation": "مگر پيشينيان را هلاك نكرديم؟"
  },
  {
    "surah_id": 77,
    "ayah_number": 17,
    "global_ayah_id": 5639,
    "translation": "سپس از پى آنان پسينيان را مى‌بريم."
  },
  {
    "surah_id": 77,
    "ayah_number": 18,
    "global_ayah_id": 5640,
    "translation": "با مجرمان چنين مى‌كنيم."
  },
  {
    "surah_id": 77,
    "ayah_number": 19,
    "global_ayah_id": 5641,
    "translation": "آن روز واى بر تكذيب‌كنندگان."
  },
  {
    "surah_id": 77,
    "ayah_number": 20,
    "global_ayah_id": 5642,
    "translation": "مگر شما را از آبى بى‌مقدار نيافريديم؟"
  },
  {
    "surah_id": 77,
    "ayah_number": 21,
    "global_ayah_id": 5643,
    "translation": "پس آن را در جايگاهى استوار نهاديم،"
  },
  {
    "surah_id": 77,
    "ayah_number": 22,
    "global_ayah_id": 5644,
    "translation": "تا مدّتى معيّن!"
  },
  {
    "surah_id": 77,
    "ayah_number": 23,
    "global_ayah_id": 5645,
    "translation": "و توانا آمديم، و چه نيك تواناييم."
  },
  {
    "surah_id": 77,
    "ayah_number": 24,
    "global_ayah_id": 5646,
    "translation": "آن روز واى بر تكذيب‌كنندگان."
  },
  {
    "surah_id": 77,
    "ayah_number": 25,
    "global_ayah_id": 5647,
    "translation": "مگر زمين را محل اجتماع نگردانيديم؟"
  },
  {
    "surah_id": 77,
    "ayah_number": 26,
    "global_ayah_id": 5648,
    "translation": "چه براى مردگان چه زندگان."
  },
  {
    "surah_id": 77,
    "ayah_number": 27,
    "global_ayah_id": 5649,
    "translation": "و كوه‌هاى بلند در آن نهاديم و به شما آبى گوارا نوشانيديم."
  },
  {
    "surah_id": 77,
    "ayah_number": 28,
    "global_ayah_id": 5650,
    "translation": "آن روز واى بر تكذيب‌كنندگان."
  },
  {
    "surah_id": 77,
    "ayah_number": 29,
    "global_ayah_id": 5651,
    "translation": "برويد به سوى همان چيزى كه آن را تكذيب مى‌كرديد."
  },
  {
    "surah_id": 77,
    "ayah_number": 30,
    "global_ayah_id": 5652,
    "translation": "برويد به سوى [آن‌] دود سه شاخه،"
  },
  {
    "surah_id": 77,
    "ayah_number": 31,
    "global_ayah_id": 5653,
    "translation": "نه سايه‌دار است و نه از شعله [آتش‌] حفاظت مى‌كند."
  },
  {
    "surah_id": 77,
    "ayah_number": 32,
    "global_ayah_id": 5654,
    "translation": "[دوزخ‌] چون كاخى [بلند] شراره مى‌افكند،"
  },
  {
    "surah_id": 77,
    "ayah_number": 33,
    "global_ayah_id": 5655,
    "translation": "گويى شترانى زرد رنگند."
  },
  {
    "surah_id": 77,
    "ayah_number": 34,
    "global_ayah_id": 5656,
    "translation": "آن روز واى بر تكذيب‌كنندگان."
  },
  {
    "surah_id": 77,
    "ayah_number": 35,
    "global_ayah_id": 5657,
    "translation": "اين، روزى است كه دم نمى‌زنند."
  },
  {
    "surah_id": 77,
    "ayah_number": 36,
    "global_ayah_id": 5658,
    "translation": "و رخصت نمى‌يابند تا پوزش خواهند."
  },
  {
    "surah_id": 77,
    "ayah_number": 37,
    "global_ayah_id": 5659,
    "translation": "آن روز واى بر تكذيب‌كنندگان."
  },
  {
    "surah_id": 77,
    "ayah_number": 38,
    "global_ayah_id": 5660,
    "translation": "اين [همان‌] روز داورى است شما و [جمله‌] پيشينيان را گرد مى‌آوريم."
  },
  {
    "surah_id": 77,
    "ayah_number": 39,
    "global_ayah_id": 5661,
    "translation": "پس اگر حيلتى داريد، در برابر من بسگاليد."
  },
  {
    "surah_id": 77,
    "ayah_number": 40,
    "global_ayah_id": 5662,
    "translation": "آن روز واى بر تكذيب‌كنندگان."
  },
  {
    "surah_id": 77,
    "ayah_number": 41,
    "global_ayah_id": 5663,
    "translation": "اهل تقوا در زير سايه‌ها و بر كنار چشمه‌سارانند،"
  },
  {
    "surah_id": 77,
    "ayah_number": 42,
    "global_ayah_id": 5664,
    "translation": "با هر ميوه‌اى كه خوش داشته باشند."
  },
  {
    "surah_id": 77,
    "ayah_number": 43,
    "global_ayah_id": 5665,
    "translation": "به [پاداش‌] آنچه مى‌كرديد، بخوريد و بياشاميد؛ گواراتان باد."
  },
  {
    "surah_id": 77,
    "ayah_number": 44,
    "global_ayah_id": 5666,
    "translation": "ما نيكوكاران را چنين پاداش مى‌دهيم."
  },
  {
    "surah_id": 77,
    "ayah_number": 45,
    "global_ayah_id": 5667,
    "translation": "آن روز واى بر تكذيب‌كنندگان."
  },
  {
    "surah_id": 77,
    "ayah_number": 46,
    "global_ayah_id": 5668,
    "translation": "[اى كافران،] بخوريد و اندكى برخوردار شويد كه شما گناهكاريد."
  },
  {
    "surah_id": 77,
    "ayah_number": 47,
    "global_ayah_id": 5669,
    "translation": "[ولى‌] آن روز واى بر تكذيب‌كنندگان."
  },
  {
    "surah_id": 77,
    "ayah_number": 48,
    "global_ayah_id": 5670,
    "translation": "و چون به آنان گفته شود: «ركوع كنيد»، به ركوع نمى‌روند."
  },
  {
    "surah_id": 77,
    "ayah_number": 49,
    "global_ayah_id": 5671,
    "translation": "آن روز واى بر تكذيب‌كنندگان."
  },
  {
    "surah_id": 77,
    "ayah_number": 50,
    "global_ayah_id": 5672,
    "translation": "پس به كدامين سخن پس از [قرآن‌] ايمان مى‌آورند؟"
  }
]