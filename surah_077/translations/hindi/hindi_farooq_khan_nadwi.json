[
  {
    "surah_id": 77,
    "ayah_number": 1,
    "global_ayah_id": 5623,
    "translation": "हवाओं की क़सम जो (पहले) धीमी चलती हैं"
  },
  {
    "surah_id": 77,
    "ayah_number": 2,
    "global_ayah_id": 5624,
    "translation": "फिर ज़ोर पकड़ के ऑंधी हो जाती हैं"
  },
  {
    "surah_id": 77,
    "ayah_number": 3,
    "global_ayah_id": 5625,
    "translation": "और (बादलों को) उभार कर फैला देती हैं"
  },
  {
    "surah_id": 77,
    "ayah_number": 4,
    "global_ayah_id": 5626,
    "translation": "फिर (उनको) फाड़ कर जुदा कर देती हैं"
  },
  {
    "surah_id": 77,
    "ayah_number": 5,
    "global_ayah_id": 5627,
    "translation": "फिर फरिश्तों की क़सम जो वही लाते हैं"
  },
  {
    "surah_id": 77,
    "ayah_number": 6,
    "global_ayah_id": 5628,
    "translation": "ताकि हुज्जत तमाम हो और डरा दिया जाए"
  },
  {
    "surah_id": 77,
    "ayah_number": 7,
    "global_ayah_id": 5629,
    "translation": "कि जिस बात का तुमसे वायदा किया जाता है वह ज़रूर होकर रहेगा"
  },
  {
    "surah_id": 77,
    "ayah_number": 8,
    "global_ayah_id": 5630,
    "translation": "फिर जब तारों की चमक जाती रहेगी"
  },
  {
    "surah_id": 77,
    "ayah_number": 9,
    "global_ayah_id": 5631,
    "translation": "और जब आसमान फट जाएगा"
  },
  {
    "surah_id": 77,
    "ayah_number": 10,
    "global_ayah_id": 5632,
    "translation": "और जब पहाड़ (रूई की तरह) उड़े उड़े फिरेंगे"
  },
  {
    "surah_id": 77,
    "ayah_number": 11,
    "global_ayah_id": 5633,
    "translation": "और जब पैग़म्बर लोग एक मुअय्यन वक्त पर जमा किए जाएँगे"
  },
  {
    "surah_id": 77,
    "ayah_number": 12,
    "global_ayah_id": 5634,
    "translation": "(फिर) भला इन (बातों) में किस दिन के लिए ताख़ीर की गयी है"
  },
  {
    "surah_id": 77,
    "ayah_number": 13,
    "global_ayah_id": 5635,
    "translation": "फ़ैसले के दिन के लिए"
  },
  {
    "surah_id": 77,
    "ayah_number": 14,
    "global_ayah_id": 5636,
    "translation": "और तुमको क्या मालूम की फ़ैसले का दिन क्या है"
  },
  {
    "surah_id": 77,
    "ayah_number": 15,
    "global_ayah_id": 5637,
    "translation": "उस दिन झुठलाने वालों की मिट्टी ख़राब है"
  },
  {
    "surah_id": 77,
    "ayah_number": 16,
    "global_ayah_id": 5638,
    "translation": "क्या हमने अगलों को हलाक नहीं किया"
  },
  {
    "surah_id": 77,
    "ayah_number": 17,
    "global_ayah_id": 5639,
    "translation": "फिर उनके पीछे पीछे पिछलों को भी चलता करेंगे"
  },
  {
    "surah_id": 77,
    "ayah_number": 18,
    "global_ayah_id": 5640,
    "translation": "हम गुनेहगारों के साथ ऐसा ही किया करते हैं"
  },
  {
    "surah_id": 77,
    "ayah_number": 19,
    "global_ayah_id": 5641,
    "translation": "उस दिन झुठलाने वालों की मिट्टी ख़राब है"
  },
  {
    "surah_id": 77,
    "ayah_number": 20,
    "global_ayah_id": 5642,
    "translation": "क्या हमने तुमको ज़लील पानी (मनी) से पैदा नहीं किया"
  },
  {
    "surah_id": 77,
    "ayah_number": 21,
    "global_ayah_id": 5643,
    "translation": "फिर हमने उसको एक मुअय्यन वक्त तक"
  },
  {
    "surah_id": 77,
    "ayah_number": 22,
    "global_ayah_id": 5644,
    "translation": "एक महफूज़ मक़ाम (रहम) में रखा"
  },
  {
    "surah_id": 77,
    "ayah_number": 23,
    "global_ayah_id": 5645,
    "translation": "फिर (उसका) एक अन्दाज़ा मुक़र्रर किया तो हम कैसा अच्छा अन्दाज़ा मुक़र्रर करने वाले हैं"
  },
  {
    "surah_id": 77,
    "ayah_number": 24,
    "global_ayah_id": 5646,
    "translation": "उन दिन झुठलाने वालों की ख़राबी है"
  },
  {
    "surah_id": 77,
    "ayah_number": 25,
    "global_ayah_id": 5647,
    "translation": "क्या हमने ज़मीन को ज़िन्दों और मुर्दों को समेटने वाली नहीं बनाया"
  },
  {
    "surah_id": 77,
    "ayah_number": 26,
    "global_ayah_id": 5648,
    "translation": "और उसमें ऊँचे ऊँचे अटल पहाड़ रख दिए"
  },
  {
    "surah_id": 77,
    "ayah_number": 27,
    "global_ayah_id": 5649,
    "translation": "और तुम लोगों को मीठा पानी पिलाया"
  },
  {
    "surah_id": 77,
    "ayah_number": 28,
    "global_ayah_id": 5650,
    "translation": "उस दिन झुठलाने वालों की ख़राबी है"
  },
  {
    "surah_id": 77,
    "ayah_number": 29,
    "global_ayah_id": 5651,
    "translation": "जिस चीज़ को तुम झुठलाया करते थे अब उसकी तरफ़ चलो"
  },
  {
    "surah_id": 77,
    "ayah_number": 30,
    "global_ayah_id": 5652,
    "translation": "(धुएँ के) साये की तरफ़ चलो जिसके तीन हिस्से हैं"
  },
  {
    "surah_id": 77,
    "ayah_number": 31,
    "global_ayah_id": 5653,
    "translation": "जिसमें न ठन्डक है और न जहन्नुम की लपक से बचाएगा"
  },
  {
    "surah_id": 77,
    "ayah_number": 32,
    "global_ayah_id": 5654,
    "translation": "उससे इतने बड़े बड़े अंगारे बरसते होंगे जैसे महल"
  },
  {
    "surah_id": 77,
    "ayah_number": 33,
    "global_ayah_id": 5655,
    "translation": "गोया ज़र्द रंग के ऊँट हैं"
  },
  {
    "surah_id": 77,
    "ayah_number": 34,
    "global_ayah_id": 5656,
    "translation": "उस दिन झुठलाने वालों की ख़राबी है"
  },
  {
    "surah_id": 77,
    "ayah_number": 35,
    "global_ayah_id": 5657,
    "translation": "ये वह दिन होगा कि लोग लब तक न हिला सकेंगे"
  },
  {
    "surah_id": 77,
    "ayah_number": 36,
    "global_ayah_id": 5658,
    "translation": "और उनको इजाज़त दी जाएगी कि कुछ उज्र माअज़ेरत कर सकें"
  },
  {
    "surah_id": 77,
    "ayah_number": 37,
    "global_ayah_id": 5659,
    "translation": "उस दिन झुठलाने वालों की तबाही है"
  },
  {
    "surah_id": 77,
    "ayah_number": 38,
    "global_ayah_id": 5660,
    "translation": "यही फैसले का दिन है (जिस में) हमने तुमको और अगलों को इकट्ठा किया है"
  },
  {
    "surah_id": 77,
    "ayah_number": 39,
    "global_ayah_id": 5661,
    "translation": "तो अगर तुम्हें कोई दाँव करना हो तो आओ चल चुको"
  },
  {
    "surah_id": 77,
    "ayah_number": 40,
    "global_ayah_id": 5662,
    "translation": "उस दिन झुठलाने वालों की ख़राबी है"
  },
  {
    "surah_id": 77,
    "ayah_number": 41,
    "global_ayah_id": 5663,
    "translation": "बेशक परहेज़गार लोग (दरख्तों की) घनी छाँव में होंगे"
  },
  {
    "surah_id": 77,
    "ayah_number": 42,
    "global_ayah_id": 5664,
    "translation": "और चश्मों और आदमियों में जो उन्हें मरग़ूब हो"
  },
  {
    "surah_id": 77,
    "ayah_number": 43,
    "global_ayah_id": 5665,
    "translation": "(दुनिया में) जो अमल करते थे उसके बदले में मज़े से खाओ पियो"
  },
  {
    "surah_id": 77,
    "ayah_number": 44,
    "global_ayah_id": 5666,
    "translation": "मुबारक हम नेकोकारों को ऐसा ही बदला दिया करते हैं"
  },
  {
    "surah_id": 77,
    "ayah_number": 45,
    "global_ayah_id": 5667,
    "translation": "उस दिन झुठलाने वालों की ख़राबी है"
  },
  {
    "surah_id": 77,
    "ayah_number": 46,
    "global_ayah_id": 5668,
    "translation": "(झुठलाने वालों) चन्द दिन चैन से खा पी लो तुम बेशक गुनेहगार हो"
  },
  {
    "surah_id": 77,
    "ayah_number": 47,
    "global_ayah_id": 5669,
    "translation": "उस दिन झुठलाने वालों की मिट्टी ख़राब है"
  },
  {
    "surah_id": 77,
    "ayah_number": 48,
    "global_ayah_id": 5670,
    "translation": "और जब उनसे कहा जाता है कि रूकूउ करों तो रूकूउ नहीं करते"
  },
  {
    "surah_id": 77,
    "ayah_number": 49,
    "global_ayah_id": 5671,
    "translation": "उस दिन झुठलाने वालों की ख़राबी है"
  },
  {
    "surah_id": 77,
    "ayah_number": 50,
    "global_ayah_id": 5672,
    "translation": "अब इसके बाद ये किस बात पर ईमान लाएँगे"
  }
]