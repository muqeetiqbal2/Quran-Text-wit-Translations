[
  {
    "surah_id": 77,
    "ayah_number": 1,
    "global_ayah_id": 5623,
    "translation": "साक्षी है वे (हवाएँ) जिनकी चोटी छोड़ दी जाती है"
  },
  {
    "surah_id": 77,
    "ayah_number": 2,
    "global_ayah_id": 5624,
    "translation": "फिर ख़ूब तेज़ हो जाती है,"
  },
  {
    "surah_id": 77,
    "ayah_number": 3,
    "global_ayah_id": 5625,
    "translation": "और (बादलों को) उठाकर फैलाती है,"
  },
  {
    "surah_id": 77,
    "ayah_number": 4,
    "global_ayah_id": 5626,
    "translation": "फिर मामला करती है अलग-अलग,"
  },
  {
    "surah_id": 77,
    "ayah_number": 5,
    "global_ayah_id": 5627,
    "translation": "फिर पेश करती है याददिहानी"
  },
  {
    "surah_id": 77,
    "ayah_number": 6,
    "global_ayah_id": 5628,
    "translation": "इल्ज़ाम उतारने या चेतावनी देने के लिए,"
  },
  {
    "surah_id": 77,
    "ayah_number": 7,
    "global_ayah_id": 5629,
    "translation": "निस्संदेह जिसका वादा तुमसे किया जा रहा है वह निश्चित ही घटित होकर रहेगा"
  },
  {
    "surah_id": 77,
    "ayah_number": 8,
    "global_ayah_id": 5630,
    "translation": "अतः जब तारे विलुप्त (प्रकाशहीन) हो जाएँगे,"
  },
  {
    "surah_id": 77,
    "ayah_number": 9,
    "global_ayah_id": 5631,
    "translation": "और जब आकाश फट जाएगा"
  },
  {
    "surah_id": 77,
    "ayah_number": 10,
    "global_ayah_id": 5632,
    "translation": "और पहाड़ चूर्ण-विचूर्ण होकर बिखर जाएँगे;"
  },
  {
    "surah_id": 77,
    "ayah_number": 11,
    "global_ayah_id": 5633,
    "translation": "और जब रसूलों का हाल यह होगा कि उन का समय नियत कर दिया गया होगा -"
  },
  {
    "surah_id": 77,
    "ayah_number": 12,
    "global_ayah_id": 5634,
    "translation": "किस दिन के लिए वे टाले गए है?"
  },
  {
    "surah_id": 77,
    "ayah_number": 13,
    "global_ayah_id": 5635,
    "translation": "फ़ैसले के दिन के लिए"
  },
  {
    "surah_id": 77,
    "ayah_number": 14,
    "global_ayah_id": 5636,
    "translation": "और तुम्हें क्या मालूम कि वह फ़ैसले का दिन क्या है? -"
  },
  {
    "surah_id": 77,
    "ayah_number": 15,
    "global_ayah_id": 5637,
    "translation": "तबाही है उस दिन झूठलाने-वालों की!"
  },
  {
    "surah_id": 77,
    "ayah_number": 16,
    "global_ayah_id": 5638,
    "translation": "क्या ऐसा नहीं हुआ कि हमने पहलों को विनष्ट किया?"
  },
  {
    "surah_id": 77,
    "ayah_number": 17,
    "global_ayah_id": 5639,
    "translation": "फिर उन्हीं के पीछे बादवालों को भी लगाते रहे?"
  },
  {
    "surah_id": 77,
    "ayah_number": 18,
    "global_ayah_id": 5640,
    "translation": "अपराधियों के साथ हम ऐसा ही करते है"
  },
  {
    "surah_id": 77,
    "ayah_number": 19,
    "global_ayah_id": 5641,
    "translation": "तबाही है उस दिन झुठलानेवालो की!"
  },
  {
    "surah_id": 77,
    "ayah_number": 20,
    "global_ayah_id": 5642,
    "translation": "क्या ऐस नहीं है कि हमने तुम्हे तुच्छ जल से पैदा किया,"
  },
  {
    "surah_id": 77,
    "ayah_number": 21,
    "global_ayah_id": 5643,
    "translation": "फिर हमने उसे एक सुरक्षित टिकने की जगह रखा,"
  },
  {
    "surah_id": 77,
    "ayah_number": 22,
    "global_ayah_id": 5644,
    "translation": "एक ज्ञात और निश्चित अवधि तक?"
  },
  {
    "surah_id": 77,
    "ayah_number": 23,
    "global_ayah_id": 5645,
    "translation": "फिर हमने अन्दाजा ठहराया, तो हम क्या ही अच्छा अन्दाज़ा ठहरानेवाले है"
  },
  {
    "surah_id": 77,
    "ayah_number": 24,
    "global_ayah_id": 5646,
    "translation": "तबाही है उस दिन झूठलानेवालों की!"
  },
  {
    "surah_id": 77,
    "ayah_number": 25,
    "global_ayah_id": 5647,
    "translation": "क्या ऐसा नहीं है कि हमने धरती को समेट रखनेवाली बनाया,"
  },
  {
    "surah_id": 77,
    "ayah_number": 26,
    "global_ayah_id": 5648,
    "translation": "ज़िन्दों को भी और मुर्दों को भी,"
  },
  {
    "surah_id": 77,
    "ayah_number": 27,
    "global_ayah_id": 5649,
    "translation": "और उसमें ऊँचे-ऊँचे पहाड़ जमाए और तुम्हें मीठा पानी पिलाया?"
  },
  {
    "surah_id": 77,
    "ayah_number": 28,
    "global_ayah_id": 5650,
    "translation": "तबाही है उस दिन झुठलानेवालों की!"
  },
  {
    "surah_id": 77,
    "ayah_number": 29,
    "global_ayah_id": 5651,
    "translation": "चलो उस चीज़ की ओर जिसे तुम झुठलाते रहे हो!"
  },
  {
    "surah_id": 77,
    "ayah_number": 30,
    "global_ayah_id": 5652,
    "translation": "चलो तीन शाखाओंवाली छाया की ओर,"
  },
  {
    "surah_id": 77,
    "ayah_number": 31,
    "global_ayah_id": 5653,
    "translation": "जिसमें न छाँव है और न वह अग्नि-ज्वाला से बचा सकती है"
  },
  {
    "surah_id": 77,
    "ayah_number": 32,
    "global_ayah_id": 5654,
    "translation": "निस्संदेह वे (ज्वालाएँ) महल जैसी (ऊँची) चिंगारियाँ फेंकती है"
  },
  {
    "surah_id": 77,
    "ayah_number": 33,
    "global_ayah_id": 5655,
    "translation": "मानो वे पीले ऊँट हैं!"
  },
  {
    "surah_id": 77,
    "ayah_number": 34,
    "global_ayah_id": 5656,
    "translation": "तबाही है उस झुठलानेवालों की!"
  },
  {
    "surah_id": 77,
    "ayah_number": 35,
    "global_ayah_id": 5657,
    "translation": "यह वह दिन है कि वे कुछ बोल नहीं रहे है,"
  },
  {
    "surah_id": 77,
    "ayah_number": 36,
    "global_ayah_id": 5658,
    "translation": "तो कोई उज़ पेश करें, (बात यह है कि) उन्हें बोलने की अनुमति नहीं दी जा रही है"
  },
  {
    "surah_id": 77,
    "ayah_number": 37,
    "global_ayah_id": 5659,
    "translation": "तबाही है उस दिन झुठलानेवालों की"
  },
  {
    "surah_id": 77,
    "ayah_number": 38,
    "global_ayah_id": 5660,
    "translation": "\"यह फ़ैसले का दिन है, हमने तुम्हें भी और पहलों को भी इकट्ठा कर दिया"
  },
  {
    "surah_id": 77,
    "ayah_number": 39,
    "global_ayah_id": 5661,
    "translation": "\"अब यदि तुम्हारे पास कोई चाल है तो मेरे विरुद्ध चलो।\""
  },
  {
    "surah_id": 77,
    "ayah_number": 40,
    "global_ayah_id": 5662,
    "translation": "तबाही है उस दिन झुठलानेवालो की!"
  },
  {
    "surah_id": 77,
    "ayah_number": 41,
    "global_ayah_id": 5663,
    "translation": "निस्संदेह डर रखनेवाले छाँवों और स्रोतों में है,"
  },
  {
    "surah_id": 77,
    "ayah_number": 42,
    "global_ayah_id": 5664,
    "translation": "और उन फलों के बीच जो वे चाहे"
  },
  {
    "surah_id": 77,
    "ayah_number": 43,
    "global_ayah_id": 5665,
    "translation": "\"खाओ-पियो मज़े से, उस कर्मों के बदले में जो तुम करते रहे हो।\""
  },
  {
    "surah_id": 77,
    "ayah_number": 44,
    "global_ayah_id": 5666,
    "translation": "निश्चय ही उत्तमकारों को हम ऐसा ही बदला देते है"
  },
  {
    "surah_id": 77,
    "ayah_number": 45,
    "global_ayah_id": 5667,
    "translation": "तबाही है उस दिन झुठलानेवालों की!"
  },
  {
    "surah_id": 77,
    "ayah_number": 46,
    "global_ayah_id": 5668,
    "translation": "\"खा लो और मज़े कर लो थोड़ा-सा, वास्तव में तुम अपराधी हो!\""
  },
  {
    "surah_id": 77,
    "ayah_number": 47,
    "global_ayah_id": 5669,
    "translation": "तबाही है उस दिन झुठलानेवालों की!"
  },
  {
    "surah_id": 77,
    "ayah_number": 48,
    "global_ayah_id": 5670,
    "translation": "जब उनसे कहा जाता है कि \"झुको! तो नहीं झुकते।\""
  },
  {
    "surah_id": 77,
    "ayah_number": 49,
    "global_ayah_id": 5671,
    "translation": "तबाही है उस दिन झुठलानेवालों की!"
  },
  {
    "surah_id": 77,
    "ayah_number": 50,
    "global_ayah_id": 5672,
    "translation": "अब आख़िर इसके पश्चात किस वाणी पर वे ईमान लाएँगे?"
  }
]