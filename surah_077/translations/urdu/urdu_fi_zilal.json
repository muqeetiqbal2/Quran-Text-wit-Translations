    "surah_id": 77,
    "ayah_number": 42,
    "global_ayah_id": 5740,
    "translation": "اور جو «<a href=170> پھل </a>» وہ چاہیں۔ (ان کے لیے «<a href=279> حاضر </a>» ہیں۔)"
