    "surah_id": 77,
    "ayah_number": 22,
    "global_ayah_id": 5720,
    "translation": "ایک مقررہ «<a href=576> مدت </a>» تک"
  },
  {
    "surah_id": 77,
    "ayah_number": 23,
    "global_ayah_id": 5721,
    "translation": "تو دیکھو ، ہم اس پر قادر تھے ، پس ہم بہت اچھی قدرت رکھنے والے ہیں"
  },
  {
    "surah_id": 77,
    "ayah_number": 24,
    "global_ayah_id": 5722,
    "translation": "تباہی ہے اس روز جھٹلانے والوں کے لیے"
  },
  {
    "surah_id": 77,
    "ayah_number": 25,
    "global_ayah_id": 5723,
    "translation": "کیا ہم نے «<a href=379> زمین </a>» کو سمیٹ کر رکھنے والی نہیں بنایا"
  },
  {
    "surah_id": 77,
    "ayah_number": 26,
    "global_ayah_id": 5724,
    "translation": "زندوں کے لیے بھی اور مردوں کے لیے بھی"
  },
  {
    "surah_id": 77,
    "ayah_number": 27,
    "global_ayah_id": 5725,
    "translation": "اور اس میں بلندو بالا «<a href=160> پہاڑ </a>» جمائے اور تمہیں میٹھا «<a href=144> پانی </a>» پلایا ؟"
  },
  {
    "surah_id": 77,
    "ayah_number": 28,
    "global_ayah_id": 5726,
    "translation": "تباہی ہے اس «<a href=326> دن </a>» جھٹلانے والوں کے لیے"
  },
  {
    "surah_id": 77,
    "ayah_number": 29,
    "global_ayah_id": 5727,
    "translation": "چلو اب اسی چیز کی طرف جسے تم جھٹلایا کرتے تھے"
