    "surah_id": 77,
    "ayah_number": 45,
    "global_ayah_id": 5743,
    "translation": "تباہی ہے اس روز جھٹلانے والوں کے لیے"
  },
  {
    "surah_id": 77,
    "ayah_number": 46,
    "global_ayah_id": 5744,
    "translation": "کھالو اور مزے  کرلو تھوڑے دن۔ حقیقت میں تم لوگ مجرم ہو"
