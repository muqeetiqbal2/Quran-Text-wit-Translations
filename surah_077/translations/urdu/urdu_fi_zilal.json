[
  {
    "surah_id": 77,
    "ayah_number": 0,
    "global_ayah_id": 5698,
    "translation": "اللہ کے «<a href=614> نام </a>» سے جو بےانتہا «<a href=600> مہربان </a>» اور رحم فرمانے والا ہے"
  },
  {
    "surah_id": 77,
    "ayah_number": 1,
    "global_ayah_id": 5699,
    "translation": "قسم ہے ان ہواؤں کی جو پے در پے بھیجی جاتی ہیں"
  },
  {
    "surah_id": 77,
    "ayah_number": 2,
    "global_ayah_id": 5700,
    "translation": "پھر طوفانی رفتار سے چلتی ہیں"
  },
  {
    "surah_id": 77,
    "ayah_number": 3,
    "global_ayah_id": 5701,
    "translation": "اور بادلوں کو اٹھا کر پھیلاتی ہیں"
  },
  {
    "surah_id": 77,
    "ayah_number": 4,
    "global_ayah_id": 5702,
    "translation": "پھر ان کو پھاڑ کر جدا کرتی ہیں"
  },
  {
    "surah_id": 77,
    "ayah_number": 5,
    "global_ayah_id": 5703,
    "translation": "پھر دلوں میں خدا کی «<a href=657> یاد </a>» ڈالتی ہیں"
  },
  {
    "surah_id": 77,
    "ayah_number": 6,
    "global_ayah_id": 5704,
    "translation": "عذر کے طور پر یا ڈراوے کے طور پر"
  },
  {
    "surah_id": 77,
    "ayah_number": 7,
    "global_ayah_id": 5705,
    "translation": "جس چیز کا تم سے وعدہ کیا جارہا ہے وہ ضرور واقع ہونے والی ہے"
  },
  {
    "surah_id": 77,
    "ayah_number": 8,
    "global_ayah_id": 5706,
    "translation": "پھر جب ستارے ماند پڑجائیں گے"
  },
  {
    "surah_id": 77,
    "ayah_number": 9,
    "global_ayah_id": 5707,
    "translation": "اور «<a href=10> آسمان </a>» پھاڑ دیا جائے گا"
  },
  {
    "surah_id": 77,
    "ayah_number": 10,
    "global_ayah_id": 5708,
    "translation": "اور «<a href=160> پہاڑ </a>» دھنک ڈالے جائیں گے"
  },
  {
    "surah_id": 77,
    "ayah_number": 11,
    "global_ayah_id": 5709,
    "translation": "اور رسولوں کی حاضری کا «<a href=639> وقت </a>» آپہنچے گا (اس روز وہ چیز واقع ہوجائے گی)"
  },
  {
    "surah_id": 77,
    "ayah_number": 12,
    "global_ayah_id": 5710,
    "translation": "کس روز کے لیے یہ «<a href=481> کام </a>» اٹھا رکھا گیا ہے ؟"
  },
  {
    "surah_id": 77,
    "ayah_number": 13,
    "global_ayah_id": 5711,
    "translation": "فیصلے کے روز کے لیے"
  },
  {
    "surah_id": 77,
    "ayah_number": 14,
    "global_ayah_id": 5712,
    "translation": "اور تمہیں کیا «<a href=293> خبر </a>» کہ وہ فیصلے کا «<a href=326> دن </a>» کیا ہے ؟"
  },
  {
    "surah_id": 77,
    "ayah_number": 15,
    "global_ayah_id": 5713,
    "translation": "تباہی ہے اس «<a href=326> دن </a>» جھٹلانے والوں کے لیے"
  },
  {
    "surah_id": 77,
    "ayah_number": 16,
    "global_ayah_id": 5714,
    "translation": "کیا ہم نے اگلوں کو «<a href=646> ہلاک </a>» نہیں کیا ؟"
  },
  {
    "surah_id": 77,
    "ayah_number": 17,
    "global_ayah_id": 5715,
    "translation": "پھر انہی کے «<a href=179> پیچھے </a>» ہم بعد والوں کو چلتا کریں گے"
  },
  {
    "surah_id": 77,
    "ayah_number": 18,
    "global_ayah_id": 5716,
    "translation": "مجرموں کے ساتھ ہم یہی کچھ کیا کرتے ہیں"
