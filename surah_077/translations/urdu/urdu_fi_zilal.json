  {
    "surah_id": 77,
    "ayah_number": 31,
    "global_ayah_id": 5729,
    "translation": "نہ ٹھنڈک پہنچانے والا اور نہ «<a href=12> آگ </a>» کی لپٹ سے بچانے والا"
  },
  {
    "surah_id": 77,
    "ayah_number": 32,
    "global_ayah_id": 5730,
    "translation": "وہ «<a href=12> آگ </a>» «<a href=572> محل </a>» جیسی بڑی بڑی  چنگاریاں پھینکے گی (جو اچھلتی ہوئی یوں محسوس ہوں گی)"
  },
  {
    "surah_id": 77,
    "ayah_number": 33,
    "global_ayah_id": 5731,
    "translation": "گویا کہ وہ زرد اونٹ ہیں"
  },
  {
    "surah_id": 77,
    "ayah_number": 34,
    "global_ayah_id": 5732,
    "translation": "تباہی ہے اس «<a href=326> دن </a>» جھٹلانے والوں کے لیے"
  },
  {
    "surah_id": 77,
    "ayah_number": 35,
    "global_ayah_id": 5733,
    "translation": "یہ وہ «<a href=326> دن </a>» ہے جس میں وہ نہ کچھ بولیں گے"
  },
  {
    "surah_id": 77,
    "ayah_number": 36,
    "global_ayah_id": 5734,
    "translation": "اور نہ انہیں موقع دیا جائے گا کہ کوئی عذر «<a href=181> پیش </a>» کریں"
  },
  {
    "surah_id": 77,
    "ayah_number": 37,
    "global_ayah_id": 5735,
    "translation": "تباہی ہے اس «<a href=326> دن </a>» جھٹلانے والوں کے لیے"
  },
  {
    "surah_id": 77,
    "ayah_number": 38,
    "global_ayah_id": 5736,
    "translation": "یہ فیصلے کا «<a href=326> دن </a>» ہے۔ ہم نے تمہیں اور تم سے «<a href=162> پہلے </a>» گزرے ہوئے لوگوں کو جمع کردیا ہے"
  },
  {
    "surah_id": 77,
    "ayah_number": 39,
    "global_ayah_id": 5737,
    "translation": "اب اگر کوئی چال تم چل سکتے ہو تو میرے مقابلہ میں چل دیکھو"
  },
  {
    "surah_id": 77,
    "ayah_number": 40,
    "global_ayah_id": 5738,
    "translation": "تباہی ہے اس «<a href=326> دن </a>» جھٹلانے والوں کے لیے"
  },
