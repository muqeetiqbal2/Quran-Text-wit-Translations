    "surah_id": 77,
    "ayah_number": 43,
    "global_ayah_id": 5741,
    "translation": "کھاؤ اور پیو مزے سے اپنے ان «<a href=42> اعمال </a>» کے صلے میں جو تم کرتے رہے ہو"
  },
  {
    "surah_id": 77,
    "ayah_number": 44,
    "global_ayah_id": 5742,
    "translation": "ہم «<a href=634> نیک </a>» لوگوں کو ایسی ہی جزا دیتے ہیں"
