    "surah_id": 77,
    "ayah_number": 48,
    "global_ayah_id": 5746,
    "translation": "جب ان سے کہا جاتا ہے کہ (اللہ کے آگے) جھکو تو نہیں جھکتے"
  },
  {
    "surah_id": 77,
    "ayah_number": 49,
    "global_ayah_id": 5747,
    "translation": "تباہی ہے اس «<a href=326> دن </a>» جھٹلانے والوں کے لیے"
  },
  {
    "surah_id": 77,
    "ayah_number": 50,
    "global_ayah_id": 5748,
    "translation": "اب اس (قرآن) کے بعد اور کون سا کلام ایسا ہوسکتا ہے جس پر یہ ایمان لائیں"
  }
]