  {
    "surah_id": 77,
    "ayah_number": 19,
    "global_ayah_id": 5717,
    "translation": "تباہی ہے ان «<a href=326> دن </a>» جھٹلانے والوں کے لیے"
  },
  {
    "surah_id": 77,
    "ayah_number": 20,
    "global_ayah_id": 5718,
    "translation": "کیا ہم نے ایک حقیر «<a href=144> پانی </a>» سے تمہیں «<a href=180> پیدا </a>» نہیں کیا"
  },
  {
    "surah_id": 77,
    "ayah_number": 21,
    "global_ayah_id": 5719,
    "translation": "اسے ایک محفوظ «<a href=232> جگہ </a>» ٹھیرائے رکھا ؟"
