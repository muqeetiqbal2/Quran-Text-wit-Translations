[
  {
    "surah_id": 77,
    "ayah_number": 0,
    "global_ayah_id": 5698,
    "translation": "اللہ کے نام سے جو رحمان و رحیم ہے"
  },
  {
    "surah_id": 77,
    "ayah_number": 1,
    "global_ayah_id": 5699,
    "translation": "قسم ہے چلتی ہواؤں کی دل کو خوش آتی"
  },
  {
    "surah_id": 77,
    "ayah_number": 2,
    "global_ayah_id": 5700,
    "translation": "پھر جھونکا دینے والیوں کی زور سے"
  },
  {
    "surah_id": 77,
    "ayah_number": 3,
    "global_ayah_id": 5701,
    "translation": "پھر ابھارنے والیوں کی اٹھا کر"
  },
  {
    "surah_id": 77,
    "ayah_number": 4,
    "global_ayah_id": 5702,
    "translation": "پھر پھاڑنے والیوں کی بانٹ کر"
  },
  {
    "surah_id": 77,
    "ayah_number": 5,
    "global_ayah_id": 5703,
    "translation": "پھر فرشتوں کی جو اتار کر لائیں وحی"
  },
  {
    "surah_id": 77,
    "ayah_number": 6,
    "global_ayah_id": 5704,
    "translation": "الزام اتارنے کو یا ڈر سنانے کو"
  },
  {
    "surah_id": 77,
    "ayah_number": 7,
    "global_ayah_id": 5705,
    "translation": "مقرر جو تم سے وعدہ ہوا وہ ضرور ہونا ہے"
  },
  {
    "surah_id": 77,
    "ayah_number": 8,
    "global_ayah_id": 5706,
    "translation": "پھر جب تارے مٹائے جائیں"
  },
  {
    "surah_id": 77,
    "ayah_number": 9,
    "global_ayah_id": 5707,
    "translation": "اور جب آسمان میں جھروکے پڑ جائیں"
  },
  {
    "surah_id": 77,
    "ayah_number": 10,
    "global_ayah_id": 5708,
    "translation": "اور جب پہاڑ اڑا دیے جائیں"
  },
  {
    "surah_id": 77,
    "ayah_number": 11,
    "global_ayah_id": 5709,
    "translation": "اور جب رسولوں کا وقت مقرر ہو جائے"
  },
  {
    "surah_id": 77,
    "ayah_number": 12,
    "global_ayah_id": 5710,
    "translation": "کس دن کے واسطے ان چیزوں میں دیر ہے"
  },
  {
    "surah_id": 77,
    "ayah_number": 13,
    "global_ayah_id": 5711,
    "translation": "اس فیصلے کے دن کے واسطے"
  },
  {
    "surah_id": 77,
    "ayah_number": 14,
    "global_ayah_id": 5712,
    "translation": "اور تو نے کیا بوجھا کیا ہے فیصلے کا دن"
  },
  {
    "surah_id": 77,
    "ayah_number": 15,
    "global_ayah_id": 5713,
    "translation": "خرابی ہے اس دن جھٹلانے والوں کی"
  },
  {
    "surah_id": 77,
    "ayah_number": 16,
    "global_ayah_id": 5714,
    "translation": "کیا ہم نے نہیں مار کھپایا پہلوں کو"
  },
  {
    "surah_id": 77,
    "ayah_number": 17,
    "global_ayah_id": 5715,
    "translation": "پھر اُنکے پیچھے بھیجتے ہیں پچھلوں کو"
  },
  {
    "surah_id": 77,
    "ayah_number": 18,
    "global_ayah_id": 5716,
    "translation": "ہم ایسا ہی کیا کرتے ہیں گنہگاروں کے ساتھ"
  },
  {
    "surah_id": 77,
    "ayah_number": 19,
    "global_ayah_id": 5717,
    "translation": "خرابی ہے اُس دن جھٹلانے والوں کی"
  },
  {
    "surah_id": 77,
    "ayah_number": 20,
    "global_ayah_id": 5718,
    "translation": "کیا ہم نے نہیں بنایا تمکو ایک بے قدر پانی سے"
  },
  {
    "surah_id": 77,
    "ayah_number": 21,
    "global_ayah_id": 5719,
    "translation": "پھر رکھا اُسکو ایک جمے ہوئے ٹھکانے میں"
  },
  {
    "surah_id": 77,
    "ayah_number": 22,
    "global_ayah_id": 5720,
    "translation": "ایک وعدہ مقرر تک"
  },
  {
    "surah_id": 77,
    "ayah_number": 23,
    "global_ayah_id": 5721,
    "translation": "پھر ہم اُسکو پورا کر سکے سو ہم کیا خوب سکت والے ہیں"
  },
  {
    "surah_id": 77,
    "ayah_number": 24,
    "global_ayah_id": 5722,
    "translation": "خرابی ہے اس دن جھٹلانے والوں کی"
  },
  {
    "surah_id": 77,
    "ayah_number": 25,
    "global_ayah_id": 5723,
    "translation": "کیا ہم نے نہیں بنائی زمین سمیٹنے والی"
  },
  {
    "surah_id": 77,
    "ayah_number": 26,
    "global_ayah_id": 5724,
    "translation": "زندوں کو اور مردوں کو"
  },
  {
    "surah_id": 77,
    "ayah_number": 27,
    "global_ayah_id": 5725,
    "translation": "اور رکھے ہم نے زمین میں بوجھ کے لئے پہاڑ اونچے اور پلایا ہم نے تمکو پانی میٹھا پیاس بھجانے والا"
  },
  {
    "surah_id": 77,
    "ayah_number": 28,
    "global_ayah_id": 5726,
    "translation": "خرابی ہے اُس دن جھٹلانے والوں کی"
  },
  {
    "surah_id": 77,
    "ayah_number": 29,
    "global_ayah_id": 5727,
    "translation": "چل کر دیکھو جس چیز کو تم جھٹلاتے تھے"
  },
  {
    "surah_id": 77,
    "ayah_number": 30,
    "global_ayah_id": 5728,
    "translation": "چلو ایک چھاؤں میں جسکی تین پھانکیں ہیں"
  },
  {
    "surah_id": 77,
    "ayah_number": 31,
    "global_ayah_id": 5729,
    "translation": "نہ گہری چھاؤں اور نہ کچھ کام آئے تپش میں"
  },
  {
    "surah_id": 77,
    "ayah_number": 32,
    "global_ayah_id": 5730,
    "translation": "وہ آگ پھینکتی ہے چنگاریاں جیسے محل"
  },
  {
    "surah_id": 77,
    "ayah_number": 33,
    "global_ayah_id": 5731,
    "translation": "گویا وہ اونٹ ہیں زرد"
  },
  {
    "surah_id": 77,
    "ayah_number": 34,
    "global_ayah_id": 5732,
    "translation": "خرابی ہے اس دن جھٹلانے والوں کی"
  },
  {
    "surah_id": 77,
    "ayah_number": 35,
    "global_ayah_id": 5733,
    "translation": "یہ وہ دن ہے کہ نہ بولیں گے"
  },
  {
    "surah_id": 77,
    "ayah_number": 36,
    "global_ayah_id": 5734,
    "translation": "اور نہ اُنکو حکم ہو کہ توبہ کریں"
  },
  {
    "surah_id": 77,
    "ayah_number": 37,
    "global_ayah_id": 5735,
    "translation": "خرابی ہے اُس دن جھٹلانے والوں کی"
  },
  {
    "surah_id": 77,
    "ayah_number": 38,
    "global_ayah_id": 5736,
    "translation": "یہ ہے دن فیصلے کا جمع کیا ہم نے تمکو اور اگلوں کو"
  },
  {
    "surah_id": 77,
    "ayah_number": 39,
    "global_ayah_id": 5737,
    "translation": "پھر اگر کچھ داؤ ہے تمہارا تو چلا لو مجھ پر"
  },
  {
    "surah_id": 77,
    "ayah_number": 40,
    "global_ayah_id": 5738,
    "translation": "خرابی ہے اس دن جھٹلانے والوں کی"
  },
  {
    "surah_id": 77,
    "ayah_number": 41,
    "global_ayah_id": 5739,
    "translation": "البتہ جو ڈرنے والے ہیں وہ سایہ میں ہیں اور نہروں میں"
  },
  {
    "surah_id": 77,
    "ayah_number": 42,
    "global_ayah_id": 5740,
    "translation": "اور میوے جس قسم کے وہ چاہیں"
  },
  {
    "surah_id": 77,
    "ayah_number": 43,
    "global_ayah_id": 5741,
    "translation": "کھاؤ اور پیو مزے سے بدلا اُن کاموں کا جو تم نے کئے تھے"
  },
  {
    "surah_id": 77,
    "ayah_number": 44,
    "global_ayah_id": 5742,
    "translation": "ہم یونہی دیتے ہیں بدلا نیکی والوں کو"
  },
  {
    "surah_id": 77,
    "ayah_number": 45,
    "global_ayah_id": 5743,
    "translation": "خرابی ہے اُس دن جھٹلانے والوں کی"
  },
  {
    "surah_id": 77,
    "ayah_number": 46,
    "global_ayah_id": 5744,
    "translation": "کھا لو اور برت لو تھوڑے دنوں بیشک تم گنہگار ہو"
  },
  {
    "surah_id": 77,
    "ayah_number": 47,
    "global_ayah_id": 5745,
    "translation": "خرابی ہے اُس دن جھٹلانے والوں کی"
  },
  {
    "surah_id": 77,
    "ayah_number": 48,
    "global_ayah_id": 5746,
    "translation": "اور جب کہیے اُن کو کہ جھک جاؤ نہیں جھکتے"
  },
  {
    "surah_id": 77,
    "ayah_number": 49,
    "global_ayah_id": 5747,
    "translation": "خرابی ہے اُس دن جھٹلانے والوں کی"
  },
  {
    "surah_id": 77,
    "ayah_number": 50,
    "global_ayah_id": 5748,
    "translation": "اب کس بات پر اُسکے بعد یقین لائیں گے"
  }
]