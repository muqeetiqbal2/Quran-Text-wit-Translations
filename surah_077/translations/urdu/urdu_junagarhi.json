[
  {
    "surah_id": 77,
    "ayah_number": 0,
    "global_ayah_id": 5698,
    "translation": " «<a href=416> شروع </a>» کرتا ہوں اللہ تعا لٰی کے «<a href=614> نام\n</a>» سے جو بڑا «<a href=600> مہربان </a>» نہایت رحم والا ہے ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 1,
    "global_ayah_id": 5699,
    "translation": " «<a href=324> دل </a>» «<a href=308> خوش </a>» کن چلتی ہوئی ہواؤں کی\n«<a href=472> قسم </a>» ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 2,
    "global_ayah_id": 5700,
    "translation": " پھر زور سے جھونکا دینے والیوں کی «<a href=472> قسم </a>» ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 3,
    "global_ayah_id": 5701,
    "translation": " پھر ( ابر کو ) ابھار کر پراگندہ کرنے والیوں کی «<a href=472> قسم </a>»\n۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 4,
    "global_ayah_id": 5702,
    "translation": " پھر حق اور باطل کو جدا جدا کر دینے والے ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 5,
    "global_ayah_id": 5703,
    "translation": " اور وحی لانے والے فرشتوں کی «<a href=472> قسم </a>» ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 6,
    "global_ayah_id": 5704,
    "translation": " جو ( وحی ) الزام اتارنے یا «<a href=13> آگاہ </a>» کر دینے کیلئے ہوتی\nہے ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 7,
    "global_ayah_id": 5705,
    "translation": " جس چیز کا تم سے وعدہ کیا جاتا ہے وہ یقیناً ہونے والی ہے ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 8,
    "global_ayah_id": 5706,
    "translation": " پس جب ستارے بے نور کر دیئے جائیں گے ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 9,
    "global_ayah_id": 5707,
    "translation": " اور جب «<a href=10> آسمان </a>» توڑ پھوڑ دیا جائے گا ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 10,
    "global_ayah_id": 5708,
    "translation": " اور جب «<a href=160> پہاڑ </a>» ٹکڑے ٹکڑے کرکے اڑا دیئے جائیں گے ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 11,
    "global_ayah_id": 5709,
    "translation": " اور جب رسولوں کو «<a href=639> وقت </a>» مقررہ پر لایا جائے گا ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 12,
    "global_ayah_id": 5710,
    "translation": " کس «<a href=326> دن </a>» کے لئے ( ان سب کو ) مؤخر کیا گیا ہے ؟ "
  },
  {
    "surah_id": 77,
    "ayah_number": 13,
    "global_ayah_id": 5711,
    "translation": " فیصلے کے «<a href=326> دن </a>» کے لئے ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 14,
    "global_ayah_id": 5712,
    "translation": " اور تجھے کیا معلوم کہ فیصلے کا «<a href=326> دن </a>» کیا ہے؟ "
  },
  {
    "surah_id": 77,
    "ayah_number": 15,
    "global_ayah_id": 5713,
    "translation": " اس «<a href=326> دن </a>» جھٹلانے والوں کی «<a href=296> خرابی </a>»\nہے ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 16,
    "global_ayah_id": 5714,
    "translation": " کیا ہم نے اگلوں کو «<a href=646> ہلاک </a>» نہیں کیا؟ "
  },
  {
    "surah_id": 77,
    "ayah_number": 17,
    "global_ayah_id": 5715,
    "translation": " پھر ہم ان کے بعد پچھلوں کو لائے ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 18,
    "global_ayah_id": 5716,
    "translation": " ہم گنہگاروں کے ساتھ اسی طرح کرتے ہیں ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 19,
    "global_ayah_id": 5717,
    "translation": " اس «<a href=326> دن </a>» جھٹلانے والوں کے لئے ویل ( «<a href=43>\n  افسوس </a>» ) ہے ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 20,
    "global_ayah_id": 5718,
    "translation": " کیا ہم نے تمہیں حقیر «<a href=144> پانی </a>» سے ( منی سے ) «<a\n  href=180> پیدا </a>» نہیں کیا ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 21,
    "global_ayah_id": 5719,
    "translation": " پھر ہم نے اسے مضبو ط و محفوظ «<a href=232> جگہ </a>» میں رکھا ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 22,
    "global_ayah_id": 5720,
    "translation": " ایک مقررہ «<a href=639> وقت </a>» تک ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 23,
    "global_ayah_id": 5721,
    "translation": " پھر ہم نے «<a href=56> اندازہ </a>» کیا اور ہم کیا خوب «<a href=56>\n  اندازہ </a>» کرنے والے ہیں ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 24,
    "global_ayah_id": 5722,
    "translation": " اس «<a href=326> دن </a>» تکذیب کرنے والوں کی «<a href=296> خرابی\n</a>» ہے ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 25,
    "global_ayah_id": 5723,
    "translation": " کیا ہم نے «<a href=379> زمین </a>» کو سمیٹنے والی نہیں بنایا؟ "
  },
  {
    "surah_id": 77,
    "ayah_number": 26,
    "global_ayah_id": 5724,
    "translation": " زندوں کو بھی اور مردوں کو بھی ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 27,
    "global_ayah_id": 5725,
    "translation": " اور ہم نے اس میں «<a href=106> بلند </a>» و بھاری «<a href=160> پہاڑ\n</a>» بنا دیئے اور تمہیں سیراب کرنے والا میٹھا «<a href=144> پانی </a>» پلایا ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 28,
    "global_ayah_id": 5726,
    "translation": " اس «<a href=326> دن </a>» «<a href=249> جھوٹ </a>» جاننے والوں کے لئے\nوائے اور «<a href=43> افسوس </a>» ہے ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 29,
    "global_ayah_id": 5727,
    "translation": " اس «<a href=331> دوزخ </a>» کی طرف جاؤ جسے تم جھٹلاتے رہے تھے ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 30,
    "global_ayah_id": 5728,
    "translation": " چلو تین شاخوں والے سائے کی طرف ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 31,
    "global_ayah_id": 5729,
    "translation": " جو دراصل نہ سایہ دینے والا ہے اور نہ شعلے سے بچا سکتا ہے ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 32,
    "global_ayah_id": 5730,
    "translation": " یقیناً «<a href=331> دوزخ </a>» چنگاریاں پھینکتی ہے جو مثل «<a\n  href=572> محل </a>» کے ہیں ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 33,
    "global_ayah_id": 5731,
    "translation": " گویا کہ وہ زرد اونٹ ہیں ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 34,
    "global_ayah_id": 5732,
    "translation": " آج ان «<a href=249> جھوٹ </a>» جاننے والوں کی درگت ہے ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 35,
    "global_ayah_id": 5733,
    "translation": " آج ( کا «<a href=326> دن </a>» ) وہ «<a href=326> دن </a>» ہے کہ یہ\nبول بھی نہ سکیں گے ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 36,
    "global_ayah_id": 5734,
    "translation": " نہ انہیں معذرت کی «<a href=28> اجازت </a>» دی جائے گی ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 37,
    "global_ayah_id": 5735,
    "translation": " اس «<a href=326> دن </a>» جھٹلانے والوں کی «<a href=296> خرابی </a>»\nہے ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 38,
    "global_ayah_id": 5736,
    "translation": " یہ ہے «<a href=461> فیصلہ </a>» کا «<a href=326> دن </a>» ہم نے تمہیں\nاور اگلوں کو سب کو جمع کرلیاہے ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 39,
    "global_ayah_id": 5737,
    "translation": " پس اگر تم مجھ سے کوئی چال چل سکتے ہو تو چل لو ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 40,
    "global_ayah_id": 5738,
    "translation": " وائے ہے اس «<a href=326> دن </a>» جھٹلانے والوں کے لئے ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 41,
    "global_ayah_id": 5739,
    "translation": " بیشک پرہیزگار لوگ سایوں میں ہیں اور بہتے چشموں میں ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 42,
    "global_ayah_id": 5740,
    "translation": " اور ان میووں میں «<a href=236> جن </a>» کی وہ «<a href=305> خواہش\n</a>» کریں ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 43,
    "global_ayah_id": 5741,
    "translation": " ۔ ( اے جنتیو! ) کھاؤ پیو مزے سے اپنے کئے ہوئے «<a href=42> اعمال </a>»\nکے بدلے ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 44,
    "global_ayah_id": 5742,
    "translation": " یقیناً ہم «<a href=635> نیکی </a>» کرنے والوں کو اسی طرح جزا دیتے ہیں\n۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 45,
    "global_ayah_id": 5743,
    "translation": " اس «<a href=326> دن </a>» سچا نہ جاننے والوں کے لئے ویل ( «<a href=43>\n  افسوس </a>» ) ہے ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 46,
    "global_ayah_id": 5744,
    "translation": " ۔ ( اے جھٹلانے والو تم «<a href=327> دنیا </a>» میں ) «<a href=212>\n  تھوڑا </a>» سا کھا لو اور «<a href=452> فائدہ </a>» اٹھالو بیشک تم «<a href=532> گنہگار </a>» ہو ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 47,
    "global_ayah_id": 5745,
    "translation": " اس «<a href=326> دن </a>» جھٹلانے والوں کے لئے «<a href=391> سخت </a>»\n«<a href=645> ہلاکت </a>» ہے ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 48,
    "global_ayah_id": 5746,
    "translation": " ان سے جب کہا جاتا ہے کہ رکوع کر لو تو نہیں کرتے ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 49,
    "global_ayah_id": 5747,
    "translation": " اس «<a href=326> دن </a>» جھٹلانے والوں کی تباہی ہے ۔ "
  },
  {
    "surah_id": 77,
    "ayah_number": 50,
    "global_ayah_id": 5748,
    "translation": " اب اس «<a href=470> قرآن </a>» کے بعد کس «<a href=71> بات </a>» پر\nایمان لائیں گے؟ "
  }
]