[
  {
    "surah_id": 77,
    "ayah_number": 1,
    "global_ayah_id": 5623,
    "translation": "Савганд ба бодҳое, ки аз паи ҳам меоянд"
  },
  {
    "surah_id": 77,
    "ayah_number": 2,
    "global_ayah_id": 5624,
    "translation": "ва савганд ба бодҳои сахти вазанда"
  },
  {
    "surah_id": 77,
    "ayah_number": 3,
    "global_ayah_id": 5625,
    "translation": "ва савганд ба бодҳои бороновар"
  },
  {
    "surah_id": 77,
    "ayah_number": 4,
    "global_ayah_id": 5626,
    "translation": "ва савганд ба онҳо, ки ҳақро аз ботил ҷудо мекунанд"
  },
  {
    "surah_id": 77,
    "ayah_number": 5,
    "global_ayah_id": 5627,
    "translation": "ва савганд ба онҳо, ки ваҳйи Худоро мефароранд,"
  },
  {
    "surah_id": 77,
    "ayah_number": 6,
    "global_ayah_id": 5628,
    "translation": "дафъ кардани узрро ё бим карданро,"
  },
  {
    "surah_id": 77,
    "ayah_number": 7,
    "global_ayah_id": 5629,
    "translation": "ки он чӣ ба шумо ваъда дода шавад, воқеъ хоҳад шуд!"
  },
  {
    "surah_id": 77,
    "ayah_number": 8,
    "global_ayah_id": 5630,
    "translation": "Пас он гоҳ ки ситорагон хомуш шаванд"
  },
  {
    "surah_id": 77,
    "ayah_number": 9,
    "global_ayah_id": 5631,
    "translation": "ва он гоҳ ки осмон бишикофад,"
  },
  {
    "surah_id": 77,
    "ayah_number": 10,
    "global_ayah_id": 5632,
    "translation": "ва он гоҳ ки кӯҳҳо пора-пора гарданд"
  },
  {
    "surah_id": 77,
    "ayah_number": 11,
    "global_ayah_id": 5633,
    "translation": "ва он гоҳ ки паёмбаронро вақте муъайян шавад."
  },
  {
    "surah_id": 77,
    "ayah_number": 12,
    "global_ayah_id": 5634,
    "translation": "Барои чӣ рӯзе муъайян шавад?"
  },
  {
    "surah_id": 77,
    "ayah_number": 13,
    "global_ayah_id": 5635,
    "translation": "Барои рӯзи фасл."
  },
  {
    "surah_id": 77,
    "ayah_number": 14,
    "global_ayah_id": 5636,
    "translation": "Ва чӣ донӣ, ки рӯзи фасл чист?"
  },
  {
    "surah_id": 77,
    "ayah_number": 15,
    "global_ayah_id": 5637,
    "translation": "Дар он рӯз вой бар такзибкунандагон (дурӯғбарорандагон)!"
  },
  {
    "surah_id": 77,
    "ayah_number": 16,
    "global_ayah_id": 5638,
    "translation": "Оё аввалиёнро ҳалок накардаем"
  },
  {
    "surah_id": 77,
    "ayah_number": 17,
    "global_ayah_id": 5639,
    "translation": "ва охириёнро низ аз паи онҳо намебарем?"
  },
  {
    "surah_id": 77,
    "ayah_number": 18,
    "global_ayah_id": 5640,
    "translation": "Бо гунаҳкорон чунин рафтор мекунем."
  },
  {
    "surah_id": 77,
    "ayah_number": 19,
    "global_ayah_id": 5641,
    "translation": "Дар он рӯз вой бар дурӯғбарорандагон!"
  },
  {
    "surah_id": 77,
    "ayah_number": 20,
    "global_ayah_id": 5642,
    "translation": "Оё шуморо аз обе пасту бемиқдор наёфаридаем?"
  },
  {
    "surah_id": 77,
    "ayah_number": 21,
    "global_ayah_id": 5643,
    "translation": "Ва онро дар ҷойгоҳе устувор қарор надодем,"
  },
  {
    "surah_id": 77,
    "ayah_number": 22,
    "global_ayah_id": 5644,
    "translation": "то замоне муъайян?"
  },
  {
    "surah_id": 77,
    "ayah_number": 23,
    "global_ayah_id": 5645,
    "translation": "Пас Мо тавоно будем ва нек тавоно будем!"
  },
  {
    "surah_id": 77,
    "ayah_number": 24,
    "global_ayah_id": 5646,
    "translation": "Дар он рӯз вой бар дурӯғбарорандагон!"
  },
  {
    "surah_id": 77,
    "ayah_number": 25,
    "global_ayah_id": 5647,
    "translation": "Оё заминро ҷойгоҳе насохтем"
  },
  {
    "surah_id": 77,
    "ayah_number": 26,
    "global_ayah_id": 5648,
    "translation": "барои зиндагону мурдагон?"
  },
  {
    "surah_id": 77,
    "ayah_number": 27,
    "global_ayah_id": 5649,
    "translation": "Дар он кӯҳҳои баланд падид овардем ва аз обе гуворо серобатон сохтем."
  },
  {
    "surah_id": 77,
    "ayah_number": 28,
    "global_ayah_id": 5650,
    "translation": "Дар он рӯз вой бар дурӯғбарорандагон!"
  },
  {
    "surah_id": 77,
    "ayah_number": 29,
    "global_ayah_id": 5651,
    "translation": "Ба сӯи он чӣ дурӯғаш мешумурдед, ба роҳ дароед."
  },
  {
    "surah_id": 77,
    "ayah_number": 30,
    "global_ayah_id": 5652,
    "translation": "Ба сӯи он дуди сешуъба (се қисм) ба роҳ афтед,"
  },
  {
    "surah_id": 77,
    "ayah_number": 31,
    "global_ayah_id": 5653,
    "translation": "ки на аз осебатон нигаҳ дорад ва на дафъи од шӯъла кунад,"
  },
  {
    "surah_id": 77,
    "ayah_number": 32,
    "global_ayah_id": 5654,
    "translation": "Ва ҷаҳаннам шарораҳое мепартояд ҳар як ба баландии қасре азим,"
  },
  {
    "surah_id": 77,
    "ayah_number": 33,
    "global_ayah_id": 5655,
    "translation": "гӯӣ, ки уштуроне зард бошанд."
  },
  {
    "surah_id": 77,
    "ayah_number": 34,
    "global_ayah_id": 5656,
    "translation": "Дар он рӯз вой бар дурӯғбарорандагон!"
  },
  {
    "surah_id": 77,
    "ayah_number": 35,
    "global_ayah_id": 5657,
    "translation": "Ин рӯзест, ки кас сухан нагӯяд."
  },
  {
    "surah_id": 77,
    "ayah_number": 36,
    "global_ayah_id": 5658,
    "translation": "Онҳоро рухсат надиҳанд, то узр хоҳанд."
  },
  {
    "surah_id": 77,
    "ayah_number": 37,
    "global_ayah_id": 5659,
    "translation": "Дар он рӯз вой бар дурӯғбарорандагон!"
  },
  {
    "surah_id": 77,
    "ayah_number": 38,
    "global_ayah_id": 5660,
    "translation": "Ин рӯз рӯзи фасл аст, ки шумо ва пешиниёнатонро гирд меоварем."
  },
  {
    "surah_id": 77,
    "ayah_number": 39,
    "global_ayah_id": 5661,
    "translation": "Пас агар ҳилае доред, ба кор баред."
  },
  {
    "surah_id": 77,
    "ayah_number": 40,
    "global_ayah_id": 5662,
    "translation": "Дар он рӯз вой бар дурӯғбарорандагон!"
  },
  {
    "surah_id": 77,
    "ayah_number": 41,
    "global_ayah_id": 5663,
    "translation": "Парҳезгорон дар сояҳову канори чашмасоронанд,"
  },
  {
    "surah_id": 77,
    "ayah_number": 42,
    "global_ayah_id": 5664,
    "translation": "бо ҳар мевае, ки орзу кунанд,"
  },
  {
    "surah_id": 77,
    "ayah_number": 43,
    "global_ayah_id": 5665,
    "translation": "Ба мукофоти корҳое, ки мекардаед, бихӯреду биёшомед, шуморо гуворо бод,"
  },
  {
    "surah_id": 77,
    "ayah_number": 44,
    "global_ayah_id": 5666,
    "translation": "Мо некӯкоронро инчунин мукофот медиҳем!"
  },
  {
    "surah_id": 77,
    "ayah_number": 45,
    "global_ayah_id": 5667,
    "translation": "Дар он рӯз вой бар дурӯғбарорандагон!"
  },
  {
    "surah_id": 77,
    "ayah_number": 46,
    "global_ayah_id": 5668,
    "translation": "Бихӯреду андак баҳрае баргиред (дар дунё), ки шумо гунаҳкоронед,"
  },
  {
    "surah_id": 77,
    "ayah_number": 47,
    "global_ayah_id": 5669,
    "translation": "Дар он рӯз вой бар дурӯғбарорандагон!"
  },
  {
    "surah_id": 77,
    "ayah_number": 48,
    "global_ayah_id": 5670,
    "translation": "Ва чун гӯяндашон, ки руқӯъ кунед, руқӯъ намекунанд (намоз намехонанд)."
  },
  {
    "surah_id": 77,
    "ayah_number": 49,
    "global_ayah_id": 5671,
    "translation": "Дар он рӯз вой бар дурӯғбарорандагон!"
  },
  {
    "surah_id": 77,
    "ayah_number": 50,
    "global_ayah_id": 5672,
    "translation": "Пас аз Қуръон ба кадом сухан имон меоваранд?"
  }
]