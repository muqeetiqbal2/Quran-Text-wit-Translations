[
  {
    "surah_id": 77,
    "ayah_number": 1,
    "global_ayah_id": 5623,
    "translation": "தொடர்ச்சியாக அனுப்பப்படுபவை (காற்று)கள் மீது சத்தியமாக"
  },
  {
    "surah_id": 77,
    "ayah_number": 2,
    "global_ayah_id": 5624,
    "translation": "வேகமாக வீசுகிறவை (புயல் காற்றுகள்) மீது (சத்தியமாக)-"
  },
  {
    "surah_id": 77,
    "ayah_number": 3,
    "global_ayah_id": 5625,
    "translation": "(மேகங்களைப்) பரவலாகப் பரப்பும் (மழைக் காற்றுகள்) மீது சத்தியமாக-"
  },
  {
    "surah_id": 77,
    "ayah_number": 4,
    "global_ayah_id": 5626,
    "translation": "(சத்தியத்தையும் அசத்தியத்தையும்) வேறுபடுத்தி காட்டுவோர் (வானவர்கள்) மீதும் (சத்தியமாக)-"
  },
  {
    "surah_id": 77,
    "ayah_number": 5,
    "global_ayah_id": 5627,
    "translation": "(இதயங்களில்) உபதேசத்தைப் போடுவோர் (வானவர்) மீதும் (சத்தியமாக)-"
  },
  {
    "surah_id": 77,
    "ayah_number": 6,
    "global_ayah_id": 5628,
    "translation": "(அந்த உபதேசம்) மன்னிப்பையோ, அல்லது எச்சரிக்கையையோ (உள்ளடக்கியதாகும்)"
  },
  {
    "surah_id": 77,
    "ayah_number": 7,
    "global_ayah_id": 5629,
    "translation": "நிச்சயமாக உங்களுக்கு வாக்களிக்கப்பட்டது நிகழ்வதேயாகும்."
  },
  {
    "surah_id": 77,
    "ayah_number": 8,
    "global_ayah_id": 5630,
    "translation": "இன்னும், நட்சத்திரங்கள் அழிக்கப்படும்போது-"
  },
  {
    "surah_id": 77,
    "ayah_number": 9,
    "global_ayah_id": 5631,
    "translation": "மேலும், வானம் பிளக்கப்படும் போது-"
  },
  {
    "surah_id": 77,
    "ayah_number": 10,
    "global_ayah_id": 5632,
    "translation": "அன்றியும், மலைகள் (தூசிகளைப் போல்) பறக்கடிக்கப்படும்போது-"
  },
  {
    "surah_id": 77,
    "ayah_number": 11,
    "global_ayah_id": 5633,
    "translation": "மேலும், தூதர்களுக்கு(த் தம் சமூகத்தாருக்காகச் சாட்சியம் கூற) நேரம் குறிக்கப்படும்போது-"
  },
  {
    "surah_id": 77,
    "ayah_number": 12,
    "global_ayah_id": 5634,
    "translation": "எந்த நாள்வரை (இவையெல்லாம்) பிற்படுத்தப்பட்டிருக்கின்றன?"
  },
  {
    "surah_id": 77,
    "ayah_number": 13,
    "global_ayah_id": 5635,
    "translation": "தீர்ப்புக்குரிய நாளுக்காகத்தான்."
  },
  {
    "surah_id": 77,
    "ayah_number": 14,
    "global_ayah_id": 5636,
    "translation": "மேலும், தீர்ப்புக்குரிய நாள் என்னவென்று உமக்கு எது அறிவித்தது?"
  },
  {
    "surah_id": 77,
    "ayah_number": 15,
    "global_ayah_id": 5637,
    "translation": "(நம் வசனங்களைப்) பொய்ப்பிப்போருக்கு அந்நாளில் கேடுதான்."
  },
  {
    "surah_id": 77,
    "ayah_number": 16,
    "global_ayah_id": 5638,
    "translation": "முன்னோர்(களில் குற்றவாளி)களை நாம் அழிக்கவில்லையா?"
  },
  {
    "surah_id": 77,
    "ayah_number": 17,
    "global_ayah_id": 5639,
    "translation": "பிறகு பின்னுள்ளவர்(களில் குற்றவாளி)களையும் (அழிந்தவர்களைப்) பின் தொடரச் செய்வோம்."
  },
  {
    "surah_id": 77,
    "ayah_number": 18,
    "global_ayah_id": 5640,
    "translation": "குற்றவாளிகளை இவ்வாறுதான் நாம் செய்வோம் (தண்டிப்போம்)."
  },
  {
    "surah_id": 77,
    "ayah_number": 19,
    "global_ayah_id": 5641,
    "translation": "பொய்ப்பிப்பவர்களுக்கு அந்நாளில் கேடுதான்."
  },
  {
    "surah_id": 77,
    "ayah_number": 20,
    "global_ayah_id": 5642,
    "translation": "அற்ப நீர்த்துளியிலிருந்து உங்களை நாம் படைக்கவில்லையா?"
  },
  {
    "surah_id": 77,
    "ayah_number": 21,
    "global_ayah_id": 5643,
    "translation": "பின்னர் அதனைப் பத்திரமான இடத்தில் (கர்ப்பத்தில்) உறுதியாக ஆக்கிவைத்தோம்."
  },
  {
    "surah_id": 77,
    "ayah_number": 22,
    "global_ayah_id": 5644,
    "translation": "ஒரு குறிப்பிடட (கால) அளவு வரை."
  },
  {
    "surah_id": 77,
    "ayah_number": 23,
    "global_ayah_id": 5645,
    "translation": "இவ்வாறு நாமே அதை அமைத்திருக்கின்றோம். அமைப்போரில் நாமே மேலானோர்."
  },
  {
    "surah_id": 77,
    "ayah_number": 24,
    "global_ayah_id": 5646,
    "translation": "பொய்ப்பிப்வர்களுக்கு அந்நாளில் கேடுதான்."
  },
  {
    "surah_id": 77,
    "ayah_number": 25,
    "global_ayah_id": 5647,
    "translation": "பூமியை உங்களை அணைத்து (இடம் தந்து)க் கொண்டிருப்பதாக நாம் ஆக்கவில்லையா?"
  },
  {
    "surah_id": 77,
    "ayah_number": 26,
    "global_ayah_id": 5648,
    "translation": "உயிருள்ளோருக்கும், மரித்தோருக்கும் (அது இடம் அளிக்கிறது)."
  },
  {
    "surah_id": 77,
    "ayah_number": 27,
    "global_ayah_id": 5649,
    "translation": "அன்றியும், அதில் உயர்ந்த மலைகளையும் நாம் ஆக்கினோம்; இனிமையான தண்ணீரையும் நாம் உங்களுக்குப் புகட்டினோம்."
  },
  {
    "surah_id": 77,
    "ayah_number": 28,
    "global_ayah_id": 5650,
    "translation": "பொய்ப்பிப்வர்களுக்கு அந்நாளில் கேடுதான்."
  },
  {
    "surah_id": 77,
    "ayah_number": 29,
    "global_ayah_id": 5651,
    "translation": "\"நீங்கள் எதைப் பொய்ப்படுத்திக் கொண்டிருந்தீர்களோ, அதன் பால் நடப்பீர்களாக\" (என்று அவர்களுக்குக் கூறப்படும்)."
  },
  {
    "surah_id": 77,
    "ayah_number": 30,
    "global_ayah_id": 5652,
    "translation": "மூன்று கிளைகளுடைய (நரகப் புகை) நிழலின் பால் நடப்பீர்களாக."
  },
  {
    "surah_id": 77,
    "ayah_number": 31,
    "global_ayah_id": 5653,
    "translation": "(அது) நிழலளிப்பதுமல்ல, (நரகின்) கடுந்தழலை விட்டுக் காப்பாற்றுவதுமல்ல."
  },
  {
    "surah_id": 77,
    "ayah_number": 32,
    "global_ayah_id": 5654,
    "translation": "நிச்சயமாக அது பெரிய மாளிகைகளைப் போன்ற நெருப்புப் பொறிகளைக் கொண்டு வீசி எறிந்து கொண்டு இருக்கும்."
  },
  {
    "surah_id": 77,
    "ayah_number": 33,
    "global_ayah_id": 5655,
    "translation": "நிச்சயமாக அது மஞ்சள் நிறமுள்ள ஒட்டகைகள் போல் இருக்கும்."
  },
  {
    "surah_id": 77,
    "ayah_number": 34,
    "global_ayah_id": 5656,
    "translation": "பொய்ப்பிப்பவர்களுக்கு அந்நாளில் கேடுதான்."
  },
  {
    "surah_id": 77,
    "ayah_number": 35,
    "global_ayah_id": 5657,
    "translation": "இது, அவர்கள் (எதுவும்) பேச முடியாத நாள்."
  },
  {
    "surah_id": 77,
    "ayah_number": 36,
    "global_ayah_id": 5658,
    "translation": "அன்றியும் (தப்புவிப்பதற்காகப்) புகழ் கூறவும் அவர்கள் அனுமதிக்கப்படமாட்டார்கள்."
  },
  {
    "surah_id": 77,
    "ayah_number": 37,
    "global_ayah_id": 5659,
    "translation": "பொய்பிப்பவர்களுக்கு அந்நாளில் கேடுதான்."
  },
  {
    "surah_id": 77,
    "ayah_number": 38,
    "global_ayah_id": 5660,
    "translation": "இது தீர்ப்புக்குரிய நாளாகும். உங்களையும், (உங்களுக்கு) முன் இருந்தோரையும் நாம் ஒன்று சேர்க்கும் (நாள்)."
  },
  {
    "surah_id": 77,
    "ayah_number": 39,
    "global_ayah_id": 5661,
    "translation": "எனவே, (தண்டனையிலிருந்து தப்பித்துக் கொள்ள) உங்களிடம் சூழ்ச்சியிருக்குமானால், சூழ்ச்சி செய்து பாருங்கள்."
  },
  {
    "surah_id": 77,
    "ayah_number": 40,
    "global_ayah_id": 5662,
    "translation": "பொய்ப்பிப்வர்களுக்கு அந்நாளில் கேடுதான்."
  },
  {
    "surah_id": 77,
    "ayah_number": 41,
    "global_ayah_id": 5663,
    "translation": "நிச்சயமாக, பயபக்தியுடையவர்கள் (குளிர்) நிழல்களிலும், நீர்ச் சுனைகளிலும் இருப்பார்கள்."
  },
  {
    "surah_id": 77,
    "ayah_number": 42,
    "global_ayah_id": 5664,
    "translation": "இன்னும், அவர்கள் விரும்பும் கனிவகைகளும் உண்டு."
  },
  {
    "surah_id": 77,
    "ayah_number": 43,
    "global_ayah_id": 5665,
    "translation": "\"நீங்கள் செய்து கொண்டிருந்த (நற்) செயல்களின் காரணமாக, சிரமமின்றி, தாராளமாக புசியுங்கள் இன்னும் பருகுங்கள்\" (என்று கூறப்படும்)."
  },
  {
    "surah_id": 77,
    "ayah_number": 44,
    "global_ayah_id": 5666,
    "translation": "நிச்சயமாக, இவ்வாறே நன்மை செய்வோருக்கு நாம் கூலி கொடுப்போம்."
  },
  {
    "surah_id": 77,
    "ayah_number": 45,
    "global_ayah_id": 5667,
    "translation": "பொய்ப்பிப்பவர்களுக்கு அந்நாளில் கேடுதான்."
  },
  {
    "surah_id": 77,
    "ayah_number": 46,
    "global_ayah_id": 5668,
    "translation": "(பொய்யாக்குவோரே உலகில்) இன்னும் கொஞ்ச (கால)ம் நீங்கள் புசித்துக் கொண்டும், சுகித்துக்கொண்டும் இருங்கள் - நிச்சயமாக நீங்கள் குற்றவாளிகளே."
  },
  {
    "surah_id": 77,
    "ayah_number": 47,
    "global_ayah_id": 5669,
    "translation": "பொய்ப்பிப்பவர்களுக்கு அந்நாளில் கேடுதான்."
  },
  {
    "surah_id": 77,
    "ayah_number": 48,
    "global_ayah_id": 5670,
    "translation": "'நீங்கள் குனிந்து வணங்குங்கள்' என்று அவர்களிடம் கூறப்பட்டால், அவர்கள் குனிந்து வணங்கமாட்டார்கள்."
  },
  {
    "surah_id": 77,
    "ayah_number": 49,
    "global_ayah_id": 5671,
    "translation": "பொய்ப்பிப்பவர்களுக்கு அந்நாளில் கேடுதான்."
  },
  {
    "surah_id": 77,
    "ayah_number": 50,
    "global_ayah_id": 5672,
    "translation": "எனவே, இதன் பின்னர் எந்த விஷயத்தின் மீதுதான் அவர்கள் ஈமான் கொள்வார்கள்?"
  }
]