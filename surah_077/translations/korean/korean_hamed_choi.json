[
  {
    "surah_id": 77,
    "ayah_number": 1,
    "global_ayah_id": 5623,
    "translation": "연이어 보내는 바람을 두고 맹세하사"
  },
  {
    "surah_id": 77,
    "ayah_number": 2,
    "global_ayah_id": 5624,
    "translation": "분노한 폭풍우를 두고 맹세하 며"
  },
  {
    "surah_id": 77,
    "ayah_number": 3,
    "global_ayah_id": 5625,
    "translation": "멀리 구름을 나르는 그들을 두고 맹세하며"
  },
  {
    "surah_id": 77,
    "ayah_number": 4,
    "global_ayah_id": 5626,
    "translation": "서로를 격리시켜 주는 자들을 두고 맹세하며"
  },
  {
    "surah_id": 77,
    "ayah_number": 5,
    "global_ayah_id": 5627,
    "translation": "계시를 전하여 주는 자들을 두고 맹세하나니"
  },
  {
    "surah_id": 77,
    "ayah_number": 6,
    "global_ayah_id": 5628,
    "translation": "진리를 밝히고 경고하노라"
  },
  {
    "surah_id": 77,
    "ayah_number": 7,
    "global_ayah_id": 5629,
    "translation": "실로 너희에게 약속된 것들이다가오고 있노라"
  },
  {
    "surah_id": 77,
    "ayah_number": 8,
    "global_ayah_id": 5630,
    "translation": "별들이 빛을 상실하고"
  },
  {
    "surah_id": 77,
    "ayah_number": 9,
    "global_ayah_id": 5631,
    "translation": "하늘이 쪼개어 지며"
  },
  {
    "surah_id": 77,
    "ayah_number": 10,
    "global_ayah_id": 5632,
    "translation": "산들이 먼지가 되어 휘날려 가고"
  },
  {
    "surah_id": 77,
    "ayah_number": 11,
    "global_ayah_id": 5633,
    "translation": "선지자들이 약속된 시간에 모이게 되는 때"
  },
  {
    "surah_id": 77,
    "ayah_number": 12,
    "global_ayah_id": 5634,
    "translation": "이것들은 어떤 날을 위하여 유예되었더뇨"
  },
  {
    "surah_id": 77,
    "ayah_number": 13,
    "global_ayah_id": 5635,
    "translation": "분류하는 그날을 위해서라"
  },
  {
    "surah_id": 77,
    "ayah_number": 14,
    "global_ayah_id": 5636,
    "translation": "분류하는 그날이 무엇인지 무엇이 그대에게 설명하여 주리요"
  },
  {
    "surah_id": 77,
    "ayah_number": 15,
    "global_ayah_id": 5637,
    "translation": "그날은 진리를 거역한 자들 에게 재앙이 있으리라"
  },
  {
    "surah_id": 77,
    "ayah_number": 16,
    "global_ayah_id": 5638,
    "translation": "하나님이 그들의 죄악으로 말미암아 옛 선조들을 멸망케 하고"
  },
  {
    "surah_id": 77,
    "ayah_number": 17,
    "global_ayah_id": 5639,
    "translation": "그들 후에 새로운 세대를 오도록 하게 했으니"
  },
  {
    "surah_id": 77,
    "ayah_number": 18,
    "global_ayah_id": 5640,
    "translation": "이처럼 하나님은 죄인들을 다루니라"
  },
  {
    "surah_id": 77,
    "ayah_number": 19,
    "global_ayah_id": 5641,
    "translation": "그날 진리를 거역한 자들에 게 재앙이 있을 것이라"
  },
  {
    "surah_id": 77,
    "ayah_number": 20,
    "global_ayah_id": 5642,
    "translation": "하나님이 너희를 창조하매 하찮은 정액으로 창조하지 아니했 더뇨"
  },
  {
    "surah_id": 77,
    "ayah_number": 21,
    "global_ayah_id": 5643,
    "translation": "하나님은 그 정액을 안전한 곳에 두었으되"
  },
  {
    "surah_id": 77,
    "ayah_number": 22,
    "global_ayah_id": 5644,
    "translation": "알려진 기간까지라"
  },
  {
    "surah_id": 77,
    "ayah_number": 23,
    "global_ayah_id": 5645,
    "translation": "하나님은 그렇게 하여 형상 을 결정하니 가장 아름다운 능력 이시라"
  },
  {
    "surah_id": 77,
    "ayah_number": 24,
    "global_ayah_id": 5646,
    "translation": "그날은 진리를 거역한 자들 에게 재앙이 있으리라"
  },
  {
    "surah_id": 77,
    "ayah_number": 25,
    "global_ayah_id": 5647,
    "translation": "하나님이 그 대지를 모이는 곳으로 하지 아니했느뇨"
  },
  {
    "surah_id": 77,
    "ayah_number": 26,
    "global_ayah_id": 5648,
    "translation": "이는 산자와 죽은 자들을 위해서라"
  },
  {
    "surah_id": 77,
    "ayah_number": 27,
    "global_ayah_id": 5649,
    "translation": "그 안에 높은 산들을 두어 너희에게 마실 달콤한 물을 주지 않았더뇨"
  },
  {
    "surah_id": 77,
    "ayah_number": 28,
    "global_ayah_id": 5650,
    "translation": "그날은 진리를 거역한 자들 에게 재앙이 있으리라"
  },
  {
    "surah_id": 77,
    "ayah_number": 29,
    "global_ayah_id": 5651,
    "translation": "너희가 거짓이라 했던 그곳 으로 가라는 말이 있을 것이며"
  },
  {
    "surah_id": 77,
    "ayah_number": 30,
    "global_ayah_id": 5652,
    "translation": "세 갈래의 연기가 싸인 그곳으로 가라"
  },
  {
    "surah_id": 77,
    "ayah_number": 31,
    "global_ayah_id": 5653,
    "translation": "그곳은 시원하게 할 그늘도 화염을 막을 것이 없는 곳이라"
  },
  {
    "surah_id": 77,
    "ayah_number": 32,
    "global_ayah_id": 5654,
    "translation": "실로 궁귈과 같은 크기의 불길이 치솟으니"
  },
  {
    "surah_id": 77,
    "ayah_number": 33,
    "global_ayah_id": 5655,
    "translation": "그 불길은 노란 낙타가 뛰는것과 같노라"
  },
  {
    "surah_id": 77,
    "ayah_number": 34,
    "global_ayah_id": 5656,
    "translation": "그날은 진리를 거역한 자들 에게 재앙이 있으리라"
  },
  {
    "surah_id": 77,
    "ayah_number": 35,
    "global_ayah_id": 5657,
    "translation": "그날은 그들이 어떤 말도 할수 없는 날이 될 것이며"
  },
  {
    "surah_id": 77,
    "ayah_number": 36,
    "global_ayah_id": 5658,
    "translation": "그들에게는 어떠한 변명도 허락되지 아니하니"
  },
  {
    "surah_id": 77,
    "ayah_number": 37,
    "global_ayah_id": 5659,
    "translation": "그날은 진리를 거역한 자들 에게 재앙이 있으리라"
  },
  {
    "surah_id": 77,
    "ayah_number": 38,
    "global_ayah_id": 5660,
    "translation": "그날은 분류를 하는 날이 될 것이며 하나님은 너희 모두와 너 희 이전의 모든 자들을 함께 모이 게 하리니"
  },
  {
    "surah_id": 77,
    "ayah_number": 39,
    "global_ayah_id": 5661,
    "translation": "너희가 계략이나 음모한 것 이 있다면 나에 대항하여 음모하 여 보라"
  },
  {
    "surah_id": 77,
    "ayah_number": 40,
    "global_ayah_id": 5662,
    "translation": "그날은 진리를 거역한 자들 에게 재앙이 있으리라"
  },
  {
    "surah_id": 77,
    "ayah_number": 41,
    "global_ayah_id": 5663,
    "translation": "그러나 의로운 자들은 시원 한 그늘과 우물 가운데 있게 될 것이며"
  },
  {
    "surah_id": 77,
    "ayah_number": 42,
    "global_ayah_id": 5664,
    "translation": "그들은 과실들과 그들이 원 하는 모든 것을 갖게 될 것이라"
  },
  {
    "surah_id": 77,
    "ayah_number": 43,
    "global_ayah_id": 5665,
    "translation": "너희는 기꺼이 먹고 마시라 이는 너희가 행한 의로움 때문이라"
  },
  {
    "surah_id": 77,
    "ayah_number": 44,
    "global_ayah_id": 5666,
    "translation": "이렇듯 하나님은 선을 실천 하는 자들에게 보상을 하니라"
  },
  {
    "surah_id": 77,
    "ayah_number": 45,
    "global_ayah_id": 5667,
    "translation": "그날은 진리를 거역한 자들 에게 재앙이 있으리니"
  },
  {
    "surah_id": 77,
    "ayah_number": 46,
    "global_ayah_id": 5668,
    "translation": "오만한 자들이여 너희도 먹 고 마시라 그러나 순간에 불과하 나니 이는 너희가 죄인들이기 때 문이라"
  },
  {
    "surah_id": 77,
    "ayah_number": 47,
    "global_ayah_id": 5669,
    "translation": "그날은 진리를 거역한 자들 에게 재앙이 있으리라"
  },
  {
    "surah_id": 77,
    "ayah_number": 48,
    "global_ayah_id": 5670,
    "translation": "부복하여 경배하라 그들에게말씀이 있었을 때 그들은 그렇게 하지 아니 했으니"
  },
  {
    "surah_id": 77,
    "ayah_number": 49,
    "global_ayah_id": 5671,
    "translation": "그날은 진리를 거역한 자들에게 재앙이 있으리라"
  },
  {
    "surah_id": 77,
    "ayah_number": 50,
    "global_ayah_id": 5672,
    "translation": "이 말 이후에 그들은 어떤 메세지를 믿으려 하느뇨"
  }
]