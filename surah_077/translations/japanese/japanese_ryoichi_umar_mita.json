[
  {
    "surah_id": 77,
    "ayah_number": 1,
    "global_ayah_id": 5623,
    "translation": "次々に送られる風において。"
  },
  {
    "surah_id": 77,
    "ayah_number": 2,
    "global_ayah_id": 5624,
    "translation": "猛威を振う風において。"
  },
  {
    "surah_id": 77,
    "ayah_number": 3,
    "global_ayah_id": 5625,
    "translation": "雨を(西?)す風において。"
  },
  {
    "surah_id": 77,
    "ayah_number": 4,
    "global_ayah_id": 5626,
    "translation": "真理と虚偽を区別する（クルアーンの）啓示において。"
  },
  {
    "surah_id": 77,
    "ayah_number": 5,
    "global_ayah_id": 5627,
    "translation": "啓示を預言者たちに伝える天使たちにおいて（誓う）。"
  },
  {
    "surah_id": 77,
    "ayah_number": 6,
    "global_ayah_id": 5628,
    "translation": "アッラーからの御諭しと警告として（伝えている）。"
  },
  {
    "surah_id": 77,
    "ayah_number": 7,
    "global_ayah_id": 5629,
    "translation": "（マッカの背信者よ。）あなたがたに約束されたこと（復活の日と懲罰）が確かに起る。"
  },
  {
    "surah_id": 77,
    "ayah_number": 8,
    "global_ayah_id": 5630,
    "translation": "諸星が消される時，"
  },
  {
    "surah_id": 77,
    "ayah_number": 9,
    "global_ayah_id": 5631,
    "translation": "天が裂け散る時，"
  },
  {
    "surah_id": 77,
    "ayah_number": 10,
    "global_ayah_id": 5632,
    "translation": "山々が塵のように運び去られる時，"
  },
  {
    "surah_id": 77,
    "ayah_number": 11,
    "global_ayah_id": 5633,
    "translation": "使徒たちが定められた時に召集される時，"
  },
  {
    "surah_id": 77,
    "ayah_number": 12,
    "global_ayah_id": 5634,
    "translation": "（それらは）いつの日まで猶予されたのか。"
  },
  {
    "surah_id": 77,
    "ayah_number": 13,
    "global_ayah_id": 5635,
    "translation": "裁きの日までである。"
  },
  {
    "surah_id": 77,
    "ayah_number": 14,
    "global_ayah_id": 5636,
    "translation": "裁きの日が何であるかを，あなたに理解させるものは何か。"
  },
  {
    "surah_id": 77,
    "ayah_number": 15,
    "global_ayah_id": 5637,
    "translation": "（真理を）嘘であると言って来た者たちにとり，その日こそ哀れである。"
  },
  {
    "surah_id": 77,
    "ayah_number": 16,
    "global_ayah_id": 5638,
    "translation": "われは（悪行のために）前代の者を滅ぼさなかったか。"
  },
  {
    "surah_id": 77,
    "ayah_number": 17,
    "global_ayah_id": 5639,
    "translation": "その後われは，後代の者にかれらを継がせたではないか。"
  },
  {
    "surah_id": 77,
    "ayah_number": 18,
    "global_ayah_id": 5640,
    "translation": "このようにわれは罪のある者たちを処分する。"
  },
  {
    "surah_id": 77,
    "ayah_number": 19,
    "global_ayah_id": 5641,
    "translation": "（真理を）嘘であると言って来た者たちにとり，その日こそ哀れである。"
  },
  {
    "surah_id": 77,
    "ayah_number": 20,
    "global_ayah_id": 5642,
    "translation": "われはあなたがたを卑しい水から創ったではないか。"
  },
  {
    "surah_id": 77,
    "ayah_number": 21,
    "global_ayah_id": 5643,
    "translation": "われはそれを，安泰な休み所（子宮）に置いた，"
  },
  {
    "surah_id": 77,
    "ayah_number": 22,
    "global_ayah_id": 5644,
    "translation": "定められた時期まで。"
  },
  {
    "surah_id": 77,
    "ayah_number": 23,
    "global_ayah_id": 5645,
    "translation": "われはそう定めた。わが決定の何と善いことよ。"
  },
  {
    "surah_id": 77,
    "ayah_number": 24,
    "global_ayah_id": 5646,
    "translation": "（真理を）嘘であると言って来た者たちにとり，その日こそ哀れである。"
  },
  {
    "surah_id": 77,
    "ayah_number": 25,
    "global_ayah_id": 5647,
    "translation": "われは，大地を大きな容器としなかったか，"
  },
  {
    "surah_id": 77,
    "ayah_number": 26,
    "global_ayah_id": 5648,
    "translation": "生存者と死者（双方のために）。"
  },
  {
    "surah_id": 77,
    "ayah_number": 27,
    "global_ayah_id": 5649,
    "translation": "その上に山々を高く聳えさせ，また清鮮な水をあなたがたに飲ませたではないか。"
  },
  {
    "surah_id": 77,
    "ayah_number": 28,
    "global_ayah_id": 5650,
    "translation": "（真理を）嘘であると言って来た者たちにとり，その日こそ哀れである。"
  },
  {
    "surah_id": 77,
    "ayah_number": 29,
    "global_ayah_id": 5651,
    "translation": "（仰せられよう。）「赴け，あなたがたが嘘であると言って来た所（地獄）ヘ。"
  },
  {
    "surah_id": 77,
    "ayah_number": 30,
    "global_ayah_id": 5652,
    "translation": "赴け，あなたがた3っの枝（に立ち登る煙）の陰に。」"
  },
  {
    "surah_id": 77,
    "ayah_number": 31,
    "global_ayah_id": 5653,
    "translation": "それは影にもならず，また燃え盛る炎に対しては役に立たないであろう。"
  },
  {
    "surah_id": 77,
    "ayah_number": 32,
    "global_ayah_id": 5654,
    "translation": "それは（巨大な）砦のような炎を吐き，"
  },
  {
    "surah_id": 77,
    "ayah_number": 33,
    "global_ayah_id": 5655,
    "translation": "丁度（狂奔する）黄褐色のラクダのよう。"
  },
  {
    "surah_id": 77,
    "ayah_number": 34,
    "global_ayah_id": 5656,
    "translation": "（真理を）嘘であると言って来た者たちにとり，その日こそ哀れである。"
  },
  {
    "surah_id": 77,
    "ayah_number": 35,
    "global_ayah_id": 5657,
    "translation": "それは，発言することが出来ない日であり，"
  },
  {
    "surah_id": 77,
    "ayah_number": 36,
    "global_ayah_id": 5658,
    "translation": "また申し開きも，かれらに許されないであろう。"
  },
  {
    "surah_id": 77,
    "ayah_number": 37,
    "global_ayah_id": 5659,
    "translation": "（真理を）嘘であると言って来た者たちにとり，その日こそ哀れである。"
  },
  {
    "surah_id": 77,
    "ayah_number": 38,
    "global_ayah_id": 5660,
    "translation": "それは裁きの日であり，われはあなたがたも（あなたがた）以前の者たちも，一緒に集める。"
  },
  {
    "surah_id": 77,
    "ayah_number": 39,
    "global_ayah_id": 5661,
    "translation": "あなたがたに何か術策があるのなら，われに向かって策謀するがいい。"
  },
  {
    "surah_id": 77,
    "ayah_number": 40,
    "global_ayah_id": 5662,
    "translation": "（真理を）嘘であると言って来た者たちにとり，その日こそ哀れである。"
  },
  {
    "surah_id": 77,
    "ayah_number": 41,
    "global_ayah_id": 5663,
    "translation": "主を畏れる者は，本当に（涼しい）影と泉の間にいるだろう。"
  },
  {
    "surah_id": 77,
    "ayah_number": 42,
    "global_ayah_id": 5664,
    "translation": "かれらが欲する，凡ての果実（を得る）。"
  },
  {
    "surah_id": 77,
    "ayah_number": 43,
    "global_ayah_id": 5665,
    "translation": "「心の底から満足して食べ且つ飲め，あなたがた（の善い）行いをしたことに対して。」（とわれは言おう。）"
  },
  {
    "surah_id": 77,
    "ayah_number": 44,
    "global_ayah_id": 5666,
    "translation": "このようにわれは，善い行いの者たちに報いる。"
  },
  {
    "surah_id": 77,
    "ayah_number": 45,
    "global_ayah_id": 5667,
    "translation": "（真理を）嘘であると言って来た者たちにとり，その日こそ哀れである。"
  },
  {
    "surah_id": 77,
    "ayah_number": 46,
    "global_ayah_id": 5668,
    "translation": "（あなたがた不義の者よ。）「しばしの間食べ且つ享楽するがいい。本当にあなたがたは罪深い者である。」"
  },
  {
    "surah_id": 77,
    "ayah_number": 47,
    "global_ayah_id": 5669,
    "translation": "（真理を）嘘であると言って来た者たちにとり，その日こそ哀れである。"
  },
  {
    "surah_id": 77,
    "ayah_number": 48,
    "global_ayah_id": 5670,
    "translation": "かれらは，「立礼〔ルクーウ〕せよ。」と言われても立礼しない。"
  },
  {
    "surah_id": 77,
    "ayah_number": 49,
    "global_ayah_id": 5671,
    "translation": "（真理を）嘘であると言ってきた者たちにとり，その日こそ哀れである。"
  },
  {
    "surah_id": 77,
    "ayah_number": 50,
    "global_ayah_id": 5672,
    "translation": "この（クルアーン）を差し置いて，どんな教えをかれらは信じようとするのか。"
  }
]