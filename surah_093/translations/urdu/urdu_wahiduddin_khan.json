    "translation": "شروع اللہ کے «<a href=614> نام </a>» سے جو بڑامہربان، نہایت رحم والا ہے۔"
  },
  {
    "surah_id": 93,
    "ayah_number": 1,
    "global_ayah_id": 6172,
    "translation": "۱۔قسم ہے روزِ روشن کی۔"
  },
  {
    "surah_id": 93,
    "ayah_number": 2,
    "global_ayah_id": 6173,
    "translation": "۲۔اور «<a href=356> رات </a>» کی جب وہ چھاجائے ۔"
  },
  {
    "surah_id": 93,
    "ayah_number": 3,
    "global_ayah_id": 6174,
    "translation": "۳۔تمھارے رب نے تم کو نہیں چھوڑا،اور نہ وہ تم سے «<a href=133> بیزار </a>» ہوا۔"
  },
  {
    "surah_id": 93,
    "ayah_number": 4,
    "global_ayah_id": 6175,
    "translation": "۴۔اور یقیناً آخرت تمھارے لیے «<a href=327> دنیا </a>» سے بہترہے۔"
  },
  {
    "surah_id": 93,
    "ayah_number": 5,
    "global_ayah_id": 6176,
    "translation": "۵۔اور عنقریب اللہ تجھ کو دے گا،پھر تو «<a href=359> راضی </a>» ہوجائے گا۔"
  },
  {
    "surah_id": 93,
    "ayah_number": 6,
    "global_ayah_id": 6177,
    "translation": "۶۔کیا اللہ نے تم کو یتیم نہیں پایا، پھر اُس نے تم کو ٹھکانا دیا۔"
  },
  {
    "surah_id": 93,
    "ayah_number": 7,
    "global_ayah_id": 6178,
    "translation": "۷۔اور تم کو متلاشی پایا تو تم کو راہ دکھائی۔"
  },
  {
    "surah_id": 93,
    "ayah_number": 8,
    "global_ayah_id": 6179,
    "translation": "۸۔اور تم کو نادار پایا تو تم کو غنی کردیا۔"
  },
  {
    "surah_id": 93,
    "ayah_number": 9,
    "global_ayah_id": 6180,
    "translation": "۹۔پس تم یتیم پر «<a href=392> سختی </a>» نہ کرو۔"
  },
  {
    "surah_id": 93,
    "ayah_number": 10,
    "global_ayah_id": 6181,
    "translation": "۱۰۔اور تم سائل کو نہ جھڑکو۔"
  },
  {
    "surah_id": 93,
    "ayah_number": 11,
    "global_ayah_id": 6182,
    "translation": "۱۱۔اور تم اپنے رب کی «<a href=623> نعمت </a>» «<a href=126> بیان </a>» کرو۔"
  }
