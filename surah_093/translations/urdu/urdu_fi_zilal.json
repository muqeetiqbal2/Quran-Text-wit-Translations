    "global_ayah_id": 6171,
    "translation": "اللہ کے «<a href=614> نام </a>» سے جو بےانتہا «<a href=600> مہربان </a>» اور رحم فرمانے والا ہے"
  },
  {
    "surah_id": 93,
    "ayah_number": 1,
    "global_ayah_id": 6172,
    "translation": "قسم ہے روز روشن کی"
  },
  {
    "surah_id": 93,
    "ayah_number": 2,
    "global_ayah_id": 6173,
    "translation": "اور «<a href=356> رات </a>» کی جبکہ وہ سکون کے ساتھ طاری ہوجائے"
  },
  {
    "surah_id": 93,
    "ayah_number": 3,
    "global_ayah_id": 6174,
    "translation": "(اے نبی) تمہارے رب نے تم کو ہرگز نہیں چھوڑا ، اور نہ وہ ناراض ہوا"
  },
  {
    "surah_id": 93,
    "ayah_number": 4,
    "global_ayah_id": 6175,
    "translation": "اور یقیناً تمہارے لیے بعد کا «<a href=328> دور </a>» «<a href=162> پہلے </a>» سے بہتر ہے"
  },
  {
    "surah_id": 93,
    "ayah_number": 5,
    "global_ayah_id": 6176,
    "translation": "اور عنقریب تمہارا رب تم کو اتنا دے گا کہ تم «<a href=308> خوش </a>» ہوجاؤ گے"
  },
  {
    "surah_id": 93,
    "ayah_number": 6,
    "global_ayah_id": 6177,
    "translation": "کیا اس نے تم کو یتیم نہیں پایا اور پھر ٹھکانہ فراہم کیا ؟"
  },
  {
    "surah_id": 93,
    "ayah_number": 7,
    "global_ayah_id": 6178,
    "translation": "اور تمہیں ناواقف راہ پایا اور پھر «<a href=644> ہدایت </a>» بخشی"
  },
  {
    "surah_id": 93,
    "ayah_number": 8,
    "global_ayah_id": 6179,
    "translation": "اور تمہیں نادار پایا اور پھر مالدار کردیا"
  },
  {
    "surah_id": 93,
    "ayah_number": 9,
    "global_ayah_id": 6180,
    "translation": "لہٰذا یتیم پر «<a href=392> سختی </a>» نہ کرو"
  },
  {
    "surah_id": 93,
    "ayah_number": 10,
    "global_ayah_id": 6181,
    "translation": "اور سائل کو نہ جھڑکو"
  },
  {
    "surah_id": 93,
    "ayah_number": 11,
    "global_ayah_id": 6182,
    "translation": "اور اپنے رب کی «<a href=623> نعمت </a>» کا اظہار کرو"
  }
