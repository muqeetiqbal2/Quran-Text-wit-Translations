[
  {
    "surah_id": 93,
    "ayah_number": 0,
    "global_ayah_id": 6171,
    "translation": "اللہ کے نام سے جو رحمان و رحیم ہے"
  },
  {
    "surah_id": 93,
    "ayah_number": 1,
    "global_ayah_id": 6172,
    "translation": "قسم دھوپ چڑھتے وقت کی"
  },
  {
    "surah_id": 93,
    "ayah_number": 2,
    "global_ayah_id": 6173,
    "translation": "اور رات کی جب چھا جائے"
  },
  {
    "surah_id": 93,
    "ayah_number": 3,
    "global_ayah_id": 6174,
    "translation": "نہ رخصت کر دیا تجھ کو تیرے رب نے اور نہ بیزار ہوا"
  },
  {
    "surah_id": 93,
    "ayah_number": 4,
    "global_ayah_id": 6175,
    "translation": "اور البتہ پچھلی بہتر ہے تجھ کو پہلی سے"
  },
  {
    "surah_id": 93,
    "ayah_number": 5,
    "global_ayah_id": 6176,
    "translation": "اور آگے دے گا تجھ کو تیرا رب پھر تو راضی ہو گا"
  },
  {
    "surah_id": 93,
    "ayah_number": 6,
    "global_ayah_id": 6177,
    "translation": "بھلا نہیں پایا تجھ کو یتیم پھر جگہ دی"
  },
  {
    "surah_id": 93,
    "ayah_number": 7,
    "global_ayah_id": 6178,
    "translation": "اور پایا تجھ کو بھٹکتا پھر راہ سجھائی"
  },
  {
    "surah_id": 93,
    "ayah_number": 8,
    "global_ayah_id": 6179,
    "translation": "اور پایا تجھ کو مفلس پھر بے پروا کر دیا"
  },
  {
    "surah_id": 93,
    "ayah_number": 9,
    "global_ayah_id": 6180,
    "translation": "سو جو یتیم ہو اُس کو مت دبا"
  },
  {
    "surah_id": 93,
    "ayah_number": 10,
    "global_ayah_id": 6181,
    "translation": "اور جو مانگتا ہو اُسکو مت جھڑک"
  },
  {
    "surah_id": 93,
    "ayah_number": 11,
    "global_ayah_id": 6182,
    "translation": "اور جو احسان ہے تیرے رب کا سو بیان کر"
  }
]