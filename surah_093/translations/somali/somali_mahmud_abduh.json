[
  {
    "surah_id": 93,
    "ayah_number": 1,
    "global_ayah_id": 6080,
    "translation": "Eebe wuxuu ku dhaartay Barqinka."
  },
  {
    "surah_id": 93,
    "ayah_number": 2,
    "global_ayah_id": 6081,
    "translation": "Iyo Habeenku markuu xasilo (Madoobaado)."
  },
  {
    "surah_id": 93,
    "ayah_number": 3,
    "global_ayah_id": 6082,
    "translation": "Inaan Eebe ka tagin Nabiyow kuuna cadhoonin."
  },
  {
    "surah_id": 93,
    "ayah_number": 4,
    "global_ayah_id": 6083,
    "translation": "Aakharana kaaga khayr badan Aduunka."
  },
  {
    "surah_id": 93,
    "ayah_number": 5,
    "global_ayah_id": 6084,
    "translation": "Eebaana ku siindoona (wanaag) waadna raalli noqon."
  },
  {
    "surah_id": 93,
    "ayah_number": 6,
    "global_ayah_id": 6085,
    "translation": "Miyuusan ku helin Eebahaa Adigoo Agoon ah oosan ku dhawaynin."
  },
  {
    "surah_id": 93,
    "ayah_number": 7,
    "global_ayah_id": 6086,
    "translation": "Miyuunase ku helin Adigoo baadi ah oosan ku hanuuninin."
  },
  {
    "surah_id": 93,
    "ayah_number": 8,
    "global_ayah_id": 6087,
    "translation": "Miyuunase ku helin Adigoo caydhi ah oosna ku hodminin (kuu waxyoonin)."
  },
  {
    "surah_id": 93,
    "ayah_number": 9,
    "global_ayah_id": 6088,
    "translation": "Ee Agoonta ha xoogin (hana dhihin)."
  },
  {
    "surah_id": 93,
    "ayah_number": 10,
    "global_ayah_id": 6089,
    "translation": "Ka wax su'aalina ha canaanan."
  },
  {
    "surah_id": 93,
    "ayah_number": 11,
    "global_ayah_id": 6090,
    "translation": "Nicmada Eebahaana ka sheekee (ku mahadi)."
  }
]