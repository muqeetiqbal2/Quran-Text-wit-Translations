[
  {
    "surah_id": 93,
    "ayah_number": 0,
    "global_ayah_id": 6171,
    "translation": "En el nombre de Dios, el Compasivo con toda la creación, el Misericordioso con los creyentes."
  },
  {
    "surah_id": 93,
    "ayah_number": 1,
    "global_ayah_id": 6172,
    "translation": "Juro por el resplandor matinal,"
  },
  {
    "surah_id": 93,
    "ayah_number": 2,
    "global_ayah_id": 6173,
    "translation": "por la noche cuando se serena,"
  },
  {
    "surah_id": 93,
    "ayah_number": 3,
    "global_ayah_id": 6174,
    "translation": "que tu Señor no te ha abandonado ni aborrecido [oh, Mujámmad]."
  },
  {
    "surah_id": 93,
    "ayah_number": 4,
    "global_ayah_id": 6175,
    "translation": "La vida del más allá será mejor para ti que esta."
  },
  {
    "surah_id": 93,
    "ayah_number": 5,
    "global_ayah_id": 6176,
    "translation": "Tu Señor te agraciará y te complacerás."
  },
  {
    "surah_id": 93,
    "ayah_number": 6,
    "global_ayah_id": 6177,
    "translation": "¿Acaso no te encontró huérfano y te dio amparo,"
  },
  {
    "surah_id": 93,
    "ayah_number": 7,
    "global_ayah_id": 6178,
    "translation": "y te encontró perdido y te guió,"
  },
  {
    "surah_id": 93,
    "ayah_number": 8,
    "global_ayah_id": 6179,
    "translation": "y te encontró pobre y te enriqueció?"
  },
  {
    "surah_id": 93,
    "ayah_number": 9,
    "global_ayah_id": 6180,
    "translation": "No maltrates al huérfano"
  },
  {
    "surah_id": 93,
    "ayah_number": 10,
    "global_ayah_id": 6181,
    "translation": "ni rechaces al mendigo."
  },
  {
    "surah_id": 93,
    "ayah_number": 11,
    "global_ayah_id": 6182,
    "translation": "Y divulga las bendiciones de tu Señor."
  }
]