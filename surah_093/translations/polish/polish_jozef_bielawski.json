[
  {
    "surah_id": 93,
    "ayah_number": 1,
    "global_ayah_id": 6080,
    "translation": "Na jasność poranka!"
  },
  {
    "surah_id": 93,
    "ayah_number": 2,
    "global_ayah_id": 6081,
    "translation": "Na noc, kiedy spokojnie zapada!"
  },
  {
    "surah_id": 93,
    "ayah_number": 3,
    "global_ayah_id": 6082,
    "translation": "Nie opuścił cię twój Pan ani cię nie znienawidził."
  },
  {
    "surah_id": 93,
    "ayah_number": 4,
    "global_ayah_id": 6083,
    "translation": "I z pewnością ostateczne będzie lepsze dla ciebie aniżeli pierwsze!"
  },
  {
    "surah_id": 93,
    "ayah_number": 5,
    "global_ayah_id": 6084,
    "translation": "I z pewnością niebawem obdarzy cię twój Pan i będziesz zadowolony!"
  },
  {
    "surah_id": 93,
    "ayah_number": 6,
    "global_ayah_id": 6085,
    "translation": "Czyż nie znalazł cię sierotą i czy nie dał ci schronienia?"
  },
  {
    "surah_id": 93,
    "ayah_number": 7,
    "global_ayah_id": 6086,
    "translation": "Czy nie znalazł cię błądzącym i czy nie poprowadził cię drogą prostą?"
  },
  {
    "surah_id": 93,
    "ayah_number": 8,
    "global_ayah_id": 6087,
    "translation": "I czy nie znalazł cię biednym, i nie wzbogacił cię?"
  },
  {
    "surah_id": 93,
    "ayah_number": 9,
    "global_ayah_id": 6088,
    "translation": "Przeto sieroty - nie uciskaj!"
  },
  {
    "surah_id": 93,
    "ayah_number": 10,
    "global_ayah_id": 6089,
    "translation": "A żebraka - nie odpychaj!"
  },
  {
    "surah_id": 93,
    "ayah_number": 11,
    "global_ayah_id": 6090,
    "translation": "A o dobrodziejstwie twego Pana - opowiadaj!"
  }
]