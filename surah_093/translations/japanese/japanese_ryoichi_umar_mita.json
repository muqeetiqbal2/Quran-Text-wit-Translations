[
  {
    "surah_id": 93,
    "ayah_number": 1,
    "global_ayah_id": 6080,
    "translation": "朝（の輝き）において，"
  },
  {
    "surah_id": 93,
    "ayah_number": 2,
    "global_ayah_id": 6081,
    "translation": "静寂な夜において（誓う）。"
  },
  {
    "surah_id": 93,
    "ayah_number": 3,
    "global_ayah_id": 6082,
    "translation": "主は，あなたを見捨てられず，憎まれた訳でもない。"
  },
  {
    "surah_id": 93,
    "ayah_number": 4,
    "global_ayah_id": 6083,
    "translation": "本当に来世（将来）は，あなたにとって現世（現在）より，もっと良いのである。"
  },
  {
    "surah_id": 93,
    "ayah_number": 5,
    "global_ayah_id": 6084,
    "translation": "やがて主はあなたの満足するものを御授けになる。"
  },
  {
    "surah_id": 93,
    "ayah_number": 6,
    "global_ayah_id": 6085,
    "translation": "かれは孤児のあなたを見付けられ，庇護なされたではないか。"
  },
  {
    "surah_id": 93,
    "ayah_number": 7,
    "global_ayah_id": 6086,
    "translation": "かれはさ迷っていたあなたを見付けて，導きを与え。"
  },
  {
    "surah_id": 93,
    "ayah_number": 8,
    "global_ayah_id": 6087,
    "translation": "また貧しいあなたを見付けて，裕福になされたではないか。"
  },
  {
    "surah_id": 93,
    "ayah_number": 9,
    "global_ayah_id": 6088,
    "translation": "だから孤児を虐げてはならない。"
  },
  {
    "surah_id": 93,
    "ayah_number": 10,
    "global_ayah_id": 6089,
    "translation": "請う者を揆ね付けてはならない。"
  },
  {
    "surah_id": 93,
    "ayah_number": 11,
    "global_ayah_id": 6090,
    "translation": "あなたの主の恩恵を宣べ伝えるがいい。"
  }
]