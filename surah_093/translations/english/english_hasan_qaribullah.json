    "surah_id": 93,
    "ayah_number": 3,
    "global_ayah_id": 6082,
    "translation": "your Lord has not forsaken you (Prophet Muhammad), nor does He hate you."
  },
  {
    "surah_id": 93,
    "ayah_number": 4,
    "global_ayah_id": 6083,
    "translation": "The Last shall be better for you than the First."
  },
  {
    "surah_id": 93,
    "ayah_number": 5,
    "global_ayah_id": 6084,
    "translation": "Your Lord will give you, and you will be satisfied."
  },
  {
    "surah_id": 93,
    "ayah_number": 6,
    "global_ayah_id": 6085,
    "translation": "Did He not find you an orphan and give you shelter?"
  },
  {
    "surah_id": 93,
    "ayah_number": 7,
    "global_ayah_id": 6086,
    "translation": "Did He not find you a wanderer so He guided you?"
  },
  {
    "surah_id": 93,
    "ayah_number": 8,
    "global_ayah_id": 6087,
    "translation": "Did He not find you poor and suffice you?"
  },
  {
    "surah_id": 93,
    "ayah_number": 9,
    "global_ayah_id": 6088,
    "translation": "Do not oppress the orphan,"
  },
  {
    "surah_id": 93,
    "ayah_number": 10,
    "global_ayah_id": 6089,
    "translation": "nor drive away the one who asks."
  },
  {
    "surah_id": 93,
    "ayah_number": 11,
    "global_ayah_id": 6090,
    "translation": "But tell of the favors of your Lord!"
  }
