[
  {
    "surah_id": 93,
    "ayah_number": 1,
    "global_ayah_id": 6080,
    "translation": "By the morning hours"
  },
  {
    "surah_id": 93,
    "ayah_number": 2,
    "global_ayah_id": 6081,
    "translation": "And by the night when it is stillest,"
  },
  {
    "surah_id": 93,
    "ayah_number": 3,
    "global_ayah_id": 6082,
    "translation": "Thy Lord hath not forsaken thee nor doth He hate thee,"
  },
  {
    "surah_id": 93,
    "ayah_number": 4,
    "global_ayah_id": 6083,
    "translation": "And verily the latter portion will be better for thee than the former,"
  },
  {
    "surah_id": 93,
    "ayah_number": 5,
    "global_ayah_id": 6084,
    "translation": "And verily thy Lord will give unto thee so that thou wilt be content."
  },
  {
    "surah_id": 93,
    "ayah_number": 6,
    "global_ayah_id": 6085,
    "translation": "Did He not find thee an orphan and protect (thee)?"
  },
  {
    "surah_id": 93,
    "ayah_number": 7,
    "global_ayah_id": 6086,
    "translation": "Did He not find thee wandering and direct (thee)?"
  },
  {
    "surah_id": 93,
    "ayah_number": 8,
    "global_ayah_id": 6087,
    "translation": "Did He not find thee destitute and enrich (thee)?"
  },
  {
    "surah_id": 93,
    "ayah_number": 9,
    "global_ayah_id": 6088,
    "translation": "Therefor the orphan oppress not,"
  },
  {
    "surah_id": 93,
    "ayah_number": 10,
    "global_ayah_id": 6089,
    "translation": "Therefor the beggar drive not away,"
  },
  {
    "surah_id": 93,
    "ayah_number": 11,
    "global_ayah_id": 6090,
    "translation": "Therefor of the bounty of thy Lord be thy discourse."
  }
]