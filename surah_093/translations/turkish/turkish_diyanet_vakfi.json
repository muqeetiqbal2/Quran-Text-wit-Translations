[
  {
    "surah_id": 93,
    "ayah_number": 1,
    "global_ayah_id": 6080,
    "translation": "Andolsun kuşluk vaktine"
  },
  {
    "surah_id": 93,
    "ayah_number": 2,
    "global_ayah_id": 6081,
    "translation": "Ve sükuna erdiğinde geceye ki,"
  },
  {
    "surah_id": 93,
    "ayah_number": 3,
    "global_ayah_id": 6082,
    "translation": "Rabbin seni bırakmadı ve sana darılmadı."
  },
  {
    "surah_id": 93,
    "ayah_number": 4,
    "global_ayah_id": 6083,
    "translation": "Gerçekten senin için ahiret dünyadan daha hayırlıdır."
  },
  {
    "surah_id": 93,
    "ayah_number": 5,
    "global_ayah_id": 6084,
    "translation": "Pek yakında Rabbin sana verecek de hoşnut olacaksın."
  },
  {
    "surah_id": 93,
    "ayah_number": 6,
    "global_ayah_id": 6085,
    "translation": "O, seni yetim bulup barındırmadı mı?"
  },
  {
    "surah_id": 93,
    "ayah_number": 7,
    "global_ayah_id": 6086,
    "translation": "Şaşırmış bulup da yol göstermedi mi?"
  },
  {
    "surah_id": 93,
    "ayah_number": 8,
    "global_ayah_id": 6087,
    "translation": "Seni fakir bulup zengin etmedi mi?"
  },
  {
    "surah_id": 93,
    "ayah_number": 9,
    "global_ayah_id": 6088,
    "translation": "Öyleyse yetimi sakın ezme."
  },
  {
    "surah_id": 93,
    "ayah_number": 10,
    "global_ayah_id": 6089,
    "translation": "El açıp isteyeni de sakın azarlama."
  },
  {
    "surah_id": 93,
    "ayah_number": 11,
    "global_ayah_id": 6090,
    "translation": "Ve Rabbinin nimetini minnet ve şükranla an."
  }
]