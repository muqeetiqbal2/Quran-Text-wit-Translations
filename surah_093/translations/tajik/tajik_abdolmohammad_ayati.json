[
  {
    "surah_id": 93,
    "ayah_number": 1,
    "global_ayah_id": 6080,
    "translation": "Савганд ба вақти чошт,"
  },
  {
    "surah_id": 93,
    "ayah_number": 2,
    "global_ayah_id": 6081,
    "translation": "ва савганд ба шаб, чун бипӯшад (бо торикии худ атрофро),"
  },
  {
    "surah_id": 93,
    "ayah_number": 3,
    "global_ayah_id": 6082,
    "translation": "ки Парвардигорат туро тарк накарда ва душман ҳам нагирифтааст."
  },
  {
    "surah_id": 93,
    "ayah_number": 4,
    "global_ayah_id": 6083,
    "translation": "Албатта охират барои ту беҳтар аз дунёст."
  },
  {
    "surah_id": 93,
    "ayah_number": 5,
    "global_ayah_id": 6084,
    "translation": "Ба зуди Парвардигорат туро ато хоҳад дод, то хушнуд шавӣ."
  },
  {
    "surah_id": 93,
    "ayah_number": 6,
    "global_ayah_id": 6085,
    "translation": "Оё туро ятим наёфт ва паноҳат надод?"
  },
  {
    "surah_id": 93,
    "ayah_number": 7,
    "global_ayah_id": 6086,
    "translation": "Ва туро гумгашта ёфт ва ҳидоятат кард?"
  },
  {
    "surah_id": 93,
    "ayah_number": 8,
    "global_ayah_id": 6087,
    "translation": "Ва туро дарвеш ёфт ва тавонгарат гардонид?"
  },
  {
    "surah_id": 93,
    "ayah_number": 9,
    "global_ayah_id": 6088,
    "translation": "Пас ятимро маёзор"
  },
  {
    "surah_id": 93,
    "ayah_number": 10,
    "global_ayah_id": 6089,
    "translation": "ва гадоро марон"
  },
  {
    "surah_id": 93,
    "ayah_number": 11,
    "global_ayah_id": 6090,
    "translation": "ва аз неъмати Парвардигорат сухан бигӯй."
  }
]