[
  {
    "surah_id": 93,
    "ayah_number": 1,
    "global_ayah_id": 6080,
    "translation": "مٿي آيل ڏينھن جو قسم آھي."
  },
  {
    "surah_id": 93,
    "ayah_number": 2,
    "global_ayah_id": 6081,
    "translation": "۽ رات جو (قسم) آھي، جڏھن ڍَڪي ٿي."
  },
  {
    "surah_id": 93,
    "ayah_number": 3,
    "global_ayah_id": 6082,
    "translation": "ته (اي پيغمبر) تنھنجي پالڻھار توکي نه ڇڏيو ۽ نڪي ناراض ٿيو."
  },
  {
    "surah_id": 93,
    "ayah_number": 4,
    "global_ayah_id": 6083,
    "translation": "۽ بيشڪ آخرت تولاءِ دنيا کان گھڻو چڱي آھي."
  },
  {
    "surah_id": 93,
    "ayah_number": 5,
    "global_ayah_id": 6084,
    "translation": "۽ تنھنجو پالڻھار سگھوئي توکي (ايترو) ڏيندو جو (تون) خوش ٿيندين."
  },
  {
    "surah_id": 93,
    "ayah_number": 6,
    "global_ayah_id": 6085,
    "translation": "توکي يتيم نه ڏٺائين ڇا پوءِ (توکي) جاءِ ڏنائين."
  },
  {
    "surah_id": 93,
    "ayah_number": 7,
    "global_ayah_id": 6086,
    "translation": "۽ توکي ناواقف ڏٺائين پوءِ (شريعت جي) رستي لاتائين."
  },
  {
    "surah_id": 93,
    "ayah_number": 8,
    "global_ayah_id": 6087,
    "translation": "۽ توکي مسڪين ڏٺائين پوءِ آسودو ڪيائين."
  },
  {
    "surah_id": 93,
    "ayah_number": 9,
    "global_ayah_id": 6088,
    "translation": "تنھنڪري يتيم تي تون ڏاڍ نه ڪر."
  },
  {
    "surah_id": 93,
    "ayah_number": 10,
    "global_ayah_id": 6089,
    "translation": "۽ سُوالي کي نه جھڻڪ."
  },
  {
    "surah_id": 93,
    "ayah_number": 11,
    "global_ayah_id": 6090,
    "translation": "۽ پنھنجي پالڻھار جي نعمت جو بيان ڪندو رھ."
  }
]