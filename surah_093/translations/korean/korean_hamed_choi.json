[
  {
    "surah_id": 93,
    "ayah_number": 1,
    "global_ayah_id": 6080,
    "translation": "아침을 두고 맹세하고"
  },
  {
    "surah_id": 93,
    "ayah_number": 2,
    "global_ayah_id": 6081,
    "translation": "어둠이 짙어지는 밤을 두고 맹세하사"
  },
  {
    "surah_id": 93,
    "ayah_number": 3,
    "global_ayah_id": 6082,
    "translation": "주님께서 그대를 버리지 아니했으며 미워하지도 않으시니라"
  },
  {
    "surah_id": 93,
    "ayah_number": 4,
    "global_ayah_id": 6083,
    "translation": "실로 그대에게는 내세가 현세보다 나으리니"
  },
  {
    "surah_id": 93,
    "ayah_number": 5,
    "global_ayah_id": 6084,
    "translation": "주님께서 그대에게 은혜를 베풀것이매 그대는 이로하여 기뻐하리라"
  },
  {
    "surah_id": 93,
    "ayah_number": 6,
    "global_ayah_id": 6085,
    "translation": "그분은 고아인 그대를 발견하여 그대를 보호하지 아니 했더뇨"
  },
  {
    "surah_id": 93,
    "ayah_number": 7,
    "global_ayah_id": 6086,
    "translation": "그분은 방황하는 그대를 발견하여 그대를 인도하지 아니 했더 뇨"
  },
  {
    "surah_id": 93,
    "ayah_number": 8,
    "global_ayah_id": 6087,
    "translation": "그분은 가난했던 그대를 부유하게 하여 주지 아니 했더뇨"
  },
  {
    "surah_id": 93,
    "ayah_number": 9,
    "global_ayah_id": 6088,
    "translation": "그러므로 고아들을 거칠게 대하지말며"
  },
  {
    "surah_id": 93,
    "ayah_number": 10,
    "global_ayah_id": 6089,
    "translation": "구하는 자에게 거절하지 말고"
  },
  {
    "surah_id": 93,
    "ayah_number": 11,
    "global_ayah_id": 6090,
    "translation": "그리고 주님의 은혜를 이야기 하라"
  }
]