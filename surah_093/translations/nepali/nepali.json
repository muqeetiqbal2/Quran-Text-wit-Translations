[
  {
    "surah_id": 93,
    "ayah_number": 0,
    "global_ayah_id": 6171,
    "translation": "शुरु अत्यन्त करुणामय, परम दयालु अल्लाहको नामबाट ।"
  },
  {
    "surah_id": 93,
    "ayah_number": 1,
    "global_ayah_id": 6172,
    "translation": "पूर्ण प्रकाशमय विहानीको कसम"
  },
  {
    "surah_id": 93,
    "ayah_number": 2,
    "global_ayah_id": 6173,
    "translation": "र, रातको जब पूर्ण अन्धयारो हुन्छ"
  },
  {
    "surah_id": 93,
    "ayah_number": 3,
    "global_ayah_id": 6174,
    "translation": "(हे मुहम्मद स.!) तिम्रा पालनकर्ताले तिमीलाई न त त्यागेका छन्, र न उनी तिमीसित अप्रसन्न नै छन् ।"
  },
  {
    "surah_id": 93,
    "ayah_number": 4,
    "global_ayah_id": 6175,
    "translation": "र, तिम्रोलागि लोक भन्दा परलोक नै राम्रा छ।"
  },
  {
    "surah_id": 93,
    "ayah_number": 5,
    "global_ayah_id": 6176,
    "translation": "र, शीघ्र नै तिम्रा रबले तिमीलाई प्रदान गर्नेछन् अनि तिमी प्रसन्न हुनेछौ ।"
  },
  {
    "surah_id": 93,
    "ayah_number": 6,
    "global_ayah_id": 6177,
    "translation": "के उनले तिमीलाई अनाथ पाएर आश्रय प्रदान गरेका होइनन् र ?"
  },
  {
    "surah_id": 93,
    "ayah_number": 7,
    "global_ayah_id": 6178,
    "translation": "र, मार्ग नजानेको पाएर तिम्रो पथ प्रदर्शन गरेका होइनन् र ?"
  },
  {
    "surah_id": 93,
    "ayah_number": 8,
    "global_ayah_id": 6179,
    "translation": "र, तिमीलाई निर्धन देखेर धनवान बनाइदिएनन् र ?"
  },
  {
    "surah_id": 93,
    "ayah_number": 9,
    "global_ayah_id": 6180,
    "translation": "अतः तिमी अनाथलाई नसताऊ ।"
  },
  {
    "surah_id": 93,
    "ayah_number": 10,
    "global_ayah_id": 6181,
    "translation": "र, भिखारीलाई नहप्काऊ ।"
  },
  {
    "surah_id": 93,
    "ayah_number": 11,
    "global_ayah_id": 6182,
    "translation": "र, आफ्ना रबको अनुग्रहको चर्चा गरिराख ।"
  }
]