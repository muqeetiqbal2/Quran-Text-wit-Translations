[
  {
    "surah_id": 93,
    "ayah_number": 0,
    "global_ayah_id": 6171,
    "translation": "اللہ دے ناں نال ( شروع ) جیہڑا حدوں مہربان ، بوہت رحم والا اے ۔"
  },
  {
    "surah_id": 93,
    "ayah_number": 1,
    "global_ayah_id": 6172,
    "translation": "چھاہ ویلے دی قسم"
  },
  {
    "surah_id": 93,
    "ayah_number": 2,
    "global_ayah_id": 6173,
    "translation": "تے رات دی جدوں اوہ چھا جاوے"
  },
  {
    "surah_id": 93,
    "ayah_number": 3,
    "global_ayah_id": 6174,
    "translation": "( اے نبی ! ) تیرے رب تہانوں نہ چھڈیا نی تھاتھوں بیزار ہویا اے"
  },
  {
    "surah_id": 93,
    "ayah_number": 4,
    "global_ayah_id": 6175,
    "translation": "تے یقیناً آخرت تیرے لئی دنیا نالوں بہتر اے"
  },
  {
    "surah_id": 93,
    "ayah_number": 5,
    "global_ayah_id": 6176,
    "translation": "تے ضرور اگوں تیرا رب تینوں عطا کر دیوے گا فیر تسی راضی ہو جاؤ گے"
  },
  {
    "surah_id": 93,
    "ayah_number": 6,
    "global_ayah_id": 6177,
    "translation": "بھلا اوہنے تہانوں یتیم نہ ویکھیا ، فیر ٹکاناں دتا"
  },
  {
    "surah_id": 93,
    "ayah_number": 7,
    "global_ayah_id": 6178,
    "translation": "تے تینوں راہ توں ناواقف ویکھیا ، فیر ہدایت بخشی"
  },
  {
    "surah_id": 93,
    "ayah_number": 8,
    "global_ayah_id": 6179,
    "translation": "تے تینوں تنگی چ ویکھیا ، فیر مالدار کر دتا"
  },
  {
    "surah_id": 93,
    "ayah_number": 9,
    "global_ayah_id": 6180,
    "translation": "فیر پر توں یتیم تے سختی نہ کیتا کر"
  },
  {
    "surah_id": 93,
    "ayah_number": 10,
    "global_ayah_id": 6181,
    "translation": "تے رہیا سوالی سو توں نہ جھڑک"
  },
  {
    "surah_id": 93,
    "ayah_number": 11,
    "global_ayah_id": 6182,
    "translation": "تے پر اپنے رب دی نعمت دا سو چرچا کر"
  }
]