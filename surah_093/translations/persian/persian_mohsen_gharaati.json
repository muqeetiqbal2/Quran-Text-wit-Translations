[
  {
    "surah_id": 93,
    "ayah_number": 1,
    "global_ayah_id": 6080,
    "translation": "سوگند به روشناییِ آغازِ روز!"
  },
  {
    "surah_id": 93,
    "ayah_number": 2,
    "global_ayah_id": 6081,
    "translation": "سوگند به شب، آن‌گاه که آرامش بخشد،"
  },
  {
    "surah_id": 93,
    "ayah_number": 3,
    "global_ayah_id": 6082,
    "translation": "که [ای پیامبر!] پروردگارت تو را رها نکرده و [بر تو] خشم نگرفته است."
  },
  {
    "surah_id": 93,
    "ayah_number": 4,
    "global_ayah_id": 6083,
    "translation": "و بی‌تردید آخرت برای تو بهتر از دنیاست."
  },
  {
    "surah_id": 93,
    "ayah_number": 5,
    "global_ayah_id": 6084,
    "translation": "و به زودی پروردگارت [چیزی] به تو عطا می‌کند که خشنود شوی."
  },
  {
    "surah_id": 93,
    "ayah_number": 6,
    "global_ayah_id": 6085,
    "translation": "آیا تو را یتیم نیافت، پس پناه داد و سامانت بخشید؟"
  },
  {
    "surah_id": 93,
    "ayah_number": 7,
    "global_ayah_id": 6086,
    "translation": "و تو را سرگشته یافت، پس هدایت کرد."
  },
  {
    "surah_id": 93,
    "ayah_number": 8,
    "global_ayah_id": 6087,
    "translation": "و تو را تهی‌دست یافت، پس بی‌نیاز کرد."
  },
  {
    "surah_id": 93,
    "ayah_number": 9,
    "global_ayah_id": 6088,
    "translation": "پس بر یتیم تندی مکن و خوارش مساز!"
  },
  {
    "surah_id": 93,
    "ayah_number": 10,
    "global_ayah_id": 6089,
    "translation": "و نیازمندِ خواهنده را از خود مران!"
  },
  {
    "surah_id": 93,
    "ayah_number": 11,
    "global_ayah_id": 6090,
    "translation": "و نعمت پروردگارت را بازگو کن!"
  }
]