[
  {
    "surah_id": 93,
    "ayah_number": 1,
    "global_ayah_id": 6080,
    "translation": "سوگند به روشنايى روز،"
  },
  {
    "surah_id": 93,
    "ayah_number": 2,
    "global_ayah_id": 6081,
    "translation": "سوگند به شب چون آرام گيرد،"
  },
  {
    "surah_id": 93,
    "ayah_number": 3,
    "global_ayah_id": 6082,
    "translation": "[كه‌] پروردگارت تو را وانگذاشته، و دشمن نداشته است."
  },
  {
    "surah_id": 93,
    "ayah_number": 4,
    "global_ayah_id": 6083,
    "translation": "و قطعاً آخرت براى تو از دنيا نيكوتر خواهد بود."
  },
  {
    "surah_id": 93,
    "ayah_number": 5,
    "global_ayah_id": 6084,
    "translation": "و بزودى پروردگارت تو را عطا خواهد داد، تا خرسند گردى."
  },
  {
    "surah_id": 93,
    "ayah_number": 6,
    "global_ayah_id": 6085,
    "translation": "مگر نه تو را يتيم يافت، پس پناه داد؟"
  },
  {
    "surah_id": 93,
    "ayah_number": 7,
    "global_ayah_id": 6086,
    "translation": "و تو را سرگشته يافت، پس هدايت كرد؟"
  },
  {
    "surah_id": 93,
    "ayah_number": 8,
    "global_ayah_id": 6087,
    "translation": "و تو را تنگدست يافت و بى‌نياز گردانيد؟"
  },
  {
    "surah_id": 93,
    "ayah_number": 9,
    "global_ayah_id": 6088,
    "translation": "و اما [تو نيز به پاس نعمت ما] يتيم را ميازار،"
  },
  {
    "surah_id": 93,
    "ayah_number": 10,
    "global_ayah_id": 6089,
    "translation": "و گدا را مران،"
  },
  {
    "surah_id": 93,
    "ayah_number": 11,
    "global_ayah_id": 6090,
    "translation": "و از نعمت پروردگار خويش [با مردم‌] سخن گوى."
  }
]