[
  {
    "surah_id": 93,
    "ayah_number": 1,
    "global_ayah_id": 6080,
    "translation": "Pe lumina zilei!"
  },
  {
    "surah_id": 93,
    "ayah_number": 2,
    "global_ayah_id": 6081,
    "translation": "Pe noaptea ce învăluie pământul!"
  },
  {
    "surah_id": 93,
    "ayah_number": 3,
    "global_ayah_id": 6082,
    "translation": "Domnul tău nici nu te-a părăsit şi nici nu te-a urât!"
  },
  {
    "surah_id": 93,
    "ayah_number": 4,
    "global_ayah_id": 6083,
    "translation": "Pentru tine, mai bună va fi Viaţa de Apoi decât Viaţa de Acum!"
  },
  {
    "surah_id": 93,
    "ayah_number": 5,
    "global_ayah_id": 6084,
    "translation": "Din darurile Sale Domnul tău îţi va dărui, iar tu mulţumit vei fi."
  },
  {
    "surah_id": 93,
    "ayah_number": 6,
    "global_ayah_id": 6085,
    "translation": "Nu te-a aflat El orfan şi te-a adăpostit?"
  },
  {
    "surah_id": 93,
    "ayah_number": 7,
    "global_ayah_id": 6086,
    "translation": "Rătăcitor te-a aflat şi te-a călăuzit?"
  },
  {
    "surah_id": 93,
    "ayah_number": 8,
    "global_ayah_id": 6087,
    "translation": "Sărac te-a aflat şi te-a îmbogăţit?"
  },
  {
    "surah_id": 93,
    "ayah_number": 9,
    "global_ayah_id": 6088,
    "translation": "Orfanul, tu să nu-l oropseşti!"
  },
  {
    "surah_id": 93,
    "ayah_number": 10,
    "global_ayah_id": 6089,
    "translation": "Cerşetorul, tu să nu-l alungi!"
  },
  {
    "surah_id": 93,
    "ayah_number": 11,
    "global_ayah_id": 6090,
    "translation": "De harul Domnului tău, necurmat să povesteşti!"
  }
]