[
  {
    "surah_id": 83,
    "ayah_number": 1,
    "global_ayah_id": 5849,
    "translation": "傷哉！稱量不公的人們。"
  },
  {
    "surah_id": 83,
    "ayah_number": 2,
    "global_ayah_id": 5850,
    "translation": "當他們從別人稱量進來的時候，他們稱量得很充足；"
  },
  {
    "surah_id": 83,
    "ayah_number": 3,
    "global_ayah_id": 5851,
    "translation": "當他們量給別人或稱給別人的時候，他們不稱足不量足。"
  },
  {
    "surah_id": 83,
    "ayah_number": 4,
    "global_ayah_id": 5852,
    "translation": "難道他們不信自己將復活，"
  },
  {
    "surah_id": 83,
    "ayah_number": 5,
    "global_ayah_id": 5853,
    "translation": "在一個重大的日子嗎？"
  },
  {
    "surah_id": 83,
    "ayah_number": 6,
    "global_ayah_id": 5854,
    "translation": "在那日，人們將為全世界的主而起立。"
  },
  {
    "surah_id": 83,
    "ayah_number": 7,
    "global_ayah_id": 5855,
    "translation": "絕不然，惡人們的紀錄，將在一本惡行簿中。"
  },
  {
    "surah_id": 83,
    "ayah_number": 8,
    "global_ayah_id": 5856,
    "translation": "你怎能知道惡行簿是什麼？"
  },
  {
    "surah_id": 83,
    "ayah_number": 9,
    "global_ayah_id": 5857,
    "translation": "是一本封存的簿子。"
  },
  {
    "surah_id": 83,
    "ayah_number": 10,
    "global_ayah_id": 5858,
    "translation": "在那日，傷哉否認的人們——"
  },
  {
    "surah_id": 83,
    "ayah_number": 11,
    "global_ayah_id": 5859,
    "translation": "否認報應日的人們！"
  },
  {
    "surah_id": 83,
    "ayah_number": 12,
    "global_ayah_id": 5860,
    "translation": "只有每個過分的犯罪的人，否認它。"
  },
  {
    "surah_id": 83,
    "ayah_number": 13,
    "global_ayah_id": 5861,
    "translation": "當別人對他宣讀我的跡象的時候，他說：「這是古人的故事。」"
  },
  {
    "surah_id": 83,
    "ayah_number": 14,
    "global_ayah_id": 5862,
    "translation": "絕不然，但他們所犯的罪惡，已像銹樣蒙敝他們的心。"
  },
  {
    "surah_id": 83,
    "ayah_number": 15,
    "global_ayah_id": 5863,
    "translation": "真的，在那日，他們必受阻攔，不得覲見他們的主。"
  },
  {
    "surah_id": 83,
    "ayah_number": 16,
    "global_ayah_id": 5864,
    "translation": "然後，他們必墮入烈火之中。"
  },
  {
    "surah_id": 83,
    "ayah_number": 17,
    "global_ayah_id": 5865,
    "translation": "然後，或者將對他們說：「這就是你們所否認的。」"
  },
  {
    "surah_id": 83,
    "ayah_number": 18,
    "global_ayah_id": 5866,
    "translation": "真的，善人們的記錄，確在善行簿中。"
  },
  {
    "surah_id": 83,
    "ayah_number": 19,
    "global_ayah_id": 5867,
    "translation": "你怎能知道善行簿是什麼？"
  },
  {
    "surah_id": 83,
    "ayah_number": 20,
    "global_ayah_id": 5868,
    "translation": "是一本封存的簿子，"
  },
  {
    "surah_id": 83,
    "ayah_number": 21,
    "global_ayah_id": 5869,
    "translation": "真主所親近的天神們將作証它。"
  },
  {
    "surah_id": 83,
    "ayah_number": 22,
    "global_ayah_id": 5870,
    "translation": "善人們必在恩澤中，"
  },
  {
    "surah_id": 83,
    "ayah_number": 23,
    "global_ayah_id": 5871,
    "translation": "靠在床上注視著，"
  },
  {
    "surah_id": 83,
    "ayah_number": 24,
    "global_ayah_id": 5872,
    "translation": "你能在他們的面目上認識恩澤的光華。"
  },
  {
    "surah_id": 83,
    "ayah_number": 25,
    "global_ayah_id": 5873,
    "translation": "他們將飲封存的天醇，"
  },
  {
    "surah_id": 83,
    "ayah_number": 26,
    "global_ayah_id": 5874,
    "translation": "封瓶口的，是麝香。教貪愛這種幸福的人們，爭先為善吧！"
  },
  {
    "surah_id": 83,
    "ayah_number": 27,
    "global_ayah_id": 5875,
    "translation": "天醇的混合物，是由太斯尼姆來的，"
  },
  {
    "surah_id": 83,
    "ayah_number": 28,
    "global_ayah_id": 5876,
    "translation": "那是一洞泉水，真主所親近的人將飲它。"
  },
  {
    "surah_id": 83,
    "ayah_number": 29,
    "global_ayah_id": 5877,
    "translation": "犯罪的人們常常嘲笑信士們，"
  },
  {
    "surah_id": 83,
    "ayah_number": 30,
    "global_ayah_id": 5878,
    "translation": "當信士們從他們的面前走過的時候，他們以目互相示意；"
  },
  {
    "surah_id": 83,
    "ayah_number": 31,
    "global_ayah_id": 5879,
    "translation": "當他們回家的時候，洋洋得意地回去；"
  },
  {
    "surah_id": 83,
    "ayah_number": 32,
    "global_ayah_id": 5880,
    "translation": "當他們遇見信士們的時候，他們說：「這等人確是迷誤的。」"
  },
  {
    "surah_id": 83,
    "ayah_number": 33,
    "global_ayah_id": 5881,
    "translation": "他們沒有被派去監視信士們。"
  },
  {
    "surah_id": 83,
    "ayah_number": 34,
    "global_ayah_id": 5882,
    "translation": "故今日信士們，嘲笑不信道的人們，"
  },
  {
    "surah_id": 83,
    "ayah_number": 35,
    "global_ayah_id": 5883,
    "translation": "他們靠在床上注視著，"
  },
  {
    "surah_id": 83,
    "ayah_number": 36,
    "global_ayah_id": 5884,
    "translation": "「不信道的人們已獲得他們的行為的報酬了嗎？」"
  }
]