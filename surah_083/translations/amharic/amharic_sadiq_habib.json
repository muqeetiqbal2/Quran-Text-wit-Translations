[
  {
    "surah_id": 83,
    "ayah_number": 1,
    "global_ayah_id": 5849,
    "translation": "ለሰላቢዎች ወዮላቸው፡፡"
  },
  {
    "surah_id": 83,
    "ayah_number": 2,
    "global_ayah_id": 5850,
    "translation": "ለእነዚያ ከሰዎች ባስሰፈሩ ጊዜ የሚያስሞሉ፡፡"
  },
  {
    "surah_id": 83,
    "ayah_number": 3,
    "global_ayah_id": 5851,
    "translation": "ለእነርሱም (ለሰዎቹ) በሰፈሩ ወይም በመዘኑላቸው ጊዜ የሚያጎድሉ (ለኾኑት)፡፡"
  },
  {
    "surah_id": 83,
    "ayah_number": 4,
    "global_ayah_id": 5852,
    "translation": "እነዚያ እነርሱ ተቀስቃሾች መኾናቸውን አያውቁምን?"
  },
  {
    "surah_id": 83,
    "ayah_number": 5,
    "global_ayah_id": 5853,
    "translation": "በታላቁ ቀን፡፡"
  },
  {
    "surah_id": 83,
    "ayah_number": 6,
    "global_ayah_id": 5854,
    "translation": "ሰዎች ሁሉ ለዓለማት ጌታ (ፍርድ)፤ በሚቆሙበት ቀን (ተቀስቃሾች መኾናቸውን)፡፡"
  },
  {
    "surah_id": 83,
    "ayah_number": 7,
    "global_ayah_id": 5855,
    "translation": "በእውነት የከሓዲዎቹ (የሰላቢዎቹ) መጽሐፍ በእርግጥ በሲጂን ውስጥ ነው፡፡"
  },
  {
    "surah_id": 83,
    "ayah_number": 8,
    "global_ayah_id": 5856,
    "translation": "ሲጂንም ምን እንደ ኾነ ምን አሳወቀህ?"
  },
  {
    "surah_id": 83,
    "ayah_number": 9,
    "global_ayah_id": 5857,
    "translation": "የታተመ መጽሐፍ ነው፡፡"
  },
  {
    "surah_id": 83,
    "ayah_number": 10,
    "global_ayah_id": 5858,
    "translation": "ለአስተባባዮች በዚያ ቀን ወዮላቸው፡፡"
  },
  {
    "surah_id": 83,
    "ayah_number": 11,
    "global_ayah_id": 5859,
    "translation": "ለእነዚያ በፍርዱ ቀን ለሚያስተባብሉት፡፡"
  },
  {
    "surah_id": 83,
    "ayah_number": 12,
    "global_ayah_id": 5860,
    "translation": "በእርሱም ወሰን አላፊ ኀጢአተኛ ሁሉ እንጅ ሌላ አያስተባብልም፡፡"
  },
  {
    "surah_id": 83,
    "ayah_number": 13,
    "global_ayah_id": 5861,
    "translation": "አንቀጾቻችን በእርሱ ላይ በተነበቡ ጊዜ «የመጀመሪያዎቹ ሰዎች ተረቶች ናቸው» ይላል፡፡"
  },
  {
    "surah_id": 83,
    "ayah_number": 14,
    "global_ayah_id": 5862,
    "translation": "ይከልከል፤ ይልቁንም በልቦቻቸው ላይ ይሠሩት የነበሩት (ኀጢአት) ደገደገባቸው፡፡"
  },
  {
    "surah_id": 83,
    "ayah_number": 15,
    "global_ayah_id": 5863,
    "translation": "ይከልከሉ፤ እነርሱ በዚያ ቀን ከጌታቸው (ማየት) ተጋራጆች ናቸው፡፡"
  },
  {
    "surah_id": 83,
    "ayah_number": 16,
    "global_ayah_id": 5864,
    "translation": "ከዚያም እነርሱ በእርግጥ ገሀነምን ገቢዎች ናቸው፡፡"
  },
  {
    "surah_id": 83,
    "ayah_number": 17,
    "global_ayah_id": 5865,
    "translation": "ከዚያም «ይህ ያ በእርሱ ታስተባብሉበት የነበራችሁት ነው» ይባላሉ፡፡"
  },
  {
    "surah_id": 83,
    "ayah_number": 18,
    "global_ayah_id": 5866,
    "translation": "በእውነቱ የእውነተኞቹ ምእምናን መጽሐፍ በዒሊዮን ውስጥ ነው፡፡"
  },
  {
    "surah_id": 83,
    "ayah_number": 19,
    "global_ayah_id": 5867,
    "translation": "ዒሊዮንም ምን እንደ ኾነ ምን አሳወቀህ?"
  },
  {
    "surah_id": 83,
    "ayah_number": 20,
    "global_ayah_id": 5868,
    "translation": "የታተመ መጽሐፍ ነው፡፡"
  },
  {
    "surah_id": 83,
    "ayah_number": 21,
    "global_ayah_id": 5869,
    "translation": "ባለሟልዎቹ ይጣዱታል፡፡"
  },
  {
    "surah_id": 83,
    "ayah_number": 22,
    "global_ayah_id": 5870,
    "translation": "እውነተኞቹ ምእምናን በእርግጥ በድሎት (ገነት) ውስጥ ናቸው፡፡"
  },
  {
    "surah_id": 83,
    "ayah_number": 23,
    "global_ayah_id": 5871,
    "translation": "በባለ አጎበር አልጋዎች ላይ ኾነው ይመለከታሉ፡፡"
  },
  {
    "surah_id": 83,
    "ayah_number": 24,
    "global_ayah_id": 5872,
    "translation": "በፊቶቻቸው ላይ የድሎትን ውበት ታውቃለህ፡፡"
  },
  {
    "surah_id": 83,
    "ayah_number": 25,
    "global_ayah_id": 5873,
    "translation": "ተጣርቶ ከታተመ ጠጅ ይጠጣሉ፡፡"
  },
  {
    "surah_id": 83,
    "ayah_number": 26,
    "global_ayah_id": 5874,
    "translation": "ማተሚያው ምስክ ከኾነ፤ በዚህም ተሽቀዳዳሚዎች ይሽቀዳደሙ፡፡"
  },
  {
    "surah_id": 83,
    "ayah_number": 27,
    "global_ayah_id": 5875,
    "translation": "መበረዣውም ከተስኒም ነው፡፡"
  },
  {
    "surah_id": 83,
    "ayah_number": 28,
    "global_ayah_id": 5876,
    "translation": "ባለሟሎቹ ከእርሷ የሚጠጡላት ምንጭ ናት፡፡"
  },
  {
    "surah_id": 83,
    "ayah_number": 29,
    "global_ayah_id": 5877,
    "translation": "እነዚያ ያምመጹት በእነዚያ ባመኑት በእርግጥ ይስቁ ነበሩ፡፡"
  },
  {
    "surah_id": 83,
    "ayah_number": 30,
    "global_ayah_id": 5878,
    "translation": "በእነርሱም ላይ ባለፉ ጊዜ ይጠቃቀሱ ነበር፡፡"
  },
  {
    "surah_id": 83,
    "ayah_number": 31,
    "global_ayah_id": 5879,
    "translation": "ወደ ቤተሰቦቻቸውም በተመለሱ ጊዜ (በመሳለቃቸው) ተደሳቾች ኾነው ይመለሱ ነበር፡፡"
  },
  {
    "surah_id": 83,
    "ayah_number": 32,
    "global_ayah_id": 5880,
    "translation": "ባዩዋቸውም ጊዜ «እነዚህ በእርግጥ ተሳሳቾች ናቸው» ይሉ ነበር፡፡"
  },
  {
    "surah_id": 83,
    "ayah_number": 33,
    "global_ayah_id": 5881,
    "translation": "በነርሱ ላይ ተጠባባቂዎች ተደርገው ያልተላኩ ሲኾኑ፡፡"
  },
  {
    "surah_id": 83,
    "ayah_number": 34,
    "global_ayah_id": 5882,
    "translation": "ዛሬ (በትንሣኤ ቀን) እነዚያ ያመኑት በከሓዲዎቹ ይስቃሉ፡፡"
  },
  {
    "surah_id": 83,
    "ayah_number": 35,
    "global_ayah_id": 5883,
    "translation": "በባለ አጎበር አልጋዎች ላይ ኾነው የሚመለከቱ ሲኾኑ (ይስቃሉ)፡፡"
  },
  {
    "surah_id": 83,
    "ayah_number": 36,
    "global_ayah_id": 5884,
    "translation": "ከሓዲዎች ይሠሩት የነበሩትን (ዋጋ) ተመነዱን? (ይላሉ)፡፡"
  }
]