[
  {
    "surah_id": 83,
    "ayah_number": 0,
    "global_ayah_id": 5930,
    "translation": "اللہ کے نام سے جو رحمان و رحیم ہے"
  },
  {
    "surah_id": 83,
    "ayah_number": 1,
    "global_ayah_id": 5931,
    "translation": "خرابی ہے گھٹانے والوں کی"
  },
  {
    "surah_id": 83,
    "ayah_number": 2,
    "global_ayah_id": 5932,
    "translation": "وہ لوگ کہ جب ماپ کر لیں لوگوں سے تو پورا بھر لیں"
  },
  {
    "surah_id": 83,
    "ayah_number": 3,
    "global_ayah_id": 5933,
    "translation": "اور جب ماپ کر دیں اُنکو یا تول کر تو گھٹا کر دیں"
  },
  {
    "surah_id": 83,
    "ayah_number": 4,
    "global_ayah_id": 5934,
    "translation": "کیا خیال نہیں رکھتے وہ لوگ کہ اُنکو اٹھنا ہے"
  },
  {
    "surah_id": 83,
    "ayah_number": 5,
    "global_ayah_id": 5935,
    "translation": "اُس بڑے دن کے واسطے"
  },
  {
    "surah_id": 83,
    "ayah_number": 6,
    "global_ayah_id": 5936,
    "translation": "جس دن کھڑے رہیں لوگ راہ دیکھتے جہان کے مالک کی"
  },
  {
    "surah_id": 83,
    "ayah_number": 7,
    "global_ayah_id": 5937,
    "translation": "ہر گز نہیں بیشک اعمالنامہ گنہگاروں کا سجین میں ہے"
  },
  {
    "surah_id": 83,
    "ayah_number": 8,
    "global_ayah_id": 5938,
    "translation": "اور تجھ کو کیا خبر ہے کیا ہے سجین"
  },
  {
    "surah_id": 83,
    "ayah_number": 9,
    "global_ayah_id": 5939,
    "translation": "ایک دفتر ہے لکھا ہوا"
  },
  {
    "surah_id": 83,
    "ayah_number": 10,
    "global_ayah_id": 5940,
    "translation": "خرابی ہے اُس دن جھٹلانے والوں کی"
  },
  {
    "surah_id": 83,
    "ayah_number": 11,
    "global_ayah_id": 5941,
    "translation": "جو جھوٹ جانتے ہیں انصاف کے دن کو"
  },
  {
    "surah_id": 83,
    "ayah_number": 12,
    "global_ayah_id": 5942,
    "translation": "اور اسکو جھٹلاتا ہے وہی جو بڑھ نکلنے والا گنہگار ہے"
  },
  {
    "surah_id": 83,
    "ayah_number": 13,
    "global_ayah_id": 5943,
    "translation": "جب سنائے اسکو ہماری آیتیں کہے نقلیں ہیں پہلوں کی"
  },
  {
    "surah_id": 83,
    "ayah_number": 14,
    "global_ayah_id": 5944,
    "translation": "کوئی نہیں پر زنگ پکڑ گیا ہے اُنکے دلوں پر جو وہ کماتے تھے"
  },
  {
    "surah_id": 83,
    "ayah_number": 15,
    "global_ayah_id": 5945,
    "translation": "کوئی نہیں وہ اپنے رب سے اُس دن روک دیے جائیں گے"
  },
  {
    "surah_id": 83,
    "ayah_number": 16,
    "global_ayah_id": 5946,
    "translation": "پھر مقرر وہ گرنے والے ہیں دوزخ میں"
  },
  {
    "surah_id": 83,
    "ayah_number": 17,
    "global_ayah_id": 5947,
    "translation": "پھر کہا جائے گا یہ وہی ہے جسکو تم جھوٹ جانتے تھے"
  },
  {
    "surah_id": 83,
    "ayah_number": 18,
    "global_ayah_id": 5948,
    "translation": "ہرگز نہیں بیشک اعمالنامہ نیکوں کاعلیین میں ہے"
  },
  {
    "surah_id": 83,
    "ayah_number": 19,
    "global_ayah_id": 5949,
    "translation": "اور تجھ کو کیاخبر ہے کیا ہے علیین"
  },
  {
    "surah_id": 83,
    "ayah_number": 20,
    "global_ayah_id": 5950,
    "translation": "ایک دفتر ہے لکھا ہوا"
  },
  {
    "surah_id": 83,
    "ayah_number": 21,
    "global_ayah_id": 5951,
    "translation": "اُسکو دیکھتے ہیں نزدیک والے یعنی فرشتے"
  },
  {
    "surah_id": 83,
    "ayah_number": 22,
    "global_ayah_id": 5952,
    "translation": "بیشک نیک لوگ ہیں آرام میں"
  },
  {
    "surah_id": 83,
    "ayah_number": 23,
    "global_ayah_id": 5953,
    "translation": "تختوں پر بیٹھے دیکھتے ہوں گے"
  },
  {
    "surah_id": 83,
    "ayah_number": 24,
    "global_ayah_id": 5954,
    "translation": "پہچان لے تو اُنکے منہ پر تازگی آرام کی"
  },
  {
    "surah_id": 83,
    "ayah_number": 25,
    "global_ayah_id": 5955,
    "translation": "انکو پلائی جاتی ہے شراب خالص مہر لگی ہوئی"
  },
  {
    "surah_id": 83,
    "ayah_number": 26,
    "global_ayah_id": 5956,
    "translation": "جسکی مہر جمتی ہے مشک پر اور اُس پر چاہیے کہ ڈھکیں ڈھکنے والے"
  },
  {
    "surah_id": 83,
    "ayah_number": 27,
    "global_ayah_id": 5957,
    "translation": "اور اُسکی ملونی ہے تسنیم سے"
  },
  {
    "surah_id": 83,
    "ayah_number": 28,
    "global_ayah_id": 5958,
    "translation": "وہ ایک چشمہ ہے جس سے پیتے ہیں نزدیک والے"
  },
  {
    "surah_id": 83,
    "ayah_number": 29,
    "global_ayah_id": 5959,
    "translation": "وہ لوگ جو گنہگار ہیں تھے ایمان والوں سے ہنسا کرتے"
  },
  {
    "surah_id": 83,
    "ayah_number": 30,
    "global_ayah_id": 5960,
    "translation": "اور جب ہو کر نکلتے انکے پاس کو تو آپس میں آنکھ مارتے"
  },
  {
    "surah_id": 83,
    "ayah_number": 31,
    "global_ayah_id": 5961,
    "translation": "اور جب پھر کر جاتے اپنے گھر پھر جاتے باتیں بناتے"
  },
  {
    "surah_id": 83,
    "ayah_number": 32,
    "global_ayah_id": 5962,
    "translation": "اور جب اُنکو دیکھتے کہتے بیشک یہ لوگ بہک رہے ہیں"
  },
  {
    "surah_id": 83,
    "ayah_number": 33,
    "global_ayah_id": 5963,
    "translation": "اور اُنکو بھیجا نہیں اُن پر نگہبان بنا کر"
  },
  {
    "surah_id": 83,
    "ayah_number": 34,
    "global_ayah_id": 5964,
    "translation": "سو آج ایمان والے منکروں سے ہنستے ہیں"
  },
  {
    "surah_id": 83,
    "ayah_number": 35,
    "global_ayah_id": 5965,
    "translation": "تختوں پر بیٹھے دیکھتے ہیں"
  },
  {
    "surah_id": 83,
    "ayah_number": 36,
    "global_ayah_id": 5966,
    "translation": "اب بدلا پایا ہے منکروں نے جیسا کہ کچھ کرتے تھے"
  }
]