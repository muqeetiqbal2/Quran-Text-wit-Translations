    "ayah_number": 20,
    "global_ayah_id": 5950,
    "translation": "وہ لکھت ایک «<a href=601> مہر </a>» کیا نوشتہ ہے"
  },
  {
    "surah_id": 83,
    "ayah_number": 21,
    "global_ayah_id": 5951,
    "translation": "کہ مقرب جس کی زیارت کرتے ہیں ،"
