    "global_ayah_id": 5930,
    "translation": "اللہ کے «<a href=614> نام </a>» سے «<a href=416> شروع </a>» جو نہایت «<a href=600> مہربان </a>» رحم والا"
  },
  {
    "surah_id": 83,
    "ayah_number": 1,
    "global_ayah_id": 5931,
    "translation": "«<a href=494> کم </a>» تولنے والوں کی «<a href=296> خرابی </a>» ہے ،"
  },
  {
    "surah_id": 83,
    "ayah_number": 2,
    "global_ayah_id": 5932,
    "translation": "وہ کہ جب اوروں سے ماپ لیں پورا لیں ،"
