[
  {
    "surah_id": 83,
    "ayah_number": 0,
    "global_ayah_id": 5930,
    "translation": " «<a href=416> شروع </a>» خدائے رحمٰن ورحیم کے «<a href=614> نام </a>» سے "
  },
  {
    "surah_id": 83,
    "ayah_number": 1,
    "global_ayah_id": 5931,
    "translation": " برا ہو ناپ تول میں کمی کرنے والوں کا! "
  },
  {
    "surah_id": 83,
    "ayah_number": 2,
    "global_ayah_id": 5932,
    "translation": " جو دوسروں سے نپوائیں تو پورا نپوائیں "
  },
  {
    "surah_id": 83,
    "ayah_number": 3,
    "global_ayah_id": 5933,
    "translation": " اور جب ان کیلئے ناپیں یا تولیں تو اس میں کمی کریں ۔ "
  },
  {
    "surah_id": 83,
    "ayah_number": 4,
    "global_ayah_id": 5934,
    "translation": " کیا یہ لوگ یہ «<a href=530> گمان </a>» نہیں رکھتے کہ ایک «<a href=326> دن </a>» وہ\nاٹھائے جانے والے ہیں؟ "
  },
  {
    "surah_id": 83,
    "ayah_number": 5,
    "global_ayah_id": 5935,
    "translation": " ایک عظیم «<a href=326> دن </a>» ( کی حاضری ) کیلئے ۔ "
  },
  {
    "surah_id": 83,
    "ayah_number": 6,
    "global_ayah_id": 5936,
    "translation": " جس «<a href=326> دن </a>» لوگ اٹھیں گے خداوند «<a href=438> عالم </a>» ( کے حضور\nپیشی ) کیلئے! "
  },
  {
    "surah_id": 83,
    "ayah_number": 7,
    "global_ayah_id": 5937,
    "translation": " ہرگز نہیں! بیشک فاجروں کے «<a href=42> اعمال </a>» نامے سجین میں ہوں گے ۔ "
  },
  {
    "surah_id": 83,
    "ayah_number": 8,
    "global_ayah_id": 5938,
    "translation": " اور تم کیا جانو کہ سجین کیا ہے؟ "
  },
  {
    "surah_id": 83,
    "ayah_number": 9,
    "global_ayah_id": 5939,
    "translation": " لکھا «<a href=654> ہوا </a>» دفتر! "
  },
  {
    "surah_id": 83,
    "ayah_number": 10,
    "global_ayah_id": 5940,
    "translation": " اس «<a href=326> دن </a>» تباہی ہے جھٹلانے والوں کی! "
  },
  {
    "surah_id": 83,
    "ayah_number": 11,
    "global_ayah_id": 5941,
    "translation": " جو روزِ جزا کو جھٹلا رہے ہیں ۔ "
  },
  {
    "surah_id": 83,
    "ayah_number": 12,
    "global_ayah_id": 5942,
    "translation": " اس کو تو وہی جھٹلاتے ہیں جو تعدی اور حق تلفی کرنے والے ہوتے ہیں ۔ "
  },
  {
    "surah_id": 83,
    "ayah_number": 13,
    "global_ayah_id": 5943,
    "translation": " جب اس کو ہماری آیتیں سنائی جاتی ہیں تو کہا ہے کہ یہ تو اگلوں کے فسانے ہیں ۔ "
  },
  {
    "surah_id": 83,
    "ayah_number": 14,
    "global_ayah_id": 5944,
    "translation": " ہرگز نہیں! بلکہ ان کے دلوں پر ان کے «<a href=42> اعمال </a>» کا زنگ چڑھ گیا ہے ۔ "
  },
  {
    "surah_id": 83,
    "ayah_number": 15,
    "global_ayah_id": 5945,
    "translation": " ہرگز نہیں! بلکہ اس «<a href=326> دن </a>» وہ اپنے رب سے اوٹ میں رکھی جائیں گے! "
  },
  {
    "surah_id": 83,
    "ayah_number": 16,
    "global_ayah_id": 5946,
    "translation": " پھر یقیناً وہ جہنم میں پڑنے والے بنیں گے ۔ "
  },
  {
    "surah_id": 83,
    "ayah_number": 17,
    "global_ayah_id": 5947,
    "translation": " تب کہا جائے گا: یہ وہی چیز ہے جس کو تم جھٹلاتے رہے ہو! "
  },
  {
    "surah_id": 83,
    "ayah_number": 18,
    "global_ayah_id": 5948,
    "translation": " ہرگز نہیں! بیشک اچھوں کے «<a href=42> اعمال </a>» نامے علیین میں ہوں گے ۔ "
  },
  {
    "surah_id": 83,
    "ayah_number": 19,
    "global_ayah_id": 5949,
    "translation": " اور تم کیا سمجھے کہ علیین کیا ہے؟ "
  },
  {
    "surah_id": 83,
    "ayah_number": 20,
    "global_ayah_id": 5950,
    "translation": " لکھا «<a href=654> ہوا </a>» دفتر! "
  },
  {
    "surah_id": 83,
    "ayah_number": 21,
    "global_ayah_id": 5951,
    "translation": " مقربوں کی نگرانی میں! "
  },
  {
    "surah_id": 83,
    "ayah_number": 22,
    "global_ayah_id": 5952,
    "translation": " بیشک «<a href=634> نیک </a>» بندے عیشوں میں ہوں گے ۔ "
  },
  {
    "surah_id": 83,
    "ayah_number": 23,
    "global_ayah_id": 5953,
    "translation": " تختوں پر بیٹھے ، سیر دیکھتے ۔ "
  },
  {
    "surah_id": 83,
    "ayah_number": 24,
    "global_ayah_id": 5954,
    "translation": " ان کے چہروں پر آسمائش کی بشاشت جھلک رہی ہوگی ۔ "
  },
  {
    "surah_id": 83,
    "ayah_number": 25,
    "global_ayah_id": 5955,
    "translation": " «<a href=393> سر </a>» بہ «<a href=601> مہر </a>» شرابِ خالص ان کو پینے کو ملے گی ۔\n "
  },
  {
    "surah_id": 83,
    "ayah_number": 26,
    "global_ayah_id": 5956,
    "translation": " جس پر مشک کی «<a href=601> مہر </a>» ہوگی – یہ چیز ہے جس کی طلب میں طالبوں کو سرگرم\nہونا چاہئے ۔ "
  },
  {
    "surah_id": 83,
    "ayah_number": 27,
    "global_ayah_id": 5957,
    "translation": " اور اس میں تسنیم کی ملونی ہوگی ۔ "
  },
  {
    "surah_id": 83,
    "ayah_number": 28,
    "global_ayah_id": 5958,
    "translation": " ایک خاص «<a href=260> چشمہ </a>» جس پر مقربین بیٹھ کر پئیں گے ۔ "
  },
  {
    "surah_id": 83,
    "ayah_number": 29,
    "global_ayah_id": 5959,
    "translation": " جو مجرم رہے ہیں وہ ان لوگوں کے حال پر ہنستے رہے ہیں کو ایمان والے تھے ۔ "
  },
  {
    "surah_id": 83,
    "ayah_number": 30,
    "global_ayah_id": 5960,
    "translation": " اور جب ان کے «<a href=141> پاس </a>» سے گذرتے تو کن انکھیوں سے اشارے کرتے ۔ "
  },
  {
    "surah_id": 83,
    "ayah_number": 31,
    "global_ayah_id": 5961,
    "translation": " اور جب اپنے لوگوں میں لوٹتے تو مگن ہوکر لوٹتے ۔ "
  },
  {
    "surah_id": 83,
    "ayah_number": 32,
    "global_ayah_id": 5962,
    "translation": " اور جب ان کو دیکھتے تو کہتے کہ یہ بالکل گمراہ ہیں! "
  },
  {
    "surah_id": 83,
    "ayah_number": 33,
    "global_ayah_id": 5963,
    "translation": " یہ ان پر کوئی نگران بنا کر تو نہیں بھیجے گئے ہیں ۔ "
  },
  {
    "surah_id": 83,
    "ayah_number": 34,
    "global_ayah_id": 5964,
    "translation": " پس آج ایمان والے کفار کے حال پر ہنسیں گے ۔ "
  },
  {
    "surah_id": 83,
    "ayah_number": 35,
    "global_ayah_id": 5965,
    "translation": " تختوں پر بیٹھتے ، سیر دیکھتے "
  },
  {
    "surah_id": 83,
    "ayah_number": 36,
    "global_ayah_id": 5966,
    "translation": " کیوں پایا نا کفار نے اپنے کیے کا بدلہ! "
  }
]