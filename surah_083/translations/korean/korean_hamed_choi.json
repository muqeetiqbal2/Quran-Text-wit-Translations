[
  {
    "surah_id": 83,
    "ayah_number": 1,
    "global_ayah_id": 5849,
    "translation": "저울을 속이는 자들에게 재앙이 있을것이라"
  },
  {
    "surah_id": 83,
    "ayah_number": 2,
    "global_ayah_id": 5850,
    "translation": "그들은 사람들로부터 받을 때저울을 넘치게 하여 받으나"
  },
  {
    "surah_id": 83,
    "ayah_number": 3,
    "global_ayah_id": 5851,
    "translation": "그들이 사람들에게 줄 때는 무게를 낮추어서 주노라"
  },
  {
    "surah_id": 83,
    "ayah_number": 4,
    "global_ayah_id": 5852,
    "translation": "그들은 그들이 부활되리라 생 각지 않느뇨"
  },
  {
    "surah_id": 83,
    "ayah_number": 5,
    "global_ayah_id": 5853,
    "translation": "그날은 위대한 날로"
  },
  {
    "surah_id": 83,
    "ayah_number": 6,
    "global_ayah_id": 5854,
    "translation": "모든 인간이 만유의 주님앞에 서는 날이며"
  },
  {
    "surah_id": 83,
    "ayah_number": 7,
    "global_ayah_id": 5855,
    "translation": "사악한 자들의 기록은 씨진 에 보관되어 있노라"
  },
  {
    "surah_id": 83,
    "ayah_number": 8,
    "global_ayah_id": 5856,
    "translation": "씨진이 무엇인지 무엇이 그대 에게 알려주리요"
  },
  {
    "surah_id": 83,
    "ayah_number": 9,
    "global_ayah_id": 5857,
    "translation": "그곳에 기록된 기록부가 있노 라"
  },
  {
    "surah_id": 83,
    "ayah_number": 10,
    "global_ayah_id": 5858,
    "translation": "그날에는 불신한 그들에게 재앙이 있을 것이요"
  },
  {
    "surah_id": 83,
    "ayah_number": 11,
    "global_ayah_id": 5859,
    "translation": "심판의 날을 부정하는 자들 에게도 재앙이 있을 것이라"
  },
  {
    "surah_id": 83,
    "ayah_number": 12,
    "global_ayah_id": 5860,
    "translation": "어느 누구도 그것을 부정하 지 아니하나 오만한 자들은 영역 을 벗어난 죄인들이라"
  },
  {
    "surah_id": 83,
    "ayah_number": 13,
    "global_ayah_id": 5861,
    "translation": "하나님의 말씀이 그에게 낭 송될 때 이것은 옛 선조들의 우화 요 라고 말하더라"
  },
  {
    "surah_id": 83,
    "ayah_number": 14,
    "global_ayah_id": 5862,
    "translation": "그렇지 않노라 그들의 마음 들이 죄악으로 물들어 있노라"
  },
  {
    "surah_id": 83,
    "ayah_number": 15,
    "global_ayah_id": 5863,
    "translation": "실로 그날 그들은 베일로 가리워져 바라보지도 못하며"
  },
  {
    "surah_id": 83,
    "ayah_number": 16,
    "global_ayah_id": 5864,
    "translation": "그들은 불지옥으로 들어가게되니"
  },
  {
    "surah_id": 83,
    "ayah_number": 17,
    "global_ayah_id": 5865,
    "translation": "이것은 너희가 거짓이라 거 역했던 현실이라는 말씀이 있을 것이라"
  },
  {
    "surah_id": 83,
    "ayah_number": 18,
    "global_ayah_id": 5866,
    "translation": "그러나 의로운 자들의 기록 은 일린에 보관되나니"
  },
  {
    "surah_id": 83,
    "ayah_number": 19,
    "global_ayah_id": 5867,
    "translation": "일린이 무엇인가를 무엇이 그대에게 설명하여 주리요"
  },
  {
    "surah_id": 83,
    "ayah_number": 20,
    "global_ayah_id": 5868,
    "translation": "그곳에 기록된 기록부가 있 노라"
  },
  {
    "surah_id": 83,
    "ayah_number": 21,
    "global_ayah_id": 5869,
    "translation": "하나님 가까이에 있는 그들 이 그것을 증언할 것이니"
  },
  {
    "surah_id": 83,
    "ayah_number": 22,
    "global_ayah_id": 5870,
    "translation": "의로운 자들은 축복속에 있 게 될 것이며"
  },
  {
    "surah_id": 83,
    "ayah_number": 23,
    "global_ayah_id": 5871,
    "translation": "그들은 안락 의자에서 바라 볼 것이라"
  },
  {
    "surah_id": 83,
    "ayah_number": 24,
    "global_ayah_id": 5872,
    "translation": "너희는 그들의 얼굴에서 밝 은 축복의 빛을 인식할 것이며"
  },
  {
    "surah_id": 83,
    "ayah_number": 25,
    "global_ayah_id": 5873,
    "translation": "봉인된 순수한 술로써 그들 의 갈증을 식힐 것이며"
  },
  {
    "surah_id": 83,
    "ayah_number": 26,
    "global_ayah_id": 5874,
    "translation": "최후의 음료수는 미스크가 될 것이니 그것을 소망하는 자 갖게 하리라"
  },
  {
    "surah_id": 83,
    "ayah_number": 27,
    "global_ayah_id": 5875,
    "translation": "거기에 타쓰님이 혼합되어 지니"
  },
  {
    "surah_id": 83,
    "ayah_number": 28,
    "global_ayah_id": 5876,
    "translation": "그것은 하나님 가까이에 있 는 자들이 마시는 샘물이라"
  },
  {
    "surah_id": 83,
    "ayah_number": 29,
    "global_ayah_id": 5877,
    "translation": "죄인들은 민음을 가졌던 자 들을 비웃어"
  },
  {
    "surah_id": 83,
    "ayah_number": 30,
    "global_ayah_id": 5878,
    "translation": "그들 옆을 지나갈 때면 눈짓으로 조롱하곤 하였고"
  },
  {
    "surah_id": 83,
    "ayah_number": 31,
    "global_ayah_id": 5879,
    "translation": "그들이 무리에게로 돌아왔을때는 우물 댔노라"
  },
  {
    "surah_id": 83,
    "ayah_number": 32,
    "global_ayah_id": 5880,
    "translation": "믿는자를 볼 때면 보라 이들이 방황한 자들이라 하더라"
  },
  {
    "surah_id": 83,
    "ayah_number": 33,
    "global_ayah_id": 5881,
    "translation": "그러나 불신자들은 믿는자를감시하기 위해 보내어진 자가 아 니매"
  },
  {
    "surah_id": 83,
    "ayah_number": 34,
    "global_ayah_id": 5882,
    "translation": "오늘은 믿음을 가진 자들이 그 불신자들을 조롱하리라"
  },
  {
    "surah_id": 83,
    "ayah_number": 35,
    "global_ayah_id": 5883,
    "translation": "이들은 안락의자에 앉아 바 라다 보리라"
  },
  {
    "surah_id": 83,
    "ayah_number": 36,
    "global_ayah_id": 5884,
    "translation": "불신자들은 그들이 행하였던대로 보상을 되돌려 받지 않느뇨"
  }
]