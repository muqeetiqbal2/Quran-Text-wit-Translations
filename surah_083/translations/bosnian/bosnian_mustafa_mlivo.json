[
  {
    "surah_id": 83,
    "ayah_number": 1,
    "global_ayah_id": 5849,
    "translation": "Teško zakidateljima,"
  },
  {
    "surah_id": 83,
    "ayah_number": 2,
    "global_ayah_id": 5850,
    "translation": "Koji kad uzimaju od svijeta, traže potpuno,"
  },
  {
    "surah_id": 83,
    "ayah_number": 3,
    "global_ayah_id": 5851,
    "translation": "A kad njima mjere ili im vagaju, zakidaju!"
  },
  {
    "surah_id": 83,
    "ayah_number": 4,
    "global_ayah_id": 5852,
    "translation": "Zar ne misle takvi da će oni biti podignuti,"
  },
  {
    "surah_id": 83,
    "ayah_number": 5,
    "global_ayah_id": 5853,
    "translation": "Za Dan strašni,"
  },
  {
    "surah_id": 83,
    "ayah_number": 6,
    "global_ayah_id": 5854,
    "translation": "Dan kad će stati ljudi pred Gospodara svjetova!"
  },
  {
    "surah_id": 83,
    "ayah_number": 7,
    "global_ayah_id": 5855,
    "translation": "Nikako! Zaista je knjiga razvratnika u Sidždžinu!"
  },
  {
    "surah_id": 83,
    "ayah_number": 8,
    "global_ayah_id": 5856,
    "translation": "A šta znaš ti šta je Sidždžin?"
  },
  {
    "surah_id": 83,
    "ayah_number": 9,
    "global_ayah_id": 5857,
    "translation": "Knjiga ispisana!"
  },
  {
    "surah_id": 83,
    "ayah_number": 10,
    "global_ayah_id": 5858,
    "translation": "Teško Tog dana poricateljima,"
  },
  {
    "surah_id": 83,
    "ayah_number": 11,
    "global_ayah_id": 5859,
    "translation": "Koji niječu Dan sudnji!"
  },
  {
    "surah_id": 83,
    "ayah_number": 12,
    "global_ayah_id": 5860,
    "translation": "A ne niječe ga, izuzev svaki prestupnik, grješnik."
  },
  {
    "surah_id": 83,
    "ayah_number": 13,
    "global_ayah_id": 5861,
    "translation": "Kad mu se uče ajeti Naši, rekne: \"Priče ranijih!\""
  },
  {
    "surah_id": 83,
    "ayah_number": 14,
    "global_ayah_id": 5862,
    "translation": "Nikako! Naprotiv, ono što su stekli je hrđa na srcima njihovim."
  },
  {
    "surah_id": 83,
    "ayah_number": 15,
    "global_ayah_id": 5863,
    "translation": "Nikako! Zaista će oni od Gospodara svoga Tog dana biti zaklonjeni,"
  },
  {
    "surah_id": 83,
    "ayah_number": 16,
    "global_ayah_id": 5864,
    "translation": "Zatim će se uistinu oni pržiti džehimom,"
  },
  {
    "surah_id": 83,
    "ayah_number": 17,
    "global_ayah_id": 5865,
    "translation": "Potom će biti rečeno: \"Ovo je to što ste poricali.\""
  },
  {
    "surah_id": 83,
    "ayah_number": 18,
    "global_ayah_id": 5866,
    "translation": "Nikako! Uistinu je Knjiga čestitih u Illijjunu!"
  },
  {
    "surah_id": 83,
    "ayah_number": 19,
    "global_ayah_id": 5867,
    "translation": "A šta znaš ti šta je Illijjun?"
  },
  {
    "surah_id": 83,
    "ayah_number": 20,
    "global_ayah_id": 5868,
    "translation": "Knjiga ispisana!"
  },
  {
    "surah_id": 83,
    "ayah_number": 21,
    "global_ayah_id": 5869,
    "translation": "Svjedočiće je približeni."
  },
  {
    "surah_id": 83,
    "ayah_number": 22,
    "global_ayah_id": 5870,
    "translation": "Uistinu će čestiti u zadovoljstvu biti,"
  },
  {
    "surah_id": 83,
    "ayah_number": 23,
    "global_ayah_id": 5871,
    "translation": "Na divanima će gledati,"
  },
  {
    "surah_id": 83,
    "ayah_number": 24,
    "global_ayah_id": 5872,
    "translation": "Spoznaćeš na licima njihovim sjaj zadovoljstva,"
  },
  {
    "surah_id": 83,
    "ayah_number": 25,
    "global_ayah_id": 5873,
    "translation": "Napajani će biti nektarom zapečaćenim."
  },
  {
    "surah_id": 83,
    "ayah_number": 26,
    "global_ayah_id": 5874,
    "translation": "Pečat njegov biće misk; a za to neka se natječu takmičari -"
  },
  {
    "surah_id": 83,
    "ayah_number": 27,
    "global_ayah_id": 5875,
    "translation": "A mješavina njegova od Tesnima,"
  },
  {
    "surah_id": 83,
    "ayah_number": 28,
    "global_ayah_id": 5876,
    "translation": "Izvora s kojeg će piti približeni."
  },
  {
    "surah_id": 83,
    "ayah_number": 29,
    "global_ayah_id": 5877,
    "translation": "Uistinu! Oni koji su skrivili ismijavali su se onima koji su vjerovali,"
  },
  {
    "surah_id": 83,
    "ayah_number": 30,
    "global_ayah_id": 5878,
    "translation": "I kad su pored njih prolazili, namigivali,"
  },
  {
    "surah_id": 83,
    "ayah_number": 31,
    "global_ayah_id": 5879,
    "translation": "A kad su se vraćali porodici svojoj, vraćali su se šaleći se,"
  },
  {
    "surah_id": 83,
    "ayah_number": 32,
    "global_ayah_id": 5880,
    "translation": "I kad bi ih vidjeli, rekli bi: \"Zaista su ovi zalutali.\""
  },
  {
    "surah_id": 83,
    "ayah_number": 33,
    "global_ayah_id": 5881,
    "translation": "A nisu poslani nad njima čuvarima."
  },
  {
    "surah_id": 83,
    "ayah_number": 34,
    "global_ayah_id": 5882,
    "translation": "Pa, Danas će se oni koji su vjerovali, nevjernicima ismijavati,"
  },
  {
    "surah_id": 83,
    "ayah_number": 35,
    "global_ayah_id": 5883,
    "translation": "Na divanima će gledati!"
  },
  {
    "surah_id": 83,
    "ayah_number": 36,
    "global_ayah_id": 5884,
    "translation": "Zar nisu nevjernici nagrađeni kako su radili?"
  }
]