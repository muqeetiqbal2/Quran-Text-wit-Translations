[
  {
    "surah_id": 83,
    "ayah_number": 1,
    "global_ayah_id": 5849,
    "translation": "അളവില്‍ കുറക്കുന്നവര്‍ക്ക് മഹാനാശം"
  },
  {
    "surah_id": 83,
    "ayah_number": 2,
    "global_ayah_id": 5850,
    "translation": "അതായത് ജനങ്ങളോട് അളന്നുവാങ്ങുകയാണെങ്കില്‍ തികച്ചെടുക്കുകയും."
  },
  {
    "surah_id": 83,
    "ayah_number": 3,
    "global_ayah_id": 5851,
    "translation": "ജനങ്ങള്‍ക്ക് അളന്നുകൊടുക്കുകയോ തൂക്കികൊടുക്കുകയോ ആണെങ്കില്‍ നഷ്ടം വരുത്തുകയും ചെയ്യുന്നവര്‍ക്ക്‌."
  },
  {
    "surah_id": 83,
    "ayah_number": 4,
    "global_ayah_id": 5852,
    "translation": "അക്കൂട്ടര്‍ വിചാരിക്കുന്നില്ലേ; തങ്ങള്‍ എഴുന്നേല്‍പിക്കപ്പെടുന്നവരാണെന്ന്‌?"
  },
  {
    "surah_id": 83,
    "ayah_number": 5,
    "global_ayah_id": 5853,
    "translation": "ഭയങ്കരമായ ഒരു ദിവസത്തിനായിട്ട്‌"
  },
  {
    "surah_id": 83,
    "ayah_number": 6,
    "global_ayah_id": 5854,
    "translation": "അതെ, ലോകരക്ഷിതാവിങ്കലേക്ക് ജനങ്ങള്‍ എഴുന്നേറ്റ് വരുന്ന ദിവസം."
  },
  {
    "surah_id": 83,
    "ayah_number": 7,
    "global_ayah_id": 5855,
    "translation": "നിസ്സംശയം; ദുര്‍മാര്‍ഗികളുടെ രേഖ സിജ്ജീനില്‍ തന്നെയായിരിക്കും."
  },
  {
    "surah_id": 83,
    "ayah_number": 8,
    "global_ayah_id": 5856,
    "translation": "സിജ്ജീന്‍ എന്നാല്‍ എന്താണെന്ന് നിനക്കറിയാമോ?"
  },
  {
    "surah_id": 83,
    "ayah_number": 9,
    "global_ayah_id": 5857,
    "translation": "എഴുതപ്പെട്ട ഒരു ഗ്രന്ഥമാകുന്നു അത്‌."
  },
  {
    "surah_id": 83,
    "ayah_number": 10,
    "global_ayah_id": 5858,
    "translation": "അന്നേ ദിവസം നിഷേധിച്ചു തള്ളുന്നവര്‍ക്കാകുന്നു നാശം."
  },
  {
    "surah_id": 83,
    "ayah_number": 11,
    "global_ayah_id": 5859,
    "translation": "അതായത് പ്രതിഫല നടപടിയുടെ ദിവസത്തെ നിഷേധിച്ചു തള്ളുന്നവര്‍ക്ക്‌."
  },
  {
    "surah_id": 83,
    "ayah_number": 12,
    "global_ayah_id": 5860,
    "translation": "എല്ലാ അതിരുവിട്ടവനും മഹാപാപിയുമായിട്ടുള്ളവനല്ലാതെ അതിനെ നിഷേധിച്ചു തള്ളുകയില്ല."
  },
  {
    "surah_id": 83,
    "ayah_number": 13,
    "global_ayah_id": 5861,
    "translation": "അവന്ന് നമ്മുടെ ദൃഷ്ടാന്തങ്ങള്‍ ഓതികേള്‍പിക്കപ്പെടുകയാണെങ്കില്‍ അവന്‍ പറയും; പൂര്‍വ്വികന്‍മാരുടെ ഐതിഹ്യങ്ങളാണെന്ന്‌."
  },
  {
    "surah_id": 83,
    "ayah_number": 14,
    "global_ayah_id": 5862,
    "translation": "അല്ല; പക്ഷെ, അവര്‍ പ്രവര്‍ത്തിച്ചുക്കൊണ്ടിരിക്കുന്നത് അവരുടെ ഹൃദയങ്ങളില്‍ കറയുണ്ടാക്കിയിരിക്കുന്നു."
  },
  {
    "surah_id": 83,
    "ayah_number": 15,
    "global_ayah_id": 5863,
    "translation": "അല്ല; തീര്‍ച്ചയായും അവര്‍ അന്നേ ദിവസം അവരുടെ രക്ഷിതാവില്‍ നിന്ന് മറയ്ക്കപ്പെടുന്നവരാകുന്നു."
  },
  {
    "surah_id": 83,
    "ayah_number": 16,
    "global_ayah_id": 5864,
    "translation": "പിന്നീടവര്‍ ജ്വലിക്കുന്ന നരകാഗ്നിയില്‍ കടന്നെരിയുന്നവരാകുന്നു."
  },
  {
    "surah_id": 83,
    "ayah_number": 17,
    "global_ayah_id": 5865,
    "translation": "പിന്നീട് പറയപ്പെടും; ഇതാണ് നിങ്ങള്‍ നിഷേധിച്ചുതള്ളിക്കൊണ്ടിരുന്ന കാര്യം."
  },
  {
    "surah_id": 83,
    "ayah_number": 18,
    "global_ayah_id": 5866,
    "translation": "നിസ്സംശയം; പുണ്യവാന്‍മാരുടെ രേഖ ഇല്ലിയ്യൂനില്‍ തന്നെയായിരിക്കും."
  },
  {
    "surah_id": 83,
    "ayah_number": 19,
    "global_ayah_id": 5867,
    "translation": "ഇല്ലിയ്യൂന്‍ എന്നാല്‍ എന്താണെന്ന് നിനക്കറിയുമോ?"
  },
  {
    "surah_id": 83,
    "ayah_number": 20,
    "global_ayah_id": 5868,
    "translation": "എഴുതപ്പെട്ട ഒരു രേഖയത്രെ അത്‌."
  },
  {
    "surah_id": 83,
    "ayah_number": 21,
    "global_ayah_id": 5869,
    "translation": "സാമീപ്യം സിദ്ധിച്ചവര്‍ അതിന്‍റെ അടുക്കല്‍ സന്നിഹിതരാകുന്നതാണ്‌."
  },
  {
    "surah_id": 83,
    "ayah_number": 22,
    "global_ayah_id": 5870,
    "translation": "തീര്‍ച്ചയായും സുകൃതവാന്‍മാര്‍ സുഖാനുഭവത്തില്‍ തന്നെയായിരിക്കും."
  },
  {
    "surah_id": 83,
    "ayah_number": 23,
    "global_ayah_id": 5871,
    "translation": "സോഫകളിലിരുന്ന് അവര്‍ നോക്കിക്കൊണ്ടിരിക്കും."
  },
  {
    "surah_id": 83,
    "ayah_number": 24,
    "global_ayah_id": 5872,
    "translation": "അവരുടെ മുഖങ്ങളില്‍ സുഖാനുഭവത്തിന്‍റെ തിളക്കം നിനക്കറിയാം."
  },
  {
    "surah_id": 83,
    "ayah_number": 25,
    "global_ayah_id": 5873,
    "translation": "മുദ്രവെക്കപ്പെട്ട ശുദ്ധമായ മദ്യത്തില്‍ നിന്ന് അവര്‍ക്ക് കുടിക്കാന്‍ നല്‍കപ്പെടും."
  },
  {
    "surah_id": 83,
    "ayah_number": 26,
    "global_ayah_id": 5874,
    "translation": "അതിന്‍റെ മുദ്ര കസ്തൂരിയായിരിക്കും. വാശി കാണിക്കുന്നവര്‍ അതിന് വേണ്ടി വാശി കാണിക്കട്ടെ."
  },
  {
    "surah_id": 83,
    "ayah_number": 27,
    "global_ayah_id": 5875,
    "translation": "അതിലെ ചേരുവ തസ്നീം ആയിരിക്കും."
  },
  {
    "surah_id": 83,
    "ayah_number": 28,
    "global_ayah_id": 5876,
    "translation": "അതായത് സാമീപ്യം സിദ്ധിച്ചവര്‍ കുടിക്കുന്ന ഒരു ഉറവ് ജലം."
  },
  {
    "surah_id": 83,
    "ayah_number": 29,
    "global_ayah_id": 5877,
    "translation": "തീര്‍ച്ചയായും കുറ്റകൃത്യത്തില്‍ ഏര്‍പെട്ടവര്‍ സത്യവിശ്വാസികളെ കളിയാക്കി ചിരിക്കുമായിരുന്നു."
  },
  {
    "surah_id": 83,
    "ayah_number": 30,
    "global_ayah_id": 5878,
    "translation": "അവരുടെ (സത്യവിശ്വാസികളുടെ) മുമ്പിലൂടെ കടന്നു പോകുമ്പോള്‍ അവര്‍ പരസ്പരം കണ്ണിട്ടു കാണിക്കുമായിരുന്നു."
  },
  {
    "surah_id": 83,
    "ayah_number": 31,
    "global_ayah_id": 5879,
    "translation": "അവരുടെ സ്വന്തക്കാരുടെ അടുക്കലേക്ക് തിരിച്ചുചെല്ലുമ്പോള്‍ രസിച്ചു കൊണ്ട് അവര്‍ തിരിച്ചുചെല്ലുമായിരുന്നു."
  },
  {
    "surah_id": 83,
    "ayah_number": 32,
    "global_ayah_id": 5880,
    "translation": "അവരെ (സത്യവിശ്വാസികളെ) അവര്‍ കാണുമ്പോള്‍, തീര്‍ച്ചയായും ഇക്കൂട്ടര്‍ വഴിപിഴച്ചവര്‍ തന്നെയാണ് എന്ന് അവര്‍ പറയുകയും ചെയ്യുമായിരുന്നു."
  },
  {
    "surah_id": 83,
    "ayah_number": 33,
    "global_ayah_id": 5881,
    "translation": "അവരുടെ (സത്യവിശ്വാസികളുടെ) മേല്‍ മേല്‍നോട്ടക്കാരായിട്ട് അവര്‍ നിയോഗിക്കപ്പെട്ടിട്ടൊന്നുമില്ല."
  },
  {
    "surah_id": 83,
    "ayah_number": 34,
    "global_ayah_id": 5882,
    "translation": "എന്നാല്‍ അന്ന് (ഖിയാമത്ത് നാളില്‍) ആ സത്യവിശ്വാസികള്‍ സത്യനിഷേധികളെ കളിയാക്കി ചിരിക്കുന്നതാണ്‌."
  },
  {
    "surah_id": 83,
    "ayah_number": 35,
    "global_ayah_id": 5883,
    "translation": "സോഫകളിലിരുന്ന് അവര്‍ നോക്കിക്കൊണ്ടിരിക്കും."
  },
  {
    "surah_id": 83,
    "ayah_number": 36,
    "global_ayah_id": 5884,
    "translation": "സത്യനിഷേധികള്‍ ചെയ്തു കൊണ്ടിരുന്നതിന് അവര്‍ക്ക് പ്രതിഫലം നല്‍കപ്പെട്ടുവോ എന്ന്‌."
  }
]