[
  {
    "surah_id": 81,
    "ayah_number": 0,
    "global_ayah_id": 5880,
    "translation": "అనంత కరుణామయుడు అపార కరుణాప్రదాత అయిన అల్లాహ్‌ పేరుతో"
  },
  {
    "surah_id": 81,
    "ayah_number": 1,
    "global_ayah_id": 5881,
    "translation": "సూర్యుడు (అంధకారంలో) చుట్టివేయబడి, కాంతిహీను డైనప్పుడు!"
  },
  {
    "surah_id": 81,
    "ayah_number": 2,
    "global_ayah_id": 5882,
    "translation": "మరియు నక్షత్రాలు (కాంతిని కోల్పోయి) రాలి పోవునప్పుడు!"
  },
  {
    "surah_id": 81,
    "ayah_number": 3,
    "global_ayah_id": 5883,
    "translation": "మరియు పర్వతాలు కదిలించబడి నప్పుడు!"
  },
  {
    "surah_id": 81,
    "ayah_number": 4,
    "global_ayah_id": 5884,
    "translation": "మరియు నిండు సూడి ఒంటెలు, నిరపేక్షంగా వదిలి వేయబడినప్పుడు!"
  },
  {
    "surah_id": 81,
    "ayah_number": 5,
    "global_ayah_id": 5885,
    "translation": "మరియు క్రూర మృగాలన్నీ ఒకచోట సమకూర్చబడినప్పుడు!"
  },
  {
    "surah_id": 81,
    "ayah_number": 6,
    "global_ayah_id": 5886,
    "translation": "మరియు సముద్రాలు ఉప్పొంగి పోయినప్పుడు!"
  },
  {
    "surah_id": 81,
    "ayah_number": 7,
    "global_ayah_id": 5887,
    "translation": "మరియు ఆత్మలు (శరీరాలతో) తిరిగి కలుపబడి నప్పుడు!"
  },
  {
    "surah_id": 81,
    "ayah_number": 8,
    "global_ayah_id": 5888,
    "translation": "మరియు సజీవంగా పాతిపెట్టడిన బాలిక ప్రశ్నించబడినప్పుడు:"
  },
  {
    "surah_id": 81,
    "ayah_number": 9,
    "global_ayah_id": 5889,
    "translation": "ఏ అపరాధానికి తాను హత్యచేయ బడిందని?"
  },
  {
    "surah_id": 81,
    "ayah_number": 10,
    "global_ayah_id": 5890,
    "translation": "మరియు కర్మపత్రాలు తెరువబడి నప్పుడు!"
  },
  {
    "surah_id": 81,
    "ayah_number": 11,
    "global_ayah_id": 5891,
    "translation": "మరియు ఆకాశం ఒలిచివేయబడి నప్పుడు!"
  },
  {
    "surah_id": 81,
    "ayah_number": 12,
    "global_ayah_id": 5892,
    "translation": "మరియు నరకాగ్ని మండించ బడినప్పుడు!"
  },
  {
    "surah_id": 81,
    "ayah_number": 13,
    "global_ayah_id": 5893,
    "translation": "మరియు స్వర్గం దగ్గరకు తీసుకురాబడి నప్పుడు!"
  },
  {
    "surah_id": 81,
    "ayah_number": 14,
    "global_ayah_id": 5894,
    "translation": "ప్రతి ఆత్మ తాను చేసి తెచ్చిన కర్మలను తెలుసుకుంటుంది."
  },
  {
    "surah_id": 81,
    "ayah_number": 15,
    "global_ayah_id": 5895,
    "translation": "అలా కాదు! నేను తొలగిపోయే నక్షత్రాల సాక్షిగా చెబుతున్నాను"
  },
  {
    "surah_id": 81,
    "ayah_number": 16,
    "global_ayah_id": 5896,
    "translation": "(ఏవైతే) వేగంగా తిరుగుతూ కనుమరుగవు తున్నాయో!"
  },
  {
    "surah_id": 81,
    "ayah_number": 17,
    "global_ayah_id": 5897,
    "translation": "మరియు గడచిపోయే రాత్రి సాక్షిగా!"
  },
  {
    "surah_id": 81,
    "ayah_number": 18,
    "global_ayah_id": 5898,
    "translation": "మరియు ప్రకాశించే ఉదయం సాక్షిగా!"
  },
  {
    "surah_id": 81,
    "ayah_number": 19,
    "global_ayah_id": 5899,
    "translation": "నిశ్చయంగా, ఇది (ఈ ఖుర్‌ఆన్‌) గౌరవ నీయుడైన సందేశహరుడు తెచ్చిన వాక్కు!"
  },
  {
    "surah_id": 81,
    "ayah_number": 20,
    "global_ayah_id": 5900,
    "translation": "అతను (జిబ్రీల్‌) మహా బలశాలి, సింహాసన ( అర్ష్‌)  అధిపతి సన్నిధిలో ఉన్నత స్థానం గల వాడు!"
  },
  {
    "surah_id": 81,
    "ayah_number": 21,
    "global_ayah_id": 5901,
    "translation": "అతని ఆజ్ఞలు పాటింపబడతాయి మరియు (అతను) విశ్వసనీయుడు!"
  },
  {
    "surah_id": 81,
    "ayah_number": 22,
    "global_ayah_id": 5902,
    "translation": "మరియు (ఓ ప్రజలారా!) మీ సహచరుడు పిచ్చివాడు కాడు!"
  },
  {
    "surah_id": 81,
    "ayah_number": 23,
    "global_ayah_id": 5903,
    "translation": "మరియు వాస్తవంగా, అతను ఆ సందేశహరుణ్ణి (జిబ్రీల్‌ను) ప్రకాశవంతమైన దిఙ్మండలంలో చూశాడు."
  },
  {
    "surah_id": 81,
    "ayah_number": 24,
    "global_ayah_id": 5904,
    "translation": "మరియు అతను (ము హమ్మద్‌) అగోచర జ్ఞానాన్ని ప్రజల నుండి దాచేవాడు కాడు."
  },
  {
    "surah_id": 81,
    "ayah_number": 25,
    "global_ayah_id": 5905,
    "translation": "మరియు ఇది (ఈ ఖుర్‌ఆన్‌) శపించబడిన (బహిష్కరించబడిన) షై తాన్‌ వాక్కు కాదు."
  },
  {
    "surah_id": 81,
    "ayah_number": 26,
    "global_ayah_id": 5906,
    "translation": "మరి మీరు ఎటు పోతున్నారు?"
  },
  {
    "surah_id": 81,
    "ayah_number": 27,
    "global_ayah_id": 5907,
    "translation": "ఇది (ఈ ఖుర్‌ఆన్‌) సర్వలోకాలకు ఒక హితోపదేశం."
  },
  {
    "surah_id": 81,
    "ayah_number": 28,
    "global_ayah_id": 5908,
    "translation": "మీలో, రుజు మార్గంలో నడవదలచుకున్న ప్రతివాని కొరకు."
  },
  {
    "surah_id": 81,
    "ayah_number": 29,
    "global_ayah_id": 5909,
    "translation": "మరియు సర్వలోకాల ప్రభువైన అల్లాహ్‌ తలచనంత వరకు, మీరు తలచినంత మాత్రాన ఏమీ కాదు.  (1/4)"
  }
]