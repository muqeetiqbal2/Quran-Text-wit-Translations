[
  {
    "surah_id": 81,
    "ayah_number": 1,
    "global_ayah_id": 5801,
    "translation": "جڏھن سج ويڙھبو."
  },
  {
    "surah_id": 81,
    "ayah_number": 2,
    "global_ayah_id": 5802,
    "translation": "۽ جڏھن تارا ميرا ٿيندا."
  },
  {
    "surah_id": 81,
    "ayah_number": 3,
    "global_ayah_id": 5803,
    "translation": "۽ جڏھن جبل ھلايا ويندا."
  },
  {
    "surah_id": 81,
    "ayah_number": 4,
    "global_ayah_id": 5804,
    "translation": "۽ جڏھن ڍُڪيون ويامڻ تي ڏاچيون بيڪار ڇڏبيون."
  },
  {
    "surah_id": 81,
    "ayah_number": 5,
    "global_ayah_id": 5805,
    "translation": "۽ جڏھن جھنگلي جانور گڏ ڪبا."
  },
  {
    "surah_id": 81,
    "ayah_number": 6,
    "global_ayah_id": 5806,
    "translation": "۽ جڏھن درياءَ (باھ وانگر) تپائبا."
  },
  {
    "surah_id": 81,
    "ayah_number": 7,
    "global_ayah_id": 5807,
    "translation": "۽ جڏھن جيءَ پاڻ ۾ ملائبا."
  },
  {
    "surah_id": 81,
    "ayah_number": 8,
    "global_ayah_id": 5808,
    "translation": "۽ جڏھن جيئري پوريل نياڻي پڇبي ته."
  },
  {
    "surah_id": 81,
    "ayah_number": 9,
    "global_ayah_id": 5809,
    "translation": "ڪھڙي ڏوھ ڪري ماري وئي."
  },
  {
    "surah_id": 81,
    "ayah_number": 10,
    "global_ayah_id": 5810,
    "translation": "۽ جڏھن اعمالناما کولبا."
  },
  {
    "surah_id": 81,
    "ayah_number": 11,
    "global_ayah_id": 5811,
    "translation": "۽ جڏھن آسمان ڇلبو."
  },
  {
    "surah_id": 81,
    "ayah_number": 12,
    "global_ayah_id": 5812,
    "translation": "۽ جڏھن دوزخ ٻاربو."
  },
  {
    "surah_id": 81,
    "ayah_number": 13,
    "global_ayah_id": 5813,
    "translation": "۽ جڏھن بھشت ويجھو ڪبو."
  },
  {
    "surah_id": 81,
    "ayah_number": 14,
    "global_ayah_id": 5814,
    "translation": "(تڏھن) ھر ھڪ جيءُ جيڪي حاضر آندو سو ڄاڻندو."
  },
  {
    "surah_id": 81,
    "ayah_number": 15,
    "global_ayah_id": 5815,
    "translation": "پوئتي ھٽندڙ تارن جو قَسم کڻان ٿو."
  },
  {
    "surah_id": 81,
    "ayah_number": 16,
    "global_ayah_id": 5816,
    "translation": "جي (ڪڏھن) سڌا ھلندڙ آھن (ڪڏھن) لڪي ويندڙ آھن."
  },
  {
    "surah_id": 81,
    "ayah_number": 17,
    "global_ayah_id": 5817,
    "translation": "۽ قسم آھي رات جو جڏھن پوئتي موٽندي آھي."
  },
  {
    "surah_id": 81,
    "ayah_number": 18,
    "global_ayah_id": 5818,
    "translation": "۽ قسم آھي صُبح جو جڏھن روشن ٿئي."
  },
  {
    "surah_id": 81,
    "ayah_number": 19,
    "global_ayah_id": 5819,
    "translation": "ته بيشڪ اھو (قرآن) ھڪ موڪليل سڳوري (مَلَڪ) جو پيغام ڏيڻ آھي."
  },
  {
    "surah_id": 81,
    "ayah_number": 20,
    "global_ayah_id": 5820,
    "translation": "جو سگھ واري عرش جي مالڪ (الله) وٽ وڏي مرتبي وارو آھي."
  },
  {
    "surah_id": 81,
    "ayah_number": 21,
    "global_ayah_id": 5821,
    "translation": "جو مڃوتيءَ وارو اُتي (مَلڪوت ۾) امين آھي."
  },
  {
    "surah_id": 81,
    "ayah_number": 22,
    "global_ayah_id": 5822,
    "translation": "۽ (ھي) اوھان جو سنگتي (ﷴ ﷺ ڪو) چريو نه آھي."
  },
  {
    "surah_id": 81,
    "ayah_number": 23,
    "global_ayah_id": 5823,
    "translation": "۽ بيشڪ (اوھان جي سنگتي) اُن (مَلَڪ) کي آسمان جي پڌري ڪناري تي (چتائي) ڏٺو آھي."
  },
  {
    "surah_id": 81,
    "ayah_number": 24,
    "global_ayah_id": 5824,
    "translation": "۽ اُھو (اوھان جو سنگتي) ڳجھ (جي ڳالھ ڏسڻ) تي بخل ڪندڙ نه آھي."
  },
  {
    "surah_id": 81,
    "ayah_number": 25,
    "global_ayah_id": 5825,
    "translation": "۽ قرآن تڙيل شيطان جو ڪلام نه آھي."
  },
  {
    "surah_id": 81,
    "ayah_number": 26,
    "global_ayah_id": 5826,
    "translation": "پوءِ ڪيڏانھن وڃو ٿا؟"
  },
  {
    "surah_id": 81,
    "ayah_number": 27,
    "global_ayah_id": 5827,
    "translation": "ھيءُ (قرآن) جھان وارن جي نصيحت کانسواءِ (ٻيو) ڪي نه آھي."
  },
  {
    "surah_id": 81,
    "ayah_number": 28,
    "global_ayah_id": 5828,
    "translation": "اوھان مان جيڪو سڌو ھلڻ گھري تنھن لاءِ آھي."
  },
  {
    "surah_id": 81,
    "ayah_number": 29,
    "global_ayah_id": 5829,
    "translation": "۽ جھانن جي پالڻھار الله جي گھُر کانسواءِ (ٻيو) ڪي اوھين گھري نه سگھندؤ."
  }
]