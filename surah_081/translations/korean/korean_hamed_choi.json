[
  {
    "surah_id": 81,
    "ayah_number": 1,
    "global_ayah_id": 5801,
    "translation": "태양이 은폐되어 그의 빛이 사라지고"
  },
  {
    "surah_id": 81,
    "ayah_number": 2,
    "global_ayah_id": 5802,
    "translation": "별들이 빛을 잃고 떨어지며"
  },
  {
    "surah_id": 81,
    "ayah_number": 3,
    "global_ayah_id": 5803,
    "translation": "산들이 신기루처럼 사라지고"
  },
  {
    "surah_id": 81,
    "ayah_number": 4,
    "global_ayah_id": 5804,
    "translation": "새끼를 밴지 열달이 된 암낙 타가 보호받지 못하고 버려지며"
  },
  {
    "surah_id": 81,
    "ayah_number": 5,
    "global_ayah_id": 5805,
    "translation": "야생동물이 떼지어 모이고"
  },
  {
    "surah_id": 81,
    "ayah_number": 6,
    "global_ayah_id": 5806,
    "translation": "바다가 물이 불어 넘쳐흐르며"
  },
  {
    "surah_id": 81,
    "ayah_number": 7,
    "global_ayah_id": 5807,
    "translation": "영혼들이 유사하게 분리되고"
  },
  {
    "surah_id": 81,
    "ayah_number": 8,
    "global_ayah_id": 5808,
    "translation": "여아가 산채로 매장되어 질문 을 받으니"
  },
  {
    "surah_id": 81,
    "ayah_number": 9,
    "global_ayah_id": 5809,
    "translation": "어떤 죄악으로 그녀가 살해되 었느뇨"
  },
  {
    "surah_id": 81,
    "ayah_number": 10,
    "global_ayah_id": 5810,
    "translation": "기록부들이 펼쳐지고"
  },
  {
    "surah_id": 81,
    "ayah_number": 11,
    "global_ayah_id": 5811,
    "translation": "하늘이 그의 베일을 벗을 때"
  },
  {
    "surah_id": 81,
    "ayah_number": 12,
    "global_ayah_id": 5812,
    "translation": "타오르는 불지옥이 열을 세 차게 발산하며"
  },
  {
    "surah_id": 81,
    "ayah_number": 13,
    "global_ayah_id": 5813,
    "translation": "천국이 의로운 자들에게 가 까이 오고"
  },
  {
    "surah_id": 81,
    "ayah_number": 14,
    "global_ayah_id": 5814,
    "translation": "그때 모든 영혼은 그가 행한것들을 알게 되니라"
  },
  {
    "surah_id": 81,
    "ayah_number": 15,
    "global_ayah_id": 5815,
    "translation": "실로 내가 지는 별들을 두고맹세하사"
  },
  {
    "surah_id": 81,
    "ayah_number": 16,
    "global_ayah_id": 5816,
    "translation": "나타나고 지는 별들을 두고 맹세하며"
  },
  {
    "surah_id": 81,
    "ayah_number": 17,
    "global_ayah_id": 5817,
    "translation": "어둠을 맞이하는 밤을 두고 맹세하며"
  },
  {
    "surah_id": 81,
    "ayah_number": 18,
    "global_ayah_id": 5818,
    "translation": "빛을 맞이하는 아침을 두고 맹세하나니"
  },
  {
    "surah_id": 81,
    "ayah_number": 19,
    "global_ayah_id": 5819,
    "translation": "실로 이것은 고귀한 사도가 전한 말씀이라"
  },
  {
    "surah_id": 81,
    "ayah_number": 20,
    "global_ayah_id": 5820,
    "translation": "그는 하나님 권좌 앞에 줄 지어 서 있는 강한자로"
  },
  {
    "surah_id": 81,
    "ayah_number": 21,
    "global_ayah_id": 5821,
    "translation": "순종하고 믿음직하노라"
  },
  {
    "surah_id": 81,
    "ayah_number": 22,
    "global_ayah_id": 5822,
    "translation": "그럼으로 너희의 동반자는 미친자가 아니며"
  },
  {
    "surah_id": 81,
    "ayah_number": 23,
    "global_ayah_id": 5823,
    "translation": "그는 청명한 지평선에 있는 그를 보았으되"
  },
  {
    "surah_id": 81,
    "ayah_number": 24,
    "global_ayah_id": 5824,
    "translation": "그가 보이지 않는 영역에 대한 지식을 인색하게 보류하고 있 는 것이 아니며"
  },
  {
    "surah_id": 81,
    "ayah_number": 25,
    "global_ayah_id": 5825,
    "translation": "이것은 저주받은 사탄의 말 이 아니매"
  },
  {
    "surah_id": 81,
    "ayah_number": 26,
    "global_ayah_id": 5826,
    "translation": "너희는 어디로 가려하느뇨"
  },
  {
    "surah_id": 81,
    "ayah_number": 27,
    "global_ayah_id": 5827,
    "translation": "실로 이것은 만인을 위한 메 세지이며"
  },
  {
    "surah_id": 81,
    "ayah_number": 28,
    "global_ayah_id": 5828,
    "translation": "너희 가운데 그 진리를 원하 는 자 그것을 따르도록 하려 함이 라"
  },
  {
    "surah_id": 81,
    "ayah_number": 29,
    "global_ayah_id": 5829,
    "translation": "그러나 만유의 주님이신 주 님의 뜻이 없이는 너희는 아무 것 도 할 수 없노라"
  }
]