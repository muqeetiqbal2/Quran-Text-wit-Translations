[
  {
    "surah_id": 81,
    "ayah_number": 1,
    "global_ayah_id": 5801,
    "translation": "Cuando el sol sea obscurecido,"
  },
  {
    "surah_id": 81,
    "ayah_number": 2,
    "global_ayah_id": 5802,
    "translation": "cuando las estrellas pierdan su brillo,"
  },
  {
    "surah_id": 81,
    "ayah_number": 3,
    "global_ayah_id": 5803,
    "translation": "cuando las montañas sean puestas en marcha,"
  },
  {
    "surah_id": 81,
    "ayah_number": 4,
    "global_ayah_id": 5804,
    "translation": "cuando las camellas preñadas de diez meses sean descuidadas,"
  },
  {
    "surah_id": 81,
    "ayah_number": 5,
    "global_ayah_id": 5805,
    "translation": "cuando las bestias salvajes sean agrupadas,"
  },
  {
    "surah_id": 81,
    "ayah_number": 6,
    "global_ayah_id": 5806,
    "translation": "cuando los mares sean hinchados,"
  },
  {
    "surah_id": 81,
    "ayah_number": 7,
    "global_ayah_id": 5807,
    "translation": "cuando las almas sean apareadas,"
  },
  {
    "surah_id": 81,
    "ayah_number": 8,
    "global_ayah_id": 5808,
    "translation": "cuando se pregunte a la niña enterrada viva"
  },
  {
    "surah_id": 81,
    "ayah_number": 9,
    "global_ayah_id": 5809,
    "translation": "qué crimen cometió para que la mataran,"
  },
  {
    "surah_id": 81,
    "ayah_number": 10,
    "global_ayah_id": 5810,
    "translation": "cuando las hojas sean desplegadas,"
  },
  {
    "surah_id": 81,
    "ayah_number": 11,
    "global_ayah_id": 5811,
    "translation": "cuando el cielo sea desollado,"
  },
  {
    "surah_id": 81,
    "ayah_number": 12,
    "global_ayah_id": 5812,
    "translation": "cuando el fuego de la gehena sea avivado,"
  },
  {
    "surah_id": 81,
    "ayah_number": 13,
    "global_ayah_id": 5813,
    "translation": "cuando el Jardín sea acercado,"
  },
  {
    "surah_id": 81,
    "ayah_number": 14,
    "global_ayah_id": 5814,
    "translation": "cada cual sabrá lo que presenta."
  },
  {
    "surah_id": 81,
    "ayah_number": 15,
    "global_ayah_id": 5815,
    "translation": "¡Pues no! ¡Juro por los planetas,"
  },
  {
    "surah_id": 81,
    "ayah_number": 16,
    "global_ayah_id": 5816,
    "translation": "que pasan y desaparecen!"
  },
  {
    "surah_id": 81,
    "ayah_number": 17,
    "global_ayah_id": 5817,
    "translation": "¡Por la noche cuando se extiende!"
  },
  {
    "surah_id": 81,
    "ayah_number": 18,
    "global_ayah_id": 5818,
    "translation": "¡Por la mañana cuando respira!"
  },
  {
    "surah_id": 81,
    "ayah_number": 19,
    "global_ayah_id": 5819,
    "translation": "Sí, es la palabra de un Enviado noble,"
  },
  {
    "surah_id": 81,
    "ayah_number": 20,
    "global_ayah_id": 5820,
    "translation": "que dispone de poder junto al Señor del Trono, firme,"
  },
  {
    "surah_id": 81,
    "ayah_number": 21,
    "global_ayah_id": 5821,
    "translation": "obedecido allís de confianza."
  },
  {
    "surah_id": 81,
    "ayah_number": 22,
    "global_ayah_id": 5822,
    "translation": "¡Vuestro paisano no es un poseso!"
  },
  {
    "surah_id": 81,
    "ayah_number": 23,
    "global_ayah_id": 5823,
    "translation": "Le ha visto en el claro horizonte,"
  },
  {
    "surah_id": 81,
    "ayah_number": 24,
    "global_ayah_id": 5824,
    "translation": "no es avaro de lo oculto."
  },
  {
    "surah_id": 81,
    "ayah_number": 25,
    "global_ayah_id": 5825,
    "translation": "No es la palabra de un demonio maldito."
  },
  {
    "surah_id": 81,
    "ayah_number": 26,
    "global_ayah_id": 5826,
    "translation": "¿Adónde iréis, pues?"
  },
  {
    "surah_id": 81,
    "ayah_number": 27,
    "global_ayah_id": 5827,
    "translation": "No es sino una amonestación dirigida a todo el mundo,"
  },
  {
    "surah_id": 81,
    "ayah_number": 28,
    "global_ayah_id": 5828,
    "translation": "para aquéllos de vosotros que quieran seguir la vía recta."
  },
  {
    "surah_id": 81,
    "ayah_number": 29,
    "global_ayah_id": 5829,
    "translation": "Pero vosotros no lo querréis, a menos que quiera Alá, Señor del universo."
  }
]