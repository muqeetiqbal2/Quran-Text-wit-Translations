[
  {
    "surah_id": 81,
    "ayah_number": 1,
    "global_ayah_id": 5801,
    "translation": "Marka qorraxda la duubo (Qiyaamada)."
  },
  {
    "surah_id": 81,
    "ayah_number": 2,
    "global_ayah_id": 5802,
    "translation": "Xiddiguhuna daataan (iyagoo Madow)."
  },
  {
    "surah_id": 81,
    "ayah_number": 3,
    "global_ayah_id": 5803,
    "translation": "Buurahana la kexeeyo (La rujiyo)."
  },
  {
    "surah_id": 81,
    "ayah_number": 4,
    "global_ayah_id": 5804,
    "translation": "Geelii rimmanaana la halleeyo."
  },
  {
    "surah_id": 81,
    "ayah_number": 5,
    "global_ayah_id": 5805,
    "translation": "Dugaaggana la kulmiyo (Qisaas darteed)."
  },
  {
    "surah_id": 81,
    "ayah_number": 6,
    "global_ayah_id": 5806,
    "translation": "Badahana la kululeeyo."
  },
  {
    "surah_id": 81,
    "ayah_number": 7,
    "global_ayah_id": 5807,
    "translation": "Naf walbana Jidhkeedii lammaaneeyo."
  },
  {
    "surah_id": 81,
    "ayah_number": 8,
    "global_ayah_id": 5808,
    "translation": "Gabdhihii la xabaalnololiyayna la warsado."
  },
  {
    "surah_id": 81,
    "ayah_number": 9,
    "global_ayah_id": 5809,
    "translation": "Maxaa dambi ah oo loo dilay."
  },
  {
    "surah_id": 81,
    "ayah_number": 10,
    "global_ayah_id": 5810,
    "translation": "Kutubta (camalkana) la fidiyo."
  },
  {
    "surah_id": 81,
    "ayah_number": 11,
    "global_ayah_id": 5811,
    "translation": "Samadana la rujiyo."
  },
  {
    "surah_id": 81,
    "ayah_number": 12,
    "global_ayah_id": 5812,
    "translation": "Naarta Jaxiimana la huriyo."
  },
  {
    "surah_id": 81,
    "ayah_number": 13,
    "global_ayah_id": 5813,
    "translation": "Jannadana la dhaweeyo."
  },
  {
    "surah_id": 81,
    "ayah_number": 14,
    "global_ayah_id": 5814,
    "translation": "Waxay ogaan nafu waxay camal fashay."
  },
  {
    "surah_id": 81,
    "ayah_number": 15,
    "global_ayah_id": 5815,
    "translation": "Waxaan ku dhaartay «huu Eebe yidhi» Xiddigaha Qarsooma (Maalintii)."
  },
  {
    "surah_id": 81,
    "ayah_number": 16,
    "global_ayah_id": 5816,
    "translation": "Ee socda iftiinka Qorraxdana ku qarsooma."
  },
  {
    "surah_id": 81,
    "ayah_number": 17,
    "global_ayah_id": 5817,
    "translation": "Iyo Habecnku markuu jeedsado."
  },
  {
    "surah_id": 81,
    "ayah_number": 18,
    "global_ayah_id": 5818,
    "translation": "Iyo subaxu markuu soo qaabilo."
  },
  {
    "surah_id": 81,
    "ayah_number": 19,
    "global_ayah_id": 5819,
    "translation": "Ee Quraanku waa hadalka Eebe, Soona raray Malag sharaf lah."
  },
  {
    "surah_id": 81,
    "ayah_number": 20,
    "global_ayah_id": 5820,
    "translation": "Xoogna leh Eeba agtiisana Daraja ku leh."
  },
  {
    "surah_id": 81,
    "ayah_number": 21,
    "global_ayah_id": 5821,
    "translation": "Laguna addeeco halkaas aaminna ah."
  },
  {
    "surah_id": 81,
    "ayah_number": 22,
    "global_ayah_id": 5822,
    "translation": "Saaxiibkiinna (Nabiguna) ma aha ku waalan."
  },
  {
    "surah_id": 81,
    "ayah_number": 23,
    "global_ayah_id": 5823,
    "translation": "Horaybuuna ugn arkay Jibriil Jahadii Caddayd (Bariga Maka)."
  },
  {
    "surah_id": 81,
    "ayah_number": 24,
    "global_ayah_id": 5824,
    "translation": "Nabiguna ma aha Ruux lugu shakiyo waxa Maqan."
  },
  {
    "surah_id": 81,
    "ayah_number": 25,
    "global_ayah_id": 5825,
    "translation": "Qaraankuna ma aha hadal shaydaan la fogeeyay."
  },
  {
    "surah_id": 81,
    "ayah_number": 26,
    "global_ayah_id": 5826,
    "translation": "Ee xaggeed Gaalooy aadaysaan."
  },
  {
    "surah_id": 81,
    "ayah_number": 27,
    "global_ayah_id": 5827,
    "translation": "Quraankuna waxaan waanada caalamka ahayn ina aha (waa waano)."
  },
  {
    "surah_id": 81,
    "ayah_number": 28,
    "global_ayah_id": 5828,
    "translation": "Ruuxii doona inuu toosnaado (yuuna u yahay)."
  },
  {
    "surah_id": 81,
    "ayah_number": 29,
    "global_ayah_id": 5829,
    "translation": "Waxna ma dooni kartaan in Eebaha Caalamku doona mooyec."
  }
]