[
  {
    "surah_id": 81,
    "ayah_number": 1,
    "global_ayah_id": 5801,
    "translation": "當太陽黯黮的時候，"
  },
  {
    "surah_id": 81,
    "ayah_number": 2,
    "global_ayah_id": 5802,
    "translation": "當星宿零落的時候，"
  },
  {
    "surah_id": 81,
    "ayah_number": 3,
    "global_ayah_id": 5803,
    "translation": "當山巒崩潰的時候，"
  },
  {
    "surah_id": 81,
    "ayah_number": 4,
    "global_ayah_id": 5804,
    "translation": "當孕駝被拋棄的時候，"
  },
  {
    "surah_id": 81,
    "ayah_number": 5,
    "global_ayah_id": 5805,
    "translation": "當野獸被集合的時候，"
  },
  {
    "surah_id": 81,
    "ayah_number": 6,
    "global_ayah_id": 5806,
    "translation": "當海洋澎湃的時候，"
  },
  {
    "surah_id": 81,
    "ayah_number": 7,
    "global_ayah_id": 5807,
    "translation": "當靈魂被配合的時候，"
  },
  {
    "surah_id": 81,
    "ayah_number": 8,
    "global_ayah_id": 5808,
    "translation": "當被活埋的女孩被詢問的時候："
  },
  {
    "surah_id": 81,
    "ayah_number": 9,
    "global_ayah_id": 5809,
    "translation": "「她為什麼罪過而遭殺害呢？」"
  },
  {
    "surah_id": 81,
    "ayah_number": 10,
    "global_ayah_id": 5810,
    "translation": "當功過簿被展開的時候，"
  },
  {
    "surah_id": 81,
    "ayah_number": 11,
    "global_ayah_id": 5811,
    "translation": "當天皮被揭去的時候，"
  },
  {
    "surah_id": 81,
    "ayah_number": 12,
    "global_ayah_id": 5812,
    "translation": "當火獄被燃著的時候，"
  },
  {
    "surah_id": 81,
    "ayah_number": 13,
    "global_ayah_id": 5813,
    "translation": "當樂園被送近的時候，"
  },
  {
    "surah_id": 81,
    "ayah_number": 14,
    "global_ayah_id": 5814,
    "translation": "每個人都知道他所作過的善惡。"
  },
  {
    "surah_id": 81,
    "ayah_number": 15,
    "global_ayah_id": 5815,
    "translation": "我誓以運行的眾星——"
  },
  {
    "surah_id": 81,
    "ayah_number": 16,
    "global_ayah_id": 5816,
    "translation": "沒落的行星，"
  },
  {
    "surah_id": 81,
    "ayah_number": 17,
    "global_ayah_id": 5817,
    "translation": "和逝去時的黑夜，"
  },
  {
    "surah_id": 81,
    "ayah_number": 18,
    "global_ayah_id": 5818,
    "translation": "照耀時的早晨，"
  },
  {
    "surah_id": 81,
    "ayah_number": 19,
    "global_ayah_id": 5819,
    "translation": "這確是一個尊貴的使者的言辭，"
  },
  {
    "surah_id": 81,
    "ayah_number": 20,
    "global_ayah_id": 5820,
    "translation": "他在寶座的主那裡，是有權力的，是有地位的，"
  },
  {
    "surah_id": 81,
    "ayah_number": 21,
    "global_ayah_id": 5821,
    "translation": "是眾望所歸，而且忠於職守的。"
  },
  {
    "surah_id": 81,
    "ayah_number": 22,
    "global_ayah_id": 5822,
    "translation": "你們的朋友，不是一個瘋人，"
  },
  {
    "surah_id": 81,
    "ayah_number": 23,
    "global_ayah_id": 5823,
    "translation": "他確已看見那個天使在明顯的天邊，"
  },
  {
    "surah_id": 81,
    "ayah_number": 24,
    "global_ayah_id": 5824,
    "translation": "他對幽玄不是吝教的。"
  },
  {
    "surah_id": 81,
    "ayah_number": 25,
    "global_ayah_id": 5825,
    "translation": "這不是被放逐的惡魔的言辭，"
  },
  {
    "surah_id": 81,
    "ayah_number": 26,
    "global_ayah_id": 5826,
    "translation": "然則，你們將往那裡去呢？"
  },
  {
    "surah_id": 81,
    "ayah_number": 27,
    "global_ayah_id": 5827,
    "translation": "這只是對於全世界的教誨——"
  },
  {
    "surah_id": 81,
    "ayah_number": 28,
    "global_ayah_id": 5828,
    "translation": "對於你們中欲循規蹈矩者的教誨，"
  },
  {
    "surah_id": 81,
    "ayah_number": 29,
    "global_ayah_id": 5829,
    "translation": "你們不欲循規蹈矩，除非真主——全世界的主——意欲的時候。"
  }
]