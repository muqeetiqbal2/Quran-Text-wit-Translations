[
  {
    "surah_id": 81,
    "ayah_number": 0,
    "global_ayah_id": 5880,
    "translation": " اللہ تعالیٰ کے «<a href=614> نام </a>» سے جو وسیع رحمت والا ، نہایت رحم والا ہے ۔\n "
  },
  {
    "surah_id": 81,
    "ayah_number": 1,
    "global_ayah_id": 5881,
    "translation": " جب سورج لپیٹ دیا جائے گا ۔ "
  },
  {
    "surah_id": 81,
    "ayah_number": 2,
    "global_ayah_id": 5882,
    "translation": " اور جب تارے بے نور ہو جائیں گے ۔ "
  },
  {
    "surah_id": 81,
    "ayah_number": 3,
    "global_ayah_id": 5883,
    "translation": " اور جب «<a href=160> پہاڑ </a>» چلائے جائیں گے ۔ "
  },
  {
    "surah_id": 81,
    "ayah_number": 4,
    "global_ayah_id": 5884,
    "translation": " اور جب دس «<a href=604> مہینے </a>» کی حاملہ اُونٹنیاں بے کار چھوڑ دی جائیں گی ۔ "
  },
  {
    "surah_id": 81,
    "ayah_number": 5,
    "global_ayah_id": 5885,
    "translation": " اور جب وحشی جانور اکٹھے کر دیے جائیں گے ۔ "
  },
  {
    "surah_id": 81,
    "ayah_number": 6,
    "global_ayah_id": 5886,
    "translation": " اور جب سمندر بھڑکا دیے جائیں گے ۔ "
  },
  {
    "surah_id": 81,
    "ayah_number": 7,
    "global_ayah_id": 5887,
    "translation": " اور جب رُوحیں ( «<a href=230> جسم </a>» سے ) ملا دی جائیں گی ۔ "
  },
  {
    "surah_id": 81,
    "ayah_number": 8,
    "global_ayah_id": 5888,
    "translation": " اور جب «<a href=381> زندہ </a>» دفن کی جانے والی لڑکی سے سوال کیا جائے گا ۔ "
  },
  {
    "surah_id": 81,
    "ayah_number": 9,
    "global_ayah_id": 5889,
    "translation": " کہ کس «<a href=531> گناہ </a>» کے بدلے میں وہ «<a href=467> قتل </a>» کی گئی ؟ "
  },
  {
    "surah_id": 81,
    "ayah_number": 10,
    "global_ayah_id": 5890,
    "translation": " اور جب «<a href=42> اعمال </a>» نامے پھیلائے جائیں گے ۔ "
  },
  {
    "surah_id": 81,
    "ayah_number": 11,
    "global_ayah_id": 5891,
    "translation": " اور جب «<a href=10> آسمان </a>» کی «<a href=507> کھال </a>» اتار دی جائے گی ۔ "
  },
  {
    "surah_id": 81,
    "ayah_number": 12,
    "global_ayah_id": 5892,
    "translation": " اور جب جہنم دہکا دی جائے گی ۔ "
  },
  {
    "surah_id": 81,
    "ayah_number": 13,
    "global_ayah_id": 5893,
    "translation": " اور جب «<a href=237> جنت </a>» قریب لائی جائے گی ۔ "
  },
  {
    "surah_id": 81,
    "ayah_number": 14,
    "global_ayah_id": 5894,
    "translation": " تو ہر جان ، جان لے گی کہ وہ کیا لے کر آئی ہے ؟ "
  },
  {
    "surah_id": 81,
    "ayah_number": 15,
    "global_ayah_id": 5895,
    "translation": " پس میں «<a href=472> قسم </a>» کھاتا ہوں «<a href=179> پیچھے </a>» ہٹنے والے (\nستاروں ) کی ! "
  },
  {
    "surah_id": 81,
    "ayah_number": 16,
    "global_ayah_id": 5896,
    "translation": " جو چلتے رہنے والے ، چھپ جانے والے ہیں ۔ "
  },
  {
    "surah_id": 81,
    "ayah_number": 17,
    "global_ayah_id": 5897,
    "translation": " اور «<a href=356> رات </a>» کی جب وہ رخصت ہوتی ہے ! "
  },
  {
    "surah_id": 81,
    "ayah_number": 18,
    "global_ayah_id": 5898,
    "translation": " اور صبح کی جب وہ سانس لیتی ہے ! "
  },
  {
    "surah_id": 81,
    "ayah_number": 19,
    "global_ayah_id": 5899,
    "translation": " بلاشبہ یقیناً یہ ایک معزز پیغام پہنچانے والے کا قول ہے ۔ "
  },
  {
    "surah_id": 81,
    "ayah_number": 20,
    "global_ayah_id": 5900,
    "translation": " جو «<a href=475> قوت </a>» والا ہے ، عرش والے کے «<a href=619> نزدیک </a>» «<a\n  href=106> بلند </a>» مرتبہ ہے ۔ "
  },
  {
    "surah_id": 81,
    "ayah_number": 21,
    "global_ayah_id": 5901,
    "translation": " وہاں اُس کی «<a href=71> بات </a>» مانی جاتی ہے ، امانت دار ہے ۔ "
  },
  {
    "surah_id": 81,
    "ayah_number": 22,
    "global_ayah_id": 5902,
    "translation": " اور تمہارا «<a href=383> ساتھی </a>» ہرگز کوئی «<a href=343> دیوانہ </a>» نہیں ہے\n۔ "
  },
  {
    "surah_id": 81,
    "ayah_number": 23,
    "global_ayah_id": 5903,
    "translation": " اور بلاشبہ یقیناً اُس ( محمد ) نے اس ( جبرئیل ) کو ( «<a href=10> آسمان </a>» کے )\nروشن کنارے پر دیکھا ہے ۔ "
  },
  {
    "surah_id": 81,
    "ayah_number": 24,
    "global_ayah_id": 5904,
    "translation": " اور وہ غیب پر ہرگز بخیل نہیں ہے ۔ "
  },
  {
    "surah_id": 81,
    "ayah_number": 25,
    "global_ayah_id": 5905,
    "translation": " اور وہ ہرگز کسی شیطان مردُود کا قول نہیں ہے ۔ "
  },
  {
    "surah_id": 81,
    "ayah_number": 26,
    "global_ayah_id": 5906,
    "translation": " پھر تم لوگ کدھر جا رہے ہو ؟ "
  },
  {
    "surah_id": 81,
    "ayah_number": 27,
    "global_ayah_id": 5907,
    "translation": " یہ تو سارے جہانوں کے لیے «<a href=622> نصیحت </a>» ہے ۔ "
  },
  {
    "surah_id": 81,
    "ayah_number": 28,
    "global_ayah_id": 5908,
    "translation": " تم میں سے اُس کے لیے جو چاہے کہ وہ «<a href=408> سیدھا </a>» چلے ۔ "
  },
  {
    "surah_id": 81,
    "ayah_number": 29,
    "global_ayah_id": 5909,
    "translation": " اور تم نہیں چاہتے مگر یہ کہ اللہ تعالیٰ چاہے جو سارے جہانوں کا رب ہے ۔ "
  }
]