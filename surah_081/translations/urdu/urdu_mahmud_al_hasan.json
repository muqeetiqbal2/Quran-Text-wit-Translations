[
  {
    "surah_id": 81,
    "ayah_number": 0,
    "global_ayah_id": 5880,
    "translation": "اللہ کے نام سے جو رحمان و رحیم ہے"
  },
  {
    "surah_id": 81,
    "ayah_number": 1,
    "global_ayah_id": 5881,
    "translation": "جب سورج کی دھوپ تہہ ہو جائے"
  },
  {
    "surah_id": 81,
    "ayah_number": 2,
    "global_ayah_id": 5882,
    "translation": "اور جب تارے میلے ہو جائیں"
  },
  {
    "surah_id": 81,
    "ayah_number": 3,
    "global_ayah_id": 5883,
    "translation": "اور جب پہاڑ چلائے جائیں"
  },
  {
    "surah_id": 81,
    "ayah_number": 4,
    "global_ayah_id": 5884,
    "translation": "اور جب بیاتی اونٹنیاں چھٹی پھریں"
  },
  {
    "surah_id": 81,
    "ayah_number": 5,
    "global_ayah_id": 5885,
    "translation": "اور جب جنگل کے جانوروں میں رول پڑ جائے"
  },
  {
    "surah_id": 81,
    "ayah_number": 6,
    "global_ayah_id": 5886,
    "translation": "اور جب دریا جھونکے جائیں"
  },
  {
    "surah_id": 81,
    "ayah_number": 7,
    "global_ayah_id": 5887,
    "translation": "اور جب جیوں کے جوڑے باندھے جائیں"
  },
  {
    "surah_id": 81,
    "ayah_number": 8,
    "global_ayah_id": 5888,
    "translation": "اور جب بیٹی جیتی گاڑ دی گئ کو پوچھیں"
  },
  {
    "surah_id": 81,
    "ayah_number": 9,
    "global_ayah_id": 5889,
    "translation": "کہ کس گناہ پر وہ ماری گئ"
  },
  {
    "surah_id": 81,
    "ayah_number": 10,
    "global_ayah_id": 5890,
    "translation": "اور جب اعمالنامے کھولے جائیں"
  },
  {
    "surah_id": 81,
    "ayah_number": 11,
    "global_ayah_id": 5891,
    "translation": "اور جب آسمان کا پوست اتار لیں"
  },
  {
    "surah_id": 81,
    "ayah_number": 12,
    "global_ayah_id": 5892,
    "translation": "اور جب دوزخ دہکائی جائے"
  },
  {
    "surah_id": 81,
    "ayah_number": 13,
    "global_ayah_id": 5893,
    "translation": "اور جب بہشت پاس لائی جائے"
  },
  {
    "surah_id": 81,
    "ayah_number": 14,
    "global_ayah_id": 5894,
    "translation": "جان لے گا ہر ایک جی جو لے کر آیا"
  },
  {
    "surah_id": 81,
    "ayah_number": 15,
    "global_ayah_id": 5895,
    "translation": "سو قسم کھاتا ہوں میں پیچھے ہٹ جانے والوں"
  },
  {
    "surah_id": 81,
    "ayah_number": 16,
    "global_ayah_id": 5896,
    "translation": "سیدھے چلنے دبک جانے والوں کی"
  },
  {
    "surah_id": 81,
    "ayah_number": 17,
    "global_ayah_id": 5897,
    "translation": "اور رات کی جب پھیل جائے"
  },
  {
    "surah_id": 81,
    "ayah_number": 18,
    "global_ayah_id": 5898,
    "translation": "اور صبح کی جب دم بھرے"
  },
  {
    "surah_id": 81,
    "ayah_number": 19,
    "global_ayah_id": 5899,
    "translation": "مقرر یہ کہا ہے ایک بھیجے ہوئے عزت والے کا"
  },
  {
    "surah_id": 81,
    "ayah_number": 20,
    "global_ayah_id": 5900,
    "translation": "قوت والا عرش کے مالک کے پاس درجہ پانے والا"
  },
  {
    "surah_id": 81,
    "ayah_number": 21,
    "global_ayah_id": 5901,
    "translation": "سب کا مانا ہوا وہاں کا معتبر"
  },
  {
    "surah_id": 81,
    "ayah_number": 22,
    "global_ayah_id": 5902,
    "translation": "اور یہ تمہارا رفیق کچھ دیوانہ نہیں"
  },
  {
    "surah_id": 81,
    "ayah_number": 23,
    "global_ayah_id": 5903,
    "translation": "اور اس نے دیکھا ہے اُس فرشتہ کو آسمان کے کھلے کنارہ کے پاس"
  },
  {
    "surah_id": 81,
    "ayah_number": 24,
    "global_ayah_id": 5904,
    "translation": "اور یہ غیب کی بات بتانے میں بخیل نہیں"
  },
  {
    "surah_id": 81,
    "ayah_number": 25,
    "global_ayah_id": 5905,
    "translation": "اور یہ کہا ہوا نہیں کسی شیطان مردود کا"
  },
  {
    "surah_id": 81,
    "ayah_number": 26,
    "global_ayah_id": 5906,
    "translation": "پھر تم کدھر چلے جا رہے ہو"
  },
  {
    "surah_id": 81,
    "ayah_number": 27,
    "global_ayah_id": 5907,
    "translation": "یہ تو ایک نصیحت ہے جہان بھر کے واسطے"
  },
  {
    "surah_id": 81,
    "ayah_number": 28,
    "global_ayah_id": 5908,
    "translation": "جو کوئی چاہے تم میں سے کہ سیدھا چلے"
  },
  {
    "surah_id": 81,
    "ayah_number": 29,
    "global_ayah_id": 5909,
    "translation": "اور تم جبھی چاہو کہ چاہے اللہ سارے جہان کا مالک"
  }
]