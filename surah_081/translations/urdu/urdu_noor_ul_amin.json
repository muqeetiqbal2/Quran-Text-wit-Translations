[
  {
    "surah_id": 81,
    "ayah_number": 0,
    "global_ayah_id": 5880,
    "translation": "شروع اللہ کے «<a href=614> نام </a>» سے جو بڑا «<a href=600> مہربان </a>» اور نہایت رحم کرنے والا ہے"
  },
  {
    "surah_id": 81,
    "ayah_number": 1,
    "global_ayah_id": 5881,
    "translation": "جب سورج لپیٹ لیاجائے گا"
  },
  {
    "surah_id": 81,
    "ayah_number": 2,
    "global_ayah_id": 5882,
    "translation": "اور ستارے بے نورہوجائینگے"
  },
  {
    "surah_id": 81,
    "ayah_number": 3,
    "global_ayah_id": 5883,
    "translation": "اور پہاڑچلائے جائینگے"
  },
  {
    "surah_id": 81,
    "ayah_number": 4,
    "global_ayah_id": 5884,
    "translation": "اور دس ماہ کی حاملہ اونٹنیاں  ،  اپنے حال پر چھوڑدی جائیں گی"
  },
  {
    "surah_id": 81,
    "ayah_number": 5,
    "global_ayah_id": 5885,
    "translation": "اور جنگلی جانوراکٹھے کردیئے جائینگے"
  },
  {
    "surah_id": 81,
    "ayah_number": 6,
    "global_ayah_id": 5886,
    "translation": "اور سمندربھڑکائے جائینگے"
  },
  {
    "surah_id": 81,
    "ayah_number": 7,
    "global_ayah_id": 5887,
    "translation": "اور جانیں جسموں سے ملا دی جائیں گی"
  },
  {
    "surah_id": 81,
    "ayah_number": 8,
    "global_ayah_id": 5888,
    "translation": "اور «<a href=381> زندہ </a>» درگورلڑکی سے پوچھاجائے گا"
  },
  {
    "surah_id": 81,
    "ayah_number": 9,
    "global_ayah_id": 5889,
    "translation": "کہ وہ کس جرم میں ماری گئی تھی؟"
  },
  {
    "surah_id": 81,
    "ayah_number": 10,
    "global_ayah_id": 5890,
    "translation": "اور جب «<a href=42> اعمال </a>» نامے کھولے جائینگے"
  },
  {
    "surah_id": 81,
    "ayah_number": 11,
    "global_ayah_id": 5891,
    "translation": "اورآسمانوں کی «<a href=507> کھال </a>» اتاردی جائے گی"
  },
  {
    "surah_id": 81,
    "ayah_number": 12,
    "global_ayah_id": 5892,
    "translation": "اور «<a href=331> دوزخ </a>» بھڑکائی جائے گی"
  },
  {
    "surah_id": 81,
    "ayah_number": 13,
    "global_ayah_id": 5893,
    "translation": "اور «<a href=237> جنت </a>» قریب لے آئی جائے گی"
  },
  {
    "surah_id": 81,
    "ayah_number": 14,
    "global_ayah_id": 5894,
    "translation": "( اس «<a href=639> وقت </a>» )  ہرشخص جان لے گاکہ وہ کیا لے کر آیا ہے"
  },
  {
    "surah_id": 81,
    "ayah_number": 15,
    "global_ayah_id": 5895,
    "translation": "میں «<a href=179> پیچھے </a>» ہٹ جانے والے ستاروں کی «<a href=472> قسم </a>» کھاتا ہوں"
  },
  {
    "surah_id": 81,
    "ayah_number": 16,
    "global_ayah_id": 5896,
    "translation": "جوسیدھے چلتے چلتے «<a href=271> غائب </a>» ہو جاتے ہیں"
  },
  {
    "surah_id": 81,
    "ayah_number": 17,
    "global_ayah_id": 5897,
    "translation": "اور «<a href=356> رات </a>» کی جب اس کی «<a href=186> تاریکی </a>» چھانے لگے"
  },
  {
    "surah_id": 81,
    "ayah_number": 18,
    "global_ayah_id": 5898,
    "translation": "اور صبح کی جب وہ سانس لے"
  },
  {
    "surah_id": 81,
    "ayah_number": 19,
    "global_ayah_id": 5899,
    "translation": "کہ یہ ایک معزز رسول کاقول ہے"
  },
  {
    "surah_id": 81,
    "ayah_number": 20,
    "global_ayah_id": 5900,
    "translation": "جوبڑاطاقتور اور صاحب عرش کے ہاں بڑے رتبے والا ہے"
  },
  {
    "surah_id": 81,
    "ayah_number": 21,
    "global_ayah_id": 5901,
    "translation": "وہاں اس کاحکم ماناجاتا ہے ،  بااعتماد ہے"
  },
  {
    "surah_id": 81,
    "ayah_number": 22,
    "global_ayah_id": 5902,
    "translation": "اور  ( اے کفارمکہ )  تمہاراصاحب مجنون نہیں ہے"
  },
  {
    "surah_id": 81,
    "ayah_number": 23,
    "global_ayah_id": 5903,
    "translation": "اوراس نے اس  ( جبریل )  کو روشن افق پر دیکھا ہے"
  },
  {
    "surah_id": 81,
    "ayah_number": 24,
    "global_ayah_id": 5904,
    "translation": "اور وہ غیب کی باتوں کو  ( لوگوں تک )  پہنچانے میں بخیل نہیں ہے"
  },
  {
    "surah_id": 81,
    "ayah_number": 25,
    "global_ayah_id": 5905,
    "translation": "اور نہ یہ  ( «<a href=470> قرآن </a>» )  کسی شیطان مردودکاقول ہے"
  },
  {
    "surah_id": 81,
    "ayah_number": 26,
    "global_ayah_id": 5906,
    "translation": "پھرتم کہا ں جارہے ہو؟"
  },
  {
    "surah_id": 81,
    "ayah_number": 27,
    "global_ayah_id": 5907,
    "translation": "یہ تو سارے جہان والوں کے لئے ایک «<a href=622> نصیحت </a>» ہے"
  },
  {
    "surah_id": 81,
    "ayah_number": 28,
    "global_ayah_id": 5908,
    "translation": "تم میں سےجو بھی «<a href=408> سیدھا </a>» چلناچاہتا ہو"
  },
  {
    "surah_id": 81,
    "ayah_number": 29,
    "global_ayah_id": 5909,
    "translation": "اور تم چاہ نہیں سکتے مگروہی سب کچھ جو اللہ رب العالمین چاہتا ہو"
  }
]