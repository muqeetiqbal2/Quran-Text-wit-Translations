[
  {
    "surah_id": 81,
    "ayah_number": 0,
    "global_ayah_id": 5880,
    "translation": "اللہ ہی کے «<a href=614> نام </a>» سے  (  «<a href=416> شروع </a>» کرتا ہوں )  جو نہایت رحم فرمانے والا بہت «<a href=600> مہربان </a>» ہے"
  },
  {
    "surah_id": 81,
    "ayah_number": 1,
    "global_ayah_id": 5881,
    "translation": "جب سورج کو لپیٹ دیا جائے گا"
  },
  {
    "surah_id": 81,
    "ayah_number": 2,
    "global_ayah_id": 5882,
    "translation": "اور جب ستارے جھڑ جائیں گے"
  },
  {
    "surah_id": 81,
    "ayah_number": 3,
    "global_ayah_id": 5883,
    "translation": "اور جب پہاڑچلائے جائیں گے"
  },
  {
    "surah_id": 81,
    "ayah_number": 4,
    "global_ayah_id": 5884,
    "translation": "اور جب دس ماہ کی حاملہ اونٹنیاں «<a href=136> بےکار </a>» چھوڑ دی جائیں گی"
  },
  {
    "surah_id": 81,
    "ayah_number": 5,
    "global_ayah_id": 5885,
    "translation": "اور جب وحشی جانور جمع کیے جائیں گے"
  },
  {
    "surah_id": 81,
    "ayah_number": 6,
    "global_ayah_id": 5886,
    "translation": "اور جب سمندر بھڑکا دیے جائیں گے"
  },
  {
    "surah_id": 81,
    "ayah_number": 7,
    "global_ayah_id": 5887,
    "translation": "اور جب جانیں ملا دی جائیں گی"
  },
  {
    "surah_id": 81,
    "ayah_number": 8,
    "global_ayah_id": 5888,
    "translation": "اور جب «<a href=381> زندہ </a>» درگور  (  لڑکی )  سے سوال کیا جائے گا"
  },
  {
    "surah_id": 81,
    "ayah_number": 9,
    "global_ayah_id": 5889,
    "translation": "وہ کس «<a href=531> گناہ </a>» میں «<a href=467> قتل </a>» کی گئی ؟"
  },
  {
    "surah_id": 81,
    "ayah_number": 10,
    "global_ayah_id": 5890,
    "translation": "اور جب صحائف «<a href=42> اعمال </a>» پھیلا دیے جائیں گے"
  },
  {
    "surah_id": 81,
    "ayah_number": 11,
    "global_ayah_id": 5891,
    "translation": "اور جب «<a href=10> آسمان </a>» کھینچ لیا جائے گا"
  },
  {
    "surah_id": 81,
    "ayah_number": 12,
    "global_ayah_id": 5892,
    "translation": "اور جب «<a href=331> دوزخ </a>» کو بھڑکا دیا جائے گا"
  },
  {
    "surah_id": 81,
    "ayah_number": 13,
    "global_ayah_id": 5893,
    "translation": "اور جب «<a href=237> جنت </a>» قریب کردی جائے گی"
  },
  {
    "surah_id": 81,
    "ayah_number": 14,
    "global_ayah_id": 5894,
    "translation": "تو ہر شخص جان لے گا جو «<a href=481> کام </a>» اس نے «<a href=181> پیش </a>» کیا ہے"
  },
  {
    "surah_id": 81,
    "ayah_number": 15,
    "global_ayah_id": 5895,
    "translation": "میں «<a href=472> قسم </a>» کھاتا ہوں «<a href=179> پیچھے </a>» ہٹنے والے ستاروں کی"
  },
  {
    "surah_id": 81,
    "ayah_number": 16,
    "global_ayah_id": 5896,
    "translation": "چلنے پھرنے والے چھپنے والے ستاروں کی"
  },
  {
    "surah_id": 81,
    "ayah_number": 17,
    "global_ayah_id": 5897,
    "translation": "اور «<a href=356> رات </a>» کی جب جانے لگے"
  },
  {
    "surah_id": 81,
    "ayah_number": 18,
    "global_ayah_id": 5898,
    "translation": "اور صبح کی جب چمکنے لگے"
  },
  {
    "surah_id": 81,
    "ayah_number": 19,
    "global_ayah_id": 5899,
    "translation": "بیشک یہ معزز رسول کا قول ہے"
  },
  {
    "surah_id": 81,
    "ayah_number": 20,
    "global_ayah_id": 5900,
    "translation": "جو «<a href=475> قوت </a>» والا ہے عرش والے کے «<a href=619> نزدیک </a>» «<a href=106> بلند </a>» مرتبہ ہے"
  },
  {
    "surah_id": 81,
    "ayah_number": 21,
    "global_ayah_id": 5901,
    "translation": "جس کی آسمانوں میں «<a href=40> اطاعت </a>» کی جاتی ہے وہاں امانت دار ہے"
  },
  {
    "surah_id": 81,
    "ayah_number": 22,
    "global_ayah_id": 5902,
    "translation": "اور تمہارے نبی مجنون نہیں ہیں"
  },
  {
    "surah_id": 81,
    "ayah_number": 23,
    "global_ayah_id": 5903,
    "translation": "اور بیشک انہوں نے اسے روشن کنارے پر دیکھا"
  },
  {
    "surah_id": 81,
    "ayah_number": 24,
    "global_ayah_id": 5904,
    "translation": "اور وہ  ( نبی )  غیب کی «<a href=293> خبر </a>» دینے پر بخیل نہیں ہیں"
  },
  {
    "surah_id": 81,
    "ayah_number": 25,
    "global_ayah_id": 5905,
    "translation": "اور یہ  (  «<a href=470> قرآن </a>» )  شیطان مردود کا قول نہیں ہے"
  },
  {
    "surah_id": 81,
    "ayah_number": 26,
    "global_ayah_id": 5906,
    "translation": "سو تم کہاں جا رہے ہو ؟"
  },
  {
    "surah_id": 81,
    "ayah_number": 27,
    "global_ayah_id": 5907,
    "translation": "بیشک وہ تمام جہان والوں کے لیے «<a href=622> نصیحت </a>» ہے"
  },
  {
    "surah_id": 81,
    "ayah_number": 28,
    "global_ayah_id": 5908,
    "translation": "تم میں سے ہر اس شخص کے لیے جو «<a href=408> سیدھا </a>» «<a href=261> چلنا </a>» چاہے"
  },
  {
    "surah_id": 81,
    "ayah_number": 29,
    "global_ayah_id": 5909,
    "translation": "اور تم صرف وہی چاہتے ہو جس کو اللہ رب العلمین چاہتا ہے"
  }
]