[
  {
    "surah_id": 81,
    "ayah_number": 0,
    "global_ayah_id": 5880,
    "translation": "اللہ کے «<a href=614> نام </a>» سے جو بےانتہا «<a href=600> مہربان </a>» اور رحم فرمانے والا ہے"
  },
  {
    "surah_id": 81,
    "ayah_number": 1,
    "global_ayah_id": 5881,
    "translation": "جب سورج لپیٹ دیا جائے گا"
  },
  {
    "surah_id": 81,
    "ayah_number": 2,
    "global_ayah_id": 5882,
    "translation": "اور جب تارے بکھر جائیں گے"
  },
  {
    "surah_id": 81,
    "ayah_number": 3,
    "global_ayah_id": 5883,
    "translation": "اور جب «<a href=160> پہاڑ </a>» چلائے جائیں گے"
  },
  {
    "surah_id": 81,
    "ayah_number": 4,
    "global_ayah_id": 5884,
    "translation": "اور جب دس «<a href=604> مہینے </a>» کی حاملہ اونٹنیاں اپنے حال پر چھوڑ دی جائیں گی"
  },
  {
    "surah_id": 81,
    "ayah_number": 5,
    "global_ayah_id": 5885,
    "translation": "اور جب جنگلی جانور سمیٹ کر اکٹھے کردیے جائیں گے"
  },
  {
    "surah_id": 81,
    "ayah_number": 6,
    "global_ayah_id": 5886,
    "translation": "اور جب سمندر بھرکا دیے جائیں گے"
  },
  {
    "surah_id": 81,
    "ayah_number": 7,
    "global_ayah_id": 5887,
    "translation": "اور جب جانیں (جسموں سے) جوڑ دی جائیں گی"
  },
  {
    "surah_id": 81,
    "ayah_number": 8,
    "global_ayah_id": 5888,
    "translation": "اور جب «<a href=381> زندہ </a>» گاڑی ہوئی لڑکی سے پوچھا جائے گا"
  },
  {
    "surah_id": 81,
    "ayah_number": 9,
    "global_ayah_id": 5889,
    "translation": "کہ وہ کسی قصور میں ماری گئی ؟"
  },
  {
    "surah_id": 81,
    "ayah_number": 10,
    "global_ayah_id": 5890,
    "translation": "اور جب «<a href=42> اعمال </a>» نامے کھولے جائیں گے"
  },
  {
    "surah_id": 81,
    "ayah_number": 11,
    "global_ayah_id": 5891,
    "translation": "اور جب «<a href=10> آسمان </a>» کا «<a href=150> پردہ </a>» ہٹا دیا جائے گا"
  },
  {
    "surah_id": 81,
    "ayah_number": 12,
    "global_ayah_id": 5892,
    "translation": "اور جب جہنم دہکائی جائے گی"
  },
  {
    "surah_id": 81,
    "ayah_number": 13,
    "global_ayah_id": 5893,
    "translation": "اور جب «<a href=237> جنت </a>» قریب لے آئی جائے گی"
  },
  {
    "surah_id": 81,
    "ayah_number": 14,
    "global_ayah_id": 5894,
    "translation": "اس «<a href=639> وقت </a>» ہر شخص کو معلوم ہوجائے گا کہ وہ کیا لے کر آیا ہے"
  },
  {
    "surah_id": 81,
    "ayah_number": 15,
    "global_ayah_id": 5895,
    "translation": "پس نہیں ، میں «<a href=472> قسم </a>» کھاتا ہوں پلٹنے والے"
  },
  {
    "surah_id": 81,
    "ayah_number": 16,
    "global_ayah_id": 5896,
    "translation": "اور چھپ جانے والے تاروں کی"
  },
  {
    "surah_id": 81,
    "ayah_number": 17,
    "global_ayah_id": 5897,
    "translation": "اور «<a href=356> رات </a>» کی جبکہ وہ تاریک ہوئی"
  },
  {
    "surah_id": 81,
    "ayah_number": 18,
    "global_ayah_id": 5898,
    "translation": "اور صبح کی جبکہ اس نے سانس لیا"
  },
  {
    "surah_id": 81,
    "ayah_number": 19,
    "global_ayah_id": 5899,
    "translation": "یہ فی الواقع ایک «<a href=101> بزرگ </a>» «<a href=183> پیغمبر </a>» کا قول ہے"
  },
  {
    "surah_id": 81,
    "ayah_number": 20,
    "global_ayah_id": 5900,
    "translation": "جو بڑی توانائی رکھتا ہے ، عرش والے کے ہاں «<a href=106> بلند </a>» مرتبہ ہے"
  },
  {
    "surah_id": 81,
    "ayah_number": 21,
    "global_ayah_id": 5901,
    "translation": "وہاں اس کا «<a href=288> حکم </a>» مانا جاتا ہے ، وہ بااعتماد ہے"
  },
  {
    "surah_id": 81,
    "ayah_number": 22,
    "global_ayah_id": 5902,
    "translation": "اور (اے اہل مکہ) تمہارا رفیق مجنون نہیں ہے"
  },
  {
    "surah_id": 81,
    "ayah_number": 23,
    "global_ayah_id": 5903,
    "translation": "اس نے اس «<a href=183> پیغمبر </a>» کو روشن افق پر دیکھا ہے"
  },
  {
    "surah_id": 81,
    "ayah_number": 24,
    "global_ayah_id": 5904,
    "translation": "اور وہ غیب (کے اس علم کو لوگوں تک پہنچانے) کے معاملہ میں بخیل نہیں ہے"
  },
  {
    "surah_id": 81,
    "ayah_number": 25,
    "global_ayah_id": 5905,
    "translation": "اور یہ کسی شیطان مردود کا قول نہیں ہے"
  },
  {
    "surah_id": 81,
    "ayah_number": 26,
    "global_ayah_id": 5906,
    "translation": "پھر تم لوگ کدھر چلے جارہے ہو ؟"
  },
  {
    "surah_id": 81,
    "ayah_number": 27,
    "global_ayah_id": 5907,
    "translation": "یہ تو سارے جہان والوں کے لیے ایک «<a href=622> نصیحت </a>» ہے"
  },
  {
    "surah_id": 81,
    "ayah_number": 28,
    "global_ayah_id": 5908,
    "translation": "تم میں سے ہر اس شخص کے لیے جو راہ راست پر «<a href=261> چلنا </a>» چاہتا ہو"
  },
  {
    "surah_id": 81,
    "ayah_number": 29,
    "global_ayah_id": 5909,
    "translation": "اور تمہارے چاہنے سے کچھ نہیں ہوتا جب تک اللہ رب العالمین نہ چاہے"
  }
]