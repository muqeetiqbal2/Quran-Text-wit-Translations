[
  {
    "surah_id": 81,
    "ayah_number": 1,
    "global_ayah_id": 5801,
    "translation": "เมื่อดวงอาทิตย์ถูกม้วนดับแสงลง"
  },
  {
    "surah_id": 81,
    "ayah_number": 2,
    "global_ayah_id": 5802,
    "translation": "และเมื่อบรรดาดวงดาวร่วงหล่นลงมากระจัดกระจาย"
  },
  {
    "surah_id": 81,
    "ayah_number": 3,
    "global_ayah_id": 5803,
    "translation": "และเมื่อบรรดาภูเขาถูกเคลื่อนย้าย"
  },
  {
    "surah_id": 81,
    "ayah_number": 4,
    "global_ayah_id": 5804,
    "translation": "และเมื่ออูฐท้องสิบเดือนถูกทอดทิ้ง"
  },
  {
    "surah_id": 81,
    "ayah_number": 5,
    "global_ayah_id": 5805,
    "translation": "และเมื่อสัตว์ถูกนำมารวมกัน"
  },
  {
    "surah_id": 81,
    "ayah_number": 6,
    "global_ayah_id": 5806,
    "translation": "และเมื่อทะเลลุกเป็นไฟ"
  },
  {
    "surah_id": 81,
    "ayah_number": 7,
    "global_ayah_id": 5807,
    "translation": "และเมื่อชีวิตทั้งหลายถูกจัดเป็นคู่"
  },
  {
    "surah_id": 81,
    "ayah_number": 8,
    "global_ayah_id": 5808,
    "translation": "และเมื่อทารกหญิงที่ถูกฝังทั้งเป็นถูกถาม"
  },
  {
    "surah_id": 81,
    "ayah_number": 9,
    "global_ayah_id": 5809,
    "translation": "ด้วยความผิดอันใดเขาจงถูกฆ่า"
  },
  {
    "surah_id": 81,
    "ayah_number": 10,
    "global_ayah_id": 5810,
    "translation": "และเมื่อบันทึกทั้งหลายถูกกางแผ่"
  },
  {
    "surah_id": 81,
    "ayah_number": 11,
    "global_ayah_id": 5811,
    "translation": "และเมื่อชั้นฟ้าถูกเลิกออก"
  },
  {
    "surah_id": 81,
    "ayah_number": 12,
    "global_ayah_id": 5812,
    "translation": "และเมื่อนรกถูกจุดให้ลุกสว่างจ้า"
  },
  {
    "surah_id": 81,
    "ayah_number": 13,
    "global_ayah_id": 5813,
    "translation": "และเมื่อสวรรค์ถูกนำมาใกล้"
  },
  {
    "surah_id": 81,
    "ayah_number": 14,
    "global_ayah_id": 5814,
    "translation": "ทุกชีวิตย่อมรู้สิ่งที่ตนได้นำมา"
  },
  {
    "surah_id": 81,
    "ayah_number": 15,
    "global_ayah_id": 5815,
    "translation": "ข้าสาบานต่อดวงดาวที่ซ่อนตัวในเวลากลางวัน"
  },
  {
    "surah_id": 81,
    "ayah_number": 16,
    "global_ayah_id": 5816,
    "translation": "ที่โคจรลับดวง"
  },
  {
    "surah_id": 81,
    "ayah_number": 17,
    "global_ayah_id": 5817,
    "translation": "ข้าสาบานด้วยกลางคืนเมื่อมันเหือดหายไป"
  },
  {
    "surah_id": 81,
    "ayah_number": 18,
    "global_ayah_id": 5818,
    "translation": "และด้วยเวลาเช้าตรู่เมื่อมันทอแสง"
  },
  {
    "surah_id": 81,
    "ayah_number": 19,
    "global_ayah_id": 5819,
    "translation": "แท้จริง อัลกุรอานคือคำพูดของร่อซูล (ญิบริล) ผู้ทรงเกียรติ"
  },
  {
    "surah_id": 81,
    "ayah_number": 20,
    "global_ayah_id": 5820,
    "translation": "ผู้ทรงพลัง ผู้ทรงตำแหน่งสูง ณ พระเจ้าแห่งบัลลังก์"
  },
  {
    "surah_id": 81,
    "ayah_number": 21,
    "global_ayah_id": 5821,
    "translation": "ผู้ใดรับการจงรักภักดี ผู้ซื่อสัตย์ ณ ที่โน้น"
  },
  {
    "surah_id": 81,
    "ayah_number": 22,
    "global_ayah_id": 5822,
    "translation": "และสหาย (มุฮัมมัด) ของพวกเจ้านั้นมิใช่เป็นคนวิกลจริตแต่ประการใด"
  },
  {
    "surah_id": 81,
    "ayah_number": 23,
    "global_ayah_id": 5823,
    "translation": "และโดยแน่นอนเขา (มุฮัมมัด) ได้เห็นเขา (ญิบริล) ณ ขอบฟ้าอย่างชัดแจ้ง"
  },
  {
    "surah_id": 81,
    "ayah_number": 24,
    "global_ayah_id": 5824,
    "translation": "และเขา (มุฮัมมัด) มิใช่เป็นผู้ตระหนี่ในเรื่องเร้นลับ"
  },
  {
    "surah_id": 81,
    "ayah_number": 25,
    "global_ayah_id": 5825,
    "translation": "และอัลกุรอานนี้มิใช่คำกล่าวของชัยฏอนที่ถูกสาปแช่ง"
  },
  {
    "surah_id": 81,
    "ayah_number": 26,
    "global_ayah_id": 5826,
    "translation": "แล้วพวกเจ้าจะไปทางไหนเล่า"
  },
  {
    "surah_id": 81,
    "ayah_number": 27,
    "global_ayah_id": 5827,
    "translation": "อัลกุรอานนั้นมิใช่อื่นใด นอกจากเป็นข้อตักเตือนแก่ประชาชาติทั้งมวล"
  },
  {
    "surah_id": 81,
    "ayah_number": 28,
    "global_ayah_id": 5828,
    "translation": "สำหรับบุคคลในหมู่พวกเจ้าที่ประสงค์อยู่ในทางอันเที่ยงตรง"
  },
  {
    "surah_id": 81,
    "ayah_number": 29,
    "global_ayah_id": 5829,
    "translation": "และพวกเจ้าจะไม่สมประสงค์สิ่งใดเว้นแต่อัลลอฮฺพระเจ้าแห่งสากลโลกจะทรงประสงค์"
  }
]