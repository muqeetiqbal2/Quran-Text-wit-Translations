[
  {
    "surah_id": 81,
    "ayah_number": 1,
    "global_ayah_id": 5801,
    "translation": "Чун хуршед бефурӯғ (хира) шавад"
  },
  {
    "surah_id": 81,
    "ayah_number": 2,
    "global_ayah_id": 5802,
    "translation": "ва чун ситорагон фурӯ резанд"
  },
  {
    "surah_id": 81,
    "ayah_number": 3,
    "global_ayah_id": 5803,
    "translation": "ва чун кӯҳҳо аз ҷои худ беҷо бишаванд"
  },
  {
    "surah_id": 81,
    "ayah_number": 4,
    "global_ayah_id": 5804,
    "translation": "ва чун шутурони ҳомила ба ҳоли худ гузошта шаванд"
  },
  {
    "surah_id": 81,
    "ayah_number": 5,
    "global_ayah_id": 5805,
    "translation": "ва чун ҷонварони ваҳшӣ ҷамъ оварда шаванд,"
  },
  {
    "surah_id": 81,
    "ayah_number": 6,
    "global_ayah_id": 5806,
    "translation": "ва чун дарёҳо оташ гиранд"
  },
  {
    "surah_id": 81,
    "ayah_number": 7,
    "global_ayah_id": 5807,
    "translation": "ва чун рӯҳҳо бо танҳо якҷоя гардганд!"
  },
  {
    "surah_id": 81,
    "ayah_number": 8,
    "global_ayah_id": 5808,
    "translation": "ва чун аз духтари зинда ба гӯр шуда пурсида шавад, ки"
  },
  {
    "surah_id": 81,
    "ayah_number": 9,
    "global_ayah_id": 5809,
    "translation": "ба чӣ гуноҳе кушта шудааст"
  },
  {
    "surah_id": 81,
    "ayah_number": 10,
    "global_ayah_id": 5810,
    "translation": "ва чун саҳифаҳо боз шаванд,"
  },
  {
    "surah_id": 81,
    "ayah_number": 11,
    "global_ayah_id": 5811,
    "translation": "ва чун осмон аз ҷои худ канда шавад'"
  },
  {
    "surah_id": 81,
    "ayah_number": 12,
    "global_ayah_id": 5812,
    "translation": "ва чун ҷаҳаннам афрӯхта гардад"
  },
  {
    "surah_id": 81,
    "ayah_number": 13,
    "global_ayah_id": 5813,
    "translation": "ва чун биҳиштро пеш оваранд,"
  },
  {
    "surah_id": 81,
    "ayah_number": 14,
    "global_ayah_id": 5814,
    "translation": "ҳар кас бидонад, ки чӣ ҳозир овардааст."
  },
  {
    "surah_id": 81,
    "ayah_number": 15,
    "global_ayah_id": 5815,
    "translation": "Савганд ба ситорагони бозгарданда,"
  },
  {
    "surah_id": 81,
    "ayah_number": 16,
    "global_ayah_id": 5816,
    "translation": "сайркунандаи ғойбшаванда"
  },
  {
    "surah_id": 81,
    "ayah_number": 17,
    "global_ayah_id": 5817,
    "translation": "ва савганд ба шаб, чун торик шавад"
  },
  {
    "surah_id": 81,
    "ayah_number": 18,
    "global_ayah_id": 5818,
    "translation": "ва савганд ба субҳ чун бидамад,"
  },
  {
    "surah_id": 81,
    "ayah_number": 19,
    "global_ayah_id": 5819,
    "translation": "ки ин сухани расуле бузургвор (Ҷибрил (а)) аст,"
  },
  {
    "surah_id": 81,
    "ayah_number": 20,
    "global_ayah_id": 5820,
    "translation": "нерӯманд, дар назди Худованди арш соҳибобрӯ"
  },
  {
    "surah_id": 81,
    "ayah_number": 21,
    "global_ayah_id": 5821,
    "translation": "он ҷо (дар назди Худо) фармонравои боваринокаст"
  },
  {
    "surah_id": 81,
    "ayah_number": 22,
    "global_ayah_id": 5822,
    "translation": "Ва ҳамсӯҳбати шумо девона нест."
  },
  {
    "surah_id": 81,
    "ayah_number": 23,
    "global_ayah_id": 5823,
    "translation": "Албатта Ӯро (Ҷибрилро) дар уфуқи равшан дидааст"
  },
  {
    "surah_id": 81,
    "ayah_number": 24,
    "global_ayah_id": 5824,
    "translation": "Ва он чиро аз ғайб ба ӯ гӯянд, дареғ намедорад."
  },
  {
    "surah_id": 81,
    "ayah_number": 25,
    "global_ayah_id": 5825,
    "translation": "Ва он сухан сухани шайтони раҷим нест."
  },
  {
    "surah_id": 81,
    "ayah_number": 26,
    "global_ayah_id": 5826,
    "translation": "Пас ба куҷо меравед?"
  },
  {
    "surah_id": 81,
    "ayah_number": 27,
    "global_ayah_id": 5827,
    "translation": "Ин китоб пандест барои ҷаҳониён,"
  },
  {
    "surah_id": 81,
    "ayah_number": 28,
    "global_ayah_id": 5828,
    "translation": "барои ҳар кас аз шумо, ки бихоҳад ба роҳи рост афтад."
  },
  {
    "surah_id": 81,
    "ayah_number": 29,
    "global_ayah_id": 5829,
    "translation": "Ва шумо намехоҳед, ғайри он чиро, ки Парвардигори ҷаҳониён хоста бошад."
  }
]