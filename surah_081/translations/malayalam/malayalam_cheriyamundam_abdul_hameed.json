[
  {
    "surah_id": 81,
    "ayah_number": 1,
    "global_ayah_id": 5801,
    "translation": "സൂര്യന്‍ ചുറ്റിപ്പൊതിയപ്പെടുമ്പോള്‍,"
  },
  {
    "surah_id": 81,
    "ayah_number": 2,
    "global_ayah_id": 5802,
    "translation": "നക്ഷത്രങ്ങള്‍ ഉതിര്‍ന്നു വീഴുമ്പോള്‍,"
  },
  {
    "surah_id": 81,
    "ayah_number": 3,
    "global_ayah_id": 5803,
    "translation": "പര്‍വ്വതങ്ങള്‍ സഞ്ചരിപ്പിക്കപ്പെടുമ്പോള്‍,"
  },
  {
    "surah_id": 81,
    "ayah_number": 4,
    "global_ayah_id": 5804,
    "translation": "പൂര്‍ണ്ണഗര്‍ഭിണികളായ ഒട്ടകങ്ങള്‍ അവഗണിക്കപ്പെടുമ്പോള്‍,"
  },
  {
    "surah_id": 81,
    "ayah_number": 5,
    "global_ayah_id": 5805,
    "translation": "വന്യമൃഗങ്ങള്‍ ഒരുമിച്ചുകൂട്ടപ്പെടുമ്പോള്‍,"
  },
  {
    "surah_id": 81,
    "ayah_number": 6,
    "global_ayah_id": 5806,
    "translation": "സമുദ്രങ്ങള്‍ ആളിക്കത്തിക്കപ്പെടുമ്പോള്‍,"
  },
  {
    "surah_id": 81,
    "ayah_number": 7,
    "global_ayah_id": 5807,
    "translation": "ആത്മാവുകള്‍ കൂട്ടിയിണക്കപ്പെടുമ്പോള്‍,"
  },
  {
    "surah_id": 81,
    "ayah_number": 8,
    "global_ayah_id": 5808,
    "translation": "(ജീവനോടെ) കുഴിച്ചു മൂടപ്പെട്ട പെണ്‍കുട്ടിയോടു ചോദിക്കപ്പെടുമ്പോള്‍,"
  },
  {
    "surah_id": 81,
    "ayah_number": 9,
    "global_ayah_id": 5809,
    "translation": "താന്‍ എന്തൊരു കുറ്റത്തിനാണ് കൊല്ലപ്പെട്ടത് എന്ന്‌."
  },
  {
    "surah_id": 81,
    "ayah_number": 10,
    "global_ayah_id": 5810,
    "translation": "(കര്‍മ്മങ്ങള്‍ രേഖപ്പെടുത്തിയ) ഏടുകള്‍ തുറന്നുവെക്കപ്പെടുമ്പോള്‍."
  },
  {
    "surah_id": 81,
    "ayah_number": 11,
    "global_ayah_id": 5811,
    "translation": "ഉപരിലോകം മറ നീക്കികാണിക്കപ്പെടുമ്പോള്‍"
  },
  {
    "surah_id": 81,
    "ayah_number": 12,
    "global_ayah_id": 5812,
    "translation": "ജ്വലിക്കുന്ന നരകാഗ്നി ആളിക്കത്തിക്കപ്പെടുമ്പോള്‍."
  },
  {
    "surah_id": 81,
    "ayah_number": 13,
    "global_ayah_id": 5813,
    "translation": "സ്വര്‍ഗം അടുത്തു കൊണ്ടുവരപ്പെടുമ്പോള്‍."
  },
  {
    "surah_id": 81,
    "ayah_number": 14,
    "global_ayah_id": 5814,
    "translation": "ഓരോ വ്യക്തിയും താന്‍ തയ്യാറാക്കിക്കൊണ്ടു വന്നിട്ടുള്ളത് എന്തെന്ന് അറിയുന്നതാണ്‌."
  },
  {
    "surah_id": 81,
    "ayah_number": 15,
    "global_ayah_id": 5815,
    "translation": "പിന്‍വാങ്ങിപ്പോകുന്നവയെ (നക്ഷത്രങ്ങളെ) ക്കൊണ്ട് ഞാന്‍ സത്യം ചെയ്തു പറയുന്നു."
  },
  {
    "surah_id": 81,
    "ayah_number": 16,
    "global_ayah_id": 5816,
    "translation": "സഞ്ചരിച്ചുകൊണ്ടിരിക്കുന്നവയും അപ്രത്യക്ഷമായിക്കൊണ്ടിരിക്കുന്നവയും"
  },
  {
    "surah_id": 81,
    "ayah_number": 17,
    "global_ayah_id": 5817,
    "translation": "രാത്രി നീങ്ങുമ്പോള്‍ അതു കൊണ്ടും,"
  },
  {
    "surah_id": 81,
    "ayah_number": 18,
    "global_ayah_id": 5818,
    "translation": "പ്രഭാതം വിടര്‍ന്ന് വരുമ്പോള്‍ അതു കൊണ്ടും (ഞാന്‍ സത്യം ചെയ്തു പറയുന്നു.)"
  },
  {
    "surah_id": 81,
    "ayah_number": 19,
    "global_ayah_id": 5819,
    "translation": "തീര്‍ച്ചയായും ഇത് (ഖുര്‍ആന്‍) മാന്യനായ ഒരു ദൂതന്‍റെ വാക്കാകുന്നു."
  },
  {
    "surah_id": 81,
    "ayah_number": 20,
    "global_ayah_id": 5820,
    "translation": "ശക്തിയുള്ളവനും, സിംഹാസനസ്ഥനായ അല്ലാഹുവിങ്കല്‍ സ്ഥാനമുള്ളവനുമായ (ദൂതന്‍റെ)"
  },
  {
    "surah_id": 81,
    "ayah_number": 21,
    "global_ayah_id": 5821,
    "translation": "അവിടെ അനുസരിക്കപ്പെടുന്നവനും വിശ്വസ്തനുമായ (ദൂതന്‍റെ)"
  },
  {
    "surah_id": 81,
    "ayah_number": 22,
    "global_ayah_id": 5822,
    "translation": "നിങ്ങളുടെ കൂട്ടുകാരന്‍ (പ്രവാചകന്‍) ഒരു ഭ്രാന്തനല്ല തന്നെ,"
  },
  {
    "surah_id": 81,
    "ayah_number": 23,
    "global_ayah_id": 5823,
    "translation": "തീര്‍ച്ചയായും അദ്ദേഹത്തെ (ജിബ്‌രീല്‍ എന്ന ദൂതനെ) പ്രത്യക്ഷമായ മണ്ഡലത്തില്‍ വെച്ച് അദ്ദേഹം കണ്ടിട്ടുണ്ട്‌."
  },
  {
    "surah_id": 81,
    "ayah_number": 24,
    "global_ayah_id": 5824,
    "translation": "അദ്ദേഹം അദൃശ്യവാര്‍ത്തയുടെ കാര്യത്തില്‍ പിശുക്ക് കാണിക്കുന്നവനുമല്ല."
  },
  {
    "surah_id": 81,
    "ayah_number": 25,
    "global_ayah_id": 5825,
    "translation": "ഇത് (ഖുര്‍ആന്‍) ശപിക്കപ്പെട്ട ഒരു പിശാചിന്‍റെ വാക്കുമല്ല."
  },
  {
    "surah_id": 81,
    "ayah_number": 26,
    "global_ayah_id": 5826,
    "translation": "അപ്പോള്‍ എങ്ങോട്ടാണ് നിങ്ങള്‍ പോകുന്നത്‌?"
  },
  {
    "surah_id": 81,
    "ayah_number": 27,
    "global_ayah_id": 5827,
    "translation": "ഇത് ലോകര്‍ക്ക് വേണ്ടിയുള്ള ഒരു ഉല്‍ബോധനമല്ലാതെ മറ്റൊന്നുമല്ല."
  },
  {
    "surah_id": 81,
    "ayah_number": 28,
    "global_ayah_id": 5828,
    "translation": "അതായത് നിങ്ങളുടെ കൂട്ടത്തില്‍ നിന്ന് നേരെ നിലകൊള്ളാന്‍ ഉദ്ദേശിച്ചവര്‍ക്ക് വേണ്ടി."
  },
  {
    "surah_id": 81,
    "ayah_number": 29,
    "global_ayah_id": 5829,
    "translation": "ലോകരക്ഷിതാവായ അല്ലാഹു ഉദ്ദേശിക്കുന്നുവെങ്കിലല്ലാതെ നിങ്ങള്‍ ഉദ്ദേശിക്കുകയില്ല."
  }
]