[
  {
    "surah_id": 81,
    "ayah_number": 1,
    "global_ayah_id": 5801,
    "translation": "जिस वक्त आफ़ताब की चादर को लपेट लिया जाएगा"
  },
  {
    "surah_id": 81,
    "ayah_number": 2,
    "global_ayah_id": 5802,
    "translation": "और जिस वक्त तारे गिर पडेग़ें"
  },
  {
    "surah_id": 81,
    "ayah_number": 3,
    "global_ayah_id": 5803,
    "translation": "और जब पहाड़ चलाए जाएंगें"
  },
  {
    "surah_id": 81,
    "ayah_number": 4,
    "global_ayah_id": 5804,
    "translation": "और जब अनक़रीब जनने वाली ऊंटनियों बेकार कर दी जाएंगी"
  },
  {
    "surah_id": 81,
    "ayah_number": 5,
    "global_ayah_id": 5805,
    "translation": "और जिस वक्त वहशी जानवर इकट्ठा किये जायेंगे"
  },
  {
    "surah_id": 81,
    "ayah_number": 6,
    "global_ayah_id": 5806,
    "translation": "और जिस वक्त दरिया आग हो जायेंगे"
  },
  {
    "surah_id": 81,
    "ayah_number": 7,
    "global_ayah_id": 5807,
    "translation": "और जिस वक्त रुहें हवियों से मिला दी जाएंगी"
  },
  {
    "surah_id": 81,
    "ayah_number": 8,
    "global_ayah_id": 5808,
    "translation": "और जिस वक्त ज़िन्दा दर गोर लड़की से पूछा जाएगा"
  },
  {
    "surah_id": 81,
    "ayah_number": 9,
    "global_ayah_id": 5809,
    "translation": "कि वह किस गुनाह के बदले मारी गयी"
  },
  {
    "surah_id": 81,
    "ayah_number": 10,
    "global_ayah_id": 5810,
    "translation": "और जिस वक्त (आमाल के) दफ्तर खोले जाएं"
  },
  {
    "surah_id": 81,
    "ayah_number": 11,
    "global_ayah_id": 5811,
    "translation": "और जिस वक्त आसमान का छिलका उतारा जाएगा"
  },
  {
    "surah_id": 81,
    "ayah_number": 12,
    "global_ayah_id": 5812,
    "translation": "और जब दोज़ख़ (की आग) भड़कायी जाएगी"
  },
  {
    "surah_id": 81,
    "ayah_number": 13,
    "global_ayah_id": 5813,
    "translation": "और जब बेहिश्त क़रीब कर दी जाएगी"
  },
  {
    "surah_id": 81,
    "ayah_number": 14,
    "global_ayah_id": 5814,
    "translation": "तब हर शख़्श मालूम करेगा कि वह क्या (आमाल) लेकर आया"
  },
  {
    "surah_id": 81,
    "ayah_number": 15,
    "global_ayah_id": 5815,
    "translation": "तो मुझे उन सितारों की क़सम जो चलते चलते पीछे हट जाते"
  },
  {
    "surah_id": 81,
    "ayah_number": 16,
    "global_ayah_id": 5816,
    "translation": "और ग़ायब होते हैं"
  },
  {
    "surah_id": 81,
    "ayah_number": 17,
    "global_ayah_id": 5817,
    "translation": "और रात की क़सम जब ख़त्म होने को आए"
  },
  {
    "surah_id": 81,
    "ayah_number": 18,
    "global_ayah_id": 5818,
    "translation": "और सुबह की क़सम जब रौशन हो जाए"
  },
  {
    "surah_id": 81,
    "ayah_number": 19,
    "global_ayah_id": 5819,
    "translation": "कि बेशक यें (क़ुरान) एक मुअज़िज़ फरिश्ता (जिबरील की ज़बान का पैग़ाम है"
  },
  {
    "surah_id": 81,
    "ayah_number": 20,
    "global_ayah_id": 5820,
    "translation": "जो बड़े क़वी अर्श के मालिक की बारगाह में बुलन्द रुतबा है"
  },
  {
    "surah_id": 81,
    "ayah_number": 21,
    "global_ayah_id": 5821,
    "translation": "वहाँ (सब फरिश्तों का) सरदार अमानतदार है"
  },
  {
    "surah_id": 81,
    "ayah_number": 22,
    "global_ayah_id": 5822,
    "translation": "और (मक्के वालों) तुम्हारे साथी मोहम्मद दीवाने नहीं हैं"
  },
  {
    "surah_id": 81,
    "ayah_number": 23,
    "global_ayah_id": 5823,
    "translation": "और बेशक उन्होनें जिबरील को (आसमान के) खुले (शरक़ी) किनारे पर देखा है"
  },
  {
    "surah_id": 81,
    "ayah_number": 24,
    "global_ayah_id": 5824,
    "translation": "और वह ग़ैब की बातों के ज़ाहिर करने में बख़ील नहीं"
  },
  {
    "surah_id": 81,
    "ayah_number": 25,
    "global_ayah_id": 5825,
    "translation": "और न यह मरदूद शैतान का क़ौल है"
  },
  {
    "surah_id": 81,
    "ayah_number": 26,
    "global_ayah_id": 5826,
    "translation": "फिर तुम कहाँ जाते हो"
  },
  {
    "surah_id": 81,
    "ayah_number": 27,
    "global_ayah_id": 5827,
    "translation": "ये सारे जहॉन के लोगों के लिए बस नसीहत है"
  },
  {
    "surah_id": 81,
    "ayah_number": 28,
    "global_ayah_id": 5828,
    "translation": "(मगर) उसी के लिए जो तुममें सीधी राह चले"
  },
  {
    "surah_id": 81,
    "ayah_number": 29,
    "global_ayah_id": 5829,
    "translation": "और तुम तो सारे जहॉन के पालने वाले ख़ुदा के चाहे बग़ैर कुछ भी चाह नहीं सकते"
  }
]