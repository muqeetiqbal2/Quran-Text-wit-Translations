[
  {
    "surah_id": 81,
    "ayah_number": 0,
    "global_ayah_id": 5880,
    "translation": "अल्लाह के नाम से जो बड़ा कृपालु और अत्यन्त दयावान है।"
  },
  {
    "surah_id": 81,
    "ayah_number": 1,
    "global_ayah_id": 5881,
    "translation": "जब सूर्य लपेट दिया जाएगा,"
  },
  {
    "surah_id": 81,
    "ayah_number": 2,
    "global_ayah_id": 5882,
    "translation": "सारे तारे मैले हो जाएँगे,"
  },
  {
    "surah_id": 81,
    "ayah_number": 3,
    "global_ayah_id": 5883,
    "translation": "जब पहाड़ चलाए जाएँगे,"
  },
  {
    "surah_id": 81,
    "ayah_number": 4,
    "global_ayah_id": 5884,
    "translation": "जब दस मास की गाभिन ऊँटनियाँ आज़ाद छोड़ दी जाएँगी,"
  },
  {
    "surah_id": 81,
    "ayah_number": 5,
    "global_ayah_id": 5885,
    "translation": "जब जंगली जानवर एकत्र किए जाएँगे,"
  },
  {
    "surah_id": 81,
    "ayah_number": 6,
    "global_ayah_id": 5886,
    "translation": "जब समुद्र भड़का दिया जाएँगे,"
  },
  {
    "surah_id": 81,
    "ayah_number": 7,
    "global_ayah_id": 5887,
    "translation": "जब लोग क़िस्म-क़िस्म कर दिए जाएँगे,"
  },
  {
    "surah_id": 81,
    "ayah_number": 8,
    "global_ayah_id": 5888,
    "translation": "और जब जीवित गाड़ी गई लड़की से पूछा जाएगा,"
  },
  {
    "surah_id": 81,
    "ayah_number": 9,
    "global_ayah_id": 5889,
    "translation": "कि उस की हत्या किस गुनाह के कारण की गई,"
  },
  {
    "surah_id": 81,
    "ayah_number": 10,
    "global_ayah_id": 5890,
    "translation": "और जब कर्म-पत्र फैला दिए जाएँगे,"
  },
  {
    "surah_id": 81,
    "ayah_number": 11,
    "global_ayah_id": 5891,
    "translation": "और जब आकाश की खाल उतार दी जाएगी,"
  },
  {
    "surah_id": 81,
    "ayah_number": 12,
    "global_ayah_id": 5892,
    "translation": "जब जहन्नम को दहकाया जाएगा,"
  },
  {
    "surah_id": 81,
    "ayah_number": 13,
    "global_ayah_id": 5893,
    "translation": "और जब जन्नत निकट कर दी जाएगी,"
  },
  {
    "surah_id": 81,
    "ayah_number": 14,
    "global_ayah_id": 5894,
    "translation": "तो कोई भी व्यक्ति जान लेगा कि उस ने क्या उपस्थित किया है"
  },
  {
    "surah_id": 81,
    "ayah_number": 15,
    "global_ayah_id": 5895,
    "translation": "अतः नहीं! मैं क़सम खाता हूँ पीछे हटने वालों की,"
  },
  {
    "surah_id": 81,
    "ayah_number": 16,
    "global_ayah_id": 5896,
    "translation": "चलने वालों, छिपने-दुबकने-वालों की"
  },
  {
    "surah_id": 81,
    "ayah_number": 17,
    "global_ayah_id": 5897,
    "translation": "साक्षी है रात्रि जब वह प्रस्थान करे,"
  },
  {
    "surah_id": 81,
    "ayah_number": 18,
    "global_ayah_id": 5898,
    "translation": "और साक्षी है प्रातः जब वह साँस ले"
  },
  {
    "surah_id": 81,
    "ayah_number": 19,
    "global_ayah_id": 5899,
    "translation": "निश्चय ही वह एक आदरणीय संदेशवाहक की लाई हुई वाणी है,"
  },
  {
    "surah_id": 81,
    "ayah_number": 20,
    "global_ayah_id": 5900,
    "translation": "जो शक्ति वाला है, सिंहासन वाले के यहाँ जिस की पैठ है"
  },
  {
    "surah_id": 81,
    "ayah_number": 21,
    "global_ayah_id": 5901,
    "translation": "उस का आदेश माना जाता है, वहाँ वह विश्वासपात्र है"
  },
  {
    "surah_id": 81,
    "ayah_number": 22,
    "global_ayah_id": 5902,
    "translation": "तुम्हारा साथी कोई दीवाना नहीं,"
  },
  {
    "surah_id": 81,
    "ayah_number": 23,
    "global_ayah_id": 5903,
    "translation": "उस ने तो (पराकाष्ठान के) प्रत्यक्ष क्षितिज पर होकर उस (फ़रिश्ते) को देखा है"
  },
  {
    "surah_id": 81,
    "ayah_number": 24,
    "global_ayah_id": 5904,
    "translation": "और वह परोक्ष के मामले में कृपण नहीं है,"
  },
  {
    "surah_id": 81,
    "ayah_number": 25,
    "global_ayah_id": 5905,
    "translation": "और वह (क़ुरआन) किसी धुतकारे हुए शैतान की लाई हुई वाणी नहीं है"
  },
  {
    "surah_id": 81,
    "ayah_number": 26,
    "global_ayah_id": 5906,
    "translation": "फिर तुम किधर जा रहे हो?"
  },
  {
    "surah_id": 81,
    "ayah_number": 27,
    "global_ayah_id": 5907,
    "translation": "वह तो सारे संसार के लिए बस एक अनुस्मृति है,"
  },
  {
    "surah_id": 81,
    "ayah_number": 28,
    "global_ayah_id": 5908,
    "translation": "उस के लिए तो तुम में से सीधे मार्ग पर चलना चाहे"
  },
  {
    "surah_id": 81,
    "ayah_number": 29,
    "global_ayah_id": 5909,
    "translation": "और तुम नहीं चाह सकते सिवाय इस के कि सारे जहान का रब अल्लाह चाहे"
  }
]