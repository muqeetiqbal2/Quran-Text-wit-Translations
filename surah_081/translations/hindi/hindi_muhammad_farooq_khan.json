[
  {
    "surah_id": 81,
    "ayah_number": 1,
    "global_ayah_id": 5801,
    "translation": "जब सूर्य लपेट दिया जाएगा,"
  },
  {
    "surah_id": 81,
    "ayah_number": 2,
    "global_ayah_id": 5802,
    "translation": "सारे तारे मैले हो जाएँगे,"
  },
  {
    "surah_id": 81,
    "ayah_number": 3,
    "global_ayah_id": 5803,
    "translation": "जब पहाड़ चलाए जाएँगे,"
  },
  {
    "surah_id": 81,
    "ayah_number": 4,
    "global_ayah_id": 5804,
    "translation": "जब दस मास की गाभिन ऊँटनियाँ आज़ाद छोड़ दी जाएँगी,"
  },
  {
    "surah_id": 81,
    "ayah_number": 5,
    "global_ayah_id": 5805,
    "translation": "जब जंगली जानवर एकत्र किए जाएँगे,"
  },
  {
    "surah_id": 81,
    "ayah_number": 6,
    "global_ayah_id": 5806,
    "translation": "जब समुद्र भड़का दिया जाएँगे,"
  },
  {
    "surah_id": 81,
    "ayah_number": 7,
    "global_ayah_id": 5807,
    "translation": "जब लोग क़िस्म-क़िस्म कर दिए जाएँगे,"
  },
  {
    "surah_id": 81,
    "ayah_number": 8,
    "global_ayah_id": 5808,
    "translation": "और जब जीवित गाड़ी गई लड़की से पूछा जाएगा,"
  },
  {
    "surah_id": 81,
    "ayah_number": 9,
    "global_ayah_id": 5809,
    "translation": "कि उसकी हत्या किस गुनाह के कारण की गई,"
  },
  {
    "surah_id": 81,
    "ayah_number": 10,
    "global_ayah_id": 5810,
    "translation": "और जब कर्म-पत्र फैला दिए जाएँगे,"
  },
  {
    "surah_id": 81,
    "ayah_number": 11,
    "global_ayah_id": 5811,
    "translation": "और जब आकाश की खाल उतार दी जाएगी,"
  },
  {
    "surah_id": 81,
    "ayah_number": 12,
    "global_ayah_id": 5812,
    "translation": "जब जहन्नम को दहकाया जाएगा,"
  },
  {
    "surah_id": 81,
    "ayah_number": 13,
    "global_ayah_id": 5813,
    "translation": "और जब जन्नत निकट कर दी जाएगी,"
  },
  {
    "surah_id": 81,
    "ayah_number": 14,
    "global_ayah_id": 5814,
    "translation": "तो कोई भी क्यक्ति जान लेगा कि उसने क्या उपस्थित किया है"
  },
  {
    "surah_id": 81,
    "ayah_number": 15,
    "global_ayah_id": 5815,
    "translation": "अतः नहीं! मैं क़सम खाता हूँ पीछे हटनेवालों की,"
  },
  {
    "surah_id": 81,
    "ayah_number": 16,
    "global_ayah_id": 5816,
    "translation": "चलनेवालों, छिपने-दुबकने-वालों की"
  },
  {
    "surah_id": 81,
    "ayah_number": 17,
    "global_ayah_id": 5817,
    "translation": "साक्षी है रात्रि जब वह प्रस्थान करे,"
  },
  {
    "surah_id": 81,
    "ayah_number": 18,
    "global_ayah_id": 5818,
    "translation": "और साक्षी है प्रातः जब वह साँस ले"
  },
  {
    "surah_id": 81,
    "ayah_number": 19,
    "global_ayah_id": 5819,
    "translation": "निश्चय ही वह एक आदरणीय संदेशवाहक की लाई हुई वाणी है,"
  },
  {
    "surah_id": 81,
    "ayah_number": 20,
    "global_ayah_id": 5820,
    "translation": "जो शक्तिवाला है, सिंहासनवाले के यहाँ जिसकी पैठ है"
  },
  {
    "surah_id": 81,
    "ayah_number": 21,
    "global_ayah_id": 5821,
    "translation": "उसका आदेश माना जाता है, वहाँ वह विश्वासपात्र है"
  },
  {
    "surah_id": 81,
    "ayah_number": 22,
    "global_ayah_id": 5822,
    "translation": "तुम्हारा साथी कोई दीवाना नहीं,"
  },
  {
    "surah_id": 81,
    "ayah_number": 23,
    "global_ayah_id": 5823,
    "translation": "उसने तो (पराकाष्ठान के) प्रत्यक्ष क्षितिज पर होकर उस (फ़रिश्ते) को देखा है"
  },
  {
    "surah_id": 81,
    "ayah_number": 24,
    "global_ayah_id": 5824,
    "translation": "और वह परोक्ष के मामले में कृपण नहीं है,"
  },
  {
    "surah_id": 81,
    "ayah_number": 25,
    "global_ayah_id": 5825,
    "translation": "और वह (क़ुरआन) किसी धुतकारे हुए शैतान की लाई हुई वाणी नहीं है"
  },
  {
    "surah_id": 81,
    "ayah_number": 26,
    "global_ayah_id": 5826,
    "translation": "फिर तुम किधर जा रहे हो?"
  },
  {
    "surah_id": 81,
    "ayah_number": 27,
    "global_ayah_id": 5827,
    "translation": "वह तो सारे संसार के लिए बस एक अनुस्मृति है,"
  },
  {
    "surah_id": 81,
    "ayah_number": 28,
    "global_ayah_id": 5828,
    "translation": "उसके लिए तो तुममे से सीधे मार्ग पर चलना चाहे"
  },
  {
    "surah_id": 81,
    "ayah_number": 29,
    "global_ayah_id": 5829,
    "translation": "और तुम नहीं चाह सकते सिवाय इसके कि सारे जहान का रब अल्लाह चाहे"
  }
]