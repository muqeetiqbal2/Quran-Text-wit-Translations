[
  {
    "surah_id": 81,
    "ayah_number": 1,
    "global_ayah_id": 5801,
    "translation": "Вақтики, қуёшни буклаб, ўралса."
  },
  {
    "surah_id": 81,
    "ayah_number": 2,
    "global_ayah_id": 5802,
    "translation": "Ва, вақтики, юлдузлар сочилиб кетса."
  },
  {
    "surah_id": 81,
    "ayah_number": 3,
    "global_ayah_id": 5803,
    "translation": "Ва, вақтики, тоғлар сайр қилдирилса."
  },
  {
    "surah_id": 81,
    "ayah_number": 4,
    "global_ayah_id": 5804,
    "translation": "Ва, вақтики, ҳомиласига ўн ой тўлган туялар қаровсиз қолса."
  },
  {
    "surah_id": 81,
    "ayah_number": 5,
    "global_ayah_id": 5805,
    "translation": "Ва, вақтики, ваҳший ҳайвонлар бир жойга тўпланса."
  },
  {
    "surah_id": 81,
    "ayah_number": 6,
    "global_ayah_id": 5806,
    "translation": "Ва, вақтики, денгизлар аланга олиб ёнса."
  },
  {
    "surah_id": 81,
    "ayah_number": 7,
    "global_ayah_id": 5807,
    "translation": "Ва вақтики, нафслар жуфтлаштирилса. (Яъни, руҳ танага қайтарилиб, икковлари бирлашсалар.)"
  },
  {
    "surah_id": 81,
    "ayah_number": 8,
    "global_ayah_id": 5808,
    "translation": "Ва вақтики, тириклай кўмилган қиздан сўралса."
  },
  {
    "surah_id": 81,
    "ayah_number": 9,
    "global_ayah_id": 5809,
    "translation": "У нима гуноҳ учун ўлдирилган?"
  },
  {
    "surah_id": 81,
    "ayah_number": 10,
    "global_ayah_id": 5810,
    "translation": "Ва, вақтики, саҳифалар нашр қилинса."
  },
  {
    "surah_id": 81,
    "ayah_number": 11,
    "global_ayah_id": 5811,
    "translation": "Ва, вақтики, осмон қўпорилса."
  },
  {
    "surah_id": 81,
    "ayah_number": 12,
    "global_ayah_id": 5812,
    "translation": "Ва, вақтики, жаҳаннам қиздирилса."
  },
  {
    "surah_id": 81,
    "ayah_number": 13,
    "global_ayah_id": 5813,
    "translation": "Ва, вақтики, жаннат яқинлаштирилса."
  },
  {
    "surah_id": 81,
    "ayah_number": 14,
    "global_ayah_id": 5814,
    "translation": "Ҳар бир жон нима ҳозирланганини билади."
  },
  {
    "surah_id": 81,
    "ayah_number": 15,
    "global_ayah_id": 5815,
    "translation": "(Кундузи) махфий бўлувчи(юлдуз)лар билан қасам."
  },
  {
    "surah_id": 81,
    "ayah_number": 16,
    "global_ayah_id": 5816,
    "translation": "(Кечалари) юрувчи, беркинувчи(юлдуз)лар билан қасам."
  },
  {
    "surah_id": 81,
    "ayah_number": 17,
    "global_ayah_id": 5817,
    "translation": "Қоронғулиги билан кириб келган кеча билан қасам."
  },
  {
    "surah_id": 81,
    "ayah_number": 18,
    "global_ayah_id": 5818,
    "translation": "Нафас олиб, кириб келган тонг билан қасам."
  },
  {
    "surah_id": 81,
    "ayah_number": 19,
    "global_ayah_id": 5819,
    "translation": "Албатта у(Қуръон) карамли Расулнинг сўзидир."
  },
  {
    "surah_id": 81,
    "ayah_number": 20,
    "global_ayah_id": 5820,
    "translation": "У қувватлидир. Арш эгаси ҳузурида мартабаси олийдир."
  },
  {
    "surah_id": 81,
    "ayah_number": 21,
    "global_ayah_id": 5821,
    "translation": "Итоат қилинган, омонатли."
  },
  {
    "surah_id": 81,
    "ayah_number": 22,
    "global_ayah_id": 5822,
    "translation": "Сизнинг соҳибингиз мажнун эмас."
  },
  {
    "surah_id": 81,
    "ayah_number": 23,
    "global_ayah_id": 5823,
    "translation": "Батаҳқиқ ул ани очиқ-ойдин уфқда кўрди. (Муҳаммад с. а. в. Жиброилни очиқ-ойдин уфқда ўз кўзлари билан асл яратилишида кўрдилар.)"
  },
  {
    "surah_id": 81,
    "ayah_number": 24,
    "global_ayah_id": 5824,
    "translation": "Ва у ғайбга бахил эмас."
  },
  {
    "surah_id": 81,
    "ayah_number": 25,
    "global_ayah_id": 5825,
    "translation": "Ва у(Қуръон) тошбўрон қилинган шайтоннинг сўзи эмас."
  },
  {
    "surah_id": 81,
    "ayah_number": 26,
    "global_ayah_id": 5826,
    "translation": "Бас, қаёққа кетмоқдасиз?!"
  },
  {
    "surah_id": 81,
    "ayah_number": 27,
    "global_ayah_id": 5827,
    "translation": "У (Қуръон) оламларга эслатмадан бошқа нарса эмас."
  },
  {
    "surah_id": 81,
    "ayah_number": 28,
    "global_ayah_id": 5828,
    "translation": "Сизлардан мустақим бўлишни хоҳловчилар учун."
  },
  {
    "surah_id": 81,
    "ayah_number": 29,
    "global_ayah_id": 5829,
    "translation": "Оламларнинг Роббиси Аллоҳ хоҳламаса, сизлар хоҳлай олмассизлар. (Ҳар бир нарса Аллоҳнинг хоҳишига боғлиқ. Ҳар бир нарса Аллоҳ таолонинг хоҳиши ила бўлади.)"
  }
]