[
  {
    "surah_id": 81,
    "ayah_number": 1,
    "global_ayah_id": 5801,
    "translation": "যখন সূর্য আলোহীন হয়ে যাবে,"
  },
  {
    "surah_id": 81,
    "ayah_number": 2,
    "global_ayah_id": 5802,
    "translation": "যখন নক্ষত্র মলিন হয়ে যাবে,"
  },
  {
    "surah_id": 81,
    "ayah_number": 3,
    "global_ayah_id": 5803,
    "translation": "যখন পর্বতমালা অপসারিত হবে,"
  },
  {
    "surah_id": 81,
    "ayah_number": 4,
    "global_ayah_id": 5804,
    "translation": "যখন দশ মাসের গর্ভবতী উষ্ট্রীসমূহ উপেক্ষিত হবে;"
  },
  {
    "surah_id": 81,
    "ayah_number": 5,
    "global_ayah_id": 5805,
    "translation": "যখন বন্য পশুরা একত্রিত হয়ে যাবে,"
  },
  {
    "surah_id": 81,
    "ayah_number": 6,
    "global_ayah_id": 5806,
    "translation": "যখন সমুদ্রকে উত্তাল করে তোলা হবে,"
  },
  {
    "surah_id": 81,
    "ayah_number": 7,
    "global_ayah_id": 5807,
    "translation": "যখন আত্মাসমূহকে যুগল করা হবে,"
  },
  {
    "surah_id": 81,
    "ayah_number": 8,
    "global_ayah_id": 5808,
    "translation": "যখন জীবন্ত প্রোথিত কন্যাকে জিজ্ঞেস করা হবে,"
  },
  {
    "surah_id": 81,
    "ayah_number": 9,
    "global_ayah_id": 5809,
    "translation": "কি অপরাধে তাকে হত্য করা হল?"
  },
  {
    "surah_id": 81,
    "ayah_number": 10,
    "global_ayah_id": 5810,
    "translation": "যখন আমলনামা খোলা হবে,"
  },
  {
    "surah_id": 81,
    "ayah_number": 11,
    "global_ayah_id": 5811,
    "translation": "যখন আকাশের আবরণ অপসারিত হবে,"
  },
  {
    "surah_id": 81,
    "ayah_number": 12,
    "global_ayah_id": 5812,
    "translation": "যখন জাহান্নামের অগ্নি প্রজ্বলিত করা হবে"
  },
  {
    "surah_id": 81,
    "ayah_number": 13,
    "global_ayah_id": 5813,
    "translation": "এবং যখন জান্নাত সন্নিকটবর্তী হবে,"
  },
  {
    "surah_id": 81,
    "ayah_number": 14,
    "global_ayah_id": 5814,
    "translation": "তখন প্রত্যেকেই জেনে নিবে সে কি উপস্থিত করেছে।"
  },
  {
    "surah_id": 81,
    "ayah_number": 15,
    "global_ayah_id": 5815,
    "translation": "আমি শপথ করি যেসব নক্ষত্রগুলো পশ্চাতে সরে যায়।"
  },
  {
    "surah_id": 81,
    "ayah_number": 16,
    "global_ayah_id": 5816,
    "translation": "চলমান হয় ও অদৃশ্য হয়,"
  },
  {
    "surah_id": 81,
    "ayah_number": 17,
    "global_ayah_id": 5817,
    "translation": "শপথ নিশাবসান ও"
  },
  {
    "surah_id": 81,
    "ayah_number": 18,
    "global_ayah_id": 5818,
    "translation": "প্রভাত আগমন কালের,"
  },
  {
    "surah_id": 81,
    "ayah_number": 19,
    "global_ayah_id": 5819,
    "translation": "নিশ্চয় কোরআন সম্মানিত রসূলের আনীত বাণী,"
  },
  {
    "surah_id": 81,
    "ayah_number": 20,
    "global_ayah_id": 5820,
    "translation": "যিনি শক্তিশালী, আরশের মালিকের নিকট মর্যাদাশালী,"
  },
  {
    "surah_id": 81,
    "ayah_number": 21,
    "global_ayah_id": 5821,
    "translation": "সবার মান্যবর, সেখানকার বিশ্বাসভাজন।"
  },
  {
    "surah_id": 81,
    "ayah_number": 22,
    "global_ayah_id": 5822,
    "translation": "এবং তোমাদের সাথী পাগল নন।"
  },
  {
    "surah_id": 81,
    "ayah_number": 23,
    "global_ayah_id": 5823,
    "translation": "তিনি সেই ফেরেশতাকে প্রকাশ্য দিগন্তে দেখেছেন।"
  },
  {
    "surah_id": 81,
    "ayah_number": 24,
    "global_ayah_id": 5824,
    "translation": "তিনি অদৃশ্য বিষয় বলতে কৃপনতা করেন না।"
  },
  {
    "surah_id": 81,
    "ayah_number": 25,
    "global_ayah_id": 5825,
    "translation": "এটা বিতাড়িত শয়তানের উক্তি নয়।"
  },
  {
    "surah_id": 81,
    "ayah_number": 26,
    "global_ayah_id": 5826,
    "translation": "অতএব, তোমরা কোথায় যাচ্ছ?"
  },
  {
    "surah_id": 81,
    "ayah_number": 27,
    "global_ayah_id": 5827,
    "translation": "এটা তো কেবল বিশ্বাবাসীদের জন্যে উপদেশ,"
  },
  {
    "surah_id": 81,
    "ayah_number": 28,
    "global_ayah_id": 5828,
    "translation": "তার জন্যে, যে তোমাদের মধ্যে সোজা চলতে চায়।"
  },
  {
    "surah_id": 81,
    "ayah_number": 29,
    "global_ayah_id": 5829,
    "translation": "তোমরা আল্লাহ রাব্বুল আলামীনের অভিপ্রায়ের বাইরে অন্য কিছুই ইচ্ছা করতে পার না।"
  }
]