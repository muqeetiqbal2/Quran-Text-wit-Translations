[
  {
    "surah_id": 81,
    "ayah_number": 1,
    "global_ayah_id": 5801,
    "translation": "যখন সূর্য অন্ধকারাচ্ছন্ন হয়ে যাবে,"
  },
  {
    "surah_id": 81,
    "ayah_number": 2,
    "global_ayah_id": 5802,
    "translation": "আর যখন তারকারা নিস্তেজ হয়ে পড়বে,"
  },
  {
    "surah_id": 81,
    "ayah_number": 3,
    "global_ayah_id": 5803,
    "translation": "আর যখন পাহাড়গুলোকে অপসারণ করা হবে,"
  },
  {
    "surah_id": 81,
    "ayah_number": 4,
    "global_ayah_id": 5804,
    "translation": "আর যখন পূর্ণ-গর্ভা উষ্টীদের পরিত্যাগ করা হবে;"
  },
  {
    "surah_id": 81,
    "ayah_number": 5,
    "global_ayah_id": 5805,
    "translation": "আর যখন বন্য পশুদের সমবেত করা হবে,"
  },
  {
    "surah_id": 81,
    "ayah_number": 6,
    "global_ayah_id": 5806,
    "translation": "আর যখন সাগর-নদী ফেঁপে উঠবে,"
  },
  {
    "surah_id": 81,
    "ayah_number": 7,
    "global_ayah_id": 5807,
    "translation": "আর যখন মনপ্রাণকে একতাবদ্ধ করা হবে,"
  },
  {
    "surah_id": 81,
    "ayah_number": 8,
    "global_ayah_id": 5808,
    "translation": "আর যখন জীবন্ত-প্রোথিত কন্যাসন্তানকে প্রশ্ন করা হবে --"
  },
  {
    "surah_id": 81,
    "ayah_number": 9,
    "global_ayah_id": 5809,
    "translation": "''কোন অপরাধে তাকে হত্যা করা হয়েছিল’’?"
  },
  {
    "surah_id": 81,
    "ayah_number": 10,
    "global_ayah_id": 5810,
    "translation": "আর যখন পৃষ্ঠাগুলো খুলে ধরা হবে,"
  },
  {
    "surah_id": 81,
    "ayah_number": 11,
    "global_ayah_id": 5811,
    "translation": "আর যখন আকাশের ঢাকনি খুলে ফেলা হবে,"
  },
  {
    "surah_id": 81,
    "ayah_number": 12,
    "global_ayah_id": 5812,
    "translation": "আর যখন ভয়ংকর আগুন জ্বালিয়ে তোলা হবে,"
  },
  {
    "surah_id": 81,
    "ayah_number": 13,
    "global_ayah_id": 5813,
    "translation": "আর যখন বেহেশতকে নিকটে আনা হবে, --"
  },
  {
    "surah_id": 81,
    "ayah_number": 14,
    "global_ayah_id": 5814,
    "translation": "সত্ত্বা জানতে পারবে কী সে হাজির করেছে।"
  },
  {
    "surah_id": 81,
    "ayah_number": 15,
    "global_ayah_id": 5815,
    "translation": "কাজেই না, আমি সাক্ষী মানছি গ্রহ-নক্ষত্রদের --"
  },
  {
    "surah_id": 81,
    "ayah_number": 16,
    "global_ayah_id": 5816,
    "translation": "যারা চলে থাকে, অদৃশ্য হয়ে যায়,"
  },
  {
    "surah_id": 81,
    "ayah_number": 17,
    "global_ayah_id": 5817,
    "translation": "আর রাত্রিকে যখন তা বিগত হয়ে যায়,"
  },
  {
    "surah_id": 81,
    "ayah_number": 18,
    "global_ayah_id": 5818,
    "translation": "আর প্রভাতকে যখন তা উজ্জ্বল হতে থাকে,"
  },
  {
    "surah_id": 81,
    "ayah_number": 19,
    "global_ayah_id": 5819,
    "translation": "নিঃসন্দেহ এ তো হচ্ছে এক সম্মানিত রসূলের বাণী --"
  },
  {
    "surah_id": 81,
    "ayah_number": 20,
    "global_ayah_id": 5820,
    "translation": "শক্তির অধিকারী, আরশের অধীশ্বরের সামনে অধিষ্ঠিত,"
  },
  {
    "surah_id": 81,
    "ayah_number": 21,
    "global_ayah_id": 5821,
    "translation": "যাঁকে মেনে চলতে হয়, আর যিনি বিশ্বাসভাজন।"
  },
  {
    "surah_id": 81,
    "ayah_number": 22,
    "global_ayah_id": 5822,
    "translation": "আর তোমাদের সাথী তো পাগল নন।"
  },
  {
    "surah_id": 81,
    "ayah_number": 23,
    "global_ayah_id": 5823,
    "translation": "আর তিনি তো নিজেকে দেখেছিলেন স্পষ্ট দিগন্তে;"
  },
  {
    "surah_id": 81,
    "ayah_number": 24,
    "global_ayah_id": 5824,
    "translation": "আর তিনি অদৃশ্য-সন্বন্ধে কৃপণ নন,"
  },
  {
    "surah_id": 81,
    "ayah_number": 25,
    "global_ayah_id": 5825,
    "translation": "আর এটি কোনো বিতাড়িত শয়তানের বক্তব্য নয়।"
  },
  {
    "surah_id": 81,
    "ayah_number": 26,
    "global_ayah_id": 5826,
    "translation": "তোমরা তাহলে কোন দিকে চলেছ?"
  },
  {
    "surah_id": 81,
    "ayah_number": 27,
    "global_ayah_id": 5827,
    "translation": "এটি আলবৎ বিশ্ববাসীর জন্য স্মরণীয় বার্তা বৈ তো নয়, --"
  },
  {
    "surah_id": 81,
    "ayah_number": 28,
    "global_ayah_id": 5828,
    "translation": "তোমাদের মধ্যেকার তার জন্য যে সহজ-সঠিক পথে চলতে চায়।"
  },
  {
    "surah_id": 81,
    "ayah_number": 29,
    "global_ayah_id": 5829,
    "translation": "আর বিশ্বজগতের প্রভু আল্লাহ্ যা চান তা ব্যতীত তোমরা অন্য কোনো-কিছু চাইবে না।"
  }
]