[
  {
    "surah_id": 81,
    "ayah_number": 1,
    "global_ayah_id": 5801,
    "translation": "Quando o sol for enfolado,"
  },
  {
    "surah_id": 81,
    "ayah_number": 2,
    "global_ayah_id": 5802,
    "translation": "Quando as estrelas forem extintas,"
  },
  {
    "surah_id": 81,
    "ayah_number": 3,
    "global_ayah_id": 5803,
    "translation": "Quando as montanhas estiverem dispersas,"
  },
  {
    "surah_id": 81,
    "ayah_number": 4,
    "global_ayah_id": 5804,
    "translation": "Quando as camelas, com crias de dez meses, forem abandonadas,"
  },
  {
    "surah_id": 81,
    "ayah_number": 5,
    "global_ayah_id": 5805,
    "translation": "Quando as feras forem congregadas,"
  },
  {
    "surah_id": 81,
    "ayah_number": 6,
    "global_ayah_id": 5806,
    "translation": "Quando os mares transbordarem,"
  },
  {
    "surah_id": 81,
    "ayah_number": 7,
    "global_ayah_id": 5807,
    "translation": "Quando as almas forem reunidas,"
  },
  {
    "surah_id": 81,
    "ayah_number": 8,
    "global_ayah_id": 5808,
    "translation": "Quando a filha, sepultada vida, for interrogada:"
  },
  {
    "surah_id": 81,
    "ayah_number": 9,
    "global_ayah_id": 5809,
    "translation": "Por que delito foste assassinada?"
  },
  {
    "surah_id": 81,
    "ayah_number": 10,
    "global_ayah_id": 5810,
    "translation": "Quando as páginas forem abertas,"
  },
  {
    "surah_id": 81,
    "ayah_number": 11,
    "global_ayah_id": 5811,
    "translation": "Quando o céu for desvendado,"
  },
  {
    "surah_id": 81,
    "ayah_number": 12,
    "global_ayah_id": 5812,
    "translation": "Quando o inferno for aceso,"
  },
  {
    "surah_id": 81,
    "ayah_number": 13,
    "global_ayah_id": 5813,
    "translation": "E quando o jardim for aproximado,"
  },
  {
    "surah_id": 81,
    "ayah_number": 14,
    "global_ayah_id": 5814,
    "translation": "Então, saberá, cada alma, o que está apresentando."
  },
  {
    "surah_id": 81,
    "ayah_number": 15,
    "global_ayah_id": 5815,
    "translation": "Juro pelos planetas,"
  },
  {
    "surah_id": 81,
    "ayah_number": 16,
    "global_ayah_id": 5816,
    "translation": "Que se mostram e se escondem,"
  },
  {
    "surah_id": 81,
    "ayah_number": 17,
    "global_ayah_id": 5817,
    "translation": "E pela noite, quando escurece,"
  },
  {
    "surah_id": 81,
    "ayah_number": 18,
    "global_ayah_id": 5818,
    "translation": "E pela aurora, quando afasta a escuridão,"
  },
  {
    "surah_id": 81,
    "ayah_number": 19,
    "global_ayah_id": 5819,
    "translation": "Que (o Alcorão) é a palavra de um honorável Mensageiro,"
  },
  {
    "surah_id": 81,
    "ayah_number": 20,
    "global_ayah_id": 5820,
    "translation": "Forte, digníssimo, ante o Senhor do Trono."
  },
  {
    "surah_id": 81,
    "ayah_number": 21,
    "global_ayah_id": 5821,
    "translation": "Que deve ser obedecido, e no qual se deve confiar."
  },
  {
    "surah_id": 81,
    "ayah_number": 22,
    "global_ayah_id": 5822,
    "translation": "E o vosso companheiro (ó povos), não é um energúmeno!"
  },
  {
    "surah_id": 81,
    "ayah_number": 23,
    "global_ayah_id": 5823,
    "translation": "Ele o viu (Gabriel), no claro horizonte,"
  },
  {
    "surah_id": 81,
    "ayah_number": 24,
    "global_ayah_id": 5824,
    "translation": "E não é avaro, quanto ao incognoscível."
  },
  {
    "surah_id": 81,
    "ayah_number": 25,
    "global_ayah_id": 5825,
    "translation": "E não é (o Alcorão) a palavra do maldito Satanás."
  },
  {
    "surah_id": 81,
    "ayah_number": 26,
    "global_ayah_id": 5826,
    "translation": "Assim, pois, aonde ides?"
  },
  {
    "surah_id": 81,
    "ayah_number": 27,
    "global_ayah_id": 5827,
    "translation": "Certamente, não é mais do que uma mensagem, para o universo."
  },
  {
    "surah_id": 81,
    "ayah_number": 28,
    "global_ayah_id": 5828,
    "translation": "Para quem de vós se quiser encaminhar."
  },
  {
    "surah_id": 81,
    "ayah_number": 29,
    "global_ayah_id": 5829,
    "translation": "Porém, não vos encaminhareis, salvo se Deus, o Senhor do Universo, assim o permitir."
  }
]