[
  {
    "surah_id": 81,
    "ayah_number": 1,
    "global_ayah_id": 5801,
    "translation": "كله چې لمر ونغښتل شي"
  },
  {
    "surah_id": 81,
    "ayah_number": 2,
    "global_ayah_id": 5802,
    "translation": "او كله چې ستوري خړ شي"
  },
  {
    "surah_id": 81,
    "ayah_number": 3,
    "global_ayah_id": 5803,
    "translation": "او كله چې غرونه روان كړل شي"
  },
  {
    "surah_id": 81,
    "ayah_number": 4,
    "global_ayah_id": 5804,
    "translation": "او كله چې د لسو میاشتو بلاربې اوښې معطلې (ازادې) پرېښودى شي"
  },
  {
    "surah_id": 81,
    "ayah_number": 5,
    "global_ayah_id": 5805,
    "translation": "او كله چې وحشي ځناوران راجمع كړل شي"
  },
  {
    "surah_id": 81,
    "ayah_number": 6,
    "global_ayah_id": 5806,
    "translation": "او كله چې دریابونه بل كړى شي"
  },
  {
    "surah_id": 81,
    "ayah_number": 7,
    "global_ayah_id": 5807,
    "translation": "او كله چې نفسونه جوړه كړل شي"
  },
  {
    "surah_id": 81,
    "ayah_number": 8,
    "global_ayah_id": 5808,
    "translation": "او كله چې ژوندۍ خښه كړى شوې جینۍ وپوښتى شي"
  },
  {
    "surah_id": 81,
    "ayah_number": 9,
    "global_ayah_id": 5809,
    "translation": "چې دا په كومې ګناه وژل شوې ده"
  },
  {
    "surah_id": 81,
    "ayah_number": 10,
    "global_ayah_id": 5810,
    "translation": "او كله چې اعمال نامې وغوړولى شي"
  },
  {
    "surah_id": 81,
    "ayah_number": 11,
    "global_ayah_id": 5811,
    "translation": "او كله چې له اسمان نه پوستكى ووېستل شي"
  },
  {
    "surah_id": 81,
    "ayah_number": 12,
    "global_ayah_id": 5812,
    "translation": "او كله چې دوزخ بلې لمبې كړى شي"
  },
  {
    "surah_id": 81,
    "ayah_number": 13,
    "global_ayah_id": 5813,
    "translation": "او كله چې جنت ښه نژدې كړى شي"
  },
  {
    "surah_id": 81,
    "ayah_number": 14,
    "global_ayah_id": 5814,
    "translation": "هر نفس به په هغه شي پوه شي چې ده حاضر كړى وي"
  },
  {
    "surah_id": 81,
    "ayah_number": 15,
    "global_ayah_id": 5815,
    "translation": "نو زه قسم خورم په هغو (ستوریو) چې بېرته ګرځېدونكي دي"
  },
  {
    "surah_id": 81,
    "ayah_number": 16,
    "global_ayah_id": 5816,
    "translation": "په روانو، پټېدونكو باندې"
  },
  {
    "surah_id": 81,
    "ayah_number": 17,
    "global_ayah_id": 5817,
    "translation": "او قسم خورم په شپې كله چې شروع شي"
  },
  {
    "surah_id": 81,
    "ayah_number": 18,
    "global_ayah_id": 5818,
    "translation": "او په سبا كله چې دى ساه واخلي (روښانه شي)"
  },
  {
    "surah_id": 81,
    "ayah_number": 19,
    "global_ayah_id": 5819,
    "translation": "بېشكه دا (قرآن) خامخا د ډېر عزتمن رسول قول دى"
  },
  {
    "surah_id": 81,
    "ayah_number": 20,
    "global_ayah_id": 5820,
    "translation": "چې د عرش د مالك په نیز د قوت والا (او) د مرتبې والا دى"
  },
  {
    "surah_id": 81,
    "ayah_number": 21,
    "global_ayah_id": 5821,
    "translation": "منلى شوى دى هلته، امین دى"
  },
  {
    "surah_id": 81,
    "ayah_number": 22,
    "global_ayah_id": 5822,
    "translation": "او ستاسو ملګرى (محمدﷺ) له سره لېونى نه دى"
  },
  {
    "surah_id": 81,
    "ayah_number": 23,
    "global_ayah_id": 5823,
    "translation": "او یقینًا یقینًا ده دغه (جبریل د اسمان) په څرګنده غاړه كې لیدلى و"
  },
  {
    "surah_id": 81,
    "ayah_number": 24,
    "global_ayah_id": 5824,
    "translation": "او دى د وحي په بیانولو كې له سره بخل كوونكى نه دى"
  },
  {
    "surah_id": 81,
    "ayah_number": 25,
    "global_ayah_id": 5825,
    "translation": "او بېخي نه دى دا (قرآن) خبره د شیطان رټل شوي"
  },
  {
    "surah_id": 81,
    "ayah_number": 26,
    "global_ayah_id": 5826,
    "translation": "نو تاسو (اى كافرانو!) چېرته ځئ؟"
  },
  {
    "surah_id": 81,
    "ayah_number": 27,
    "global_ayah_id": 5827,
    "translation": "نه دى دا (قرآن) مګر د عالمونو لپاره نصیحت (او پند)"
  },
  {
    "surah_id": 81,
    "ayah_number": 28,
    "global_ayah_id": 5828,
    "translation": "د هغه چا لپاره چې په تاسو كې غواړې چې دى نېغ برابر شي"
  },
  {
    "surah_id": 81,
    "ayah_number": 29,
    "global_ayah_id": 5829,
    "translation": "او تاسو د (د سمې لارې) اراده نشئ كولى مګر دا چې الله رب العلمین يې اراده وكړي"
  }
]