[
  {
    "surah_id": 81,
    "ayah_number": 1,
    "global_ayah_id": 5801,
    "translation": "சூரியன் (ஒளியில்லாததாகச்) சுருட்டப்படும் போது"
  },
  {
    "surah_id": 81,
    "ayah_number": 2,
    "global_ayah_id": 5802,
    "translation": "நட்சத்திரங்கள் (ஒளியிழந்து) உதிர்ந்து விழும்போது-"
  },
  {
    "surah_id": 81,
    "ayah_number": 3,
    "global_ayah_id": 5803,
    "translation": "மலைகள் பெயர்க்கப்படும் போது-"
  },
  {
    "surah_id": 81,
    "ayah_number": 4,
    "global_ayah_id": 5804,
    "translation": "சூல் நிறைந்த ஒட்டகைகள் (கவனிப்பாரற்று) விடப்படும் போது-"
  },
  {
    "surah_id": 81,
    "ayah_number": 5,
    "global_ayah_id": 5805,
    "translation": "காட்டு மிருகங்கள் (மனிதர்களுடனும், இதர பிராணிகளுடனும்) ஒன்று சேர்க்கப்படும்போது-"
  },
  {
    "surah_id": 81,
    "ayah_number": 6,
    "global_ayah_id": 5806,
    "translation": "கடல்கள் தீ மூட்டப்படும்போது-"
  },
  {
    "surah_id": 81,
    "ayah_number": 7,
    "global_ayah_id": 5807,
    "translation": "உயிர்கள் ஒன்றிணைக்கப்படும் போது-"
  },
  {
    "surah_id": 81,
    "ayah_number": 8,
    "global_ayah_id": 5808,
    "translation": "உயிருடன் புதைக்கப்பட்ட பெண் (குழந்தை) வினவப்படும் போது-"
  },
  {
    "surah_id": 81,
    "ayah_number": 9,
    "global_ayah_id": 5809,
    "translation": "\"எந்தக் குற்றத்திற்காக அது கொல்லப்பட்டது?\" என்று-"
  },
  {
    "surah_id": 81,
    "ayah_number": 10,
    "global_ayah_id": 5810,
    "translation": "பட்டோலைகள் விரிக்கப்படும் போது-"
  },
  {
    "surah_id": 81,
    "ayah_number": 11,
    "global_ayah_id": 5811,
    "translation": "வானம் அகற்றப்படும் போது-"
  },
  {
    "surah_id": 81,
    "ayah_number": 12,
    "global_ayah_id": 5812,
    "translation": "நரகம் கொழுந்துவிட்டு எரியுமாறு செய்யப்படும் போது-"
  },
  {
    "surah_id": 81,
    "ayah_number": 13,
    "global_ayah_id": 5813,
    "translation": "சுவர்க்கம் சமீபமாக கொண்டு வரப்படும்போது-"
  },
  {
    "surah_id": 81,
    "ayah_number": 14,
    "global_ayah_id": 5814,
    "translation": "ஒவ்வோர் ஆத்மாவும், தான் கொண்டு வந்ததை அறிந்து கொள்ளும்."
  },
  {
    "surah_id": 81,
    "ayah_number": 15,
    "global_ayah_id": 5815,
    "translation": "எனவே, பின்னே விலகிச் செல்பவை (கிரகங்களின்) மீது சத்தியமாக-"
  },
  {
    "surah_id": 81,
    "ayah_number": 16,
    "global_ayah_id": 5816,
    "translation": "முன் சென்று கொண்டிருப்பவை மறைபவை (மீதும்),"
  },
  {
    "surah_id": 81,
    "ayah_number": 17,
    "global_ayah_id": 5817,
    "translation": "பின்வாங்கிச் செல்லும் இரவின் மீதும்,"
  },
  {
    "surah_id": 81,
    "ayah_number": 18,
    "global_ayah_id": 5818,
    "translation": "மூச்சுவிட்டுக் கொண்டெழும் வைகறையின் மீதும் சத்தியமாக."
  },
  {
    "surah_id": 81,
    "ayah_number": 19,
    "global_ayah_id": 5819,
    "translation": "நிச்சயமாக (இக்குர்ஆன்) மிகவும் கண்ணியமிக்க ஒரு தூதுவர் (ஜிப்ரயீல் மூலம் வந்த) சொல்லாகும்."
  },
  {
    "surah_id": 81,
    "ayah_number": 20,
    "global_ayah_id": 5820,
    "translation": "(அவர்) சக்திமிக்கவர்; அர்ஷுக்குடையவனிடம் பெரும் பதவியுடையவர்."
  },
  {
    "surah_id": 81,
    "ayah_number": 21,
    "global_ayah_id": 5821,
    "translation": "(வானவர் தம்) தலைவர்; அன்றியும் நம்பிக்கைக்குரியவர்."
  },
  {
    "surah_id": 81,
    "ayah_number": 22,
    "global_ayah_id": 5822,
    "translation": "மேலும் உங்கள் தோழர் பைத்தியக்காரர் அல்லர்."
  },
  {
    "surah_id": 81,
    "ayah_number": 23,
    "global_ayah_id": 5823,
    "translation": "அவர் திட்டமாக அவரை (ஜிப்ரயீலை) தெளிவான அடிவானத்தில் கண்டார்."
  },
  {
    "surah_id": 81,
    "ayah_number": 24,
    "global_ayah_id": 5824,
    "translation": "மேலும், அவர் மறைவான செய்திகளை கூறுவதில் உலோபித்தனம் செய்பவரல்லர்."
  },
  {
    "surah_id": 81,
    "ayah_number": 25,
    "global_ayah_id": 5825,
    "translation": "அன்றியும், இது விரட்டப்பட்ட ஷைத்தானின் வாக்கல்ல."
  },
  {
    "surah_id": 81,
    "ayah_number": 26,
    "global_ayah_id": 5826,
    "translation": "எனவே, (நேர்வழியை விட்டும்) நீங்கள் எங்கே செல்கின்றீர்கள்?"
  },
  {
    "surah_id": 81,
    "ayah_number": 27,
    "global_ayah_id": 5827,
    "translation": "இது, அகிலத்தாருக்கெல்லாம் உபதேசமாகும்."
  },
  {
    "surah_id": 81,
    "ayah_number": 28,
    "global_ayah_id": 5828,
    "translation": "உங்களில் நின்றும் யார் நேர்வழியை விரும்புகிறாரோ, அவருக்கு (நல்லுபதேசமாகும்)."
  },
  {
    "surah_id": 81,
    "ayah_number": 29,
    "global_ayah_id": 5829,
    "translation": "ஆயினும், அகிலங்களுக்கெல்லாம் இறைவனாகிய அல்லாஹ் நாடினாலன்றி நீங்கள் (நல்லுபதேசம் பெற) நாடமாட்டீர்கள்."
  }
]