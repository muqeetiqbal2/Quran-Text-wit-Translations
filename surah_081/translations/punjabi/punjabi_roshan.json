[
  {
    "surah_id": 81,
    "ayah_number": 0,
    "global_ayah_id": 5880,
    "translation": "اللہ دے ناں نال ( شروع ) جیہڑا حدوں مہربان ، بوہت رحم والا اے ۔"
  },
  {
    "surah_id": 81,
    "ayah_number": 1,
    "global_ayah_id": 5881,
    "translation": "جدوں سورج ولھیٹ دتا جائے گا"
  },
  {
    "surah_id": 81,
    "ayah_number": 2,
    "global_ayah_id": 5882,
    "translation": "تے جدوں تارے پھِکے پے جان گے"
  },
  {
    "surah_id": 81,
    "ayah_number": 3,
    "global_ayah_id": 5883,
    "translation": "تے جدوں پہاڑ ٹورے جان گے"
  },
  {
    "surah_id": 81,
    "ayah_number": 4,
    "global_ayah_id": 5884,
    "translation": "تے جدوں دہ ( 10 ) ماہی گھبن ( ڈُھکیاں ) اوٹھنیاں آوارہ پھرن گئیاں"
  },
  {
    "surah_id": 81,
    "ayah_number": 5,
    "global_ayah_id": 5885,
    "translation": "تے جدوں وحشی جانور کٹھے کیتے جان گے"
  },
  {
    "surah_id": 81,
    "ayah_number": 6,
    "global_ayah_id": 5886,
    "translation": "تے جدوں سمندر اچھلن گے"
  },
  {
    "surah_id": 81,
    "ayah_number": 7,
    "global_ayah_id": 5887,
    "translation": "تے جدوں جاناں جُرٹ ہون گئیاں"
  },
  {
    "surah_id": 81,
    "ayah_number": 8,
    "global_ayah_id": 5888,
    "translation": "تے جدوں جیوندی دبی نوں پچھیا جاوے گا"
  },
  {
    "surah_id": 81,
    "ayah_number": 9,
    "global_ayah_id": 5889,
    "translation": "پئی اوہ کیس گناہ توں ماری گئی سی ؟"
  },
  {
    "surah_id": 81,
    "ayah_number": 10,
    "global_ayah_id": 5890,
    "translation": "تے جدوں عملاں دے کھاتے کھلارے جان گے"
  },
  {
    "surah_id": 81,
    "ayah_number": 11,
    "global_ayah_id": 5891,
    "translation": "تے جدوں اسمان دی کھل لاہ دتی جاوے گی"
  },
  {
    "surah_id": 81,
    "ayah_number": 12,
    "global_ayah_id": 5892,
    "translation": "تے جدوں دوزخ بھکھائی جاوے گی"
  },
  {
    "surah_id": 81,
    "ayah_number": 13,
    "global_ayah_id": 5893,
    "translation": "تے جدوں جنت نیڑے لیاندی جاوے گی"
  },
  {
    "surah_id": 81,
    "ayah_number": 14,
    "global_ayah_id": 5894,
    "translation": "( تد ) ہر جی جان لوے گا جو اوہ پلّے لیایا اے"
  },
  {
    "surah_id": 81,
    "ayah_number": 15,
    "global_ayah_id": 5895,
    "translation": "سو نئیں ! مینوں قسم اے پچھاں ہٹن والیاں ( تاریاں ) دی"
  },
  {
    "surah_id": 81,
    "ayah_number": 16,
    "global_ayah_id": 5896,
    "translation": "ٹُرن والے ، ڈُب جان والے دی"
  },
  {
    "surah_id": 81,
    "ayah_number": 17,
    "global_ayah_id": 5897,
    "translation": "تے رات دی جدوں پرتن لگے"
  },
  {
    "surah_id": 81,
    "ayah_number": 18,
    "global_ayah_id": 5898,
    "translation": "تے صبح دی جدوں ساہ لوے"
  },
  {
    "surah_id": 81,
    "ayah_number": 19,
    "global_ayah_id": 5899,
    "translation": "بیشک ایہہ ( قرآن ) لازمی اک عزت والے قاصد ( جبریل ) دا سخن اے"
  },
  {
    "surah_id": 81,
    "ayah_number": 20,
    "global_ayah_id": 5900,
    "translation": "جیہڑا زوراں والا ، عرش والے دے لاگے اُچے مرتبے والا اے"
  },
  {
    "surah_id": 81,
    "ayah_number": 21,
    "global_ayah_id": 5901,
    "translation": "( فرشتیاں چ ) منیا جاندا اوتھے امانت دار اے"
  },
  {
    "surah_id": 81,
    "ayah_number": 22,
    "global_ayah_id": 5902,
    "translation": "تے ( مکے والیو ! ) تہاڈا ساتھی کتن دیوانہ نئیں"
  },
  {
    "surah_id": 81,
    "ayah_number": 23,
    "global_ayah_id": 5903,
    "translation": "تے بلاشبہ یقیناً ایس اوہنوں ( جبرائیل نوں اسمان دے ) چانن کنڈھے تے ویکھیا اے"
  },
  {
    "surah_id": 81,
    "ayah_number": 24,
    "global_ayah_id": 5904,
    "translation": "تے اوہ غیب ( دیاں خبراں ) تے کتن بخیل نئیں"
  },
  {
    "surah_id": 81,
    "ayah_number": 25,
    "global_ayah_id": 5905,
    "translation": "تے ایہہ ( قرآن ) کتن کسے مردود شیطان دا سُخن نئیں"
  },
  {
    "surah_id": 81,
    "ayah_number": 26,
    "global_ayah_id": 5906,
    "translation": "فیر تسی کدھر ونجے پھردے او"
  },
  {
    "surah_id": 81,
    "ayah_number": 27,
    "global_ayah_id": 5907,
    "translation": "ایہہ تے جہاناں لئی نصیحت دے سوا کجھ نئیں"
  },
  {
    "surah_id": 81,
    "ayah_number": 28,
    "global_ayah_id": 5908,
    "translation": "اوہدے لئی جیہڑا تہاڈے وچوں سدھا رہنا چاہوے"
  },
  {
    "surah_id": 81,
    "ayah_number": 29,
    "global_ayah_id": 5909,
    "translation": "تے تسی ( کجھ وی ) نئیں چاؤہندے پر ایہہ پئی اللہ چاہوے جیہڑا کل جہاناں دا مالک اے ۔"
  }
]