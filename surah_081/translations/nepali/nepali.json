[
  {
    "surah_id": 81,
    "ayah_number": 0,
    "global_ayah_id": 5880,
    "translation": "शुरु अत्यन्त करुणामय, परम दयालु अल्लाहको नामबाट ।"
  },
  {
    "surah_id": 81,
    "ayah_number": 1,
    "global_ayah_id": 5881,
    "translation": "जब सूर्यलाई बेरिनेछ"
  },
  {
    "surah_id": 81,
    "ayah_number": 2,
    "global_ayah_id": 5882,
    "translation": "र जब ताराहरू प्रकाशविहीन हुनेछन्"
  },
  {
    "surah_id": 81,
    "ayah_number": 3,
    "global_ayah_id": 5883,
    "translation": "र जब पर्वतहरू गतिशील बनाइनेछन्"
  },
  {
    "surah_id": 81,
    "ayah_number": 4,
    "global_ayah_id": 5884,
    "translation": "र जब दस महिनाकी गर्भिणी ऊँटनीहरू त्यागिनेछन्"
  },
  {
    "surah_id": 81,
    "ayah_number": 5,
    "global_ayah_id": 5885,
    "translation": "र जब जङ्गली जनावरहरू एकत्रित गरिनेछन्"
  },
  {
    "surah_id": 81,
    "ayah_number": 6,
    "global_ayah_id": 5886,
    "translation": "र जब समुद्रमा आगो दन्काइनेछ"
  },
  {
    "surah_id": 81,
    "ayah_number": 7,
    "global_ayah_id": 5887,
    "translation": "र जब आत्माहरू जोडिनेछन्"
  },
  {
    "surah_id": 81,
    "ayah_number": 8,
    "global_ayah_id": 5888,
    "translation": "र जब जिउँदै गाडिएकी बालिकालाई सोधिनेछ"
  },
  {
    "surah_id": 81,
    "ayah_number": 9,
    "global_ayah_id": 5889,
    "translation": "कुन पापमा उसको हत्या गरिएको थियो"
  },
  {
    "surah_id": 81,
    "ayah_number": 10,
    "global_ayah_id": 5890,
    "translation": "र, जब कर्मपत्रहरू खोलिनेछन्"
  },
  {
    "surah_id": 81,
    "ayah_number": 11,
    "global_ayah_id": 5891,
    "translation": "र, जब आकाशलाई उदाङ्गो गरिनेछ"
  },
  {
    "surah_id": 81,
    "ayah_number": 12,
    "global_ayah_id": 5892,
    "translation": "र जब नरक दन्काइनेछ"
  },
  {
    "surah_id": 81,
    "ayah_number": 13,
    "global_ayah_id": 5893,
    "translation": "र जब स्वर्ग नजिक ल्याइनेछ"
  },
  {
    "surah_id": 81,
    "ayah_number": 14,
    "global_ayah_id": 5894,
    "translation": "त्यतिबेला प्रत्येक व्यक्तिले आफूले के लिएर आएको छ भन्ने जान्नेछ ।"
  },
  {
    "surah_id": 81,
    "ayah_number": 15,
    "global_ayah_id": 5895,
    "translation": "होइन  यी ताराहरूको कसम जो पछि हट्छन्"
  },
  {
    "surah_id": 81,
    "ayah_number": 16,
    "global_ayah_id": 5896,
    "translation": "जो अघि सर्दै लुप्त हुन्छन् ।"
  },
  {
    "surah_id": 81,
    "ayah_number": 17,
    "global_ayah_id": 5897,
    "translation": "र, रातको कसम जब त्यो बित्न लाग्छ"
  },
  {
    "surah_id": 81,
    "ayah_number": 18,
    "global_ayah_id": 5898,
    "translation": "र  प्रभातको कसम जब त्यो उदाउन लाग्छ"
  },
  {
    "surah_id": 81,
    "ayah_number": 19,
    "global_ayah_id": 5899,
    "translation": "निश्चय नै यो (कुरआन) एक प्रतिष्ठित दूत (द्वारा ल्याइए) को वचन् हो।"
  },
  {
    "surah_id": 81,
    "ayah_number": 20,
    "global_ayah_id": 5900,
    "translation": "जो शक्तिशाली एवं सिंहासनका स्वामीकहाँ उच्च पदाधिकारी हुन् ।"
  },
  {
    "surah_id": 81,
    "ayah_number": 21,
    "global_ayah_id": 5901,
    "translation": "त्यहाँ उनको आज्ञापालन गरिन्छ, जो इमानदार छन् ।"
  },
  {
    "surah_id": 81,
    "ayah_number": 22,
    "global_ayah_id": 5902,
    "translation": "र, तिम्रा साथी (मुहम्मद स.) उन्मादी होइनन् ।"
  },
  {
    "surah_id": 81,
    "ayah_number": 23,
    "global_ayah_id": 5903,
    "translation": "उनले त्यस (दूत जिब्रइल) लाई प्रकाशमय क्षितिजमा देखेका छन् ।"
  },
  {
    "surah_id": 81,
    "ayah_number": 24,
    "global_ayah_id": 5904,
    "translation": "र, उनी परोक्षको ज्ञान (पुर्याउने) मामिलामा कञ्जुस छैनन् ।"
  },
  {
    "surah_id": 81,
    "ayah_number": 25,
    "global_ayah_id": 5905,
    "translation": "र, यो (कुरआन) कुनै तिरस्कृत शैतानको कथन होइन ।"
  },
  {
    "surah_id": 81,
    "ayah_number": 26,
    "global_ayah_id": 5906,
    "translation": "तैपनि तिमीहरू कहाँ जाँदैछौ ?"
  },
  {
    "surah_id": 81,
    "ayah_number": 27,
    "global_ayah_id": 5907,
    "translation": "यो सम्पूर्ण संसारबासीहरूका लागि उपदेश हो ।"
  },
  {
    "surah_id": 81,
    "ayah_number": 28,
    "global_ayah_id": 5908,
    "translation": "तिमीहरूमध्ये सीधामार्गमा हिंड्न चाहनेहरू कालागि ।"
  },
  {
    "surah_id": 81,
    "ayah_number": 29,
    "global_ayah_id": 5909,
    "translation": "र तिमीहरुले चाहन सक्ने छैनौ जबसम्म सम्पूर्ण संसारका पालनकर्ता अल्लाहको चाहना हुँदैन ।"
  }
]