[
  {
    "surah_id": 81,
    "ayah_number": 1,
    "global_ayah_id": 5801,
    "translation": "Quando sarà oscurato il sole,"
  },
  {
    "surah_id": 81,
    "ayah_number": 2,
    "global_ayah_id": 5802,
    "translation": "e spente le stelle,"
  },
  {
    "surah_id": 81,
    "ayah_number": 3,
    "global_ayah_id": 5803,
    "translation": "e messe in marcia le montagne,"
  },
  {
    "surah_id": 81,
    "ayah_number": 4,
    "global_ayah_id": 5804,
    "translation": "e neglette le cammelle gravide di dieci mesi,"
  },
  {
    "surah_id": 81,
    "ayah_number": 5,
    "global_ayah_id": 5805,
    "translation": "e radunate le belve,"
  },
  {
    "surah_id": 81,
    "ayah_number": 6,
    "global_ayah_id": 5806,
    "translation": "e ribollenti i mari,"
  },
  {
    "surah_id": 81,
    "ayah_number": 7,
    "global_ayah_id": 5807,
    "translation": "e divise in gruppi le anime,"
  },
  {
    "surah_id": 81,
    "ayah_number": 8,
    "global_ayah_id": 5808,
    "translation": "e quando verrà chiesto alla [neonata] sepolta viva"
  },
  {
    "surah_id": 81,
    "ayah_number": 9,
    "global_ayah_id": 5809,
    "translation": "per quale colpa sia stata uccisa,"
  },
  {
    "surah_id": 81,
    "ayah_number": 10,
    "global_ayah_id": 5810,
    "translation": "e quando saranno dispiegati i fogli,"
  },
  {
    "surah_id": 81,
    "ayah_number": 11,
    "global_ayah_id": 5811,
    "translation": "e scorticato il cielo,"
  },
  {
    "surah_id": 81,
    "ayah_number": 12,
    "global_ayah_id": 5812,
    "translation": "e attizzata la Fornace,"
  },
  {
    "surah_id": 81,
    "ayah_number": 13,
    "global_ayah_id": 5813,
    "translation": "e avvicinato il Paradiso,"
  },
  {
    "surah_id": 81,
    "ayah_number": 14,
    "global_ayah_id": 5814,
    "translation": "ogni anima conoscerà quel che avrà prodotto."
  },
  {
    "surah_id": 81,
    "ayah_number": 15,
    "global_ayah_id": 5815,
    "translation": "Giuro per i pianeti"
  },
  {
    "surah_id": 81,
    "ayah_number": 16,
    "global_ayah_id": 5816,
    "translation": "che passano e che si occultano,"
  },
  {
    "surah_id": 81,
    "ayah_number": 17,
    "global_ayah_id": 5817,
    "translation": "per la notte che si estende,"
  },
  {
    "surah_id": 81,
    "ayah_number": 18,
    "global_ayah_id": 5818,
    "translation": "per l'aurora che esala il suo alito,"
  },
  {
    "surah_id": 81,
    "ayah_number": 19,
    "global_ayah_id": 5819,
    "translation": "questa è la parola di un Messaggero nobilissimo,"
  },
  {
    "surah_id": 81,
    "ayah_number": 20,
    "global_ayah_id": 5820,
    "translation": "potente ed eccellente presso il Signore del Trono,"
  },
  {
    "surah_id": 81,
    "ayah_number": 21,
    "global_ayah_id": 5821,
    "translation": "colà obbedito e fedele."
  },
  {
    "surah_id": 81,
    "ayah_number": 22,
    "global_ayah_id": 5822,
    "translation": "Il vostro compagno non è un folle:"
  },
  {
    "surah_id": 81,
    "ayah_number": 23,
    "global_ayah_id": 5823,
    "translation": "in verità l'ha visto sull'orizzonte luminoso,"
  },
  {
    "surah_id": 81,
    "ayah_number": 24,
    "global_ayah_id": 5824,
    "translation": "non è avaro dell'Invisibile."
  },
  {
    "surah_id": 81,
    "ayah_number": 25,
    "global_ayah_id": 5825,
    "translation": "Questa non è parola di dèmone lapidato."
  },
  {
    "surah_id": 81,
    "ayah_number": 26,
    "global_ayah_id": 5826,
    "translation": "Dove andate dunque?"
  },
  {
    "surah_id": 81,
    "ayah_number": 27,
    "global_ayah_id": 5827,
    "translation": "Questo non è che un Monito rivolto al creato"
  },
  {
    "surah_id": 81,
    "ayah_number": 28,
    "global_ayah_id": 5828,
    "translation": "per chi di voi voglia seguire la Retta Via."
  },
  {
    "surah_id": 81,
    "ayah_number": 29,
    "global_ayah_id": 5829,
    "translation": "Ma voi lo vorrete solo se lo vorrà Allah, il Signore dei mondi."
  }
]