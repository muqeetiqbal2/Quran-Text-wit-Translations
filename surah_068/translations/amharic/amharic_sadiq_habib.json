[
  {
    "surah_id": 68,
    "ayah_number": 1,
    "global_ayah_id": 5272,
    "translation": "ነ.(ኑን)፤ በብርእ እምላለሁ በዚያም (መልአኮች) በሚጽፉት፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 2,
    "global_ayah_id": 5273,
    "translation": "አንተ በጌታህ ጸጋ የተጎናጸፍክ ስትኾን ዕብድ አይደለህም፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 3,
    "global_ayah_id": 5274,
    "translation": "ላንተም (ከጌታህ) የማይቋረጥ ዋጋ በእርግጥ አልለህ፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 4,
    "global_ayah_id": 5275,
    "translation": "አንተም በታላቅ ጠባይ ላይ ነህ፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 5,
    "global_ayah_id": 5276,
    "translation": "ወደፊትም ታያለህ፤ ያያሉም፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 6,
    "global_ayah_id": 5277,
    "translation": "ዕብደት በማንኛችሁ እንዳልለ፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 7,
    "global_ayah_id": 5278,
    "translation": "ጌታህ እርሱ ከመንገዱ የተሳሳተውን ሰው ዐዋቂ ነው፡፡ እርሱም ተመሪዎቹን ዐዋቂ ነው፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 8,
    "global_ayah_id": 5279,
    "translation": "ለአስተባባዮችም አትታዝዙ፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 9,
    "global_ayah_id": 5280,
    "translation": "ብትመሳሰላቸውና ቢመሳሰሉህ ተመኙ፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 10,
    "global_ayah_id": 5281,
    "translation": "ወራዳንም ሁሉ አትታዘዝ፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 11,
    "global_ayah_id": 5282,
    "translation": "ሰውን አነዋሪንና በማሳበቅ ኼያጅን፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 12,
    "global_ayah_id": 5283,
    "translation": "ለበጎ ነገር በጣም ከልካይን፣ ወሰን አላፊን፣ ኃጢአተኛን፤"
  },
  {
    "surah_id": 68,
    "ayah_number": 13,
    "global_ayah_id": 5284,
    "translation": "ልበ ደረቅን፣ ከዚህ በኋላ ዲቃላን (ሁሉ አትታዘዝ)፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 14,
    "global_ayah_id": 5285,
    "translation": "የገንዘብና የልጆች ባለቤት በመኾኑ (ያስተባብላል)፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 15,
    "global_ayah_id": 5286,
    "translation": "በእርሱ ላይ አንቀጾቻችን በሚነበቡ ጊዜ «የመጀመሪያዎቹ ሰዎች ተረቶች ናቸው» ይላል፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 16,
    "global_ayah_id": 5287,
    "translation": "በአፍንጫው ላይ በእርግጥ (የሚነወርበት) ምልክት እናደርግበታለን፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 17,
    "global_ayah_id": 5288,
    "translation": "እኛ የአትክልቲቱን ባለቤቶቸ እንደ ሞከርን (የመካን ሰዎች) ሞከርናቸው፡፡ ማልደው (ፍሬዋን) ሊለቅሟት በማሉ ጊዜ፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 18,
    "global_ayah_id": 5289,
    "translation": "(በመሓላቸው) አያስቀሩምም፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 19,
    "global_ayah_id": 5290,
    "translation": "እነርሱ የተኙ ኾነውም ሳሉ ከጌታህ የኾነ ዟሪ በእርሷ ላይ ዞረባት፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 20,
    "global_ayah_id": 5291,
    "translation": "እንደ ሌሊት ጨለማም ኾና አነጋች፤ (ከሰለች)፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 21,
    "global_ayah_id": 5292,
    "translation": "ያነጉም ኾነው ተጠራሩ፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 22,
    "global_ayah_id": 5293,
    "translation": "«ቆራጮች እንደ ኾናችሁ በእርሻቸሁ ላይ ማልዱ» በማለት፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 23,
    "global_ayah_id": 5294,
    "translation": "እነርሱ የሚንሾካሾኩ ኾነው ኼዱም፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 24,
    "global_ayah_id": 5295,
    "translation": "ዛሬ በእናንተ ላይ ድኻ እንዳይገባት በማለት፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 25,
    "global_ayah_id": 5296,
    "translation": "(ድኾችን) በመከልከልም ላይ (በሐሳባቸው) ቻዮች ኾነው ማለዱ፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 26,
    "global_ayah_id": 5297,
    "translation": "(ተቃጥላ) ባዩዋትም ጊዜ «እኛ በእርግጥ ተሳሳቾች ነን» አሉ፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 27,
    "global_ayah_id": 5298,
    "translation": "«ይልቁንም እኛ የተከለከልን ነን» አሉ፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 28,
    "global_ayah_id": 5299,
    "translation": "ትክክለኛቸው «ለእናንተ አላህን ለምን አታጠሩም አላልኳችሁምን?» አላቸው፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 29,
    "global_ayah_id": 5300,
    "translation": "«ጌታችን ጥራት ይገባው፡፡ እኛ በዳዮች ነበርን፤» አሉ፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 30,
    "global_ayah_id": 5301,
    "translation": "የሚወቃቀሱም ኾነው ከፊሎቻቸው በከፊሉ ላይ መጡ፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 31,
    "global_ayah_id": 5302,
    "translation": "«ዋ ጥፋታችን! እኛ ድንበር አላፊዎች ነበርን፤» አሉ፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 32,
    "global_ayah_id": 5303,
    "translation": "«ጌታችን ከእርሷ የተሻለን (አትክልት) ሊለውጠን ይከጀላል፡፡ እኛ ወደ ጌታችን ከጃዮች ነን፤» (አሉ)፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 33,
    "global_ayah_id": 5304,
    "translation": "ቅጣቱ እንደዚሁ ነው፡፡ የመጨረሻይቱም ዓለም ቅጣት ታላቅ ነው፡፡ የሚያውቁት በኾኑ ኖሮ (በተጠነቀቁ ነበር)፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 34,
    "global_ayah_id": 5305,
    "translation": "ለጥንቁቆቹ በጌታቸው ዘንድ መጠቀሚያ ገነቶች አሏቸው፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 35,
    "global_ayah_id": 5306,
    "translation": "ሙስሊሞቹን እንደ ከሓዲዎች እናደርጋለን?"
  },
  {
    "surah_id": 68,
    "ayah_number": 36,
    "global_ayah_id": 5307,
    "translation": "ለእናንተ ምን (አስረጅ) አላችሁ? እንዴት ትፈርዳላችሁ፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 37,
    "global_ayah_id": 5308,
    "translation": "በእውነቱ ለእናንተ በእርሱ የምታጠኑበት መጽሐፍ አላችሁን?"
  },
  {
    "surah_id": 68,
    "ayah_number": 38,
    "global_ayah_id": 5309,
    "translation": "በውስጡ ለእናንተ የምትመርጡት አላችሁ (የሚል)"
  },
  {
    "surah_id": 68,
    "ayah_number": 39,
    "global_ayah_id": 5310,
    "translation": "ወይስ ለእናንተ የምትፈርዱት አላችሁ በማለት (ቃል ኪዳን የገባንላችሁ) እስከ ትንሣኤ ቀን ደራሽ የኾኑ መሓላዎች ለእናንተ በእኛ ላይ አሏችሁን?"
  },
  {
    "surah_id": 68,
    "ayah_number": 40,
    "global_ayah_id": 5311,
    "translation": "በዚህ ማንኛቸው ተያያዥ እንደ ኾነ ጠይቃቸው፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 41,
    "global_ayah_id": 5312,
    "translation": "ወይስ ለእነርሱ (በፍርዳቸው ተስማሚ) «ተጋሪዎች» አሏቸውን? እውነተኞችም እንደኾኑ «ተጋሪዎቻቸውን» ያምጡ፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 42,
    "global_ayah_id": 5313,
    "translation": "ባት የሚገለጥበትን (ከሓዲዎች) ወደ መስገድም የሚጥጠሩበትንና የማይችሉበት ቀን (አስታውስ)፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 43,
    "global_ayah_id": 5314,
    "translation": "ዓይኖቻቸው የፈሩ ውርደት የምትሸፍናቸው ሲኾኑ፤ (ወደ ስግደት የሚጠሩበትን)፤ እነርሱም (በምድረ ዓለም) ደህና ኾነው ሳሉ ወደ ስግደት በእርግጥ ይጠሩ ነበሩ፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 44,
    "global_ayah_id": 5315,
    "translation": "በዚህም ንግግር ከሚያስተባብሉት ሰዎች ጋር ተዎኝ፡፡ (እነርሱን እኔ እበቃሃለሁ)፡፡ ከማያውቁት ስፍራ አዘናግተን እንይዛቸዋለን፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 45,
    "global_ayah_id": 5316,
    "translation": "እነርሱንም አዘገያለሁ፡፡ ዘዴዬ ብርቱ ነውና፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 46,
    "global_ayah_id": 5317,
    "translation": "በእውነቱ ዋጋን ትጠይቃቸዋለህን? ስለዚህ እነርሱ ከዕዳ የተከበዱ ናቸውን?"
  },
  {
    "surah_id": 68,
    "ayah_number": 47,
    "global_ayah_id": 5318,
    "translation": "ወይስ እነርሱ ዘንድ የሩቁ ምስጢር ዕውቀት አልለን? ስለዚህ እነርሱ ይጽፋሉን?"
  },
  {
    "surah_id": 68,
    "ayah_number": 48,
    "global_ayah_id": 5319,
    "translation": "ለጌታህም ፍርድ ታገሥ፤ (በመበሳጨትና ባለ መታገሥ) እንደ ዓሣው ባለቤትም (እንደ ዮናስ) አትኹን፡፡ እርሱ በጭንቀት የተመላ ኾኖ (ጌታውን) በተጣራ ጊዜ፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 49,
    "global_ayah_id": 5320,
    "translation": "ከጌታው የኾነ ጸጋ ባላገኘው ኖሮ በምድረ በዳ ተወቃሽ ኾኖ በተጣለ ነበር፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 50,
    "global_ayah_id": 5321,
    "translation": "ጌታውም (በነቢይነት) መረጠው፡፡ ከደጋጎቹም አደረገው፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 51,
    "global_ayah_id": 5322,
    "translation": "እነሆ እነዚያም የካዱት ሰዎች ቁርኣኑን በሰሙ ጊዜ በዓይኖቻቸው ሊጥሉህ (ሊያጠፉህ) ይቀርባሉ፡፡ «እርሱም በእርግጥ ዕብድ ነው» ይላሉ፡፡"
  },
  {
    "surah_id": 68,
    "ayah_number": 52,
    "global_ayah_id": 5323,
