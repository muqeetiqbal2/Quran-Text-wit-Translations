[
  {
    "surah_id": 70,
    "ayah_number": 1,
    "global_ayah_id": 5376,
    "translation": "한 질문자가 있을 응벌에 관하여 질문하였나니"
  },
  {
    "surah_id": 70,
    "ayah_number": 2,
    "global_ayah_id": 5377,
    "translation": "그것은 아무도 제지할 수 없 는 불신자들을 위한 응벌에 관한 것으로"
  },
  {
    "surah_id": 70,
    "ayah_number": 3,
    "global_ayah_id": 5378,
    "translation": "승천의 길 의 주님 하나님으 로부터의 응벌이라"
  },
  {
    "surah_id": 70,
    "ayah_number": 4,
    "global_ayah_id": 5379,
    "translation": "오만년과도 같은 하루 동안에천사들과 가브리엘 천사가 그분 께로 을라가니라"
  },
  {
    "surah_id": 70,
    "ayah_number": 5,
    "global_ayah_id": 5380,
    "translation": "그러므로 그대는 아름답게 인내하라"
  },
  {
    "surah_id": 70,
    "ayah_number": 6,
    "global_ayah_id": 5381,
    "translation": "실로 그들은 그것이 멀리 있 다 생각하고 있노라"
  },
  {
    "surah_id": 70,
    "ayah_number": 7,
    "global_ayah_id": 5382,
    "translation": "그러나 하나님은 그것이 가까 이 있음을 알고 계시니라"
  },
  {
    "surah_id": 70,
    "ayah_number": 8,
    "global_ayah_id": 5383,
    "translation": "그날에는 하늘이 용해된 구리 처럼 될 것이며"
  },
  {
    "surah_id": 70,
    "ayah_number": 9,
    "global_ayah_id": 5384,
    "translation": "산들이 양털처럼 될 것이며"
  },
  {
    "surah_id": 70,
    "ayah_number": 10,
    "global_ayah_id": 5385,
    "translation": "친구가 친구의 안부를 물을 수 없으며"
  },
  {
    "surah_id": 70,
    "ayah_number": 11,
    "global_ayah_id": 5386,
    "translation": "비록 그들이 서로가 서로를 안다하여도 그러할 것이며 죄인 들은 그날의 응벌을 피하기 위하 여 그의 자손이나"
  },
  {
    "surah_id": 70,
    "ayah_number": 12,
    "global_ayah_id": 5387,
    "translation": "그의 아내와 형제나"
  },
  {
    "surah_id": 70,
    "ayah_number": 13,
    "global_ayah_id": 5388,
    "translation": "그를 보호한 친척이나"
  },
  {
    "surah_id": 70,
    "ayah_number": 14,
    "global_ayah_id": 5389,
    "translation": "대지에 있는 모든 것을 바쳐그 응벌을 피하려 하도다"
  },
  {
    "surah_id": 70,
    "ayah_number": 15,
    "global_ayah_id": 5390,
    "translation": "그러나 결코 그렇게 될 수 없으며 불지옥이 있을 뿐으로"
  },
  {
    "surah_id": 70,
    "ayah_number": 16,
    "global_ayah_id": 5391,
    "translation": "머리부터 불태워지고"
  },
  {
    "surah_id": 70,
    "ayah_number": 17,
    "global_ayah_id": 5392,
    "translation": "외면하고 거역했던 자들을 부르며"
  },
  {
    "surah_id": 70,
    "ayah_number": 18,
    "global_ayah_id": 5393,
    "translation": "재물을 축적하여 감추었던 자들을 부르니라"
  },
  {
    "surah_id": 70,
    "ayah_number": 19,
    "global_ayah_id": 5394,
    "translation": "실로 인간은 창조되었으되 침착하지 못하고"
  },
  {
    "surah_id": 70,
    "ayah_number": 20,
    "global_ayah_id": 5395,
    "translation": "재앙이 이를 때면 크게 슬퍼 하며"
  },
  {
    "surah_id": 70,
    "ayah_number": 21,
    "global_ayah_id": 5396,
    "translation": "행운이 찾아들 때는 인색해 하더라"
  },
  {
    "surah_id": 70,
    "ayah_number": 22,
    "global_ayah_id": 5397,
    "translation": "그러나 예배에 충실한 자들 은 그렇지 아니하니"
  },
  {
    "surah_id": 70,
    "ayah_number": 23,
    "global_ayah_id": 5398,
    "translation": "항상 예배하는 그들이라"
  },
  {
    "surah_id": 70,
    "ayah_number": 24,
    "global_ayah_id": 5399,
    "translation": "그들의 재물은 정당한 것으로"
  },
  {
    "surah_id": 70,
    "ayah_number": 25,
    "global_ayah_id": 5400,
    "translation": "구하는 자들이나 구하지 아 니한 자들을 위해 사용하고"
  },
  {
    "surah_id": 70,
    "ayah_number": 26,
    "global_ayah_id": 5401,
    "translation": "심판의 날의 진리를 받으들 이며"
  },
  {
    "surah_id": 70,
    "ayah_number": 27,
    "global_ayah_id": 5402,
    "translation": "주님의 응벌을 두려워 하는 자들이라"
  },
  {
    "surah_id": 70,
    "ayah_number": 28,
    "global_ayah_id": 5403,
    "translation": "실로 하나님의 응벌은 불가 피한 것이되"
  },
  {
    "surah_id": 70,
    "ayah_number": 29,
    "global_ayah_id": 5404,
    "translation": "순결을 지키는 자들은 제외 라"
  },
  {
    "surah_id": 70,
    "ayah_number": 30,
    "global_ayah_id": 5405,
    "translation": "그러나 아내들과 그들의 오 른 손이 소유한 자들은 허락된 것이되"
  },
  {
    "surah_id": 70,
    "ayah_number": 31,
    "global_ayah_id": 5406,
    "translation": "그러나 이를 위반한 것은 불의한 자들이라"
  },
  {
    "surah_id": 70,
    "ayah_number": 32,
    "global_ayah_id": 5407,
    "translation": "신용을 지키고 약속을 이행 하는 자들과"
  },
  {
    "surah_id": 70,
    "ayah_number": 33,
    "global_ayah_id": 5408,
    "translation": "증언을 함에 정직한 자들과"
  },
  {
    "surah_id": 70,
    "ayah_number": 34,
    "global_ayah_id": 5409,
    "translation": "예배생활에 충실한 자들은"
  },
  {
    "surah_id": 70,
    "ayah_number": 35,
    "global_ayah_id": 5410,
    "translation": "축복받은 천국에 있게 되리라"
  },
  {
    "surah_id": 70,
    "ayah_number": 36,
    "global_ayah_id": 5411,
    "translation": "그러나 그대 주위를 급히 서둘러 돌진하는 불신자들에게는 어떤 일이 있겠느뇨"
  },
  {
    "surah_id": 70,
    "ayah_number": 37,
    "global_ayah_id": 5412,
    "translation": "오른쪽과 왼쪽에서 왜 떼지 어 앉아 있느뇨"
  },
  {
    "surah_id": 70,
    "ayah_number": 38,
    "global_ayah_id": 5413,
    "translation": "그들 각자는 축복받은 천국 으로 들어가려 갈망하느뇨"
  },
  {
    "surah_id": 70,
    "ayah_number": 39,
    "global_ayah_id": 5414,
    "translation": "결코 그렇게 될 수 없나니 하나님은 그들이 알고 있는 것으 로 창조하였노라"
  },
  {
    "surah_id": 70,
    "ayah_number": 40,
    "global_ayah_id": 5415,
    "translation": "동쪽과 서쪽의 주님께 맹세 하사 권세는 그분께 있노라"
  },
  {
    "surah_id": 70,
    "ayah_number": 41,
    "global_ayah_id": 5416,
    "translation": "그들보다 나은 다른 백성들 로 그들을 대체할 수 있으며 하나님은 그렇게 함에 부족함이 없노 라"
  },
  {
    "surah_id": 70,
    "ayah_number": 42,
    "global_ayah_id": 5417,
    "translation": "그러므로 그들이 무익한 대 화에 빠져 그들이 약속받은 그날 에 직면할 때까지 만끽하도록 버 려두라"
  },
  {
    "surah_id": 70,
    "ayah_number": 43,
    "global_ayah_id": 5418,
    "translation": "그들이 그들의 무덤으로 부 터 서들러 나오는 그날 그들은 마치 서둘러 우상에게로 가는 것 같더라"
  },
  {
    "surah_id": 70,
    "ayah_number": 44,
    "global_ayah_id": 5419,
    "translation": "실의에 빠진 그들의 눈들은 아래로 내려져 있으며 수치가 그 들을 에워싸니 그러함이 그들이 약속받은 날이라"
  }
]