[
  {
    "surah_id": 70,
    "ayah_number": 1,
    "global_ayah_id": 5376,
    "translation": "ወዳቂ ከኾነው ቅጣት ጠያቂ ጠየቀ፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 2,
    "global_ayah_id": 5377,
    "translation": "በከሓዲዎች ላይ (ወዳቂ ከኾነው) ለእርሱ መላሽ የለውም፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 3,
    "global_ayah_id": 5378,
    "translation": "የ(ሰማያት) መሰላሎች ባለቤት ከኾነው አላህ (መላሽ የለውም)፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 4,
    "global_ayah_id": 5379,
    "translation": "መላእክቱና መንፈሱም ልኩ አምሳ ሺሕ ዓመት በኾነ ቀን ውስጥ ወደእርሱ ያርጋሉ፤ (ይወጣሉ)፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 5,
    "global_ayah_id": 5380,
    "translation": "መልካምንም ትዕግስት ታገሥ፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 6,
    "global_ayah_id": 5381,
    "translation": "እነርሱ (ያንን ቀን) ሩቅ አድርገው ያዩታል፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 7,
    "global_ayah_id": 5382,
    "translation": "እኛም ቅርብ ኾኖ እናየዋለን፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 8,
    "global_ayah_id": 5383,
    "translation": "ሰማይ እንደ ዘይት አተላ በምትኾንበት ቀን፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 9,
    "global_ayah_id": 5384,
    "translation": "ጋራዎችም በተለያዩ ቀለማት እንደ ተነከረ ሱፍ (ነፋስ እንደሚያበረው) በሚኾኑበት ቀን፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 10,
    "global_ayah_id": 5385,
    "translation": "ዘመድም ዘመድን በማይጠይቅበት ቀን፤ (መላሽ የለውም)፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 11,
    "global_ayah_id": 5386,
    "translation": "(ዘመዶቻቸውን) ያዩዋቸዋል፡፡ አመጸኛው ከዚያ ቀን ስቃይ (ነፍሱን) በልጆቹ ሊበዥ ይመኛል፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 12,
    "global_ayah_id": 5387,
    "translation": "በሚስቱም በወንድሙም፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 13,
    "global_ayah_id": 5388,
    "translation": "በዚያችም በምታስጠጋው ጎሳው፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 14,
    "global_ayah_id": 5389,
    "translation": "በምድርም ላይ ባለው ሁሉ (ሊበዥ) ከዚያም ሊያድነው (ይመኛል)፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 15,
    "global_ayah_id": 5390,
    "translation": "ይተው! እርሷ (እሳቲቱ) ለዟ ናት፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 16,
    "global_ayah_id": 5391,
    "translation": "የራስን ቅል ቆዳ የምትሞሽልቅ ስትኾን፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 17,
    "global_ayah_id": 5392,
    "translation": "(ከእምነት) የዞረንና የሸሸን ሰው (ወደእርሷ) ትጠራለች፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 18,
    "global_ayah_id": 5393,
    "translation": "ገንዘብን የሰበሰበንና (ዘካውን ሳይሰጥ) የቆጠረንም፤ (ትጠራለች)፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 19,
    "global_ayah_id": 5394,
    "translation": "ሰው ቅጠ ቢስ ኾኖ ተፈጠረ፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 20,
    "global_ayah_id": 5395,
    "translation": "ክፉ ነገር ባገኘው ጊዜ ብስጪተኛ፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 21,
    "global_ayah_id": 5396,
    "translation": "መልካምም ነገር (ድሎት) ባገኘ ጊዜ ከልካይ (ኾኖ ተፈጠረ)፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 22,
    "global_ayah_id": 5397,
    "translation": "ሰጋጆቹ ብቻ ሲቀሩ፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 23,
    "global_ayah_id": 5398,
    "translation": "እነዚያ እነርሱ በስግደታቸው ላይ ዘውታሪዎች የኾኑት፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 24,
    "global_ayah_id": 5399,
    "translation": "እነዚያም በገንዘቦቻቸው ላይ የታወቀ መብት ያለባቸው የኾኑት፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 25,
    "global_ayah_id": 5400,
    "translation": "ለለማኝ ከልመና ለሚከለከልም (መብት ያለባቸው የኾኑት)፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 26,
    "global_ayah_id": 5401,
    "translation": "እነዚያም በፍርዱ ቀን እውነት የሚሉት (የሚያረጋግጡት)፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 27,
    "global_ayah_id": 5402,
    "translation": "እነዚያም እነርሱ ከጌታቸው ቅጣት ፈሪዎች የኾኑት፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 28,
    "global_ayah_id": 5403,
    "translation": "የጌታቸው ቅጣት (መምጣቱ) የማያስተማምን ነውና፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 29,
    "global_ayah_id": 5404,
    "translation": "እነዚያም እነርሱ ብልቶቻቸውን ጠባቂዎች የኾኑት፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 30,
    "global_ayah_id": 5405,
    "translation": "በሚስቶቻቸው ወይም እጆቻቸው በያዙዋቸው (ባሪያዎች) ላይ ሲቀር፡፡ እነርሱ (በእነዚህ) የማይወቀሱ ናቸውና፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 31,
    "global_ayah_id": 5406,
    "translation": "ከዚያም ወዲያ የፈለገ ሰው እነዚያ እነሱ ድንበር አላፊዎች ናቸው፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 32,
    "global_ayah_id": 5407,
    "translation": "እነዚያም እነርሱ አደራዎቻቸውንና ቃል ኪዳናቸውን ጠባቂዎች የኾኑት፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 33,
    "global_ayah_id": 5408,
    "translation": "እነዚያም እነርሱ በምስክርነታቸው ትክክለኞች የኾኑት፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 34,
    "global_ayah_id": 5409,
    "translation": "እነዚያም እነርሱ በሶላቶቻቸው ላይ የሚጠባበቁት፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 35,
    "global_ayah_id": 5410,
    "translation": "እነዚህ (ከዚህ በላይ የተወሱት ሁሉ) በገነቶች ውስጥ የሚከበሩ ናቸው፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 36,
    "global_ayah_id": 5411,
    "translation": "ለእነዚያም ለካዱት ወደ አንተ በኩል አንገቶቻቸውን መዝዘው የሚያተኩሩት ምን አላቸው?"
  },
  {
    "surah_id": 70,
    "ayah_number": 37,
    "global_ayah_id": 5412,
    "translation": "ከቀኝና ከግራ ክፍልፍል ጭፍሮች ሲኾኑ፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 38,
    "global_ayah_id": 5413,
    "translation": "ከእነርሱ እያንዳንዱ ሰው የጸጋይቱን ገነት መግባትን ይከጅላልን?"
  },
  {
    "surah_id": 70,
    "ayah_number": 39,
    "global_ayah_id": 5414,
    "translation": "ይከልከል፤ እኛ ከሚያውቁት ነገር (ከፍቶት ጠብታ) ፈጠርናቸው፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 40,
    "global_ayah_id": 5415,
    "translation": "በምሥራቆችና በምዕራቦችም ጌታ እምላለሁ፡፡ እኛ በእርግጥ ቻዮች ነን፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 41,
    "global_ayah_id": 5416,
    "translation": "ከእነርሱ የተሻለን በመለወጥ ላይ፡፡ እኛም ተሸናፊዎች አይደለንም፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 42,
    "global_ayah_id": 5417,
    "translation": "ያንንም የሚስፈራሩበትን ቀናቸውን እስከሚገናኙ ድረስ ተዋቸው፡፡ ይዋኙ ይጫወቱም፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 43,
    "global_ayah_id": 5418,
    "translation": "ወደ ጣዖቶች እንደሚሽቀዳደሙ ኾነው ከመቃብሮቻቸው ፈጥነው የሚወጡበትን ቀን (እስከሚገናኙ ድረስ ተዋቸው)፡፡"
  },
  {
    "surah_id": 70,
    "ayah_number": 44,
    "global_ayah_id": 5419,
    "translation": "ዓይኖቻቸው ያፈሩ ኾነው ውርደት ትሸፍናቸዋለች፡፡ ይህ ቀን ያ ይስፈራሩበት የነበሩት ነው፡፡"
  }
]