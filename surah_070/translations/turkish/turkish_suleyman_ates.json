[
  {
    "surah_id": 70,
    "ayah_number": 1,
    "global_ayah_id": 5376,
    "translation": "Bir soran, inecek azabı sordu:"
  },
  {
    "surah_id": 70,
    "ayah_number": 2,
    "global_ayah_id": 5377,
    "translation": "Kafirler için, ki onu savacak yoktur,"
  },
  {
    "surah_id": 70,
    "ayah_number": 3,
    "global_ayah_id": 5378,
    "translation": "Yükselme derecelerinin sahibi Allah'tan."
  },
  {
    "surah_id": 70,
    "ayah_number": 4,
    "global_ayah_id": 5379,
    "translation": "Melekler ve Ruh, miktarı elli bin yıl süren bir gün içinde O'na çıkar."
  },
  {
    "surah_id": 70,
    "ayah_number": 5,
    "global_ayah_id": 5380,
    "translation": "Şimdi sen güzelce sabret."
  },
  {
    "surah_id": 70,
    "ayah_number": 6,
    "global_ayah_id": 5381,
    "translation": "Onlar onu uzak görüyor(lar)."
  },
  {
    "surah_id": 70,
    "ayah_number": 7,
    "global_ayah_id": 5382,
    "translation": "Biz ise onu yakın görüyoruz."
  },
  {
    "surah_id": 70,
    "ayah_number": 8,
    "global_ayah_id": 5383,
    "translation": "O gün gök, erimiş maden gibi olur."
  },
  {
    "surah_id": 70,
    "ayah_number": 9,
    "global_ayah_id": 5384,
    "translation": "Dağlar, renkli yün gibi olur."
  },
  {
    "surah_id": 70,
    "ayah_number": 10,
    "global_ayah_id": 5385,
    "translation": "Dost dostun halini sormaz."
  },
  {
    "surah_id": 70,
    "ayah_number": 11,
    "global_ayah_id": 5386,
    "translation": "Birbirlerine gösterilirler (fakat herkes kendi derdine düştüğünden, başkasıyle ilgilenemez). Suçlu ister ki o günün azabından (kurtulmak için) fidye versin: Oğullarını,"
  },
  {
    "surah_id": 70,
    "ayah_number": 12,
    "global_ayah_id": 5387,
    "translation": "Eşini ve kardeşini,"
  },
  {
    "surah_id": 70,
    "ayah_number": 13,
    "global_ayah_id": 5388,
    "translation": "Kendisini barındıran, içinde yetiştiği tüm ailesini,"
  },
  {
    "surah_id": 70,
    "ayah_number": 14,
    "global_ayah_id": 5389,
    "translation": "Ve yeryüzünde bulunanların hepsini (versin) de tek kendisini kurtarsın."
  },
  {
    "surah_id": 70,
    "ayah_number": 15,
    "global_ayah_id": 5390,
    "translation": "Hayır! O (ateş), alevlenen bir ateştir."
  },
  {
    "surah_id": 70,
    "ayah_number": 16,
    "global_ayah_id": 5391,
    "translation": "Derileri kavurur, soyar."
  },
  {
    "surah_id": 70,
    "ayah_number": 17,
    "global_ayah_id": 5392,
    "translation": "(Kendine) Çağırır; sırtını dönüp gideni,"
  },
  {
    "surah_id": 70,
    "ayah_number": 18,
    "global_ayah_id": 5393,
    "translation": "(Mal) Toplayıp kasada yığanı!"
  },
  {
    "surah_id": 70,
    "ayah_number": 19,
    "global_ayah_id": 5394,
    "translation": "Doğrusu insan hırslı (ve huysuz) yaratılmıştır."
  },
  {
    "surah_id": 70,
    "ayah_number": 20,
    "global_ayah_id": 5395,
    "translation": "Kendisine kötülük dokundu mu sızlanır,"
  },
  {
    "surah_id": 70,
    "ayah_number": 21,
    "global_ayah_id": 5396,
    "translation": "Kendisine hayır dokundu mu yardım etmez (sıkı sıkı tutar)."
  },
  {
    "surah_id": 70,
    "ayah_number": 22,
    "global_ayah_id": 5397,
    "translation": "Ancak namaz kılanlar bunun dışındadır."
  },
  {
    "surah_id": 70,
    "ayah_number": 23,
    "global_ayah_id": 5398,
    "translation": "Onlar ki: Namazlarını sürekli kılarlar (aksatmazlar)."
  },
  {
    "surah_id": 70,
    "ayah_number": 24,
    "global_ayah_id": 5399,
    "translation": "Onların mallarında belli bir hisse vardır:"
  },
  {
    "surah_id": 70,
    "ayah_number": 25,
    "global_ayah_id": 5400,
    "translation": "Saile ve mahruma (isteyene ve utancından dolayı istemeyip mahrum kalana)."
  },
  {
    "surah_id": 70,
    "ayah_number": 26,
    "global_ayah_id": 5401,
    "translation": "Ceza gününü tasdik ederler,"
  },
  {
    "surah_id": 70,
    "ayah_number": 27,
    "global_ayah_id": 5402,
    "translation": "Rablerinin azabından korkarlar."
  },
  {
    "surah_id": 70,
    "ayah_number": 28,
    "global_ayah_id": 5403,
    "translation": "Çünkü Rablerinin azabına güven olmaz."
  },
  {
    "surah_id": 70,
    "ayah_number": 29,
    "global_ayah_id": 5404,
    "translation": "Irzlarını korurlar."
  },
  {
    "surah_id": 70,
    "ayah_number": 30,
    "global_ayah_id": 5405,
    "translation": "Yalnız eşlerine, ya da ellerinin altında bulunan(cariyelerin)e karşı (korumazlar. Bundan ötürü de) onlar kınanmazlar."
  },
  {
    "surah_id": 70,
    "ayah_number": 31,
    "global_ayah_id": 5406,
    "translation": "Ama kim bundan ötesini ararsa, onlar (sınırı) aşanlardır."
  },
  {
    "surah_id": 70,
    "ayah_number": 32,
    "global_ayah_id": 5407,
    "translation": "Emanetlerini ve ahidlerini gözetirler."
  },
  {
    "surah_id": 70,
    "ayah_number": 33,
    "global_ayah_id": 5408,
    "translation": "Şahidliklerini yaparlar."
  },
  {
    "surah_id": 70,
    "ayah_number": 34,
    "global_ayah_id": 5409,
    "translation": "Namazlarını korurlar."
  },
  {
    "surah_id": 70,
    "ayah_number": 35,
    "global_ayah_id": 5410,
    "translation": "İşte onlar cennetlerde ağırlanırlar."
  },
  {
    "surah_id": 70,
    "ayah_number": 36,
    "global_ayah_id": 5411,
    "translation": "Nankörlere ne oluyur ki sana doğru koşuyorlar?"
  },
  {
    "surah_id": 70,
    "ayah_number": 37,
    "global_ayah_id": 5412,
    "translation": "Sağdan, soldan, ayrı ayrı gruplar halinde (gelip etrafını sarıyorlar)?"
  },
  {
    "surah_id": 70,
    "ayah_number": 38,
    "global_ayah_id": 5413,
    "translation": "Onlardan her biri, ni'met cennetine sokulacağını mı umuyor?"
  },
  {
    "surah_id": 70,
    "ayah_number": 39,
    "global_ayah_id": 5414,
    "translation": "Hayır! Öyle şey yok! Biz onları bildikleri şeyden yarattık."
  },
  {
    "surah_id": 70,
    "ayah_number": 40,
    "global_ayah_id": 5415,
    "translation": "Yoo, doğuların ve batıların Rabbine yemin ederim ki bizim gücümüz yeter:"
  },
  {
    "surah_id": 70,
    "ayah_number": 41,
    "global_ayah_id": 5416,
    "translation": "Onları, kendilerinden daha hayırlı olanlarla değiştirmeğe. Bizim önümüze geçilmez (bize engel olunamaz)."
  },
  {
    "surah_id": 70,
    "ayah_number": 42,
    "global_ayah_id": 5417,
    "translation": "Bırak onları kendilerine va'dedilen günlerine kavuşuncaya kadar dalsın, oynasınlar."
  },
  {
    "surah_id": 70,
    "ayah_number": 43,
    "global_ayah_id": 5418,
    "translation": "O gün kabirlerden hızlı hızlı çıkarlar. Onlar dikilen(putlara yahut hedef)lere doğru koşar gibi (koşarlar)."
  },
  {
    "surah_id": 70,
    "ayah_number": 44,
    "global_ayah_id": 5419,
    "translation": "Gözleri düşük, yüzlerini alçaklık bürümüş bir durumda. İşte onlara va'dedilen gün, bugündür."
  }
]