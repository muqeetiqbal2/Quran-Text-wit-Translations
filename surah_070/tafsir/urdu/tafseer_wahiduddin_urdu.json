  {
    "surah_id": 70,
    "ayah_number": 35,
    "global_ayah_id": 5479,
    "tafseer": "ان آیات میں مختصر طور پر دونوں قسم کے انسانوں کی صفات بیان کر دی گئی ہیں۔ ان لوگوں کی بھی جو جنت میں داخل کيے جانے کے مستحق قرار پائیں گے اور ان لوگوں کی بھی جن کے اعمال انھیں قیامت کے دن جہنم میں گرانے کا سبب بنیں گے۔"
  },
