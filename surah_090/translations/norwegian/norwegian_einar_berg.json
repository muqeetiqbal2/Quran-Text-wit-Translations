[
  {
    "surah_id": 90,
    "ayah_number": 1,
    "global_ayah_id": 6024,
    "translation": "Nei, sannelig, jeg sverger ved denne byen,"
  },
  {
    "surah_id": 90,
    "ayah_number": 2,
    "global_ayah_id": 6025,
    "translation": "og du bor jo i denne byen,"
  },
  {
    "surah_id": 90,
    "ayah_number": 3,
    "global_ayah_id": 6026,
    "translation": "og ved en far og hans avkom!"
  },
  {
    "surah_id": 90,
    "ayah_number": 4,
    "global_ayah_id": 6027,
    "translation": "Vi har visselig skapt mennesket til møye."
  },
  {
    "surah_id": 90,
    "ayah_number": 5,
    "global_ayah_id": 6028,
    "translation": "Tror han ikke at noen har makt over ham?"
  },
  {
    "surah_id": 90,
    "ayah_number": 6,
    "global_ayah_id": 6029,
    "translation": "Han sier: «Jeg har satt over styr rikdom i massevis.»"
  },
  {
    "surah_id": 90,
    "ayah_number": 7,
    "global_ayah_id": 6030,
    "translation": "Tror han at ingen har sett ham?"
  },
  {
    "surah_id": 90,
    "ayah_number": 8,
    "global_ayah_id": 6031,
    "translation": "Har Vi ikke gitt ham to øyne,"
  },
  {
    "surah_id": 90,
    "ayah_number": 9,
    "global_ayah_id": 6032,
    "translation": "tunge, og to lepper."
  },
  {
    "surah_id": 90,
    "ayah_number": 10,
    "global_ayah_id": 6033,
    "translation": "Har Vi ikke vist ham de to veier?"
  },
  {
    "surah_id": 90,
    "ayah_number": 11,
    "global_ayah_id": 6034,
    "translation": "Men han gav seg ikke i kast med den trange og bratte."
  },
  {
    "surah_id": 90,
    "ayah_number": 12,
    "global_ayah_id": 6035,
    "translation": "Vet du da hva den trange vei er?"
  },
  {
    "surah_id": 90,
    "ayah_number": 13,
    "global_ayah_id": 6036,
    "translation": "Det er å skaffe en slave frihet,"
  },
  {
    "surah_id": 90,
    "ayah_number": 14,
    "global_ayah_id": 6037,
    "translation": "og på hungerens dag å gi mat"
  },
  {
    "surah_id": 90,
    "ayah_number": 15,
    "global_ayah_id": 6038,
    "translation": "til en foreldreløs slektning,"
  },
  {
    "surah_id": 90,
    "ayah_number": 16,
    "global_ayah_id": 6039,
    "translation": "eller til en fattig stakkar,"
  },
  {
    "surah_id": 90,
    "ayah_number": 17,
    "global_ayah_id": 6040,
    "translation": "og så være av dem som tror, og som anbefaler hverandre standhaftighet, og råder hverandre til medfølelse."
  },
  {
    "surah_id": 90,
    "ayah_number": 18,
    "global_ayah_id": 6041,
    "translation": "Dette er høyre hånds folk!"
  },
  {
    "surah_id": 90,
    "ayah_number": 19,
    "global_ayah_id": 6042,
    "translation": "Men de som fornekter Vårt ord, de er venstre hånds folk."
  },
  {
    "surah_id": 90,
    "ayah_number": 20,
    "global_ayah_id": 6043,
    "translation": "Over dem hvelver seg Ild."
  }
]