[
  {
    "surah_id": 90,
    "ayah_number": 1,
    "global_ayah_id": 6024,
    "translation": "سوگند به اين شهر،"
  },
  {
    "surah_id": 90,
    "ayah_number": 2,
    "global_ayah_id": 6025,
    "translation": "و حال آنكه تو در اين شهر جاى دارى؛"
  },
  {
    "surah_id": 90,
    "ayah_number": 3,
    "global_ayah_id": 6026,
    "translation": "سوگند به پدرى [چنان‌] و آن كسى را كه به وجود آورد؛"
  },
  {
    "surah_id": 90,
    "ayah_number": 4,
    "global_ayah_id": 6027,
    "translation": "براستى كه انسان را در رنج آفريده‌ايم."
  },
  {
    "surah_id": 90,
    "ayah_number": 5,
    "global_ayah_id": 6028,
    "translation": "آيا پندارد كه هيچ كس هرگز بر او دست نتواند يافت؟"
  },
  {
    "surah_id": 90,
    "ayah_number": 6,
    "global_ayah_id": 6029,
    "translation": "گويد: «مال فراوانى تباه كردم.»"
  },
  {
    "surah_id": 90,
    "ayah_number": 7,
    "global_ayah_id": 6030,
    "translation": "آيا پندارد كه هيچ كس او را نديده است؟"
  },
  {
    "surah_id": 90,
    "ayah_number": 8,
    "global_ayah_id": 6031,
    "translation": "آيا دو چشمش نداده‌ايم؟"
  },
  {
    "surah_id": 90,
    "ayah_number": 9,
    "global_ayah_id": 6032,
    "translation": "و زبانى و دو لب."
  },
  {
    "surah_id": 90,
    "ayah_number": 10,
    "global_ayah_id": 6033,
    "translation": "و هر دو راه [خير و شر] را بدو نموديم."
  },
  {
    "surah_id": 90,
    "ayah_number": 11,
    "global_ayah_id": 6034,
    "translation": "و[لى‌] نخواست از گردنه [عاقبت‌نگرى‌] بالا رود!"
  },
  {
    "surah_id": 90,
    "ayah_number": 12,
    "global_ayah_id": 6035,
    "translation": "و تو چه دانى كه آن گردنه [سخت‌] چيست؟"
  },
  {
    "surah_id": 90,
    "ayah_number": 13,
    "global_ayah_id": 6036,
    "translation": "بنده‌اى را آزادكردن،"
  },
  {
    "surah_id": 90,
    "ayah_number": 14,
    "global_ayah_id": 6037,
    "translation": "يا در روز گرسنگى، طعام‌دادن:"
  },
  {
    "surah_id": 90,
    "ayah_number": 15,
    "global_ayah_id": 6038,
    "translation": "به يتيمى خويشاوند،"
  },
  {
    "surah_id": 90,
    "ayah_number": 16,
    "global_ayah_id": 6039,
    "translation": "يا بينوايى خاك‌نشين."
  },
  {
    "surah_id": 90,
    "ayah_number": 17,
    "global_ayah_id": 6040,
    "translation": "علاوه بر اين از زمره كسانى باشد كه گرويده و يكديگر را به شكيبايى و مهربانى سفارش كرده‌اند؛"
  },
  {
    "surah_id": 90,
    "ayah_number": 18,
    "global_ayah_id": 6041,
    "translation": "اينانند خجستگان."
  },
  {
    "surah_id": 90,
    "ayah_number": 19,
    "global_ayah_id": 6042,
    "translation": "و كسانى كه به انكار نشانه‌هاى ما پرداخته‌اند، آنانند ناخجستگان شوم."
  },
  {
    "surah_id": 90,
    "ayah_number": 20,
    "global_ayah_id": 6043,
    "translation": "بر آنان آتشى سرپوشيده احاطه دارد."
  }
]