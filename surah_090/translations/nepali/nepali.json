[
  {
    "surah_id": 90,
    "ayah_number": 0,
    "global_ayah_id": 6112,
    "translation": "शुरु अत्यन्त करुणामय, परम दयालु अल्लाहको नामबाट ।"
  },
  {
    "surah_id": 90,
    "ayah_number": 1,
    "global_ayah_id": 6113,
    "translation": "होइन, म यस नगरको कसम खान्छु"
  },
  {
    "surah_id": 90,
    "ayah_number": 2,
    "global_ayah_id": 6114,
    "translation": "जबकि तिमी यस नगरमा बस्दछौ ।"
  },
  {
    "surah_id": 90,
    "ayah_number": 3,
    "global_ayah_id": 6115,
    "translation": "र, बाबु र सन्तानको कसम"
  },
  {
    "surah_id": 90,
    "ayah_number": 4,
    "global_ayah_id": 6116,
    "translation": "निस्सन्देह हामीले मानवलाई कष्टमा सृष्टि गरेका छौं ।"
  },
  {
    "surah_id": 90,
    "ayah_number": 5,
    "global_ayah_id": 6117,
    "translation": "के कसैले उसलाई नियन्त्रणमा लिन सक्दैन भनी ठान्दछ ?"
  },
  {
    "surah_id": 90,
    "ayah_number": 6,
    "global_ayah_id": 6118,
    "translation": "भन्छ– मैले त धेरै धन–सम्पत्ति खर्च गरेँ ।"
  },
  {
    "surah_id": 90,
    "ayah_number": 7,
    "global_ayah_id": 6119,
    "translation": "के कसैले उसलाई देखेकै छैन भनी ठान्दछ ?"
  },
  {
    "surah_id": 90,
    "ayah_number": 8,
    "global_ayah_id": 6120,
    "translation": "के हामीले दिएनौं उसलाई दुईवटा आँखाहरू ?"
  },
  {
    "surah_id": 90,
    "ayah_number": 9,
    "global_ayah_id": 6121,
    "translation": "र एउटा जिब्रो र दुईटा ओठहरू ?"
  },
  {
    "surah_id": 90,
    "ayah_number": 10,
    "global_ayah_id": 6122,
    "translation": "र, हामीले नै उसलाई दुईटै मार्ग देखायौं ।"
  },
  {
    "surah_id": 90,
    "ayah_number": 11,
    "global_ayah_id": 6123,
    "translation": "तर ऊ अकबामा पस्न सकेन ।"
  },
  {
    "surah_id": 90,
    "ayah_number": 12,
    "global_ayah_id": 6124,
    "translation": "र ‘अकबा’ के हो तिमीलाई के थाहा ?"
  },
  {
    "surah_id": 90,
    "ayah_number": 13,
    "global_ayah_id": 6125,
    "translation": "घाँटीलाई मुक्त गर्नु ।"
  },
  {
    "surah_id": 90,
    "ayah_number": 14,
    "global_ayah_id": 6126,
    "translation": "वा भोको भएको दिन खाना खुवाउनु"
  },
  {
    "surah_id": 90,
    "ayah_number": 15,
    "global_ayah_id": 6127,
    "translation": "कुनै नातेदार अनाथलाई"
  },
  {
    "surah_id": 90,
    "ayah_number": 16,
    "global_ayah_id": 6128,
    "translation": "वा दुर्दशाग्रस्त गरिबलाई"
  },
  {
    "surah_id": 90,
    "ayah_number": 17,
    "global_ayah_id": 6129,
    "translation": "फेरि त्यो व्यक्ति ती व्यक्तिहरूमध्ये होओस् जो ईमान ल्याउँछ र परस्पर धैर्य धारण गर्न र एक अर्कालाई दया गर्न उपदेश दिन्छ ।"
  },
  {
    "surah_id": 90,
    "ayah_number": 18,
    "global_ayah_id": 6130,
    "translation": "उनीहरू नै हुन् सौभाग्यशाली ।"
  },
  {
    "surah_id": 90,
    "ayah_number": 19,
    "global_ayah_id": 6131,
    "translation": "र, जसले हाम्रा आयतहरुको इन्कार गरे तिनीहरू नै हुन् अभागी ।"
  },
  {
    "surah_id": 90,
    "ayah_number": 20,
    "global_ayah_id": 6132,
    "translation": "उनीहरूमाथि चारैतिरबाट बन्द गरिएको आगो हुनेछ ।"
  }
]