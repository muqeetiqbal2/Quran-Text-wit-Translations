[
  {
    "surah_id": 90,
    "ayah_number": 1,
    "global_ayah_id": 6024,
    "translation": "我以這個地方盟誓——"
  },
  {
    "surah_id": 90,
    "ayah_number": 2,
    "global_ayah_id": 6025,
    "translation": "你將在那裡，不受羈束——"
  },
  {
    "surah_id": 90,
    "ayah_number": 3,
    "global_ayah_id": 6026,
    "translation": "我以一個父親和他所生的子孫盟誓，"
  },
  {
    "surah_id": 90,
    "ayah_number": 4,
    "global_ayah_id": 6027,
    "translation": "我確已把人創造在苦難裡。"
  },
  {
    "surah_id": 90,
    "ayah_number": 5,
    "global_ayah_id": 6028,
    "translation": "他以為任何人都不能制裁他嗎？"
  },
  {
    "surah_id": 90,
    "ayah_number": 6,
    "global_ayah_id": 6029,
    "translation": "他說：「我花費了許多財產！」"
  },
  {
    "surah_id": 90,
    "ayah_number": 7,
    "global_ayah_id": 6030,
    "translation": "他以為任何人都沒有看見他嗎？"
  },
  {
    "surah_id": 90,
    "ayah_number": 8,
    "global_ayah_id": 6031,
    "translation": "難道我沒有為他創造兩隻眼睛、"
  },
  {
    "surah_id": 90,
    "ayah_number": 9,
    "global_ayah_id": 6032,
    "translation": "一條舌頭、兩片嘴唇，"
  },
  {
    "surah_id": 90,
    "ayah_number": 10,
    "global_ayah_id": 6033,
    "translation": "並指示他兩條明顯的道路嗎？"
  },
  {
    "surah_id": 90,
    "ayah_number": 11,
    "global_ayah_id": 6034,
    "translation": "他怎麼不超越山徑呢？"
  },
  {
    "surah_id": 90,
    "ayah_number": 12,
    "global_ayah_id": 6035,
    "translation": "你怎能知道超越山徑是什麼事？"
  },
  {
    "surah_id": 90,
    "ayah_number": 13,
    "global_ayah_id": 6036,
    "translation": "是釋放奴隸，"
  },
  {
    "surah_id": 90,
    "ayah_number": 14,
    "global_ayah_id": 6037,
    "translation": "或在饑荒日賑濟"
  },
  {
    "surah_id": 90,
    "ayah_number": 15,
    "global_ayah_id": 6038,
    "translation": "親戚的孤兒，"
  },
  {
    "surah_id": 90,
    "ayah_number": 16,
    "global_ayah_id": 6039,
    "translation": "或困窮的貧民；"
  },
  {
    "surah_id": 90,
    "ayah_number": 17,
    "global_ayah_id": 6040,
    "translation": "同時，他是一個信道而且行善，並以堅忍相勉，以慈憫相助者。"
  },
  {
    "surah_id": 90,
    "ayah_number": 18,
    "global_ayah_id": 6041,
    "translation": "這等人是幸福的。"
  },
  {
    "surah_id": 90,
    "ayah_number": 19,
    "global_ayah_id": 6042,
    "translation": "不信我的跡象者，是薄命的，"
  },
  {
    "surah_id": 90,
    "ayah_number": 20,
    "global_ayah_id": 6043,
    "translation": "他們將被關在火獄裡。"
  }
]