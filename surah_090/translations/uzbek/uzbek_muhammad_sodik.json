[
  {
    "surah_id": 90,
    "ayah_number": 1,
    "global_ayah_id": 6024,
    "translation": "Мана шу шаҳар билан қасам."
  },
  {
    "surah_id": 90,
    "ayah_number": 2,
    "global_ayah_id": 6025,
    "translation": "Сен муқим турган бу шаҳарла."
  },
  {
    "surah_id": 90,
    "ayah_number": 3,
    "global_ayah_id": 6026,
    "translation": "Ва волид ва ундан тарқаган валадлар билан қасам."
  },
  {
    "surah_id": 90,
    "ayah_number": 4,
    "global_ayah_id": 6027,
    "translation": "Батаҳқиқ, Биз инсонни машаққатда яратдик."
  },
  {
    "surah_id": 90,
    "ayah_number": 5,
    "global_ayah_id": 6028,
    "translation": "У инсон унга ҳеч кимнинг кучи етмайди, деб ҳисоблайдими?"
  },
  {
    "surah_id": 90,
    "ayah_number": 6,
    "global_ayah_id": 6029,
    "translation": "У, кўплаб мол-дунё нафақа қилдим, дейдир. (Мол-дунё билан ғурурга кетганларга яхшилик йўлида эҳсон қил, деб айтилса, юқоридаги гапни айтишади. Ваҳоланки, яхшилик йўлида ҳеч нарса сарфламаган бўлади.)"
  },
  {
    "surah_id": 90,
    "ayah_number": 7,
    "global_ayah_id": 6030,
    "translation": "У инсон уни биров кўрмади, деб ўйлайдими?"
  },
  {
    "surah_id": 90,
    "ayah_number": 8,
    "global_ayah_id": 6031,
    "translation": "Биз унга икки кўзни бермадикми?"
  },
  {
    "surah_id": 90,
    "ayah_number": 9,
    "global_ayah_id": 6032,
    "translation": "Ва тилни ва икки лабни (бермадикми?)"
  },
  {
    "surah_id": 90,
    "ayah_number": 10,
    "global_ayah_id": 6033,
    "translation": "Ва Биз уни икки: (яхши ва ёмон) йўлга йўллаб қўйдик."
  },
  {
    "surah_id": 90,
    "ayah_number": 11,
    "global_ayah_id": 6034,
    "translation": "Бас, у довон ошиб ўтмади."
  },
  {
    "surah_id": 90,
    "ayah_number": 12,
    "global_ayah_id": 6035,
    "translation": "Довон қандоқ нарса эканини сенга нима билдирди?"
  },
  {
    "surah_id": 90,
    "ayah_number": 13,
    "global_ayah_id": 6036,
    "translation": "У қул озод қилишдир."
  },
  {
    "surah_id": 90,
    "ayah_number": 14,
    "global_ayah_id": 6037,
    "translation": "Ёки очарчилик кунида таом беришдир."
  },
  {
    "surah_id": 90,
    "ayah_number": 15,
    "global_ayah_id": 6038,
    "translation": "Қариндош етимларга."
  },
  {
    "surah_id": 90,
    "ayah_number": 16,
    "global_ayah_id": 6039,
    "translation": "Ёки тупроққа қориган мискинларга."
  },
  {
    "surah_id": 90,
    "ayah_number": 17,
    "global_ayah_id": 6040,
    "translation": "Сўнгра иймон келтирганлар ва бир-бирини сабрга, меҳр-шафқатга чақирганлар бўлса."
  },
  {
    "surah_id": 90,
    "ayah_number": 18,
    "global_ayah_id": 6041,
    "translation": "Ана ўшалар ўнг томон эгаларидир."
  },
  {
    "surah_id": 90,
    "ayah_number": 19,
    "global_ayah_id": 6042,
    "translation": "Оятларимизга куфр келтирганлар, улар, чап томон эгаларидир."
  },
  {
    "surah_id": 90,
    "ayah_number": 20,
    "global_ayah_id": 6043,
    "translation": "Уларни чиқиб бўлмайдиган ўт-олов ўраб олгандир."
  }
]