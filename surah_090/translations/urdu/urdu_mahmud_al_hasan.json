[
  {
    "surah_id": 90,
    "ayah_number": 0,
    "global_ayah_id": 6112,
    "translation": "اللہ کے نام سے جو رحمان و رحیم ہے"
  },
  {
    "surah_id": 90,
    "ayah_number": 1,
    "global_ayah_id": 6113,
    "translation": "قسم کھاتا ہوں میں اس شہر کی"
  },
  {
    "surah_id": 90,
    "ayah_number": 2,
    "global_ayah_id": 6114,
    "translation": "اور تجھ پر قید نہیں رہے گی اس شہر میں"
  },
  {
    "surah_id": 90,
    "ayah_number": 3,
    "global_ayah_id": 6115,
    "translation": "اور قسم ہے جنتے کی اور جو اس نے جنا"
  },
  {
    "surah_id": 90,
    "ayah_number": 4,
    "global_ayah_id": 6116,
    "translation": "تحقیق ہم نے بنایا آدمی کو محنت میں"
  },
  {
    "surah_id": 90,
    "ayah_number": 5,
    "global_ayah_id": 6117,
    "translation": "کیا خیال رکھتا ہے وہ کہ اُس پر بس نہ چلے گا کسی کا"
  },
  {
    "surah_id": 90,
    "ayah_number": 6,
    "global_ayah_id": 6118,
    "translation": "کہتا ہے میں نے خرچ کر ڈالا مال ڈھیروں"
  },
  {
    "surah_id": 90,
    "ayah_number": 7,
    "global_ayah_id": 6119,
    "translation": "کیا خیال رکھتا ہے کہ دیکھا نہیں اسکو کسی نے"
  },
  {
    "surah_id": 90,
    "ayah_number": 8,
    "global_ayah_id": 6120,
    "translation": "بھلا ہم نے نہیں دیں اُسکو دو آنکھیں"
  },
  {
    "surah_id": 90,
    "ayah_number": 9,
    "global_ayah_id": 6121,
    "translation": "اور زبان اور دو ہونٹ"
  },
  {
    "surah_id": 90,
    "ayah_number": 10,
    "global_ayah_id": 6122,
    "translation": "اور دکھلا دیں اُسکو دو گھاٹیاں"
  },
  {
    "surah_id": 90,
    "ayah_number": 11,
    "global_ayah_id": 6123,
    "translation": "سو نہ دھمک سکا گھاٹی پر"
  },
  {
    "surah_id": 90,
    "ayah_number": 12,
    "global_ayah_id": 6124,
    "translation": "اور توکیا سمجھا کیا ہے وہ گھاٹی"
  },
  {
    "surah_id": 90,
    "ayah_number": 13,
    "global_ayah_id": 6125,
    "translation": "چھڑانا گردن کا"
  },
  {
    "surah_id": 90,
    "ayah_number": 14,
    "global_ayah_id": 6126,
    "translation": "یا کھلانا بھوک کے دن میں"
  },
  {
    "surah_id": 90,
    "ayah_number": 15,
    "global_ayah_id": 6127,
    "translation": "یتیم کو جو قرابت والا ہے"
  },
  {
    "surah_id": 90,
    "ayah_number": 16,
    "global_ayah_id": 6128,
    "translation": "یا محتاج کو جو خاک میں رل رہا ہے"
  },
  {
    "surah_id": 90,
    "ayah_number": 17,
    "global_ayah_id": 6129,
    "translation": "پھر ہووے ایمان والوں میں جو تاکید کرتے ہیں آپس میں تحمل کی اور تاکید کرتے ہیں رحم کھانے کی"
  },
  {
    "surah_id": 90,
    "ayah_number": 18,
    "global_ayah_id": 6130,
    "translation": "وہ لوگ ہیں بڑے نصیب والے"
  },
  {
    "surah_id": 90,
    "ayah_number": 19,
    "global_ayah_id": 6131,
    "translation": "اور جو منکر ہوئے ہماری آیتوں سے وہ ہیں کمبختی والے"
  },
  {
    "surah_id": 90,
    "ayah_number": 20,
    "global_ayah_id": 6132,
    "translation": "اُنہی کو آگ میں موند دیا ہے"
  }
]