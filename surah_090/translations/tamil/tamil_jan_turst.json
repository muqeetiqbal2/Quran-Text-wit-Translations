[
  {
    "surah_id": 90,
    "ayah_number": 1,
    "global_ayah_id": 6024,
    "translation": "இந்நகரத்தின் மீது நான் சத்தியம் செய்கின்றேன்."
  },
  {
    "surah_id": 90,
    "ayah_number": 2,
    "global_ayah_id": 6025,
    "translation": "நீர் இந்நகரத்தில் (சுதந்திரமாகத்) தங்கியிருக்கும் நிலையில்,"
  },
  {
    "surah_id": 90,
    "ayah_number": 3,
    "global_ayah_id": 6026,
    "translation": "பெற்றோர் மீதும், (பெற்ற) சந்ததியின் மீதும் சத்தியமாக,"
  },
  {
    "surah_id": 90,
    "ayah_number": 4,
    "global_ayah_id": 6027,
    "translation": "திடமாக, நாம் மனிதனைக் கஷ்டத்தில் (உள்ளவனாகப்) படைத்தோம்."
  },
  {
    "surah_id": 90,
    "ayah_number": 5,
    "global_ayah_id": 6028,
    "translation": "'ஒருவரும், தன் மீது சக்தி பெறவே மாட்டார்' என்று அவன் எண்ணிக் கொள்கிறானா?"
  },
  {
    "surah_id": 90,
    "ayah_number": 6,
    "global_ayah_id": 6029,
    "translation": "\"ஏராளமான பொருளை நான் அழித்தேன்\" என்று அவன் கூறுகிறான்."
  },
  {
    "surah_id": 90,
    "ayah_number": 7,
    "global_ayah_id": 6030,
    "translation": "தன்னை ஒருவரும் பார்க்கவில்லையென்று அவன் எண்ணுகிறானா?"
  },
  {
    "surah_id": 90,
    "ayah_number": 8,
    "global_ayah_id": 6031,
    "translation": "அவனுக்கு நாம் இரண்டு கண்களை நாம் ஆக்கவில்லையா?"
  },
  {
    "surah_id": 90,
    "ayah_number": 9,
    "global_ayah_id": 6032,
    "translation": "மேலும் நாவையும், இரண்டு உதடுகளையும் (ஆக்கவில்லையா)?"
  },
  {
    "surah_id": 90,
    "ayah_number": 10,
    "global_ayah_id": 6033,
    "translation": "அன்றியும் (நன்மை, தீமையாகிய) இருபாதைகளை நாம் அவனுக்குக் காண்பித்தோம்."
  },
  {
    "surah_id": 90,
    "ayah_number": 11,
    "global_ayah_id": 6034,
    "translation": "ஆயினும், அவன் கணவாயைக் கடக்கவில்லை."
  },
  {
    "surah_id": 90,
    "ayah_number": 12,
    "global_ayah_id": 6035,
    "translation": "(நபியே!) கணவாய் என்பது என்ன என்பதை உமக்கு எது அறிவிக்கும்."
  },
  {
    "surah_id": 90,
    "ayah_number": 13,
    "global_ayah_id": 6036,
    "translation": "(அது) ஓர் அடிமையை விடுவித்தல்-"
  },
  {
    "surah_id": 90,
    "ayah_number": 14,
    "global_ayah_id": 6037,
    "translation": "அல்லது, பசித்திருக்கும் நாளில் உணவளித்தலாகும்."
  },
  {
    "surah_id": 90,
    "ayah_number": 15,
    "global_ayah_id": 6038,
    "translation": "உறவினனான ஓர் அநாதைக்கோ,"
  },
  {
    "surah_id": 90,
    "ayah_number": 16,
    "global_ayah_id": 6039,
    "translation": "அல்லது (வறுமை) மண்ணில் புரளும் ஓர் ஏழைக்கோ (உணவளிப்பதாகும்)."
  },
  {
    "surah_id": 90,
    "ayah_number": 17,
    "global_ayah_id": 6040,
    "translation": "பின்னர், ஈமான் கொண்டு, பொறுமையைக் கொண்டு ஒருவருக்கொருவர் உபதேசித்தும், கிருபையைக் கொண்டு ஒருவருக் கொருவர் உபதேசித்தும் வந்தவர்களில் இருப்பதுவும் (கணவாயைக் கடத்தல்) ஆகும்."
  },
  {
    "surah_id": 90,
    "ayah_number": 18,
    "global_ayah_id": 6041,
    "translation": "அத்தகையவர் தாம் வலப்புறத்தில் இருப்பவர்கள்."
  },
  {
    "surah_id": 90,
    "ayah_number": 19,
    "global_ayah_id": 6042,
    "translation": "ஆனால், எவர்கள் நம் வசனங்களை நிராகரிக்கிறார்களோ, அவர்கள் தாம் இடப்பக்கத்தையுடையோர்."
  },
  {
    "surah_id": 90,
    "ayah_number": 20,
    "global_ayah_id": 6043,
    "translation": "அவர்கள் மீது (எப்பக்கமும்) மூடப்பட்ட நெருப்பு இருக்கிறது."
  }
]