[
  {
    "surah_id": 90,
    "ayah_number": 1,
    "global_ayah_id": 6024,
    "translation": "Не! Кълна се в този град [Мека] -"
  },
  {
    "surah_id": 90,
    "ayah_number": 2,
    "global_ayah_id": 6025,
    "translation": "на теб [о, Мухаммад] този град ти беше позволен, -"
  },
  {
    "surah_id": 90,
    "ayah_number": 3,
    "global_ayah_id": 6026,
    "translation": "и в родителя [Адам], и в неговото потомство!"
  },
  {
    "surah_id": 90,
    "ayah_number": 4,
    "global_ayah_id": 6027,
    "translation": "Ние сътворихме човека в трудности."
  },
  {
    "surah_id": 90,
    "ayah_number": 5,
    "global_ayah_id": 6028,
    "translation": "Нима смята, че никой не ще го надмогне?"
  },
  {
    "surah_id": 90,
    "ayah_number": 6,
    "global_ayah_id": 6029,
    "translation": "Казва: “Пропилях огромно богатство.”"
  },
  {
    "surah_id": 90,
    "ayah_number": 7,
    "global_ayah_id": 6030,
    "translation": "Нима смята, че никой не го е видял?"
  },
  {
    "surah_id": 90,
    "ayah_number": 8,
    "global_ayah_id": 6031,
    "translation": "Не му ли дадохме Ние две очи"
  },
  {
    "surah_id": 90,
    "ayah_number": 9,
    "global_ayah_id": 6032,
    "translation": "и език, и устни,"
  },
  {
    "surah_id": 90,
    "ayah_number": 10,
    "global_ayah_id": 6033,
    "translation": "и му посочихме двата пътя,"
  },
  {
    "surah_id": 90,
    "ayah_number": 11,
    "global_ayah_id": 6034,
    "translation": "ала той не пое стръмния път."
  },
  {
    "surah_id": 90,
    "ayah_number": 12,
    "global_ayah_id": 6035,
    "translation": "Но откъде да знаеш ти какво е стръмният път?"
  },
  {
    "surah_id": 90,
    "ayah_number": 13,
    "global_ayah_id": 6036,
    "translation": "Да се освободи роб"
  },
  {
    "surah_id": 90,
    "ayah_number": 14,
    "global_ayah_id": 6037,
    "translation": "или да се даде храна в ден на глад"
  },
  {
    "surah_id": 90,
    "ayah_number": 15,
    "global_ayah_id": 6038,
    "translation": "на сирак - роднина"
  },
  {
    "surah_id": 90,
    "ayah_number": 16,
    "global_ayah_id": 6039,
    "translation": "или на окаян клетник."
  },
  {
    "surah_id": 90,
    "ayah_number": 17,
    "global_ayah_id": 6040,
    "translation": "И е от онези, които вярват и взаимно се наставляват за търпение, и взаимно се наставляват за състрадание."
  },
  {
    "surah_id": 90,
    "ayah_number": 18,
    "global_ayah_id": 6041,
    "translation": "Тези са хората на десницата."
  },
  {
    "surah_id": 90,
    "ayah_number": 19,
    "global_ayah_id": 6042,
    "translation": "А които отхвърлят Нашите знамения, те са хората на левицата."
  },
  {
    "surah_id": 90,
    "ayah_number": 20,
    "global_ayah_id": 6043,
    "translation": "Ще бъдат затворени в Огъня."
  }
]