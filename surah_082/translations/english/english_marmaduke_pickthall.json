[
  {
    "surah_id": 82,
    "ayah_number": 1,
    "global_ayah_id": 5830,
    "translation": "When the heaven is cleft asunder,"
  },
  {
    "surah_id": 82,
    "ayah_number": 2,
    "global_ayah_id": 5831,
    "translation": "When the planets are dispersed,"
  },
  {
    "surah_id": 82,
    "ayah_number": 3,
    "global_ayah_id": 5832,
    "translation": "When the seas are poured forth,"
  },
  {
    "surah_id": 82,
    "ayah_number": 4,
    "global_ayah_id": 5833,
    "translation": "And the sepulchres are overturned,"
  },
  {
    "surah_id": 82,
    "ayah_number": 5,
    "global_ayah_id": 5834,
    "translation": "A soul will know what it hath sent before (it) and what left behind."
  },
  {
    "surah_id": 82,
    "ayah_number": 6,
    "global_ayah_id": 5835,
    "translation": "O man! What hath made thee careless concerning thy Lord, the Bountiful,"
  },
  {
    "surah_id": 82,
    "ayah_number": 7,
    "global_ayah_id": 5836,
    "translation": "Who created thee, then fashioned, then proportioned thee?"
  },
  {
    "surah_id": 82,
    "ayah_number": 8,
    "global_ayah_id": 5837,
    "translation": "Into whatsoever form He will, He casteth thee."
  },
  {
    "surah_id": 82,
    "ayah_number": 9,
    "global_ayah_id": 5838,
    "translation": "Nay, but ye deny the Judgment."
  },
  {
    "surah_id": 82,
    "ayah_number": 10,
    "global_ayah_id": 5839,
    "translation": "Lo! there are above you guardians,"
  },
  {
    "surah_id": 82,
    "ayah_number": 11,
    "global_ayah_id": 5840,
    "translation": "Generous and recording,"
  },
  {
    "surah_id": 82,
    "ayah_number": 12,
    "global_ayah_id": 5841,
    "translation": "Who know (all) that ye do."
  },
  {
    "surah_id": 82,
    "ayah_number": 13,
    "global_ayah_id": 5842,
    "translation": "Lo! the righteous verily will be in delight."
  },
  {
    "surah_id": 82,
    "ayah_number": 14,
    "global_ayah_id": 5843,
    "translation": "And lo! the wicked verily will be in hell;"
  },
  {
    "surah_id": 82,
    "ayah_number": 15,
    "global_ayah_id": 5844,
    "translation": "They will burn therein on the Day of Judgment,"
  },
  {
    "surah_id": 82,
    "ayah_number": 16,
    "global_ayah_id": 5845,
    "translation": "And will not be absent thence."
  },
  {
    "surah_id": 82,
    "ayah_number": 17,
    "global_ayah_id": 5846,
    "translation": "Ah, what will convey unto thee what the Day of Judgment is!"
  },
  {
    "surah_id": 82,
    "ayah_number": 18,
    "global_ayah_id": 5847,
    "translation": "Again, what will convey unto thee what the Day of Judgment is!"
  },
  {
    "surah_id": 82,
    "ayah_number": 19,
    "global_ayah_id": 5848,
    "translation": "A day on which no soul hath power at all for any (other) soul. The (absolute) command on that day is Allah's."
  }
]