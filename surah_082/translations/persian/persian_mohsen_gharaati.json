[
  {
    "surah_id": 82,
    "ayah_number": 1,
    "global_ayah_id": 5830,
    "translation": "آن‌گاه که آسمان شکافته شود."
  },
  {
    "surah_id": 82,
    "ayah_number": 2,
    "global_ayah_id": 5831,
    "translation": "و آن‌گاه که ستارگان پراکنده شوند."
  },
  {
    "surah_id": 82,
    "ayah_number": 3,
    "global_ayah_id": 5832,
    "translation": "و آن‌گاه که دریاها گشوده شوند و به هم راه یابند."
  },
  {
    "surah_id": 82,
    "ayah_number": 4,
    "global_ayah_id": 5833,
    "translation": "و آن‌گاه که قبرها زیر و رو گردد."
  },
  {
    "surah_id": 82,
    "ayah_number": 5,
    "global_ayah_id": 5834,
    "translation": "[آن هنگام] هر کس آنچه را از پیش فرستاده و آنچه را از پس فرستاده است، می‌داند."
  },
  {
    "surah_id": 82,
    "ayah_number": 6,
    "global_ayah_id": 5835,
    "translation": "ای انسان! چه چیز تو را در برابر پروردگارت که کریم و بخشنده است، مغرور ساخت؟"
  },
  {
    "surah_id": 82,
    "ayah_number": 7,
    "global_ayah_id": 5836,
    "translation": "همان که تو را آفرید و [اندامت را] استوار ساخت و هماهنگ و متعادل کرد."
  },
  {
    "surah_id": 82,
    "ayah_number": 8,
    "global_ayah_id": 5837,
    "translation": "و به هر صورت که خواست، تو را ترکیب کرد."
  },
  {
    "surah_id": 82,
    "ayah_number": 9,
    "global_ayah_id": 5838,
    "translation": "با این همه، [شما روز] جزا را دروغ می‌پندارید."
  },
  {
    "surah_id": 82,
    "ayah_number": 10,
    "global_ayah_id": 5839,
    "translation": "در حالی که قطعاً بر شما نگهبانانی [از فرشتگان] گمارده شده‌اند."
  },
  {
    "surah_id": 82,
    "ayah_number": 11,
    "global_ayah_id": 5840,
    "translation": "نویسندگانی بزرگوار،"
  },
  {
    "surah_id": 82,
    "ayah_number": 12,
    "global_ayah_id": 5841,
    "translation": "که به آنچه می‌کنید، آگاهند."
  },
  {
    "surah_id": 82,
    "ayah_number": 13,
    "global_ayah_id": 5842,
    "translation": "بی‌شک، نیکان در ناز و نعمت‌اند."
  },
  {
    "surah_id": 82,
    "ayah_number": 14,
    "global_ayah_id": 5843,
    "translation": "و بدکاران در آتشی شعله‌ور."
  },
  {
    "surah_id": 82,
    "ayah_number": 15,
    "global_ayah_id": 5844,
    "translation": "که در روز جزا به آن وارد شوند،"
  },
  {
    "surah_id": 82,
    "ayah_number": 16,
    "global_ayah_id": 5845,
    "translation": "و لحظه‌ای، از آن جدا نشوند."
  },
  {
    "surah_id": 82,
    "ayah_number": 17,
    "global_ayah_id": 5846,
    "translation": "و تو چه می‌دانی که روز جزا چه روزی است؟"
  },
  {
    "surah_id": 82,
    "ayah_number": 18,
    "global_ayah_id": 5847,
    "translation": "باز، چه می‌دانی که روز جزا چه روزی است؟"
  },
  {
    "surah_id": 82,
    "ayah_number": 19,
    "global_ayah_id": 5848,
    "translation": "روزی که هیچ کس برای دیگری هیچ اختیاری ندارد و در آن روز، فرمان، فرمان خداست."
  }
]