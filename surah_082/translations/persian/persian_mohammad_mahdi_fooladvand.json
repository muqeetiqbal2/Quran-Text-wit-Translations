[
  {
    "surah_id": 82,
    "ayah_number": 1,
    "global_ayah_id": 5830,
    "translation": "آنگاه كه آسمان زهم بشكافد،"
  },
  {
    "surah_id": 82,
    "ayah_number": 2,
    "global_ayah_id": 5831,
    "translation": "و آنگاه كه اختران پراكنده شوند،"
  },
  {
    "surah_id": 82,
    "ayah_number": 3,
    "global_ayah_id": 5832,
    "translation": "و آنگاه كه درياها از جا بركنده گردند،"
  },
  {
    "surah_id": 82,
    "ayah_number": 4,
    "global_ayah_id": 5833,
    "translation": "و آنگاه كه گورها زير و زبر شوند،"
  },
  {
    "surah_id": 82,
    "ayah_number": 5,
    "global_ayah_id": 5834,
    "translation": "هر نفسى آنچه را پيش فرستاده و بازپس گذاشته، بداند."
  },
  {
    "surah_id": 82,
    "ayah_number": 6,
    "global_ayah_id": 5835,
    "translation": "اى انسان، چه چيز تو را در باره پروردگار بزرگوارت مغرور ساخته؟"
  },
  {
    "surah_id": 82,
    "ayah_number": 7,
    "global_ayah_id": 5836,
    "translation": "همان كس كه تو را آفريد، و [اندام‌] تو را درست كرد، و [آنگاه‌] تو را سامان بخشيد."
  },
  {
    "surah_id": 82,
    "ayah_number": 8,
    "global_ayah_id": 5837,
    "translation": "و به هر صورتى كه خواست، تو را تركيب كرد."
  },
  {
    "surah_id": 82,
    "ayah_number": 9,
    "global_ayah_id": 5838,
    "translation": "با اين همه، شما منكر [روز] جزاييد."
  },
  {
    "surah_id": 82,
    "ayah_number": 10,
    "global_ayah_id": 5839,
    "translation": "و قطعاً بر شما نگهبانانى [گماشته شده‌]اند:"
  },
  {
    "surah_id": 82,
    "ayah_number": 11,
    "global_ayah_id": 5840,
    "translation": "[فرشتگان‌] بزرگوارى كه نويسندگان [اعمال شما] هستند؛"
  },
  {
    "surah_id": 82,
    "ayah_number": 12,
    "global_ayah_id": 5841,
    "translation": "آنچه را مى‌كنيد، مى‌دانند."
  },
  {
    "surah_id": 82,
    "ayah_number": 13,
    "global_ayah_id": 5842,
    "translation": "قطعاً نيكان به بهشت اندرند."
  },
  {
    "surah_id": 82,
    "ayah_number": 14,
    "global_ayah_id": 5843,
    "translation": "و بى‌شك، بدكاران در دوزخند."
  },
  {
    "surah_id": 82,
    "ayah_number": 15,
    "global_ayah_id": 5844,
    "translation": "روز جزا در آنجا درآيند،"
  },
  {
    "surah_id": 82,
    "ayah_number": 16,
    "global_ayah_id": 5845,
    "translation": "و از آن [عذاب‌] دور نخواهند بود."
  },
  {
    "surah_id": 82,
    "ayah_number": 17,
    "global_ayah_id": 5846,
    "translation": "و تو چه دانى كه چيست روز جزا؟"
  },
  {
    "surah_id": 82,
    "ayah_number": 18,
    "global_ayah_id": 5847,
    "translation": "باز چه دانى كه چيست روز جزا؟"
  },
  {
    "surah_id": 82,
    "ayah_number": 19,
    "global_ayah_id": 5848,
    "translation": "روزى كه كسى براى كسى هيچ اختيارى ندارد؛ و در آن روز، فرمان از آنِ خداست."
  }
]