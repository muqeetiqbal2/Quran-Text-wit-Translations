[
  {
    "surah_id": 82,
    "ayah_number": 1,
    "global_ayah_id": 5830,
    "translation": "Quando o céu se fender,"
  },
  {
    "surah_id": 82,
    "ayah_number": 2,
    "global_ayah_id": 5831,
    "translation": "Quando os planetas se dispersarem,"
  },
  {
    "surah_id": 82,
    "ayah_number": 3,
    "global_ayah_id": 5832,
    "translation": "Quando os oceanos forem despejados,"
  },
  {
    "surah_id": 82,
    "ayah_number": 4,
    "global_ayah_id": 5833,
    "translation": "E quando os sepulcros forem revirados,"
  },
  {
    "surah_id": 82,
    "ayah_number": 5,
    "global_ayah_id": 5834,
    "translation": "Saberá cada alma o que fez e o que deixou de fazer."
  },
  {
    "surah_id": 82,
    "ayah_number": 6,
    "global_ayah_id": 5835,
    "translation": "Ó humano, o que te fez negligente em relação ao teu Senhor, o Munificentíssimo,"
  },
  {
    "surah_id": 82,
    "ayah_number": 7,
    "global_ayah_id": 5836,
    "translation": "Que te criou, te formou, te aperfeiçoou,"
  },
  {
    "surah_id": 82,
    "ayah_number": 8,
    "global_ayah_id": 5837,
    "translation": "E te modelou, na forma que Lhe aprouve?"
  },
  {
    "surah_id": 82,
    "ayah_number": 9,
    "global_ayah_id": 5838,
    "translation": "Qual! Apesar disso, desmentis o (Dia do) Juízo!"
  },
  {
    "surah_id": 82,
    "ayah_number": 10,
    "global_ayah_id": 5839,
    "translation": "Porém, certamente, sobre vós há anjos da guarda,"
  },
  {
    "surah_id": 82,
    "ayah_number": 11,
    "global_ayah_id": 5840,
    "translation": "Generosos e anotadores,"
  },
  {
    "surah_id": 82,
    "ayah_number": 12,
    "global_ayah_id": 5841,
    "translation": "Que sabem (tudo) o que fazeis."
  },
  {
    "surah_id": 82,
    "ayah_number": 13,
    "global_ayah_id": 5842,
    "translation": "Sabei que os piedosos estarão em deleite;"
  },
  {
    "surah_id": 82,
    "ayah_number": 14,
    "global_ayah_id": 5843,
    "translation": "Por outra, os ignóbeis, irão para a fogueira,"
  },
  {
    "surah_id": 82,
    "ayah_number": 15,
    "global_ayah_id": 5844,
    "translation": "Em que entrarão, no Dia do Juízo,"
  },
  {
    "surah_id": 82,
    "ayah_number": 16,
    "global_ayah_id": 5845,
    "translation": "Da qual jamais poderão esquivar-se."
  },
  {
    "surah_id": 82,
    "ayah_number": 17,
    "global_ayah_id": 5846,
    "translation": "E, o que te fará entender o que é o Dia do Juízo?"
  },
  {
    "surah_id": 82,
    "ayah_number": 18,
    "global_ayah_id": 5847,
    "translation": "Novamente: o que te fará entender o que é o Dia do Juízo?"
  },
  {
    "surah_id": 82,
    "ayah_number": 19,
    "global_ayah_id": 5848,
    "translation": "É o dia em que nenhuma alma poderá advogar por outra, porque o mando, nesse dia, só será de Deus."
  }
]