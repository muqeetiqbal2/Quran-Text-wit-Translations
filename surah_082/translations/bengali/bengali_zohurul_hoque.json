[
  {
    "surah_id": 82,
    "ayah_number": 1,
    "global_ayah_id": 5830,
    "translation": "যখন আকাশ বিদীর্ণ হবে,"
  },
  {
    "surah_id": 82,
    "ayah_number": 2,
    "global_ayah_id": 5831,
    "translation": "আর যখন নক্ষত্রসব বিক্ষিপ্ত হবে,"
  },
  {
    "surah_id": 82,
    "ayah_number": 3,
    "global_ayah_id": 5832,
    "translation": "আর যখন সমুদ্রগুলো উচ্ছলিত হবে,"
  },
  {
    "surah_id": 82,
    "ayah_number": 4,
    "global_ayah_id": 5833,
    "translation": "আর যখন কবরগুলো উন্মোচিত হবে, --"
  },
  {
    "surah_id": 82,
    "ayah_number": 5,
    "global_ayah_id": 5834,
    "translation": "তখন প্রত্যেকেই জানতে পারবে সে কী আগ-বাড়িয়েছে, আর কী সে পেছনে ফেলে রেখেছে।"
  },
  {
    "surah_id": 82,
    "ayah_number": 6,
    "global_ayah_id": 5835,
    "translation": "ওহে মানব! কিসে তোমাকে ভুলিয়েছে তোমার মহানুভব প্রভুসন্বন্ধে --"
  },
  {
    "surah_id": 82,
    "ayah_number": 7,
    "global_ayah_id": 5836,
    "translation": "যিনি তোমাকে সৃষ্টি করেছেন, তারপর তোমাকে সুঠাম করেছেন, তারপর তোমাকে সুসমঞ্জস করেছেন, --"
  },
  {
    "surah_id": 82,
    "ayah_number": 8,
    "global_ayah_id": 5837,
    "translation": "যে আকৃতিতে তিনি চেয়েছেন সেইভাবে তিনি তোমাকে গঠন করেছেন?"
  },
  {
    "surah_id": 82,
    "ayah_number": 9,
    "global_ayah_id": 5838,
    "translation": "না, তোমরা বরং সদ্বিচারকেই মিথ্যারোপ করছ।"
  },
  {
    "surah_id": 82,
    "ayah_number": 10,
    "global_ayah_id": 5839,
    "translation": "অথচ তোমাদের উপরে নিশ্চয়ই তত্ত্বাবধায়ক রয়েছে, --"
  },
  {
    "surah_id": 82,
    "ayah_number": 11,
    "global_ayah_id": 5840,
    "translation": "সম্মানিত লিপিকারগণ,"
  },
  {
    "surah_id": 82,
    "ayah_number": 12,
    "global_ayah_id": 5841,
    "translation": "তারা জানে তোমরা যা-কিছু কর।"
  },
  {
    "surah_id": 82,
    "ayah_number": 13,
    "global_ayah_id": 5842,
    "translation": "ধার্মিকরা নিশ্চয় থাকবে আনন্দেরই মাঝে,"
  },
  {
    "surah_id": 82,
    "ayah_number": 14,
    "global_ayah_id": 5843,
    "translation": "আর পাপাচারীরা আলবৎ থাকবে ভয়ংকর আগুনে, --"
  },
  {
    "surah_id": 82,
    "ayah_number": 15,
    "global_ayah_id": 5844,
    "translation": "তারা এতে প্রবেশ করবে বিচারের দিনে"
  },
  {
    "surah_id": 82,
    "ayah_number": 16,
    "global_ayah_id": 5845,
    "translation": "আর তারা এর থেকে গরহাজির থাকতে পারবে না।"
  },
  {
    "surah_id": 82,
    "ayah_number": 17,
    "global_ayah_id": 5846,
    "translation": "আর কিসে তোমাকে বুঝতে দেবে কী সেই বিচারের দিন?"
  },
  {
    "surah_id": 82,
    "ayah_number": 18,
    "global_ayah_id": 5847,
    "translation": "পুনরায় কিসে তোমাকে বোঝানো যাবে বিচারের দিন কি?"
  },
  {
    "surah_id": 82,
    "ayah_number": 19,
    "global_ayah_id": 5848,
    "translation": "এ সেইদিন যেদিন কোনো সত্ত্বা কোনো আ‌ত্মার জন্যে কোনো-কিছু করার সামর্থ্য রাখবে না। আর কর্তৃত্ব সেইদিন হবে আল্লাহ্‌রই।"
  }
]