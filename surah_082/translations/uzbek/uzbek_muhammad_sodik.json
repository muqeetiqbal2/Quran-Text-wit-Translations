[
  {
    "surah_id": 82,
    "ayah_number": 1,
    "global_ayah_id": 5830,
    "translation": "Вақтики, осмон ёрилса."
  },
  {
    "surah_id": 82,
    "ayah_number": 2,
    "global_ayah_id": 5831,
    "translation": "Ва, вақтики, юлдузлар сочилиб кетса."
  },
  {
    "surah_id": 82,
    "ayah_number": 3,
    "global_ayah_id": 5832,
    "translation": "Ва, вақтики, денгизлар портлатилса."
  },
  {
    "surah_id": 82,
    "ayah_number": 4,
    "global_ayah_id": 5833,
    "translation": "Ва, вақтики, қабрлар остин-устин бўлса."
  },
  {
    "surah_id": 82,
    "ayah_number": 5,
    "global_ayah_id": 5834,
    "translation": "Ҳар бир жон нимани тақдим қилдию, нимани таъхир қилди- билади."
  },
  {
    "surah_id": 82,
    "ayah_number": 6,
    "global_ayah_id": 5835,
    "translation": "Эй Инсон! Сени карамли Роббинг ҳақида нима ғурурга кетказди?!"
  },
  {
    "surah_id": 82,
    "ayah_number": 7,
    "global_ayah_id": 5836,
    "translation": "У сени тўла-тўкис ва мўътадил қилиб яратган зотдир."
  },
  {
    "surah_id": 82,
    "ayah_number": 8,
    "global_ayah_id": 5837,
    "translation": "Ўзи хоҳлаган суратда сени таркиб қилди."
  },
  {
    "surah_id": 82,
    "ayah_number": 9,
    "global_ayah_id": 5838,
    "translation": "Йўқ! Балки, сиз жазони ёлғонга чиқармоқдасиз!"
  },
  {
    "surah_id": 82,
    "ayah_number": 10,
    "global_ayah_id": 5839,
    "translation": "Ҳолбуки, устингиздан кузатиб турувчилар бордир."
  },
  {
    "surah_id": 82,
    "ayah_number": 11,
    "global_ayah_id": 5840,
    "translation": "Улар ҳурматли, ёзиб тургувчилардир."
  },
  {
    "surah_id": 82,
    "ayah_number": 12,
    "global_ayah_id": 5841,
    "translation": "Улар нима қилаётганингизни биладир."
  },
  {
    "surah_id": 82,
    "ayah_number": 13,
    "global_ayah_id": 5842,
    "translation": "Албатта, яхшилар жаннатдадир."
  },
  {
    "surah_id": 82,
    "ayah_number": 14,
    "global_ayah_id": 5843,
    "translation": "Ва албатта, фожирлар жаҳаннамдадир."
  },
  {
    "surah_id": 82,
    "ayah_number": 15,
    "global_ayah_id": 5844,
    "translation": "Улар у ерга қиёмат куни кирадир."
  },
  {
    "surah_id": 82,
    "ayah_number": 16,
    "global_ayah_id": 5845,
    "translation": "Ва улар ундан ғойиб бўла олмайдир."
  },
  {
    "surah_id": 82,
    "ayah_number": 17,
    "global_ayah_id": 5846,
    "translation": "Ва жазо куни нима эканини сенга нима билдирди?"
  },
  {
    "surah_id": 82,
    "ayah_number": 18,
    "global_ayah_id": 5847,
    "translation": "Сўнг жазо куни нима эканини сенга нима билдирди?"
  },
  {
    "surah_id": 82,
    "ayah_number": 19,
    "global_ayah_id": 5848,
    "translation": "Ўша кунда ҳеч бир жон бошқа бир жон учун бирор нарса қилиш имконига молик эмасдир. У кунда барча иш Аллоҳнинг Ўзига хосдир."
  }
]