[
  {
    "surah_id": 82,
    "ayah_number": 1,
    "global_ayah_id": 5830,
    "translation": "Idan sama ta tsãge."
  },
  {
    "surah_id": 82,
    "ayah_number": 2,
    "global_ayah_id": 5831,
    "translation": "Kuma idan taurãri suka wãtse."
  },
  {
    "surah_id": 82,
    "ayah_number": 3,
    "global_ayah_id": 5832,
    "translation": "Kuma idan tẽkuna aka facce su."
  },
  {
    "surah_id": 82,
    "ayah_number": 4,
    "global_ayah_id": 5833,
    "translation": "Kuma idan kaburbura aka tõne su."
  },
  {
    "surah_id": 82,
    "ayah_number": 5,
    "global_ayah_id": 5834,
    "translation": "Rai yã san abin da ya gabatar, da abin da yã jinkirtar."
  },
  {
    "surah_id": 82,
    "ayah_number": 6,
    "global_ayah_id": 5835,
    "translation": "Yã kai mutum! Mẽ ya rũɗe ka game da Ubangijinka, Mai karimci."
  },
  {
    "surah_id": 82,
    "ayah_number": 7,
    "global_ayah_id": 5836,
    "translation": "Wanda Ya halitta ka sa'an nan ya daidaitã ka, Ya kuma tsakaitã ka."
  },
  {
    "surah_id": 82,
    "ayah_number": 8,
    "global_ayah_id": 5837,
    "translation": "A cikin kõwace irin sũra Ya so Ya ginã ka a kanta."
  },
  {
    "surah_id": 82,
    "ayah_number": 9,
    "global_ayah_id": 5838,
    "translation": "A'aha, bã haka ba, kuna ƙaryatãwa game da sakamako!"
  },
  {
    "surah_id": 82,
    "ayah_number": 10,
    "global_ayah_id": 5839,
    "translation": "Lalle ne, a kanku, haƙiƙa akwai matsara."
  },
  {
    "surah_id": 82,
    "ayah_number": 11,
    "global_ayah_id": 5840,
    "translation": "Mãsu daraja, marubũta."
  },
  {
    "surah_id": 82,
    "ayah_number": 12,
    "global_ayah_id": 5841,
    "translation": "Sunã sanin abin da kuke aikatãwa."
  },
  {
    "surah_id": 82,
    "ayah_number": 13,
    "global_ayah_id": 5842,
    "translation": "Lalle ne, mãsu ɗã'ã ga Allah, dãhir, suna cikin ni'ima."
  },
  {
    "surah_id": 82,
    "ayah_number": 14,
    "global_ayah_id": 5843,
    "translation": "Kuma lalle ne, fãjirai, dãhir, sunã cikin Jahĩm."
  },
  {
    "surah_id": 82,
    "ayah_number": 15,
    "global_ayah_id": 5844,
    "translation": "Zã su shigẽ ta a rãnar sakamako."
  },
  {
    "surah_id": 82,
    "ayah_number": 16,
    "global_ayah_id": 5845,
    "translation": "Bã zã su faku daga gare ta ba."
  },
  {
    "surah_id": 82,
    "ayah_number": 17,
    "global_ayah_id": 5846,
    "translation": "Kuma mẽ ya sanar da kai abin da ake cẽ wa rẽnar sakamako?"
  },
  {
    "surah_id": 82,
    "ayah_number": 18,
    "global_ayah_id": 5847,
    "translation": "Sa'an nan, mẽ ya sanar da kai abin da ake cẽ wa rãnar sakamako?"
  },
  {
    "surah_id": 82,
    "ayah_number": 19,
    "global_ayah_id": 5848,
    "translation": "Rãnã ce da wani rai ba ya iya mallakar kõme dõmin wani rai al'amari, a rãnar nan, ga Allah (ɗai) yake."
  }
]