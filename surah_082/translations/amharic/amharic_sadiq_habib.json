[
  {
    "surah_id": 82,
    "ayah_number": 1,
    "global_ayah_id": 5830,
    "translation": "ሰማይ በተሰነጠቀች ጊዜ፤"
  },
  {
    "surah_id": 82,
    "ayah_number": 2,
    "global_ayah_id": 5831,
    "translation": "ከዋክብትም ተበታትነው በወደቁ ጊዜ፤"
  },
  {
    "surah_id": 82,
    "ayah_number": 3,
    "global_ayah_id": 5832,
    "translation": "ባሕሮችም በተከፈቱና በተደበላለቁ ጊዜ፤"
  },
  {
    "surah_id": 82,
    "ayah_number": 4,
    "global_ayah_id": 5833,
    "translation": "መቃብሮችም በተገለባበጡና (ሙታን) በተነሱ ጊዜ፤"
  },
  {
    "surah_id": 82,
    "ayah_number": 5,
    "global_ayah_id": 5834,
    "translation": "ማንኛይቱም ነፍስ ያስቀደመችውንና ያቆየችውን ታውቃለች፡፡"
  },
  {
    "surah_id": 82,
    "ayah_number": 6,
    "global_ayah_id": 5835,
    "translation": "አንተ ሰው ሆይ! በቸሩ ጌታህ ምን አታለለህ?"
  },
  {
    "surah_id": 82,
    "ayah_number": 7,
    "global_ayah_id": 5836,
    "translation": "በዚያ በፈጠረህ አካለ ሙሉም ባደረገህ ባስተካከለህም፡፡"
  },
  {
    "surah_id": 82,
    "ayah_number": 8,
    "global_ayah_id": 5837,
    "translation": "በማንኛውም በሻው ቅርፅ በገጣጠመህ (ጌታህ ምን አታለለህ)፡፡"
  },
  {
    "surah_id": 82,
    "ayah_number": 9,
    "global_ayah_id": 5838,
    "translation": "ተከልከሉ፤ በእውነቱ በፍርዱ ቀን ታስተባብላላችሁ፡፡"
  },
  {
    "surah_id": 82,
    "ayah_number": 10,
    "global_ayah_id": 5839,
    "translation": "በእናንተ ላይ ተጠባባቂዎች ያሉባችሁ፤ ስትኾኑ፤"
  },
  {
    "surah_id": 82,
    "ayah_number": 11,
    "global_ayah_id": 5840,
    "translation": "የተከበሩ ጸሐፊዎች የኾኑ፤ (ተጠባባቂዎች)፡፡"
  },
  {
    "surah_id": 82,
    "ayah_number": 12,
    "global_ayah_id": 5841,
    "translation": "የምትሠሩትን ሁሉ የሚያውቁ፡፡"
  },
  {
    "surah_id": 82,
    "ayah_number": 13,
    "global_ayah_id": 5842,
    "translation": "እውነተኞቹ ምእምናን በእርግጥ በገነት ውስጥ ናቸው፡፡"
  },
  {
    "surah_id": 82,
    "ayah_number": 14,
    "global_ayah_id": 5843,
    "translation": "ከሓዲዎቹም በእርግጥ በገሀነም ውስጥ ናቸው፡፡"
  },
  {
    "surah_id": 82,
    "ayah_number": 15,
    "global_ayah_id": 5844,
    "translation": "በፍርዱ ቀን ይገቧታል፡፡"
  },
  {
    "surah_id": 82,
    "ayah_number": 16,
    "global_ayah_id": 5845,
    "translation": "እነርሱም ከርሷ ራቂዎች አይደሉም፡፡"
  },
  {
    "surah_id": 82,
    "ayah_number": 17,
    "global_ayah_id": 5846,
    "translation": "የፍርድ ቀን ምን እንደኾነ ምን አሳወቀህ?"
  },
  {
    "surah_id": 82,
    "ayah_number": 18,
    "global_ayah_id": 5847,
    "translation": "ከዚያም የፍርዱ ቀን ምን እንደኾነ ምን አሳወቀህ?"
  },
  {
    "surah_id": 82,
    "ayah_number": 19,
    "global_ayah_id": 5848,
    "translation": "(እርሱ) ማንኛይቱም ነፍስ ለሌላይቱ ነፍስ ምንም ማድረግን የማትችልበት ቀን ነው፡፡ ነገሩም ሁሉ በዚያ ቀን ለአላህ ብቻ ነው፡፡"
  }
]