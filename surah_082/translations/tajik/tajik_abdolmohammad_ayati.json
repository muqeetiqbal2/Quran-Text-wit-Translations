[
  {
    "surah_id": 82,
    "ayah_number": 1,
    "global_ayah_id": 5830,
    "translation": "Он гоҳ, ки осмон бишикофад"
  },
  {
    "surah_id": 82,
    "ayah_number": 2,
    "global_ayah_id": 5831,
    "translation": "ва он гоҳ ки ситоратон пароканда шаванд"
  },
  {
    "surah_id": 82,
    "ayah_number": 3,
    "global_ayah_id": 5832,
    "translation": "ва он гоҳ, ки дарёҳо ба ҳам бипайванданд"
  },
  {
    "surah_id": 82,
    "ayah_number": 4,
    "global_ayah_id": 5833,
    "translation": "ва он гоҳ, ки қабрҳо зеру забар (шикофта) гардаид,"
  },
  {
    "surah_id": 82,
    "ayah_number": 5,
    "global_ayah_id": 5834,
    "translation": "ҳар кас медонад, чӣ чиз пешопеш фиристода ва чӣ чиз бар ҷой гузоштааст."
  },
  {
    "surah_id": 82,
    "ayah_number": 6,
    "global_ayah_id": 5835,
    "translation": "Эй одамӣ, чӣ чиз туро ба Парвардигори каримат мағрур кардааст? (фирефтааст)."
  },
  {
    "surah_id": 82,
    "ayah_number": 7,
    "global_ayah_id": 5836,
    "translation": "Он кӣ туро биёфарид, ва аъзоят дуруст кард ва туро мӯътадил қомат кард."
  },
  {
    "surah_id": 82,
    "ayah_number": 8,
    "global_ayah_id": 5837,
    "translation": "Ва ба ҳар сурате, ки хост, аъзои туро ба ҳам андохт (таркиб дод)."
  },
  {
    "surah_id": 82,
    "ayah_number": 9,
    "global_ayah_id": 5838,
    "translation": "Не, не шумо рӯзи ҷазоро дурӯғ меҳисобед."
  },
  {
    "surah_id": 82,
    "ayah_number": 10,
    "global_ayah_id": 5839,
    "translation": "Ҳол он ки бар шумо муҳофизоне (фариштагоне) вобаста шудаанд:"
  },
  {
    "surah_id": 82,
    "ayah_number": 11,
    "global_ayah_id": 5840,
    "translation": "котибоне бузургвор"
  },
  {
    "surah_id": 82,
    "ayah_number": 12,
    "global_ayah_id": 5841,
    "translation": "медонанд, ки шумо чӣ мекунед."
  },
  {
    "surah_id": 82,
    "ayah_number": 13,
    "global_ayah_id": 5842,
    "translation": "Албатта некӯкорон дар неъматанд"
  },
  {
    "surah_id": 82,
    "ayah_number": 14,
    "global_ayah_id": 5843,
    "translation": "ва гуноҳкорон дар ҷаҳаннам!"
  },
  {
    "surah_id": 82,
    "ayah_number": 15,
    "global_ayah_id": 5844,
    "translation": "Дар рӯзи шумор (қиёмат) ба ҷаҳаннам дароянд"
  },
  {
    "surah_id": 82,
    "ayah_number": 16,
    "global_ayah_id": 5845,
    "translation": "ва аз он ғоиб нашаванд"
  },
  {
    "surah_id": 82,
    "ayah_number": 17,
    "global_ayah_id": 5846,
    "translation": "Ту чӣ донӣ, ки рӯзи шумор чист?"
  },
  {
    "surah_id": 82,
    "ayah_number": 18,
    "global_ayah_id": 5847,
    "translation": "Боз ҳам ту чӣ донӣ, ки рӯзи шумор чист?"
  },
  {
    "surah_id": 82,
    "ayah_number": 19,
    "global_ayah_id": 5848,
    "translation": "Рӯзест, ки касе барои каси дигар ҳеҷ коре натаванад кард ва дар он рӯз фармон фармони Худо бошад."
  }
]