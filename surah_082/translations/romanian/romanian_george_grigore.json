[
  {
    "surah_id": 82,
    "ayah_number": 1,
    "global_ayah_id": 5830,
    "translation": "Când cerul se va rupe"
  },
  {
    "surah_id": 82,
    "ayah_number": 2,
    "global_ayah_id": 5831,
    "translation": "şi stelele vor fi împrăştiate,"
  },
  {
    "surah_id": 82,
    "ayah_number": 3,
    "global_ayah_id": 5832,
    "translation": "când mările se vor revărsa"
  },
  {
    "surah_id": 82,
    "ayah_number": 4,
    "global_ayah_id": 5833,
    "translation": "şi mormintele vor fi răvăşite:"
  },
  {
    "surah_id": 82,
    "ayah_number": 5,
    "global_ayah_id": 5834,
    "translation": "fiece suflet va cunoaşte ceea ce a pus înainte, ceea ce a pus în urmă."
  },
  {
    "surah_id": 82,
    "ayah_number": 6,
    "global_ayah_id": 5835,
    "translation": "Omule, ce te-a abătut de la Domnul tău cel Sfânt"
  },
  {
    "surah_id": 82,
    "ayah_number": 7,
    "global_ayah_id": 5836,
    "translation": "care te-a plăsmuit, te-a şlefuit, te-a desăvârşit?"
  },
  {
    "surah_id": 82,
    "ayah_number": 8,
    "global_ayah_id": 5837,
    "translation": "El ţi-a dat chipul pe care l-a voit!"
  },
  {
    "surah_id": 82,
    "ayah_number": 9,
    "global_ayah_id": 5838,
    "translation": "Ba nu! Voi socotiţi Legea minciună,"
  },
  {
    "surah_id": 82,
    "ayah_number": 10,
    "global_ayah_id": 5839,
    "translation": "însă asupra voastră stau păzitorii:"
  },
  {
    "surah_id": 82,
    "ayah_number": 11,
    "global_ayah_id": 5840,
    "translation": "scribi prea-cinstiţi"
  },
  {
    "surah_id": 82,
    "ayah_number": 12,
    "global_ayah_id": 5841,
    "translation": "care ştiu ceea ce săvârşiţi."
  },
  {
    "surah_id": 82,
    "ayah_number": 13,
    "global_ayah_id": 5842,
    "translation": "Oamenii curaţi vor trăi în belşug,"
  },
  {
    "surah_id": 82,
    "ayah_number": 14,
    "global_ayah_id": 5843,
    "translation": "iar cei desfrânaţi vor fi aruncaţi în Foc,"
  },
  {
    "surah_id": 82,
    "ayah_number": 15,
    "global_ayah_id": 5844,
    "translation": "în Ziua Judecăţii de Apoi"
  },
  {
    "surah_id": 82,
    "ayah_number": 16,
    "global_ayah_id": 5845,
    "translation": "de la care nu vor putea lipsi."
  },
  {
    "surah_id": 82,
    "ayah_number": 17,
    "global_ayah_id": 5846,
    "translation": "Cum vei şti tu oare când va fi Ziua Judecăţii de Apoi?"
  },
  {
    "surah_id": 82,
    "ayah_number": 18,
    "global_ayah_id": 5847,
    "translation": "Şi încă o dată, cum vei şti tu oare când va fi Ziua Judecăţii de Apoi?"
  },
  {
    "surah_id": 82,
    "ayah_number": 19,
    "global_ayah_id": 5848,
    "translation": "În Ziua aceea, nici un suflet nu va avea putinţă pentru alt suflet. În Ziua aceea, a lui Dumnezeu va fi Porunca!"
  }
]