[
  {
    "surah_id": 82,
    "ayah_number": 1,
    "global_ayah_id": 5830,
    "translation": "Kiedy niebo rozdzieli się"
  },
  {
    "surah_id": 82,
    "ayah_number": 2,
    "global_ayah_id": 5831,
    "translation": "I kiedy gwiazdy zostaną rozproszone;"
  },
  {
    "surah_id": 82,
    "ayah_number": 3,
    "global_ayah_id": 5832,
    "translation": "Kiedy morza się wzburzą"
  },
  {
    "surah_id": 82,
    "ayah_number": 4,
    "global_ayah_id": 5833,
    "translation": "I kiedy groby zostaną wywrócone,"
  },
  {
    "surah_id": 82,
    "ayah_number": 5,
    "global_ayah_id": 5834,
    "translation": "Wtedy każda dusza się dowie, co sobie przygotowała i co zaniedbała."
  },
  {
    "surah_id": 82,
    "ayah_number": 6,
    "global_ayah_id": 5835,
    "translation": "O człowieku! Cóż ciebie zwiodło względem twego Pana, Szlachetnego?"
  },
  {
    "surah_id": 82,
    "ayah_number": 7,
    "global_ayah_id": 5836,
    "translation": "Tego, który ciebie stworzył i ukształtował cię harmonijnie, i wymierzył proporcjonalnie"
  },
  {
    "surah_id": 82,
    "ayah_number": 8,
    "global_ayah_id": 5837,
    "translation": "- ułożył cię w takiej postaci, w jakiej chciał?"
  },
  {
    "surah_id": 82,
    "ayah_number": 9,
    "global_ayah_id": 5838,
    "translation": "Otóż wręcz przeciwnie! Za kłamstwo uważają Sąd!"
  },
  {
    "surah_id": 82,
    "ayah_number": 10,
    "global_ayah_id": 5839,
    "translation": "Zaprawdę, nad wami są stróże"
  },
  {
    "surah_id": 82,
    "ayah_number": 11,
    "global_ayah_id": 5840,
    "translation": "Szlachetni, którzy zapisują;"
  },
  {
    "surah_id": 82,
    "ayah_number": 12,
    "global_ayah_id": 5841,
    "translation": "Oni wiedzą, co wy czynicie!"
  },
  {
    "surah_id": 82,
    "ayah_number": 13,
    "global_ayah_id": 5842,
    "translation": "Zaprawdę, sprawiedliwi będą w szczęśliwości!"
  },
  {
    "surah_id": 82,
    "ayah_number": 14,
    "global_ayah_id": 5843,
    "translation": "Zaprawdę, grzesznicy będą w ogniu piekielnym!"
  },
  {
    "surah_id": 82,
    "ayah_number": 15,
    "global_ayah_id": 5844,
    "translation": "Oni będą się tam palić w Dniu Sądu"
  },
  {
    "surah_id": 82,
    "ayah_number": 16,
    "global_ayah_id": 5845,
    "translation": "I nie będą mogli oddalić się od niego."
  },
  {
    "surah_id": 82,
    "ayah_number": 17,
    "global_ayah_id": 5846,
    "translation": "A co ciebie pouczy, co to jest Dzień Sądu?"
  },
  {
    "surah_id": 82,
    "ayah_number": 18,
    "global_ayah_id": 5847,
    "translation": "I jeszcze raz: co ciebie pouczy, co to Dzień Sądu?"
  },
  {
    "surah_id": 82,
    "ayah_number": 19,
    "global_ayah_id": 5848,
    "translation": "Tego Dnia żadna dusza nie będzie w stanie nic pomóc innej duszy. Rozkaz, tego Dnia, będzie należeć do Boga!"
  }
]