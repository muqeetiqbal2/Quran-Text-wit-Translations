[
  {
    "surah_id": 82,
    "ayah_number": 1,
    "global_ayah_id": 5830,
    "translation": "Cuando el cielo se hienda,"
  },
  {
    "surah_id": 82,
    "ayah_number": 2,
    "global_ayah_id": 5831,
    "translation": "cuando las estrellas se dispersen,"
  },
  {
    "surah_id": 82,
    "ayah_number": 3,
    "global_ayah_id": 5832,
    "translation": "cuando los mares sean desbordados,"
  },
  {
    "surah_id": 82,
    "ayah_number": 4,
    "global_ayah_id": 5833,
    "translation": "cuando las sepulturas sean vueltas al revés,"
  },
  {
    "surah_id": 82,
    "ayah_number": 5,
    "global_ayah_id": 5834,
    "translation": "sabrá cada cual lo que hizo y lo que dejó de hacer."
  },
  {
    "surah_id": 82,
    "ayah_number": 6,
    "global_ayah_id": 5835,
    "translation": "¡Hombre! ¿Qué es lo que te ha engañado acerca de tu noble Señor,"
  },
  {
    "surah_id": 82,
    "ayah_number": 7,
    "global_ayah_id": 5836,
    "translation": "Que te ha creado, dado forma y disposición armoniosas,"
  },
  {
    "surah_id": 82,
    "ayah_number": 8,
    "global_ayah_id": 5837,
    "translation": "Que te ha formado del modo que ha querido?"
  },
  {
    "surah_id": 82,
    "ayah_number": 9,
    "global_ayah_id": 5838,
    "translation": "¡Pero no! Desmentís el Juicio,"
  },
  {
    "surah_id": 82,
    "ayah_number": 10,
    "global_ayah_id": 5839,
    "translation": "pero hay quienes os guardan:"
  },
  {
    "surah_id": 82,
    "ayah_number": 11,
    "global_ayah_id": 5840,
    "translation": "nobles, escribas,"
  },
  {
    "surah_id": 82,
    "ayah_number": 12,
    "global_ayah_id": 5841,
    "translation": "que saben lo que hacéis."
  },
  {
    "surah_id": 82,
    "ayah_number": 13,
    "global_ayah_id": 5842,
    "translation": "Sí, los justos estarán en delicia,"
  },
  {
    "surah_id": 82,
    "ayah_number": 14,
    "global_ayah_id": 5843,
    "translation": "mientras que los pecadores estarán en fuego de gehena."
  },
  {
    "surah_id": 82,
    "ayah_number": 15,
    "global_ayah_id": 5844,
    "translation": "En él arderán el día del Juicio"
  },
  {
    "surah_id": 82,
    "ayah_number": 16,
    "global_ayah_id": 5845,
    "translation": "y no se ausentarán de él."
  },
  {
    "surah_id": 82,
    "ayah_number": 17,
    "global_ayah_id": 5846,
    "translation": "Y ¿cómo sabrás qué es el día del Juicio?"
  },
  {
    "surah_id": 82,
    "ayah_number": 18,
    "global_ayah_id": 5847,
    "translation": "Sí, ¿cómo sabrás qué es el día del Juicio?"
  },
  {
    "surah_id": 82,
    "ayah_number": 19,
    "global_ayah_id": 5848,
    "translation": "El día que nadie pueda hacer nada en favor de nadie. Y será Alá Quien, ese día, decida."
  }
]