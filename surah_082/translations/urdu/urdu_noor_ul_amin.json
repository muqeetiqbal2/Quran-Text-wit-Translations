    "global_ayah_id": 5910,
    "translation": "شروع اللہ کے «<a href=614> نام </a>» سے جو بڑا «<a href=600> مہربان </a>» اور نہایت رحم کرنے والا ہے"
  },
  {
    "surah_id": 82,
    "ayah_number": 1,
    "global_ayah_id": 5911,
    "translation": "جب «<a href=10> آسمان </a>» پھٹ جائے گا"
  },
  {
    "surah_id": 82,
    "ayah_number": 2,
    "global_ayah_id": 5912,
    "translation": "اور ستارے  ( ٹوٹ کر )  بکھر پڑیں گے"
