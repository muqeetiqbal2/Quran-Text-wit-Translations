  {
    "surah_id": 82,
    "ayah_number": 4,
    "global_ayah_id": 5914,
    "translation": "اورقبریں زیروزبرکردی جائینگی"
  },
  {
    "surah_id": 82,
    "ayah_number": 5,
    "global_ayah_id": 5915,
    "translation": "( اس «<a href=326> دن </a>» )  ہرشخص جان لے گا کہ اس نے آگے کیا  ( عمل )  بھیجا اور «<a href=179> پیچھے </a>» کیا چھوڑا"
  },
  {
    "surah_id": 82,
    "ayah_number": 6,
    "global_ayah_id": 5916,
    "translation": "اے انسان!تجھے اپنے رب کریم سے کس چیزنے دھوکے میں ڈالے رکھا؟"
  },
  {
    "surah_id": 82,
    "ayah_number": 7,
    "global_ayah_id": 5917,
    "translation": "جس نے تجھے «<a href=180> پیدا </a>» کیا  پھر «<a href=320> درست </a>» کیا پھر متوازن  ( «<a href=3> انسان </a>» )  بنایا"
  },
  {
    "surah_id": 82,
    "ayah_number": 8,
    "global_ayah_id": 5918,
    "translation": "( اور )  جس شکل میں بھی چاہاتیرے «<a href=230> جسم </a>» کی ترکیب کی"
  },
  {
    "surah_id": 82,
    "ayah_number": 9,
    "global_ayah_id": 5919,
    "translation": "کوئی نہیں بلکہ تم توروزجزاکو جھٹلاتے ہو"
  },
  {
    "surah_id": 82,
    "ayah_number": 10,
    "global_ayah_id": 5920,
    "translation": "حالانکہ تم پر نگران  ( فرشتے )  «<a href=593> مقرر </a>» ہیں"
  },
  {
    "surah_id": 82,
    "ayah_number": 11,
    "global_ayah_id": 5921,
    "translation": "جومعززہیں «<a href=42> اعمال </a>» «<a href=555> لکھنے </a>» والے"
  },
  {
    "surah_id": 82,
    "ayah_number": 12,
    "global_ayah_id": 5922,
    "translation": "وہ جانتے ہیںجو کچھ تم کرتے ہو"
  },
  {
    "surah_id": 82,
    "ayah_number": 13,
    "global_ayah_id": 5923,
    "translation": "یقینانیک لوگ  ( «<a href=237> جنت </a>» کی )  نعمتوں میں ہوں گے"
  },
  {
    "surah_id": 82,
    "ayah_number": 14,
    "global_ayah_id": 5924,
    "translation": "اور یقینابدکردار جہنم میں"
  },
  {
    "surah_id": 82,
    "ayah_number": 15,
    "global_ayah_id": 5925,
    "translation": "وہ «<a href=476> قیامت </a>» کے «<a href=326> دن </a>» اس میں «<a href=313> داخل </a>» ہوں گے"
  },
  {
    "surah_id": 82,
    "ayah_number": 16,
    "global_ayah_id": 5926,
    "translation": "اور جہنم سے «<a href=271> غائب </a>» نہ رہ سکیں گے"
  },
  {
    "surah_id": 82,
    "ayah_number": 17,
    "global_ayah_id": 5927,
    "translation": "اور آپ کیا جانیں کہ «<a href=476> قیامت </a>» کادن کیا ہے"
  },
  {
    "surah_id": 82,
    "ayah_number": 18,
    "global_ayah_id": 5928,
    "translation": "پھرہاں  ،  آپ کیا جانیں کہ «<a href=476> قیامت </a>» کا «<a href=326> دن </a>» کیا ہے"
  },
  {
    "surah_id": 82,
    "ayah_number": 19,
    "global_ayah_id": 5929,
    "translation": "جس «<a href=326> دن </a>» کوئی کسی دوسرے کے لئے کچھ بھی نہ کرسکے گااوراس «<a href=326> دن </a>» «<a href=288> حکم </a>» صرف اللہ کاچلے گا"
  }
]