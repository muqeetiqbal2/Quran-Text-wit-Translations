  {
    "surah_id": 82,
    "ayah_number": 9,
    "global_ayah_id": 5919,
    "translation": "۹۔ہرگز نہیں ،بلکہ تم «<a href=59> انصاف </a>» کے «<a href=326> دن </a>» کو جھٹلاتے ہو۔"
  },
  {
    "surah_id": 82,
    "ayah_number": 10,
