    "global_ayah_id": 5910,
    "translation": "شروع اللہ کے «<a href=614> نام </a>» سے جو بڑامہربان، نہایت رحم والا ہے۔"
  },
  {
    "surah_id": 82,
    "ayah_number": 1,
    "global_ayah_id": 5911,
    "translation": "۱۔جب آسمان پھٹ جائے گا۔"
