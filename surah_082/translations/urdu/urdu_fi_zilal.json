    "global_ayah_id": 5910,
    "translation": "اللہ کے «<a href=614> نام </a>» سے جو بےانتہا «<a href=600> مہربان </a>» اور رحم فرمانے والا ہے"
  },
  {
    "surah_id": 82,
    "ayah_number": 1,
    "global_ayah_id": 5911,
    "translation": "جب «<a href=10> آسمان </a>» پھٹ جائے گا"
  },
  {
    "surah_id": 82,
    "ayah_number": 2,
    "global_ayah_id": 5912,
    "translation": "اور جب تارے بکھر جائیں گے"
  },
  {
    "surah_id": 82,
    "ayah_number": 3,
    "global_ayah_id": 5913,
    "translation": "اور جب سمندر پھاڑ دیے جائیں گے"
  },
  {
    "surah_id": 82,
    "ayah_number": 4,
    "global_ayah_id": 5914,
    "translation": "اور جب قبریں کھول دی جائیں گی"
  },
  {
    "surah_id": 82,
    "ayah_number": 5,
    "global_ayah_id": 5915,
    "translation": "اس «<a href=639> وقت </a>» ہر شخص کو اس کا اگلا «<a href=147> پچھلا </a>» سب کیا دھرا معلوم ہوجائے گا"
  },
  {
    "surah_id": 82,
    "ayah_number": 6,
    "global_ayah_id": 5916,
    "translation": "اے «<a href=3> انسان </a>» ! کس چیز نے تجھے اپنے اس رب کریم کی طرف سے دھوکے میں ڈال دیا"
  },
  {
    "surah_id": 82,
    "ayah_number": 7,
    "global_ayah_id": 5917,
    "translation": "جس نے تجھے «<a href=180> پیدا </a>» کیا ، تجھے نک سک سے «<a href=320> درست </a>» کیا ، تجھے متناسب بنایا"
  },
  {
    "surah_id": 82,
    "ayah_number": 8,
    "global_ayah_id": 5918,
    "translation": "اور جس «<a href=421> صورت </a>» میں چاہا ، تجھ کو جوڑ کر «<a href=213> تیار </a>» کیا"
  },
  {
    "surah_id": 82,
    "ayah_number": 9,
    "global_ayah_id": 5919,
    "translation": "ہرگز نہیں ! بلکہ (اصل «<a href=71> بات </a>» یہ ہے کہ) تم لوگ جزا وسزا کو جھٹلاتے ہو"
  },
  {
    "surah_id": 82,
    "ayah_number": 10,
    "global_ayah_id": 5920,
    "translation": "حالانکہ تم پر نگران «<a href=593> مقرر </a>» ہیں"
  },
  {
    "surah_id": 82,
    "ayah_number": 11,
    "global_ayah_id": 5921,
    "translation": "ایسے معزز کاتب"
  },
  {
    "surah_id": 82,
    "ayah_number": 12,
    "global_ayah_id": 5922,
    "translation": "جو تمہارے ہر فعل کو جانتے ہیں"
  },
  {
    "surah_id": 82,
    "ayah_number": 13,
    "global_ayah_id": 5923,
    "translation": "یقیناً «<a href=634> نیک </a>» لوگ مزے میں ہوں گے"
  },
  {
    "surah_id": 82,
    "ayah_number": 14,
    "global_ayah_id": 5924,
    "translation": "اور بیشک بدکار لوگ جہنم میں جائیں گے"
  },
  {
    "surah_id": 82,
    "ayah_number": 15,
    "global_ayah_id": 5925,
    "translation": "جزا کے «<a href=326> دن </a>» وہ اس میں «<a href=313> داخل </a>» ہوں گے"
  },
  {
    "surah_id": 82,
    "ayah_number": 16,
    "global_ayah_id": 5926,
    "translation": "اور اس سے ہرگز «<a href=271> غائب </a>» نہ ہوسکیں گے"
  },
  {
    "surah_id": 82,
    "ayah_number": 17,
    "global_ayah_id": 5927,
    "translation": "اور تم کیا جانتے ہو کہ وہ جزا کا «<a href=326> دن </a>» کیا ہے ؟"
  },
  {
    "surah_id": 82,
    "ayah_number": 18,
    "global_ayah_id": 5928,
    "translation": "ہاں ، تمہیں کیا «<a href=293> خبر </a>» کہ وہ جزا کا «<a href=326> دن </a>» کیا ہے ؟"
  },
  {
    "surah_id": 82,
    "ayah_number": 19,
    "global_ayah_id": 5929,
    "translation": "یہ وہ «<a href=326> دن </a>» ہے جب کسی شخص کے لیے کچھ کرنا کسی کے بس میں نہ ہوگا ، «<a href=461> فیصلہ </a>» اس «<a href=326> دن </a>» بالکل اللہ کے «<a href=34> اختیار </a>» میں ہوگا"
  }
]