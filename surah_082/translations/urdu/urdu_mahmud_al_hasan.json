[
  {
    "surah_id": 82,
    "ayah_number": 0,
    "global_ayah_id": 5910,
    "translation": "اللہ کے نام سے جو رحمان و رحیم ہے"
  },
  {
    "surah_id": 82,
    "ayah_number": 1,
    "global_ayah_id": 5911,
    "translation": "جب آسمان چِر جائے"
  },
  {
    "surah_id": 82,
    "ayah_number": 2,
    "global_ayah_id": 5912,
    "translation": "اور جب تارے جھڑ پڑیں"
  },
  {
    "surah_id": 82,
    "ayah_number": 3,
    "global_ayah_id": 5913,
    "translation": "اور جب دریا ابل نکلیں"
  },
  {
    "surah_id": 82,
    "ayah_number": 4,
    "global_ayah_id": 5914,
    "translation": "اور جب قبریں زیروزبر کر دی جائیں"
  },
  {
    "surah_id": 82,
    "ayah_number": 5,
    "global_ayah_id": 5915,
    "translation": "جان لے ہر ایک جی جو کچھ کہ آگے بھیجا اور پیچھے چھوڑا"
  },
  {
    "surah_id": 82,
    "ayah_number": 6,
    "global_ayah_id": 5916,
    "translation": "اے آدمی کس چیز سے بہکا تو اپنے رب کریم پر"
  },
  {
    "surah_id": 82,
    "ayah_number": 7,
    "global_ayah_id": 5917,
    "translation": "جس نے تجھ کو بنایا پھر تجھ کو ٹھیک کیا پھر تجھ کو برابر کیا"
  },
  {
    "surah_id": 82,
    "ayah_number": 8,
    "global_ayah_id": 5918,
    "translation": "جس صورت میں چاہا تجھ کو جوڑ دیا"
  },
  {
    "surah_id": 82,
    "ayah_number": 9,
    "global_ayah_id": 5919,
    "translation": "ہرگز نہیں پر تم جھوٹ جانتے ہو انصاف کا ہونا"
  },
  {
    "surah_id": 82,
    "ayah_number": 10,
    "global_ayah_id": 5920,
    "translation": "اور تم پر نگہبان مقرر ہیں"
  },
  {
    "surah_id": 82,
    "ayah_number": 11,
    "global_ayah_id": 5921,
    "translation": "عزت والے عمل لکھنے والے"
  },
  {
    "surah_id": 82,
    "ayah_number": 12,
    "global_ayah_id": 5922,
    "translation": "جانتے ہیں جو کچھ تم کرتے ہو"
  },
  {
    "surah_id": 82,
    "ayah_number": 13,
    "global_ayah_id": 5923,
    "translation": "بیشک نیک لوگ بہشت میں ہیں"
  },
  {
    "surah_id": 82,
    "ayah_number": 14,
    "global_ayah_id": 5924,
    "translation": "اور بیشک گنہگار دوزخ میں ہیں"
  },
  {
    "surah_id": 82,
    "ayah_number": 15,
    "global_ayah_id": 5925,
    "translation": "ڈالے جائیں گے اُس میں انصاف کے دن"
  },
  {
    "surah_id": 82,
    "ayah_number": 16,
    "global_ayah_id": 5926,
    "translation": "اور نہ ہوں گے اُس سے جدا ہونے والے"
  },
  {
    "surah_id": 82,
    "ayah_number": 17,
    "global_ayah_id": 5927,
    "translation": "اور تجھ کو کیا خبر ہے کیسا ہے دن انصاف کا"
  },
  {
    "surah_id": 82,
    "ayah_number": 18,
    "global_ayah_id": 5928,
    "translation": "پھر بھی تجھ کو کیا خبر ہے کیسا ہے دن انصاف کا"
  },
  {
    "surah_id": 82,
    "ayah_number": 19,
    "global_ayah_id": 5929,
    "translation": "جس دن کہ بھلا نہ کر سکے کوئی جی کسی جی کا کچھ بھی اور حکم اُس دن اللہ ہی کا ہے"
  }
]