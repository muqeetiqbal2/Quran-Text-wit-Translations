    "ayah_number": 0,
    "global_ayah_id": 5910,
    "translation": "اللہ ہی کے «<a href=614> نام </a>» سے  (  «<a href=416> شروع </a>» کرتا ہوں )  جو نہایت رحم فرمانے والا بہت «<a href=600> مہربان </a>» ہے"
  },
  {
    "surah_id": 82,
    "ayah_number": 1,
    "global_ayah_id": 5911,
    "translation": "جب «<a href=10> آسمان </a>» پھٹ جائے گا"
  },
  {
    "surah_id": 82,
    "ayah_number": 2,
    "global_ayah_id": 5912,
    "translation": "اور جب ستارے جھڑ جائیں گے"
  },
  {
    "surah_id": 82,
    "ayah_number": 3,
    "global_ayah_id": 5913,
    "translation": "اور جب سمندر  (  اپنی «<a href=232> جگہ </a>» سے )  بہادیے جائیں گے"
  },
  {
    "surah_id": 82,
    "ayah_number": 4,
    "global_ayah_id": 5914,
    "translation": "اور جب قبریں شق کردی جائیں گی"
  },
  {
    "surah_id": 82,
    "ayah_number": 5,
    "global_ayah_id": 5915,
    "translation": "تو ہر شخص جان لے گا کہ اس نے «<a href=162> پہلے </a>» کیا عمل کیا تھا اور بعد میں کیا کیا تھا"
  },
  {
    "surah_id": 82,
    "ayah_number": 6,
    "global_ayah_id": 5916,
    "translation": "اے «<a href=3> انسان </a>» ! تجھے اپنے رب کریم سے کس چیز نے دھوکے میں رکھا تھا ؟"
  },
  {
    "surah_id": 82,
    "ayah_number": 7,
    "global_ayah_id": 5917,
    "translation": "جس نے تجھے «<a href=180> پیدا </a>» کیا، پھر «<a href=320> درست </a>» کیا، پھر  (  تیرے اعضاء کو )  متناسب بنایا"
  },
  {
    "surah_id": 82,
    "ayah_number": 8,
    "global_ayah_id": 5918,
    "translation": "پھر جس «<a href=421> صورت </a>» میں چاہا تجھے بنادیا"
  },
  {
    "surah_id": 82,
    "ayah_number": 9,
    "global_ayah_id": 5919,
    "translation": "بیشک تم روزِ جزاء کو جھٹلاتے ہو"
  },
  {
    "surah_id": 82,
    "ayah_number": 10,
    "global_ayah_id": 5920,
    "translation": "اور بیشک تم پر «<a href=628> نگہبان </a>»  ( «<a href=593> مقرر </a>» )  ہیں"
  },
  {
    "surah_id": 82,
    "ayah_number": 11,
    "global_ayah_id": 5921,
    "translation": "معزز «<a href=555> لکھنے </a>» والے"
  },
  {
    "surah_id": 82,
    "ayah_number": 12,
    "global_ayah_id": 5922,
    "translation": "وہ جانتے ہیں تم جو کچھ عمل کرتے ہو"
  },
  {
    "surah_id": 82,
    "ayah_number": 13,
    "global_ayah_id": 5923,
    "translation": "بیشک نیکو کار ضرور  (  «<a href=237> جنت </a>» کی )  «<a href=623> نعمت </a>» میں ہیں"
  },
  {
    "surah_id": 82,
    "ayah_number": 14,
    "global_ayah_id": 5924,
    "translation": "اور بیشک بدکار ضرور «<a href=331> دوزخ </a>» میں ہیں"
  },
  {
    "surah_id": 82,
    "ayah_number": 15,
    "global_ayah_id": 5925,
    "translation": "وہ روزِ جزاء کو اس میں پہنچیں گے"
  },
  {
    "surah_id": 82,
    "ayah_number": 16,
    "global_ayah_id": 5926,
    "translation": "اور وہ اس سے چھپ نہیں سکیں گے"
  },
  {
    "surah_id": 82,
    "ayah_number": 17,
    "global_ayah_id": 5927,
    "translation": "اور آپ نے کیا سمجھا روزِ جزاء کیا ہے ؟"
  },
  {
    "surah_id": 82,
    "ayah_number": 18,
    "global_ayah_id": 5928,
    "translation": "پھر آپ نے کیا سمجھا روزِ جزاء کیا ہے ؟"
  },
  {
    "surah_id": 82,
    "ayah_number": 19,
    "global_ayah_id": 5929,
    "translation": "جس «<a href=326> دن </a>» کوئی شخص کسی شخص کے لیے کسی چیز کا «<a href=564> مالک </a>» نہیں ہوگا، اور اس «<a href=326> دن </a>» تمام احکام اللہ ہی کے لیے ہوں گے"
  }
]