[
  {
    "surah_id": 82,
    "ayah_number": 1,
    "global_ayah_id": 5830,
    "translation": "ئاسمان يېرىلغان چاغدا،"
  },
  {
    "surah_id": 82,
    "ayah_number": 2,
    "global_ayah_id": 5831,
    "translation": "يۇلتۇزلار تۆكۈلگەن چاغدا،"
  },
  {
    "surah_id": 82,
    "ayah_number": 3,
    "global_ayah_id": 5832,
    "translation": "دېڭىزلار بىر - بىرىگە قوشۇلغان چاغدا،"
  },
  {
    "surah_id": 82,
    "ayah_number": 4,
    "global_ayah_id": 5833,
    "translation": "قەبرىلەر ئاستى - ئۈستى قىلىنغان (يەنى ئۆلۈكلەر چىقىرىلغان) چاغدا،"
  },
  {
    "surah_id": 82,
    "ayah_number": 5,
    "global_ayah_id": 5834,
    "translation": "ھەر ئادەم ئىلگىرى - كېيىن قىلغان ئىشلىرىنىڭ ھەممىسىنى بىلىدۇ"
  },
  {
    "surah_id": 82,
    "ayah_number": 6,
    "global_ayah_id": 5835,
    "translation": "ئى ئىنسان! سېنى مەرھەمەتلىك پەرۋەردىگارىڭغا ئاسىيلىق قىلىشقا نېمە ئالدىدى؟"
  },
  {
    "surah_id": 82,
    "ayah_number": 7,
    "global_ayah_id": 5836,
    "translation": "ئۇ سېنى ياراتتى، (ئەزالىرىڭنى) بېجىرىم، قامىتىڭنى تۈز قىلدى"
  },
  {
    "surah_id": 82,
    "ayah_number": 8,
    "global_ayah_id": 5837,
    "translation": "سېنى ئۇ خالىغان شەكىلدە قۇراشتۇردى"
  },
  {
    "surah_id": 82,
    "ayah_number": 9,
    "global_ayah_id": 5838,
    "translation": "ھەرگىز ئۇنداق قىلماڭلار (يەنى اﷲ نىڭ كەرەمىگە مەغرۇر بولماڭلار). (ئى مەككە كۇففارلىرى!) بەلكى سىلەر دىننى ئىنكار قىلىسىلەر"
  },
  {
    "surah_id": 82,
    "ayah_number": 10,
    "global_ayah_id": 5839,
    "translation": "ھالبۇكى سىلەرنىڭ ئۈستۈڭلاردا سىلەرنى كۈزىتىپ تۇرغۇچى پەرىشتىلەر بار"
  },
  {
    "surah_id": 82,
    "ayah_number": 11,
    "global_ayah_id": 5840,
    "translation": "ئۇلار (اﷲ نىڭ دەرگاھىدا) ھۆرمەتلىك پەرىشتىلەر بولۇپ، (سىلەرنىڭ سۆزلىرىڭلارنى ۋە ئەمەللىرىڭلار) نى يېزىپ تۇرىدۇ"
  },
  {
    "surah_id": 82,
    "ayah_number": 12,
    "global_ayah_id": 5841,
    "translation": "ئۇلار قىلمىشىڭلارنى بىلىپ تۇرىدۇ"
  },
  {
    "surah_id": 82,
    "ayah_number": 13,
    "global_ayah_id": 5842,
    "translation": "مۆمىنلەر شەك - شۈبھىسىز جەننەتتە بولىدۇ،"
  },
  {
    "surah_id": 82,
    "ayah_number": 14,
    "global_ayah_id": 5843,
    "translation": "كاپىرلار شەك - شۈبھىسىز دوزاختا بولىدۇ"
  },
  {
    "surah_id": 82,
    "ayah_number": 15,
    "global_ayah_id": 5844,
    "translation": "ئۇلار قىيامەت كۈنى دوزاخقا كىرىدۇ"
  },
  {
    "surah_id": 82,
    "ayah_number": 16,
    "global_ayah_id": 5845,
    "translation": "ئۇلار ھەرگىز دوزاختىن ئايرىلمايدۇ"
  },
  {
    "surah_id": 82,
    "ayah_number": 17,
    "global_ayah_id": 5846,
    "translation": "قىيامەت كۈنىنىڭ (دەھشەتلىكلىكىنىڭ) قانداقلىقىنى قانداق بىلەلەيسەن؟"
  },
  {
    "surah_id": 82,
    "ayah_number": 18,
    "global_ayah_id": 5847,
    "translation": "قىيامەت كۈنىنىڭ (دەھشەتلىكلىكىنىڭ) قانداقلىقىنى قانداق بىلەلەيسەن؟"
  },
  {
    "surah_id": 82,
    "ayah_number": 19,
    "global_ayah_id": 5848,
    "translation": "ئۇ كۈندە بىر ئادەمنىڭ يەنە بىر ئادەمگە ياردەم بېرىشى قولىدىن كەلمەيدۇ، بۇ كۈندە ھۆكۈم اﷲ قا خاستۇر"
  }
]