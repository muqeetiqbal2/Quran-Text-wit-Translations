[
  {
    "surah_id": 82,
    "ayah_number": 1,
    "global_ayah_id": 5830,
    "translation": "வானம் பிளந்து விடும்போது"
  },
  {
    "surah_id": 82,
    "ayah_number": 2,
    "global_ayah_id": 5831,
    "translation": "நட்சத்திரங்கள் உதிர்ந்து விழும்போது-"
  },
  {
    "surah_id": 82,
    "ayah_number": 3,
    "global_ayah_id": 5832,
    "translation": "கடல்கள் (பொங்கி ஒன்றால் ஒன்று) அகற்றப்படும் போது,"
  },
  {
    "surah_id": 82,
    "ayah_number": 4,
    "global_ayah_id": 5833,
    "translation": "கப்றுகள் திறக்கப்படும் போது,"
  },
  {
    "surah_id": 82,
    "ayah_number": 5,
    "global_ayah_id": 5834,
    "translation": "ஒவ்வோர் ஆத்மாவும், அது எதை முற்படுத்தி (அனுப்பி) வைத்தது, எதைப் பின்னே விட்டுச் சென்றது என்பதை அறிந்து கொள்ளும்."
  },
  {
    "surah_id": 82,
    "ayah_number": 6,
    "global_ayah_id": 5835,
    "translation": "மனிதனே! கொடையாளனான சங்கை மிக்க உன் இறைவனுக்கு மாறு செய்யும்படி உன்னை மருட்டி விட்டது எது?"
  },
  {
    "surah_id": 82,
    "ayah_number": 7,
    "global_ayah_id": 5836,
    "translation": "அவன்தான் உன்னைப்படைத்து, உன்னை ஒழுங்குபடுத்தி; உன்னைச் செவ்வையாக்கினான்."
  },
  {
    "surah_id": 82,
    "ayah_number": 8,
    "global_ayah_id": 5837,
    "translation": "எந்த வடிவத்தில் அவன் விரும்பினானோ (அதில் உன் உறுப்புகளைப்) பொருத்தினான்."
  },
  {
    "surah_id": 82,
    "ayah_number": 9,
    "global_ayah_id": 5838,
    "translation": "இவ்வாறிருந்தும் நீங்கள் (கியாம) நாளைப் பொய்ப்பிக்கின்றீர்கள்."
  },
  {
    "surah_id": 82,
    "ayah_number": 10,
    "global_ayah_id": 5839,
    "translation": "நிச்சயமாக, உங்கள் மீது பாது காவலர்கள் (நியமிக்கப்பட்டு) இருக்கின்றனர்."
  },
  {
    "surah_id": 82,
    "ayah_number": 11,
    "global_ayah_id": 5840,
    "translation": "(அவர்கள்) கண்ணியம் வாய்ந்த எழுத்தாளர்கள்."
  },
  {
    "surah_id": 82,
    "ayah_number": 12,
    "global_ayah_id": 5841,
    "translation": "நீங்கள் செய்கிறதை அவர்கள் அறிகிறார்கள்."
  },
  {
    "surah_id": 82,
    "ayah_number": 13,
    "global_ayah_id": 5842,
    "translation": "நிச்சயமாக நல்லவர்கள் நயீம் என்னும் சுவர்க்கத்தில் இருப்பார்கள்."
  },
  {
    "surah_id": 82,
    "ayah_number": 14,
    "global_ayah_id": 5843,
    "translation": "இன்னும், நிச்சயமாக, தீமை செய்தவர்கள் நரகத்தில் இருப்பார்கள்."
  },
  {
    "surah_id": 82,
    "ayah_number": 15,
    "global_ayah_id": 5844,
    "translation": "நியாயத்தீர்ப்பு நாளில் அவர்கள் அதில் பிரவேசிப்பார்கள்."
  },
  {
    "surah_id": 82,
    "ayah_number": 16,
    "global_ayah_id": 5845,
    "translation": "மேலும், அவர்கள் அதிலிருந்து (தப்பித்து) மறைந்து விட மாட்டார்கள்."
  },
  {
    "surah_id": 82,
    "ayah_number": 17,
    "global_ayah_id": 5846,
    "translation": "நியாயத் தீர்ப்பு நாள் என்ன வென்று உமக்கு அறிவிப்பது எது?"
  },
  {
    "surah_id": 82,
    "ayah_number": 18,
    "global_ayah_id": 5847,
    "translation": "பின்னும் - நியாயத் தீர்ப்பு நாள் என்ன என்று உமக்கு அறிவிப்பது எது?"
  },
  {
    "surah_id": 82,
    "ayah_number": 19,
    "global_ayah_id": 5848,
    "translation": "அந்நாளில் ஓர் அத்மா பிறிதோர் ஆத்மாவுக்கு எதுவும் செய்ய சக்தி பெறாது, அதிகாரம் முழுவதும் அன்று அல்லாஹ்வுக்கே."
  }
]