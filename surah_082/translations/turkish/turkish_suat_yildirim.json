[
  {
    "surah_id": 82,
    "ayah_number": 1,
    "global_ayah_id": 5830,
    "translation": "Gök yarıldığı zaman..."
  },
  {
    "surah_id": 82,
    "ayah_number": 2,
    "global_ayah_id": 5831,
    "translation": "Yıldızlar parçalanıp etrafa saçıldığı zaman..."
  },
  {
    "surah_id": 82,
    "ayah_number": 3,
    "global_ayah_id": 5832,
    "translation": "Denizler birbirine katılıp tek deniz haline geldiği zaman..."
  },
  {
    "surah_id": 82,
    "ayah_number": 4,
    "global_ayah_id": 5833,
    "translation": "Kabirlerin içi dışına çıkarıldığı zaman..."
  },
  {
    "surah_id": 82,
    "ayah_number": 5,
    "global_ayah_id": 5834,
    "translation": "İşte o zaman!.. Her kişi ne yapıp ne yapmadığını iyice anlayacaktır."
  },
  {
    "surah_id": 82,
    "ayah_number": 6,
    "global_ayah_id": 5835,
    "translation": "Ey insan, nedir seni o kerim Rabbin hakkında aldatan?"
  },
  {
    "surah_id": 82,
    "ayah_number": 7,
    "global_ayah_id": 5836,
    "translation": "O değil mi seni yaratan, bütün vücud sistemini düzenleyen ve sana dengeli bir hilkat veren,"
  },
  {
    "surah_id": 82,
    "ayah_number": 8,
    "global_ayah_id": 5837,
    "translation": "Ve seni dilediği bir surette terkib eden?"
  },
  {
    "surah_id": 82,
    "ayah_number": 9,
    "global_ayah_id": 5838,
    "translation": "Hayır, yanlış yapıyorsunuz! Siz tutup dini, dirilip hesap vermeyi yalan sayıyorsunuz."
  },
  {
    "surah_id": 82,
    "ayah_number": 10,
    "global_ayah_id": 5839,
    "translation": "Halbuki yanınızdan ayrılmayan muhafızlar var."
  },
  {
    "surah_id": 82,
    "ayah_number": 11,
    "global_ayah_id": 5840,
    "translation": "O muhafızlar değerli, şerefli kâtiplerdir."
  },
  {
    "surah_id": 82,
    "ayah_number": 12,
    "global_ayah_id": 5841,
    "translation": "Yaptığınız her şeyi bilip yazarlar. [18,49]"
  },
  {
    "surah_id": 82,
    "ayah_number": 13,
    "global_ayah_id": 5842,
    "translation": "İyi ve hayırlı insanlar naîm cennetinde, nimetler içindedirler."
  },
  {
    "surah_id": 82,
    "ayah_number": 14,
    "global_ayah_id": 5843,
    "translation": "Yoldan sapan kâfirler ise ateştedirler."
  },
  {
    "surah_id": 82,
    "ayah_number": 15,
    "global_ayah_id": 5844,
    "translation": "Onlar yalan saydıkları hesap günü oraya girerler."
  },
  {
    "surah_id": 82,
    "ayah_number": 16,
    "global_ayah_id": 5845,
    "translation": "Hem oradan hiç ayrılmazlar."
  },
  {
    "surah_id": 82,
    "ayah_number": 17,
    "global_ayah_id": 5846,
    "translation": "O din gününün, o hesap gününün ne olduğunu sen bilir misin?"
  },
  {
    "surah_id": 82,
    "ayah_number": 18,
    "global_ayah_id": 5847,
    "translation": "Evet, bir daha söylüyorum: Din gününün ne olduğunu sen bilir misin?"
  },
  {
    "surah_id": 82,
    "ayah_number": 19,
    "global_ayah_id": 5848,
    "translation": "O, kimsenin kimseye hiç fayda veremeyeceği bir gün!O gün, bütün hüküm ve yetki, yalnız Allah'ın! [1,4; 100,10]"
  }
]