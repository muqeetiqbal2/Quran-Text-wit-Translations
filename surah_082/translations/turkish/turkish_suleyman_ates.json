[
  {
    "surah_id": 82,
    "ayah_number": 1,
    "global_ayah_id": 5830,
    "translation": "Gök yarıldığı zaman,"
  },
  {
    "surah_id": 82,
    "ayah_number": 2,
    "global_ayah_id": 5831,
    "translation": "Yıldızlar saçıldığı zaman,"
  },
  {
    "surah_id": 82,
    "ayah_number": 3,
    "global_ayah_id": 5832,
    "translation": "Denizler fışkırtıldığı zaman,"
  },
  {
    "surah_id": 82,
    "ayah_number": 4,
    "global_ayah_id": 5833,
    "translation": "Kabirlerin içi dışına getirildiği zaman,"
  },
  {
    "surah_id": 82,
    "ayah_number": 5,
    "global_ayah_id": 5834,
    "translation": "Her can, ne (yapıp) öne sürdüğünü ve ne (yapmayıp) geride bıraktığını bilir."
  },
  {
    "surah_id": 82,
    "ayah_number": 6,
    "global_ayah_id": 5835,
    "translation": "Ey insan, seni engin kerem sahibi Rabbine karşı ne aldatıp isyana sürükledi?"
  },
  {
    "surah_id": 82,
    "ayah_number": 7,
    "global_ayah_id": 5836,
    "translation": "O (Rab) ki seni yarattı, seni düzenledi, sana ölçülü bir biçim verdi."
  },
  {
    "surah_id": 82,
    "ayah_number": 8,
    "global_ayah_id": 5837,
    "translation": "Seni(n organlarını) dilediği şekilde birbirine ekledi."
  },
  {
    "surah_id": 82,
    "ayah_number": 9,
    "global_ayah_id": 5838,
    "translation": "Hayır, (bu gururunuzun sebebi şudur) siz ceza (görme)yi yalanlıyorsunuz."
  },
  {
    "surah_id": 82,
    "ayah_number": 10,
    "global_ayah_id": 5839,
    "translation": "Oysa üzerinizde koruyucu(yaptıklarınızı zabtedici melek)ler vardır;"
  },
  {
    "surah_id": 82,
    "ayah_number": 11,
    "global_ayah_id": 5840,
    "translation": "Değerli yazıcılar,"
  },
  {
    "surah_id": 82,
    "ayah_number": 12,
    "global_ayah_id": 5841,
    "translation": "Yaptığınız herşeyi bilirler."
  },
  {
    "surah_id": 82,
    "ayah_number": 13,
    "global_ayah_id": 5842,
    "translation": "İyiler ni'met içindedirler."
  },
  {
    "surah_id": 82,
    "ayah_number": 14,
    "global_ayah_id": 5843,
    "translation": "Kötüler de yakıcı ateş içindedirler."
  },
  {
    "surah_id": 82,
    "ayah_number": 15,
    "global_ayah_id": 5844,
    "translation": "Ceza günü oraya girerler."
  },
  {
    "surah_id": 82,
    "ayah_number": 16,
    "global_ayah_id": 5845,
    "translation": "Onlar ondan (hiçbir yere kaçıp) kaybolacak değillerdir."
  },
  {
    "surah_id": 82,
    "ayah_number": 17,
    "global_ayah_id": 5846,
    "translation": "Ceza gününün ne olduğunu sen nereden bileceksin?"
  },
  {
    "surah_id": 82,
    "ayah_number": 18,
    "global_ayah_id": 5847,
    "translation": "Ve yine ceza gününün ne olduğunu sen nereden bileceksin?"
  },
  {
    "surah_id": 82,
    "ayah_number": 19,
    "global_ayah_id": 5848,
    "translation": "O, kimsenin kimseye yardım edemeyeceği bir gündür! O gün buyruk, yalnız Allah'ındır."
  }
]