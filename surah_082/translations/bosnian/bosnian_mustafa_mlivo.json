[
  {
    "surah_id": 82,
    "ayah_number": 1,
    "global_ayah_id": 5830,
    "translation": "Kad se nebo rascijepi,"
  },
  {
    "surah_id": 82,
    "ayah_number": 2,
    "global_ayah_id": 5831,
    "translation": "I kad se planete rasprše,"
  },
  {
    "surah_id": 82,
    "ayah_number": 3,
    "global_ayah_id": 5832,
    "translation": "I kad mora uzavriju,"
  },
  {
    "surah_id": 82,
    "ayah_number": 4,
    "global_ayah_id": 5833,
    "translation": "I kad se kaburi ispreturaju,"
  },
  {
    "surah_id": 82,
    "ayah_number": 5,
    "global_ayah_id": 5834,
    "translation": "Znaće duša šta je unaprijed poslala i (šta) zapostavila."
  },
  {
    "surah_id": 82,
    "ayah_number": 6,
    "global_ayah_id": 5835,
    "translation": "O čovječe! Šta te je obmanulo o Gospodaru tvom plemenitom,"
  },
  {
    "surah_id": 82,
    "ayah_number": 7,
    "global_ayah_id": 5836,
    "translation": "Koji te je stvorio, pa te uredio, te te simetričnim učinio?,"
  },
  {
    "surah_id": 82,
    "ayah_number": 8,
    "global_ayah_id": 5837,
    "translation": "U kojem obliku, kako je htio, sastavio te!"
  },
  {
    "surah_id": 82,
    "ayah_number": 9,
    "global_ayah_id": 5838,
    "translation": "Nikako! Naprotiv, poričete Sud."
  },
  {
    "surah_id": 82,
    "ayah_number": 10,
    "global_ayah_id": 5839,
    "translation": "A uistinu, nad vama su čuvari,"
  },
  {
    "surah_id": 82,
    "ayah_number": 11,
    "global_ayah_id": 5840,
    "translation": "Plemeniti pisari,"
  },
  {
    "surah_id": 82,
    "ayah_number": 12,
    "global_ayah_id": 5841,
    "translation": "Znaju šta činite."
  },
  {
    "surah_id": 82,
    "ayah_number": 13,
    "global_ayah_id": 5842,
    "translation": "Uistinu, pravedni će u zadovoljstvo,"
  },
  {
    "surah_id": 82,
    "ayah_number": 14,
    "global_ayah_id": 5843,
    "translation": "I uistinu, razvratnici će u džehim."
  },
  {
    "surah_id": 82,
    "ayah_number": 15,
    "global_ayah_id": 5844,
    "translation": "Pržiće se njime Dana sudnjeg,"
  },
  {
    "surah_id": 82,
    "ayah_number": 16,
    "global_ayah_id": 5845,
    "translation": "I neće oni iz njega biti odsutni."
  },
  {
    "surah_id": 82,
    "ayah_number": 17,
    "global_ayah_id": 5846,
    "translation": "A šta znaš ti šta je Dan sudnji?"
  },
  {
    "surah_id": 82,
    "ayah_number": 18,
    "global_ayah_id": 5847,
    "translation": "Ponovo, šta znaš ti šta je Dan sudnji?"
  },
  {
    "surah_id": 82,
    "ayah_number": 19,
    "global_ayah_id": 5848,
    "translation": "Dan kad neće vladati duša za dušu nimalo, a komanda će Tog dana biti Allahova."
  }
]