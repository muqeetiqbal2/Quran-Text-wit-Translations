[
  {
    "surah_id": 82,
    "ayah_number": 1,
    "global_ayah_id": 5830,
    "translation": "जब आसमान तर्ख़ जाएगा"
  },
  {
    "surah_id": 82,
    "ayah_number": 2,
    "global_ayah_id": 5831,
    "translation": "और जब तारे झड़ पड़ेंगे"
  },
  {
    "surah_id": 82,
    "ayah_number": 3,
    "global_ayah_id": 5832,
    "translation": "और जब दरिया बह (कर एक दूसरे से मिल) जाएँगे"
  },
  {
    "surah_id": 82,
    "ayah_number": 4,
    "global_ayah_id": 5833,
    "translation": "और जब कब्रें उखाड़ दी जाएँगी"
  },
  {
    "surah_id": 82,
    "ayah_number": 5,
    "global_ayah_id": 5834,
    "translation": "तब हर शख़्श को मालूम हो जाएगा कि उसने आगे क्या भेजा था और पीछे क्या छोड़ा था"
  },
  {
    "surah_id": 82,
    "ayah_number": 6,
    "global_ayah_id": 5835,
    "translation": "ऐ इन्सान तुम्हें अपने परवरदिगार के बारे में किस चीज़ ने धोका दिया"
  },
  {
    "surah_id": 82,
    "ayah_number": 7,
    "global_ayah_id": 5836,
    "translation": "जिसने तुझे पैदा किया तो तुझे दुरूस्त बनाया और मुनासिब आज़ा दिए"
  },
  {
    "surah_id": 82,
    "ayah_number": 8,
    "global_ayah_id": 5837,
    "translation": "और जिस सूरत में उसने चाहा तेरे जोड़ बन्द मिलाए"
  },
  {
    "surah_id": 82,
    "ayah_number": 9,
    "global_ayah_id": 5838,
    "translation": "हाँ बात ये है कि तुम लोग जज़ा (के दिन) को झुठलाते हो"
  },
  {
    "surah_id": 82,
    "ayah_number": 10,
    "global_ayah_id": 5839,
    "translation": "हालॉकि तुम पर निगेहबान मुक़र्रर हैं"
  },
  {
    "surah_id": 82,
    "ayah_number": 11,
    "global_ayah_id": 5840,
    "translation": "बुर्ज़ुग लोग (फरिश्ते सब बातों को) लिखने वाले (केरामन क़ातेबीन)"
  },
  {
    "surah_id": 82,
    "ayah_number": 12,
    "global_ayah_id": 5841,
    "translation": "जो कुछ तुम करते हो वह सब जानते हैं"
  },
  {
    "surah_id": 82,
    "ayah_number": 13,
    "global_ayah_id": 5842,
    "translation": "बेशक नेको कार (बेहिश्त की) नेअमतों में होंगे"
  },
  {
    "surah_id": 82,
    "ayah_number": 14,
    "global_ayah_id": 5843,
    "translation": "और बदकार लोग यक़ीनन जहन्नुम में जज़ा के दिन"
  },
  {
    "surah_id": 82,
    "ayah_number": 15,
    "global_ayah_id": 5844,
    "translation": "उसी में झोंके जाएँगे"
  },
  {
    "surah_id": 82,
    "ayah_number": 16,
    "global_ayah_id": 5845,
    "translation": "और वह लोग उससे छुप न सकेंगे"
  },
  {
    "surah_id": 82,
    "ayah_number": 17,
    "global_ayah_id": 5846,
    "translation": "और तुम्हें क्या मालूम कि जज़ा का दिन क्या है"
  },
  {
    "surah_id": 82,
    "ayah_number": 18,
    "global_ayah_id": 5847,
    "translation": "फिर तुम्हें क्या मालूम कि जज़ा का दिन क्या चीज़ है"
  },
  {
    "surah_id": 82,
    "ayah_number": 19,
    "global_ayah_id": 5848,
    "translation": "उस दिन कोई शख़्श किसी शख़्श की भलाई न कर सकेगा और उस दिन हुक्म सिर्फ ख़ुदा ही का होगा"
  }
]