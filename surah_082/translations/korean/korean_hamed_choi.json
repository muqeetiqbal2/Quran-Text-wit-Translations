[
  {
    "surah_id": 82,
    "ayah_number": 1,
    "global_ayah_id": 5830,
    "translation": "하늘이 갈라지고"
  },
  {
    "surah_id": 82,
    "ayah_number": 2,
    "global_ayah_id": 5831,
    "translation": "별들이 흩어지며"
  },
  {
    "surah_id": 82,
    "ayah_number": 3,
    "global_ayah_id": 5832,
    "translation": "바다가 열리어 하나가 되고"
  },
  {
    "surah_id": 82,
    "ayah_number": 4,
    "global_ayah_id": 5833,
    "translation": "모든 무덤이 열리어 뒤엎어지 며"
  },
  {
    "surah_id": 82,
    "ayah_number": 5,
    "global_ayah_id": 5834,
    "translation": "그때 모든 인간은 앞서 있었 던 것들과 미루었던 것들을 알게 되노라"
  },
  {
    "surah_id": 82,
    "ayah_number": 6,
    "global_ayah_id": 5835,
    "translation": "인간들이여 가장 은혜로우신 주님으로부터 무엇이 너희를 유혹 했느뇨"
  },
  {
    "surah_id": 82,
    "ayah_number": 7,
    "global_ayah_id": 5836,
    "translation": "그분께서 너희를 창조하고 형 상을 만든 후 균형을 주시었고"
  },
  {
    "surah_id": 82,
    "ayah_number": 8,
    "global_ayah_id": 5837,
    "translation": "그분이 원하시는 형태로써 너희를 지으셨으나"
  },
  {
    "surah_id": 82,
    "ayah_number": 9,
    "global_ayah_id": 5838,
    "translation": "너희는 진리와 심판을 거역하매"
  },
  {
    "surah_id": 82,
    "ayah_number": 10,
    "global_ayah_id": 5839,
    "translation": "너희를 감시하는 자들을 두 었노라"
  },
  {
    "surah_id": 82,
    "ayah_number": 11,
    "global_ayah_id": 5840,
    "translation": "이들은 명예로운 기록자들이매"
  },
  {
    "surah_id": 82,
    "ayah_number": 12,
    "global_ayah_id": 5841,
    "translation": "그들은 너희가 행하는 모든 것을 알고 있노라"
  },
  {
    "surah_id": 82,
    "ayah_number": 13,
    "global_ayah_id": 5842,
    "translation": "실로 의로운 자들은 축복속 에 있게 되나"
  },
  {
    "surah_id": 82,
    "ayah_number": 14,
    "global_ayah_id": 5843,
    "translation": "사악한 자들은 불지옥에 있 게 되나니"
  },
  {
    "surah_id": 82,
    "ayah_number": 15,
    "global_ayah_id": 5844,
    "translation": "그곳은 심판의 날 그들이 들어갈 곳으로"
  },
  {
    "surah_id": 82,
    "ayah_number": 16,
    "global_ayah_id": 5845,
    "translation": "그때 그들은 그곳으로부터 결코 나갈 수 없노라"
  },
  {
    "surah_id": 82,
    "ayah_number": 17,
    "global_ayah_id": 5846,
    "translation": "심판의 날이 무엇인지 무엇 이 그대에게 알려주리요"
  },
  {
    "surah_id": 82,
    "ayah_number": 18,
    "global_ayah_id": 5847,
    "translation": "심판의 날이 무엇인지 무엇 이 그대에게 알려주리요"
  },
  {
    "surah_id": 82,
    "ayah_number": 19,
    "global_ayah_id": 5848,
    "translation": "그날은 누구도 타인에게 효 용이 없는 날로 그날은 하나님의 명령만이 있을 뿐이라"
  }
]