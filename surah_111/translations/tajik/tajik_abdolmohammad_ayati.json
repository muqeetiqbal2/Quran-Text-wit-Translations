  {
    "surah_id": 111,
    "ayah_number": 1,
    "global_ayah_id": 6217,
    "translation": "Дастҳои Абулаҳаб бурида бод ва ҳалок бар ӯ бод."
  },
  {
    "surah_id": 111,
    "ayah_number": 2,
    "global_ayah_id": 6218,
    "translation": "Моли ӯ ва он чӣ ба даст оварда буд, ба ҳолаш суд накард."
  },
  {
    "surah_id": 111,
    "ayah_number": 3,
    "global_ayah_id": 6219,
    "translation": "Ба зудӣ ба оташе шӯълавар дарояд"
  },
  {
    "surah_id": 111,
    "ayah_number": 4,
    "global_ayah_id": 6220,
    "translation": "ва занаш ҳезумкаш аст"
  },
  {
    "surah_id": 111,
    "ayah_number": 5,
    "global_ayah_id": 6221,
    "translation": "ва бар гардан ресмоне аз лифи (пӯсти) хурмо дорад."
  }
]