  {
    "surah_id": 111,
    "ayah_number": 1,
    "global_ayah_id": 6217,
    "translation": "Да се погубят двете ръце на Абу Лахаб! И той да се погуби!"
  },
  {
    "surah_id": 111,
    "ayah_number": 2,
    "global_ayah_id": 6218,
    "translation": "Не го избави неговият имот и онова, което е придобил."
  },
  {
    "surah_id": 111,
    "ayah_number": 3,
    "global_ayah_id": 6219,
    "translation": "Ще гори в огън с пламъци той"
  },
  {
    "surah_id": 111,
    "ayah_number": 4,
    "global_ayah_id": 6220,
    "translation": "и жена му, носещата дърва."
  },
  {
    "surah_id": 111,
    "ayah_number": 5,
    "global_ayah_id": 6221,
    "translation": "На шията й ще има въже от сплетени влакна."
  }
]