[
  {
    "surah_id": 111,
    "ayah_number": 1,
    "global_ayah_id": 6217,
    "translation": "അബൂലഹബിന്‍റെ ഇരുകൈകളും നശിച്ചിരിക്കുന്നു. അവന്‍ നാശമടയുകയും ചെയ്തിരിക്കുന്നു."
  },
  {
    "surah_id": 111,
    "ayah_number": 2,
    "global_ayah_id": 6218,
    "translation": "അവന്‍റെ ധനമോ അവന്‍ സമ്പാദിച്ചുവെച്ചതോ അവനു ഉപകാരപ്പെട്ടില്ല."
  },
  {
    "surah_id": 111,
    "ayah_number": 3,
    "global_ayah_id": 6219,
    "translation": "തീജ്വാലകളുള്ള നരകാഗ്നിയില്‍ അവന്‍ പ്രവേശിക്കുന്നതാണ്‌."
  },
  {
    "surah_id": 111,
    "ayah_number": 4,
    "global_ayah_id": 6220,
    "translation": "വിറകുചുമട്ടുകാരിയായ അവന്‍റെ ഭാര്യയും."
  },
  {
    "surah_id": 111,
    "ayah_number": 5,
    "global_ayah_id": 6221,
    "translation": "അവളുടെ കഴുത്തില്‍ ഈന്തപ്പനനാരുകൊണ്ടുള്ള ഒരു കയറുണ്ടായിരിക്കും."
  }
]