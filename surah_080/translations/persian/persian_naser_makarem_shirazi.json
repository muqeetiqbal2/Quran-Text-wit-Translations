[
  {
    "surah_id": 80,
    "ayah_number": 1,
    "global_ayah_id": 5759,
    "translation": "چهره در هم کشید و روی برتافت..."
  },
  {
    "surah_id": 80,
    "ayah_number": 2,
    "global_ayah_id": 5760,
    "translation": "از اینکه نابینایی به سراغ او آمده بود!"
  },
  {
    "surah_id": 80,
    "ayah_number": 3,
    "global_ayah_id": 5761,
    "translation": "تو چه می‌دانی شاید او پاکی و تقوا پیشه کند،"
  },
  {
    "surah_id": 80,
    "ayah_number": 4,
    "global_ayah_id": 5762,
    "translation": "یا متذکّر گردد و این تذکّر به حال او مفید باشد!"
  },
  {
    "surah_id": 80,
    "ayah_number": 5,
    "global_ayah_id": 5763,
    "translation": "امّا آن کس که توانگر است،"
  },
  {
    "surah_id": 80,
    "ayah_number": 6,
    "global_ayah_id": 5764,
    "translation": "تو به او روی می‌آوری،"
  },
  {
    "surah_id": 80,
    "ayah_number": 7,
    "global_ayah_id": 5765,
    "translation": "در حالی که اگر او خود را پاک نسازد، چیزی بر تو نیست!"
  },
  {
    "surah_id": 80,
    "ayah_number": 8,
    "global_ayah_id": 5766,
    "translation": "امّا کسی که به سراغ تو می‌آید و کوشش می‌کند،"
  },
  {
    "surah_id": 80,
    "ayah_number": 9,
    "global_ayah_id": 5767,
    "translation": "و از خدا ترسان است،"
  },
  {
    "surah_id": 80,
    "ayah_number": 10,
    "global_ayah_id": 5768,
    "translation": "تو از او غافل می‌شوی!"
  },
  {
    "surah_id": 80,
    "ayah_number": 11,
    "global_ayah_id": 5769,
    "translation": "هرگز چنین نیست که آنها می‌پندارند؛ این (قرآن) تذکّر و یادآوری است،"
  },
  {
    "surah_id": 80,
    "ayah_number": 12,
    "global_ayah_id": 5770,
    "translation": "و هر کس بخواهد از آن پند می‌گیرد!"
  },
  {
    "surah_id": 80,
    "ayah_number": 13,
    "global_ayah_id": 5771,
    "translation": "در الواح پرارزشی ثبت است،"
  },
  {
    "surah_id": 80,
    "ayah_number": 14,
    "global_ayah_id": 5772,
    "translation": "الواحی والاقدر و پاکیزه،"
  },
  {
    "surah_id": 80,
    "ayah_number": 15,
    "global_ayah_id": 5773,
    "translation": "به دست سفیرانی است‌"
  },
  {
    "surah_id": 80,
    "ayah_number": 16,
    "global_ayah_id": 5774,
    "translation": "والا مقام و فرمانبردار و نیکوکار!"
  },
  {
    "surah_id": 80,
    "ayah_number": 17,
    "global_ayah_id": 5775,
    "translation": "مرگ بر این انسان، چقدر کافر و ناسپاس است!"
  },
  {
    "surah_id": 80,
    "ayah_number": 18,
    "global_ayah_id": 5776,
    "translation": "(خداوند) او را از چه چیز آفریده است؟!"
  },
  {
    "surah_id": 80,
    "ayah_number": 19,
    "global_ayah_id": 5777,
    "translation": "او را از نطفه ناچیزی آفرید، سپس اندازه‌گیری کرد و موزون ساخت،"
  },
  {
    "surah_id": 80,
    "ayah_number": 20,
    "global_ayah_id": 5778,
    "translation": "سپس راه را برای او آسان کرد،"
  },
  {
    "surah_id": 80,
    "ayah_number": 21,
    "global_ayah_id": 5779,
    "translation": "بعد او را میراند و در قبر پنهان نمود،"
  },
  {
    "surah_id": 80,
    "ayah_number": 22,
    "global_ayah_id": 5780,
    "translation": "سپس هرگاه بخواهد او را زنده می‌کند!"
  },
  {
    "surah_id": 80,
    "ayah_number": 23,
    "global_ayah_id": 5781,
    "translation": "چنین نیست که او می‌پندارد؛ او هنوز آنچه را (خدا) فرمان داده، اطاعت نکرده است!"
  },
  {
    "surah_id": 80,
    "ayah_number": 24,
    "global_ayah_id": 5782,
    "translation": "انسان باید به غذای خویش (و آفرینش آن) بنگرد!"
  },
  {
    "surah_id": 80,
    "ayah_number": 25,
    "global_ayah_id": 5783,
    "translation": "ما آب فراوان از آسمان فرو ریختیم،"
  },
  {
    "surah_id": 80,
    "ayah_number": 26,
    "global_ayah_id": 5784,
    "translation": "سپس زمین را از هم شکافتیم،"
  },
  {
    "surah_id": 80,
    "ayah_number": 27,
    "global_ayah_id": 5785,
    "translation": "و در آن دانه‌های فراوانی رویاندیم،"
  },
  {
    "surah_id": 80,
    "ayah_number": 28,
    "global_ayah_id": 5786,
    "translation": "و انگور و سبزی بسیار،"
  },
  {
    "surah_id": 80,
    "ayah_number": 29,
    "global_ayah_id": 5787,
    "translation": "و زیتون و نخل فراوان،"
  },
  {
    "surah_id": 80,
    "ayah_number": 30,
    "global_ayah_id": 5788,
    "translation": "و باغهای پردرخت،"
  },
  {
    "surah_id": 80,
    "ayah_number": 31,
    "global_ayah_id": 5789,
    "translation": "و میوه و چراگاه،"
  },
  {
    "surah_id": 80,
    "ayah_number": 32,
    "global_ayah_id": 5790,
    "translation": "تا وسیله‌ای برای بهره‌گیری شما و چهارپایانتان باشد!"
  },
  {
    "surah_id": 80,
    "ayah_number": 33,
    "global_ayah_id": 5791,
    "translation": "هنگامی که آن صدای مهیب [= صیحه رستاخیز] بیاید، (کافران در اندوه عمیقی فرومی‌روند)!"
  },
  {
    "surah_id": 80,
    "ayah_number": 34,
    "global_ayah_id": 5792,
    "translation": "در آن روز که انسان از برادر خود می‌گریزد،"
  },
  {
    "surah_id": 80,
    "ayah_number": 35,
    "global_ayah_id": 5793,
    "translation": "و از مادر و پدرش،"
  },
  {
    "surah_id": 80,
    "ayah_number": 36,
    "global_ayah_id": 5794,
    "translation": "و زن و فرزندانش؛"
  },
  {
    "surah_id": 80,
    "ayah_number": 37,
    "global_ayah_id": 5795,
    "translation": "در آن روز هر کدام از آنها وضعی دارد که او را کاملاً به خود مشغول می‌سازد!"
  },
  {
    "surah_id": 80,
    "ayah_number": 38,
    "global_ayah_id": 5796,
    "translation": "چهره‌هائی در آن روز گشاده و نورانی است،"
  },
  {
    "surah_id": 80,
    "ayah_number": 39,
    "global_ayah_id": 5797,
    "translation": "خندان و مسرور است؛"
  },
  {
    "surah_id": 80,
    "ayah_number": 40,
    "global_ayah_id": 5798,
    "translation": "و صورتهایی در آن روز غبارآلود است،"
  },
  {
    "surah_id": 80,
    "ayah_number": 41,
    "global_ayah_id": 5799,
    "translation": "و دود تاریکی آنها را پوشانده است،"
  },
  {
    "surah_id": 80,
    "ayah_number": 42,
    "global_ayah_id": 5800,
    "translation": "آنان همان کافران فاجرند!"
  }
]