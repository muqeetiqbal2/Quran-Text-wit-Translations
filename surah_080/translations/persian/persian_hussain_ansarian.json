[
  {
    "surah_id": 80,
    "ayah_number": 1,
    "global_ayah_id": 5759,
    "translation": "چهره در هم کشید و روی گردانید،"
  },
  {
    "surah_id": 80,
    "ayah_number": 2,
    "global_ayah_id": 5760,
    "translation": "از اینکه آن مرد نابینا نزد او آمد!"
  },
  {
    "surah_id": 80,
    "ayah_number": 3,
    "global_ayah_id": 5761,
    "translation": "تو چه می دانی شاید او [در پرتو تعالیم اسلام از آلودگی] پاک و پاکیزه شود"
  },
  {
    "surah_id": 80,
    "ayah_number": 4,
    "global_ayah_id": 5762,
    "translation": "یا متذکّر [حقایق] گردد و آن تذکر او را سود دهد؛"
  },
  {
    "surah_id": 80,
    "ayah_number": 5,
    "global_ayah_id": 5763,
    "translation": "اما کسی که خود را ثروتمند نشان می دهد"
  },
  {
    "surah_id": 80,
    "ayah_number": 6,
    "global_ayah_id": 5764,
    "translation": "تو به او روی می آوری [و نسبت به وی اهتمام می ورزی]"
  },
  {
    "surah_id": 80,
    "ayah_number": 7,
    "global_ayah_id": 5765,
    "translation": "در حالی که اگر او نخواهد خود را [از آلودگی های باطنی و عملی] پاک کند تکلیفی بر عهده تو [نسبت به او] نیست؛"
  },
  {
    "surah_id": 80,
    "ayah_number": 8,
    "global_ayah_id": 5766,
    "translation": "و اما آنکه شتابان نزد تو آمد"
  },
  {
    "surah_id": 80,
    "ayah_number": 9,
    "global_ayah_id": 5767,
    "translation": "در حالی که [از پروردگارش] می ترسد،"
  },
  {
    "surah_id": 80,
    "ayah_number": 10,
    "global_ayah_id": 5768,
    "translation": "تو [با روی گردانی] از او به دیگران می پردازی."
  },
  {
    "surah_id": 80,
    "ayah_number": 11,
    "global_ayah_id": 5769,
    "translation": "این چنین [برخوردی شایسته] نیست، بی تردید این آیات قرآن مایه پند است."
  },
  {
    "surah_id": 80,
    "ayah_number": 12,
    "global_ayah_id": 5770,
    "translation": "پس هرکه خواست از آن پند گیرد،"
  },
  {
    "surah_id": 80,
    "ayah_number": 13,
    "global_ayah_id": 5771,
    "translation": "در صحیفه هایی است ارزشمند"
  },
  {
    "surah_id": 80,
    "ayah_number": 14,
    "global_ayah_id": 5772,
    "translation": "بلند مرتبه و پاکیزه"
  },
  {
    "surah_id": 80,
    "ayah_number": 15,
    "global_ayah_id": 5773,
    "translation": "در دست سفیرانی"
  },
  {
    "surah_id": 80,
    "ayah_number": 16,
    "global_ayah_id": 5774,
    "translation": "بزرگوار و نیکوکار."
  },
  {
    "surah_id": 80,
    "ayah_number": 17,
    "global_ayah_id": 5775,
    "translation": "مرگ بر انسان، چه کافر و ناسپاس است!"
  },
  {
    "surah_id": 80,
    "ayah_number": 18,
    "global_ayah_id": 5776,
    "translation": "[خدا] او را از چه چیز آفریده؟"
  },
  {
    "surah_id": 80,
    "ayah_number": 19,
    "global_ayah_id": 5777,
    "translation": "از نطفه ای [ناچیز و بی مقدار] آفریده است، پس او را [در ذات، صفات و اندام] اندازه لازم عطا کرد."
  },
  {
    "surah_id": 80,
    "ayah_number": 20,
    "global_ayah_id": 5778,
    "translation": "آن گاه راه [هدایت، سعادت، خیر و طاعت] را برایش آسان ساخت."
  },
  {
    "surah_id": 80,
    "ayah_number": 21,
    "global_ayah_id": 5779,
    "translation": "سپس او را میراند و در گور نهاد،"
  },
  {
    "surah_id": 80,
    "ayah_number": 22,
    "global_ayah_id": 5780,
    "translation": "و سپس چون بخواهد او را زنده می کند."
  },
  {
    "surah_id": 80,
    "ayah_number": 23,
    "global_ayah_id": 5781,
    "translation": "این چنین نیست [که وظیفه اش را انجام داده باشد] هنوز آنچه را به او دستور داده به جا نیاورده است."
  },
  {
    "surah_id": 80,
    "ayah_number": 24,
    "global_ayah_id": 5782,
    "translation": "پس انسان باید به خوراکش با تأمل بنگرد"
  },
  {
    "surah_id": 80,
    "ayah_number": 25,
    "global_ayah_id": 5783,
    "translation": "که ما [از آسمان] آب فراوانی فرو ریختیم."
  },
  {
    "surah_id": 80,
    "ayah_number": 26,
    "global_ayah_id": 5784,
    "translation": "سپس زمین را [به صورتی سودمند] از هم شکافتیم."
  },
  {
    "surah_id": 80,
    "ayah_number": 27,
    "global_ayah_id": 5785,
    "translation": "پس در آن دانه های فراوانی رویاندیم،"
  },
  {
    "surah_id": 80,
    "ayah_number": 28,
    "global_ayah_id": 5786,
    "translation": "و انگور و سبزیجات"
  },
  {
    "surah_id": 80,
    "ayah_number": 29,
    "global_ayah_id": 5787,
    "translation": "و زیتون و درخت خرما…."
  },
  {
    "surah_id": 80,
    "ayah_number": 30,
    "global_ayah_id": 5788,
    "translation": "و بوستان های پر از درخت تناور و بزرگ"
  },
  {
    "surah_id": 80,
    "ayah_number": 31,
    "global_ayah_id": 5789,
    "translation": "و میوه و چراگاه"
  },
  {
    "surah_id": 80,
    "ayah_number": 32,
    "global_ayah_id": 5790,
    "translation": "تا مایه برخورداری شما و دام هایتان باشد. …."
  },
  {
    "surah_id": 80,
    "ayah_number": 33,
    "global_ayah_id": 5791,
    "translation": "پس زمانی که آن بانگ هولناک و مهیب در رسد،"
  },
  {
    "surah_id": 80,
    "ayah_number": 34,
    "global_ayah_id": 5792,
    "translation": "روزی که آدمی فرار می کند، از برادرش…."
  },
  {
    "surah_id": 80,
    "ayah_number": 35,
    "global_ayah_id": 5793,
    "translation": "و از مادر و پدرش…."
  },
  {
    "surah_id": 80,
    "ayah_number": 36,
    "global_ayah_id": 5794,
    "translation": "و از همسر و فرزندانش"
  },
  {
    "surah_id": 80,
    "ayah_number": 37,
    "global_ayah_id": 5795,
    "translation": "در آن روز هرکسی از آنان را کاری است که او را به خود مشغول می کند [تا جایی که نمی گذارد به چیز دیگری بپردازد.]"
  },
  {
    "surah_id": 80,
    "ayah_number": 38,
    "global_ayah_id": 5796,
    "translation": "در آن روز چهره هایی درخشان و نورانی است"
  },
  {
    "surah_id": 80,
    "ayah_number": 39,
    "global_ayah_id": 5797,
    "translation": "خندان و خوشحال…."
  },
  {
    "surah_id": 80,
    "ayah_number": 40,
    "global_ayah_id": 5798,
    "translation": "و در آن روز چهره هایی است که بر آنان غبار نشسته"
  },
  {
    "surah_id": 80,
    "ayah_number": 41,
    "global_ayah_id": 5799,
    "translation": "[و] سیاهی و تاریکی آنان را فرا گرفته است؛ …."
  },
  {
    "surah_id": 80,
    "ayah_number": 42,
    "global_ayah_id": 5800,
    "translation": "آنان همان کافران بد کارند."
  }
]