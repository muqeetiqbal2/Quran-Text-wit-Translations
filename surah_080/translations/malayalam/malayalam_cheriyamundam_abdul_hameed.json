[
  {
    "surah_id": 80,
    "ayah_number": 1,
    "global_ayah_id": 5759,
    "translation": "അദ്ദേഹം മുഖം ചുളിച്ചു തിരിഞ്ഞുകളഞ്ഞു."
  },
  {
    "surah_id": 80,
    "ayah_number": 2,
    "global_ayah_id": 5760,
    "translation": "അദ്ദേഹത്തിന്‍റെ (നബിയുടെ) അടുത്ത് ആ അന്ധന്‍ വന്നതിനാല്‍."
  },
  {
    "surah_id": 80,
    "ayah_number": 3,
    "global_ayah_id": 5761,
    "translation": "(നബിയേ,) നിനക്ക് എന്തറിയാം? അയാള്‍ (അന്ധന്‍) ഒരു വേള പരിശുദ്ധി പ്രാപിച്ചേക്കാമല്ലോ?"
  },
  {
    "surah_id": 80,
    "ayah_number": 4,
    "global_ayah_id": 5762,
    "translation": "അല്ലെങ്കില്‍ ഉപദേശം സ്വീകരിക്കുകയും, ആ ഉപദേശം അയാള്‍ക്ക് പ്രയോജനപ്പെടുകയും ചെയ്തേക്കാമല്ലോ."
  },
  {
    "surah_id": 80,
    "ayah_number": 5,
    "global_ayah_id": 5763,
    "translation": "എന്നാല്‍ സ്വയം പര്യാപ്തത നടിച്ചവനാകട്ടെ"
  },
  {
    "surah_id": 80,
    "ayah_number": 6,
    "global_ayah_id": 5764,
    "translation": "നീ അവന്‍റെ നേരെ ശ്രദ്ധതിരിക്കുന്നു."
  },
  {
    "surah_id": 80,
    "ayah_number": 7,
    "global_ayah_id": 5765,
    "translation": "അവന്‍ പരിശുദ്ധി പ്രാപിക്കാതിരിക്കുന്നതിനാല്‍ നിനക്കെന്താണ് കുറ്റം?"
  },
  {
    "surah_id": 80,
    "ayah_number": 8,
    "global_ayah_id": 5766,
    "translation": "എന്നാല്‍ നിന്‍റെ അടുക്കല്‍ ഓടിവന്നവനാകട്ടെ,"
  },
  {
    "surah_id": 80,
    "ayah_number": 9,
    "global_ayah_id": 5767,
    "translation": "(അല്ലാഹുവെ) അവന്‍ ഭയപ്പെടുന്നവനായിക്കൊണ്ട്‌"
  },
  {
    "surah_id": 80,
    "ayah_number": 10,
    "global_ayah_id": 5768,
    "translation": "അവന്‍റെ കാര്യത്തില്‍ നീ അശ്രദ്ധകാണിക്കുന്നു."
  },
  {
    "surah_id": 80,
    "ayah_number": 11,
    "global_ayah_id": 5769,
    "translation": "നിസ്സംശയം ഇത് (ഖുര്‍ആന്‍) ഒരു ഉല്‍ബോധനമാകുന്നു; തീര്‍ച്ച."
  },
  {
    "surah_id": 80,
    "ayah_number": 12,
    "global_ayah_id": 5770,
    "translation": "അതിനാല്‍ ആര്‍ ഉദ്ദേശിക്കുന്നുവോ അവനത് ഓര്‍മിച്ച് കൊള്ളട്ടെ."
  },
  {
    "surah_id": 80,
    "ayah_number": 13,
    "global_ayah_id": 5771,
    "translation": "ആദരണീയമായ ചില ഏടുകളിലാണത്‌."
  },
  {
    "surah_id": 80,
    "ayah_number": 14,
    "global_ayah_id": 5772,
    "translation": "ഔന്നത്യം നല്‍കപ്പെട്ടതും പരിശുദ്ധമാക്കപ്പെട്ടതുമായ (ഏടുകളില്‍)"
  },
  {
    "surah_id": 80,
    "ayah_number": 15,
    "global_ayah_id": 5773,
    "translation": "ചില സന്ദേശവാഹകരുടെ കൈകളിലാണത്‌."
  },
  {
    "surah_id": 80,
    "ayah_number": 16,
    "global_ayah_id": 5774,
    "translation": "മാന്യന്‍മാരും പുണ്യവാന്‍മാരും ആയിട്ടുള്ളവരുടെ."
  },
  {
    "surah_id": 80,
    "ayah_number": 17,
    "global_ayah_id": 5775,
    "translation": "മനുഷ്യന്‍ നാശമടയട്ടെ. എന്താണവന്‍ ഇത്ര നന്ദികെട്ടവനാകാന്‍?"
  },
  {
    "surah_id": 80,
    "ayah_number": 18,
    "global_ayah_id": 5776,
    "translation": "ഏതൊരു വസ്തുവില്‍ നിന്നാണ് അല്ലാഹു അവനെ സൃഷ്ടിച്ചത്‌?"
  },
  {
    "surah_id": 80,
    "ayah_number": 19,
    "global_ayah_id": 5777,
    "translation": "ഒരു ബീജത്തില്‍ നിന്ന് അവനെ സൃഷ്ടിക്കുകയും, എന്നിട്ട് അവനെ (അവന്‍റെ കാര്യം) വ്യവസ്ഥപ്പെടുത്തുകയും ചെയ്തു."
  },
  {
    "surah_id": 80,
    "ayah_number": 20,
    "global_ayah_id": 5778,
    "translation": "പിന്നീട് അവന്‍ മാര്‍ഗം എളുപ്പമാക്കുകയും ചെയ്തു."
  },
  {
    "surah_id": 80,
    "ayah_number": 21,
    "global_ayah_id": 5779,
    "translation": "അനന്തരം അവനെ മരിപ്പിക്കുകയും, ഖബ്‌റില്‍ മറയ്ക്കുകയും ചെയ്തു."
  },
  {
    "surah_id": 80,
    "ayah_number": 22,
    "global_ayah_id": 5780,
    "translation": "പിന്നീട് അവന്‍ ഉദ്ദേശിക്കുമ്പോള്‍ അവനെ ഉയിര്‍ത്തെഴുന്നേല്‍പിക്കുന്നതാണ്‌."
  },
  {
    "surah_id": 80,
    "ayah_number": 23,
    "global_ayah_id": 5781,
    "translation": "നിസ്സംശയം, അവനോട് അല്ലാഹു കല്‍പിച്ചത് അവന്‍ നിര്‍വഹിച്ചില്ല."
  },
  {
    "surah_id": 80,
    "ayah_number": 24,
    "global_ayah_id": 5782,
    "translation": "എന്നാല്‍ മനുഷ്യന്‍ തന്‍റെ ഭക്ഷണത്തെപ്പറ്റി ഒന്നു ചിന്തിച്ച് നോക്കട്ടെ."
  },
  {
    "surah_id": 80,
    "ayah_number": 25,
    "global_ayah_id": 5783,
    "translation": "നാം ശക്തിയായി മഴ വെള്ളം ചൊരിഞ്ഞുകൊടുത്തു."
  },
  {
    "surah_id": 80,
    "ayah_number": 26,
    "global_ayah_id": 5784,
    "translation": "പിന്നീട് നാം ഭൂമിയെ ഒരു തരത്തില്‍ പിളര്‍ത്തി,"
  },
  {
    "surah_id": 80,
    "ayah_number": 27,
    "global_ayah_id": 5785,
    "translation": "എന്നിട്ട് അതില്‍ നാം ധാന്യം മുളപ്പിച്ചു."
  },
  {
    "surah_id": 80,
    "ayah_number": 28,
    "global_ayah_id": 5786,
    "translation": "മുന്തിരിയും പച്ചക്കറികളും"
  },
  {
    "surah_id": 80,
    "ayah_number": 29,
    "global_ayah_id": 5787,
    "translation": "ഒലീവും ഈന്തപ്പനയും"
  },
  {
    "surah_id": 80,
    "ayah_number": 30,
    "global_ayah_id": 5788,
    "translation": "ഇടതൂര്‍ന്നു നില്‍ക്കുന്ന തോട്ടങ്ങളും."
  },
  {
    "surah_id": 80,
    "ayah_number": 31,
    "global_ayah_id": 5789,
    "translation": "പഴവര്‍ഗവും പുല്ലും."
  },
  {
    "surah_id": 80,
    "ayah_number": 32,
    "global_ayah_id": 5790,
    "translation": "നിങ്ങള്‍ക്കും നിങ്ങളുടെ കന്നുകാലികള്‍ക്കും ഉപയോഗത്തിനായിട്ട്‌."
  },
  {
    "surah_id": 80,
    "ayah_number": 33,
    "global_ayah_id": 5791,
    "translation": "എന്നാല്‍ ചെകിടടപ്പിക്കുന്ന ആ ശബ്ദം വന്നാല്‍."
  },
  {
    "surah_id": 80,
    "ayah_number": 34,
    "global_ayah_id": 5792,
    "translation": "അതായത് മനുഷ്യന്‍ തന്‍റെ സഹോദരനെ വിട്ട് ഓടിപ്പോകുന്ന ദിവസം."
  },
  {
    "surah_id": 80,
    "ayah_number": 35,
    "global_ayah_id": 5793,
    "translation": "തന്‍റെ മാതാവിനെയും പിതാവിനെയും."
  },
  {
    "surah_id": 80,
    "ayah_number": 36,
    "global_ayah_id": 5794,
    "translation": "തന്‍റെ ഭാര്യയെയും മക്കളെയും."
  },
  {
    "surah_id": 80,
    "ayah_number": 37,
    "global_ayah_id": 5795,
    "translation": "അവരില്‍പ്പെട്ട ഓരോ മനുഷ്യനും തനിക്ക് മതിയാവുന്നത്ര (ചിന്താ) വിഷയം അന്ന് ഉണ്ടായിരിക്കും."
  },
  {
    "surah_id": 80,
    "ayah_number": 38,
    "global_ayah_id": 5796,
    "translation": "അന്ന് ചില മുഖങ്ങള്‍ പ്രസന്നതയുള്ളവയായിരിക്കും"
  },
  {
    "surah_id": 80,
    "ayah_number": 39,
    "global_ayah_id": 5797,
    "translation": "ചിരിക്കുന്നവയും സന്തോഷം കൊള്ളുന്നവയും."
  },
  {
    "surah_id": 80,
    "ayah_number": 40,
    "global_ayah_id": 5798,
    "translation": "വെറെ ചില മുഖങ്ങളാകട്ടെ അന്ന് പൊടി പുരണ്ടിരിക്കും."
  },
  {
    "surah_id": 80,
    "ayah_number": 41,
    "global_ayah_id": 5799,
    "translation": "അവയെ കൂരിരുട്ട് മൂടിയിരിക്കും."
  },
  {
    "surah_id": 80,
    "ayah_number": 42,
    "global_ayah_id": 5800,
    "translation": "അക്കൂട്ടരാകുന്നു അവിശ്വാസികളും അധര്‍മ്മകാരികളുമായിട്ടുള്ളവര്‍."
  }
]