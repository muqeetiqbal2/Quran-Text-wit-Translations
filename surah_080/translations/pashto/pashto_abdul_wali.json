[
  {
    "surah_id": 80,
    "ayah_number": 1,
    "global_ayah_id": 5759,
    "translation": "ده تندى تریو كړ او مخ يې وګرځاوه"
  },
  {
    "surah_id": 80,
    "ayah_number": 2,
    "global_ayah_id": 5760,
    "translation": "په دې وجه چې ده ته ړوند راغى"
  },
  {
    "surah_id": 80,
    "ayah_number": 3,
    "global_ayah_id": 5761,
    "translation": "او ته څه شي پوه كړى يې۔، ښايي چې دى پاك شي"
  },
  {
    "surah_id": 80,
    "ayah_number": 4,
    "global_ayah_id": 5762,
    "translation": "یا به دى نصیحت (او پند) واخلي، نو ده ته به پند نفع ورسوي"
  },
  {
    "surah_id": 80,
    "ayah_number": 5,
    "global_ayah_id": 5763,
    "translation": "هر چې هغه څوك دى چې استغنا يې كړې ده"
  },
  {
    "surah_id": 80,
    "ayah_number": 6,
    "global_ayah_id": 5764,
    "translation": "نو ته په هغه پسې كېږې"
  },
  {
    "surah_id": 80,
    "ayah_number": 7,
    "global_ayah_id": 5765,
    "translation": "حال دا چې په تا هېڅ الزام نشته چې هغه پاك نشي"
  },
  {
    "surah_id": 80,
    "ayah_number": 8,
    "global_ayah_id": 5766,
    "translation": "او هر چې هغه څوك دى چې تا ته په منډو راځي"
  },
  {
    "surah_id": 80,
    "ayah_number": 9,
    "global_ayah_id": 5767,
    "translation": "په داسې حال كې چې دى (له الله نه) وېرېږي"
  },
  {
    "surah_id": 80,
    "ayah_number": 10,
    "global_ayah_id": 5768,
    "translation": "نو ته له هغه نه مشغولېږې"
  },
  {
    "surah_id": 80,
    "ayah_number": 11,
    "global_ayah_id": 5769,
    "translation": "داسې كله هم مه كوه، بېشكه دا (سورت) یو پند (او نصیحت) دى"
  },
  {
    "surah_id": 80,
    "ayah_number": 12,
    "global_ayah_id": 5770,
    "translation": "نو هغه څوك چې غواړي (نو) دى دې ومني"
  },
  {
    "surah_id": 80,
    "ayah_number": 13,
    "global_ayah_id": 5771,
    "translation": "(دغه) په عزتمنو پاڼو كې دى"
  },
  {
    "surah_id": 80,
    "ayah_number": 14,
    "global_ayah_id": 5772,
    "translation": "چې پورته كړى شوې، ښې پاكې كړى شوې دي"
  },
  {
    "surah_id": 80,
    "ayah_number": 15,
    "global_ayah_id": 5773,
    "translation": "د لیكونكو (ملايكو) په لاسونو كې"
  },
  {
    "surah_id": 80,
    "ayah_number": 16,
    "global_ayah_id": 5774,
    "translation": "چې ډېر عزتمن، ډېر نېك دي"
  },
  {
    "surah_id": 80,
    "ayah_number": 17,
    "global_ayah_id": 5775,
    "translation": "انسان دې هلاك كړى شي، دى څومره ډېر ناشكره دى!"
  },
  {
    "surah_id": 80,
    "ayah_number": 18,
    "global_ayah_id": 5776,
    "translation": "دى دغه (الله) له څه شي نه پیدا كړى دى؟"
  },
  {
    "surah_id": 80,
    "ayah_number": 19,
    "global_ayah_id": 5777,
    "translation": "له نطفې نه۔، دى يې پیدا كړى دى، پس دى يې اندازه كړى دى"
  },
  {
    "surah_id": 80,
    "ayah_number": 20,
    "global_ayah_id": 5778,
    "translation": "بیا يې ده ته لاره ور اسانه كړې ده"
  },
  {
    "surah_id": 80,
    "ayah_number": 21,
    "global_ayah_id": 5779,
    "translation": "بیا يې دى مړ كړ، نو دى يې په قبر كې كېښود"
  },
  {
    "surah_id": 80,
    "ayah_number": 22,
    "global_ayah_id": 5780,
    "translation": "بیا چې كله وغواړي دى به ژوندى كړي"
  },
  {
    "surah_id": 80,
    "ayah_number": 23,
    "global_ayah_id": 5781,
    "translation": "داسې نه ده۔، دغه (انسان) هغه كار نه دى كړى چې دغه (الله) ده ته حكم كړى دى"
  },
  {
    "surah_id": 80,
    "ayah_number": 24,
    "global_ayah_id": 5782,
    "translation": "نو انسان دې خپل طعام ته وګوري"
  },
  {
    "surah_id": 80,
    "ayah_number": 25,
    "global_ayah_id": 5783,
    "translation": "چې بېشكه مونږ اوبه راتوى كړې دي، راتویول"
  },
  {
    "surah_id": 80,
    "ayah_number": 26,
    "global_ayah_id": 5784,
    "translation": "بیا مونږ ځمكه څیرې كړې ده، څیرول"
  },
  {
    "surah_id": 80,
    "ayah_number": 27,
    "global_ayah_id": 5785,
    "translation": "نو مونږ په دې كې دانې را زرغونه كړي دي"
  },
  {
    "surah_id": 80,
    "ayah_number": 28,
    "global_ayah_id": 5786,
    "translation": "او انګور او تركاريانې"
  },
  {
    "surah_id": 80,
    "ayah_number": 29,
    "global_ayah_id": 5787,
    "translation": "او زیتون او كجورې"
  },
  {
    "surah_id": 80,
    "ayah_number": 30,
    "global_ayah_id": 5788,
    "translation": "او ګڼ باغونه"
  },
  {
    "surah_id": 80,
    "ayah_number": 31,
    "global_ayah_id": 5789,
    "translation": "او مېوې او ګياه (واښه)"
  },
  {
    "surah_id": 80,
    "ayah_number": 32,
    "global_ayah_id": 5790,
    "translation": "ستاسو او ستاسو د څارویو د فايدې لپاره"
  },
  {
    "surah_id": 80,
    "ayah_number": 33,
    "global_ayah_id": 5791,
    "translation": "نو كله چې سخت اواز راشي"
  },
  {
    "surah_id": 80,
    "ayah_number": 34,
    "global_ayah_id": 5792,
    "translation": "په هغه ورځ چې سړى به له خپل وروره تښتي"
  },
  {
    "surah_id": 80,
    "ayah_number": 35,
    "global_ayah_id": 5793,
    "translation": "او له خپلې مور او خپل پلاره"
  },
  {
    "surah_id": 80,
    "ayah_number": 36,
    "global_ayah_id": 5794,
    "translation": "او له خپلې ښځې او خپلو زامنو نه"
  },
  {
    "surah_id": 80,
    "ayah_number": 37,
    "global_ayah_id": 5795,
    "translation": "په دوى كې د هر سړي لپاره به په دغه ورځ كې یو حال وي چې دى به (له نورو نه) بې پروا (بې غوره) كوي"
  },
  {
    "surah_id": 80,
    "ayah_number": 38,
    "global_ayah_id": 5796,
    "translation": "څه مخونه به په دغې ورځ كې روښانه وي"
  },
  {
    "surah_id": 80,
    "ayah_number": 39,
    "global_ayah_id": 5797,
    "translation": "خندېدونكي (او) خوشاله به وي"
  },
  {
    "surah_id": 80,
    "ayah_number": 40,
    "global_ayah_id": 5798,
    "translation": "او څه مخونه به په دغې ورځ كې پر هغو به ګرد پروت وي"
  },
  {
    "surah_id": 80,
    "ayah_number": 41,
    "global_ayah_id": 5799,
    "translation": "دغه (مخونه) به توروالي پټ كړي وي"
  },
  {
    "surah_id": 80,
    "ayah_number": 42,
    "global_ayah_id": 5800,
    "translation": "دغه (تور مخي) خلق هم دوى كافران (او) فاجران (بدكاران) دي"
  }
]