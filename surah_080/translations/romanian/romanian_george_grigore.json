[
  {
    "surah_id": 80,
    "ayah_number": 1,
    "global_ayah_id": 5759,
    "translation": "El s-a încruntat şi a întors spatele,"
  },
  {
    "surah_id": 80,
    "ayah_number": 2,
    "global_ayah_id": 5760,
    "translation": "când orbul a venit la el."
  },
  {
    "surah_id": 80,
    "ayah_number": 3,
    "global_ayah_id": 5761,
    "translation": "Ce ştii tu? Poate s-ar fi mântuit"
  },
  {
    "surah_id": 80,
    "ayah_number": 4,
    "global_ayah_id": 5762,
    "translation": "ori şi-ar fi amintit, iar amintirea i-ar fi folosit."
  },
  {
    "surah_id": 80,
    "ayah_number": 5,
    "global_ayah_id": 5763,
    "translation": "În schimb pe cel bogat,"
  },
  {
    "surah_id": 80,
    "ayah_number": 6,
    "global_ayah_id": 5764,
    "translation": "tu îl primeşti cu cinste"
  },
  {
    "surah_id": 80,
    "ayah_number": 7,
    "global_ayah_id": 5765,
    "translation": "fără să-ţi pese dacă se va mântui,"
  },
  {
    "surah_id": 80,
    "ayah_number": 8,
    "global_ayah_id": 5766,
    "translation": "iar pe cel care vine la tine, plin de râvnă,"
  },
  {
    "surah_id": 80,
    "ayah_number": 9,
    "global_ayah_id": 5767,
    "translation": "plin de teamă,"
  },
  {
    "surah_id": 80,
    "ayah_number": 10,
    "global_ayah_id": 5768,
    "translation": "tu, cu nepăsare, îl primeşti!"
  },
  {
    "surah_id": 80,
    "ayah_number": 11,
    "global_ayah_id": 5769,
    "translation": "Nu! Aceasta este o amintire"
  },
  {
    "surah_id": 80,
    "ayah_number": 12,
    "global_ayah_id": 5770,
    "translation": "oricui vrea să-şi amintească!"
  },
  {
    "surah_id": 80,
    "ayah_number": 13,
    "global_ayah_id": 5771,
    "translation": "Ea este de pe sulurile prea cinstite,"
  },
  {
    "surah_id": 80,
    "ayah_number": 14,
    "global_ayah_id": 5772,
    "translation": "înălţate, curăţate,"
  },
  {
    "surah_id": 80,
    "ayah_number": 15,
    "global_ayah_id": 5773,
    "translation": "de mâinile scribilor"
  },
  {
    "surah_id": 80,
    "ayah_number": 16,
    "global_ayah_id": 5774,
    "translation": "cinstiţi şi nevinovaţi!"
  },
  {
    "surah_id": 80,
    "ayah_number": 17,
    "global_ayah_id": 5775,
    "translation": "Să fie ucis omul! Cât este de tăgăduitor!"
  },
  {
    "surah_id": 80,
    "ayah_number": 18,
    "global_ayah_id": 5776,
    "translation": "Din ce l-a creat?"
  },
  {
    "surah_id": 80,
    "ayah_number": 19,
    "global_ayah_id": 5777,
    "translation": "Dintr-un strop de sămânţă! L-a creat şi i-a dat o soartă;"
  },
  {
    "surah_id": 80,
    "ayah_number": 20,
    "global_ayah_id": 5778,
    "translation": "i-a făcut calea uşoară;"
  },
  {
    "surah_id": 80,
    "ayah_number": 21,
    "global_ayah_id": 5779,
    "translation": "apoi l-a lăsat să moară şi a pus să fie înmormântat;"
  },
  {
    "surah_id": 80,
    "ayah_number": 22,
    "global_ayah_id": 5780,
    "translation": "iar când va voi, îl va scula!"
  },
  {
    "surah_id": 80,
    "ayah_number": 23,
    "global_ayah_id": 5781,
    "translation": "Nu! Omul nu împlineşte ceea ce El îi porunceşte."
  },
  {
    "surah_id": 80,
    "ayah_number": 24,
    "global_ayah_id": 5782,
    "translation": "Omul, să se uite la hrana sa!"
  },
  {
    "surah_id": 80,
    "ayah_number": 25,
    "global_ayah_id": 5783,
    "translation": "Noi am vărsat apă, şi ce vărsare!"
  },
  {
    "surah_id": 80,
    "ayah_number": 26,
    "global_ayah_id": 5784,
    "translation": "Noi am crăpat pământul, şi ce crăpare!"
  },
  {
    "surah_id": 80,
    "ayah_number": 27,
    "global_ayah_id": 5785,
    "translation": "Noi am făcut să răsară grâne,"
  },
  {
    "surah_id": 80,
    "ayah_number": 28,
    "global_ayah_id": 5786,
    "translation": "vii şi legume,"
  },
  {
    "surah_id": 80,
    "ayah_number": 29,
    "global_ayah_id": 5787,
    "translation": "măslini şi curmali,"
  },
  {
    "surah_id": 80,
    "ayah_number": 30,
    "global_ayah_id": 5788,
    "translation": "şi grădini dese,"
  },
  {
    "surah_id": 80,
    "ayah_number": 31,
    "global_ayah_id": 5789,
    "translation": "fructe şi păşuni,"
  },
  {
    "surah_id": 80,
    "ayah_number": 32,
    "global_ayah_id": 5790,
    "translation": "zestre vouă şi turmelor voastre."
  },
  {
    "surah_id": 80,
    "ayah_number": 33,
    "global_ayah_id": 5791,
    "translation": "Când va veni însă Vuietul,"
  },
  {
    "surah_id": 80,
    "ayah_number": 34,
    "global_ayah_id": 5792,
    "translation": "în ziua când omul va fugi de fratele său,"
  },
  {
    "surah_id": 80,
    "ayah_number": 35,
    "global_ayah_id": 5793,
    "translation": "de mama sa, de tatăl său,"
  },
  {
    "surah_id": 80,
    "ayah_number": 36,
    "global_ayah_id": 5794,
    "translation": "de soţia sa, de fiii săi,"
  },
  {
    "surah_id": 80,
    "ayah_number": 37,
    "global_ayah_id": 5795,
    "translation": "în Ziua aceea fiece om îşi va primi răsplata."
  },
  {
    "surah_id": 80,
    "ayah_number": 38,
    "global_ayah_id": 5796,
    "translation": "În Ziua aceea"
  },
  {
    "surah_id": 80,
    "ayah_number": 39,
    "global_ayah_id": 5797,
    "translation": "vor fi chipuri strălucitoare, surâzătoare şi bucuroase,"
  },
  {
    "surah_id": 80,
    "ayah_number": 40,
    "global_ayah_id": 5798,
    "translation": "însă în Ziua aceea,"
  },
  {
    "surah_id": 80,
    "ayah_number": 41,
    "global_ayah_id": 5799,
    "translation": "vor fi şi chipuri colbuite."
  },
  {
    "surah_id": 80,
    "ayah_number": 42,
    "global_ayah_id": 5800,
    "translation": "Aceştia vor fi tăgăduitorii, desfrânaţii!"
  }
]