[
  {
    "surah_id": 80,
    "ayah_number": 0,
    "global_ayah_id": 5837,
    "translation": "अल्लाहच्या नावाने, जो अत्यंत दयावंत व असीम कृपावंत आहे."
  },
  {
    "surah_id": 80,
    "ayah_number": 1,
    "global_ayah_id": 5838,
    "translation": "क्रोधिष्ट झाला आणि उपेक्षा केली,"
  },
  {
    "surah_id": 80,
    "ayah_number": 2,
    "global_ayah_id": 5839,
    "translation": "या गोष्टीवर की तो अंध त्याच्याजवळ आला."
  },
  {
    "surah_id": 80,
    "ayah_number": 3,
    "global_ayah_id": 5840,
    "translation": "तुम्हाला काय कल्पना कदाचित तो सुधरेल"
  },
  {
    "surah_id": 80,
    "ayah_number": 4,
    "global_ayah_id": 5841,
    "translation": "अथवा उपदेशावर लक्ष देईल आणि उपदेश करणे त्याच्यासाठी लाभदायी ठरेल?"
  },
  {
    "surah_id": 80,
    "ayah_number": 5,
    "global_ayah_id": 5842,
    "translation": "जो इसम दुर्लक्ष करतो"
  },
  {
    "surah_id": 80,
    "ayah_number": 6,
    "global_ayah_id": 5843,
    "translation": "त्याच्याकडे तर तुम्ही लक्ष देता,"
  },
  {
    "surah_id": 80,
    "ayah_number": 7,
    "global_ayah_id": 5844,
    "translation": "वस्तुतः जर तो सुधारला नाही तर तुम्हावर त्याची काय जबाबदारी?"
  },
  {
    "surah_id": 80,
    "ayah_number": 8,
    "global_ayah_id": 5845,
    "translation": "आणि जो स्वतः तुमच्यापाशी धावत येतो"
  },
  {
    "surah_id": 80,
    "ayah_number": 9,
    "global_ayah_id": 5846,
    "translation": "आणि भीत असतो"
  },
  {
    "surah_id": 80,
    "ayah_number": 10,
    "global_ayah_id": 5847,
    "translation": "त्याची तुम्ही उपेक्षा करता!"
  },
  {
    "surah_id": 80,
    "ayah_number": 11,
    "global_ayah_id": 5848,
    "translation": "कदापि नाही, हा तर एक उपदेश आहे."
  },
  {
    "surah_id": 80,
    "ayah_number": 12,
    "global_ayah_id": 5849,
    "translation": "ज्याची इच्छा असेल त्याने हा स्वीकारावा."
  },
  {
    "surah_id": 80,
    "ayah_number": 13,
    "global_ayah_id": 5850,
    "translation": "हे अशा पत्रिकात नमूद आहेत ज्या प्रतिष्ठित आहे,"
  },
  {
    "surah_id": 80,
    "ayah_number": 14,
    "global_ayah_id": 5851,
    "translation": "उच्चकोटीच्या आहेत, पवित्र आहेत,"
  },
  {
    "surah_id": 80,
    "ayah_number": 15,
    "global_ayah_id": 5852,
    "translation": "लिहिणार्‍यांच्या हातात असतील."
  },
  {
    "surah_id": 80,
    "ayah_number": 16,
    "global_ayah_id": 5853,
    "translation": "सन्माननीय आणि प्रामाणिकपणे"
  },
  {
    "surah_id": 80,
    "ayah_number": 17,
    "global_ayah_id": 5854,
    "translation": "धिक्कार असो माणसाचा, सत्याचा किती कट्टर इन्कार करणारा आहे हा,"
  },
  {
    "surah_id": 80,
    "ayah_number": 18,
    "global_ayah_id": 5855,
    "translation": "कोणत्या वस्तूने अल्लाहने त्यास निर्माण केले आहे?"
  },
  {
    "surah_id": 80,
    "ayah_number": 19,
    "global_ayah_id": 5856,
    "translation": "वीर्याच्या एका थेंबाने अल्लाहने त्याला निर्माण केले, मग त्याचे भाग्य ठरविले"
  },
  {
    "surah_id": 80,
    "ayah_number": 20,
    "global_ayah_id": 5857,
    "translation": "मग त्याच्यासाठी जीवनाचा मार्ग सोपा केला,"
  },
  {
    "surah_id": 80,
    "ayah_number": 21,
    "global_ayah_id": 5858,
    "translation": "मग त्याला मृत्यू दिला आणि कबरीत पोहचविले."
  },
  {
    "surah_id": 80,
    "ayah_number": 22,
    "global_ayah_id": 5859,
    "translation": "मग हवे तेव्हा त्याने त्याला पुन्हा उठवून उभे करावे."
  },
  {
    "surah_id": 80,
    "ayah_number": 23,
    "global_ayah_id": 5860,
    "translation": "कदापि नाही, याने ते कर्तव्य बजावले नाही ज्याची आज्ञा अल्लाहने त्याला दिली होती."
  },
  {
    "surah_id": 80,
    "ayah_number": 24,
    "global_ayah_id": 5861,
    "translation": "मग जरा माणसाने आपल्या आहाराकडे पहावे."
  },
  {
    "surah_id": 80,
    "ayah_number": 25,
    "global_ayah_id": 5862,
    "translation": "आम्ही खूप पाणी ओतले,"
  },
  {
    "surah_id": 80,
    "ayah_number": 26,
    "global_ayah_id": 5863,
    "translation": "मग जमिनीला अजब तर्‍हेने फाडले,"
  },
  {
    "surah_id": 80,
    "ayah_number": 27,
    "global_ayah_id": 5864,
    "translation": "मग तिच्यात उगविली धान्य"
  },
  {
    "surah_id": 80,
    "ayah_number": 28,
    "global_ayah_id": 5865,
    "translation": "आणि द्राक्षे व भाज्या"
  },
  {
    "surah_id": 80,
    "ayah_number": 29,
    "global_ayah_id": 5866,
    "translation": "आणि जैतुन व खजुरी"
  },
  {
    "surah_id": 80,
    "ayah_number": 30,
    "global_ayah_id": 5867,
    "translation": "आणि घनदाट बागा"
  },
  {
    "surah_id": 80,
    "ayah_number": 31,
    "global_ayah_id": 5868,
    "translation": "आणि विभिन्न प्रकारची फळे व चारा"
  },
  {
    "surah_id": 80,
    "ayah_number": 32,
    "global_ayah_id": 5869,
    "translation": "तुमच्यासाठी आणि तुमच्या जनावरांसाठी जीवनसामग्री म्हणून."
  },
  {
    "surah_id": 80,
    "ayah_number": 33,
    "global_ayah_id": 5870,
    "translation": "सरतेशेवटी जेव्हा तो कान बधीर करणारा आवाज दुमदुमेल"
  },
  {
    "surah_id": 80,
    "ayah_number": 34,
    "global_ayah_id": 5871,
    "translation": "त्या दिवशी माणूस आपला भाऊ"
  },
  {
    "surah_id": 80,
    "ayah_number": 35,
    "global_ayah_id": 5872,
    "translation": "आणि आपली आई आणि आपले वडील"
  },
  {
    "surah_id": 80,
    "ayah_number": 36,
    "global_ayah_id": 5873,
    "translation": "आणि आपली पत्नी व आपल्या संततीपासून दूर पळेल"
  },
  {
    "surah_id": 80,
    "ayah_number": 37,
    "global_ayah_id": 5874,
    "translation": "त्यांच्यापैकी प्रत्येक माणसावर त्या दिवशी अशी वेळ येऊन ठेपेल की त्याला आपल्याखेरीज कुणाचेही भान राहणार नाही."
  },
  {
    "surah_id": 80,
    "ayah_number": 38,
    "global_ayah_id": 5875,
    "translation": "काही चेहरे त्या दिवशी चमकत असतील,"
  },
  {
    "surah_id": 80,
    "ayah_number": 39,
    "global_ayah_id": 5876,
    "translation": "प्रफुल्लीत, प्रसन्न आणि आनंदित व हर्षभरीत असतील,"
  },
  {
    "surah_id": 80,
    "ayah_number": 40,
    "global_ayah_id": 5877,
    "translation": "आणि काही चेहर्‍यांवर त्या दिवशी धूळ उडत असेल"
  },
  {
    "surah_id": 80,
    "ayah_number": 41,
    "global_ayah_id": 5878,
    "translation": "आणि काळिमा पसरलेला असेल."
  },
  {
    "surah_id": 80,
    "ayah_number": 42,
    "global_ayah_id": 5879,
    "translation": "हेच अश्रद्धावंत व दुराचारी लोक असतील."
  }
]