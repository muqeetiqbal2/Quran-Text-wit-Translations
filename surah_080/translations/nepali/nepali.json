[
  {
    "surah_id": 80,
    "ayah_number": 0,
    "global_ayah_id": 5837,
    "translation": "शुरु अत्यन्त करुणामय, परम दयालु अल्लाहको नामबाट ।"
  },
  {
    "surah_id": 80,
    "ayah_number": 1,
    "global_ayah_id": 5838,
    "translation": "अन"
  },
  {
    "surah_id": 80,
    "ayah_number": 2,
    "global_ayah_id": 5839,
    "translation": "उनीनजिक अन्धो ब्यक्ति आयो भनेर ।"
  },
  {
    "surah_id": 80,
    "ayah_number": 3,
    "global_ayah_id": 5840,
    "translation": "(हे मुहम्मद स.!) तिमीलाई के थाहा ऊ सुध्रन्थ्यो कि !"
  },
  {
    "surah_id": 80,
    "ayah_number": 4,
    "global_ayah_id": 5841,
    "translation": "अथवा उपदेश ग्रहण गर्थ्यो र त्तस उपदेशले उसलाई लाभान्वित पार्थ्यो होला ।"
  },
  {
    "surah_id": 80,
    "ayah_number": 5,
    "global_ayah_id": 5842,
    "translation": "तर जसले वास्ता नै गर्दैन"
  },
  {
    "surah_id": 80,
    "ayah_number": 6,
    "global_ayah_id": 5843,
    "translation": "त्यसतर्फ तिमी पूरा ध्यान दिन्छौ ।"
  },
  {
    "surah_id": 80,
    "ayah_number": 7,
    "global_ayah_id": 5844,
    "translation": "जबकि यदि ऊ नसुध्रिएन भने तिमीमाथि कुनै उत्तरदायित्व छैन ।"
  },
  {
    "surah_id": 80,
    "ayah_number": 8,
    "global_ayah_id": 5845,
    "translation": "र, जो व्यक्ति तिमीकहाँ दगुर्दै आयो"
  },
  {
    "surah_id": 80,
    "ayah_number": 9,
    "global_ayah_id": 5846,
    "translation": "र ईशभय पनि राख्दछ"
  },
  {
    "surah_id": 80,
    "ayah_number": 10,
    "global_ayah_id": 5847,
    "translation": "त्यसलाई तिमीले उपेक्षा गर्यौ ।"
  },
  {
    "surah_id": 80,
    "ayah_number": 11,
    "global_ayah_id": 5848,
    "translation": "कदापि होइन । (यो कुरआन) उपदेश हो ।"
  },
  {
    "surah_id": 80,
    "ayah_number": 12,
    "global_ayah_id": 5849,
    "translation": "इच्छा हुनेले यसलाई ग्रहण गरोस् ।"
  },
  {
    "surah_id": 80,
    "ayah_number": 13,
    "global_ayah_id": 5850,
    "translation": "प्रतिष्ठित पानाहरूमा (अङ्कित छ)"
  },
  {
    "surah_id": 80,
    "ayah_number": 14,
    "global_ayah_id": 5851,
    "translation": "उच्चकोटिका र अति पवित्र (पानाहरूमा)"
  },
  {
    "surah_id": 80,
    "ayah_number": 15,
    "global_ayah_id": 5852,
    "translation": "जुन यस्ता लिपिकारहरूको हातमा रहेको छ"
  },
  {
    "surah_id": 80,
    "ayah_number": 16,
    "global_ayah_id": 5853,
    "translation": "जो आदरणीय तथा कर्तव्यनिष्ठ रहेको छ ।"
  },
  {
    "surah_id": 80,
    "ayah_number": 17,
    "global_ayah_id": 5854,
    "translation": "सत्यानाश छ मानवको ! कति कृतघ्न रहेछ !"
  },
  {
    "surah_id": 80,
    "ayah_number": 18,
    "global_ayah_id": 5855,
    "translation": "उसलाई उन (अल्लाह) ले कुन तत्वबाट सृष्टि गरे ?"
  },
  {
    "surah_id": 80,
    "ayah_number": 19,
    "global_ayah_id": 5856,
    "translation": "वीर्यबाट उसको सृष्टि गरे अनि (सृष्टिको) चरण निर्धारण गरे ।"
  },
  {
    "surah_id": 80,
    "ayah_number": 20,
    "global_ayah_id": 5857,
    "translation": "र, उसकोलागि मार्ग सरल पारिदिए ।"
  },
  {
    "surah_id": 80,
    "ayah_number": 21,
    "global_ayah_id": 5858,
    "translation": "अनि उसलाई मृत्यु दिए र चिहानसम्म पुर्याए ।"
  },
  {
    "surah_id": 80,
    "ayah_number": 22,
    "global_ayah_id": 5859,
    "translation": "फेरि जहिले चाहन्छन् पूनः जीवित पार्नेछन् ।"
  },
  {
    "surah_id": 80,
    "ayah_number": 23,
    "global_ayah_id": 5860,
    "translation": "किमार्थ होइन  अल्लाहले दिएको आदेशलाई उसले अहिलेसम्म पूरा गरेन ।"
  },
  {
    "surah_id": 80,
    "ayah_number": 24,
    "global_ayah_id": 5861,
    "translation": "मानिसले आफ्नो खाद्य पदार्थतर्फ हेरोस् ।"
  },
  {
    "surah_id": 80,
    "ayah_number": 25,
    "global_ayah_id": 5862,
    "translation": "(उसले बुझिहाल्छ) कि हामीले नै प्रशस्त पानी बर्सायौं ।"
  },
  {
    "surah_id": 80,
    "ayah_number": 26,
    "global_ayah_id": 5863,
    "translation": "अनि भूमिलाई राम्ररी चिर्यौं ।"
  },
  {
    "surah_id": 80,
    "ayah_number": 27,
    "global_ayah_id": 5864,
    "translation": "अनि त्यसमा उब्जायौं अन्न–बाली"
  },
  {
    "surah_id": 80,
    "ayah_number": 28,
    "global_ayah_id": 5865,
    "translation": "र अंगुर एवं सागपात"
  },
  {
    "surah_id": 80,
    "ayah_number": 29,
    "global_ayah_id": 5866,
    "translation": "र जैतुन एवं खजूरका बगैंचा"
  },
  {
    "surah_id": 80,
    "ayah_number": 30,
    "global_ayah_id": 5867,
    "translation": "र घना बगैंचाहरू"
  },
  {
    "surah_id": 80,
    "ayah_number": 31,
    "global_ayah_id": 5868,
    "translation": "र फलहरू एवं घाँसपात ।"
  },
  {
    "surah_id": 80,
    "ayah_number": 32,
    "global_ayah_id": 5869,
    "translation": "तिमी र तिम्रा पशुहरूको जीविकाका लागि ।"
  },
  {
    "surah_id": 80,
    "ayah_number": 33,
    "global_ayah_id": 5870,
    "translation": "अन्ततः जुन दिन कर्कश ध्वनि आउनेछ"
  },
  {
    "surah_id": 80,
    "ayah_number": 34,
    "global_ayah_id": 5871,
    "translation": "त्यस दिन मनुष्य भाग्नेछ आफ्ना दाजुभाइबाट"
  },
  {
    "surah_id": 80,
    "ayah_number": 35,
    "global_ayah_id": 5872,
    "translation": "आफ्ना आमाबाबुबाट"
  },
  {
    "surah_id": 80,
    "ayah_number": 36,
    "global_ayah_id": 5873,
    "translation": "तथा आफ्नी पत्नी एवं आफ्ना छोराहरुबाट ।"
  },
  {
    "surah_id": 80,
    "ayah_number": 37,
    "global_ayah_id": 5874,
    "translation": "त्यसदिन उनीहरूमध्ये प्रत्येक आफ्नै चिन्तामा ग्रस्त हुनेछ ।"
  },
  {
    "surah_id": 80,
    "ayah_number": 38,
    "global_ayah_id": 5875,
    "translation": "कतिपय मुहारहरू त्यसदिन उज्जवल हुनेछन्"
  },
  {
    "surah_id": 80,
    "ayah_number": 39,
    "global_ayah_id": 5876,
    "translation": "प्रफुल्ल र फक्रेका ।"
  },
  {
    "surah_id": 80,
    "ayah_number": 40,
    "global_ayah_id": 5877,
    "translation": "र, कतिपय मुहारहरू त्यसदिन धुलोयुक्त हुनेछन् ।"
  },
  {
    "surah_id": 80,
    "ayah_number": 41,
    "global_ayah_id": 5878,
    "translation": "तिनीहरूमाथि अँध्यारो छाएको हुनेछ ।"
  },
  {
    "surah_id": 80,
    "ayah_number": 42,
    "global_ayah_id": 5879,
    "translation": "तिनीहरू नै हुनेछन् काफिर र दुराचारीहरू ।"
  }
]