[
  {
    "surah_id": 80,
    "ayah_number": 1,
    "global_ayah_id": 5759,
    "translation": "Surat astı ve döndü;"
  },
  {
    "surah_id": 80,
    "ayah_number": 2,
    "global_ayah_id": 5760,
    "translation": "Kör geldi diye."
  },
  {
    "surah_id": 80,
    "ayah_number": 3,
    "global_ayah_id": 5761,
    "translation": "Ne bilirsin belki o arınacak?"
  },
  {
    "surah_id": 80,
    "ayah_number": 4,
    "global_ayah_id": 5762,
    "translation": "Yahut öğüt dinleyecek de öğüt, kendisine yarayacak."
  },
  {
    "surah_id": 80,
    "ayah_number": 5,
    "global_ayah_id": 5763,
    "translation": "Kendisini zengin görüp tenezzül etmeyene gelince;"
  },
  {
    "surah_id": 80,
    "ayah_number": 6,
    "global_ayah_id": 5764,
    "translation": "Sen ona yöneliyorsun."
  },
  {
    "surah_id": 80,
    "ayah_number": 7,
    "global_ayah_id": 5765,
    "translation": "Onun arınmamasından sana ne?"
  },
  {
    "surah_id": 80,
    "ayah_number": 8,
    "global_ayah_id": 5766,
    "translation": "Fakat koşarak sana gelen,"
  },
  {
    "surah_id": 80,
    "ayah_number": 9,
    "global_ayah_id": 5767,
    "translation": "Saygılı olarak gelmişken,"
  },
  {
    "surah_id": 80,
    "ayah_number": 10,
    "global_ayah_id": 5768,
    "translation": "Sen onunla ilgilenmiyorsun."
  },
  {
    "surah_id": 80,
    "ayah_number": 11,
    "global_ayah_id": 5769,
    "translation": "Hayır (olmaz böyle şey); o (ayetler), bir hatırlatmadır."
  },
  {
    "surah_id": 80,
    "ayah_number": 12,
    "global_ayah_id": 5770,
    "translation": "Dileyen onu düşünüp öğüt alır."
  },
  {
    "surah_id": 80,
    "ayah_number": 13,
    "global_ayah_id": 5771,
    "translation": "(O öğüt) Sahifeler içindedir: Değer verilen,"
  },
  {
    "surah_id": 80,
    "ayah_number": 14,
    "global_ayah_id": 5772,
    "translation": "Saygı ile yükseltilen, tertemiz (sayfalar)"
  },
  {
    "surah_id": 80,
    "ayah_number": 15,
    "global_ayah_id": 5773,
    "translation": "Yazıcıların ellerinde:"
  },
  {
    "surah_id": 80,
    "ayah_number": 16,
    "global_ayah_id": 5774,
    "translation": "Değerli, iyi (yazıcıların)."
  },
  {
    "surah_id": 80,
    "ayah_number": 17,
    "global_ayah_id": 5775,
    "translation": "Kahrolası insan, ne kadar da nankördür!"
  },
  {
    "surah_id": 80,
    "ayah_number": 18,
    "global_ayah_id": 5776,
    "translation": "(Allah) Onu hangi şeyden yarattı?"
  },
  {
    "surah_id": 80,
    "ayah_number": 19,
    "global_ayah_id": 5777,
    "translation": "Nutfe (sperm)den. Onu yarattı, ona biçim verdi."
  },
  {
    "surah_id": 80,
    "ayah_number": 20,
    "global_ayah_id": 5778,
    "translation": "Sonra ona yolu kolaylaştırdı."
  },
  {
    "surah_id": 80,
    "ayah_number": 21,
    "global_ayah_id": 5779,
    "translation": "Sonra onu öldürdü, kabre koydurdu."
  },
  {
    "surah_id": 80,
    "ayah_number": 22,
    "global_ayah_id": 5780,
    "translation": "Sonra dilediği zaman onu diriltip kaldırdı."
  },
  {
    "surah_id": 80,
    "ayah_number": 23,
    "global_ayah_id": 5781,
    "translation": "Hayır, insan, O'nun kendisine emrettiğini yapmadı."
  },
  {
    "surah_id": 80,
    "ayah_number": 24,
    "global_ayah_id": 5782,
    "translation": "İnsan şu yiyeceğine baksın."
  },
  {
    "surah_id": 80,
    "ayah_number": 25,
    "global_ayah_id": 5783,
    "translation": "Biz suyu iyice döktük."
  },
  {
    "surah_id": 80,
    "ayah_number": 26,
    "global_ayah_id": 5784,
    "translation": "Sonra toprağı güzelce yardık da,"
  },
  {
    "surah_id": 80,
    "ayah_number": 27,
    "global_ayah_id": 5785,
    "translation": "Orada bitirdik: Dane,"
  },
  {
    "surah_id": 80,
    "ayah_number": 28,
    "global_ayah_id": 5786,
    "translation": "Üzüm, yonca,"
  },
  {
    "surah_id": 80,
    "ayah_number": 29,
    "global_ayah_id": 5787,
    "translation": "Zeytin, hurma,"
  },
  {
    "surah_id": 80,
    "ayah_number": 30,
    "global_ayah_id": 5788,
    "translation": "İri ve gür bahçeler,"
  },
  {
    "surah_id": 80,
    "ayah_number": 31,
    "global_ayah_id": 5789,
    "translation": "Meyva ve çayır;"
  },
  {
    "surah_id": 80,
    "ayah_number": 32,
    "global_ayah_id": 5790,
    "translation": "Sizin ve hayvanlarınızın geçimi için."
  },
  {
    "surah_id": 80,
    "ayah_number": 33,
    "global_ayah_id": 5791,
    "translation": "Çarpınca kulakları sağır eden o gürültü geldiği zaman,"
  },
  {
    "surah_id": 80,
    "ayah_number": 34,
    "global_ayah_id": 5792,
    "translation": "İşte o gün kişi kaçar: kardeşinden,"
  },
  {
    "surah_id": 80,
    "ayah_number": 35,
    "global_ayah_id": 5793,
    "translation": "Anasından, babasından,"
  },
  {
    "surah_id": 80,
    "ayah_number": 36,
    "global_ayah_id": 5794,
    "translation": "Eşinden ve oğullarından."
  },
  {
    "surah_id": 80,
    "ayah_number": 37,
    "global_ayah_id": 5795,
    "translation": "O gün, onlardan her kişinin, kendisine yeter derecede işi vardır."
  },
  {
    "surah_id": 80,
    "ayah_number": 38,
    "global_ayah_id": 5796,
    "translation": "Yüzler var ki o gün parıl parıl,"
  },
  {
    "surah_id": 80,
    "ayah_number": 39,
    "global_ayah_id": 5797,
    "translation": "Güleç, sevinçli."
  },
  {
    "surah_id": 80,
    "ayah_number": 40,
    "global_ayah_id": 5798,
    "translation": "Yüzler de var ki o gün tozlanmış."
  },
  {
    "surah_id": 80,
    "ayah_number": 41,
    "global_ayah_id": 5799,
    "translation": "Onları karanlık bürümüş (öylesine üzgün, öylesine dertli)."
  },
  {
    "surah_id": 80,
    "ayah_number": 42,
    "global_ayah_id": 5800,
    "translation": "İşte onlar kafirler, Hak'tan sapanlardır."
  }
]