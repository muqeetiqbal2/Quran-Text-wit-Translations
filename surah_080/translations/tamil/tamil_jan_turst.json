[
  {
    "surah_id": 80,
    "ayah_number": 1,
    "global_ayah_id": 5759,
    "translation": "அவர் கடுகடுத்தார், மேலும் (முகத்தைத்) திருப்பிக் கொண்டார்."
  },
  {
    "surah_id": 80,
    "ayah_number": 2,
    "global_ayah_id": 5760,
    "translation": "அவரிடம் அந்த அந்தகர் வந்தபோது,"
  },
  {
    "surah_id": 80,
    "ayah_number": 3,
    "global_ayah_id": 5761,
    "translation": "(நபியே! உம்மிடம் வந்த அவர்) அவர் தூய்மையாகி விடக்கூடும் என்பதை நீர் அறிவீரா?"
  },
  {
    "surah_id": 80,
    "ayah_number": 4,
    "global_ayah_id": 5762,
    "translation": "அல்லது அவர் (உம் உபதேசத்தை) நினைவு படுத்திக்கொள்வதன் மூலம், (உம்முடைய) உபதேசம் அவருக்குப் பலனளித்திருக்கலாம்."
  },
  {
    "surah_id": 80,
    "ayah_number": 5,
    "global_ayah_id": 5763,
    "translation": "(உம் உபதேசத்தின்) தேவையை எவன் அலட்சியம் செய்கிறானோ-"
  },
  {
    "surah_id": 80,
    "ayah_number": 6,
    "global_ayah_id": 5764,
    "translation": "நீர் அவன்பாலே முன்னோக்குகின்றீர்."
  },
  {
    "surah_id": 80,
    "ayah_number": 7,
    "global_ayah_id": 5765,
    "translation": "ஆயினும் (இஸ்லாத்தை யேற்று) அவன் தூய்மையடையாமல் போனால், உம் மீது (அதனால் குற்றம்) இல்லை."
  },
  {
    "surah_id": 80,
    "ayah_number": 8,
    "global_ayah_id": 5766,
    "translation": "ஆனால், எவர் உம்மிடம் விரைந்து வந்தாரோ,"
  },
  {
    "surah_id": 80,
    "ayah_number": 9,
    "global_ayah_id": 5767,
    "translation": "அல்லாஹ்வுக்கு அஞ்சியவராக-"
  },
  {
    "surah_id": 80,
    "ayah_number": 10,
    "global_ayah_id": 5768,
    "translation": "அவரை விட்டும் பராமுகமாய் இருக்கின்றீர்."
  },
  {
    "surah_id": 80,
    "ayah_number": 11,
    "global_ayah_id": 5769,
    "translation": "அவ்வாறல்ல! ஏனெனில் (இத்திருக் குர்ஆன் நினைவூட்டும்) நல்லுபதேசமாகும்."
  },
  {
    "surah_id": 80,
    "ayah_number": 12,
    "global_ayah_id": 5770,
    "translation": "எனவே, எவர் விரும்புகிறாரோ அவர் அதை நினைவு கொள்வார்."
  },
  {
    "surah_id": 80,
    "ayah_number": 13,
    "global_ayah_id": 5771,
    "translation": "(அது) சங்கையாக்கப்பட்ட ஏடுகளில் இருக்கிறது."
  },
  {
    "surah_id": 80,
    "ayah_number": 14,
    "global_ayah_id": 5772,
    "translation": "உயர்வாக்கப்பட்டது, பரிசுத்தமாக்கப்பட்டது."
  },
  {
    "surah_id": 80,
    "ayah_number": 15,
    "global_ayah_id": 5773,
    "translation": "(வானவர்களான) எழுதுபவர்களின் கைகளால்-"
  },
  {
    "surah_id": 80,
    "ayah_number": 16,
    "global_ayah_id": 5774,
    "translation": "(லவ்ஹுல் மஹ்ஃபூளிலிருந்து எழுதிய அவ்வானவர்கள்) சங்கை மிக்கவர்கள்; நல்லோர்கள்."
  },
  {
    "surah_id": 80,
    "ayah_number": 17,
    "global_ayah_id": 5775,
    "translation": "(நன்றி கெட்ட மனிதன்) அழிவானாக! எவ்வளவு நன்றி மறந்தவனாக அவன் இருக்கின்றான்!"
  },
  {
    "surah_id": 80,
    "ayah_number": 18,
    "global_ayah_id": 5776,
    "translation": "எப்பொருளால் அவனை (அல்லாஹ்) படைத்தான்? (என்பதை அவன் சிந்தித்தானா?)"
  },
  {
    "surah_id": 80,
    "ayah_number": 19,
    "global_ayah_id": 5777,
    "translation": "(ஒரு துளி) இந்திரியத்திலிருந்து அவனைப் படைத்து, அவனை (அளவுப்படி) சரியாக்கினான்."
  },
  {
    "surah_id": 80,
    "ayah_number": 20,
    "global_ayah_id": 5778,
    "translation": "பின் அவனுக்காக வழியை எளிதாக்கினான்."
  },
  {
    "surah_id": 80,
    "ayah_number": 21,
    "global_ayah_id": 5779,
    "translation": "பின் அவனை மரிக்கச் செய்து, அவனை கப்ரில்' ஆக்குகிறான்."
  },
  {
    "surah_id": 80,
    "ayah_number": 22,
    "global_ayah_id": 5780,
    "translation": "பின்னர், அவன் விரும்பும்போது அவனை (உயிர்ப்பித்து) எழுப்புவான்."
  },
  {
    "surah_id": 80,
    "ayah_number": 23,
    "global_ayah_id": 5781,
    "translation": "(இவ்வாறிருந்தும் அல்லாஹ் மனிதனுக்கு) எதை ஏவினானோ அதை அவன் நிறைவேற்றுவதில்லை."
  },
  {
    "surah_id": 80,
    "ayah_number": 24,
    "global_ayah_id": 5782,
    "translation": "எனவே, மனிதன் தன் உணவின் பக்கமே (அது எவ்வாறு பெறப்படுகிறது) என்பதை நோட்டமிட்டுப் பார்க்கட்டும்."
  },
  {
    "surah_id": 80,
    "ayah_number": 25,
    "global_ayah_id": 5783,
    "translation": "நிச்சயமாக நாமே மழையை நன்கு பொழியச் செய்கிறோம்."
  },
  {
    "surah_id": 80,
    "ayah_number": 26,
    "global_ayah_id": 5784,
    "translation": "பின், பூமியைப் பிளப்பதாகப் பிளந்து-"
  },
  {
    "surah_id": 80,
    "ayah_number": 27,
    "global_ayah_id": 5785,
    "translation": "பின் அதிலிருந்து வித்தை முளைப்பிக்கிறோம்."
  },
  {
    "surah_id": 80,
    "ayah_number": 28,
    "global_ayah_id": 5786,
    "translation": "திராட்சைகளையும், புற்பூண்டுகளையும்-"
  },
  {
    "surah_id": 80,
    "ayah_number": 29,
    "global_ayah_id": 5787,
    "translation": "ஒலிவ மரத்தையும், பேரீச்சையையும் -"
  },
  {
    "surah_id": 80,
    "ayah_number": 30,
    "global_ayah_id": 5788,
    "translation": "அடர்ந்த தோட்டங்களையும்,"
  },
  {
    "surah_id": 80,
    "ayah_number": 31,
    "global_ayah_id": 5789,
    "translation": "பழங்களையும், தீவனங்களையும்-"
  },
  {
    "surah_id": 80,
    "ayah_number": 32,
    "global_ayah_id": 5790,
    "translation": "(இவையெல்லாம்) உங்களுக்கும், உங்கள் கால் நடைகளுக்கும் பயனளிப்பதற்காக,"
  },
  {
    "surah_id": 80,
    "ayah_number": 33,
    "global_ayah_id": 5791,
    "translation": "ஆகவே, (யுக முடிவின் போது காதைச் செவிடாக்கும் பெருஞ் சப்தம் வரும் போது -"
  },
  {
    "surah_id": 80,
    "ayah_number": 34,
    "global_ayah_id": 5792,
    "translation": "அந்த நாளில் மனிதன் விரண்டு ஓடுவான் - தன் சகோதரனை விட்டும் -"
  },
  {
    "surah_id": 80,
    "ayah_number": 35,
    "global_ayah_id": 5793,
    "translation": "தன் தாயை விட்டும், தன் தந்தையை விட்டும்;"
  },
  {
    "surah_id": 80,
    "ayah_number": 36,
    "global_ayah_id": 5794,
    "translation": "தன் மனைவியை விட்டும், தன் மக்களை விட்டும்-"
  },
  {
    "surah_id": 80,
    "ayah_number": 37,
    "global_ayah_id": 5795,
    "translation": "அன்று ஒவ்வொரு மனிதனுக்கும் அவனவன் (அவல) நிலையே போதுமானதாயிருக்கும்."
  },
  {
    "surah_id": 80,
    "ayah_number": 38,
    "global_ayah_id": 5796,
    "translation": "அந்நாளில் சில முகங்கள் இலங்கிக் கொண்டிருக்கும்."
  },
  {
    "surah_id": 80,
    "ayah_number": 39,
    "global_ayah_id": 5797,
    "translation": "சிரித்தவையாகவும், மகிழ்வுடையதாகவும் இருக்கும்."
  },
  {
    "surah_id": 80,
    "ayah_number": 40,
    "global_ayah_id": 5798,
    "translation": "ஆனால் அந்நாளில் - (வேறு) சில முகங்கள், அவற்றின் மீது புழுதி படிந்திருக்கும்."
  },
  {
    "surah_id": 80,
    "ayah_number": 41,
    "global_ayah_id": 5799,
    "translation": "அவற்றைக் கருமை இருள் மூடியிருக்கும்."
  },
  {
    "surah_id": 80,
    "ayah_number": 42,
    "global_ayah_id": 5800,
    "translation": "அவர்கள்தாம், நிராகரித்தவர்கள,; தீயவர்கள்."
  }
]