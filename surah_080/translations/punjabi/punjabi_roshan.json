[
  {
    "surah_id": 80,
    "ayah_number": 0,
    "global_ayah_id": 5837,
    "translation": "اللہ دے ناں نال ( شروع ) جیہڑا حدوں مہربان ، بوہت رحم والا اے ۔"
  },
  {
    "surah_id": 80,
    "ayah_number": 1,
    "global_ayah_id": 5838,
    "translation": "اوہنے متھے وٹ پایا تے منہ موڑ لیا"
  },
  {
    "surah_id": 80,
    "ayah_number": 2,
    "global_ayah_id": 5839,
    "translation": "( تاں ) پئی اوہدے کول اک انّھا آیا"
  },
  {
    "surah_id": 80,
    "ayah_number": 3,
    "global_ayah_id": 5840,
    "translation": "تے ( اے نبی ! ) تہانوں کیہہ معلوم شاید اوہ پاکی لے لیندا"
  },
  {
    "surah_id": 80,
    "ayah_number": 4,
    "global_ayah_id": 5841,
    "translation": "یا نصیحت لیندا فیر نصیحت اوہنوں فیدہ دیندی"
  },
  {
    "surah_id": 80,
    "ayah_number": 5,
    "global_ayah_id": 5842,
    "translation": "سگوں جیہڑا بے پروائی ورتدا"
  },
  {
    "surah_id": 80,
    "ayah_number": 6,
    "global_ayah_id": 5843,
    "translation": "سو تسی اوہدا کھیڑا کردے او"
  },
  {
    "surah_id": 80,
    "ayah_number": 7,
    "global_ayah_id": 5844,
    "translation": "حالاں جے اوہ پاک نئیں ہوندا تہاڈے تے ( کوئی بھار ) نئیں"
  },
  {
    "surah_id": 80,
    "ayah_number": 8,
    "global_ayah_id": 5845,
    "translation": "تے رہیا جیہڑا تہاڈے کول چیچا آیا"
  },
  {
    "surah_id": 80,
    "ayah_number": 9,
    "global_ayah_id": 5846,
    "translation": "تے اوہ ڈردا وی اے"
  },
  {
    "surah_id": 80,
    "ayah_number": 10,
    "global_ayah_id": 5847,
    "translation": "فیر توں اوہدے نال لاپرواہی ورتداں ایں"
  },
  {
    "surah_id": 80,
    "ayah_number": 11,
    "global_ayah_id": 5848,
    "translation": "ہرگز نئیں ! بیشک ایہہ ( قرآن ) تے اک نصیحت اے"
  },
  {
    "surah_id": 80,
    "ayah_number": 12,
    "global_ayah_id": 5849,
    "translation": "سو جیہڑا چاہوے ایہنوں قبول کرے"
  },
  {
    "surah_id": 80,
    "ayah_number": 13,
    "global_ayah_id": 5850,
    "translation": "عزت دے لائق صحیفیاں وچ ( سانبھیا ) اے"
  },
  {
    "surah_id": 80,
    "ayah_number": 14,
    "global_ayah_id": 5851,
    "translation": "جیہڑے اچے کیتے گئے تے پاک نیں"
  },
  {
    "surah_id": 80,
    "ayah_number": 15,
    "global_ayah_id": 5852,
    "translation": "اجہے لکھن والیاں دے ہتھاں وچ نیں"
  },
  {
    "surah_id": 80,
    "ayah_number": 16,
    "global_ayah_id": 5853,
    "translation": "جیہڑے عزتاں والے تے نیک نیں"
  },
  {
    "surah_id": 80,
    "ayah_number": 17,
    "global_ayah_id": 5854,
    "translation": "غارت جائے انسان ، ( ایہہ ) کِناں ناشکرا اے !"
  },
  {
    "surah_id": 80,
    "ayah_number": 18,
    "global_ayah_id": 5855,
    "translation": "اوس اوہنوں کیس شے چوں پیدا کیتا ؟"
  },
  {
    "surah_id": 80,
    "ayah_number": 19,
    "global_ayah_id": 5856,
    "translation": "اک نطفے چوں اوہنے اوہنوں پیدا کیتا فیر اوہدا اندازہ لائیا"
  },
  {
    "surah_id": 80,
    "ayah_number": 20,
    "global_ayah_id": 5857,
    "translation": "مڑ کے اوہنوں راہ سوکھی کر دتی"
  },
  {
    "surah_id": 80,
    "ayah_number": 21,
    "global_ayah_id": 5858,
    "translation": "مڑ کے اوہنوں موت دتی فیر قبر چ پایا"
  },
  {
    "surah_id": 80,
    "ayah_number": 22,
    "global_ayah_id": 5859,
    "translation": "مڑ کے اوہ جدوں چاہوے گا اوہنوں ٹھا لے گا"
  },
  {
    "surah_id": 80,
    "ayah_number": 23,
    "global_ayah_id": 5860,
    "translation": "ہرگز نئیں اوہنے اوہدے حکم نوں اجے پورا نئیں کیتا"
  },
  {
    "surah_id": 80,
    "ayah_number": 24,
    "global_ayah_id": 5861,
    "translation": "انسان نوں لازم اے پئی اپنے کھاج ول ویکھے"
  },
  {
    "surah_id": 80,
    "ayah_number": 25,
    "global_ayah_id": 5862,
    "translation": "واقعی اساں زور دار مینہ ورھایا"
  },
  {
    "surah_id": 80,
    "ayah_number": 26,
    "global_ayah_id": 5863,
    "translation": "مڑ کے اسیں زمین نوں جدا جدا پاڑیا"
  },
  {
    "surah_id": 80,
    "ayah_number": 27,
    "global_ayah_id": 5864,
    "translation": "فیر اسیں اوہدے وچوں دانے اگائے"
  },
  {
    "surah_id": 80,
    "ayah_number": 28,
    "global_ayah_id": 5865,
    "translation": "تے انگور تے ویلاں"
  },
  {
    "surah_id": 80,
    "ayah_number": 29,
    "global_ayah_id": 5866,
    "translation": "تے زیتون تے کھجوراں"
  },
  {
    "surah_id": 80,
    "ayah_number": 30,
    "global_ayah_id": 5867,
    "translation": "تے سنگھنے باغ"
  },
  {
    "surah_id": 80,
    "ayah_number": 31,
    "global_ayah_id": 5868,
    "translation": "تے میوے تے چوگا"
  },
  {
    "surah_id": 80,
    "ayah_number": 32,
    "global_ayah_id": 5869,
    "translation": "تہاڈے تے تہاڈے پسواں دے فیدے لئی ( اے )"
  },
  {
    "surah_id": 80,
    "ayah_number": 33,
    "global_ayah_id": 5870,
    "translation": "فیر جدوں کن ڈورے کر دین والی ( دوجی پھوک ) آ پجے گی"
  },
  {
    "surah_id": 80,
    "ayah_number": 34,
    "global_ayah_id": 5871,
    "translation": "اوس دیہاڑے بندہ اپنے بھرا توں نسے گا"
  },
  {
    "surah_id": 80,
    "ayah_number": 35,
    "global_ayah_id": 5872,
    "translation": "تے اپنی ماں تے اپنے پیؤ توں"
  },
  {
    "surah_id": 80,
    "ayah_number": 36,
    "global_ayah_id": 5873,
    "translation": "تے اپنی بیوی تے اپنے پتراں کولوں"
  },
  {
    "surah_id": 80,
    "ayah_number": 37,
    "global_ayah_id": 5874,
    "translation": "اوہناں وچوں ہر بندے دی اوس دیہاڑے اینج دی حالت ہووے گی جیہڑی ( دوجیاں توں ) بے پرواہ کر دیوے گی"
  },
  {
    "surah_id": 80,
    "ayah_number": 38,
    "global_ayah_id": 5875,
    "translation": "اوس دیہاڑے کئی چہرے روشن ہون گے"
  },
  {
    "surah_id": 80,
    "ayah_number": 39,
    "global_ayah_id": 5876,
    "translation": "ہسدے بوہت خوشیاں کردے"
  },
  {
    "surah_id": 80,
    "ayah_number": 40,
    "global_ayah_id": 5877,
    "translation": "تے کئیاں بوتھیاں تے اوس دیہاڑے کھیہہ اڈدی ہووے گی"
  },
  {
    "surah_id": 80,
    "ayah_number": 41,
    "global_ayah_id": 5878,
    "translation": "اوہناں تے کالک چڑھی ہووے گی"
  },
  {
    "surah_id": 80,
    "ayah_number": 42,
    "global_ayah_id": 5879,
    "translation": "اوہی لوک سب کافر نافرمان نیں"
  }
]