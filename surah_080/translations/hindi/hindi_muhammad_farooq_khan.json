[
  {
    "surah_id": 80,
    "ayah_number": 1,
    "global_ayah_id": 5759,
    "translation": "उसने त्योरी चढ़ाई और मुँह फेर लिया,"
  },
  {
    "surah_id": 80,
    "ayah_number": 2,
    "global_ayah_id": 5760,
    "translation": "इस कारण कि उसके पास अन्धा आ गया।"
  },
  {
    "surah_id": 80,
    "ayah_number": 3,
    "global_ayah_id": 5761,
    "translation": "और तुझे क्या मालूम शायद वह स्वयं को सँवारता-निखारता हो"
  },
  {
    "surah_id": 80,
    "ayah_number": 4,
    "global_ayah_id": 5762,
    "translation": "या नसीहत हासिल करता हो तो नसीहत उसके लिए लाभदायक हो?"
  },
  {
    "surah_id": 80,
    "ayah_number": 5,
    "global_ayah_id": 5763,
    "translation": "रहा वह व्यक्ति जो धनी हो गया ह"
  },
  {
    "surah_id": 80,
    "ayah_number": 6,
    "global_ayah_id": 5764,
    "translation": "तू उसके पीछे पड़ा है -"
  },
  {
    "surah_id": 80,
    "ayah_number": 7,
    "global_ayah_id": 5765,
    "translation": "हालाँकि वह अपने को न निखारे तो तुझपर कोई ज़िम्मेदारी नहीं आती -"
  },
  {
    "surah_id": 80,
    "ayah_number": 8,
    "global_ayah_id": 5766,
    "translation": "और रहा वह व्यक्ति जो स्वयं ही तेरे पास दौड़ता हुआ आया,"
  },
  {
    "surah_id": 80,
    "ayah_number": 9,
    "global_ayah_id": 5767,
    "translation": "और वह डरता भी है,"
  },
  {
    "surah_id": 80,
    "ayah_number": 10,
    "global_ayah_id": 5768,
    "translation": "तो तू उससे बेपरवाई करता है"
  },
  {
    "surah_id": 80,
    "ayah_number": 11,
    "global_ayah_id": 5769,
    "translation": "कदापि नहीं, वे (आयतें) तो महत्वपूर्ण नसीहत है -"
  },
  {
    "surah_id": 80,
    "ayah_number": 12,
    "global_ayah_id": 5770,
    "translation": "तो जो चाहे उसे याद कर ले -"
  },
  {
    "surah_id": 80,
    "ayah_number": 13,
    "global_ayah_id": 5771,
    "translation": "पवित्र पन्नों में अंकित है,"
  },
  {
    "surah_id": 80,
    "ayah_number": 14,
    "global_ayah_id": 5772,
    "translation": "प्रतिष्ठि्त, उच्च,"
  },
  {
    "surah_id": 80,
    "ayah_number": 15,
    "global_ayah_id": 5773,
    "translation": "ऐसे कातिबों के हाथों में रहा करते है"
  },
  {
    "surah_id": 80,
    "ayah_number": 16,
    "global_ayah_id": 5774,
    "translation": "जो प्रतिष्ठित और नेक है"
  },
  {
    "surah_id": 80,
    "ayah_number": 17,
    "global_ayah_id": 5775,
    "translation": "विनष्ट हुआ मनुष्य! कैसा अकृतज्ञ है!"
  },
  {
    "surah_id": 80,
    "ayah_number": 18,
    "global_ayah_id": 5776,
    "translation": "उसको किस चीज़ से पैदा किया?"
  },
  {
    "surah_id": 80,
    "ayah_number": 19,
    "global_ayah_id": 5777,
    "translation": "तनिक-सी बूँद से उसको पैदा किया, तो उसके लिए एक अंदाजा ठहराया,"
  },
  {
    "surah_id": 80,
    "ayah_number": 20,
    "global_ayah_id": 5778,
    "translation": "फिर मार्ग को देखो, उसे सुगम कर दिया,"
  },
  {
    "surah_id": 80,
    "ayah_number": 21,
    "global_ayah_id": 5779,
    "translation": "फिर उसे मृत्यु दी और क्रब में उसे रखवाया,"
  },
  {
    "surah_id": 80,
    "ayah_number": 22,
    "global_ayah_id": 5780,
    "translation": "फिर जब चाहेगा उसे (जीवित करके) उठा खड़ा करेगा। -"
  },
  {
    "surah_id": 80,
    "ayah_number": 23,
    "global_ayah_id": 5781,
    "translation": "कदापि नहीं, उसने उसको पूरा नहीं किया जिसका आदेश अल्लाह ने उसे दिया है"
  },
  {
    "surah_id": 80,
    "ayah_number": 24,
    "global_ayah_id": 5782,
    "translation": "अतः मनुष्य को चाहिए कि अपने भोजन को देखे,"
  },
  {
    "surah_id": 80,
    "ayah_number": 25,
    "global_ayah_id": 5783,
    "translation": "कि हमने ख़ूब पानी बरसाया,"
  },
  {
    "surah_id": 80,
    "ayah_number": 26,
    "global_ayah_id": 5784,
    "translation": "फिर धरती को विशेष रूप से फाड़ा,"
  },
  {
    "surah_id": 80,
    "ayah_number": 27,
    "global_ayah_id": 5785,
    "translation": "फिर हमने उसमें उगाए अनाज,"
  },
  {
    "surah_id": 80,
    "ayah_number": 28,
    "global_ayah_id": 5786,
    "translation": "और अंगूर और तरकारी,"
  },
  {
    "surah_id": 80,
    "ayah_number": 29,
    "global_ayah_id": 5787,
    "translation": "और ज़ैतून और खजूर,"
  },
  {
    "surah_id": 80,
    "ayah_number": 30,
    "global_ayah_id": 5788,
    "translation": "और घने बाग़,"
  },
  {
    "surah_id": 80,
    "ayah_number": 31,
    "global_ayah_id": 5789,
    "translation": "और मेवे और घास-चारा,"
  },
  {
    "surah_id": 80,
    "ayah_number": 32,
    "global_ayah_id": 5790,
    "translation": "तुम्हारे लिए और तुम्हारे चौपायों के लिेए जीवन-सामग्री के रूप में"
  },
  {
    "surah_id": 80,
    "ayah_number": 33,
    "global_ayah_id": 5791,
    "translation": "फिर जब वह बहरा कर देनेवाली प्रचंड आवाज़ आएगी,"
  },
  {
    "surah_id": 80,
    "ayah_number": 34,
    "global_ayah_id": 5792,
    "translation": "जिस दिन आदमी भागेगा अपने भाई से,"
  },
  {
    "surah_id": 80,
    "ayah_number": 35,
    "global_ayah_id": 5793,
    "translation": "और अपनी माँ और अपने बाप से,"
  },
  {
    "surah_id": 80,
    "ayah_number": 36,
    "global_ayah_id": 5794,
    "translation": "और अपनी पत्नी और अपने बेटों से"
  },
  {
    "surah_id": 80,
    "ayah_number": 37,
    "global_ayah_id": 5795,
    "translation": "उनमें से प्रत्येक व्यक्ति को उस दिन ऐसी पड़ी होगी जो उसे दूसरों से बेपरवाह कर देगी"
  },
  {
    "surah_id": 80,
    "ayah_number": 38,
    "global_ayah_id": 5796,
    "translation": "कितने ही चेहरे उस दिन रौशन होंगे,"
  },
  {
    "surah_id": 80,
    "ayah_number": 39,
    "global_ayah_id": 5797,
    "translation": "हँसते, प्रफुल्लित"
  },
  {
    "surah_id": 80,
    "ayah_number": 40,
    "global_ayah_id": 5798,
    "translation": "और कितने ही चेहरे होंगे जिनपर उस दिन धूल पड़ी होगी,"
  },
  {
    "surah_id": 80,
    "ayah_number": 41,
    "global_ayah_id": 5799,
    "translation": "उनपर कलौंस छा रही होगी"
  },
  {
    "surah_id": 80,
    "ayah_number": 42,
    "global_ayah_id": 5800,
    "translation": "वहीं होंगे इनकार करनेवाले दुराचारी लोग!"
  }
]