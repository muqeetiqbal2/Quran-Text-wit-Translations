[
  {
    "surah_id": 80,
    "ayah_number": 1,
    "global_ayah_id": 5759,
    "translation": "वह अपनी बात पर चीं ब जबीं हो गया"
  },
  {
    "surah_id": 80,
    "ayah_number": 2,
    "global_ayah_id": 5760,
    "translation": "और मुँह फेर बैठा कि उसके पास नाबीना आ गया"
  },
  {
    "surah_id": 80,
    "ayah_number": 3,
    "global_ayah_id": 5761,
    "translation": "और तुमको क्या मालूम यायद वह (तालीम से) पाकीज़गी हासिल करता"
  },
  {
    "surah_id": 80,
    "ayah_number": 4,
    "global_ayah_id": 5762,
    "translation": "या वह नसीहत सुनता तो नसीहत उसके काम आती"
  },
  {
    "surah_id": 80,
    "ayah_number": 5,
    "global_ayah_id": 5763,
    "translation": "तो जो कुछ परवाह नहीं करता"
  },
  {
    "surah_id": 80,
    "ayah_number": 6,
    "global_ayah_id": 5764,
    "translation": "उसके तो तुम दरपै हो जाते हो हालॉकि अगर वह न सुधरे"
  },
  {
    "surah_id": 80,
    "ayah_number": 7,
    "global_ayah_id": 5765,
    "translation": "तो तुम ज़िम्मेदार नहीं"
  },
  {
    "surah_id": 80,
    "ayah_number": 8,
    "global_ayah_id": 5766,
    "translation": "और जो तुम्हारे पास लपकता हुआ आता है"
  },
  {
    "surah_id": 80,
    "ayah_number": 9,
    "global_ayah_id": 5767,
    "translation": "और (ख़ुदा से) डरता है"
  },
  {
    "surah_id": 80,
    "ayah_number": 10,
    "global_ayah_id": 5768,
    "translation": "तो तुम उससे बेरूख़ी करते हो"
  },
  {
    "surah_id": 80,
    "ayah_number": 11,
    "global_ayah_id": 5769,
    "translation": "देखो ये (क़ुरान) तो सरासर नसीहत है"
  },
  {
    "surah_id": 80,
    "ayah_number": 12,
    "global_ayah_id": 5770,
    "translation": "तो जो चाहे इसे याद रखे"
  },
  {
    "surah_id": 80,
    "ayah_number": 13,
    "global_ayah_id": 5771,
    "translation": "(लौहे महफूज़ के) बहुत मोअज़ज़िज औराक़ में (लिखा हुआ) है"
  },
  {
    "surah_id": 80,
    "ayah_number": 14,
    "global_ayah_id": 5772,
    "translation": "बुलन्द मरतबा और पाक हैं"
  },
  {
    "surah_id": 80,
    "ayah_number": 15,
    "global_ayah_id": 5773,
    "translation": "(ऐसे) लिखने वालों के हाथों में है"
  },
  {
    "surah_id": 80,
    "ayah_number": 16,
    "global_ayah_id": 5774,
    "translation": "जो बुज़ुर्ग नेकोकार हैं"
  },
  {
    "surah_id": 80,
    "ayah_number": 17,
    "global_ayah_id": 5775,
    "translation": "इन्सान हलाक हो जाए वह क्या कैसा नाशुक्रा है"
  },
  {
    "surah_id": 80,
    "ayah_number": 18,
    "global_ayah_id": 5776,
    "translation": "(ख़ुदा ने) उसे किस चीज़ से पैदा किया"
  },
  {
    "surah_id": 80,
    "ayah_number": 19,
    "global_ayah_id": 5777,
    "translation": "नुत्फे से उसे पैदा किया फिर उसका अन्दाज़ा मुक़र्रर किया"
  },
  {
    "surah_id": 80,
    "ayah_number": 20,
    "global_ayah_id": 5778,
    "translation": "फिर उसका रास्ता आसान कर दिया"
  },
  {
    "surah_id": 80,
    "ayah_number": 21,
    "global_ayah_id": 5779,
    "translation": "फिर उसे मौत दी फिर उसे कब्र में दफ़न कराया"
  },
  {
    "surah_id": 80,
    "ayah_number": 22,
    "global_ayah_id": 5780,
    "translation": "फिर जब चाहेगा उठा खड़ा करेगा"
  },
  {
    "surah_id": 80,
    "ayah_number": 23,
    "global_ayah_id": 5781,
    "translation": "सच तो यह है कि ख़ुदा ने जो हुक्म उसे दिया उसने उसको पूरा न किया"
  },
  {
    "surah_id": 80,
    "ayah_number": 24,
    "global_ayah_id": 5782,
    "translation": "तो इन्सान को अपने घाटे ही तरफ ग़ौर करना चाहिए"
  },
  {
    "surah_id": 80,
    "ayah_number": 25,
    "global_ayah_id": 5783,
    "translation": "कि हम ही ने (बादल) से पानी बरसाया"
  },
  {
    "surah_id": 80,
    "ayah_number": 26,
    "global_ayah_id": 5784,
    "translation": "फिर हम ही ने ज़मीन (दरख्त उगाकर) चीरी फाड़ी"
  },
  {
    "surah_id": 80,
    "ayah_number": 27,
    "global_ayah_id": 5785,
    "translation": "फिर हमने उसमें अनाज उगाया"
  },
  {
    "surah_id": 80,
    "ayah_number": 28,
    "global_ayah_id": 5786,
    "translation": "और अंगूर और तरकारियाँ"
  },
  {
    "surah_id": 80,
    "ayah_number": 29,
    "global_ayah_id": 5787,
    "translation": "और ज़ैतून और खजूरें"
  },
  {
    "surah_id": 80,
    "ayah_number": 30,
    "global_ayah_id": 5788,
    "translation": "और घने घने बाग़ और मेवे"
  },
  {
    "surah_id": 80,
    "ayah_number": 31,
    "global_ayah_id": 5789,
    "translation": "और चारा (ये सब कुछ) तुम्हारे और तुम्हारे"
  },
  {
    "surah_id": 80,
    "ayah_number": 32,
    "global_ayah_id": 5790,
    "translation": "चारपायों के फायदे के लिए (बनाया)"
  },
  {
    "surah_id": 80,
    "ayah_number": 33,
    "global_ayah_id": 5791,
    "translation": "तो जब कानों के परदे फाड़ने वाली (क़यामत) आ मौजूद होगी"
  },
  {
    "surah_id": 80,
    "ayah_number": 34,
    "global_ayah_id": 5792,
    "translation": "उस दिन आदमी अपने भाई"
  },
  {
    "surah_id": 80,
    "ayah_number": 35,
    "global_ayah_id": 5793,
    "translation": "और अपनी माँ और अपने बाप"
  },
  {
    "surah_id": 80,
    "ayah_number": 36,
    "global_ayah_id": 5794,
    "translation": "और अपने लड़के बालों से भागेगा"
  },
  {
    "surah_id": 80,
    "ayah_number": 37,
    "global_ayah_id": 5795,
    "translation": "उस दिन हर शख़्श (अपनी नजात की) ऐसी फ़िक्र में होगा जो उसके (मशग़ूल होने के) लिए काफ़ी हों"
  },
  {
    "surah_id": 80,
    "ayah_number": 38,
    "global_ayah_id": 5796,
    "translation": "बहुत से चेहरे तो उस दिन चमकते होंगे"
  },
  {
    "surah_id": 80,
    "ayah_number": 39,
    "global_ayah_id": 5797,
    "translation": "ख़न्दाँ शांदाँ (यही नेको कार हैं)"
  },
  {
    "surah_id": 80,
    "ayah_number": 40,
    "global_ayah_id": 5798,
    "translation": "और बहुत से चेहरे ऐसे होंगे जिन पर गर्द पड़ी होगी"
  },
  {
    "surah_id": 80,
    "ayah_number": 41,
    "global_ayah_id": 5799,
    "translation": "उस पर सियाही छाई हुई होगी"
  },
  {
    "surah_id": 80,
    "ayah_number": 42,
    "global_ayah_id": 5800,
    "translation": "यही कुफ्फ़ार बदकार हैं"
  }
]