[
  {
    "surah_id": 80,
    "ayah_number": 0,
    "global_ayah_id": 5837,
    "translation": "अल्लाह के नाम से जो बड़ा कृपालु और अत्यन्त दयावान है।"
  },
  {
    "surah_id": 80,
    "ayah_number": 1,
    "global_ayah_id": 5838,
    "translation": "उस ने त्योरी चढ़ाई और मुँह फेर लिया,"
  },
  {
    "surah_id": 80,
    "ayah_number": 2,
    "global_ayah_id": 5839,
    "translation": "इस कारण कि उस के पास अन्धा आ गया।"
  },
  {
    "surah_id": 80,
    "ayah_number": 3,
    "global_ayah_id": 5840,
    "translation": "और तुझे क्या मालूम शायद वह स्वयं को सँवारता-निखारता हो"
  },
  {
    "surah_id": 80,
    "ayah_number": 4,
    "global_ayah_id": 5841,
    "translation": "या नसीहत हासिल करता हो तो नसीहत उस के लिए लाभदायक हो?"
  },
  {
    "surah_id": 80,
    "ayah_number": 5,
    "global_ayah_id": 5842,
    "translation": "रहा वह व्यक्ति जो धनी हो गया है"
  },
  {
    "surah_id": 80,
    "ayah_number": 6,
    "global_ayah_id": 5843,
    "translation": "तू उस के पीछे पड़ा है -"
  },
  {
    "surah_id": 80,
    "ayah_number": 7,
    "global_ayah_id": 5844,
    "translation": "हालाँकि वह अपने को न निखारे तो तुझ पर कोई ज़िम्मेदारी नहीं आती -"
  },
  {
    "surah_id": 80,
    "ayah_number": 8,
    "global_ayah_id": 5845,
    "translation": "और रहा वह व्यक्ति जो स्वयं ही तेरे पास दौड़ता हुआ आया,"
  },
  {
    "surah_id": 80,
    "ayah_number": 9,
    "global_ayah_id": 5846,
    "translation": "और वह डरता भी है,"
  },
  {
    "surah_id": 80,
    "ayah_number": 10,
    "global_ayah_id": 5847,
    "translation": "तो तू उस से बेपरवाई करता है"
  },
  {
    "surah_id": 80,
    "ayah_number": 11,
    "global_ayah_id": 5848,
    "translation": "कदापि नहीं, वे (आयतें) तो महत्वपूर्ण नसीहत हैं -"
  },
  {
    "surah_id": 80,
    "ayah_number": 12,
    "global_ayah_id": 5849,
    "translation": "तो जो चाहे उसे याद कर ले -"
  },
  {
    "surah_id": 80,
    "ayah_number": 13,
    "global_ayah_id": 5850,
    "translation": "पवित्र पन्नों में अंकित हैं,"
  },
  {
    "surah_id": 80,
    "ayah_number": 14,
    "global_ayah_id": 5851,
    "translation": "प्रतिष्ठि्त, उच्च,"
  },
  {
    "surah_id": 80,
    "ayah_number": 15,
    "global_ayah_id": 5852,
    "translation": "ऐसे कातिबों के हाथों में रहा करते हैं"
  },
  {
    "surah_id": 80,
    "ayah_number": 16,
    "global_ayah_id": 5853,
    "translation": "जो प्रतिष्ठित और नेक हैं"
  },
  {
    "surah_id": 80,
    "ayah_number": 17,
    "global_ayah_id": 5854,
    "translation": "विनष्ट हुआ मनुष्य! कैसा अकृतज्ञ है!"
  },
  {
    "surah_id": 80,
    "ayah_number": 18,
    "global_ayah_id": 5855,
    "translation": "उसको किस चीज़ से पैदा किया?"
  },
  {
    "surah_id": 80,
    "ayah_number": 19,
    "global_ayah_id": 5856,
    "translation": "तनिक-सी बूँद से उसको पैदा किया, तो उस के लिए एक अंदाजा ठहराया,"
  },
  {
    "surah_id": 80,
    "ayah_number": 20,
    "global_ayah_id": 5857,
    "translation": "फिर मार्ग को देखो, उसे सुगम कर दिया,"
  },
  {
    "surah_id": 80,
    "ayah_number": 21,
    "global_ayah_id": 5858,
    "translation": "फिर उसे मृत्यु दी और क्रब में उसे रखवाया,"
  },
  {
    "surah_id": 80,
    "ayah_number": 22,
    "global_ayah_id": 5859,
    "translation": "फिर जब चाहेगा उसे (जीवित करके) उठा खड़ा करेगा। -"
  },
  {
    "surah_id": 80,
    "ayah_number": 23,
    "global_ayah_id": 5860,
    "translation": "कदापि नहीं, उस ने उसको पूरा नहीं किया जिस का आदेश अल्लाह ने उसे दिया है"
  },
  {
    "surah_id": 80,
    "ayah_number": 24,
    "global_ayah_id": 5861,
    "translation": "अतः मनुष्य को चाहिए कि अपने भोजन को देखे,"
  },
  {
    "surah_id": 80,
    "ayah_number": 25,
    "global_ayah_id": 5862,
    "translation": "कि हम ने ख़ूब पानी बरसाया,"
  },
  {
    "surah_id": 80,
    "ayah_number": 26,
    "global_ayah_id": 5863,
    "translation": "फिर धरती को विशेष रूप से फाड़ा,"
  },
  {
    "surah_id": 80,
    "ayah_number": 27,
    "global_ayah_id": 5864,
    "translation": "फिर हम ने उस में उगाए अनाज,"
  },
  {
    "surah_id": 80,
    "ayah_number": 28,
    "global_ayah_id": 5865,
    "translation": "और अंगूर और तरकारी,"
  },
  {
    "surah_id": 80,
    "ayah_number": 29,
    "global_ayah_id": 5866,
    "translation": "और ज़ैतून और खजूर,"
  },
  {
    "surah_id": 80,
    "ayah_number": 30,
    "global_ayah_id": 5867,
    "translation": "और घने बाग़,"
  },
  {
    "surah_id": 80,
    "ayah_number": 31,
    "global_ayah_id": 5868,
    "translation": "और मेवे और घास-चारा,"
  },
  {
    "surah_id": 80,
    "ayah_number": 32,
    "global_ayah_id": 5869,
    "translation": "तुम्हारे लिए और तुम्हारे चौपायों के लिेए जीवन-सामग्री के रूप में"
  },
  {
    "surah_id": 80,
    "ayah_number": 33,
    "global_ayah_id": 5870,
    "translation": "फिर जब वह बहरा कर देने वाली प्रचंड आवाज़ आएगी,"
  },
  {
    "surah_id": 80,
    "ayah_number": 34,
    "global_ayah_id": 5871,
    "translation": "जिस दिन आदमी भागेगा अपने भाई से,"
  },
  {
    "surah_id": 80,
    "ayah_number": 35,
    "global_ayah_id": 5872,
    "translation": "और अपनी माँ और अपने बाप से,"
  },
  {
    "surah_id": 80,
    "ayah_number": 36,
    "global_ayah_id": 5873,
    "translation": "और अपनी पत्नी और अपने बेटों से"
  },
  {
    "surah_id": 80,
    "ayah_number": 37,
    "global_ayah_id": 5874,
    "translation": "उन में से प्रत्येक व्यक्ति को उस दिन ऐसी पड़ी होगी जो उसे दूसरों से बेपरवाह कर देगी"
  },
  {
    "surah_id": 80,
    "ayah_number": 38,
    "global_ayah_id": 5875,
    "translation": "कितने ही चेहरे उस दिन रौशन होंगे,"
  },
  {
    "surah_id": 80,
    "ayah_number": 39,
    "global_ayah_id": 5876,
    "translation": "हँसते, प्रफुल्लित"
  },
  {
    "surah_id": 80,
    "ayah_number": 40,
    "global_ayah_id": 5877,
    "translation": "और कितने ही चेहरे होंगे जिन पर उस दिन धूल पड़ी होगी,"
  },
  {
    "surah_id": 80,
    "ayah_number": 41,
    "global_ayah_id": 5878,
    "translation": "उन पर कलौंस छा रही होगी"
  },
  {
    "surah_id": 80,
    "ayah_number": 42,
    "global_ayah_id": 5879,
    "translation": "वहीं होंगे इनकार करने वाले दुराचारी लोग!"
  }
]