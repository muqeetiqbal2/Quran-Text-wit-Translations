[
  {
    "surah_id": 80,
    "ayah_number": 1,
    "global_ayah_id": 5759,
    "translation": "Ai (Muhammedi) u mrrol e u kthye (me fytyrë)"
  },
  {
    "surah_id": 80,
    "ayah_number": 2,
    "global_ayah_id": 5760,
    "translation": "ngase i erdhi pranë i verbëri."
  },
  {
    "surah_id": 80,
    "ayah_number": 3,
    "global_ayah_id": 5761,
    "translation": "E kush të dëfton ty – ndoshta ai dëshiron të pastrohet (nga mëkatet),"
  },
  {
    "surah_id": 80,
    "ayah_number": 4,
    "global_ayah_id": 5762,
    "translation": "ose të këshillohet, e t’i sjell dobi atij këshillimi,"
  },
  {
    "surah_id": 80,
    "ayah_number": 5,
    "global_ayah_id": 5763,
    "translation": "e atij që ësthë i pasur (e prezentohet si i panevojshëm për të besuar)"
  },
  {
    "surah_id": 80,
    "ayah_number": 6,
    "global_ayah_id": 5764,
    "translation": "atij po i kthehesh"
  },
  {
    "surah_id": 80,
    "ayah_number": 7,
    "global_ayah_id": 5765,
    "translation": "sepse, ti nuk ke përgjegjësi, nëse ai nuk don të pastrohet (të besojë);"
  },
  {
    "surah_id": 80,
    "ayah_number": 8,
    "global_ayah_id": 5766,
    "translation": "e atij që të vjen ty duke nxituar (për këshillim)"
  },
  {
    "surah_id": 80,
    "ayah_number": 9,
    "global_ayah_id": 5767,
    "translation": "dhe ndien drojë"
  },
  {
    "surah_id": 80,
    "ayah_number": 10,
    "global_ayah_id": 5768,
    "translation": "e ti atë nuk po e merr në konsiderim."
  },
  {
    "surah_id": 80,
    "ayah_number": 11,
    "global_ayah_id": 5769,
    "translation": "Mos vepro ashtu! Ato janë këshilla,"
  },
  {
    "surah_id": 80,
    "ayah_number": 12,
    "global_ayah_id": 5770,
    "translation": "e, kush të dojë, le të mësojë"
  },
  {
    "surah_id": 80,
    "ayah_number": 13,
    "global_ayah_id": 5771,
    "translation": "në faqet e (Kur’anit të) çmueshme"
  },
  {
    "surah_id": 80,
    "ayah_number": 14,
    "global_ayah_id": 5772,
    "translation": "të lartësuara (të madhërueshme), të pastra,"
  },
  {
    "surah_id": 80,
    "ayah_number": 15,
    "global_ayah_id": 5773,
    "translation": "me duart e shkruesve (engjëjve)"
  },
  {
    "surah_id": 80,
    "ayah_number": 16,
    "global_ayah_id": 5774,
    "translation": "të ndershëm dhe të drejtë."
  },
  {
    "surah_id": 80,
    "ayah_number": 17,
    "global_ayah_id": 5775,
    "translation": "Mallkuar qoftë njeriu! Sa jomirënjohës që është ai!"
  },
  {
    "surah_id": 80,
    "ayah_number": 18,
    "global_ayah_id": 5776,
    "translation": "Prej çkahjes e krijoi Ai (Perëndia) atë (njeriun)?!"
  },
  {
    "surah_id": 80,
    "ayah_number": 19,
    "global_ayah_id": 5777,
    "translation": "Prej pikës së farës e krijoi dhe përgatiti për të çdo gjë të dobishme,"
  },
  {
    "surah_id": 80,
    "ayah_number": 20,
    "global_ayah_id": 5778,
    "translation": "dhe pastaj ia lehtësoi rrugën (e lindjes),"
  },
  {
    "surah_id": 80,
    "ayah_number": 21,
    "global_ayah_id": 5779,
    "translation": "pas kësaj, (Ai) ia caktoi vdekjen dhe bëri që të varroset,"
  },
  {
    "surah_id": 80,
    "ayah_number": 22,
    "global_ayah_id": 5780,
    "translation": "dhe, mandej kur të dojë Ai, e ringjallë."
  },
  {
    "surah_id": 80,
    "ayah_number": 23,
    "global_ayah_id": 5781,
    "translation": "Në të vërtetë! Ai – njeriu, ende nuk i ka plotësuar ato që i ka urdhëruar Ai!"
  },
  {
    "surah_id": 80,
    "ayah_number": 24,
    "global_ayah_id": 5782,
    "translation": "Le të shikojë njeriu në ushqimin e vet:"
  },
  {
    "surah_id": 80,
    "ayah_number": 25,
    "global_ayah_id": 5783,
    "translation": "Ne kemi derdhur ujëra (shira) të bollshme,"
  },
  {
    "surah_id": 80,
    "ayah_number": 26,
    "global_ayah_id": 5784,
    "translation": "pastaj e kemi plasaritur tokën me çarje"
  },
  {
    "surah_id": 80,
    "ayah_number": 27,
    "global_ayah_id": 5785,
    "translation": "dhe bëjmë që nga ajo të rriten drithërat,"
  },
  {
    "surah_id": 80,
    "ayah_number": 28,
    "global_ayah_id": 5786,
    "translation": "dhe rrushi e perimet,"
  },
  {
    "surah_id": 80,
    "ayah_number": 29,
    "global_ayah_id": 5787,
    "translation": "dhe ulliri e palma,"
  },
  {
    "surah_id": 80,
    "ayah_number": 30,
    "global_ayah_id": 5788,
    "translation": "dhe kopshtet e dendura,"
  },
  {
    "surah_id": 80,
    "ayah_number": 31,
    "global_ayah_id": 5789,
    "translation": "dhe pëmët e barishtet,"
  },
  {
    "surah_id": 80,
    "ayah_number": 32,
    "global_ayah_id": 5790,
    "translation": "për ju dhe bagëtinë tuaj."
  },
  {
    "surah_id": 80,
    "ayah_number": 33,
    "global_ayah_id": 5791,
    "translation": "E, kur të arrijë zëri i madh shurdhues, -"
  },
  {
    "surah_id": 80,
    "ayah_number": 34,
    "global_ayah_id": 5792,
    "translation": "në Ditën kur njeriu ikën nga vëllau i tij"
  },
  {
    "surah_id": 80,
    "ayah_number": 35,
    "global_ayah_id": 5793,
    "translation": "dhe nga nëna e babai i tij"
  },
  {
    "surah_id": 80,
    "ayah_number": 36,
    "global_ayah_id": 5794,
    "translation": "dhe nga bashkëshortja e fëmijët e tij;"
  },
  {
    "surah_id": 80,
    "ayah_number": 37,
    "global_ayah_id": 5795,
    "translation": "atë Ditë, çdonjëri është i preokupuar me gjendjen e vetvetes,"
  },
  {
    "surah_id": 80,
    "ayah_number": 38,
    "global_ayah_id": 5796,
    "translation": "disa fytyra atë Ditë, shëndrisin,"
  },
  {
    "surah_id": 80,
    "ayah_number": 39,
    "global_ayah_id": 5797,
    "translation": "të qeshura, të gëzuara,"
  },
  {
    "surah_id": 80,
    "ayah_number": 40,
    "global_ayah_id": 5798,
    "translation": "kurse disa fytyra, atë Ditë, pluhërosen,"
  },
  {
    "surah_id": 80,
    "ayah_number": 41,
    "global_ayah_id": 5799,
    "translation": "errësira do t’i kaplojë,"
  },
  {
    "surah_id": 80,
    "ayah_number": 42,
    "global_ayah_id": 5800,
    "translation": "këta janë jobesimtarët, të korruptuarit."
  }
]