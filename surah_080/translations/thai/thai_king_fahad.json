[
  {
    "surah_id": 80,
    "ayah_number": 1,
    "global_ayah_id": 5759,
    "translation": "เขา (มุฮัมมัด) ทำหน้าบึ้ง และผินหน้าไปทางอื่น"
  },
  {
    "surah_id": 80,
    "ayah_number": 2,
    "global_ayah_id": 5760,
    "translation": "เพราะชายตาบอดมาหาเขา"
  },
  {
    "surah_id": 80,
    "ayah_number": 3,
    "global_ayah_id": 5761,
    "translation": "และอะไรเล่าที่จะให้เจ้ารู้ หวังว่าเขาจะมาเพื่อซักฟอกจิตใจก็ได้"
  },
  {
    "surah_id": 80,
    "ayah_number": 4,
    "global_ayah_id": 5762,
    "translation": "หรือเพื่อรับคำตักเตือน เพื่อที่คำตักเตือนนั้นจะเป็นประโยชน์แก่เขา"
  },
  {
    "surah_id": 80,
    "ayah_number": 5,
    "global_ayah_id": 5763,
    "translation": "ส่วนผู้ที่พอเพียงแล้ว"
  },
  {
    "surah_id": 80,
    "ayah_number": 6,
    "global_ayah_id": 5764,
    "translation": "เจ้ากลับต้อนรับขับสู้"
  },
  {
    "surah_id": 80,
    "ayah_number": 7,
    "global_ayah_id": 5765,
    "translation": "และไม่ใช่หน้าที่ของเจ้า การที่เขาไม่ซักฟอก"
  },
  {
    "surah_id": 80,
    "ayah_number": 8,
    "global_ayah_id": 5766,
    "translation": "และส่วนผู้ที่มาหาเจ้าด้วยความพยายาม"
  },
  {
    "surah_id": 80,
    "ayah_number": 9,
    "global_ayah_id": 5767,
    "translation": "และเขามีความกลัวเกรง"
  },
  {
    "surah_id": 80,
    "ayah_number": 10,
    "global_ayah_id": 5768,
    "translation": "เจ้ากลับเมินเฉย"
  },
  {
    "surah_id": 80,
    "ayah_number": 11,
    "global_ayah_id": 5769,
    "translation": "มิใช่เช่นนั้น แท้จริงมันเป็นข้อเตือนใจ"
  },
  {
    "surah_id": 80,
    "ayah_number": 12,
    "global_ayah_id": 5770,
    "translation": "ดังนั้นผู้ใดประสงค์ก็ให้รำลึกถึงข้อเตือนใจนั้น"
  },
  {
    "surah_id": 80,
    "ayah_number": 13,
    "global_ayah_id": 5771,
    "translation": "ซึ่งมีอยู่ในคัมภีร์อันทรงเกียรติ"
  },
  {
    "surah_id": 80,
    "ayah_number": 14,
    "global_ayah_id": 5772,
    "translation": "ที่ได้รับการเทิดทูน ได้รับความบริสุทธิ์"
  },
  {
    "surah_id": 80,
    "ayah_number": 15,
    "global_ayah_id": 5773,
    "translation": "ด้วยมือของมลาอิกะฮฺ"
  },
  {
    "surah_id": 80,
    "ayah_number": 16,
    "global_ayah_id": 5774,
    "translation": "ผู้ทรงเกียรติ ทรงคุณธรรม"
  },
  {
    "surah_id": 80,
    "ayah_number": 17,
    "global_ayah_id": 5775,
    "translation": "มนุษย์นั้นถูกสังหารเสียก็ดี เขาช่างเนรคุณเสียนี่กระไร"
  },
  {
    "surah_id": 80,
    "ayah_number": 18,
    "global_ayah_id": 5776,
    "translation": "จากสิ่งใดเล่าพระองค์ทรงบังเกิดเขามา ?"
  },
  {
    "surah_id": 80,
    "ayah_number": 19,
    "global_ayah_id": 5777,
    "translation": "จากเชื้ออสุจิหยดหนึ่งพระองค์ทรงบังเกิดเขา แล้วก็กำหนดสภาวะแก่เขา"
  },
  {
    "surah_id": 80,
    "ayah_number": 20,
    "global_ayah_id": 5778,
    "translation": "แล้วพระองค์ก็ทรงแผ้วทางให้สะดวกแก่เขา"
  },
  {
    "surah_id": 80,
    "ayah_number": 21,
    "global_ayah_id": 5779,
    "translation": "ต่อมาพระองค์ให้เขาตายไป แล้วให้เขาลงหลุม"
  },
  {
    "surah_id": 80,
    "ayah_number": 22,
    "global_ayah_id": 5780,
    "translation": "ครั้นเมื่อพระองค์ทรงประสงค์ ก็ทรงให้เขาฟื้นคืนชีพ"
  },
  {
    "surah_id": 80,
    "ayah_number": 23,
    "global_ayah_id": 5781,
    "translation": "มิใช่เช่นนั้น เขามิได้ปฏิบัติในสิ่งที่พระองค์ทรงใช้เขา"
  },
  {
    "surah_id": 80,
    "ayah_number": 24,
    "global_ayah_id": 5782,
    "translation": "มนุษย์จงพิจารณาดูอาหารของเขาซิ"
  },
  {
    "surah_id": 80,
    "ayah_number": 25,
    "global_ayah_id": 5783,
    "translation": "เราได้หลั่งน้ำฝนลงมามากมายอย่างไร"
  },
  {
    "surah_id": 80,
    "ayah_number": 26,
    "global_ayah_id": 5784,
    "translation": "แล้วเราได้แยกแผ่นดินออกไป"
  },
  {
    "surah_id": 80,
    "ayah_number": 27,
    "global_ayah_id": 5785,
    "translation": "และเราได้ให้เมล็ดพืชงอกเงยขึ้นจากในแผ่นดิน"
  },
  {
    "surah_id": 80,
    "ayah_number": 28,
    "global_ayah_id": 5786,
    "translation": "และองุ่นและพืชผัก"
  },
  {
    "surah_id": 80,
    "ayah_number": 29,
    "global_ayah_id": 5787,
    "translation": "และมะกอกและอินทผลัม"
  },
  {
    "surah_id": 80,
    "ayah_number": 30,
    "global_ayah_id": 5788,
    "translation": "และเรือกสวนที่หนาทึบ"
  },
  {
    "surah_id": 80,
    "ayah_number": 31,
    "global_ayah_id": 5789,
    "translation": "และผลไม้และทุ่งหญ้า"
  },
  {
    "surah_id": 80,
    "ayah_number": 32,
    "global_ayah_id": 5790,
    "translation": "ทั้งนี้เพื่อเป็นประโยชน์แก่พวกเจ้าและสัตว์เลี้ยงของพวกเจ้า"
  },
  {
    "surah_id": 80,
    "ayah_number": 33,
    "global_ayah_id": 5791,
    "translation": "ครั้นเมื่อเสียงกัมปนาทมาถึง"
  },
  {
    "surah_id": 80,
    "ayah_number": 34,
    "global_ayah_id": 5792,
    "translation": "วันที่ผู้คนจะหนีจากพี่น้องของเขา"
  },
  {
    "surah_id": 80,
    "ayah_number": 35,
    "global_ayah_id": 5793,
    "translation": "และจากแม่ของเขา และพ่อของเขา"
  },
  {
    "surah_id": 80,
    "ayah_number": 36,
    "global_ayah_id": 5794,
    "translation": "และจากภริยาของเขา และลูก ๆ ของเขา"
  },
  {
    "surah_id": 80,
    "ayah_number": 37,
    "global_ayah_id": 5795,
    "translation": "สำหรับแต่ละคนในหมู่พวกเขาในวันนั้น มีภาระพอตัวเขาอยู่แล้ว"
  },
  {
    "surah_id": 80,
    "ayah_number": 38,
    "global_ayah_id": 5796,
    "translation": "หลายใบหน้าในวันนั้นแจ่มใส"
  },
  {
    "surah_id": 80,
    "ayah_number": 39,
    "global_ayah_id": 5797,
    "translation": "หัวเราะดีใจร่าเริง"
  },
  {
    "surah_id": 80,
    "ayah_number": 40,
    "global_ayah_id": 5798,
    "translation": "และหลายใบหน้าในวันนั้นมีฝุ่นจับ"
  },
  {
    "surah_id": 80,
    "ayah_number": 41,
    "global_ayah_id": 5799,
    "translation": "ความหม่นหมองจะปกคลุมบนใบหน้านั้น"
  },
  {
    "surah_id": 80,
    "ayah_number": 42,
    "global_ayah_id": 5800,
    "translation": "ชนเหล่านั้นคือพวกปฏิเสธศรัทธาพวกประพฤติชั่ว"
  }
]