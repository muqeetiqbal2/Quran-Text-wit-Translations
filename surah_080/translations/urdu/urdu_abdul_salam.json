[
  {
    "surah_id": 80,
    "ayah_number": 0,
    "global_ayah_id": 5837,
    "translation": "اللہ کے «<a href=614> نام </a>» سے جو بےحد رحم والا، نہایت «<a href=600> مہربان </a>» ہے۔ [1]"
  },
  {
    "surah_id": 80,
    "ayah_number": 1,
    "global_ayah_id": 5838,
    "translation": "اس نے «<a href=216> تیوری </a>» چڑھائی اور «<a href=597> منہ </a>» پھیر لیا۔ [1]"
  },
  {
    "surah_id": 80,
    "ayah_number": 2,
    "global_ayah_id": 5839,
    "translation": "اس لیے کہ اس کے «<a href=141> پاس </a>» «<a href=58> اندھا </a>» آیا۔ [2]"
  },
  {
    "surah_id": 80,
    "ayah_number": 3,
    "global_ayah_id": 5840,
    "translation": "اور تجھے کیا چیز معلوم کرواتی ہے شاید وہ «<a href=196> پاکیزگی </a>» حاصل کر لے۔ [3]"
  },
  {
    "surah_id": 80,
    "ayah_number": 4,
    "global_ayah_id": 5841,
    "translation": "یا «<a href=622> نصیحت </a>» حاصل کرے تو وہ «<a href=622> نصیحت </a>» اسے «<a href=452> فائدہ </a>» دے۔ [4]"
  },
  {
    "surah_id": 80,
    "ayah_number": 5,
    "global_ayah_id": 5842,
    "translation": "لیکن جو بے پروا ہو گیا۔ [5]"
  },
  {
    "surah_id": 80,
    "ayah_number": 6,
    "global_ayah_id": 5843,
    "translation": "سو تو اس کے «<a href=179> پیچھے </a>» پڑتا ہے۔ [6]"
  },
  {
    "surah_id": 80,
    "ayah_number": 7,
    "global_ayah_id": 5844,
    "translation": "حالانکہ تجھ پر(کوئی ذمہ داری) نہیں کہ وہ «<a href=142> پاک </a>» نہیں ہوتا۔ [7]"
  },
  {
    "surah_id": 80,
    "ayah_number": 8,
    "global_ayah_id": 5845,
    "translation": "اور لیکن جو «<a href=501> کوشش </a>» کرتا «<a href=654> ہوا </a>» تیرے «<a href=141> پاس </a>» آیا ۔ [8]"
  },
  {
    "surah_id": 80,
    "ayah_number": 9,
    "global_ayah_id": 5846,
    "translation": "اور وہ ڈر رہا ہے۔ [9]"
  },
  {
    "surah_id": 80,
    "ayah_number": 10,
    "global_ayah_id": 5847,
    "translation": "تو تو اس سے بے توجہی کرتا ہے۔ [10]"
  },
  {
    "surah_id": 80,
    "ayah_number": 11,
    "global_ayah_id": 5848,
    "translation": "ایسا ہرگز نہیں چاہیے، یہ (قرآن) تو ایک «<a href=622> نصیحت </a>» ہے۔ [11]"
  },
  {
    "surah_id": 80,
    "ayah_number": 12,
    "global_ayah_id": 5849,
    "translation": "تو جو چاہے اسے «<a href=465> قبول </a>» کر لے۔ [12]"
  },
  {
    "surah_id": 80,
    "ayah_number": 13,
    "global_ayah_id": 5850,
    "translation": "ایسے صحیفوں میں ہے «<a href=236> جن </a>» کی «<a href=441> عزت </a>» کی جاتی ہے ۔ [13]"
  },
  {
    "surah_id": 80,
    "ayah_number": 14,
    "global_ayah_id": 5851,
    "translation": "جو «<a href=106> بلند </a>» کیے ہوئے،پاک کیے ہوئے ہیں۔ [14]"
  },
  {
    "surah_id": 80,
    "ayah_number": 15,
    "global_ayah_id": 5852,
    "translation": "ایسے «<a href=555> لکھنے </a>» والوں کے ہاتھوں میں ہیں۔ [15]"
  },
  {
    "surah_id": 80,
    "ayah_number": 16,
    "global_ayah_id": 5853,
    "translation": "جو معزز ہیں، «<a href=634> نیک </a>» ہیں۔ [16]"
  },
  {
    "surah_id": 80,
    "ayah_number": 17,
    "global_ayah_id": 5854,
    "translation": "مارا جائے انسان! وہ کس قدر «<a href=611> ناشکرا </a>» ہے۔ [17]"
  },
  {
    "surah_id": 80,
    "ayah_number": 18,
    "global_ayah_id": 5855,
    "translation": "اس نے اسے کس چیز سے «<a href=180> پیدا </a>» کیا۔ [18]"
  },
  {
    "surah_id": 80,
    "ayah_number": 19,
    "global_ayah_id": 5856,
    "translation": "ایک قطرے سے، اس نے اسے «<a href=180> پیدا </a>» کیا، پس اس کا «<a href=56> اندازہ </a>» «<a href=593> مقرر </a>» کیا ۔\n[19]"
  },
  {
    "surah_id": 80,
    "ayah_number": 20,
    "global_ayah_id": 5857,
    "translation": "پھر اس کے لیے «<a href=357> راستہ </a>» «<a href=9> آسان </a>» کر دیا۔ [20]"
  },
  {
    "surah_id": 80,
    "ayah_number": 21,
    "global_ayah_id": 5858,
    "translation": "پھر اسے موت دی، پھر اسے «<a href=464> قبر </a>» میں رکھوایا۔ [21]"
  },
  {
    "surah_id": 80,
    "ayah_number": 22,
    "global_ayah_id": 5859,
    "translation": "پھر جب وہ چاہے گا اسے اٹھا ئے گا۔ [22]"
  },
  {
    "surah_id": 80,
    "ayah_number": 23,
    "global_ayah_id": 5860,
    "translation": "ہرگز نہیں، ابھی تک اس نے وہ «<a href=481> کام </a>» پورا نہیں کیا جس کا اس نے اسے «<a href=288> حکم </a>» دیا۔\n[23]"
  },
  {
    "surah_id": 80,
    "ayah_number": 24,
    "global_ayah_id": 5861,
    "translation": "تو «<a href=3> انسان </a>» کو لازم ہے کہ اپنے کھانے کی طرف دیکھے۔ [24]"
  },
  {
    "surah_id": 80,
    "ayah_number": 25,
    "global_ayah_id": 5862,
    "translation": "کہ ہم نے «<a href=144> پانی </a>» برسایا، خوب برسانا۔ [25]"
  },
  {
    "surah_id": 80,
    "ayah_number": 26,
    "global_ayah_id": 5863,
    "translation": "پھرہم نے «<a href=379> زمین </a>» کو پھاڑا، ایک عجیب طریقے سے پھاڑنا۔ [26]"
  },
  {
    "surah_id": 80,
    "ayah_number": 27,
    "global_ayah_id": 5864,
    "translation": "پھر ہم نے اس میں اناج اگایا۔ [27]"
  },
  {
    "surah_id": 80,
    "ayah_number": 28,
    "global_ayah_id": 5865,
    "translation": "اور انگور اور ترکاری۔ [28]"
  },
  {
    "surah_id": 80,
    "ayah_number": 29,
    "global_ayah_id": 5866,
    "translation": "اور زیتون اور «<a href=510> کھجور </a>» کے درخت۔ [29]"
  },
  {
    "surah_id": 80,
    "ayah_number": 30,
    "global_ayah_id": 5867,
    "translation": "اور گھنے باغات۔ [30]"
  },
  {
    "surah_id": 80,
    "ayah_number": 31,
    "global_ayah_id": 5868,
    "translation": "اور «<a href=170> پھل </a>» اور چارا۔ [31]"
  },
  {
    "surah_id": 80,
    "ayah_number": 32,
    "global_ayah_id": 5869,
    "translation": "تمھارے لیے اور تمھارے مویشیوں کے لیے زندگی کا سامان۔ [32]"
  },
  {
    "surah_id": 80,
    "ayah_number": 33,
    "global_ayah_id": 5870,
    "translation": "پس جب کانوں کو بہرا کرنے والی ( قیامت) آجائے گی۔ [33]"
  },
  {
    "surah_id": 80,
    "ayah_number": 34,
    "global_ayah_id": 5871,
    "translation": "جس «<a href=326> دن </a>» آدمی اپنے «<a href=120> بھائی </a>» سے بھاگے گا۔ [34]"
  },
  {
    "surah_id": 80,
    "ayah_number": 35,
    "global_ayah_id": 5872,
    "translation": "اور اپنی «<a href=565> ماں </a>» اور اپنے «<a href=69> باپ </a>» (سے). [35]"
  },
  {
    "surah_id": 80,
    "ayah_number": 36,
    "global_ayah_id": 5873,
    "translation": "اور اپنی «<a href=130> بیوی </a>» اور اپنے بیٹوں سے۔ [36]"
  },
  {
    "surah_id": 80,
    "ayah_number": 37,
    "global_ayah_id": 5874,
    "translation": "اس «<a href=326> دن </a>» ان میں سے ہر شخص کی ایک ایسی «<a href=280> حالت </a>» ہوگی جو اسے ( دوسروں سے) بے پروا بنا دے\nگی۔ [37]"
  },
  {
    "surah_id": 80,
    "ayah_number": 38,
    "global_ayah_id": 5875,
    "translation": "کچھ چہرے اس «<a href=326> دن </a>» روشن ہوں گے۔ [38]"
  },
  {
    "surah_id": 80,
    "ayah_number": 39,
    "global_ayah_id": 5876,
    "translation": "ہنستے ہوئے، بہت خوش۔ [39]"
  },
  {
    "surah_id": 80,
    "ayah_number": 40,
    "global_ayah_id": 5877,
    "translation": "اور کچھ چہرے، اس «<a href=326> دن </a>» ان پر ایک «<a href=448> غبار </a>» ہوگا۔ [40]"
  },
  {
    "surah_id": 80,
    "ayah_number": 41,
    "global_ayah_id": 5878,
    "translation": "ان کو «<a href=407> سیاہی </a>» ڈھانپتی ہو گی۔ [41]"
  },
  {
    "surah_id": 80,
    "ayah_number": 42,
    "global_ayah_id": 5879,
    "translation": "یہی ہیں جو کافر ہیں ، نافرمان ہیں۔ [42]"
  }
]