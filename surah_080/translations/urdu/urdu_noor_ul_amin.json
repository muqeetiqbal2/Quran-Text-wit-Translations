[
  {
    "surah_id": 80,
    "ayah_number": 0,
    "global_ayah_id": 5837,
    "translation": "شروع اللہ کے «<a href=614> نام </a>» سے جو بڑا «<a href=600> مہربان </a>» اور نہایت رحم کرنے والا ہے"
  },
  {
    "surah_id": 80,
    "ayah_number": 1,
    "global_ayah_id": 5838,
    "translation": "( اے نبی )  ترش روہوئے اور  ( انہوں نے عبداللہ بن ام مکتوم سے )  بے رخی کی"
  },
  {
    "surah_id": 80,
    "ayah_number": 2,
    "global_ayah_id": 5839,
    "translation": "کہ ان کے «<a href=141> پاس </a>» ایک «<a href=58> اندھا </a>»  ( عبداللہ بن ام مکتوم )  آیا"
  },
  {
    "surah_id": 80,
    "ayah_number": 3,
    "global_ayah_id": 5840,
    "translation": "اورآپکو کیا معلوم شاید اس کی اصلاح ہوجاتی"
  },
  {
    "surah_id": 80,
    "ayah_number": 4,
    "global_ayah_id": 5841,
    "translation": "یانصیحت کی «<a href=71> بات </a>» سنتاتونصیحت اسے «<a href=452> فائدہ </a>» دیتی"
  },
  {
    "surah_id": 80,
    "ayah_number": 5,
    "global_ayah_id": 5842,
    "translation": "لیکن جو شخص  ( ایمان لانے میں  )  بے پر واہ ہوتا ہے"
  },
  {
    "surah_id": 80,
    "ayah_number": 6,
    "global_ayah_id": 5843,
    "translation": "توآپ  ( ان مشرکوں کو «<a href=340> دین </a>» سکھانے کے )  «<a href=179> پیچھے </a>» پڑے ہوئے ہیں"
  },
  {
    "surah_id": 80,
    "ayah_number": 7,
    "global_ayah_id": 5844,
    "translation": "حالانکہ اگروہ نہیں سنورتے توآپ پر کوئی «<a href=355> ذمہ داری </a>» نہیں"
  },
  {
    "surah_id": 80,
    "ayah_number": 8,
    "global_ayah_id": 5845,
    "translation": "اورجو شخص  ( عبداللہ بن ام مکتوم )  آپ کے «<a href=141> پاس </a>» دوڑتا «<a href=654> ہوا </a>» آتا ہے"
  },
  {
    "surah_id": 80,
    "ayah_number": 9,
    "global_ayah_id": 5846,
    "translation": "اوراپنے رب سے ڈرتا ہے"
  },
  {
    "surah_id": 80,
    "ayah_number": 10,
    "global_ayah_id": 5847,
    "translation": "توآپ اس سے غفلت برتتے ہیں"
  },
  {
    "surah_id": 80,
    "ayah_number": 11,
    "global_ayah_id": 5848,
    "translation": "ایسا ہرگز نہیں چاہیے بیشک یہ  ( «<a href=470> قرآن </a>» )  توایک «<a href=622> نصیحت </a>» ہے"
  },
  {
    "surah_id": 80,
    "ayah_number": 12,
    "global_ayah_id": 5849,
    "translation": "جو چاہےاسے «<a href=657> یاد </a>» کرلے"
  },
  {
    "surah_id": 80,
    "ayah_number": 13,
    "global_ayah_id": 5850,
    "translation": "وہ قابل احترام صحیفوں میں ہے"
  },
  {
    "surah_id": 80,
    "ayah_number": 14,
    "global_ayah_id": 5851,
    "translation": "وہ  ( صحیفے )  جوبلندمقام پر ہیں  ،  اور پاکیزہ ہیں"
  },
  {
    "surah_id": 80,
    "ayah_number": 15,
    "global_ayah_id": 5852,
    "translation": "وہ ایسے «<a href=555> لکھنے </a>» والے  ( فرشتوں کے )  ہاتھوں میں ہیں"
  },
  {
    "surah_id": 80,
    "ayah_number": 16,
    "global_ayah_id": 5853,
    "translation": "جومعزز اور «<a href=634> نیک </a>» ہیں"
  },
  {
    "surah_id": 80,
    "ayah_number": 17,
    "global_ayah_id": 5854,
    "translation": "لعنت ہوانسان پر وہ کیسامنکرحق ہے؟"
  },
  {
    "surah_id": 80,
    "ayah_number": 18,
    "global_ayah_id": 5855,
    "translation": "اللہ نے اسے کس چیزسے «<a href=180> پیدا </a>» کیا"
  },
  {
    "surah_id": 80,
    "ayah_number": 19,
    "global_ayah_id": 5856,
    "translation": "نطفہ سے ،  اللہ نے اسے «<a href=180> پیدا </a>» کیا  پھر اس کی تقدیر «<a href=593> مقرر </a>» کی"
  },
  {
    "surah_id": 80,
    "ayah_number": 20,
    "global_ayah_id": 5857,
    "translation": "پھر اس کے لئے  ( «<a href=565> ماں </a>» کے رحم سے نکلنے کے )  راستے کو «<a href=9> آسان </a>» بنایا"
  },
  {
    "surah_id": 80,
    "ayah_number": 21,
    "global_ayah_id": 5858,
    "translation": "پھراسے موت دی اور اسے «<a href=464> قبر </a>» میں پہنچا دیا"
  },
  {
    "surah_id": 80,
    "ayah_number": 22,
    "global_ayah_id": 5859,
    "translation": "پھرجب وہ چاہےگااسے دوبارہ «<a href=381> زندہ </a>» اٹھائے گا"
  },
  {
    "surah_id": 80,
    "ayah_number": 23,
    "global_ayah_id": 5860,
    "translation": "ہر گز نہیں  ،  اس نے وہ «<a href=355> ذمہ داری </a>» پوری نہیں کی جس کا اللہ نے اسے «<a href=288> حکم </a>» دیاتھا"
  },
  {
    "surah_id": 80,
    "ayah_number": 24,
    "global_ayah_id": 5861,
    "translation": "انسان کو چاہیے کہ وہ اپنے کھانے کی طرف دیکھے"
  },
  {
    "surah_id": 80,
    "ayah_number": 25,
    "global_ayah_id": 5862,
    "translation": "ہم نے «<a href=144> پانی </a>» برسایا"
  },
  {
    "surah_id": 80,
    "ayah_number": 26,
    "global_ayah_id": 5863,
    "translation": "پھرعجیب طرح سے «<a href=379> زمین </a>» کو پھاڑا"
  },
  {
    "surah_id": 80,
    "ayah_number": 27,
    "global_ayah_id": 5864,
    "translation": "تواس میں سے ہم نے اناج بھی اگایا"
  },
  {
    "surah_id": 80,
    "ayah_number": 28,
    "global_ayah_id": 5865,
    "translation": "اور انگور بھی اور ترکاریاں"
  },
  {
    "surah_id": 80,
    "ayah_number": 29,
    "global_ayah_id": 5866,
    "translation": "اور زیتون اور کجھور"
  },
  {
    "surah_id": 80,
    "ayah_number": 30,
    "global_ayah_id": 5867,
    "translation": "اور گھنے باغات"
  },
  {
    "surah_id": 80,
    "ayah_number": 31,
    "global_ayah_id": 5868,
    "translation": "اور «<a href=170> پھل </a>» اور «<a href=253> چارہ </a>» اُگائے"
  },
  {
    "surah_id": 80,
    "ayah_number": 32,
    "global_ayah_id": 5869,
    "translation": "یہ سب تمہارے اور تمہارے مویشیوں کے لئے «<a href=385> سامان </a>» حیات ہے"
  },
  {
    "surah_id": 80,
    "ayah_number": 33,
    "global_ayah_id": 5870,
    "translation": "پھرجب کانوں کو بہراکردینے والا  ( صور )  برپا ہوجائے گا"
  },
  {
    "surah_id": 80,
    "ayah_number": 34,
    "global_ayah_id": 5871,
    "translation": "توآدمی اس «<a href=326> دن </a>» اپنے «<a href=120> بھائی </a>» سے بھاگے گا"
  },
  {
    "surah_id": 80,
    "ayah_number": 35,
    "global_ayah_id": 5872,
    "translation": "اوراپنی «<a href=565> ماں </a>» اور اپنے «<a href=69> باپ </a>» سے  ( بھاگے گا )"
  },
  {
    "surah_id": 80,
    "ayah_number": 36,
    "global_ayah_id": 5873,
    "translation": "اور اپنی «<a href=130> بیوی </a>» اور بیٹوں سے  ( بھی بھاگے گا )"
  },
  {
    "surah_id": 80,
    "ayah_number": 37,
    "global_ayah_id": 5874,
    "translation": "اس «<a href=326> دن </a>» ہرشخص کی ایسی «<a href=280> حالت </a>» ہوگی جو اسے  ( دوسرں سے )  بے خبرکردے گا"
  },
  {
    "surah_id": 80,
    "ayah_number": 38,
    "global_ayah_id": 5875,
    "translation": "اس «<a href=326> دن </a>» کچھ چہرے «<a href=264> چمک </a>» دمک رہے ہوں گے"
  },
  {
    "surah_id": 80,
    "ayah_number": 39,
    "global_ayah_id": 5876,
    "translation": "ہنستے ہوئے «<a href=308> خوش </a>» وخرم"
  },
  {
    "surah_id": 80,
    "ayah_number": 40,
    "global_ayah_id": 5877,
    "translation": "اور کچھ چہروں پر اس «<a href=326> دن </a>» غبارپڑی ہوگی"
  },
  {
    "surah_id": 80,
    "ayah_number": 41,
    "global_ayah_id": 5878,
    "translation": "اور «<a href=407> سیاہی </a>» چھا رہی ہوگی"
  },
  {
    "surah_id": 80,
    "ayah_number": 42,
    "global_ayah_id": 5879,
    "translation": "یہ وہ لوگ ہوں گےجو کافراور بدکار ہیں"
  }
]