[
  {
    "surah_id": 80,
    "ayah_number": 1,
    "global_ayah_id": 5759,
    "translation": "선지자께서 눈살을 찌푸렸고 등을 돌리셨나니"
  },
  {
    "surah_id": 80,
    "ayah_number": 2,
    "global_ayah_id": 5760,
    "translation": "장님이 그분께 다가와 방해하 였기 때문이라"
  },
  {
    "surah_id": 80,
    "ayah_number": 3,
    "global_ayah_id": 5761,
    "translation": "그가 스스로를 순결케 하려 하는지를 무엇이 그대로 하여금 알게 하리요"
  },
  {
    "surah_id": 80,
    "ayah_number": 4,
    "global_ayah_id": 5762,
    "translation": "그가 교훈을 받고 그대의 교 훈이 그를 유익하게 할련지도 모 르니라"
  },
  {
    "surah_id": 80,
    "ayah_number": 5,
    "global_ayah_id": 5763,
    "translation": "스스로 충만하다 생각하는 자 있나니"
  },
  {
    "surah_id": 80,
    "ayah_number": 6,
    "global_ayah_id": 5764,
    "translation": "그대여 그를 경계하라"
  },
  {
    "surah_id": 80,
    "ayah_number": 7,
    "global_ayah_id": 5765,
    "translation": "그가 스스로를 순결케 하지 아니한 것은 그대의 책임이 아니라"
  },
  {
    "surah_id": 80,
    "ayah_number": 8,
    "global_ayah_id": 5766,
    "translation": "그러나 진실로 열망하여 그대 에게 다가오는 자와"
  },
  {
    "surah_id": 80,
    "ayah_number": 9,
    "global_ayah_id": 5767,
    "translation": "마음속에 두려움을 느끼는 자 에게"
  },
  {
    "surah_id": 80,
    "ayah_number": 10,
    "global_ayah_id": 5768,
    "translation": "그대가 그를 소홀이 하였으 매"
  },
  {
    "surah_id": 80,
    "ayah_number": 11,
    "global_ayah_id": 5769,
    "translation": "결코 그래서는 안되나니 그 것이 하나님의 교훈이기 때문이라"
  },
  {
    "surah_id": 80,
    "ayah_number": 12,
    "global_ayah_id": 5770,
    "translation": "그러므로 원하는 자에게 그 로 하여금 교훈을 간직하도록 하 라"
  },
  {
    "surah_id": 80,
    "ayah_number": 13,
    "global_ayah_id": 5771,
    "translation": "그것은 명예롭게 기록되어 있으며"
  },
  {
    "surah_id": 80,
    "ayah_number": 14,
    "global_ayah_id": 5772,
    "translation": "순결하고 성스럽게 그리고 명예스럽게"
  },
  {
    "surah_id": 80,
    "ayah_number": 15,
    "global_ayah_id": 5773,
    "translation": "서기들의 손들에 의해 기록 되나니"
  },
  {
    "surah_id": 80,
    "ayah_number": 16,
    "global_ayah_id": 5774,
    "translation": "영광스럽고 고귀한 것이라"
  },
  {
    "surah_id": 80,
    "ayah_number": 17,
    "global_ayah_id": 5775,
    "translation": "하나님을 불신한 인간들에게저주가 있을 것이라"
  },
  {
    "surah_id": 80,
    "ayah_number": 18,
    "global_ayah_id": 5776,
    "translation": "그 무엇으로 하나님은 인간 을 창조하셨느뇨"
  },
  {
    "surah_id": 80,
    "ayah_number": 19,
    "global_ayah_id": 5777,
    "translation": "한방울의 정액으로 인간을창조하여 운명을 주었을 뿐이라"
  },
  {
    "surah_id": 80,
    "ayah_number": 20,
    "global_ayah_id": 5778,
    "translation": "그런 후 인간이 출생하기에순탄한 길을 두었으며"
  },
  {
    "surah_id": 80,
    "ayah_number": 21,
    "global_ayah_id": 5779,
    "translation": "그런 다음에는 인간을 죽게하여 무덤으로 향하도록 한 후"
  },
  {
    "surah_id": 80,
    "ayah_number": 22,
    "global_ayah_id": 5780,
    "translation": "하나님은 뜻이 있을 때 인 간을 다시 부활하시니라"
  },
  {
    "surah_id": 80,
    "ayah_number": 23,
    "global_ayah_id": 5781,
    "translation": "실로 인간은 하나님이 명령한 것들을 수행치 않노라"
  },
  {
    "surah_id": 80,
    "ayah_number": 24,
    "global_ayah_id": 5782,
    "translation": "인간으로 하여금 그가 먹는음식을 숙고하여 보게 하라"
  },
  {
    "surah_id": 80,
    "ayah_number": 25,
    "global_ayah_id": 5783,
    "translation": "실로 하나님은 흡족한 비를내리게 한 후"
  },
  {
    "surah_id": 80,
    "ayah_number": 26,
    "global_ayah_id": 5784,
    "translation": "대지를 펼쳐 그곳으로 부터식물을 재배케 하여"
  },
  {
    "surah_id": 80,
    "ayah_number": 27,
    "global_ayah_id": 5785,
    "translation": "그곳에서 곡식들을 성장케 하며"
  },
  {
    "surah_id": 80,
    "ayah_number": 28,
    "global_ayah_id": 5786,
    "translation": "포도와 푸른 식물과"
  },
  {
    "surah_id": 80,
    "ayah_number": 29,
    "global_ayah_id": 5787,
    "translation": "올리브와 종려나무와"
  },
  {
    "surah_id": 80,
    "ayah_number": 30,
    "global_ayah_id": 5788,
    "translation": "울창한 정원과"
  },
  {
    "surah_id": 80,
    "ayah_number": 31,
    "global_ayah_id": 5789,
    "translation": "과실과 목초가 있으니"
  },
  {
    "surah_id": 80,
    "ayah_number": 32,
    "global_ayah_id": 5790,
    "translation": "이 모든 것은 인간과 가축들을 위한 것이라"
  },
  {
    "surah_id": 80,
    "ayah_number": 33,
    "global_ayah_id": 5791,
    "translation": "고막이 터질듯한 소리가 들 릴 때면"
  },
  {
    "surah_id": 80,
    "ayah_number": 34,
    "global_ayah_id": 5792,
    "translation": "그날 인간은 그의 형제들로 부터 도주하나니"
  },
  {
    "surah_id": 80,
    "ayah_number": 35,
    "global_ayah_id": 5793,
    "translation": "그의 어머니와 아버지로부터"
  },
  {
    "surah_id": 80,
    "ayah_number": 36,
    "global_ayah_id": 5794,
    "translation": "그의 아내와 이이들로부터 도주하노라"
  },
  {
    "surah_id": 80,
    "ayah_number": 37,
    "global_ayah_id": 5795,
    "translation": "그날 그들 각자는 타인에게 무관심하며 스스로의 일에만 열중하노라"
  },
  {
    "surah_id": 80,
    "ayah_number": 38,
    "global_ayah_id": 5796,
    "translation": "그날 그들 중의 일부는 얼굴에 빛이 나며"
  },
  {
    "surah_id": 80,
    "ayah_number": 39,
    "global_ayah_id": 5797,
    "translation": "웃음짓고 기뻐 할 것이나"
  },
  {
    "surah_id": 80,
    "ayah_number": 40,
    "global_ayah_id": 5798,
    "translation": "일부는 그날 그들의 얼굴이 먼지로 싸여지며"
  },
  {
    "surah_id": 80,
    "ayah_number": 41,
    "global_ayah_id": 5799,
    "translation": "어둠이 그를 감싸니라"
  },
  {
    "surah_id": 80,
    "ayah_number": 42,
    "global_ayah_id": 5800,
    "translation": "그러함이 오만한 불신자들에게 있을 것이라"
  }
]