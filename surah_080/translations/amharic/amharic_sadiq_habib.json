[
  {
    "surah_id": 80,
    "ayah_number": 1,
    "global_ayah_id": 5759,
    "translation": "ፊቱን አጨፈገገ፤ ዞረም፡፡"
  },
  {
    "surah_id": 80,
    "ayah_number": 2,
    "global_ayah_id": 5760,
    "translation": "ዕውሩ ስለ መጣው፡፡"
  },
  {
    "surah_id": 80,
    "ayah_number": 3,
    "global_ayah_id": 5761,
    "translation": "ምን ያሳውቅሃል? (ከኀጢአቶቹ) ሊጥራራ ይከጀላል፡፡"
  },
  {
    "surah_id": 80,
    "ayah_number": 4,
    "global_ayah_id": 5762,
    "translation": "ወይም ሊገሠጽ ግሠጼይቱም ልትጠቅመው (ይከጀላል)፡፡"
  },
  {
    "surah_id": 80,
    "ayah_number": 5,
    "global_ayah_id": 5763,
    "translation": "የተብቃቃው ሰውማ፤"
  },
  {
    "surah_id": 80,
    "ayah_number": 6,
    "global_ayah_id": 5764,
    "translation": "አንተ ለእርሱ (ለእምነቱ በመጓጓት) በፈገግታ ትቀበለዋለህ፡፡"
  },
  {
    "surah_id": 80,
    "ayah_number": 7,
    "global_ayah_id": 5765,
    "translation": "ባይጥራራ (ባያምን) ባንተ ላይ ምንም የሌለብህ ስትኾን፡፡"
  },
  {
    "surah_id": 80,
    "ayah_number": 8,
    "global_ayah_id": 5766,
    "translation": "እየገሰገሰ የመጣህ ሰውማ፤"
  },
  {
    "surah_id": 80,
    "ayah_number": 9,
    "global_ayah_id": 5767,
    "translation": "እርሱ (አላህን) የሚፈራ ሲኾን፤"
  },
  {
    "surah_id": 80,
    "ayah_number": 10,
    "global_ayah_id": 5768,
    "translation": "አንተ ከእርሱ ትዝዘናጋለህ፡፡"
  },
  {
    "surah_id": 80,
    "ayah_number": 11,
    "global_ayah_id": 5769,
    "translation": "ተከልከል፡፡ እርሷ ማስገንዘቢያ ናት፡፡"
  },
  {
    "surah_id": 80,
    "ayah_number": 12,
    "global_ayah_id": 5770,
    "translation": "የሻም ሰው (ቁርኣኑን) ያስታውሰዋል፡፡"
  },
  {
    "surah_id": 80,
    "ayah_number": 13,
    "global_ayah_id": 5771,
    "translation": "በተከበሩ ጽሑፎች ውስጥ ነው፡፡"
  },
  {
    "surah_id": 80,
    "ayah_number": 14,
    "global_ayah_id": 5772,
    "translation": "ከፍ በተደረገች ንጹሕ በተደረገች (ጽሑፍ ውስጥ ነው)፡፡"
  },
  {
    "surah_id": 80,
    "ayah_number": 15,
    "global_ayah_id": 5773,
    "translation": "በጸሐፊዎቹ (መላእክት) እጆች (ንጹሕ የተደረገች)፡፡"
  },
  {
    "surah_id": 80,
    "ayah_number": 16,
    "global_ayah_id": 5774,
    "translation": "የተከበሩና ታዛዦች በኾኑት (ጸሐፊዎች እጆች)፡፡"
  },
  {
    "surah_id": 80,
    "ayah_number": 17,
    "global_ayah_id": 5775,
    "translation": "ሰው ተረገመ፤ ምን ከሓዲ አደረገው?"
  },
  {
    "surah_id": 80,
    "ayah_number": 18,
    "global_ayah_id": 5776,
    "translation": "(ጌታው) በምን ነገር ፈጠረው? (አያስብምን?)"
  },
  {
    "surah_id": 80,
    "ayah_number": 19,
    "global_ayah_id": 5777,
    "translation": "ከፍትወት ጠብታ ፈጠረው፤ መጠነውም፡፡"
  },
  {
    "surah_id": 80,
    "ayah_number": 20,
    "global_ayah_id": 5778,
    "translation": "ከዚያም (መውጫ) መንገዱን አገራው፡፡"
  },
  {
    "surah_id": 80,
    "ayah_number": 21,
    "global_ayah_id": 5779,
    "translation": "ከዚያም ገደለው፤ እንዲቀበርም አደረገው፡፡"
  },
  {
    "surah_id": 80,
    "ayah_number": 22,
    "global_ayah_id": 5780,
    "translation": "ከዚያም (ማንሳቱን) በሻ ጊዜ ያስነሳዋል፡፡"
  },
  {
    "surah_id": 80,
    "ayah_number": 23,
    "global_ayah_id": 5781,
    "translation": "በእውነት ያንን (ጌታው) ያዘዘውን ገና አልፈጸመም፡፡"
  },
  {
    "surah_id": 80,
    "ayah_number": 24,
    "global_ayah_id": 5782,
    "translation": "ሰውም ወደ ምግቡ ይመልከት፡፡"
  },
  {
    "surah_id": 80,
    "ayah_number": 25,
    "global_ayah_id": 5783,
    "translation": "እኛ ውሃን ማንቧቧትን ያንቧቧን መኾናችንን፡፡"
  },
  {
    "surah_id": 80,
    "ayah_number": 26,
    "global_ayah_id": 5784,
    "translation": "ከዚያም ምድርን (በደካማ ቡቃያ) መሰንጠቅን የሰነጠቅን፤"
  },
  {
    "surah_id": 80,
    "ayah_number": 27,
    "global_ayah_id": 5785,
    "translation": "በውስጧም እኽልን ያበቀልን፤"
  },
  {
    "surah_id": 80,
    "ayah_number": 28,
    "global_ayah_id": 5786,
    "translation": "ወይንንም፤ እርጥብ ያበቀልን፤"
  },
  {
    "surah_id": 80,
    "ayah_number": 29,
    "global_ayah_id": 5787,
    "translation": "የዘይት ወይራንም ዘንባባንም፤"
  },
  {
    "surah_id": 80,
    "ayah_number": 30,
    "global_ayah_id": 5788,
    "translation": "ጭፍቆች አትክልቶችንም፤"
  },
  {
    "surah_id": 80,
    "ayah_number": 31,
    "global_ayah_id": 5789,
    "translation": "ፍራፍሬንም ገለባንም፤ (ያበቀልን መኾናችንን ይመልከት)፡፡"
  },
  {
    "surah_id": 80,
    "ayah_number": 32,
    "global_ayah_id": 5790,
    "translation": "ለእናንተም ለእንስሶቻችሁም መጠቀሚያ ይኾን ዘንድ (ይህን ሠራን)፡፡"
  },
  {
    "surah_id": 80,
    "ayah_number": 33,
    "global_ayah_id": 5791,
    "translation": "አደንቋሪይቱም (መከራ) በመጣች ጊዜ፤"
  },
  {
    "surah_id": 80,
    "ayah_number": 34,
    "global_ayah_id": 5792,
    "translation": "ሰው ከወንድሙ በሚሸሽበት ቀን፤"
  },
  {
    "surah_id": 80,
    "ayah_number": 35,
    "global_ayah_id": 5793,
    "translation": "ከናቱም ካባቱም፤"
  },
  {
    "surah_id": 80,
    "ayah_number": 36,
    "global_ayah_id": 5794,
    "translation": "ከሚስቱም ከልጁም፤"
  },
  {
    "surah_id": 80,
    "ayah_number": 37,
    "global_ayah_id": 5795,
    "translation": "ከእነርሱ ለየሰው ሁሉ በዚያ ቀን (ከሌላው) የሚያብቃቃው ኹነታ አልለው፡፡"
  },
  {
    "surah_id": 80,
    "ayah_number": 38,
    "global_ayah_id": 5796,
    "translation": "ፊቶች በዚያ ቀን አብሪዎች ናቸው፤"
  },
  {
    "surah_id": 80,
    "ayah_number": 39,
    "global_ayah_id": 5797,
    "translation": "ሳቂዎችም ተደሳቾችም ናቸው፡፡"
  },
  {
    "surah_id": 80,
    "ayah_number": 40,
    "global_ayah_id": 5798,
    "translation": "ፊቶችም በዚያ ቀን በላያቸው ላይ ትቢያ አልለባቸው፤"
  },
  {
    "surah_id": 80,
    "ayah_number": 41,
    "global_ayah_id": 5799,
    "translation": "ጥቁረት ትሸፍናቸዋለች፤"
  },
  {
    "surah_id": 80,
    "ayah_number": 42,
    "global_ayah_id": 5800,
    "translation": "እነዚያ እነሱ ከሓዲዎቹ አመጸኞቹ ናቸው፡፡"
  }
]