[
  {
    "surah_id": 80,
    "ayah_number": 0,
    "global_ayah_id": 5837,
    "translation": "In the name of God, the Most Gracious, the Most Merciful"
  },
  {
    "surah_id": 80,
    "ayah_number": 1,
    "global_ayah_id": 5838,
    "translation": "1 He frowned and turned away"
  },
  {
    "surah_id": 80,
    "ayah_number": 2,
    "global_ayah_id": 5839,
    "translation": "2 when the blind man approached him,"
  },
  {
    "surah_id": 80,
    "ayah_number": 3,
    "global_ayah_id": 5840,
    "translation": "3 for how can you know that he might seek to purify himself,"
  },
  {
    "surah_id": 80,
    "ayah_number": 4,
    "global_ayah_id": 5841,
    "translation": "4 or take heed and derive benefit from [Our] warning?"
  },
  {
    "surah_id": 80,
    "ayah_number": 5,
    "global_ayah_id": 5842,
    "translation": "5 As for him who was indifferent,"
  },
  {
    "surah_id": 80,
    "ayah_number": 6,
    "global_ayah_id": 5843,
    "translation": "6 you eagerly attended to him—"
  },
  {
    "surah_id": 80,
    "ayah_number": 7,
    "global_ayah_id": 5844,
    "translation": "7 though you are not to be blamed if he would not purify himself—"
  },
  {
    "surah_id": 80,
    "ayah_number": 8,
    "global_ayah_id": 5845,
    "translation": "8 but as for one who comes to you, eagerly"
  },
  {
    "surah_id": 80,
    "ayah_number": 9,
    "global_ayah_id": 5846,
    "translation": "9 and in awe of God"
  },
  {
    "surah_id": 80,
    "ayah_number": 10,
    "global_ayah_id": 5847,
    "translation": "10 you pay him no heed."
  },
  {
    "surah_id": 80,
    "ayah_number": 11,
    "global_ayah_id": 5848,
    "translation": "11 Indeed, this [Quran] is an admonition."
  },
  {
    "surah_id": 80,
    "ayah_number": 12,
    "global_ayah_id": 5849,
    "translation": "12 Let him who will, pay heed to it."
  },
  {
    "surah_id": 80,
    "ayah_number": 13,
    "global_ayah_id": 5850,
    "translation": "13 It is set down on honoured pages,"
  },
  {
    "surah_id": 80,
    "ayah_number": 14,
    "global_ayah_id": 5851,
    "translation": "14 exalted and purified,"
  },
  {
    "surah_id": 80,
    "ayah_number": 15,
    "global_ayah_id": 5852,
    "translation": "15 by the hands of"
  },
  {
    "surah_id": 80,
    "ayah_number": 16,
    "global_ayah_id": 5853,
    "translation": "16 scribes, exalted and purified."
  },
  {
    "surah_id": 80,
    "ayah_number": 17,
    "global_ayah_id": 5854,
    "translation": "17 Woe to man! How ungrateful he is!"
  },
  {
    "surah_id": 80,
    "ayah_number": 18,
    "global_ayah_id": 5855,
    "translation": "18 Of what [stuff] has He created him?"
  },
  {
    "surah_id": 80,
    "ayah_number": 19,
    "global_ayah_id": 5856,
    "translation": "19 Out of a drop of sperm! He creates and proportions him,"
  },
  {
    "surah_id": 80,
    "ayah_number": 20,
    "global_ayah_id": 5857,
    "translation": "20 He makes his path easy for him."
  },
  {
    "surah_id": 80,
    "ayah_number": 21,
    "global_ayah_id": 5858,
    "translation": "21 Then He causes him to die and be buried."
  },
  {
    "surah_id": 80,
    "ayah_number": 22,
    "global_ayah_id": 5859,
    "translation": "22 Then when He pleases, He will bring him back to life."
  },
  {
    "surah_id": 80,
    "ayah_number": 23,
    "global_ayah_id": 5860,
    "translation": "23 Yet man declines to do His bidding."
  },
  {
    "surah_id": 80,
    "ayah_number": 24,
    "global_ayah_id": 5861,
    "translation": "24 Let man reflect on the food he eats."
  },
  {
    "surah_id": 80,
    "ayah_number": 25,
    "global_ayah_id": 5862,
    "translation": "25 We let the rain pour down in torrents"
  },
  {
    "surah_id": 80,
    "ayah_number": 26,
    "global_ayah_id": 5863,
    "translation": "26 and then We cleaved the earth asunder."
  },
  {
    "surah_id": 80,
    "ayah_number": 27,
    "global_ayah_id": 5864,
    "translation": "27 We make the grain grow out of it,"
  },
  {
    "surah_id": 80,
    "ayah_number": 28,
    "global_ayah_id": 5865,
    "translation": "28 and grape vines and vegetables,"
  },
  {
    "surah_id": 80,
    "ayah_number": 29,
    "global_ayah_id": 5866,
    "translation": "29 and olive trees and date palms"
  },
  {
    "surah_id": 80,
    "ayah_number": 30,
    "global_ayah_id": 5867,
    "translation": "30 and burgeoning enclosed gardens"
  },
  {
    "surah_id": 80,
    "ayah_number": 31,
    "global_ayah_id": 5868,
    "translation": "31 and fruits and fodder"
  },
  {
    "surah_id": 80,
    "ayah_number": 32,
    "global_ayah_id": 5869,
    "translation": "32 as provision for you and for your cattle to enjoy."
  },
  {
    "surah_id": 80,
    "ayah_number": 33,
    "global_ayah_id": 5870,
    "translation": "33 But when the deafening blast is sounded,"
  },
  {
    "surah_id": 80,
    "ayah_number": 34,
    "global_ayah_id": 5871,
    "translation": "34 on that Day a man shall flee from his own brother,"
  },
  {
    "surah_id": 80,
    "ayah_number": 35,
    "global_ayah_id": 5872,
    "translation": "35 his mother, his father,"
  },
  {
    "surah_id": 80,
    "ayah_number": 36,
    "global_ayah_id": 5873,
    "translation": "36 his wife and his sons:"
  },
  {
    "surah_id": 80,
    "ayah_number": 37,
    "global_ayah_id": 5874,
    "translation": "37 on that Day every man among them will have enough concern of his own—"
  },
  {
    "surah_id": 80,
    "ayah_number": 38,
    "global_ayah_id": 5875,
    "translation": "38 on that Day some faces will be beaming,"
  },
  {
    "surah_id": 80,
    "ayah_number": 39,
    "global_ayah_id": 5876,
    "translation": "39 laughing, and rejoicing,"
  },
  {
    "surah_id": 80,
    "ayah_number": 40,
    "global_ayah_id": 5877,
    "translation": "40 but some faces will be covered with dust"
  },
  {
    "surah_id": 80,
    "ayah_number": 41,
    "global_ayah_id": 5878,
    "translation": "41 and overcast with gloom:"
  },
  {
    "surah_id": 80,
    "ayah_number": 42,
    "global_ayah_id": 5879,
    "translation": "42 those will be ones who denied the truth and were immersed in iniquity."
  }
