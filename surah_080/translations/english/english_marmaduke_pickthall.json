[
  {
    "surah_id": 80,
    "ayah_number": 1,
    "global_ayah_id": 5759,
    "translation": "He frowned and turned away"
  },
  {
    "surah_id": 80,
    "ayah_number": 2,
    "global_ayah_id": 5760,
    "translation": "Because the blind man came unto him."
  },
  {
    "surah_id": 80,
    "ayah_number": 3,
    "global_ayah_id": 5761,
    "translation": "What could inform thee but that he might grow (in grace)"
  },
  {
    "surah_id": 80,
    "ayah_number": 4,
    "global_ayah_id": 5762,
    "translation": "Or take heed and so the reminder might avail him?"
  },
  {
    "surah_id": 80,
    "ayah_number": 5,
    "global_ayah_id": 5763,
    "translation": "As for him who thinketh himself independent,"
  },
  {
    "surah_id": 80,
    "ayah_number": 6,
    "global_ayah_id": 5764,
    "translation": "Unto him thou payest regard."
  },
  {
    "surah_id": 80,
    "ayah_number": 7,
    "global_ayah_id": 5765,
    "translation": "Yet it is not thy concern if he grow not (in grace)."
  },
  {
    "surah_id": 80,
    "ayah_number": 8,
    "global_ayah_id": 5766,
    "translation": "But as for him who cometh unto thee with earnest purpose"
  },
  {
    "surah_id": 80,
    "ayah_number": 9,
    "global_ayah_id": 5767,
    "translation": "And hath fear,"
  },
  {
    "surah_id": 80,
    "ayah_number": 10,
    "global_ayah_id": 5768,
    "translation": "From him thou art distracted."
  },
  {
    "surah_id": 80,
    "ayah_number": 11,
    "global_ayah_id": 5769,
    "translation": "Nay, but verily it is an Admonishment,"
  },
  {
    "surah_id": 80,
    "ayah_number": 12,
    "global_ayah_id": 5770,
    "translation": "So let whosoever will pay heed to it,"
  },
  {
    "surah_id": 80,
    "ayah_number": 13,
    "global_ayah_id": 5771,
    "translation": "On honoured leaves"
  },
  {
    "surah_id": 80,
    "ayah_number": 14,
    "global_ayah_id": 5772,
    "translation": "Exalted, purified,"
  },
  {
    "surah_id": 80,
    "ayah_number": 15,
    "global_ayah_id": 5773,
    "translation": "(Set down) by scribes"
  },
  {
    "surah_id": 80,
    "ayah_number": 16,
    "global_ayah_id": 5774,
    "translation": "Noble and righteous."
  },
  {
    "surah_id": 80,
    "ayah_number": 17,
    "global_ayah_id": 5775,
    "translation": "Man is (self-)destroyed: how ungrateful!"
  },
  {
    "surah_id": 80,
    "ayah_number": 18,
    "global_ayah_id": 5776,
    "translation": "From what thing doth He create him?"
  },
  {
    "surah_id": 80,
    "ayah_number": 19,
    "global_ayah_id": 5777,
    "translation": "From a drop of seed. He createth him and proportioneth him,"
  },
  {
    "surah_id": 80,
    "ayah_number": 20,
    "global_ayah_id": 5778,
    "translation": "Then maketh the way easy for him,"
  },
  {
    "surah_id": 80,
    "ayah_number": 21,
    "global_ayah_id": 5779,
    "translation": "Then causeth him to die, and burieth him;"
  },
  {
    "surah_id": 80,
    "ayah_number": 22,
    "global_ayah_id": 5780,
    "translation": "Then, when He will, He bringeth him again to life."
  },
  {
    "surah_id": 80,
    "ayah_number": 23,
    "global_ayah_id": 5781,
    "translation": "Nay, but (man) hath not done what He commanded him."
  },
  {
    "surah_id": 80,
    "ayah_number": 24,
    "global_ayah_id": 5782,
    "translation": "Let man consider his food:"
  },
  {
    "surah_id": 80,
    "ayah_number": 25,
    "global_ayah_id": 5783,
    "translation": "How We pour water in showers"
  },
  {
    "surah_id": 80,
    "ayah_number": 26,
    "global_ayah_id": 5784,
    "translation": "Then split the earth in clefts"
  },
  {
    "surah_id": 80,
    "ayah_number": 27,
    "global_ayah_id": 5785,
    "translation": "And cause the grain to grow therein"
  },
  {
    "surah_id": 80,
    "ayah_number": 28,
    "global_ayah_id": 5786,
    "translation": "And grapes and green fodder"
  },
  {
    "surah_id": 80,
    "ayah_number": 29,
    "global_ayah_id": 5787,
    "translation": "And olive-trees and palm-trees"
  },
  {
    "surah_id": 80,
    "ayah_number": 30,
    "global_ayah_id": 5788,
    "translation": "And garden-closes of thick foliage"
  },
  {
    "surah_id": 80,
    "ayah_number": 31,
    "global_ayah_id": 5789,
    "translation": "And fruits and grasses:"
  },
  {
    "surah_id": 80,
    "ayah_number": 32,
    "global_ayah_id": 5790,
    "translation": "Provision for you and your cattle."
  },
  {
    "surah_id": 80,
    "ayah_number": 33,
    "global_ayah_id": 5791,
    "translation": "But when the Shout cometh"
  },
  {
    "surah_id": 80,
    "ayah_number": 34,
    "global_ayah_id": 5792,
    "translation": "On the day when a man fleeth from his brother"
  },
  {
    "surah_id": 80,
    "ayah_number": 35,
    "global_ayah_id": 5793,
    "translation": "And his mother and his father"
  },
  {
    "surah_id": 80,
    "ayah_number": 36,
    "global_ayah_id": 5794,
    "translation": "And his wife and his children,"
  },
  {
    "surah_id": 80,
    "ayah_number": 37,
    "global_ayah_id": 5795,
    "translation": "Every man that day will have concern enough to make him heedless (of others)."
  },
  {
    "surah_id": 80,
    "ayah_number": 38,
    "global_ayah_id": 5796,
    "translation": "On that day faces will be bright as dawn,"
  },
  {
    "surah_id": 80,
    "ayah_number": 39,
    "global_ayah_id": 5797,
    "translation": "Laughing, rejoicing at good news;"
  },
  {
    "surah_id": 80,
    "ayah_number": 40,
    "global_ayah_id": 5798,
    "translation": "And other faces, on that day, with dust upon them,"
  },
  {
    "surah_id": 80,
    "ayah_number": 41,
    "global_ayah_id": 5799,
    "translation": "Veiled in darkness,"
  },
  {
    "surah_id": 80,
    "ayah_number": 42,
    "global_ayah_id": 5800,
    "translation": "Those are the disbelievers, the wicked."
  }
]