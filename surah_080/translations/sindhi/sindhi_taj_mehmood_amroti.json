[
  {
    "surah_id": 80,
    "ayah_number": 1,
    "global_ayah_id": 5759,
    "translation": "مُنھن ۾ گُھنڊ وڌائين ۽ مُنھن موڙيائين."
  },
  {
    "surah_id": 80,
    "ayah_number": 2,
    "global_ayah_id": 5760,
    "translation": "ھن ڪري جو وٽس نابين آيو."
  },
  {
    "surah_id": 80,
    "ayah_number": 3,
    "global_ayah_id": 5761,
    "translation": "۽ ڪنھن سمجھايئي جيڪر اُھو سڌرجي ھا."
  },
  {
    "surah_id": 80,
    "ayah_number": 4,
    "global_ayah_id": 5762,
    "translation": "يا نصيحت ٻڌي ھا پوءِ اُھا نصيحت ٻڌڻ نفعو ڏئيس ھا."
  },
  {
    "surah_id": 80,
    "ayah_number": 5,
    "global_ayah_id": 5763,
    "translation": "پر جنھن بي پرواھي ڪئي."
  },
  {
    "surah_id": 80,
    "ayah_number": 6,
    "global_ayah_id": 5764,
    "translation": "پوءِ تنھن (جي سڌاري) لاءِ تون پٺيان پيو آھين."
  },
  {
    "surah_id": 80,
    "ayah_number": 7,
    "global_ayah_id": 5765,
    "translation": "ھن ۾ توتي (ڪا ميار) ڪانھي ته اُھو نه سُڌرجي."
  },
  {
    "surah_id": 80,
    "ayah_number": 8,
    "global_ayah_id": 5766,
    "translation": "۽ جيڪو تو وٽ ڊوڙندو آيو."
  },
  {
    "surah_id": 80,
    "ayah_number": 9,
    "global_ayah_id": 5767,
    "translation": "۽ اُھو (پنھنجي الله کان) ڊڄي ٿو."
  },
  {
    "surah_id": 80,
    "ayah_number": 10,
    "global_ayah_id": 5768,
    "translation": "پوءِ تنھن کان تون ويسلو ٿئين ٿو."
  },
  {
    "surah_id": 80,
    "ayah_number": 11,
    "global_ayah_id": 5769,
    "translation": "ائين نه آھي بيشڪ اھي (قرآن جون آيتون) ھڪ نصيحت آھي."
  },
  {
    "surah_id": 80,
    "ayah_number": 12,
    "global_ayah_id": 5770,
    "translation": "پوءِ جيڪو گھُري سو قرآن ياد رکي."
  },
  {
    "surah_id": 80,
    "ayah_number": 13,
    "global_ayah_id": 5771,
    "translation": "(بيشڪ قرآن جون آيتون) تعظيم وارن ورقن ۾ لکيل آھن."
  },
  {
    "surah_id": 80,
    "ayah_number": 14,
    "global_ayah_id": 5772,
    "translation": "جي مٿاھان ۽ پاڪ آھن."
  },
  {
    "surah_id": 80,
    "ayah_number": 15,
    "global_ayah_id": 5773,
    "translation": "لکندڙن جي ھٿن ۾."
  },
  {
    "surah_id": 80,
    "ayah_number": 16,
    "global_ayah_id": 5774,
    "translation": "جي سڳورا ڀلارا آھن."
  },
  {
    "surah_id": 80,
    "ayah_number": 17,
    "global_ayah_id": 5775,
    "translation": "ماڻھو ماريو وڃي جو ڪھڙو نه بي شُڪر آھي."
  },
  {
    "surah_id": 80,
    "ayah_number": 18,
    "global_ayah_id": 5776,
    "translation": "(ڌيان ڪري ته الله) ڪھڙي شيءَ مان پيدا ڪيس."
  },
  {
    "surah_id": 80,
    "ayah_number": 19,
    "global_ayah_id": 5777,
    "translation": "مني جي ڦڙي مان، خلقيائينس پوءِ اندازو مقرر ڪيائينس."
  },
  {
    "surah_id": 80,
    "ayah_number": 20,
    "global_ayah_id": 5778,
    "translation": "وري (نڪرڻ جي) واٽ سنھنجي ڪيائينس."
  },
  {
    "surah_id": 80,
    "ayah_number": 21,
    "global_ayah_id": 5779,
    "translation": "وري ماريائينس پوءِ قبر ۾ رکايائينس."
  },
  {
    "surah_id": 80,
    "ayah_number": 22,
    "global_ayah_id": 5780,
    "translation": "وري جڏھن گھرندو تڏھن اُن کي جيئرو ڪندو."
  },
  {
    "surah_id": 80,
    "ayah_number": 23,
    "global_ayah_id": 5781,
    "translation": "ائين نه آھي جيڪي فرمايائينس سو پورو نه ڪيائين."
  },
  {
    "surah_id": 80,
    "ayah_number": 24,
    "global_ayah_id": 5782,
    "translation": "پوءِ جڳائي ته ماڻھو پنھنجي کاڌي ڏانھن نھاري ڏسي."
  },
  {
    "surah_id": 80,
    "ayah_number": 25,
    "global_ayah_id": 5783,
    "translation": "ته اسان پاڻي کي چڱيءَ طرح آسمان کان پلٽيو."
  },
  {
    "surah_id": 80,
    "ayah_number": 26,
    "global_ayah_id": 5784,
    "translation": "وري زمين کي پوري طرح چيريوسون."
  },
  {
    "surah_id": 80,
    "ayah_number": 27,
    "global_ayah_id": 5785,
    "translation": "پوءِ منجھس اَن ڄمايوسون."
  },
  {
    "surah_id": 80,
    "ayah_number": 28,
    "global_ayah_id": 5786,
    "translation": "۽ ڊاکون ۽ ترڪاريون."
  },
  {
    "surah_id": 80,
    "ayah_number": 29,
    "global_ayah_id": 5787,
    "translation": "۽ زيتون ۽ کجيون."
  },
  {
    "surah_id": 80,
    "ayah_number": 30,
    "global_ayah_id": 5788,
    "translation": "۽ گھاٽا باغ."
  },
  {
    "surah_id": 80,
    "ayah_number": 31,
    "global_ayah_id": 5789,
    "translation": "۽ ميوو ۽ گاھ (به)."
  },
  {
    "surah_id": 80,
    "ayah_number": 32,
    "global_ayah_id": 5790,
    "translation": "اوھان جي نفعي لاءِ ۽ اوھان جي ڍورن لاءِ."
  },
  {
    "surah_id": 80,
    "ayah_number": 33,
    "global_ayah_id": 5791,
    "translation": "پوءِ جڏھن ڪَن ٻوڙا ڪندڙ (دھشت واري) ھڪل ايندي."
  },
  {
    "surah_id": 80,
    "ayah_number": 34,
    "global_ayah_id": 5792,
    "translation": "انھي ڏينھن آدمي پنھنجي ڀاءُ کان ڀڄندو."
  },
  {
    "surah_id": 80,
    "ayah_number": 35,
    "global_ayah_id": 5793,
    "translation": "۽ (پڻ) پنھنجي ماءُ کان ۽ پنھنجي پيءُ کان."
  },
  {
    "surah_id": 80,
    "ayah_number": 36,
    "global_ayah_id": 5794,
    "translation": "۽ پنھنجي گھر واريءَ کان ۽ پنھنجي پٽن کان ڀڄندو."
  },
  {
    "surah_id": 80,
    "ayah_number": 37,
    "global_ayah_id": 5795,
    "translation": "انھن مان سڀڪنھن مڙس لاءِ اُن ڏينھن اھڙي حالت ھوندي جو کيس بس ھوندي."
  },
  {
    "surah_id": 80,
    "ayah_number": 38,
    "global_ayah_id": 5796,
    "translation": "ڪيترائي منھن اُن ڏينھن روشن ھوندا."
  },
  {
    "surah_id": 80,
    "ayah_number": 39,
    "global_ayah_id": 5797,
    "translation": "کِلندڙ ۽ (تمام) سرھا ھوندا."
  },
  {
    "surah_id": 80,
    "ayah_number": 40,
    "global_ayah_id": 5798,
    "translation": "۽ ڪيترائي منھن (ھوندا) جن تي اُن ڏينھن رئي پيل ھوندي."
  },
  {
    "surah_id": 80,
    "ayah_number": 41,
    "global_ayah_id": 5799,
    "translation": "جن کي ڪارنھن ويڙھي ويندي."
  },
  {
    "surah_id": 80,
    "ayah_number": 42,
    "global_ayah_id": 5800,
    "translation": "اھي ئي مُنڪر بدڪار آھن."
  }
]