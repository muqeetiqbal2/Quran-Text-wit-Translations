[
  {
    "surah_id": 69,
    "ayah_number": 1,
    "global_ayah_id": 5324,
    "translation": "確かな真実，"
  },
  {
    "surah_id": 69,
    "ayah_number": 2,
    "global_ayah_id": 5325,
    "translation": "確かな真実とは何か。"
  },
  {
    "surah_id": 69,
    "ayah_number": 3,
    "global_ayah_id": 5326,
    "translation": "確かな真実が何であるかを，あなたに理解させるものは何か。"
  },
  {
    "surah_id": 69,
    "ayah_number": 4,
    "global_ayah_id": 5327,
    "translation": "サムードとアード（の民）は，突然来る災厄を虚偽であるとした。"
  },
  {
    "surah_id": 69,
    "ayah_number": 5,
    "global_ayah_id": 5328,
    "translation": "それでサムードは雷雲の嵐によって滅ぼされた。"
  },
  {
    "surah_id": 69,
    "ayah_number": 6,
    "global_ayah_id": 5329,
    "translation": "またアードは，唸り狂う風によって滅ぼされた。"
  },
  {
    "surah_id": 69,
    "ayah_number": 7,
    "global_ayah_id": 5330,
    "translation": "7夜8日にわたり，かれらに対し絶え間なく（嵐が）襲い，それで朽ちたナツメヤシの木のように，（凡ての）民がそこに倒れているのを，あなたは見たであろう。"
  },
  {
    "surah_id": 69,
    "ayah_number": 8,
    "global_ayah_id": 5331,
    "translation": "それであなたは，かれらの中，誰か残っている者を見るのか。"
  },
  {
    "surah_id": 69,
    "ayah_number": 9,
    "global_ayah_id": 5332,
    "translation": "またフィルアウンやかれ以前の者や滅ぼされた諸都市（の民）も，罪を犯していた。"
  },
  {
    "surah_id": 69,
    "ayah_number": 10,
    "global_ayah_id": 5333,
    "translation": "かれらは主の使徒に従わないので，かれは猛烈な懲罰でかれらを処罰した。"
  },
  {
    "surah_id": 69,
    "ayah_number": 11,
    "global_ayah_id": 5334,
    "translation": "大水のとき，われが方舟であなたがたを連んだのは，"
  },
  {
    "surah_id": 69,
    "ayah_number": 12,
    "global_ayah_id": 5335,
    "translation": "それをあなたがたへの数訓とさせ，注意深い耳がそれを（聞いて）記憶に留めるためである。"
  },
  {
    "surah_id": 69,
    "ayah_number": 13,
    "global_ayah_id": 5336,
    "translation": "それでラッパが一吹き吹かれた時，"
  },
  {
    "surah_id": 69,
    "ayah_number": 14,
    "global_ayah_id": 5337,
    "translation": "大地や山々は持ち上げられ，一撃で粉々に砕かれ，"
  },
  {
    "surah_id": 69,
    "ayah_number": 15,
    "global_ayah_id": 5338,
    "translation": "その日（一大）事件が起る。"
  },
  {
    "surah_id": 69,
    "ayah_number": 16,
    "global_ayah_id": 5339,
    "translation": "また大空は千々に裂ける。天が脆く弱い日であろう。"
  },
  {
    "surah_id": 69,
    "ayah_number": 17,
    "global_ayah_id": 5340,
    "translation": "天使たちは，その（天の）端々におり，その日，8人（の天使）がかれらの上に，あなたの主の玉座を担うてあろう。"
  },
  {
    "surah_id": 69,
    "ayah_number": 18,
    "global_ayah_id": 5341,
    "translation": "その日あなたがたは（審判のため）みな（剥？）き出しにされ何一つとして隠しおおせないであろう。"
  },
  {
    "surah_id": 69,
    "ayah_number": 19,
    "global_ayah_id": 5342,
    "translation": "それで右手にその（行状）記を渡される者は言う。「ここに（来て），あなたがたはわたしの（行状）記を読め。」"
  },
  {
    "surah_id": 69,
    "ayah_number": 20,
    "global_ayah_id": 5343,
    "translation": "「いずれわたし（信者）の清算（審判）に合うことが，本当に分っていた。」"
  },
  {
    "surah_id": 69,
    "ayah_number": 21,
    "global_ayah_id": 5344,
    "translation": "こうしてかれは至福な生活に浸り，"
  },
  {
    "surah_id": 69,
    "ayah_number": 22,
    "global_ayah_id": 5345,
    "translation": "高い（丘の）園の中で，"
  },
  {
    "surah_id": 69,
    "ayah_number": 23,
    "global_ayah_id": 5346,
    "translation": "様々な果実が手近にある。"
  },
  {
    "surah_id": 69,
    "ayah_number": 24,
    "global_ayah_id": 5347,
    "translation": "「あなたがたは，過ぎ去った日（現世）で行った（善行の）ために，満悦して食べ，且つ飲め。」（と言われよう）。"
  },
  {
    "surah_id": 69,
    "ayah_number": 25,
    "global_ayah_id": 5348,
    "translation": "だが左手にその（行状）記を渡される者は言う。「ああ，わたしの（行状）記が渡さオになかったならば」"
  },
  {
    "surah_id": 69,
    "ayah_number": 26,
    "global_ayah_id": 5349,
    "translation": "「わたしは自分の清算が，どんなものであるかを知らなかった。」"
  },
  {
    "surah_id": 69,
    "ayah_number": 27,
    "global_ayah_id": 5350,
    "translation": "ああ，その（死）が（わたしの）終末であったならば，"
  },
  {
    "surah_id": 69,
    "ayah_number": 28,
    "global_ayah_id": 5351,
    "translation": "富は，わたしに役立たなかった。"
  },
  {
    "surah_id": 69,
    "ayah_number": 29,
    "global_ayah_id": 5352,
    "translation": "「権威は，わたしから消え失せてしまった。」"
  },
  {
    "surah_id": 69,
    "ayah_number": 30,
    "global_ayah_id": 5353,
    "translation": "（だが厳命が下ろう。）「かれを捕えて，縛れ。」"
  },
  {
    "surah_id": 69,
    "ayah_number": 31,
    "global_ayah_id": 5354,
    "translation": "それから燃え盛る火で，かれを焼け。"
  },
  {
    "surah_id": 69,
    "ayah_number": 32,
    "global_ayah_id": 5355,
    "translation": "更に70腕尺の長さの鎖で，かれを巻け。"
  },
  {
    "surah_id": 69,
    "ayah_number": 33,
    "global_ayah_id": 5356,
    "translation": "本当にかれは，偉大なるアッラーを信じず，"
  },
  {
    "surah_id": 69,
    "ayah_number": 34,
    "global_ayah_id": 5357,
    "translation": "また貧者を養うことを勧めなかった。"
  },
  {
    "surah_id": 69,
    "ayah_number": 35,
    "global_ayah_id": 5358,
    "translation": "それでこの日かれは，そこに友は無く，"
  },
  {
    "surah_id": 69,
    "ayah_number": 36,
    "global_ayah_id": 5359,
    "translation": "また，穢しい腐敗物の外に食物はない，"
  },
  {
    "surah_id": 69,
    "ayah_number": 37,
    "global_ayah_id": 5360,
    "translation": "「それを食べるのは，罪人だけである。」"
  },
  {
    "surah_id": 69,
    "ayah_number": 38,
    "global_ayah_id": 5361,
    "translation": "われは，あなたがたが見得るものにおいて誓い，"
  },
  {
    "surah_id": 69,
    "ayah_number": 39,
    "global_ayah_id": 5362,
    "translation": "またあなたがたが見得ないものにおいて誓う。"
  },
  {
    "surah_id": 69,
    "ayah_number": 40,
    "global_ayah_id": 5363,
    "translation": "本当にこれは，尊貴な使徒の言葉である。"
  },
  {
    "surah_id": 69,
    "ayah_number": 41,
    "global_ayah_id": 5364,
    "translation": "これは詩人の言葉ではない。だがあなたがたは，ほとんど信じない。"
  },
  {
    "surah_id": 69,
    "ayah_number": 42,
    "global_ayah_id": 5365,
    "translation": "また，占い師の言葉でもない。しかしあなたがたはほとんど気にもしない。"
  },
  {
    "surah_id": 69,
    "ayah_number": 43,
    "global_ayah_id": 5366,
    "translation": "（これは）万有の主から下された啓示である。"
  },
  {
    "surah_id": 69,
    "ayah_number": 44,
    "global_ayah_id": 5367,
    "translation": "もしかれ（使徒）が，われに関して何らかの言葉を捏造するならば，"
  },
  {
    "surah_id": 69,
    "ayah_number": 45,
    "global_ayah_id": 5368,
    "translation": "われはきっとかれの右手を捕え，"
  },
  {
    "surah_id": 69,
    "ayah_number": 46,
    "global_ayah_id": 5369,
    "translation": "かれの頸動脈を必ず切るであろう"
  },
  {
    "surah_id": 69,
    "ayah_number": 47,
    "global_ayah_id": 5370,
    "translation": "あなたがたの中，誰一人，かれを守ってやれないのである。"
  },
  {
    "surah_id": 69,
    "ayah_number": 48,
    "global_ayah_id": 5371,
    "translation": "本当にこれは，主を畏れる者への訓戒である。"
  },
  {
    "surah_id": 69,
    "ayah_number": 49,
    "global_ayah_id": 5372,
    "translation": "われはあなたがたの中，（それを）拒否する者を知る。"
  },
  {
    "surah_id": 69,
    "ayah_number": 50,
    "global_ayah_id": 5373,
    "translation": "本当にこの（クルアーン）は，不信者にとっては悲しみ（の種）であろう。"
  },
  {
    "surah_id": 69,
    "ayah_number": 51,
    "global_ayah_id": 5374,
    "translation": "だがそれは，本当に確固たる不動の真理である。"
  },
  {
    "surah_id": 69,
    "ayah_number": 52,
    "global_ayah_id": 5375,
    "translation": "だから至大なる御方，あなたの主の御名を讃えなさい。"
  }
]