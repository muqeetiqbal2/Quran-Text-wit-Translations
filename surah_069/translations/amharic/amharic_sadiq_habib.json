[
  {
    "surah_id": 69,
    "ayah_number": 1,
    "global_ayah_id": 5324,
    "translation": "እውነትን አረጋጋጪቱ (ትንሣኤ)፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 2,
    "global_ayah_id": 5325,
    "translation": "አረጋጋጪቱም (እርሷ) ምንድን ናት!"
  },
  {
    "surah_id": 69,
    "ayah_number": 3,
    "global_ayah_id": 5326,
    "translation": "አረጋጋጪቱም ምን እንደኾነች ምን አሳወቀህ?"
  },
  {
    "surah_id": 69,
    "ayah_number": 4,
    "global_ayah_id": 5327,
    "translation": "ሰሙድና ዓድ በቆርቋሪይቱ (ትንሣኤ) አስተባበሉ፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 5,
    "global_ayah_id": 5328,
    "translation": "ሠሙድማ ወሰን በሌላት ጩኸት ተጠፋ፤ (ተወደሙ)፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 6,
    "global_ayah_id": 5329,
    "translation": "ዓድማ በኀይል በምትንሻሻ ብርቱ ነፋስ ተጠፉ፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 7,
    "global_ayah_id": 5330,
    "translation": "ተከታታይ በኾኑ ሰባት ሌሊቶችና ስምንት መዓልቶች ውስጥ በእነርሱ ላይ ለቀቃት፡፡ ሕዝቦቹንም፤ በውስጧ የተጣሉ ኾነው ልክ ክፍት የኾኑ የዘንባባ ግንዶች መስለው ታያቸዋለህ፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 8,
    "global_ayah_id": 5331,
    "translation": "ለእነርሱም ቀሪን ታያለህን?"
  },
  {
    "surah_id": 69,
    "ayah_number": 9,
    "global_ayah_id": 5332,
    "translation": "ፈርዖን ከበፊቱ የነበሩትም ሰዎች ተገልባጮቹም (ከተሞች) በኀጢአት (ሥራዎች) መጡ፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 10,
    "global_ayah_id": 5333,
    "translation": "የጌታቸውንም መልእክተኛ ትዕዛዝ ጣሱ፡፡ የበረታችንም አያያዝ ያዛቸው፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 11,
    "global_ayah_id": 5334,
    "translation": "እኛ ውሃው ባየለ ጊዜ በተንሻላይቱ ታንኳ ውስጥ ጫንናችሁ፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 12,
    "global_ayah_id": 5335,
    "translation": "ለእናንተ መገሰጫ ልናደርጋት አጥኒ የኾነችም ጆሮ ታጠናት ዘንድ፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 13,
    "global_ayah_id": 5336,
    "translation": "በቀንዱም አንዲት መንነፋት በተነፋች ጊዜ፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 14,
    "global_ayah_id": 5337,
    "translation": "ምድርና ጋራዎችም (ከስፍራቸው) በተነሱና አንዲትን መሰባበር በተሰባበሩ ጊዜ፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 15,
    "global_ayah_id": 5338,
    "translation": "በዚያ ቀን ኋኝቱ (ትንሣኤ) ትኾናለች፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 16,
    "global_ayah_id": 5339,
    "translation": "ሰማይም ትቀደዳለች፡፡ ስለዚህ እርሷ በዚያ ቀን ደካማ ናት፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 17,
    "global_ayah_id": 5340,
    "translation": "መላእክትም በየጫፎችዋ ላይ ይኾናሉ፡፡ የጌታህንም ዐርሽ በዚያ ቀን ስምንት መላእክት ከበላያቸው ይሸከማሉ፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 18,
    "global_ayah_id": 5341,
    "translation": "በዚያ ቀን ከእናንተ ተደባቂ (ነገሮች) የማይደበቁ ሲኾኑ ትቅቀረባላችሁ፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 19,
    "global_ayah_id": 5342,
    "translation": "መጽሐፉን በቀኙ የተሰጠ ሰውማ (ለጓደኞቹ) «እንኩ፤ መጽሐፌን አንብቡ» ይላል፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 20,
    "global_ayah_id": 5343,
    "translation": "«እኔ ምርመራየን የምገናኝ መኾኔን አረጋገጥኩ፤» (ተዘጋጀሁም ይላል)፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 21,
    "global_ayah_id": 5344,
    "translation": "እርሱም በተወደደች ኑሮ ውሰጥ ይኾናል፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 22,
    "global_ayah_id": 5345,
    "translation": "በከፍተኛይቱ ገነት ውስጥ፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 23,
    "global_ayah_id": 5346,
    "translation": "ፍሬዎችዋ ቅርቦች የኾኑ፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 24,
    "global_ayah_id": 5347,
    "translation": "በአለፉት ቀናት ውስጥ (በምድረ ዓለም) ባስቀደማችሁት ምክንያት ብሉ፤ ጠጡም፤ (ይባላሉ)፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 25,
    "global_ayah_id": 5348,
    "translation": "መጽሐፉንም በግራው የተሰጠማ «ዋ ጥፋቴ! ምነው መጽሐፌን ባልተሰጠሁ» ይላል፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 26,
    "global_ayah_id": 5349,
    "translation": "«ምርመራየንም ምን እንደኾነ ባላወቅኩ፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 27,
    "global_ayah_id": 5350,
    "translation": "«እርሷ (ሞት ሕይወቴን) ምነው ፈጻሚ በኾነች፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 28,
    "global_ayah_id": 5351,
    "translation": "«ገንዘቤ ከእኔ ምንንም አላብቃቃኝ፤ (አልጠቀመኝም)፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 29,
    "global_ayah_id": 5352,
    "translation": "«ኀይሌ ከእኔ ላይ ጠፋ» (ይላል)፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 30,
    "global_ayah_id": 5353,
    "translation": "«ያዙት፤ እሰሩትም፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 31,
    "global_ayah_id": 5354,
    "translation": "«ከዚያም በእሳት ውሰጥ አግቡት፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 32,
    "global_ayah_id": 5355,
    "translation": "«ከዚያም ርዝመቷ ሰባ ክንድ በኾነች ሰንሰለት ውስጥ አግቡት፡፡»"
  },
  {
    "surah_id": 69,
    "ayah_number": 33,
    "global_ayah_id": 5356,
    "translation": "እርሱ ታላቅ በኾነው አላህ አያምንም ነበርና፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 34,
    "global_ayah_id": 5357,
    "translation": "ድኾችንም በማብላት ላይ አያግባባም ነበርና፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 35,
    "global_ayah_id": 5358,
    "translation": "ለእርሱም ዛሬ እዚህ ዘመድ የለውም፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 36,
    "global_ayah_id": 5359,
    "translation": "ምግብም ከእሳት ሰዎች ቁስል እጣቢ (እዥ) በስተቀር የለውም፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 37,
    "global_ayah_id": 5360,
    "translation": "ኀጢኣተኞች እንጅ ሌላ አይበላውም፤ (ይባላል)፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 38,
    "global_ayah_id": 5361,
    "translation": "በምታዩትም ነገር እምላለሁ፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 39,
    "global_ayah_id": 5362,
    "translation": "በማታዩትም ነገር፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 40,
    "global_ayah_id": 5363,
    "translation": "እርሱ (ቁርኣን) የተከበረ መልክተኛ ቃል ነው፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 41,
    "global_ayah_id": 5364,
    "translation": "እርሱም የባለቅኔ ቃል (ግጥም) አይደለም፡፡ ጥቂትን ብቻ ታምናላችሁ፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 42,
    "global_ayah_id": 5365,
    "translation": "የጠንቋይም ቃል አይደለም፡፡ ጥቂትን ብቻ ታስታውሳላችሁ፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 43,
    "global_ayah_id": 5366,
    "translation": "ከዓለማት ጌታ የተወረደ ነው፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 44,
    "global_ayah_id": 5367,
    "translation": "በእኛ ላይም ከፊልን ቃላት (ያላልነውን) በቀጠፈ ኖሮ፤"
  },
  {
    "surah_id": 69,
    "ayah_number": 45,
    "global_ayah_id": 5368,
    "translation": "በኀይል በያዝነው ነበር፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 46,
    "global_ayah_id": 5369,
    "translation": "ከዚያም ከእርሱ የልቡን ሥር (የተንጠለጠለበትን ጅማት) በቆረጥን ነበር፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 47,
    "global_ayah_id": 5370,
    "translation": "ከእናንተም ውስጥ ከእርሱ ላይ ከልካዮች ምንም አይኖሩም፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 48,
    "global_ayah_id": 5371,
    "translation": "እርሱም (ቁርኣን) ለጥንቁቆቹ መገሠጫ ነው፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 49,
    "global_ayah_id": 5372,
    "translation": "እኛም ከእናንተ ውስጥ አስተባባዮች መኖራቸውን በእርግጥ እናውቃለን፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 50,
    "global_ayah_id": 5373,
    "translation": "እርሱም (ቁርኣን) በከሓዲዎቹ ላይ ጸጸት ነው፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 51,
    "global_ayah_id": 5374,
    "translation": "እርሱም የተረጋገጠ እውነት ነው፡፡"
  },
  {
    "surah_id": 69,
    "ayah_number": 52,
    "global_ayah_id": 5375,
    "translation": "የታላቁን ጌታህንም ስም አወድስ፡፡"
  }
]