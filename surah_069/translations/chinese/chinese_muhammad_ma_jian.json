[
  {
    "surah_id": 69,
    "ayah_number": 1,
    "global_ayah_id": 5324,
    "translation": "真災，"
  },
  {
    "surah_id": 69,
    "ayah_number": 2,
    "global_ayah_id": 5325,
    "translation": "真災是什麼？"
  },
  {
    "surah_id": 69,
    "ayah_number": 3,
    "global_ayah_id": 5326,
    "translation": "你怎麼能認識真災是什麼呢？"
  },
  {
    "surah_id": 69,
    "ayah_number": 4,
    "global_ayah_id": 5327,
    "translation": "賽莫德人和阿德人，曾否認大難。"
  },
  {
    "surah_id": 69,
    "ayah_number": 5,
    "global_ayah_id": 5328,
    "translation": "至於賽莫德人呢，已為嚴刑所毀滅；"
  },
  {
    "surah_id": 69,
    "ayah_number": 6,
    "global_ayah_id": 5329,
    "translation": "至於阿德人，已為怒吼的暴風所毀滅。"
  },
  {
    "surah_id": 69,
    "ayah_number": 7,
    "global_ayah_id": 5330,
    "translation": "真主曾使暴風對著他們連刮了七夜八晝，你看阿德人倒仆在地上，好像空心的海棗樹幹一樣。"
  },
  {
    "surah_id": 69,
    "ayah_number": 8,
    "global_ayah_id": 5331,
    "translation": "你能看見他們還有孑遺嗎？"
  },
  {
    "surah_id": 69,
    "ayah_number": 9,
    "global_ayah_id": 5332,
    "translation": "法老和在他之前的人，以及被傾覆的城市的居民，又再犯罪，"
  },
  {
    "surah_id": 69,
    "ayah_number": 10,
    "global_ayah_id": 5333,
    "translation": "他們曾違抗他們的主的使者，故他嚴厲懲治了他們。"
  },
  {
    "surah_id": 69,
    "ayah_number": 11,
    "global_ayah_id": 5334,
    "translation": "當大水泛濫的時候，我讓你們乘船，"
  },
  {
    "surah_id": 69,
    "ayah_number": 12,
    "global_ayah_id": 5335,
    "translation": "以便我以那件事為你們的教訓，以便能記憶的耳朵把它記住。"
  },
  {
    "surah_id": 69,
    "ayah_number": 13,
    "global_ayah_id": 5336,
    "translation": "當號角一嚮，"
  },
  {
    "surah_id": 69,
    "ayah_number": 14,
    "global_ayah_id": 5337,
    "translation": "大地和山岳都被移動，且互相碰撞一次的時候；"
  },
  {
    "surah_id": 69,
    "ayah_number": 15,
    "global_ayah_id": 5338,
    "translation": "在那日，那件大事將發生，"
  },
  {
    "surah_id": 69,
    "ayah_number": 16,
    "global_ayah_id": 5339,
    "translation": "天將破裂；在那日，天將成為脆弱的。"
  },
  {
    "surah_id": 69,
    "ayah_number": 17,
    "global_ayah_id": 5340,
    "translation": "眾天神將在天的各方；在那日，在他們上面，將有八個天神，擔負你的主的寶座；"
  },
  {
    "surah_id": 69,
    "ayah_number": 18,
    "global_ayah_id": 5341,
    "translation": "在那日，你們將被檢閱，你們的任何秘密，都無法隱藏。"
  },
  {
    "surah_id": 69,
    "ayah_number": 19,
    "global_ayah_id": 5342,
    "translation": "用右手接受自己的功過簿的人將說：「你們拿我的功過簿去讀讀吧！"
  },
  {
    "surah_id": 69,
    "ayah_number": 20,
    "global_ayah_id": 5343,
    "translation": "我確已猜想到我必遇見我的賬目。」"
  },
  {
    "surah_id": 69,
    "ayah_number": 21,
    "global_ayah_id": 5344,
    "translation": "他將在愉快的生活裡，"
  },
  {
    "surah_id": 69,
    "ayah_number": 22,
    "global_ayah_id": 5345,
    "translation": "在崇高的樂園裡，"
  },
  {
    "surah_id": 69,
    "ayah_number": 23,
    "global_ayah_id": 5346,
    "translation": "那裡面的水果伸手可得。"
  },
  {
    "surah_id": 69,
    "ayah_number": 24,
    "global_ayah_id": 5347,
    "translation": "「你們可以愉快地飲食，因為你們在過去的歲月中行過善。」"
  },
  {
    "surah_id": 69,
    "ayah_number": 25,
    "global_ayah_id": 5348,
    "translation": "以左手接過自己的功過簿的人將說：「啊呀！但願我沒有接過我的功過簿，"
  },
  {
    "surah_id": 69,
    "ayah_number": 26,
    "global_ayah_id": 5349,
    "translation": "不知道我自己的賬目！"
  },
  {
    "surah_id": 69,
    "ayah_number": 27,
    "global_ayah_id": 5350,
    "translation": "但願塵世的死亡已了結我的一生！"
  },
  {
    "surah_id": 69,
    "ayah_number": 28,
    "global_ayah_id": 5351,
    "translation": "我的財產於我毫無裨益，"
  },
  {
    "surah_id": 69,
    "ayah_number": 29,
    "global_ayah_id": 5352,
    "translation": "我的權柄已從我的手中消失。」"
  },
  {
    "surah_id": 69,
    "ayah_number": 30,
    "global_ayah_id": 5353,
    "translation": "「你們捉住他，給他帶上枷鎖，"
  },
  {
    "surah_id": 69,
    "ayah_number": 31,
    "global_ayah_id": 5354,
    "translation": "然後把他投在烈火裡，"
  },
  {
    "surah_id": 69,
    "ayah_number": 32,
    "global_ayah_id": 5355,
    "translation": "然後把他穿在一條七十臂長的鏈子上。」"
  },
  {
    "surah_id": 69,
    "ayah_number": 33,
    "global_ayah_id": 5356,
    "translation": "他生前確是不信仰尊大的真主，"
  },
  {
    "surah_id": 69,
    "ayah_number": 34,
    "global_ayah_id": 5357,
    "translation": "不勉勵人賬濟貪民；"
  },
  {
    "surah_id": 69,
    "ayah_number": 35,
    "global_ayah_id": 5358,
    "translation": "故今日他在這裡沒有一個親戚。"
  },
  {
    "surah_id": 69,
    "ayah_number": 36,
    "global_ayah_id": 5359,
    "translation": "除膿汁外，他沒有食物。"
  },
  {
    "surah_id": 69,
    "ayah_number": 37,
    "global_ayah_id": 5360,
    "translation": "只有迷誤的人們才吃膿汁。"
  },
  {
    "surah_id": 69,
    "ayah_number": 38,
    "global_ayah_id": 5361,
    "translation": "不然！我以你們所能見的萬象盟誓，"
  },
  {
    "surah_id": 69,
    "ayah_number": 39,
    "global_ayah_id": 5362,
    "translation": "並且以你們不能見的幽玄盟誓，"
  },
  {
    "surah_id": 69,
    "ayah_number": 40,
    "global_ayah_id": 5363,
    "translation": "這確是尊貴的使者的言辭；"
  },
  {
    "surah_id": 69,
    "ayah_number": 41,
    "global_ayah_id": 5364,
    "translation": "並不是詩人的言辭，你們很少信仰，"
  },
  {
    "surah_id": 69,
    "ayah_number": 42,
    "global_ayah_id": 5365,
    "translation": "也不是僕人的言辭，你們很少覺悟。"
  },
  {
    "surah_id": 69,
    "ayah_number": 43,
    "global_ayah_id": 5366,
    "translation": "這是從全世界的主降示的。"
  },
  {
    "surah_id": 69,
    "ayah_number": 44,
    "global_ayah_id": 5367,
    "translation": "假若他假借我的名義，捏造謠言，"
  },
  {
    "surah_id": 69,
    "ayah_number": 45,
    "global_ayah_id": 5368,
    "translation": "我必以權力逮捕他，"
  },
  {
    "surah_id": 69,
    "ayah_number": 46,
    "global_ayah_id": 5369,
    "translation": "然後必割斷他的大動脈，"
  },
  {
    "surah_id": 69,
    "ayah_number": 47,
    "global_ayah_id": 5370,
    "translation": "你們中沒有一個人能保衛他。"
  },
  {
    "surah_id": 69,
    "ayah_number": 48,
    "global_ayah_id": 5371,
    "translation": "這確是對敬畏者的教訓。"
  },
  {
    "surah_id": 69,
    "ayah_number": 49,
    "global_ayah_id": 5372,
    "translation": "我的確知道你們中有否認的人。"
  },
  {
    "surah_id": 69,
    "ayah_number": 50,
    "global_ayah_id": 5373,
    "translation": "這對於不信道的人們確是悔恨。"
  },
  {
    "surah_id": 69,
    "ayah_number": 51,
    "global_ayah_id": 5374,
    "translation": "這確是真實的信念，"
  },
  {
    "surah_id": 69,
    "ayah_number": 52,
    "global_ayah_id": 5375,
    "translation": "故你當頌揚你的主的大名。"
  }
]