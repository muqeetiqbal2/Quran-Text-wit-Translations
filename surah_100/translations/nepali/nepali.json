[
  {
    "surah_id": 100,
    "ayah_number": 0,
    "global_ayah_id": 6245,
    "translation": "शुरु अत्यन्त करुणामय, परम दयालु अल्लाहको नामबाट ।"
  },
  {
    "surah_id": 100,
    "ayah_number": 1,
    "global_ayah_id": 6246,
    "translation": "कसम हस्याङ्फस्याङ् गर्दै दौड्ने ती घोडाहरूको"
  },
  {
    "surah_id": 100,
    "ayah_number": 2,
    "global_ayah_id": 6247,
    "translation": "जो खुरबाट अग्निका झिल्काहरू निकाल्छन"
  },
  {
    "surah_id": 100,
    "ayah_number": 3,
    "global_ayah_id": 6248,
    "translation": "र एका बिहानै छापा मार्छन्"
  },
  {
    "surah_id": 100,
    "ayah_number": 4,
    "global_ayah_id": 6249,
    "translation": "र त्यहाँ धूलो उडाउँछन् ।"
  },
  {
    "surah_id": 100,
    "ayah_number": 5,
    "global_ayah_id": 6250,
    "translation": "अनि शत्रुका सैन्य–दलभित्र पस्छन् ।"
  },
  {
    "surah_id": 100,
    "ayah_number": 6,
    "global_ayah_id": 6251,
    "translation": "निश्चय नै मनुष्य आफ्ना पालनकर्ताप्रति कृतघ्न रहेको छ ।"
  },
  {
    "surah_id": 100,
    "ayah_number": 7,
    "global_ayah_id": 6252,
    "translation": "र, ऊ स्वयं यसको साक्षी हो ।"
  },
  {
    "surah_id": 100,
    "ayah_number": 8,
    "global_ayah_id": 6253,
    "translation": "ऊ सम्पत्तिको मोहमा धेरै नै लिप्त छ ।"
  },
  {
    "surah_id": 100,
    "ayah_number": 9,
    "global_ayah_id": 6254,
    "translation": "के उसलाई थाहा छैन जब चिहानबाट सबै निकालिनेछन् ?"
  },
  {
    "surah_id": 100,
    "ayah_number": 10,
    "global_ayah_id": 6255,
    "translation": "र, छातीभित्र जे छ त्यो पनि बाहिर नकालिनेछ ।"
  },
  {
    "surah_id": 100,
    "ayah_number": 11,
    "global_ayah_id": 6256,
    "translation": "निश्चय नै उनीहरूका रब त्यस दिन उनीहरूको अवस्थासँग पूर्ण अवगत रहनेछन् ।"
  }
]