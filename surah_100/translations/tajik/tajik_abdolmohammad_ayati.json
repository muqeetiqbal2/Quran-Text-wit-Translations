[
  {
    "surah_id": 100,
    "ayah_number": 1,
    "global_ayah_id": 6147,
    "translation": "Савганд ба аспони тездав,"
  },
  {
    "surah_id": 100,
    "ayah_number": 2,
    "global_ayah_id": 6148,
    "translation": "савганд ба аспоне, ки ба сум аз санг оташ меҷаҳонанд"
  },
  {
    "surah_id": 100,
    "ayah_number": 3,
    "global_ayah_id": 6149,
    "translation": "ва савганд ба аспоне, ки бомдодон ҳуҷум оваранд"
  },
  {
    "surah_id": 100,
    "ayah_number": 4,
    "global_ayah_id": 6150,
    "translation": "ва дар он ҷо ғубор бархезонанд"
  },
  {
    "surah_id": 100,
    "ayah_number": 5,
    "global_ayah_id": 6151,
    "translation": "ва дар он ҷо дар миён дароянд,"
  },
  {
    "surah_id": 100,
    "ayah_number": 6,
    "global_ayah_id": 6152,
    "translation": "ки одамӣ Парвардигори худро шукр намегӯяд"
  },
  {
    "surah_id": 100,
    "ayah_number": 7,
    "global_ayah_id": 6153,
    "translation": "ва ӯ худ бар ин гувоҳ аст."
  },
  {
    "surah_id": 100,
    "ayah_number": 8,
    "global_ayah_id": 6154,
    "translation": "Ӯ молро сахт дӯст дорад."
  },
  {
    "surah_id": 100,
    "ayah_number": 9,
    "global_ayah_id": 6155,
    "translation": "Оё намедонад, ки чун он чӣ дар гӯрҳост, зинда гардад,"
  },
  {
    "surah_id": 100,
    "ayah_number": 10,
    "global_ayah_id": 6156,
    "translation": "ва он чӣ дар дилҳо ниҳон аст, ошкор шавад,"
  },
  {
    "surah_id": 100,
    "ayah_number": 11,
    "global_ayah_id": 6157,
    "translation": "Парвардигорашон дар он рӯз аз ҳолашон огоҳ аст."
  }
]