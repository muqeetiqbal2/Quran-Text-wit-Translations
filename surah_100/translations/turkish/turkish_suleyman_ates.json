[
  {
    "surah_id": 100,
    "ayah_number": 1,
    "global_ayah_id": 6147,
    "translation": "Andolsun nefesleriyle (güp güp) ses çıkararak koşan(at)lara,"
  },
  {
    "surah_id": 100,
    "ayah_number": 2,
    "global_ayah_id": 6148,
    "translation": "(Tırnaklariyle yerden) Ateş çıkaranlara,"
  },
  {
    "surah_id": 100,
    "ayah_number": 3,
    "global_ayah_id": 6149,
    "translation": "Sabahleyin akın edenlere,"
  },
  {
    "surah_id": 100,
    "ayah_number": 4,
    "global_ayah_id": 6150,
    "translation": "(Koşarak) Toz koparanlara,"
  },
  {
    "surah_id": 100,
    "ayah_number": 5,
    "global_ayah_id": 6151,
    "translation": "Derken bir topluluğun ortasına dalanlara."
  },
  {
    "surah_id": 100,
    "ayah_number": 6,
    "global_ayah_id": 6152,
    "translation": "(Bunlara andolsun) Ki insan, Rabbine karşı çok nankördür."
  },
  {
    "surah_id": 100,
    "ayah_number": 7,
    "global_ayah_id": 6153,
    "translation": "Ve o da buna şahiddir."
  },
  {
    "surah_id": 100,
    "ayah_number": 8,
    "global_ayah_id": 6154,
    "translation": "Doğrusu o, malı çok sever."
  },
  {
    "surah_id": 100,
    "ayah_number": 9,
    "global_ayah_id": 6155,
    "translation": "Bilmez mi o, kabirlerde olanlar dışarı atıldığı,"
  },
  {
    "surah_id": 100,
    "ayah_number": 10,
    "global_ayah_id": 6156,
    "translation": "Göğüslerde bulunanlar devşirildiği zaman,"
  },
  {
    "surah_id": 100,
    "ayah_number": 11,
    "global_ayah_id": 6157,
    "translation": "O gün Rabbleri onların her halini haber almış(gizli ve açık bütün yaptıklarını bilmiş)tir."
  }
]