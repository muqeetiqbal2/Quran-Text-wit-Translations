[
  {
    "surah_id": 100,
    "ayah_number": 1,
    "global_ayah_id": 6147,
    "translation": "Harıl harıl koşanlara,"
  },
  {
    "surah_id": 100,
    "ayah_number": 2,
    "global_ayah_id": 6148,
    "translation": "(Nallarıyla) çakarak kıvılcım saçanlara,"
  },
  {
    "surah_id": 100,
    "ayah_number": 3,
    "global_ayah_id": 6149,
    "translation": "(Ansızın) sabah baskını yapanlara,"
  },
  {
    "surah_id": 100,
    "ayah_number": 4,
    "global_ayah_id": 6150,
    "translation": "Orada tozu dumana katanlara,"
  },
  {
    "surah_id": 100,
    "ayah_number": 5,
    "global_ayah_id": 6151,
    "translation": "Derken orada bir topluluğun ta ortasına girenlere yemin ederim ki,"
  },
  {
    "surah_id": 100,
    "ayah_number": 6,
    "global_ayah_id": 6152,
    "translation": "Şüphesiz insan, Rabbine karşı pek nankördür."
  },
  {
    "surah_id": 100,
    "ayah_number": 7,
    "global_ayah_id": 6153,
    "translation": "Şüphesiz buna kendisi de şahittir,"
  },
  {
    "surah_id": 100,
    "ayah_number": 8,
    "global_ayah_id": 6154,
    "translation": "Ve o, mal sevgisine de aşırı derecede düşkündür."
  },
  {
    "surah_id": 100,
    "ayah_number": 9,
    "global_ayah_id": 6155,
    "translation": "Kabirlerde bulunanların diriltilip dışarı atıldığını düşünmez mi?"
  },
  {
    "surah_id": 100,
    "ayah_number": 10,
    "global_ayah_id": 6156,
    "translation": "Ve kalplerde gizlenenler ortaya konduğu zaman,"
  },
  {
    "surah_id": 100,
    "ayah_number": 11,
    "global_ayah_id": 6157,
    "translation": "Şüphesiz Rableri o gün onlardan tamamıyle haberdar"
  }
]