    "translation": "Na galopujące, zadyszane,"
  },
  {
    "surah_id": 100,
    "ayah_number": 2,
    "global_ayah_id": 6148,
    "translation": "Krzeszące iskry ognia,."
  },
  {
    "surah_id": 100,
    "ayah_number": 3,
    "global_ayah_id": 6149,
    "translation": "Które ruszają do ataku rankiem,"
  },
  {
    "surah_id": 100,
    "ayah_number": 4,
    "global_ayah_id": 6150,
    "translation": "Wzbijając tuman kurzu,"
  },
  {
    "surah_id": 100,
    "ayah_number": 5,
    "global_ayah_id": 6151,
    "translation": "I wdzierają się w sam środek gromadnie!"
  },
  {
    "surah_id": 100,
    "ayah_number": 6,
    "global_ayah_id": 6152,
    "translation": "Zaprawdę, człowiek jest niewdzięczny względem swego Pana!"
  },
  {
    "surah_id": 100,
    "ayah_number": 7,
    "global_ayah_id": 6153,
    "translation": "I, zaprawdę, on sam jest tego świadkiem!"
  },
  {
    "surah_id": 100,
    "ayah_number": 8,
    "global_ayah_id": 6154,
    "translation": "Zaprawdę, jego miłość do dóbr jest ogromna!"
  },
  {
    "surah_id": 100,
    "ayah_number": 9,
    "global_ayah_id": 6155,
    "translation": "Czyż on nie wie, że kiedy zostanie wywrócone to, co jest w grobach,"
  },
  {
    "surah_id": 100,
    "ayah_number": 10,
    "global_ayah_id": 6156,
    "translation": "I kiedy zostanie wydobyte na jaw to, co jest w piersiach"
  },
  {
    "surah_id": 100,
    "ayah_number": 11,
    "global_ayah_id": 6157,
    "translation": "- zaprawdę, tego Dnia, ich Pan będzie o nich doskonale powiadomiony!"
