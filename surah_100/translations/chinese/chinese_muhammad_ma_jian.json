  },
  {
    "surah_id": 100,
    "ayah_number": 3,
    "global_ayah_id": 6149,
    "translation": "以早晨出擊,"
  },
  {
    "surah_id": 100,
    "ayah_number": 4,
    "global_ayah_id": 6150,
    "translation": "捲起塵埃,"
  },
  {
    "surah_id": 100,
    "ayah_number": 5,
    "global_ayah_id": 6151,
    "translation": "攻入敵圍的馬隊盟誓,"
  },
  {
    "surah_id": 100,
    "ayah_number": 6,
    "global_ayah_id": 6152,
    "translation": "人對于主, 確是孤負的。"
  },
  {
    "surah_id": 100,
    "ayah_number": 7,
    "global_ayah_id": 6153,
    "translation": "他自己對那孤負確是見証的,"
  },
  {
    "surah_id": 100,
    "ayah_number": 8,
    "global_ayah_id": 6154,
    "translation": "他對于財產確是酷好的。"
  },
  {
    "surah_id": 100,
    "ayah_number": 9,
    "global_ayah_id": 6155,
    "translation": "難道他不知道嗎？當墳中的朽骨被揭發,"
  },
  {
    "surah_id": 100,
    "ayah_number": 10,
    "global_ayah_id": 6156,
    "translation": "胸中的秘密被顯示的時侯,"
  },
  {
    "surah_id": 100,
    "ayah_number": 11,
    "global_ayah_id": 6157,
    "translation": "在那日, 他們的主, 確是徹知他們的。"
  }
