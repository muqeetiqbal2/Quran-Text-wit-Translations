[
  {
    "surah_id": 100,
    "ayah_number": 1,
    "global_ayah_id": 6147,
    "translation": "ভাবো ঊর্ধ্বশ্বাসে ধাবমানদের কথা,"
  },
  {
    "surah_id": 100,
    "ayah_number": 2,
    "global_ayah_id": 6148,
    "translation": "ফলে যারা আগুনের ফুলকি ছোড়ে আঘাতের ছোটে,"
  },
  {
    "surah_id": 100,
    "ayah_number": 3,
    "global_ayah_id": 6149,
    "translation": "আর যারা ভোরে অভিযান চালায়,"
  },
  {
    "surah_id": 100,
    "ayah_number": 4,
    "global_ayah_id": 6150,
    "translation": "আর তার ফলে যারা ধূলো উড়ায় --"
  },
  {
    "surah_id": 100,
    "ayah_number": 5,
    "global_ayah_id": 6151,
    "translation": "তখন এর ফলে সৈন্যদলকে ভেদ করে যায়।"
  },
  {
    "surah_id": 100,
    "ayah_number": 6,
    "global_ayah_id": 6152,
    "translation": "মানুষ নিশ্চয়ই তার প্রভুর প্রতি বড় অকৃতজ্ঞ,"
  },
  {
    "surah_id": 100,
    "ayah_number": 7,
    "global_ayah_id": 6153,
    "translation": "আর সে আলবৎ এ বিষয়ে অবশ্য প্রত্যক্ষদশ।"
  },
  {
    "surah_id": 100,
    "ayah_number": 8,
    "global_ayah_id": 6154,
    "translation": "আর নিঃসন্দেহ সে ধনসম্পদের মোহে দুরন্ত।"
  },
  {
    "surah_id": 100,
    "ayah_number": 9,
    "global_ayah_id": 6155,
    "translation": "তবে কি সে জানে না যখন কবরগুলোয় যা আছে তা তোলা হবে,"
  },
  {
    "surah_id": 100,
    "ayah_number": 10,
    "global_ayah_id": 6156,
    "translation": "এবং অন্তরে যা আছে তা প্রকাশ করা হবে?"
  },
  {
    "surah_id": 100,
    "ayah_number": 11,
    "global_ayah_id": 6157,
    "translation": "নিঃসন্দেহ তাদের প্রভু সেইদিন তাদের সন্বন্ধে সবিশেষে অবহিত থাকবেন।"
  }
]