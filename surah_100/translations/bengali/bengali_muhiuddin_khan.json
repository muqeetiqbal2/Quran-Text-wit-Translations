[
  {
    "surah_id": 100,
    "ayah_number": 1,
    "global_ayah_id": 6147,
    "translation": "শপথ উর্ধ্বশ্বাসে চলমান অশ্বসমূহের,"
  },
  {
    "surah_id": 100,
    "ayah_number": 2,
    "global_ayah_id": 6148,
    "translation": "অতঃপর ক্ষুরাঘাতে অগ্নিবিচ্ছুরক অশ্বসমূহের"
  },
  {
    "surah_id": 100,
    "ayah_number": 3,
    "global_ayah_id": 6149,
    "translation": "অতঃপর প্রভাতকালে আক্রমণকারী অশ্বসমূহের"
  },
  {
    "surah_id": 100,
    "ayah_number": 4,
    "global_ayah_id": 6150,
    "translation": "ও যারা সে সময়ে ধুলি উৎক্ষিপ্ত করে"
  },
  {
    "surah_id": 100,
    "ayah_number": 5,
    "global_ayah_id": 6151,
    "translation": "অতঃপর যারা শক্রদলের অভ্যন্তরে ঢুকে পড়ে-"
  },
  {
    "surah_id": 100,
    "ayah_number": 6,
    "global_ayah_id": 6152,
    "translation": "নিশ্চয় মানুষ তার পালনকর্তার প্রতি অকৃতজ্ঞ।"
  },
  {
    "surah_id": 100,
    "ayah_number": 7,
    "global_ayah_id": 6153,
    "translation": "এবং সে অবশ্য এ বিষয়ে অবহিত"
  },
  {
    "surah_id": 100,
    "ayah_number": 8,
    "global_ayah_id": 6154,
    "translation": "এবং সে নিশ্চিতই ধন-সম্পদের ভালবাসায় মত্ত।"
  },
  {
    "surah_id": 100,
    "ayah_number": 9,
    "global_ayah_id": 6155,
    "translation": "সে কি জানে না, যখন কবরে যা আছে, তা উত্থিত হবে"
  },
  {
    "surah_id": 100,
    "ayah_number": 10,
    "global_ayah_id": 6156,
    "translation": "এবং অন্তরে যা আছে, তা অর্জন করা হবে?"
  },
  {
    "surah_id": 100,
    "ayah_number": 11,
    "global_ayah_id": 6157,
    "translation": "সেদিন তাদের কি হবে, সে সম্পর্কে তাদের পালনকর্তা সবিশেষ জ্ঞাত।"
  }
]