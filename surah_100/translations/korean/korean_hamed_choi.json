    "ayah_number": 1,
    "global_ayah_id": 6147,
    "translation": "질주하는 말을 두고 맹세하사"
  },
  {
    "surah_id": 100,
    "ayah_number": 2,
    "global_ayah_id": 6148,
    "translation": "불꽃을 튀기는 말을 두고 맹 세하며"
  },
  {
    "surah_id": 100,
    "ayah_number": 3,
    "global_ayah_id": 6149,
    "translation": "새벽에 공격하는 말을 두고 맹세하나니"
  },
  {
    "surah_id": 100,
    "ayah_number": 4,
    "global_ayah_id": 6150,
    "translation": "먼지를 일으키며"
  },
  {
    "surah_id": 100,
    "ayah_number": 5,
    "global_ayah_id": 6151,
    "translation": "적 깊숙이 돌진하는 말을 두고맹세하사"
  },
  {
    "surah_id": 100,
    "ayah_number": 6,
    "global_ayah_id": 6152,
    "translation": "실로 인간은 주님께 감사할 줄 모르더라"
  },
  {
    "surah_id": 100,
    "ayah_number": 7,
    "global_ayah_id": 6153,
    "translation": "인간은 그가 행한 것을 증언 할 것이매"
  },
  {
    "surah_id": 100,
    "ayah_number": 8,
    "global_ayah_id": 6154,
    "translation": "재물에 탐익하는데만 열중하 노라"
  },
  {
    "surah_id": 100,
    "ayah_number": 9,
    "global_ayah_id": 6155,
    "translation": "무덤속에 있는 것들이 밖으로 나와 산산히 흩어지고"
  },
  {
    "surah_id": 100,
    "ayah_number": 10,
    "global_ayah_id": 6156,
    "translation": "그의 심중에 있는 것들이 밝 혀지며"
  },
  {
    "surah_id": 100,
    "ayah_number": 11,
    "global_ayah_id": 6157,
    "translation": "그날 주님께서 그것들을 아 심으로 충만하다는 것을 인간은 알지 못하느뇨"
  }
]