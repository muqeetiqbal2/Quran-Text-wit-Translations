[
  {
    "surah_id": 100,
    "ayah_number": 1,
    "global_ayah_id": 6147,
    "translation": "Кълна се в [конете -] препускащите с пръхтене"
  },
  {
    "surah_id": 100,
    "ayah_number": 2,
    "global_ayah_id": 6148,
    "translation": "и мятащите искри с чаткане,"
  },
  {
    "surah_id": 100,
    "ayah_number": 3,
    "global_ayah_id": 6149,
    "translation": "и връхлитащите сутрин,"
  },
  {
    "surah_id": 100,
    "ayah_number": 4,
    "global_ayah_id": 6150,
    "translation": "и вдигащи с това прахоляк,"
  },
  {
    "surah_id": 100,
    "ayah_number": 5,
    "global_ayah_id": 6151,
    "translation": "и врязващи се в множество [от врагове]"
  },
  {
    "surah_id": 100,
    "ayah_number": 6,
    "global_ayah_id": 6152,
    "translation": "човекът е голям неблагодарник към своя Господ."
  },
  {
    "surah_id": 100,
    "ayah_number": 7,
    "global_ayah_id": 6153,
    "translation": "И сам на това е свидетел."
  },
  {
    "surah_id": 100,
    "ayah_number": 8,
    "global_ayah_id": 6154,
    "translation": "И е силна любовта му към благата."
  },
  {
    "surah_id": 100,
    "ayah_number": 9,
    "global_ayah_id": 6155,
    "translation": "Нима не знае, че когато бъде изкарано това, което е в гробовете,"
  },
  {
    "surah_id": 100,
    "ayah_number": 10,
    "global_ayah_id": 6156,
    "translation": "и бъде разкрито това, което е в гърдите,"
  },
  {
    "surah_id": 100,
    "ayah_number": 11,
    "global_ayah_id": 6157,
    "translation": "техният Господ е сведущ за тях в този Ден?"
  }
]