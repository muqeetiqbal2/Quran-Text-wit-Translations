  {
    "surah_id": 100,
    "ayah_number": 1,
    "global_ayah_id": 6147,
    "translation": "साक्षी है जो हाँफते-फुँकार मारते हुए दौड़ते है,"
  },
  {
    "surah_id": 100,
    "ayah_number": 2,
