[
  {
    "surah_id": 100,
    "ayah_number": 0,
    "global_ayah_id": 6245,
    "translation": "अल्लाह के नाम से जो बड़ा कृपालु और अत्यन्त दयावान है।"
  },
  {
    "surah_id": 100,
    "ayah_number": 1,
    "global_ayah_id": 6246,
    "translation": "साक्षी है जो हाँफते-फुँकार मारते हुए दौड़ते हैं,"
  },
  {
    "surah_id": 100,
    "ayah_number": 2,
    "global_ayah_id": 6247,
    "translation": "फिर ठोकरों से चिनगारियाँ निकालते हैं,"
  },
  {
    "surah_id": 100,
    "ayah_number": 3,
    "global_ayah_id": 6248,
    "translation": "फिर सुबह सवेरे धावा मारते होते हैं,"
  },
  {
    "surah_id": 100,
    "ayah_number": 4,
    "global_ayah_id": 6249,
    "translation": "उस में उठाया उन्होंने गर्द-गुबार"
  },
  {
    "surah_id": 100,
    "ayah_number": 5,
    "global_ayah_id": 6250,
    "translation": "और इसी हाल में वे दल में जा घुसे"
  },
  {
    "surah_id": 100,
    "ayah_number": 6,
    "global_ayah_id": 6251,
    "translation": "निस्संदेह मनुष्य अपने रब का बड़ा अकृतज्ञ है,"
  },
  {
    "surah_id": 100,
    "ayah_number": 7,
    "global_ayah_id": 6252,
    "translation": "और निश्चय ही वह स्वयं इस पर गवाह है!"
  },
  {
    "surah_id": 100,
    "ayah_number": 8,
    "global_ayah_id": 6253,
    "translation": "और निश्चय ही वह धन के मोह में बड़ा दृढ़ है"
  },
  {
    "surah_id": 100,
    "ayah_number": 9,
    "global_ayah_id": 6254,
    "translation": "तो क्या वह जानता नहीं जब उगलवा लिया जाएगा जो क़ब्रों में है"
  },
  {
    "surah_id": 100,
    "ayah_number": 10,
    "global_ayah_id": 6255,
    "translation": "और स्पष्ट अनावृत्त कर दिया जाएगा जो कुछ सीनों में है"
  },
  {
    "surah_id": 100,
    "ayah_number": 11,
    "global_ayah_id": 6256,
    "translation": "निस्संदेह उन का रब उस दिन उन की पूरी ख़बर रखता होगा"
  }
]