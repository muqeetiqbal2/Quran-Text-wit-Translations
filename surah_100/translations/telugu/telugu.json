[
  {
    "surah_id": 100,
    "ayah_number": 0,
    "global_ayah_id": 6245,
    "translation": "అనంత కరుణామయుడు అపార కరుణాప్రదాత అయిన అల్లాహ్‌ పేరుతో"
  },
  {
    "surah_id": 100,
    "ayah_number": 1,
    "global_ayah_id": 6246,
    "translation": "వగర్చుతూ పరిగెత్తే గుర్రాల సాక్షిగా!"
  },
  {
    "surah_id": 100,
    "ayah_number": 2,
    "global_ayah_id": 6247,
    "translation": "తమ ఖురాల తట్టులతో అగ్నికణాలు లేపేవాటి"
  },
  {
    "surah_id": 100,
    "ayah_number": 3,
    "global_ayah_id": 6248,
    "translation": "తెల్లవారుఝామున దాడిచేసే వాటి"
  },
  {
    "surah_id": 100,
    "ayah_number": 4,
    "global_ayah_id": 6249,
    "translation": "(మేఘాల వంటి) దుమ్ము లేపుతూ"
  },
  {
    "surah_id": 100,
    "ayah_number": 5,
    "global_ayah_id": 6250,
    "translation": "(శత్రువుల) సమూహంలోకి దూరిపోయే వాటి."
  },
  {
    "surah_id": 100,
    "ayah_number": 6,
    "global_ayah_id": 6251,
    "translation": "నిశ్చయంగా, మానవుడు తన ప్రభువు పట్ల ఎంతో కృతఘ్నుడు."
  },
  {
    "surah_id": 100,
    "ayah_number": 7,
    "global_ayah_id": 6252,
    "translation": "మరియు నిశ్చయంగా, దీనికి స్వయంగా అతడే సాక్షి."
  },
  {
    "surah_id": 100,
    "ayah_number": 8,
    "global_ayah_id": 6253,
    "translation": "మరియు నిశ్చయంగా, అతడు సిరిసంపదల వ్యామోహంలో పూర్తిగా మునిగి ఉన్నాడు. (7/8)"
  },
  {
    "surah_id": 100,
    "ayah_number": 9,
    "global_ayah_id": 6254,
    "translation": "* ఏమిటి? అతనికి తెలియదా? గోరీలలో ఉన్నదంతా పెళ్ళగించి బయటికి తీయబడి నప్పుడు"
  },
  {
    "surah_id": 100,
    "ayah_number": 10,
    "global_ayah_id": 6255,
    "translation": "మరియు (మానవుల) హృదయాలలోని విషయాలన్నీ వెల్లడి చేయబడి నప్పుడు"
  },
  {
    "surah_id": 100,
    "ayah_number": 11,
    "global_ayah_id": 6256,
    "translation": "నిశ్చయంగా, ఆ రోజున వారి ప్రభువు వారిని గురించి అంతా తెలుసుకొని ఉంటాడని!"
  }
]