[
  {
    "surah_id": 100,
    "ayah_number": 1,
    "global_ayah_id": 6147,
    "translation": "سوگند به ماديانهائى كه با همهمه تازانند و با سم‌[هاى‌] خود از سنگ آتش مى‌جهانند!"
  },
  {
    "surah_id": 100,
    "ayah_number": 2,
    "global_ayah_id": 6148,
    "translation": "و برق [از سنگ‌] همى جهانند،"
  },
  {
    "surah_id": 100,
    "ayah_number": 3,
    "global_ayah_id": 6149,
    "translation": "و صبحگاهان هجوم آرند،"
  },
  {
    "surah_id": 100,
    "ayah_number": 4,
    "global_ayah_id": 6150,
    "translation": "و با آن [يورش‌]، گردى برانگيزند،"
  },
  {
    "surah_id": 100,
    "ayah_number": 5,
    "global_ayah_id": 6151,
    "translation": "و بدان [هجوم‌]، در دل گروهى درآيند،"
  },
  {
    "surah_id": 100,
    "ayah_number": 6,
    "global_ayah_id": 6152,
    "translation": "كه انسان نسبت به پروردگارش سخت ناسپاس است،"
  },
  {
    "surah_id": 100,
    "ayah_number": 7,
    "global_ayah_id": 6153,
    "translation": "و او خود بر اين [امر]، نيك گواه است."
  },
  {
    "surah_id": 100,
    "ayah_number": 8,
    "global_ayah_id": 6154,
    "translation": "و راستى او سخت شيفته مال است."
  },
  {
    "surah_id": 100,
    "ayah_number": 9,
    "global_ayah_id": 6155,
    "translation": "مگر نمى‌داند كه چون آنچه در گورهاست بيرون ريخته گردد،"
  },
  {
    "surah_id": 100,
    "ayah_number": 10,
    "global_ayah_id": 6156,
    "translation": "و آنچه در سينه‌هاست فاش شود،"
  },
  {
    "surah_id": 100,
    "ayah_number": 11,
    "global_ayah_id": 6157,
    "translation": "در چنان روزى پروردگارشان به [حال‌] ايشان نيك آگاه است؟"
  }
]