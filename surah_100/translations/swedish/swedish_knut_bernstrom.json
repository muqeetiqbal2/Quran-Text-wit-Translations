    "translation": "SE de frustande stridshästarna!"
  },
  {
    "surah_id": 100,
    "ayah_number": 2,
    "global_ayah_id": 6148,
    "translation": "Se hur deras [hovar] slår upp gnistor"
  },
  {
    "surah_id": 100,
    "ayah_number": 3,
    "global_ayah_id": 6149,
    "translation": "när de galopperar till anfall i den tidiga morgonen"
  },
  {
    "surah_id": 100,
    "ayah_number": 4,
    "global_ayah_id": 6150,
    "translation": "[och] hur de river upp moln av damm"
  },
  {
    "surah_id": 100,
    "ayah_number": 5,
    "global_ayah_id": 6151,
    "translation": "när de stormar fram i stridsvimlet!"
  },
  {
    "surah_id": 100,
    "ayah_number": 6,
    "global_ayah_id": 6152,
    "translation": "MÄNNISKAN är sannerligen djupt otacksam mot sin Herre -"
  },
  {
    "surah_id": 100,
    "ayah_number": 7,
    "global_ayah_id": 6153,
    "translation": "om detta vittnar hon själv -"
  },
  {
    "surah_id": 100,
    "ayah_number": 8,
    "global_ayah_id": 6154,
    "translation": "och visar sin kärlek till rikedom i ivern [att samla mer]."
  },
  {
    "surah_id": 100,
    "ayah_number": 9,
    "global_ayah_id": 6155,
    "translation": "Vet hon inte [att] då det som göms i gravarna strös omkring"
  },
  {
    "surah_id": 100,
    "ayah_number": 10,
    "global_ayah_id": 6156,
    "translation": "och det som människorna har dolt i sina hjärtan uppenbaras;"
  },
  {
    "surah_id": 100,
    "ayah_number": 11,
    "global_ayah_id": 6157,
    "translation": "den Dagen [skall det bli uppenbart att] deras Herre var väl underrättad om dem."
  }
]