[
  {
    "surah_id": 100,
    "ayah_number": 1,
    "global_ayah_id": 6147,
    "translation": "കിതച്ചു കൊണ്ട് ഓടുന്നവയും,"
  },
  {
    "surah_id": 100,
    "ayah_number": 2,
    "global_ayah_id": 6148,
    "translation": "അങ്ങനെ (കുളമ്പ് കല്ലില്‍) ഉരസി തീപ്പൊരി പറപ്പിക്കുന്നവയും,"
  },
  {
    "surah_id": 100,
    "ayah_number": 3,
    "global_ayah_id": 6149,
    "translation": "എന്നിട്ട് പ്രഭാതത്തില്‍ ആക്രമണം നടത്തുന്നവയും ,"
  },
  {
    "surah_id": 100,
    "ayah_number": 4,
    "global_ayah_id": 6150,
    "translation": "അന്നേരത്ത് പൊടിപടലം ഇളക്കിവിട്ടവയും"
  },
  {
    "surah_id": 100,
    "ayah_number": 5,
    "global_ayah_id": 6151,
    "translation": "അതിലൂടെ (ശത്രു) സംഘത്തിന്‍റെ നടുവില്‍ പ്രവേശിച്ചവയും (കുതിരകള്‍) തന്നെ സത്യം."
  },
  {
    "surah_id": 100,
    "ayah_number": 6,
    "global_ayah_id": 6152,
    "translation": "തീര്‍ച്ചയായും മനുഷ്യന്‍ തന്‍റെ രക്ഷിതാവിനോട് നന്ദികെട്ടവന്‍ തന്നെ."
  },
  {
    "surah_id": 100,
    "ayah_number": 7,
    "global_ayah_id": 6153,
    "translation": "തീര്‍ച്ചയായും അവന്‍ അതിന്ന് സാക്ഷ്യം വഹിക്കുന്നവനുമാകുന്നു."
  },
  {
    "surah_id": 100,
    "ayah_number": 8,
    "global_ayah_id": 6154,
    "translation": "തീര്‍ച്ചയായും അവന്‍ ധനത്തോടുള്ള സ്നേഹം കഠിനമായവനാകുന്നു."
  },
  {
    "surah_id": 100,
    "ayah_number": 9,
    "global_ayah_id": 6155,
    "translation": "എന്നാല്‍ അവന്‍ അറിയുന്നില്ലേ? ഖബ്‌റുകളിലുള്ളത് ഇളക്കിമറിച്ച് പുറത്ത് കൊണ്ട് വരപ്പെടുകയും ,"
  },
  {
    "surah_id": 100,
    "ayah_number": 10,
    "global_ayah_id": 6156,
    "translation": "ഹൃദയങ്ങളിലുള്ളത് വെളിക്ക് കൊണ്ടു വരപ്പെടുകയും ചെയ്താല്‍ ,"
  },
  {
    "surah_id": 100,
    "ayah_number": 11,
    "global_ayah_id": 6157,
    "translation": "തീര്‍ച്ചയായും അവരുടെ രക്ഷിതാവ് അന്നേ ദിവസം അവരെ പറ്റി സൂക്ഷ്മമായി അറിയുന്നവന്‍ തന്നെയാകുന്നു."
  }
]