  },
  {
    "surah_id": 100,
    "ayah_number": 7,
    "global_ayah_id": 6252,
    "translation": "and he himself is a witness to that"
  },
  {
    "surah_id": 100,
    "ayah_number": 8,
    "global_ayah_id": 6253,
    "translation": "and surely he loves riches with a passionate loving."
  },
  {
    "surah_id": 100,
    "ayah_number": 9,
    "global_ayah_id": 6254,
    "translation": "Is he not aware that when whatever lies (buried) in the graves is overthrown;"
  },
  {
    "surah_id": 100,
    "ayah_number": 10,
    "global_ayah_id": 6255,
    "translation": "and the secrets of the hearts are laid bare (and examined)?"
  },
  {
    "surah_id": 100,
    "ayah_number": 11,
