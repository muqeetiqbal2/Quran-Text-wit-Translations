[
  {
    "surah_id": 100,
    "ayah_number": 1,
    "global_ayah_id": 6147,
    "translation": "By the snorting chargers,"
  },
  {
    "surah_id": 100,
    "ayah_number": 2,
    "global_ayah_id": 6148,
    "translation": "by the strikers of sparks [with their hoofs],"
  },
  {
    "surah_id": 100,
    "ayah_number": 3,
    "global_ayah_id": 6149,
    "translation": "by the raiders at dawn,"
  },
  {
    "surah_id": 100,
    "ayah_number": 4,
    "global_ayah_id": 6150,
    "translation": "raising therein a trail of dust,"
  },
  {
    "surah_id": 100,
    "ayah_number": 5,
    "global_ayah_id": 6151,
    "translation": "and cleaving therein a host!"
  },
  {
    "surah_id": 100,
    "ayah_number": 6,
    "global_ayah_id": 6152,
    "translation": "Indeed man is ungrateful to his Lord,"
  },
  {
    "surah_id": 100,
    "ayah_number": 7,
    "global_ayah_id": 6153,
    "translation": "and indeed he is [himself] witness to that!"
  },
  {
    "surah_id": 100,
    "ayah_number": 8,
    "global_ayah_id": 6154,
    "translation": "And indeed he is an avid lover of wealth."
  },
  {
    "surah_id": 100,
    "ayah_number": 9,
    "global_ayah_id": 6155,
    "translation": "Does he not know, when what is [buried] in the graves is turned over,"
  },
  {
    "surah_id": 100,
    "ayah_number": 10,
    "global_ayah_id": 6156,
    "translation": "and what is [concealed] in the breasts is divulged,"
  },
  {
    "surah_id": 100,
    "ayah_number": 11,
    "global_ayah_id": 6157,
    "translation": "on that day their Lord will be well informed about them [and their deeds]?"
  }
]