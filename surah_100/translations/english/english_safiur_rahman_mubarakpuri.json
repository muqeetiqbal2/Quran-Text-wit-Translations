    "global_ayah_id": 6147,
    "translation": "By the `Adiyat (steeds), snorting."
  },
  {
    "surah_id": 100,
    "ayah_number": 2,
    "global_ayah_id": 6148,
    "translation": "Striking sparks of fire."
  },
  {
    "surah_id": 100,
    "ayah_number": 3,
    "global_ayah_id": 6149,
    "translation": "And scouring to the raid at dawn."
  },
  {
    "surah_id": 100,
    "ayah_number": 4,
    "global_ayah_id": 6150,
    "translation": "And raise the dust in clouds the while."
  },
  {
    "surah_id": 100,
    "ayah_number": 5,
    "global_ayah_id": 6151,
    "translation": "And penetrating forthwith as one into the midst."
  },
  {
    "surah_id": 100,
    "ayah_number": 6,
    "global_ayah_id": 6152,
    "translation": "Verily, man is ungrateful to his Lord."
  },
  {
    "surah_id": 100,
    "ayah_number": 7,
    "global_ayah_id": 6153,
    "translation": "And to that He bears witness."
  },
  {
    "surah_id": 100,
    "ayah_number": 8,
    "global_ayah_id": 6154,
    "translation": "And verily, he is violent in the love of wealth."
  },
  {
    "surah_id": 100,
    "ayah_number": 9,
    "global_ayah_id": 6155,
    "translation": "Knows he not that when the contents of the graves are poured forth"
  },
  {
    "surah_id": 100,
    "ayah_number": 10,
    "global_ayah_id": 6156,
    "translation": "And that which is in the breasts shall be made known"
  },
  {
    "surah_id": 100,
    "ayah_number": 11,
    "global_ayah_id": 6157,
    "translation": "Verily, that Day their Lord will be Well-Acquainted with them."
  }
