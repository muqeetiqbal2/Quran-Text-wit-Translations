[
  {
    "surah_id": 100,
    "ayah_number": 1,
    "global_ayah_id": 6147,
    "translation": "Ҳарсиллаб чопувчиотлар билан қасам."
  },
  {
    "surah_id": 100,
    "ayah_number": 2,
    "global_ayah_id": 6148,
    "translation": "Ўт чақнатиб чопувчи отлар билан қасам."
  },
  {
    "surah_id": 100,
    "ayah_number": 3,
    "global_ayah_id": 6149,
    "translation": "Тонг чоғида ғорат қилувчи отлар билан қасам."
  },
  {
    "surah_id": 100,
    "ayah_number": 4,
    "global_ayah_id": 6150,
    "translation": "Ўша пайтда чанг қўзғотдилар."
  },
  {
    "surah_id": 100,
    "ayah_number": 5,
    "global_ayah_id": 6151,
    "translation": "Ва у ила жамоа ўртасига (ёриб) кирдилар."
  },
  {
    "surah_id": 100,
    "ayah_number": 6,
    "global_ayah_id": 6152,
    "translation": "Албатта, инсон ўз Роббисига ношукрдир."
  },
  {
    "surah_id": 100,
    "ayah_number": 7,
    "global_ayah_id": 6153,
    "translation": "Ва албатта, у ана шунга ўзи гувоҳдир."
  },
  {
    "surah_id": 100,
    "ayah_number": 8,
    "global_ayah_id": 6154,
    "translation": "Албатта, у мол-дунёга ҳаддан ташқари ўчдир."
  },
  {
    "surah_id": 100,
    "ayah_number": 9,
    "global_ayah_id": 6155,
    "translation": "У билмасми?! Қабрдагилар қўзғатилганда."
  },
  {
    "surah_id": 100,
    "ayah_number": 10,
    "global_ayah_id": 6156,
    "translation": "Ва кўкракларидаги ошкор бўлганда."
  },
  {
    "surah_id": 100,
    "ayah_number": 11,
    "global_ayah_id": 6157,
    "translation": "Ўша кунда Роббилари улардан, хабардор эканини?!"
  }
]