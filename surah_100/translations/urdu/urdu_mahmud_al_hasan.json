[
  {
    "surah_id": 100,
    "ayah_number": 0,
    "global_ayah_id": 6245,
    "translation": "اللہ کے نام سے جو رحمان و رحیم ہے"
  },
  {
    "surah_id": 100,
    "ayah_number": 1,
    "global_ayah_id": 6246,
    "translation": "قسم ہے دوڑنے والے گھوڑوں کی ہانپ کر"
  },
  {
    "surah_id": 100,
    "ayah_number": 2,
    "global_ayah_id": 6247,
    "translation": "پھر آگ سلگانے والے جھاڑ کر"
  },
  {
    "surah_id": 100,
    "ayah_number": 3,
    "global_ayah_id": 6248,
    "translation": "پھر غارت کر ڈالنے والے صبح کو"
  },
  {
    "surah_id": 100,
    "ayah_number": 4,
    "global_ayah_id": 6249,
    "translation": "پھر اٹھانے والے اُس میں گرد"
  },
  {
    "surah_id": 100,
    "ayah_number": 5,
    "global_ayah_id": 6250,
    "translation": "پھر گھس جانے والے اُس وقت فوج میں"
  },
  {
    "surah_id": 100,
    "ayah_number": 6,
    "global_ayah_id": 6251,
    "translation": "بیشک آدمی اپنے رب کا ناشکر ہے"
  },
  {
    "surah_id": 100,
    "ayah_number": 7,
    "global_ayah_id": 6252,
    "translation": "اور وہ آدمی اس کام کو سامنے دیکھتا ہے"
  },
  {
    "surah_id": 100,
    "ayah_number": 8,
    "global_ayah_id": 6253,
    "translation": "اور آدمی محبت پر مال کی بہت پکا ہے"
  },
  {
    "surah_id": 100,
    "ayah_number": 9,
    "global_ayah_id": 6254,
    "translation": "کیا نہیں جانتا وہ وقت کہ کریدا جائے جو کچھ قبروں میں ہے"
  },
  {
    "surah_id": 100,
    "ayah_number": 10,
    "global_ayah_id": 6255,
    "translation": "اور تحقیق ہووے جو کچھ کہ جیوں میں ہے"
  },
  {
    "surah_id": 100,
    "ayah_number": 11,
    "global_ayah_id": 6256,
    "translation": "بیشک اُنکے رب کو اُنکی اُس دن سب خبر ہے"
  }
]