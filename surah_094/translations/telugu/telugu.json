[
  {
    "surah_id": 94,
    "ayah_number": 0,
    "global_ayah_id": 6183,
    "translation": "అనంత కరుణామయుడు అపార కరుణాప్రదాత అయిన అల్లాహ్‌ పేరుతో"
  },
  {
    "surah_id": 94,
    "ayah_number": 1,
    "global_ayah_id": 6184,
    "translation": "* (ఓ ము హమ్మద్‌!) ఏమీ? మేము నీ కొరకు నీ హృదయాన్ని తెరువలేదా?"
  },
  {
    "surah_id": 94,
    "ayah_number": 2,
    "global_ayah_id": 6185,
    "translation": "మరియు మేము నీ భారాన్ని నీపై నుండి దించివేయలేదా?"
  },
  {
    "surah_id": 94,
    "ayah_number": 3,
    "global_ayah_id": 6186,
    "translation": "ఏదైతే నీ వెన్నును విరుస్తూ ఉండిందో?"
  },
  {
    "surah_id": 94,
    "ayah_number": 4,
    "global_ayah_id": 6187,
    "translation": "మరియు నీ పేరు ప్రతిష్ఠలను పైకెత్తలేదా?"
  },
  {
    "surah_id": 94,
    "ayah_number": 5,
    "global_ayah_id": 6188,
    "translation": "నిశ్చయంగా, ఎల్లప్పుడు కష్టంతో పాటు సుఖం కూడా ఉంటుంది"
  },
  {
    "surah_id": 94,
    "ayah_number": 6,
    "global_ayah_id": 6189,
    "translation": "నిశ్చయంగా, కష్టంతో పాటు సుఖం కూడా ఉంటుంది."
  },
  {
    "surah_id": 94,
    "ayah_number": 7,
    "global_ayah_id": 6190,
    "translation": "కావున నీకు తీరిక లభించినప్పుడు ఆరాధనలో నిమగ్నుడవైపో!"
  },
  {
    "surah_id": 94,
    "ayah_number": 8,
    "global_ayah_id": 6191,
    "translation": "మరియు నీ ప్రభువునందే ధ్యానం నిలుపు."
  }
]