    "ayah_number": 1,
    "global_ayah_id": 6091,
    "translation": "ልብህን ለአንተ አላሰፋንልህምን? (አስፍተንልሃል)፡፡"
  },
  {
    "surah_id": 94,
    "ayah_number": 2,
    "global_ayah_id": 6092,
    "translation": "ሸክምህንም ካንተ አውርደንልሃል፡፡"
  },
  {
    "surah_id": 94,
    "ayah_number": 3,
    "global_ayah_id": 6093,
    "translation": "ያንን ጀርባህን ያከበደውን (ሸክም)፡፡"
  },
  {
    "surah_id": 94,
    "ayah_number": 4,
    "global_ayah_id": 6094,
    "translation": "መወሳትህንም ላንተ ከፍ አድርገንልሃል፡፡"
  },
  {
    "surah_id": 94,
    "ayah_number": 5,
    "global_ayah_id": 6095,
    "translation": "ከችግርም ጋር ምቾት አልለ፡፡"
  },
  {
    "surah_id": 94,
    "ayah_number": 6,
    "global_ayah_id": 6096,
    "translation": "ከችግር ጋር በእርግጥ ምቾት አልለ፡፡"
  },
  {
    "surah_id": 94,
    "ayah_number": 7,
    "global_ayah_id": 6097,
    "translation": "በጨረስክም ጊዜ ልፋ፡፡ (ቀጥል)፡፡"
  },
  {
    "surah_id": 94,
    "ayah_number": 8,
    "global_ayah_id": 6098,
    "translation": "ወደ ጌታህም ብቻ ከጅል፡፡"
  }
]