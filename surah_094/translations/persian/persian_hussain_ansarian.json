[
  {
    "surah_id": 94,
    "ayah_number": 1,
    "global_ayah_id": 6091,
    "translation": "آیا سینه ات را [به نوری از سوی خود] گشاده نکردیم؟"
  },
  {
    "surah_id": 94,
    "ayah_number": 2,
    "global_ayah_id": 6092,
    "translation": "و بار گرانت را فرو ننهادیم؟"
  },
  {
    "surah_id": 94,
    "ayah_number": 3,
    "global_ayah_id": 6093,
    "translation": "همان بار گرانی که پشتت را شکست."
  },
  {
    "surah_id": 94,
    "ayah_number": 4,
    "global_ayah_id": 6094,
    "translation": "و آوازه ات را برایت بلند نکردیم؟"
  },
  {
    "surah_id": 94,
    "ayah_number": 5,
    "global_ayah_id": 6095,
    "translation": "پس بی تردید با دشواری آسانی است."
  },
  {
    "surah_id": 94,
    "ayah_number": 6,
    "global_ayah_id": 6096,
    "translation": "[آری] بی تردید با دشواری آسانی است."
  },
  {
    "surah_id": 94,
    "ayah_number": 7,
    "global_ayah_id": 6097,
    "translation": "پس هنگامی که [از کار بسیار مهم تبلیغ] فراغت می یابی، به عبادت و دعا بکوش"
  },
  {
    "surah_id": 94,
    "ayah_number": 8,
    "global_ayah_id": 6098,
    "translation": "و مشتاقانه به سوی پروردگارت رو آور."
  }
]