[
  {
    "surah_id": 94,
    "ayah_number": 1,
    "global_ayah_id": 6091,
    "translation": "[ای پیامبر!] آیا سینه‌ات را نگشاده‌ایم؟"
  },
  {
    "surah_id": 94,
    "ayah_number": 2,
    "global_ayah_id": 6092,
    "translation": "و بار سنگینت را از [دوش] تو برنداشتیم؟"
  },
  {
    "surah_id": 94,
    "ayah_number": 3,
    "global_ayah_id": 6093,
    "translation": "آن [بار گران] که برای تو کمرشکن بود."
  },
  {
    "surah_id": 94,
    "ayah_number": 4,
    "global_ayah_id": 6094,
    "translation": "و نام تو را بلند [آوازه] کردیم."
  },
  {
    "surah_id": 94,
    "ayah_number": 5,
    "global_ayah_id": 6095,
    "translation": "پس [بدان که] با هر سختی، آسانی است."
  },
  {
    "surah_id": 94,
    "ayah_number": 6,
    "global_ayah_id": 6096,
    "translation": "[آری!] با هر سختی، آسانی است."
  },
  {
    "surah_id": 94,
    "ayah_number": 7,
    "global_ayah_id": 6097,
    "translation": "پس هرگاه [از کار] فارغ شدی، [برای کار تازه] بکوش و رنج آن را بر خود هموار کن!"
  },
  {
    "surah_id": 94,
    "ayah_number": 8,
    "global_ayah_id": 6098,
    "translation": "و مشتاقانه به سوی پروردگارت روی آور!"
  }
]