[
  {
    "surah_id": 94,
    "ayah_number": 1,
    "global_ayah_id": 6091,
    "translation": "آيا براى تو سينه‌ات را نگشاده‌ايم؟"
  },
  {
    "surah_id": 94,
    "ayah_number": 2,
    "global_ayah_id": 6092,
    "translation": "و بار گرانت را از [دوش‌] تو برنداشتيم؟"
  },
  {
    "surah_id": 94,
    "ayah_number": 3,
    "global_ayah_id": 6093,
    "translation": "[بارى‌] كه [گويى‌] پشت تو را شكست."
  },
  {
    "surah_id": 94,
    "ayah_number": 4,
    "global_ayah_id": 6094,
    "translation": "و نامت را براى تو بلند گردانيديم."
  },
  {
    "surah_id": 94,
    "ayah_number": 5,
    "global_ayah_id": 6095,
    "translation": "پس [بدان كه‌] با دشوارى، آسانى است."
  },
  {
    "surah_id": 94,
    "ayah_number": 6,
    "global_ayah_id": 6096,
    "translation": "آرى، با دشوارى، آسانى است."
  },
  {
    "surah_id": 94,
    "ayah_number": 7,
    "global_ayah_id": 6097,
    "translation": "پس چون فراغت يافتى، به طاعت دركوش؛"
  },
  {
    "surah_id": 94,
    "ayah_number": 8,
    "global_ayah_id": 6098,
    "translation": "و با اشتياق، به سوى پروردگارت روى آور."
  }
