[
  {
    "surah_id": 94,
    "ayah_number": 0,
    "global_ayah_id": 6183,
    "translation": "﻿अल्लाहच्या नावाने, जो अत्यंत दयावंत व असीम कृपावंत आहे."
  },
  {
    "surah_id": 94,
    "ayah_number": 1,
    "global_ayah_id": 6184,
    "translation": "(हे पैगंबर (स.)) काय आम्ही तुमचे मन तुमच्यासाठी उघडले नाही?"
  },
  {
    "surah_id": 94,
    "ayah_number": 2,
    "global_ayah_id": 6185,
    "translation": "आणि तुमच्यावरून ते भारी ओझे उतरविले"
  },
  {
    "surah_id": 94,
    "ayah_number": 3,
    "global_ayah_id": 6186,
    "translation": "जे तुमची कंबर खचवीत होते."
  },
  {
    "surah_id": 94,
    "ayah_number": 4,
    "global_ayah_id": 6187,
    "translation": "आणि तुमच्याखातर तुमच्या लौकिकाचा नाद दुमदुमला."
  },
  {
    "surah_id": 94,
    "ayah_number": 5,
    "global_ayah_id": 6188,
    "translation": "तर वस्तुस्थिती अशी आहे की, अडचणीबरोबर संपन्नताही आहे."
  },
  {
    "surah_id": 94,
    "ayah_number": 6,
    "global_ayah_id": 6189,
    "translation": "निःसंशय अडचणींबरोबर संपन्नताही आहे."
  },
  {
    "surah_id": 94,
    "ayah_number": 7,
    "global_ayah_id": 6190,
    "translation": "म्हणून जेव्हा तुम्ही मोकळे व्हाल तेव्हा उपासनेच्या परिश्रमात लागा"
  },
  {
    "surah_id": 94,
    "ayah_number": 8,
    "global_ayah_id": 6191,
    "translation": "आणि आपल्या पालनकर्त्याकडेच ओढ ठेवा."
  }
]