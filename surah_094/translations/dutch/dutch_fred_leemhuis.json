    "surah_id": 94,
    "ayah_number": 3,
    "global_ayah_id": 6093,
    "translation": "die zwaar op jouw rug drukte?"
  },
  {
    "surah_id": 94,
    "ayah_number": 4,
    "global_ayah_id": 6094,
    "translation": "En Wij hebben jouw aanzien vergroot."
  },
  {
    "surah_id": 94,
    "ayah_number": 5,
    "global_ayah_id": 6095,
    "translation": "Want met het moeilijke hangt het gemakkelijke samen."
  },
  {
    "surah_id": 94,
    "ayah_number": 6,
    "global_ayah_id": 6096,
    "translation": "Ja, met het moeilijke hangt het gemakkelijke samen!"
  },
  {
    "surah_id": 94,
    "ayah_number": 7,
    "global_ayah_id": 6097,
    "translation": "En wanneer je klaar bent span je dan in"
  },
  {
    "surah_id": 94,
    "ayah_number": 8,
    "global_ayah_id": 6098,
    "translation": "en richt je verlangen tot jouw Heer."
  }
