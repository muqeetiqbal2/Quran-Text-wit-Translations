    "ayah_number": 1,
    "global_ayah_id": 6091,
    "translation": "Hebben Wij bij jou je hart niet opengesteld"
  },
  {
    "surah_id": 94,
    "ayah_number": 2,
    "global_ayah_id": 6092,
    "translation": "en jou je last afgenomen,"
  },
