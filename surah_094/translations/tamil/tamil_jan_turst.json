[
  {
    "surah_id": 94,
    "ayah_number": 1,
    "global_ayah_id": 6091,
    "translation": "நாம், உம் இதயத்தை உமக்காக விரிவாக்கவில்லையா?"
  },
  {
    "surah_id": 94,
    "ayah_number": 2,
    "global_ayah_id": 6092,
    "translation": "மேலும், நாம் உம்மை விட்டும் உம் சுமையை இறக்கினோம்."
  },
  {
    "surah_id": 94,
    "ayah_number": 3,
    "global_ayah_id": 6093,
    "translation": "அது உம் முதுகை முறித்துக் கொண்டுடிருந்தது."
  },
  {
    "surah_id": 94,
    "ayah_number": 4,
    "global_ayah_id": 6094,
    "translation": "மேலும், நாம் உமக்காக உம்முடைய புகழை மேலோங்கச் செய்தோம்."
  },
  {
    "surah_id": 94,
    "ayah_number": 5,
    "global_ayah_id": 6095,
    "translation": "ஆதலின் நிச்சயமாகத் துன்பத்துடன் இன்பம் இருக்கிறது."
  },
  {
    "surah_id": 94,
    "ayah_number": 6,
    "global_ayah_id": 6096,
    "translation": "நிச்சயமாக துன்பத்துடன் இன்பம் இருக்கிறது."
  },
  {
    "surah_id": 94,
    "ayah_number": 7,
    "global_ayah_id": 6097,
    "translation": "எனவே, (வேலைகளிலிருந்து) நீர் ஓய்ந்ததும் (இறைவழியிலும், வணக்கத்திலும்) முயல்வீராக."
  },
  {
    "surah_id": 94,
    "ayah_number": 8,
    "global_ayah_id": 6098,
    "translation": "மேலும், முழு மனத்துடன் உம் இறைவன் பால் சார்ந்து விடுவீராக."
  }
]