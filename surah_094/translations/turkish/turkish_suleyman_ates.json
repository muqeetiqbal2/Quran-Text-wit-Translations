  {
    "surah_id": 94,
    "ayah_number": 1,
    "global_ayah_id": 6091,
    "translation": "Biz senin (bunalan) göğsünü açmadık mı (ondaki bunalımları, sıkıntıları giderip, onu ilim, hikmet ve huzur ile genişletmedik mi)?"
  },
  {
    "surah_id": 94,
    "ayah_number": 2,
    "global_ayah_id": 6092,
    "translation": "Ve atmadık mı senin üzerinden yükünü?"
  },
  {
    "surah_id": 94,
    "ayah_number": 3,
    "global_ayah_id": 6093,
    "translation": "Ki (o, ağırlığından) sırtını çatırdatmıştı!"
  },
  {
    "surah_id": 94,
    "ayah_number": 4,
    "global_ayah_id": 6094,
    "translation": "Senin şanını yükseltmedik mi?"
  },
  {
    "surah_id": 94,
    "ayah_number": 5,
    "global_ayah_id": 6095,
    "translation": "Muhakkak her güçlükle beraber bir kolaylık vardır."
  },
  {
    "surah_id": 94,
    "ayah_number": 6,
    "global_ayah_id": 6096,
    "translation": "Evet, her güçlükle beraber bir kolaylık vardır."
  },
  {
    "surah_id": 94,
    "ayah_number": 7,
    "global_ayah_id": 6097,
    "translation": "O halde (işlerinden) boşaldığın zaman (ibadete) dur."
  },
  {
    "surah_id": 94,
    "ayah_number": 8,
    "global_ayah_id": 6098,
    "translation": "Rabb'ine niyaz et, yalvar."
  }
]