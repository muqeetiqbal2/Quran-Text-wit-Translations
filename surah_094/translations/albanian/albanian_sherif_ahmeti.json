[
  {
    "surah_id": 94,
    "ayah_number": 1,
    "global_ayah_id": 6091,
    "translation": "A nuk ta hapëm ne gjoksin tënd?"
  },
  {
    "surah_id": 94,
    "ayah_number": 2,
    "global_ayah_id": 6092,
    "translation": "Dhe Ne hoqëm prej teje barrën tënde,"
  },
  {
    "surah_id": 94,
    "ayah_number": 3,
    "global_ayah_id": 6093,
    "translation": "E cila shtypte shpinën tënde."
  },
  {
    "surah_id": 94,
    "ayah_number": 4,
    "global_ayah_id": 6094,
    "translation": "Dhe Ne, ta ngritëm lartë famën tënde?"
  },
  {
    "surah_id": 94,
    "ayah_number": 5,
    "global_ayah_id": 6095,
    "translation": "E, pa dyshim se pas vështirësisë është lehtësimi."
  },
  {
    "surah_id": 94,
    "ayah_number": 6,
    "global_ayah_id": 6096,
    "translation": "Vërtet, pas vështirësisë vjen lehtësimi."
  },
  {
    "surah_id": 94,
    "ayah_number": 7,
    "global_ayah_id": 6097,
    "translation": "E kur ta kryesh (obligimin), atëbotë mundohu me adhurim (All-llahut)."
  },
  {
    "surah_id": 94,
    "ayah_number": 8,
    "global_ayah_id": 6098,
    "translation": "Dhe, vetëm te Zoti yt përqëndro synimin!"
  }
]