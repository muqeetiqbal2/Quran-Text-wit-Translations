[
  {
    "surah_id": 94,
    "ayah_number": 1,
    "global_ayah_id": 6091,
    "translation": "আমরা কি তোমার বক্ষ প্রশস্ত করে দিই নি?"
  },
  {
    "surah_id": 94,
    "ayah_number": 2,
    "global_ayah_id": 6092,
    "translation": "আর আমরা তোমার থেকে লাঘব করেছি তোমার ভার, --"
  },
  {
    "surah_id": 94,
    "ayah_number": 3,
    "global_ayah_id": 6093,
    "translation": "যা চেপে বসেছিল তোমার পিঠে;"
  },
  {
    "surah_id": 94,
    "ayah_number": 4,
    "global_ayah_id": 6094,
    "translation": "আর আমরা তোমার জন্য উন্নত করেছি তোমার নামোল্লেখ।"
  },
  {
    "surah_id": 94,
    "ayah_number": 5,
    "global_ayah_id": 6095,
    "translation": "অতএব কষ্টের সঙ্গেই তো আরাম রয়েছে,"
  },
  {
    "surah_id": 94,
    "ayah_number": 6,
    "global_ayah_id": 6096,
    "translation": "নিশ্চয় কষ্টের সঙ্গে আরাম রয়েছে।"
  },
  {
    "surah_id": 94,
    "ayah_number": 7,
    "global_ayah_id": 6097,
    "translation": "সুতরাং যখন তুমি মুক্ত হয়েছে তখন কঠোর পরিশ্রম করো,"
  },
  {
    "surah_id": 94,
    "ayah_number": 8,
    "global_ayah_id": 6098,
    "translation": "আর তোমার প্রভুর প্রতি তবে একান্তভাবে মনোনিবেশ করো।"
  }
]