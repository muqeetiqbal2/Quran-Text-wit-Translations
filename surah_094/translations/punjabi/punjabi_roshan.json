    "global_ayah_id": 6183,
    "translation": "اللہ دے ناں نال ( شروع ) جیہڑا حدوں مہربان ، بوہت رحم والا اے ۔"
  },
  {
    "surah_id": 94,
    "ayah_number": 1,
    "global_ayah_id": 6184,
    "translation": "( اے نبی ! ) بھلا اسیں تیرے لئی تیرا سینہ نئیں کھول دتا ؟"
  },
  {
    "surah_id": 94,
    "ayah_number": 2,
    "global_ayah_id": 6185,
    "translation": "تے تیرے توں تیرا بھار لاء چھڈیا"
  },
  {
    "surah_id": 94,
    "ayah_number": 3,
    "global_ayah_id": 6186,
    "translation": "جنھے تیرا لک توڑ چھڈیا سی"
  },
  {
    "surah_id": 94,
    "ayah_number": 4,
    "global_ayah_id": 6187,
    "translation": "تے اسیں تیرے لئی تیرا ذکر اُچا کر دتا"
  },
  {
    "surah_id": 94,
    "ayah_number": 5,
    "global_ayah_id": 6188,
    "translation": "سو بیشک ہر مشکل دے نال آسانی"
  },
  {
    "surah_id": 94,
    "ayah_number": 6,
    "global_ayah_id": 6189,
    "translation": "بیشک ( ریت پرانی ) ہر مشکل دے نال آسانی"
  },
  {
    "surah_id": 94,
    "ayah_number": 7,
    "global_ayah_id": 6190,
    "translation": "فیر جدوں تسی فارغ ہو جاؤ فیر محنت کرو"
  },
  {
    "surah_id": 94,
    "ayah_number": 8,
    "global_ayah_id": 6191,
    "translation": "تے اپنے رب ول ای فیر تانگھ رکھو"
  }
]