[
  {
    "surah_id": 94,
    "ayah_number": 0,
    "global_ayah_id": 6183,
    "translation": "En el nombre de Dios, el Compasivo con toda la creación, el Misericordioso con los creyentes."
  },
  {
    "surah_id": 94,
    "ayah_number": 1,
    "global_ayah_id": 6184,
    "translation": "¿Acaso no he dado sosiego a tu corazón [¡oh, Mujámmad!],"
  },
  {
    "surah_id": 94,
    "ayah_number": 2,
    "global_ayah_id": 6185,
    "translation": "te he liberado de la carga"
  },
  {
    "surah_id": 94,
    "ayah_number": 3,
    "global_ayah_id": 6186,
    "translation": "que agobiaba tu espalda,"
  },
  {
    "surah_id": 94,
    "ayah_number": 4,
    "global_ayah_id": 6187,
    "translation": "y he elevado tu renombre?"
  },
  {
    "surah_id": 94,
    "ayah_number": 5,
    "global_ayah_id": 6188,
    "translation": "Luego de toda dificultad viene la facilidad."
  },
  {
    "surah_id": 94,
    "ayah_number": 6,
    "global_ayah_id": 6189,
    "translation": "Realmente, luego de toda dificultad viene la facilidad."
  },
  {
    "surah_id": 94,
    "ayah_number": 7,
    "global_ayah_id": 6190,
    "translation": "Cuando cumplas con tus obligaciones dedícate a la adoración,"
  },
  {
    "surah_id": 94,
    "ayah_number": 8,
    "global_ayah_id": 6191,
    "translation": "y a tu Señor anhela con devoción."
  }
