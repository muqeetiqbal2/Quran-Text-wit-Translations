[
  {
    "surah_id": 94,
    "ayah_number": 0,
    "global_ayah_id": 6183,
    "translation": "शुरु अत्यन्त करुणामय, परम दयालु अल्लाहको नामबाट ।"
  },
  {
    "surah_id": 94,
    "ayah_number": 1,
    "global_ayah_id": 6184,
    "translation": "(हे सन्देष्टा !) के हामीले तिम्रो छाती तिम्रोलागि खोलिदिएनौं ?"
  },
  {
    "surah_id": 94,
    "ayah_number": 2,
    "global_ayah_id": 6185,
    "translation": "र, हामीले तिमीबाट तिम्रो त्यो बोझ पनि हटाइदियौं"
  },
  {
    "surah_id": 94,
    "ayah_number": 3,
    "global_ayah_id": 6186,
    "translation": "जसले तिम्रो ढाड भाँचिरहेको थियो ।"
  },
  {
    "surah_id": 94,
    "ayah_number": 4,
    "global_ayah_id": 6187,
    "translation": "र, तिम्रोलागि हामीले तिम्रो कीर्ति उच्दिच पारिदियौँ ।"
  },
  {
    "surah_id": 94,
    "ayah_number": 5,
    "global_ayah_id": 6188,
    "translation": "अतः निश्चय नै कठिनाइपछि सरलता छ ।"
  },
  {
    "surah_id": 94,
    "ayah_number": 6,
    "global_ayah_id": 6189,
    "translation": "हो, कठिनाइ लगत्तै सरलता छ ।"
  },
  {
    "surah_id": 94,
    "ayah_number": 7,
    "global_ayah_id": 6190,
    "translation": "अतः फुर्सद पाउँदा उपासनामा जुट्ने गर ।"
  },
  {
    "surah_id": 94,
    "ayah_number": 8,
    "global_ayah_id": 6191,
    "translation": "र, आफ्ना रबतर्फ मोहित होऊ ।"
  }
]