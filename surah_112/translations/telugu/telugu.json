[
  {
    "surah_id": 112,
    "ayah_number": 0,
    "global_ayah_id": 6332,
    "translation": "అనంత కరుణామయుడు అపార కరుణాప్రదాత అయిన అల్లాహ్‌ పేరుతో"
  },
  {
    "surah_id": 112,
    "ayah_number": 1,
    "global_ayah_id": 6333,
    "translation": "ఇలా అను:  ఆయనే అల్లాహ్‌! ఏకైకుడు."
  },
  {
    "surah_id": 112,
    "ayah_number": 2,
    "global_ayah_id": 6334,
    "translation": "అల్లాహ్‌! ఎవరి అక్కరా లేనివాడు."
  },
  {
    "surah_id": 112,
    "ayah_number": 3,
    "global_ayah_id": 6335,
    "translation": "ఆయనకు సంతానం లేదు (బిడ్డలను కనడు) మరియు ఆయన కూడా ఎవరి సంతానమూ (ఎవరికీ జన్మించిన వాడునూ) కాడు."
  },
  {
    "surah_id": 112,
    "ayah_number": 4,
    "global_ayah_id": 6336,
    "translation": "మరియు (సర్వ లోకాలలో) ఆయనతో పోల్చదగినది ఏదీ లేదు."
  }
]