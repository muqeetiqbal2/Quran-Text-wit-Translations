    "ayah_number": 1,
    "global_ayah_id": 6194,
    "translation": "குறைஷிகளுக்கு விருப்பம் உண்டாக்கி,"
  },
  {
    "surah_id": 106,
    "ayah_number": 2,
    "global_ayah_id": 6195,
    "translation": "மாரி காலத்துடையவும் கோடைக்காலத்துடையவும் பிரயாணத்தில் அவர்களுக்கு மன விருப்பத்தை உண்டாக்கியமைக்காக-"
  },
  {
    "surah_id": 106,
    "ayah_number": 3,
    "global_ayah_id": 6196,
    "translation": "இவ்வீட்டின் (கஅபாவின்) இறைவனை அவர்கள் வணங்குவார்களாக."
  },
  {
    "surah_id": 106,
    "ayah_number": 4,
    "global_ayah_id": 6197,
    "translation": "அவனே, அவர்களுக்கு பசிக்கு உணவளித்தான்; மேலும் அவர்களுக்கு அச்சத்திலிருந்தும் அபயமளித்தான்."
  }
]