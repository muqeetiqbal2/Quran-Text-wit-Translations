  {
    "surah_id": 89,
    "ayah_number": 19,
    "global_ayah_id": 6100,
    "translation": " اور «<a href=638> وراثت </a>» کو سمیٹ کر ہڑپ کرتے ہو ۔ "
  },
  {
    "surah_id": 89,
    "ayah_number": 20,
    "global_ayah_id": 6101,
    "translation": " اور «<a href=563> مال </a>» کے عشق میں متوالے ہو ۔ "
  },
  {
    "surah_id": 89,
    "ayah_number": 21,
    "global_ayah_id": 6102,
    "translation": " ہرگز نہیں! ( اس «<a href=639> وقت </a>» کو «<a href=657> یاد </a>» رکھیں ) جب «<a\n  href=379> زمین </a>» کوٹ کوٹ کر «<a href=98> برابر </a>» کردی جائے گی ۔ "
