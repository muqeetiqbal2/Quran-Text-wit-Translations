  {
    "surah_id": 89,
    "ayah_number": 22,
    "global_ayah_id": 6103,
    "translation": " اور تیرا خداوند صف در صف فرشتوں ( کے جلو ) میں نمودار ہوگا ۔ "
  },
  {
    "surah_id": 89,
    "ayah_number": 23,
    "global_ayah_id": 6104,
    "translation": " اور جہنم اس «<a href=326> دن </a>» «<a href=279> حاضر </a>» کی جائے گی ۔ اس «<a\n  href=326> دن </a>» «<a href=3> انسان </a>» سوچے گا ، مگر کیا حاصل اس سوچنے کا؟ "
  },
  {
    "surah_id": 89,
    "ayah_number": 24,
    "global_ayah_id": 6105,
    "translation": " کہے گا: کا! میں نے اپنی زندگی کیلئے کچھ کر رکھا ہوتا! "
  },
  {
    "surah_id": 89,
    "ayah_number": 25,
    "global_ayah_id": 6106,
    "translation": " پس اس «<a href=326> دن </a>» نہ اس کا سا «<a href=440> عذاب </a>» کوئی دے سکتا "
  },
  {
    "surah_id": 89,
    "ayah_number": 26,
    "global_ayah_id": 6107,
    "translation": " اور نہ اس کا سا «<a href=82> باندھنا </a>» کوئی باندھ سکتا! "
