[
  {
    "surah_id": 89,
    "ayah_number": 0,
    "global_ayah_id": 6081,
    "translation": "اللہ کے نام سے جو رحمان و رحیم ہے"
  },
  {
    "surah_id": 89,
    "ayah_number": 1,
    "global_ayah_id": 6082,
    "translation": "قسم ہے فجر کی"
  },
  {
    "surah_id": 89,
    "ayah_number": 2,
    "global_ayah_id": 6083,
    "translation": "اور دس راتوں کی"
  },
  {
    "surah_id": 89,
    "ayah_number": 3,
    "global_ayah_id": 6084,
    "translation": "اور جفت اورطاق کی"
  },
  {
    "surah_id": 89,
    "ayah_number": 4,
    "global_ayah_id": 6085,
    "translation": "اور اس رات کی جب رات کو چلے"
  },
  {
    "surah_id": 89,
    "ayah_number": 5,
    "global_ayah_id": 6086,
    "translation": "ہے اُن چیزوں کی قسم پوری عقلمندوں کے واسطے"
  },
  {
    "surah_id": 89,
    "ayah_number": 6,
    "global_ayah_id": 6087,
    "translation": "تو نے نہ دیکھا کیسا کیا تیرے رب نے عاد کے ساتھ"
  },
  {
    "surah_id": 89,
    "ayah_number": 7,
    "global_ayah_id": 6088,
    "translation": "وہ جو ارم میں تھے بڑے ستونوں والے"
  },
  {
    "surah_id": 89,
    "ayah_number": 8,
    "global_ayah_id": 6089,
    "translation": "کہ بنی نہیں ویسی سارے شہروں میں"
  },
  {
    "surah_id": 89,
    "ayah_number": 9,
    "global_ayah_id": 6090,
    "translation": "اور ثمود کے ساتھ جنہوں نے تراشا پتھروں کو وادی میں"
  },
  {
    "surah_id": 89,
    "ayah_number": 10,
    "global_ayah_id": 6091,
    "translation": "اور فرعون کے ساتھ و ہ میخوں والا"
  },
  {
    "surah_id": 89,
    "ayah_number": 11,
    "global_ayah_id": 6092,
    "translation": "یہ سب تھے جنہوں نے سر اٹھایا ملکوں میں"
  },
  {
    "surah_id": 89,
    "ayah_number": 12,
    "global_ayah_id": 6093,
    "translation": "پھر بہت ڈالی اُن میں خرابی"
  },
  {
    "surah_id": 89,
    "ayah_number": 13,
    "global_ayah_id": 6094,
    "translation": "پھر پھینکا اُن پر تیرے رب نے کوڑا عذاب کا"
  },
  {
    "surah_id": 89,
    "ayah_number": 14,
    "global_ayah_id": 6095,
    "translation": "بیشک تیرا رب لگا ہے گھات میں"
  },
  {
    "surah_id": 89,
    "ayah_number": 15,
    "global_ayah_id": 6096,
    "translation": "سو آدمی جو ہے جب جانچے اُسکو رب اُس کا پھر اُس کو عزت دے اور اُسکو نعمت دے تو کہے میرے رب نے مجھ کو عزت دی"
  },
  {
    "surah_id": 89,
    "ayah_number": 16,
    "global_ayah_id": 6097,
    "translation": "اور وہ جس وقت اُسکو جانچے پھر کھینچ کرے اُس پر روزی کی تو کہے میرے رب نے مجھے ذلیل کیا"
  },
  {
    "surah_id": 89,
    "ayah_number": 17,
    "global_ayah_id": 6098,
    "translation": "کوئی نہیں پر تم عزت سے نہیں رکھتے یتیم کو"
  },
  {
    "surah_id": 89,
    "ayah_number": 18,
    "global_ayah_id": 6099,
    "translation": "اور تاکید نہیں کرتے آپس میں محتاج کے کھلانے کی"
  },
  {
    "surah_id": 89,
    "ayah_number": 19,
    "global_ayah_id": 6100,
    "translation": "اور کھا جاتے ہو مردے کا مال سمیٹ کر سارا"
  },
  {
    "surah_id": 89,
    "ayah_number": 20,
    "global_ayah_id": 6101,
    "translation": "اور پیار کرتے ہو مال کو جی بھر کر"
  },
  {
    "surah_id": 89,
    "ayah_number": 21,
    "global_ayah_id": 6102,
    "translation": "کوئی نہیں جب پست کر دی جائے زمین کوٹ کوٹ کر"
  },
  {
    "surah_id": 89,
    "ayah_number": 22,
    "global_ayah_id": 6103,
    "translation": "اور آئے تیرا رب اور فرشتے آئیں قطار قطار"
  },
  {
    "surah_id": 89,
    "ayah_number": 23,
    "global_ayah_id": 6104,
    "translation": "اور لائی جائے اُس دن دوزخ اُس دن سوچے گا آدمی اور کہاں ملے اُسکو سوچنا"
  },
  {
    "surah_id": 89,
    "ayah_number": 24,
    "global_ayah_id": 6105,
    "translation": "کہے کیا اچھا ہوتا جو میں کچھ آگے بھیجدیتا اپنی زندگی میں"
  },
  {
    "surah_id": 89,
    "ayah_number": 25,
    "global_ayah_id": 6106,
    "translation": "پھر اُس دن عذاب نہ دے اُس کا سا کوئی"
  },
  {
    "surah_id": 89,
    "ayah_number": 26,
    "global_ayah_id": 6107,
    "translation": "اور نہ باندھ کر رکھے اُس کا سا باندھنا کوئی"
  },
  {
    "surah_id": 89,
    "ayah_number": 27,
    "global_ayah_id": 6108,
    "translation": "اے وہ جی جس نے چین پکڑ لیا"
  },
  {
    "surah_id": 89,
    "ayah_number": 28,
    "global_ayah_id": 6109,
    "translation": "پھر چل اپنے رب کی طرف تو اس سے راضی وہ تجھ سے راضی"
  },
  {
    "surah_id": 89,
    "ayah_number": 29,
    "global_ayah_id": 6110,
    "translation": "پھر شامل ہو میرے بندوں میں"
  },
  {
    "surah_id": 89,
    "ayah_number": 30,
    "global_ayah_id": 6111,
    "translation": "اور داخل ہو میری بہشت میں"
  }
]