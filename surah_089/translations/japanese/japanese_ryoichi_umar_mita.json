[
  {
    "surah_id": 89,
    "ayah_number": 1,
    "global_ayah_id": 5994,
    "translation": "暁において，"
  },
  {
    "surah_id": 89,
    "ayah_number": 2,
    "global_ayah_id": 5995,
    "translation": "10夜において，"
  },
  {
    "surah_id": 89,
    "ayah_number": 3,
    "global_ayah_id": 5996,
    "translation": "偶数と奇数において，"
  },
  {
    "surah_id": 89,
    "ayah_number": 4,
    "global_ayah_id": 5997,
    "translation": "去り行く夜において（誓う）。"
  },
  {
    "surah_id": 89,
    "ayah_number": 5,
    "global_ayah_id": 5998,
    "translation": "本当にこの中には，分別ある者への誓いがあるではないか。"
  },
  {
    "surah_id": 89,
    "ayah_number": 6,
    "global_ayah_id": 5999,
    "translation": "あなたはアッラーが，如何にアード（の民）を処分されたかを考えないのか，"
  },
  {
    "surah_id": 89,
    "ayah_number": 7,
    "global_ayah_id": 6000,
    "translation": "円柱の並び立つイラム（の都）のことを，"
  },
  {
    "surah_id": 89,
    "ayah_number": 8,
    "global_ayah_id": 6001,
    "translation": "これに類するものは，その国において造られたことはなかったではないか。"
  },
  {
    "surah_id": 89,
    "ayah_number": 9,
    "global_ayah_id": 6002,
    "translation": "また谷間の岩に彫り込んだサムード（の民）や，"
  },
  {
    "surah_id": 89,
    "ayah_number": 10,
    "global_ayah_id": 6003,
    "translation": "杭のぬしフィルアゥン（のことを考えないのか）。"
  },
  {
    "surah_id": 89,
    "ayah_number": 11,
    "global_ayah_id": 6004,
    "translation": "これらは（凡て），その国において法を越えた者たちで，"
  },
  {
    "surah_id": 89,
    "ayah_number": 12,
    "global_ayah_id": 6005,
    "translation": "その地に邪悪を増長させた。"
  },
  {
    "surah_id": 89,
    "ayah_number": 13,
    "global_ayah_id": 6006,
    "translation": "それであなたの主は，懲罰の鞭をかれらに浴びせかけられた。"
  },
  {
    "surah_id": 89,
    "ayah_number": 14,
    "global_ayah_id": 6007,
    "translation": "本当にあなたの主は監視の塔におられる。"
  },
  {
    "surah_id": 89,
    "ayah_number": 15,
    "global_ayah_id": 6008,
    "translation": "さて人間は主が御試みのため，寛大にされ恵みを授けられると，かれは，「主は，わたしに寛大であられます。」と言う。"
  },
  {
    "surah_id": 89,
    "ayah_number": 16,
    "global_ayah_id": 6009,
    "translation": "だがかれを試み，御恵みを減らされる時は，「主はわたしを，軽視なさいます。」と言う。"
  },
  {
    "surah_id": 89,
    "ayah_number": 17,
    "global_ayah_id": 6010,
    "translation": "断じていけない。いや，あなたがたは孤児を大切にしない。"
  },
  {
    "surah_id": 89,
    "ayah_number": 18,
    "global_ayah_id": 6011,
    "translation": "また貧者を養うために，互いに励まさない。"
  },
  {
    "surah_id": 89,
    "ayah_number": 19,
    "global_ayah_id": 6012,
    "translation": "しかも遺産を取り上げ，強欲を欲しい尽にする。"
  },
  {
    "surah_id": 89,
    "ayah_number": 20,
    "global_ayah_id": 6013,
    "translation": "またあなたがたは，法外な愛で財産を愛する。"
  },
  {
    "surah_id": 89,
    "ayah_number": 21,
    "global_ayah_id": 6014,
    "translation": "断じていけない。大地が粉々に砕かれる時，"
  },
  {
    "surah_id": 89,
    "ayah_number": 22,
    "global_ayah_id": 6015,
    "translation": "主は，列また列の天使（を従え），来臨なされる。"
  },
  {
    "surah_id": 89,
    "ayah_number": 23,
    "global_ayah_id": 6016,
    "translation": "また地獄は，その日（目の当たりに）運ばれ，その日人間は反省するであろう。だが反省したとて，どうしてかれのためになろうか。"
  },
  {
    "surah_id": 89,
    "ayah_number": 24,
    "global_ayah_id": 6017,
    "translation": "かれは，「ああ，わたしの（将来の）生命のために，（善行を）貯えていたならば。」と言う。"
  },
  {
    "surah_id": 89,
    "ayah_number": 25,
    "global_ayah_id": 6018,
    "translation": "それでその日，誰もなし得ない程の懲罰を加えられ，"
  },
  {
    "surah_id": 89,
    "ayah_number": 26,
    "global_ayah_id": 6019,
    "translation": "また誰も拘束し得ない程に束縛なされる。"
  },
  {
    "surah_id": 89,
    "ayah_number": 27,
    "global_ayah_id": 6020,
    "translation": "（善行を積んだ魂に言われるであろう。）おお，安心，大悟している魂よ，"
  },
  {
    "surah_id": 89,
    "ayah_number": 28,
    "global_ayah_id": 6021,
    "translation": "あなたの主に返れ，歓喜し御満悦にあずかって。"
  },
  {
    "surah_id": 89,
    "ayah_number": 29,
    "global_ayah_id": 6022,
    "translation": "あなたは，わがしもべの中に入れ。"
  },
  {
    "surah_id": 89,
    "ayah_number": 30,
    "global_ayah_id": 6023,
    "translation": "あなたは，わが楽園に入れ。"
  }
]