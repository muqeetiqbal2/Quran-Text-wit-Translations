[
  {
    "surah_id": 89,
    "ayah_number": 1,
    "global_ayah_id": 5994,
    "translation": "誓以黎明，"
  },
  {
    "surah_id": 89,
    "ayah_number": 2,
    "global_ayah_id": 5995,
    "translation": "與十夜，"
  },
  {
    "surah_id": 89,
    "ayah_number": 3,
    "global_ayah_id": 5996,
    "translation": "與偶數和奇數，"
  },
  {
    "surah_id": 89,
    "ayah_number": 4,
    "global_ayah_id": 5997,
    "translation": "與離去的黑夜，"
  },
  {
    "surah_id": 89,
    "ayah_number": 5,
    "global_ayah_id": 5998,
    "translation": "對於有理智者，此中有一種盟誓嗎？"
  },
  {
    "surah_id": 89,
    "ayah_number": 6,
    "global_ayah_id": 5999,
    "translation": "難道你不知道你的主怎樣懲治阿德人——"
  },
  {
    "surah_id": 89,
    "ayah_number": 7,
    "global_ayah_id": 6000,
    "translation": "有高柱的伊賴姆人嗎？"
  },
  {
    "surah_id": 89,
    "ayah_number": 8,
    "global_ayah_id": 6001,
    "translation": "像那樣的人，在別的城市裡還沒有被創造過的——"
  },
  {
    "surah_id": 89,
    "ayah_number": 9,
    "global_ayah_id": 6002,
    "translation": "怎樣懲治在山谷裡鑿石為家的賽莫德人，"
  },
  {
    "surah_id": 89,
    "ayah_number": 10,
    "global_ayah_id": 6003,
    "translation": "怎樣懲治有武力的法老。"
  },
  {
    "surah_id": 89,
    "ayah_number": 11,
    "global_ayah_id": 6004,
    "translation": "這等人曾在國中放肆，"
  },
  {
    "surah_id": 89,
    "ayah_number": 12,
    "global_ayah_id": 6005,
    "translation": "乃多行不義，"
  },
  {
    "surah_id": 89,
    "ayah_number": 13,
    "global_ayah_id": 6006,
    "translation": "故你的主把一種刑罰，傾注在他們身上。"
  },
  {
    "surah_id": 89,
    "ayah_number": 14,
    "global_ayah_id": 6007,
    "translation": "你的主，確是監視的。"
  },
  {
    "surah_id": 89,
    "ayah_number": 15,
    "global_ayah_id": 6008,
    "translation": "至於人，當他的主考驗他，故優待他，而且使他過安逸生活的時候，他說：「我的主優待我了。」"
  },
  {
    "surah_id": 89,
    "ayah_number": 16,
    "global_ayah_id": 6009,
    "translation": "當他考驗他，故節約他的給養的時候，他說：「我的主凌辱我了。」"
  },
  {
    "surah_id": 89,
    "ayah_number": 17,
    "global_ayah_id": 6010,
    "translation": "絕不然！但你們不優待孤兒，"
  },
  {
    "surah_id": 89,
    "ayah_number": 18,
    "global_ayah_id": 6011,
    "translation": "你們不以濟貧相勉勵，"
  },
  {
    "surah_id": 89,
    "ayah_number": 19,
    "global_ayah_id": 6012,
    "translation": "你們侵吞遺產，"
  },
  {
    "surah_id": 89,
    "ayah_number": 20,
    "global_ayah_id": 6013,
    "translation": "你們酷愛錢財。"
  },
  {
    "surah_id": 89,
    "ayah_number": 21,
    "global_ayah_id": 6014,
    "translation": "絕不然！當大地震動復震動，"
  },
  {
    "surah_id": 89,
    "ayah_number": 22,
    "global_ayah_id": 6015,
    "translation": "你的主的命令，和排班的天神，同齊來臨的時候，"
  },
  {
    "surah_id": 89,
    "ayah_number": 23,
    "global_ayah_id": 6016,
    "translation": "在那日，火獄將被拿來；在那日，人將覺悟，但覺悟於他有何裨益呢？"
  },
  {
    "surah_id": 89,
    "ayah_number": 24,
    "global_ayah_id": 6017,
    "translation": "他將說：「但願我在世的時候曾行善事。」"
  },
  {
    "surah_id": 89,
    "ayah_number": 25,
    "global_ayah_id": 6018,
    "translation": "在那日，任何人，不用他的那種刑罰懲治別人；"
  },
  {
    "surah_id": 89,
    "ayah_number": 26,
    "global_ayah_id": 6019,
    "translation": "任何人，不用他的那種束縛束縛別人。"
  },
  {
    "surah_id": 89,
    "ayah_number": 27,
    "global_ayah_id": 6020,
    "translation": "安定的靈魂啊！"
  },
  {
    "surah_id": 89,
    "ayah_number": 28,
    "global_ayah_id": 6021,
    "translation": "你應當喜悅地，被喜悅地歸於你的主。"
  },
  {
    "surah_id": 89,
    "ayah_number": 29,
    "global_ayah_id": 6022,
    "translation": "你應當入在我的眾僕裡；"
  },
  {
    "surah_id": 89,
    "ayah_number": 30,
    "global_ayah_id": 6023,
    "translation": "你應當入在我的樂園裡。"
  }
]