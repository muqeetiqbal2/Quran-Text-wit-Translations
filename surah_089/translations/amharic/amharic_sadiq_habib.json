[
  {
    "surah_id": 89,
    "ayah_number": 1,
    "global_ayah_id": 5994,
    "translation": "በጎህ እምላለሁ፡፡"
  },
  {
    "surah_id": 89,
    "ayah_number": 2,
    "global_ayah_id": 5995,
    "translation": "በዐሥር ሌሊቶችም፡፡"
  },
  {
    "surah_id": 89,
    "ayah_number": 3,
    "global_ayah_id": 5996,
    "translation": "በጥንዱም በነጠላውም፡፡"
  },
  {
    "surah_id": 89,
    "ayah_number": 4,
    "global_ayah_id": 5997,
    "translation": "በሌሊቱም በሚኼድ ጊዜ፡፡"
  },
  {
    "surah_id": 89,
    "ayah_number": 5,
    "global_ayah_id": 5998,
    "translation": "በዚህ (መሓላ) ለባለ አእምሮ ታላቅ መሓላ አለበትን?"
  },
  {
    "surah_id": 89,
    "ayah_number": 6,
    "global_ayah_id": 5999,
    "translation": "ጌታህ በዓድ እንዴት እንደ ሠራ አታውቅምን?"
  },
  {
    "surah_id": 89,
    "ayah_number": 7,
    "global_ayah_id": 6000,
    "translation": "በኢረም በባለ ረዣዢሚቱ አዕማድ፡፡"
  },
  {
    "surah_id": 89,
    "ayah_number": 8,
    "global_ayah_id": 6001,
    "translation": "በዚያች ብጤዋ በአገሮች ውስጥ ያልተፈጠረ በኾነችው፡፡"
  },
  {
    "surah_id": 89,
    "ayah_number": 9,
    "global_ayah_id": 6002,
    "translation": "በሰሙድም በእነዚያ በሸለቆው ቋጥኝን የቆረጡ በኾኑት፡፡"
  },
  {
    "surah_id": 89,
    "ayah_number": 10,
    "global_ayah_id": 6003,
    "translation": "በፈርዖንም ባለ ችካሎች በኾነው፡፡"
  },
  {
    "surah_id": 89,
    "ayah_number": 11,
    "global_ayah_id": 6004,
    "translation": "በእነዚያ በአገሮች ላይ ግፍ የሠሩ፡፡"
  },
  {
    "surah_id": 89,
    "ayah_number": 12,
    "global_ayah_id": 6005,
    "translation": "በእርሷም ውስጥ ጥፋትን ያበዙ በኾኑት (እንዴት እንደሠራ አታውቅምን?)"
  },
  {
    "surah_id": 89,
    "ayah_number": 13,
    "global_ayah_id": 6006,
    "translation": "በእነርሱ ላይም ጌታህ የቅጣትን አለንጋ አወረደባቸው፡፡"
  },
  {
    "surah_id": 89,
    "ayah_number": 14,
    "global_ayah_id": 6007,
    "translation": "ጌታህ በመጠባበቂያ ላይ ነውና፡፡"
  },
  {
    "surah_id": 89,
    "ayah_number": 15,
    "global_ayah_id": 6008,
    "translation": "ሰውማ ጌታው በሞከረው ጊዜ፣ ባከበረውና ባጣቀመውም (ጊዜ) «ጌታዬ አከበረኝ (አበለጠኝ)» ይላል፡፡"
  },
  {
    "surah_id": 89,
    "ayah_number": 16,
    "global_ayah_id": 6009,
    "translation": "በሞከረውና በእርሱ ላይ ሲሳዩን ባጠበበ ጊዜማ «ጌታዬ አሳነሰኝ» ይላል፡፡"
  },
  {
    "surah_id": 89,
    "ayah_number": 17,
    "global_ayah_id": 6010,
    "translation": "ይከልከል፤ ይልቁንም የቲምን አታከብሩም፡፡"
  },
  {
    "surah_id": 89,
    "ayah_number": 18,
    "global_ayah_id": 6011,
    "translation": "ድኻንም በማብላት ላይ አትታዘዙም፡፡"
  },
  {
    "surah_id": 89,
    "ayah_number": 19,
    "global_ayah_id": 6012,
    "translation": "የውርስንም ገንዘብ የመሰብሰብን አበላል ትበላላችሁ፡፡"
  },
  {
    "surah_id": 89,
    "ayah_number": 20,
    "global_ayah_id": 6013,
    "translation": "ገንዘብንም ብዙን መውደድ ትወዳላችሁ፡፡"
  },
  {
    "surah_id": 89,
    "ayah_number": 21,
    "global_ayah_id": 6014,
    "translation": "ተዉ፤ ምድር ደጋግማ በተሰባበረች ጊዜ፤"
  },
  {
    "surah_id": 89,
    "ayah_number": 22,
    "global_ayah_id": 6015,
    "translation": "መላእክትም ሰልፍ ሰልፍ ኾነው ጌታህ (ትዕዛዙ) በመጣ ጊዜ፤"
  },
  {
    "surah_id": 89,
    "ayah_number": 23,
    "global_ayah_id": 6016,
    "translation": "ገሀነምም በዚያ ቀን በተመጣች ጊዜ በዚያ ቀን ሰው (ጥፋቱን) ይገነዘባል፡፡ መገንዘብም ለእርሱ ከየቱ?"
  },
  {
    "surah_id": 89,
    "ayah_number": 24,
    "global_ayah_id": 6017,
    "translation": "«ዋ እኔ! ምነው በሕይወቴ (መልካምን ሥራ) ባስቀደምኩ ኖሮ» ይላል፡፡"
  },
  {
    "surah_id": 89,
    "ayah_number": 25,
    "global_ayah_id": 6018,
    "translation": "በዚያ ቀንም የርሱን አቀጣጥ አንድም አይቀጣም፡፡"
  },
  {
    "surah_id": 89,
    "ayah_number": 26,
    "global_ayah_id": 6019,
    "translation": "የእርሱንም አስተሳሰር አንድም አያስርም፡፡"
  },
  {
    "surah_id": 89,
    "ayah_number": 27,
    "global_ayah_id": 6020,
    "translation": "(ለአመነች ነፍስም) «አንቺ የረካሺው ነፍስ ሆይ!"
  },
  {
    "surah_id": 89,
    "ayah_number": 28,
    "global_ayah_id": 6021,
    "translation": "«ወዳጅ ተወዳጅ ኾነሽ ወደ ጌታሽ ተመለሺ፡፡"
  },
  {
    "surah_id": 89,
    "ayah_number": 29,
    "global_ayah_id": 6022,
    "translation": "«በባሮቼም ውስጥ ግቢ፡፡"
  },
  {
    "surah_id": 89,
    "ayah_number": 30,
    "global_ayah_id": 6023,
    "translation": "ገነቴንም ግቢ፤» (ትባላለች)፡፡"
  }
]