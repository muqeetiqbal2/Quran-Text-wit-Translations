[
  {
    "surah_id": 56,
    "ayah_number": 1,
    "global_ayah_id": 4980,
    "translation": "மாபெரும் நிகழ்ச்சி(யான இறுதிநாள்) ஏற்பட்டால்"
  },
  {
    "surah_id": 56,
    "ayah_number": 2,
    "global_ayah_id": 4981,
    "translation": "அந்நிகழ்ச்சியைப் பொய்யாக்குவது எதுவுமில்லை."
  },
  {
    "surah_id": 56,
    "ayah_number": 3,
    "global_ayah_id": 4982,
    "translation": "அது (தீயோரைத்) தாழ்த்தி விடும், (நல்லோரை) உயர்த்தி விடும்."
  },
  {
    "surah_id": 56,
    "ayah_number": 4,
    "global_ayah_id": 4983,
    "translation": "பூமி நடுக்கத்தால் நடுக்கமடையச் செய்யும் போது."
  },
  {
    "surah_id": 56,
    "ayah_number": 5,
    "global_ayah_id": 4984,
    "translation": "இன்னும் மலைகள் தூள் தூளாக ஆக்கப்படும் போது,"
  },
  {
    "surah_id": 56,
    "ayah_number": 6,
    "global_ayah_id": 4985,
    "translation": "பின்னர், அது பரப்பப்பட்ட புழுதி ஆகிவிடும்."
  },
  {
    "surah_id": 56,
    "ayah_number": 7,
    "global_ayah_id": 4986,
    "translation": "(அப்போது) நீங்களும் மூன்று பிரிவினர்களாகி விடுவீர்கள்."
  },
  {
    "surah_id": 56,
    "ayah_number": 8,
    "global_ayah_id": 4987,
    "translation": "(முதலாமவர்) வலது பாரிசத்திலுள்ளோர் - வலது பாரிசத்துக்காரர் யார்? (என்பதை அறிவீர்களா?)"
  },
  {
    "surah_id": 56,
    "ayah_number": 9,
    "global_ayah_id": 4988,
    "translation": "(இரண்டாமவர்) இடது பாரிசத்திலுள்ளோர் - இடது பாரிசத்திலுள்ளோர் யார்? (என அறிவீர்களா?)"
  },
  {
    "surah_id": 56,
    "ayah_number": 10,
    "global_ayah_id": 4989,
    "translation": "(மூன்றாமவர் நம்பிக்கையில்) முந்தியவர்கள் (மறுமையிலும்) முந்தியவர்களே யாவார்கள்."
  },
  {
    "surah_id": 56,
    "ayah_number": 11,
    "global_ayah_id": 4990,
    "translation": "இவர்கள் (இறைவனுக்கு) அண்மையிலாக்கப்பட்டவர்கள்."
  },
  {
    "surah_id": 56,
    "ayah_number": 12,
    "global_ayah_id": 4991,
    "translation": "இவர்கள் பாக்கியங்களுள்ள (சுவனச்) சோலைகளில் இருப்பர்."
  },
  {
    "surah_id": 56,
    "ayah_number": 13,
    "global_ayah_id": 4992,
    "translation": "முதலாமவரில் ஒரு பெருங் கூட்டத்தினரும்,"
  },
  {
    "surah_id": 56,
    "ayah_number": 14,
    "global_ayah_id": 4993,
    "translation": "பின்னவர்களில், ஒரு சொற்பத்தொகையினரும் -"
  },
  {
    "surah_id": 56,
    "ayah_number": 15,
    "global_ayah_id": 4994,
    "translation": "(பொன்னிழைகளால்) ஆக்கப் பெற்ற கட்டில்களின் மீது -"
  },
  {
    "surah_id": 56,
    "ayah_number": 16,
    "global_ayah_id": 4995,
    "translation": "ஒருவரையொருவர் முன்னோக்கியவாகளாக, அவற்றின் மீது சாய்ந்திருப்பார்கள்."
  },
  {
    "surah_id": 56,
    "ayah_number": 17,
    "global_ayah_id": 4996,
    "translation": "நிலையான இளமையுடைய இளைஞர்கள் (இவர்கள் பணிக்காகச்) சுற்றிக் கொண்டே இருப்பார்கள்."
  },
  {
    "surah_id": 56,
    "ayah_number": 18,
    "global_ayah_id": 4997,
    "translation": "தெளிந்த பானங்களால் நிறம்பிய கிண்ணங்களையும், கெண்டிகளையும், குவளைகளையும் கொண்டு (அவர்களிடம் சுற்றி வருவார்கள்)."
  },
  {
    "surah_id": 56,
    "ayah_number": 19,
    "global_ayah_id": 4998,
    "translation": "(அப்பானங்களைப் பருகும்) அவர்கள் அவற்றினால் தலை நோய்க்காளாக மாட்டார்கள், மதிமயங்கவுமாட்டார்கள்."
  },
  {
    "surah_id": 56,
    "ayah_number": 20,
    "global_ayah_id": 4999,
    "translation": "இன்னும் அவர்கள் தெரிந்தெடுக்கும் கனி வகைகளையும் -"
  },
  {
    "surah_id": 56,
    "ayah_number": 21,
    "global_ayah_id": 5000,
    "translation": "விரும்பும் பட்சிகளின் மாமிசத்தையும் (கொண்டு அவ்விளைஞர்கள் வருவார்கள்)."
  },
  {
    "surah_id": 56,
    "ayah_number": 22,
    "global_ayah_id": 5001,
    "translation": "(அங்கு இவர்களுக்கு) ஹூருல் ஈன் (என்னும் நெடிய கண்களுடைய) கன்னியர் இருப்பர்."
  },
  {
    "surah_id": 56,
    "ayah_number": 23,
    "global_ayah_id": 5002,
    "translation": "மறைக்கப்பட்ட முத்துக்களைப் போல் அவர்கள் (இருப்பார்கள்)."
  },
  {
    "surah_id": 56,
    "ayah_number": 24,
    "global_ayah_id": 5003,
    "translation": "(இவையாவும்) சுவர்க்க வாசிகள் (இம்மையில் செய்து கொண்டிருந்த) செயல்களுக்கு கூலியாகும்."
  },
  {
    "surah_id": 56,
    "ayah_number": 25,
    "global_ayah_id": 5004,
    "translation": "அங்கு இவர்கள் வீணானதையும், பாவமுண்டாக்குவதையும் (கொண்ட பேச்சுகளைச்) செவியுற மாட்டார்கள்."
  },
  {
    "surah_id": 56,
    "ayah_number": 26,
    "global_ayah_id": 5005,
    "translation": "'ஸலாம், ஸலாம்' என்னும் சொல்லையே (செவியுறுவார்கள்)."
  },
  {
    "surah_id": 56,
    "ayah_number": 27,
    "global_ayah_id": 5006,
    "translation": "இன்னும் வலப்புறத்தார்கள் - வலப்புறத்தார்கள் யார்? (என்பதை அறிவீர்களா?)"
  },
  {
    "surah_id": 56,
    "ayah_number": 28,
    "global_ayah_id": 5007,
    "translation": "(அவர்கள்) முள்ளில்லாத இலந்தை மரத்தின் கீழும்:"
  },
  {
    "surah_id": 56,
    "ayah_number": 29,
    "global_ayah_id": 5008,
    "translation": "(நுனி முதல் அடிவரை) குலை குலையாகப் பழங்களுடை வாழை மரத்தின் கீழும்:"
  },
  {
    "surah_id": 56,
    "ayah_number": 30,
    "global_ayah_id": 5009,
    "translation": "இன்னும், நீண்ட நிழலிலும்,"
  },
  {
    "surah_id": 56,
    "ayah_number": 31,
    "global_ayah_id": 5010,
    "translation": "(சதா) ஒலித்தோடிக் கொண்டிருக்கும் நீரின் அருகிலும்,"
  },
  {
    "surah_id": 56,
    "ayah_number": 32,
    "global_ayah_id": 5011,
    "translation": "ஏராளமான கனிவகைகளின் மத்தியிலும் -"
  },
  {
    "surah_id": 56,
    "ayah_number": 33,
    "global_ayah_id": 5012,
    "translation": "அவை அற்றுப் போகாதவை, (உண்ணத்) தடுக்கப்படாதவை -"
  },
  {
    "surah_id": 56,
    "ayah_number": 34,
    "global_ayah_id": 5013,
    "translation": "மேலும், உன்னதமான விரிப்புகளில் (அமர்ந்திருப்பர்)."
  },
  {
    "surah_id": 56,
    "ayah_number": 35,
    "global_ayah_id": 5014,
    "translation": "நிச்சயமாக (ஹூருல் ஈன் என்னும் பெண்களைப்) புதிய படைப்பாக, நாம் உண்டாக்கி,"
  },
  {
    "surah_id": 56,
    "ayah_number": 36,
    "global_ayah_id": 5015,
    "translation": "அப்பெண்களைக் கன்னிகளாகவும்,"
  },
  {
    "surah_id": 56,
    "ayah_number": 37,
    "global_ayah_id": 5016,
    "translation": "(தம் துணைவர் மீது) பாசமுடையோராகவும், சம வயதினராகவும்,"
  },
  {
    "surah_id": 56,
    "ayah_number": 38,
    "global_ayah_id": 5017,
    "translation": "வலப்புறத்தோருக்காக (ஆக்கி வைத்துள்ளோம்)."
  },
  {
    "surah_id": 56,
    "ayah_number": 39,
    "global_ayah_id": 5018,
    "translation": "முன்னுள்ளோரில் ஒரு கூட்டமும்,"
  },
  {
    "surah_id": 56,
    "ayah_number": 40,
    "global_ayah_id": 5019,
    "translation": "பின்னுள்ளோரில் ஒரு கூட்டமும் (வலப்புறத்தோராக இருப்பார்கள்)."
  },
  {
    "surah_id": 56,
    "ayah_number": 41,
    "global_ayah_id": 5020,
    "translation": "இடது பாரிசத்திலுள்ளவர்களோ இடது பாரிசத்திலுள்ளவர்கள் யார்? (என்று அறிவீர்களா?)"
  },
  {
    "surah_id": 56,
    "ayah_number": 42,
    "global_ayah_id": 5021,
    "translation": "(அவர்கள்) கொடிய அனல் காற்றிலும், கொதிக்கும் நீரிலும் -"
  },
  {
    "surah_id": 56,
    "ayah_number": 43,
    "global_ayah_id": 5022,
    "translation": "அடர்ந்து இருண்ட புகையின் நிழலிலும் இருப்பார்கள்."
  },
  {
    "surah_id": 56,
    "ayah_number": 44,
    "global_ayah_id": 5023,
    "translation": "(அங்கு) குளிர்ச்சியுமில்லை, நலமுமில்லை."
  },
  {
    "surah_id": 56,
    "ayah_number": 45,
    "global_ayah_id": 5024,
    "translation": "நிச்சயமாக அவர்கள் இதற்கு முன்னர் (உலகத்தில்) சுகபோகிகளாக இருந்தனர்."
  },
  {
    "surah_id": 56,
    "ayah_number": 46,
    "global_ayah_id": 5025,
    "translation": "ஆனால், அவர்கள் பெரும் பாவத்தின் மீது நிலைத்தும் இருந்தனர்."
  },
  {
    "surah_id": 56,
    "ayah_number": 47,
    "global_ayah_id": 5026,
    "translation": "மேலும், அவர்கள், \"நாம் மரித்து மண்ணாகவும், எலும்புகளாகவும் ஆகி விட்டாலும், நாம் மீண்டும் நிச்சயமாக எழுப்பப்படுவோமா?\" என்று கேட்டுக் கொண்டு இருந்தனர்."
  },
  {
    "surah_id": 56,
    "ayah_number": 48,
    "global_ayah_id": 5027,
    "translation": "\"அல்லது, முன்னோர்களான நம் தந்தையருமா? (எழுப்பப்படுவர்?\" என்றும் கூறினர்.)"
  },
  {
    "surah_id": 56,
    "ayah_number": 49,
    "global_ayah_id": 5028,
    "translation": "(நபியே!) நீர் கூறும்: \"(நிச்சயமாக உங்களில்) முன்னோர்களும், பின்னோர்களும்."
  },
  {
    "surah_id": 56,
    "ayah_number": 50,
    "global_ayah_id": 5029,
    "translation": "\"குறிப்பிட்ட நாளின் ஒரு நேரத்தில் (நீங்கள் யாவரும்) ஒன்று கூட்டப்படுவீர்கள்."
  },
  {
    "surah_id": 56,
    "ayah_number": 51,
    "global_ayah_id": 5030,
    "translation": "அதற்குப் பின்னர்: \"பொய்யர்களாகிய வழி கேடர்களே! நிச்சயமாக நீங்கள்,"
  },
  {
    "surah_id": 56,
    "ayah_number": 52,
    "global_ayah_id": 5031,
    "translation": "ஜக்கூம் (என்னும் கள்ளி) மரத்திலிருந்தே நீங்கள் புசிப்பவர்கள்."
  },
  {
    "surah_id": 56,
    "ayah_number": 53,
    "global_ayah_id": 5032,
    "translation": "ஆகவே, \"அதைக் கொண்டே வயிறுகளை நிரப்புவீர்கள்."
  },
  {
    "surah_id": 56,
    "ayah_number": 54,
    "global_ayah_id": 5033,
    "translation": "அப்புறம் அதன்மேல் கொதிக்கும் நீரையே குடிப்பீர்கள்."
  },
  {
    "surah_id": 56,
    "ayah_number": 55,
    "global_ayah_id": 5034,
    "translation": "\"பின்னும் ஹீம் - தாகமுள்ள ஒட்டகை குடிப்பதைப் போல் குடிப்பீர்கள்.\""
  },
  {
    "surah_id": 56,
    "ayah_number": 56,
    "global_ayah_id": 5035,
    "translation": "இதுதான் நியாயத் தீர்ப்பு நாளில் அவர்களுக்கு விருந்தாகும்."
  },
  {
    "surah_id": 56,
    "ayah_number": 57,
    "global_ayah_id": 5036,
    "translation": "நாமே உங்களைப் படைத்தோம். எனவே, (நாம் கூறுவதை) நீங்கள் உண்மையென்று நம்ப வேண்டாமா?"
  },
  {
    "surah_id": 56,
    "ayah_number": 58,
    "global_ayah_id": 5037,
    "translation": "(கர்ப்பப் பையில்) நீங்கள் செலுத்தும் இந்திரியத்தைக் கவனித்தீர்களா?"
  },
  {
    "surah_id": 56,
    "ayah_number": 59,
    "global_ayah_id": 5038,
    "translation": "அதை நீங்கள் படைக்கிறீர்களா? அல்லது நாம் படைக்கின்றோமா?"
  },
  {
    "surah_id": 56,
    "ayah_number": 60,
    "global_ayah_id": 5039,
    "translation": "உங்களுக்கிடையில் மரணத்தையும் நாமே ஏற்படுத்தியுள்ளோம், எனவே நம்மை எவரும் மிகைக்க முடியாது."
  },
  {
    "surah_id": 56,
    "ayah_number": 61,
    "global_ayah_id": 5040,
    "translation": "(அன்றியும் உங்களைப் போக்கி விட்டு) உங்கள் போன்றோரை பதிலாகக் கொண்டு வந்து நீங்கள் அறியாத உருவத்தில் உங்களை உண்டாக்கவும் (நாம் இயலாதவர்கள் அல்ல)."
  },
  {
    "surah_id": 56,
    "ayah_number": 62,
    "global_ayah_id": 5041,
    "translation": "முதல் முறையாக (நாம் உங்களைப்) படைத்தது பற்றி நிச்சயமாக நீங்கள் அறிவீர்கள் - எனவே (அதிலிருந்து நினைவு கூர்ந்து) நீங்கள் உணர்வு பெற வேண்டாமா?"
  },
  {
    "surah_id": 56,
    "ayah_number": 63,
    "global_ayah_id": 5042,
    "translation": "(இப்பூமியில்) விதைப்பதை நீங்கள் கவனித்தீர்களா?"
  },
  {
    "surah_id": 56,
    "ayah_number": 64,
    "global_ayah_id": 5043,
    "translation": "அதனை நீங்கள் முளைக்கச் செய்கின்றீர்களா? அல்லது நாம் முளைக்கச் செய்கின்றோமா?"
  },
  {
    "surah_id": 56,
    "ayah_number": 65,
    "global_ayah_id": 5044,
    "translation": "நாம் நாடினால் திட்டமாக அதனைக் கூளமாய் ஆக்கிவிடுவோம் - அப்பால் நீங்கள் ஆச்சரியப்பட்டுக் கொண்டு இருப்பீர்கள்."
  },
  {
    "surah_id": 56,
    "ayah_number": 66,
    "global_ayah_id": 5045,
    "translation": "\"நிச்சயமாக நாம் கடன் பட்டவர்களாகி விட்டோம்."
  },
  {
    "surah_id": 56,
    "ayah_number": 67,
    "global_ayah_id": 5046,
    "translation": "\"மேலும், (பயிர்களிலிருந்து எதுவும் பெற முடியாதவர்களாகத்) தடுக்கப்பட்டு விட்டோம்\" (என்றும் கூறிக் கொண்டிருப்பீர்கள்)."
  },
  {
    "surah_id": 56,
    "ayah_number": 68,
    "global_ayah_id": 5047,
    "translation": "அன்றியும், நீங்கள் குடிக்கும் நீரைக் கவனித்தீர்களா?"
  },
  {
    "surah_id": 56,
    "ayah_number": 69,
    "global_ayah_id": 5048,
    "translation": "மேகத்திலிருந்து அதை நீங்கள் இறக்கினீர்களா? அல்லது நாம் இறக்குகிறோமா?"
  },
  {
    "surah_id": 56,
    "ayah_number": 70,
    "global_ayah_id": 5049,
    "translation": "நாம் நாடினால், அதைக் கைப்புள்ள தாக்கியிருப்போம்; (இவற்றுக்கெல்லாம்) நீங்கள் நன்றி செலுத்த வேண்டாமா?"
  },
  {
    "surah_id": 56,
    "ayah_number": 71,
    "global_ayah_id": 5050,
    "translation": "நீங்கள் மூட்டும் நெருப்பை கவனித்தீர்களா?"
  },
  {
    "surah_id": 56,
    "ayah_number": 72,
    "global_ayah_id": 5051,
    "translation": "அதன் மரத்தை நீங்கள் உண்டாக்கினீர்களா? அல்லது நாம் உண்டு பண்ணுகிறோமா?"
  },
  {
    "surah_id": 56,
    "ayah_number": 73,
    "global_ayah_id": 5052,
    "translation": "நாம் அதனை நினைவூட்டுவதாகவும், பயணிகளுக்கு பயனளிக்கப்பதற்காகவும் உண்டாக்கினோம்."
  },
  {
    "surah_id": 56,
    "ayah_number": 74,
    "global_ayah_id": 5053,
    "translation": "ஆகவே, மகத்தான உம்முடைய ரப்பின் திருநாமத்தைக் கொண்டு தஸ்பீஹு செய்வீராக."
  },
  {
    "surah_id": 56,
    "ayah_number": 75,
    "global_ayah_id": 5054,
    "translation": "நட்சத்திர மண்டலங்களின் மீது நான் சத்தியம் செய்கிறேன்."
  },
  {
    "surah_id": 56,
    "ayah_number": 76,
    "global_ayah_id": 5055,
    "translation": "நீங்கள் அறீவீர்களாயின் நிச்சயமாக இது மகத்தான் பிரமாணமாகும்."
  },
  {
    "surah_id": 56,
    "ayah_number": 77,
    "global_ayah_id": 5056,
    "translation": "நீச்சயமாக, இது மிகவும் கண்ணியமும் சங்கையும் மிக்க குர்ஆன் ஆகும்."
  },
  {
    "surah_id": 56,
    "ayah_number": 78,
    "global_ayah_id": 5057,
    "translation": "பாதுகாக்கப்பட்ட ஏட்டில் இருக்கிறது."
  },
  {
    "surah_id": 56,
    "ayah_number": 79,
    "global_ayah_id": 5058,
    "translation": "தூய்மையானவர்களைத் தவிர (வேறெவரும்) இதனைத் தொட மாட்டார்கள்."
  },
  {
    "surah_id": 56,
    "ayah_number": 80,
    "global_ayah_id": 5059,
    "translation": "அகிலத்தாரின் இறைவனால் இது இறக்கியருளப்பட்டது."
  },
  {
    "surah_id": 56,
    "ayah_number": 81,
    "global_ayah_id": 5060,
    "translation": "அவ்வாறிருந்தும், (குர்ஆனின் மகத்தான) இச்செய்தி பற்றி நீங்கள் அலட்சியமாக இருக்கிறீர்களா?"
  },
  {
    "surah_id": 56,
    "ayah_number": 82,
    "global_ayah_id": 5061,
    "translation": "நீங்கள் பொய்ப்பிப்பதை (இறைவன் தந்த) உங்கள் பாக்கியங்களுக்கு (நன்றியாக) ஆக்குகின்றீர்களா?"
  },
  {
    "surah_id": 56,
    "ayah_number": 83,
    "global_ayah_id": 5062,
    "translation": "மரணத் தறுவாயில் ஒருவனின் (உயிர்) தொண்டைக் குழியை அடையும் போது -"
  },
  {
    "surah_id": 56,
    "ayah_number": 84,
    "global_ayah_id": 5063,
    "translation": "அந்நேரம் நீங்கள் பார்த்துக் கொண்டிருக்கிறீர்கள்."
  },
  {
    "surah_id": 56,
    "ayah_number": 85,
    "global_ayah_id": 5064,
    "translation": "ஆயினும், நாமோ அவனுக்கு உங்களை விட சமீபமாக இருக்கிறோம். எனினும் நீங்கள் பார்க்கிறீர்களில்லை."
  },
  {
    "surah_id": 56,
    "ayah_number": 86,
    "global_ayah_id": 5065,
    "translation": "எனவே, (மறுமையில் உங்கள் செயல்களுக்கு) கூலி கொடுக்கப்பட மாட்டீர்கள் என்று இருந்தால் -"
  },
  {
    "surah_id": 56,
    "ayah_number": 87,
    "global_ayah_id": 5066,
    "translation": "நீங்கள் உண்மையாளராக இருப்பின், (அவ்வுயிரை) மீளவைத்திருக்கலாமே!"
  },
  {
    "surah_id": 56,
    "ayah_number": 88,
    "global_ayah_id": 5067,
    "translation": "(இறந்தவர் இறைவனுக்கு) நெருக்கமானவர்களில் நின்றும் இருப்பாராயின்."
  },
  {
    "surah_id": 56,
    "ayah_number": 89,
    "global_ayah_id": 5068,
    "translation": "அவருக்குச் சுகமும், நல்லுணவும் இன்னும் பாக்கியமுள்ள சுவர்க்கமும் உண்டு."
  },
  {
    "surah_id": 56,
    "ayah_number": 90,
    "global_ayah_id": 5069,
    "translation": "அன்றியும், அவர் வலப்புறத்துத் தோழராக இருந்தால்,"
  },
  {
    "surah_id": 56,
    "ayah_number": 91,
    "global_ayah_id": 5070,
    "translation": "\"வலப்புறத்தோரே! உங்களுக்கு \"ஸலாம்\" உண்டாவதாக\" (என்று கூறப்படும்)."
  },
  {
    "surah_id": 56,
    "ayah_number": 92,
    "global_ayah_id": 5071,
    "translation": "ஆனால் அவன் வழிகெட்டுப் பொய்யாக்குவோரில் (ஒருவனாக) இருந்தால்"
  },
  {
    "surah_id": 56,
    "ayah_number": 93,
    "global_ayah_id": 5072,
    "translation": "கொதிக்கும் நீரே, அவனுக்கு விருந்தாகும்."
  },
  {
    "surah_id": 56,
    "ayah_number": 94,
    "global_ayah_id": 5073,
    "translation": "நரக நெருப்பில் தள்ளப்படுவது (விருந்தாகும்)."
  },
  {
    "surah_id": 56,
    "ayah_number": 95,
    "global_ayah_id": 5074,
    "translation": "நிச்சயமாக இதுதான் உறுதியான உண்மையாகும்."
  },
  {
    "surah_id": 56,
    "ayah_number": 96,
    "global_ayah_id": 5075,
    "translation": "எனவே (நபியே!) மகத்தான உம்முடைய இறைவனின் திருநாமத்தைக் கொண்டு தஸ்பீஹு செய்வீராக."
  }
]