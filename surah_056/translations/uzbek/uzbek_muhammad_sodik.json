[
  {
    "surah_id": 56,
    "ayah_number": 1,
    "global_ayah_id": 4980,
    "translation": "Воқеа воқеъ бўлганда."
  },
  {
    "surah_id": 56,
    "ayah_number": 2,
    "global_ayah_id": 4981,
    "translation": "Унинг воқеъ бўлишини ёлғон қилувчи (жон) йўқдир."
  },
  {
    "surah_id": 56,
    "ayah_number": 3,
    "global_ayah_id": 4982,
    "translation": "У ҳам пастлатувчи, ҳам кўтарувчидир."
  },
  {
    "surah_id": 56,
    "ayah_number": 4,
    "global_ayah_id": 4983,
    "translation": "Қачонки ер қаттиқ ларзага келганда."
  },
  {
    "surah_id": 56,
    "ayah_number": 5,
    "global_ayah_id": 4984,
    "translation": "Тоғлар майдаланиб, титилганда."
  },
  {
    "surah_id": 56,
    "ayah_number": 6,
    "global_ayah_id": 4985,
    "translation": "Бас, улар тарқалган чанг-тўзонга айланганда."
  },
  {
    "surah_id": 56,
    "ayah_number": 7,
    "global_ayah_id": 4986,
    "translation": "Ва сизлар уч тоифа бўлгангда."
  },
  {
    "surah_id": 56,
    "ayah_number": 8,
    "global_ayah_id": 4987,
    "translation": "Ўнг тараф эгалари. Ўнг тараф эгалари не(саодатлилар)дир?!"
  },
  {
    "surah_id": 56,
    "ayah_number": 9,
    "global_ayah_id": 4988,
    "translation": "Ва чап тараф эгалари. Чап тараф эгалари не(бадбахтлар)дир?!"
  },
  {
    "surah_id": 56,
    "ayah_number": 10,
    "global_ayah_id": 4989,
    "translation": "Ва пешқадамлар, пешқадамлар."
  },
  {
    "surah_id": 56,
    "ayah_number": 11,
    "global_ayah_id": 4990,
    "translation": "Ана ўшалар, (Аллоҳга) яқин бўлганлар."
  },
  {
    "surah_id": 56,
    "ayah_number": 12,
    "global_ayah_id": 4991,
    "translation": "Сернеъмат жаннатлардалар."
  },
  {
    "surah_id": 56,
    "ayah_number": 13,
    "global_ayah_id": 4992,
    "translation": "Аввалгилардан кўпгина жамоатлар."
  },
  {
    "surah_id": 56,
    "ayah_number": 14,
    "global_ayah_id": 4993,
    "translation": "Ва охиргилардан оздирлар."
  },
  {
    "surah_id": 56,
    "ayah_number": 15,
    "global_ayah_id": 4994,
    "translation": "Тўқима сўриларидалар."
  },
  {
    "surah_id": 56,
    "ayah_number": 16,
    "global_ayah_id": 4995,
    "translation": "Бир-бирларига рўбарў бўлиб, ёнбошлаган ҳолларидалар. (Яъни, пешқадамлар жаннат дуру-ёқутларни аралаш қилиб тўқилган сўриларда бир-бирларига қараб, ёнбошлаб-ястаниб роҳатланишар экан.)"
  },
  {
    "surah_id": 56,
    "ayah_number": 17,
    "global_ayah_id": 4996,
    "translation": "Атрофларида мангу ёш йигитлар айланиб юрурлар."
  },
  {
    "surah_id": 56,
    "ayah_number": 18,
    "global_ayah_id": 4997,
    "translation": "Оқар чашма (майи тўлатилган) қадаҳлар, кўзалар ва косалар билан."
  },
  {
    "surah_id": 56,
    "ayah_number": 19,
    "global_ayah_id": 4998,
    "translation": "Ундан бош оғриғи ҳам, маст ҳам бўлмаслар."
  },
  {
    "surah_id": 56,
    "ayah_number": 20,
    "global_ayah_id": 4999,
    "translation": "Ва улар хоҳлаган мевалар билан."
  },
  {
    "surah_id": 56,
    "ayah_number": 21,
    "global_ayah_id": 5000,
    "translation": "Иштаҳалари тусаган қуш гўшти билан."
  },
  {
    "surah_id": 56,
    "ayah_number": 22,
    "global_ayah_id": 5001,
    "translation": "Яна кўзи гўзал ҳурлар бор."
  },
  {
    "surah_id": 56,
    "ayah_number": 23,
    "global_ayah_id": 5002,
    "translation": "Мисоли яширилган дур."
  },
  {
    "surah_id": 56,
    "ayah_number": 24,
    "global_ayah_id": 5003,
    "translation": "Булар, қилган амалларнинг мукофотидур."
  },
  {
    "surah_id": 56,
    "ayah_number": 25,
    "global_ayah_id": 5004,
    "translation": "Улар у ерда беҳуда, гуноҳ сўзларни эшитмаслар."
  },
  {
    "surah_id": 56,
    "ayah_number": 26,
    "global_ayah_id": 5005,
    "translation": "Фақат «Салом, Салом» дейилганини (эшитарлар). (Бир-бирларига салом берадилар, уларга фаришталар ҳам салом берадилар. Аллоҳнинг саломи ҳам етказиб турилади.)"
  },
  {
    "surah_id": 56,
    "ayah_number": 27,
    "global_ayah_id": 5006,
    "translation": "Ўнг тараф эгалари. Ўнг тараф эгалари не(саодатлилар)дир!"
  },
  {
    "surah_id": 56,
    "ayah_number": 28,
    "global_ayah_id": 5007,
    "translation": "Улар тиконсиз сидрзорлардадир. (Сидр-ҳушбўй ҳидли бута бўлиб, араблар уни ҳиди учун яхши кўрар эканлар. Аммо тикани жуда кўп бўларкан.)"
  },
  {
    "surah_id": 56,
    "ayah_number": 29,
    "global_ayah_id": 5008,
    "translation": "Сермева бананзорлардадир."
  },
  {
    "surah_id": 56,
    "ayah_number": 30,
    "global_ayah_id": 5009,
    "translation": "Ва ёйилган соялардадир."
  },
  {
    "surah_id": 56,
    "ayah_number": 31,
    "global_ayah_id": 5010,
    "translation": "Оқар сувлардадир."
  },
  {
    "surah_id": 56,
    "ayah_number": 32,
    "global_ayah_id": 5011,
    "translation": "Сероб мевалардадир."
  },
  {
    "surah_id": 56,
    "ayah_number": 33,
    "global_ayah_id": 5012,
    "translation": "Тугамайдиган ва ман қилинмайдиганлардадир."
  },
  {
    "surah_id": 56,
    "ayah_number": 34,
    "global_ayah_id": 5013,
    "translation": "Баланд-баланд кўрпачалардадир."
  },
  {
    "surah_id": 56,
    "ayah_number": 35,
    "global_ayah_id": 5014,
    "translation": "Албатта, Биз у(ҳурлар)ни дафъатан, хос қилиб, яратдик."
  },
  {
    "surah_id": 56,
    "ayah_number": 36,
    "global_ayah_id": 5015,
    "translation": "Бас, уларни бокиралар қилдик."
  },
  {
    "surah_id": 56,
    "ayah_number": 37,
    "global_ayah_id": 5016,
    "translation": "Тенгдош маҳбубалар қилдик."
  },
  {
    "surah_id": 56,
    "ayah_number": 38,
    "global_ayah_id": 5017,
    "translation": "Ўнг тараф эгалари учун."
  },
  {
    "surah_id": 56,
    "ayah_number": 39,
    "global_ayah_id": 5018,
    "translation": "Улар аввалгилардан кўпгина жамоатлардир."
  },
  {
    "surah_id": 56,
    "ayah_number": 40,
    "global_ayah_id": 5019,
    "translation": "Кейингилардан ҳам кўпгина жамоатлардир."
  },
  {
    "surah_id": 56,
    "ayah_number": 41,
    "global_ayah_id": 5020,
    "translation": "Ва чап тараф эгалари. Чап тараф эгалари не(бадбахтлар)дир?!"
  },
  {
    "surah_id": 56,
    "ayah_number": 42,
    "global_ayah_id": 5021,
    "translation": "Улар ўт шамол ва қайноқ сувдадирлар."
  },
  {
    "surah_id": 56,
    "ayah_number": 43,
    "global_ayah_id": 5022,
    "translation": "Қоп-қора тутундан бўлган соядадирлар."
  },
  {
    "surah_id": 56,
    "ayah_number": 44,
    "global_ayah_id": 5023,
    "translation": "Салқин ҳамэмас, фойдаии ҳам."
  },
  {
    "surah_id": 56,
    "ayah_number": 45,
    "global_ayah_id": 5024,
    "translation": "Албатта улар бундан олдин ҳой-ҳавасга берилганлардан эдилар."
  },
  {
    "surah_id": 56,
    "ayah_number": 46,
    "global_ayah_id": 5025,
    "translation": "Ва мудом катта гуноҳ ишлар қилар эдилар."
  },
  {
    "surah_id": 56,
    "ayah_number": 47,
    "global_ayah_id": 5026,
    "translation": "Ва «Биз ўлиб, тупроққа ва суякка айланганимиздан кейин қайта тирилтриламизми?"
  },
  {
    "surah_id": 56,
    "ayah_number": 48,
    "global_ayah_id": 5027,
    "translation": "Аввалги оталаримиз ҳам-а?!» дер эдилар."
  },
  {
    "surah_id": 56,
    "ayah_number": 49,
    "global_ayah_id": 5028,
    "translation": "Айтгил: «Албатта, аввалгилар ва охиргилар."
  },
  {
    "surah_id": 56,
    "ayah_number": 50,
    "global_ayah_id": 5029,
    "translation": "Маълум кунга белгиланган вақтда албатта тўпланувчилар»."
  },
  {
    "surah_id": 56,
    "ayah_number": 51,
    "global_ayah_id": 5030,
    "translation": "Сўнгра, сиз эй адашганлар, ёлғонга чиқарувчилар!"
  },
  {
    "surah_id": 56,
    "ayah_number": 52,
    "global_ayah_id": 5031,
    "translation": "Албатта, заққум дарахтидан еювчисизлар."
  },
  {
    "surah_id": 56,
    "ayah_number": 53,
    "global_ayah_id": 5032,
    "translation": "Бас, ундан қоринларни тўлдирувчисизлар."
  },
  {
    "surah_id": 56,
    "ayah_number": 54,
    "global_ayah_id": 5033,
    "translation": "Бас, устидан ўта қайноқ сувдан ичувчисизлар."
  },
  {
    "surah_id": 56,
    "ayah_number": 55,
    "global_ayah_id": 5034,
    "translation": "Бас, чанқоқ туядек ичувчисизлар."
  },
  {
    "surah_id": 56,
    "ayah_number": 56,
    "global_ayah_id": 5035,
    "translation": "Уларнинг қиёмат кунидаги зиёфатлари мана шу!"
  },
  {
    "surah_id": 56,
    "ayah_number": 57,
    "global_ayah_id": 5036,
    "translation": "Биз сизларни яратганимиз, ишонсаларинг-чи!"
  },
  {
    "surah_id": 56,
    "ayah_number": 58,
    "global_ayah_id": 5037,
    "translation": "Ўзингиз чиқарадиган манийни ўйлаб кўринг-а!"
  },
  {
    "surah_id": 56,
    "ayah_number": 59,
    "global_ayah_id": 5038,
    "translation": "Уни сизлар яратасизми ёки Биз яратувчимизми?!"
  },
  {
    "surah_id": 56,
    "ayah_number": 60,
    "global_ayah_id": 5039,
    "translation": "Орангиздаги ўлимни Биз белгилаганмиз ва Биз ожиз эмасмиз."
  },
  {
    "surah_id": 56,
    "ayah_number": 61,
    "global_ayah_id": 5040,
    "translation": "Сизнинг ўрнингизга сизга ўхшашларни алмаштиришдан ва сизларни ўзингиз билмайдиган ҳолда яратишдан."
  },
  {
    "surah_id": 56,
    "ayah_number": 62,
    "global_ayah_id": 5041,
    "translation": "Ва дарҳақиқат, аввалги яратилишини билдингиз-ку, эсласаларингиз-чи!"
  },
  {
    "surah_id": 56,
    "ayah_number": 63,
    "global_ayah_id": 5042,
    "translation": "Ўзингиз экаётган нарсани ўйлаб кўринг-а!"
  },
  {
    "surah_id": 56,
    "ayah_number": 64,
    "global_ayah_id": 5043,
    "translation": "Уни сиз ундирасизми ёки Биз ундирувчимизми?"
  },
  {
    "surah_id": 56,
    "ayah_number": 65,
    "global_ayah_id": 5044,
    "translation": "Агар хоҳласак, Биз уни қуруқ чўпга айлантириб қўямиз. Сизлар эса надоматда ажабланиб:"
  },
  {
    "surah_id": 56,
    "ayah_number": 66,
    "global_ayah_id": 5045,
    "translation": "«Албатта, биз зиён кўрганлармиз."
  },
  {
    "surah_id": 56,
    "ayah_number": 67,
    "global_ayah_id": 5046,
    "translation": "Балки маҳрум бўлганлармиз», (дейсиз)."
  },
  {
    "surah_id": 56,
    "ayah_number": 68,
    "global_ayah_id": 5047,
    "translation": "Ўзингиз ичадиган сувни ўйлаб кўринг-а!"
  },
  {
    "surah_id": 56,
    "ayah_number": 69,
    "global_ayah_id": 5048,
    "translation": "Уни булутлардан сиз туширасизми ёки Биз тушурувчимизми?"
  },
  {
    "surah_id": 56,
    "ayah_number": 70,
    "global_ayah_id": 5049,
    "translation": "Агар хоҳласак, Биз уни шўр қилиб қўямиз. Шукр қилсангиз-чи!"
  },
  {
    "surah_id": 56,
    "ayah_number": 71,
    "global_ayah_id": 5050,
    "translation": "Ўзингиз ёқадиган оловни ўйлаб кўринг-а!"
  },
  {
    "surah_id": 56,
    "ayah_number": 72,
    "global_ayah_id": 5051,
    "translation": "Унинг дарахтини сиз яратгансизми ёки Биз яратувчимизми?"
  },
  {
    "surah_id": 56,
    "ayah_number": 73,
    "global_ayah_id": 5052,
    "translation": "Биз у(олов)ни эслатма ва йўловчилар учун манфаъат қилиб қўйдик."
  },
  {
    "surah_id": 56,
    "ayah_number": 74,
    "global_ayah_id": 5053,
    "translation": "Бас, улуғ Роббинг исмини поклаб ёд эт! (Мазкур неъматларнинг эгасини таниган инсон Улуғ Аллоҳ таолога тасбиҳ айтиб, ибодат қилишга ўтади.)"
  },
  {
    "surah_id": 56,
    "ayah_number": 75,
    "global_ayah_id": 5054,
    "translation": "Юлдузларнинг манзиллари билан қасам ичаман. («Жойлари» деганимиз - унинг ўрнашган, чиқиш ва ботиш жойлари - буржларидир.)"
  },
  {
    "surah_id": 56,
    "ayah_number": 76,
    "global_ayah_id": 5055,
    "translation": "Албатта, агар билсангиз бу улуғ қасамдир. (Бу ояти карима ўн тўрт асрдан кўпроқ муқаддам нозил бўлганлиги ҳаммага маълум. Ўша пайтда одамлар юлдузлар ҳақида содда тушунчага эга эдилар, уларнинг ҳажми, сони, ҳаракати ҳақида деярли ҳеч нарса билмас эдилар. Фалакиёт илми ривожланиб, улар воситасида очилган жуда кўплаб куллиётлар Қуръон оятларининг улуғлигини тасдиқлади.)"
  },
  {
    "surah_id": 56,
    "ayah_number": 77,
    "global_ayah_id": 5056,
    "translation": "Албатта, у Қуръони каримдир."
  },
  {
    "surah_id": 56,
    "ayah_number": 78,
    "global_ayah_id": 5057,
    "translation": "У сақланган китобдадир."
  },
  {
    "surah_id": 56,
    "ayah_number": 79,
    "global_ayah_id": 5058,
    "translation": "Уни фақат покланганларгина ушлайдир."
  },
  {
    "surah_id": 56,
    "ayah_number": 80,
    "global_ayah_id": 5059,
    "translation": "У оламларнинг Роббисидан туширилгандир."
  },
  {
    "surah_id": 56,
    "ayah_number": 81,
    "global_ayah_id": 5060,
    "translation": "Бас, сизлар мана шу сўз(Қуръон)га бепарволик қиласизларми?!"
  },
  {
    "surah_id": 56,
    "ayah_number": 82,
    "global_ayah_id": 5061,
    "translation": "Ва ёлғонга чиқаришни ризқ қилиб оласизларми?! (Яъни, иймон келтириш лозим бўлган нарсаларга ишонмасликни ўз насибангиз қилиб оласизларми?)"
  },
  {
    "surah_id": 56,
    "ayah_number": 83,
    "global_ayah_id": 5062,
    "translation": "Жонингиз ҳалқумга келиб қолса-чи?!"
  },
  {
    "surah_id": 56,
    "ayah_number": 84,
    "global_ayah_id": 5063,
    "translation": "Ҳолбуки, ўша вақтда ўзларингиз қараб турган бўласизлар."
  },
  {
    "surah_id": 56,
    "ayah_number": 85,
    "global_ayah_id": 5064,
    "translation": "Биз эса, сиздан кўра унга яқинмиз, аммо сизлар кўрмайсизлар. (Яъни, Аллоҳнинг Ўз бандасига қанчалар яқинлигини англамайсизлар. Ўлаётган одамга Аллоҳ таоло унинг устида турган қариндошидан кўра яқинроқ бўлади.)"
  },
  {
    "surah_id": 56,
    "ayah_number": 86,
    "global_ayah_id": 5065,
    "translation": "Агар сиз ҳисоб бермас бўлсангиз."
  },
  {
    "surah_id": 56,
    "ayah_number": 87,
    "global_ayah_id": 5066,
    "translation": "У(жон)ни ўрнига қайтаринг-чи! Агар ростгўй бўлсангиз!"
  },
  {
    "surah_id": 56,
    "ayah_number": 88,
    "global_ayah_id": 5067,
    "translation": "Агар, у муқарраблардан бўлса."
  },
  {
    "surah_id": 56,
    "ayah_number": 89,
    "global_ayah_id": 5068,
    "translation": "Роҳатда, фароғатда ва сернеъмат жаннатдадир."
  },
  {
    "surah_id": 56,
    "ayah_number": 90,
    "global_ayah_id": 5069,
    "translation": "Агар ўнг тараф эгаларидан бўлса."
  },
  {
    "surah_id": 56,
    "ayah_number": 91,
    "global_ayah_id": 5070,
    "translation": "Бас, «Сенга ўнг тараф эгаларидан Салом»дир."
  },
  {
    "surah_id": 56,
    "ayah_number": 92,
