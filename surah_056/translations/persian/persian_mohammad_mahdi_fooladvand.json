[
  {
    "surah_id": 56,
    "ayah_number": 1,
    "global_ayah_id": 4980,
    "translation": "آن واقعه چون وقوع يابد،"
  },
  {
    "surah_id": 56,
    "ayah_number": 2,
    "global_ayah_id": 4981,
    "translation": "[كه‌] در وقوع آن دروغى نيست:"
  },
  {
    "surah_id": 56,
    "ayah_number": 3,
    "global_ayah_id": 4982,
    "translation": "پست‌كننده [و] بالابرنده است."
  },
  {
    "surah_id": 56,
    "ayah_number": 4,
    "global_ayah_id": 4983,
    "translation": "چون زمين با تكان [سختى‌] لرزانده شود،"
  },
  {
    "surah_id": 56,
    "ayah_number": 5,
    "global_ayah_id": 4984,
    "translation": "و كوهها [جمله‌] ريزه ريزه شوند،"
  },
  {
    "surah_id": 56,
    "ayah_number": 6,
    "global_ayah_id": 4985,
    "translation": "و غبارى پراكنده گردند،"
  },
  {
    "surah_id": 56,
    "ayah_number": 7,
    "global_ayah_id": 4986,
    "translation": "و شما سه دسته شويد:"
  },
  {
    "surah_id": 56,
    "ayah_number": 8,
    "global_ayah_id": 4987,
    "translation": "ياران دست راست، كدامند ياران دست راست؟"
  },
  {
    "surah_id": 56,
    "ayah_number": 9,
    "global_ayah_id": 4988,
    "translation": "و ياران چپ؛ كدامند ياران چپ؟"
  },
  {
    "surah_id": 56,
    "ayah_number": 10,
    "global_ayah_id": 4989,
    "translation": "و سبقت‌گيرندگان مقدمند؛"
  },
  {
    "surah_id": 56,
    "ayah_number": 11,
    "global_ayah_id": 4990,
    "translation": "آنانند همان مقربان [خدا]،"
  },
  {
    "surah_id": 56,
    "ayah_number": 12,
    "global_ayah_id": 4991,
    "translation": "در باغستانهاى پر نعمت."
  },
  {
    "surah_id": 56,
    "ayah_number": 13,
    "global_ayah_id": 4992,
    "translation": "گروهى از پيشينيان،"
  },
  {
    "surah_id": 56,
    "ayah_number": 14,
    "global_ayah_id": 4993,
    "translation": "و اندكى از متأخران."
  },
  {
    "surah_id": 56,
    "ayah_number": 15,
    "global_ayah_id": 4994,
    "translation": "بر تختهايى جواهرنشان،"
  },
  {
    "surah_id": 56,
    "ayah_number": 16,
    "global_ayah_id": 4995,
    "translation": "كه روبروى هم بر آنها تكيه داده‌اند."
  },
  {
    "surah_id": 56,
    "ayah_number": 17,
    "global_ayah_id": 4996,
    "translation": "بر گردشان پسرانى جاودان [به خدمت‌] مى‌گردند،"
  },
  {
    "surah_id": 56,
    "ayah_number": 18,
    "global_ayah_id": 4997,
    "translation": "با جامها و آبريزها و پياله‌[ها]يى از باده ناب روان."
  },
  {
    "surah_id": 56,
    "ayah_number": 19,
    "global_ayah_id": 4998,
    "translation": "[كه‌] نه از آن دردسر گيرند و نه بى‌خرد گردند."
  },
  {
    "surah_id": 56,
    "ayah_number": 20,
    "global_ayah_id": 4999,
    "translation": "و ميوه از هر چه اختيار كنند."
  },
  {
    "surah_id": 56,
    "ayah_number": 21,
    "global_ayah_id": 5000,
    "translation": "و از گوشت پرنده هر چه بخواهند."
  },
  {
    "surah_id": 56,
    "ayah_number": 22,
    "global_ayah_id": 5001,
    "translation": "و حوران چشم‌درشت،"
  },
  {
    "surah_id": 56,
    "ayah_number": 23,
    "global_ayah_id": 5002,
    "translation": "مثل لؤلؤ نهان ميان صدف،"
  },
  {
    "surah_id": 56,
    "ayah_number": 24,
    "global_ayah_id": 5003,
    "translation": "[اينها] پاداشى است براى آنچه مى‌كردند."
  },
  {
    "surah_id": 56,
    "ayah_number": 25,
    "global_ayah_id": 5004,
    "translation": "در آنجا نه بيهوده‌اى مى‌شنوند و نه [سخنى‌] گناه‌آلود."
  },
  {
    "surah_id": 56,
    "ayah_number": 26,
    "global_ayah_id": 5005,
    "translation": "سخنى جز سلام و درود نيست."
  },
  {
    "surah_id": 56,
    "ayah_number": 27,
    "global_ayah_id": 5006,
    "translation": "و ياران راست؛ ياران راست كدامند؟"
  },
  {
    "surah_id": 56,
    "ayah_number": 28,
    "global_ayah_id": 5007,
    "translation": "در [زير] درختان كُنار بى‌خار،"
  },
  {
    "surah_id": 56,
    "ayah_number": 29,
    "global_ayah_id": 5008,
    "translation": "و درختهاى موز كه ميوه‌اش خوشه خوشه روى هم چيده است."
  },
  {
    "surah_id": 56,
    "ayah_number": 30,
    "global_ayah_id": 5009,
    "translation": "و سايه‌اى پايدار."
  },
  {
    "surah_id": 56,
    "ayah_number": 31,
    "global_ayah_id": 5010,
    "translation": "و آبى ريزان."
  },
  {
    "surah_id": 56,
    "ayah_number": 32,
    "global_ayah_id": 5011,
    "translation": "و ميوه‌اى فراوان،"
  },
  {
    "surah_id": 56,
    "ayah_number": 33,
    "global_ayah_id": 5012,
    "translation": "نه بريده و نه ممنوع."
  },
  {
    "surah_id": 56,
    "ayah_number": 34,
    "global_ayah_id": 5013,
    "translation": "و همخوابگانى بالا بلند."
  },
  {
    "surah_id": 56,
    "ayah_number": 35,
    "global_ayah_id": 5014,
    "translation": "ما آنان را پديد آورده‌ايم پديد آوردنى،"
  },
  {
    "surah_id": 56,
    "ayah_number": 36,
    "global_ayah_id": 5015,
    "translation": "و ايشان را دوشيزه گردانيده‌ايم،"
  },
  {
    "surah_id": 56,
    "ayah_number": 37,
    "global_ayah_id": 5016,
    "translation": "شوى دوست همسال،"
  },
  {
    "surah_id": 56,
    "ayah_number": 38,
    "global_ayah_id": 5017,
    "translation": "براى ياران راست."
  },
  {
    "surah_id": 56,
    "ayah_number": 39,
    "global_ayah_id": 5018,
    "translation": "كه گروهى از پيشينيانند،"
  },
  {
    "surah_id": 56,
    "ayah_number": 40,
    "global_ayah_id": 5019,
    "translation": "و گروهى از متأخران."
  },
  {
    "surah_id": 56,
    "ayah_number": 41,
    "global_ayah_id": 5020,
    "translation": "و ياران چپ؛ كدامند ياران چپ؟"
  },
  {
    "surah_id": 56,
    "ayah_number": 42,
    "global_ayah_id": 5021,
    "translation": "در [ميان‌] باد گرم و آب داغ."
  },
  {
    "surah_id": 56,
    "ayah_number": 43,
    "global_ayah_id": 5022,
    "translation": "و سايه‌اى از دود تار."
  },
  {
    "surah_id": 56,
    "ayah_number": 44,
    "global_ayah_id": 5023,
    "translation": "نه خنك و نه خوش."
  },
  {
    "surah_id": 56,
    "ayah_number": 45,
    "global_ayah_id": 5024,
    "translation": "اينان بودند كه پيش از اين ناز پروردگان بودند."
  },
  {
    "surah_id": 56,
    "ayah_number": 46,
    "global_ayah_id": 5025,
    "translation": "و بر گناه بزرگ پافشارى مى‌كردند."
  },
  {
    "surah_id": 56,
    "ayah_number": 47,
    "global_ayah_id": 5026,
    "translation": "و مى‌گفتند: «آيا چون مرديم و خاك واستخوان شديم، واقعاً [باز] زنده مى‌گرديم؟"
  },
  {
    "surah_id": 56,
    "ayah_number": 48,
    "global_ayah_id": 5027,
    "translation": "يا پدران گذشته ما [نيز]؟»"
  },
  {
    "surah_id": 56,
    "ayah_number": 49,
    "global_ayah_id": 5028,
    "translation": "بگو: «در حقيقت، اولين و آخرين،"
  },
  {
    "surah_id": 56,
    "ayah_number": 50,
    "global_ayah_id": 5029,
    "translation": "قطعاً همه در موعد روزى معلوم گرد آورده شوند.»"
  },
  {
    "surah_id": 56,
    "ayah_number": 51,
    "global_ayah_id": 5030,
    "translation": "آنگاه شما اى گمراهان دروغپرداز،"
  },
  {
    "surah_id": 56,
    "ayah_number": 52,
    "global_ayah_id": 5031,
    "translation": "قطعاً از درختى كه از زقّوم است خواهيد خورد."
  },
  {
    "surah_id": 56,
    "ayah_number": 53,
    "global_ayah_id": 5032,
    "translation": "و از آن شكمهايتان را خواهيد آكند."
  },
  {
    "surah_id": 56,
    "ayah_number": 54,
    "global_ayah_id": 5033,
    "translation": "و روى آن از آب جوش مى‌نوشيد؛"
  },
  {
    "surah_id": 56,
    "ayah_number": 55,
    "global_ayah_id": 5034,
    "translation": "[مانند] نوشيدن اشتران تشنه."
  },
  {
    "surah_id": 56,
    "ayah_number": 56,
    "global_ayah_id": 5035,
    "translation": "اين است پذيرايى آنان در روز جزا."
  },
  {
    "surah_id": 56,
    "ayah_number": 57,
    "global_ayah_id": 5036,
    "translation": "ماييم كه شما را آفريده‌ايم، پس چرا تصديق نمى‌كنيد؟"
  },
  {
    "surah_id": 56,
    "ayah_number": 58,
    "global_ayah_id": 5037,
    "translation": "آيا آنچه را [كه به صورت نطفه‌] فرو مى‌ريزيد ديده‌ايد؟"
  },
  {
    "surah_id": 56,
    "ayah_number": 59,
    "global_ayah_id": 5038,
    "translation": "آيا شما آن را خلق مى‌كنيد يا ما آفريننده‌ايم؟"
  },
  {
    "surah_id": 56,
    "ayah_number": 60,
    "global_ayah_id": 5039,
    "translation": "ماييم كه ميان شما مرگ را مقدر كرده‌ايم و بر ما سبقت نتوانيد جست؛"
  },
  {
    "surah_id": 56,
    "ayah_number": 61,
    "global_ayah_id": 5040,
    "translation": "[و مى‌توانيم‌] امثال شما را به جاى شما قرار دهيم و شما را [به صورت‌] آنچه نمى‌دانيد پديدار گردانيم."
  },
  {
    "surah_id": 56,
    "ayah_number": 62,
    "global_ayah_id": 5041,
    "translation": "و قطعاً پديدار شدن نخستين خود را شناختيد؛ پس چرا سر عبرت گرفتن نداريد؟"
  },
  {
    "surah_id": 56,
    "ayah_number": 63,
    "global_ayah_id": 5042,
    "translation": "آيا آنچه را كشت مى‌كنيد، ملاحظه كرده‌ايد؟"
  },
  {
    "surah_id": 56,
    "ayah_number": 64,
    "global_ayah_id": 5043,
    "translation": "آيا شما آن را [بى‌يارى ما] زراعت مى‌كنيد، يا ماييم كه زراعت مى‌كنيم؟"
  },
  {
    "surah_id": 56,
    "ayah_number": 65,
    "global_ayah_id": 5044,
    "translation": "اگر بخواهيم قطعاً خاشاكش مى‌گردانيم، پس در افسوس [و تعجب‌] مى‌افتيد."
  },
  {
    "surah_id": 56,
    "ayah_number": 66,
    "global_ayah_id": 5045,
    "translation": "[و مى‌گوييد:] «واقعاً ما زيان زده‌ايم،"
  },
  {
    "surah_id": 56,
    "ayah_number": 67,
    "global_ayah_id": 5046,
    "translation": "بلكه ما محروم شدگانيم.»"
  },
  {
    "surah_id": 56,
    "ayah_number": 68,
    "global_ayah_id": 5047,
    "translation": "آيا آبى را كه مى‌نوشيد ديده‌ايد؟"
  },
  {
    "surah_id": 56,
    "ayah_number": 69,
    "global_ayah_id": 5048,
    "translation": "آيا شما آن را از [دل‌] ابر سپيد فرود آورده‌ايد، يا ما فرودآورنده‌ايم؟"
  },
  {
    "surah_id": 56,
    "ayah_number": 70,
    "global_ayah_id": 5049,
    "translation": "اگر بخواهيم آن را تلخ مى‌گردانيم، پس چرا سپاس نمى‌داريد؟"
  },
  {
    "surah_id": 56,
    "ayah_number": 71,
    "global_ayah_id": 5050,
    "translation": "آيا آن آتشى را كه برمى‌افروزيد ملاحظه كرده‌ايد؟"
  },
  {
    "surah_id": 56,
    "ayah_number": 72,
    "global_ayah_id": 5051,
    "translation": "آيا شما [چوب‌] درخت آن را پديدار كرده‌ايد، يا ما پديدآورنده‌ايم؟"
  },
  {
    "surah_id": 56,
    "ayah_number": 73,
    "global_ayah_id": 5052,
    "translation": "ما آن را [مايه‌] عبرت و [وسيله‌] استفاده براى بيابانگردان قرار داده‌ايم."
  },
  {
    "surah_id": 56,
    "ayah_number": 74,
    "global_ayah_id": 5053,
    "translation": "پس به نام پروردگار بزرگت تسبيح گوى."
  },
  {
    "surah_id": 56,
    "ayah_number": 75,
    "global_ayah_id": 5054,
    "translation": "نه [چنين است كه مى‌پنداريد]، سوگند به جايگاه‌هاى [ويژه و فواصل معيّن‌] ستارگان."
  },
  {
    "surah_id": 56,
    "ayah_number": 76,
    "global_ayah_id": 5055,
    "translation": "اگر بدانيد، آن سوگندى سخت بزرگ است!"
  },
  {
    "surah_id": 56,
    "ayah_number": 77,
    "global_ayah_id": 5056,
    "translation": "كه اين [پيام‌] قطعاً قرآنى است ارجمند،"
  },
  {
    "surah_id": 56,
    "ayah_number": 78,
    "global_ayah_id": 5057,
    "translation": "در كتابى نهفته،"
  },
  {
    "surah_id": 56,
    "ayah_number": 79,
    "global_ayah_id": 5058,
    "translation": "كه جز پاك‌شدگان بر آن دست ندارند،"
  },
  {
    "surah_id": 56,
    "ayah_number": 80,
    "global_ayah_id": 5059,
    "translation": "وحيى است از جانب پروردگار جهانيان."
  },
  {
    "surah_id": 56,
    "ayah_number": 81,
    "global_ayah_id": 5060,
    "translation": "آيا شما اين سخن را سبك [و سست‌] مى‌گيريد؟"
  },
  {
    "surah_id": 56,
    "ayah_number": 82,
    "global_ayah_id": 5061,
    "translation": "و تنها نصيب خود را در تكذيب [آن‌] قرار مى‌دهيد؟"
  },
  {
    "surah_id": 56,
    "ayah_number": 83,
    "global_ayah_id": 5062,
    "translation": "پس چرا آنگاه كه [جان شما] به گلو مى‌رسد،"
  },
  {
    "surah_id": 56,
    "ayah_number": 84,
    "global_ayah_id": 5063,
    "translation": "و در آن هنگام خود نظاره گريد -"
  },
  {
    "surah_id": 56,
    "ayah_number": 85,
    "global_ayah_id": 5064,
    "translation": "و ما به آن [محتضر] از شما نزديكتريم ولى نمى‌بينيد-"
  },
  {
    "surah_id": 56,
    "ayah_number": 86,
    "global_ayah_id": 5065,
    "translation": "پس چرا، اگر شما بى‌جزا مى‌مانيد [و حساب و كتابى در كار نيست‌]،"
  },
  {
    "surah_id": 56,
    "ayah_number": 87,
    "global_ayah_id": 5066,
    "translation": "اگر راست مى‌گوييد، [روح‌] را برنمى‌گردانيد؟"
  },
  {
    "surah_id": 56,
    "ayah_number": 88,
    "global_ayah_id": 5067,
    "translation": "و اما اگر [او] از مقربان باشد،"
  },
  {
    "surah_id": 56,
    "ayah_number": 89,
    "global_ayah_id": 5068,
    "translation": "[در] آسايش و راحت و بهشت پر نعمت [خواهد بود]."
  },
  {
    "surah_id": 56,
    "ayah_number": 90,
    "global_ayah_id": 5069,
    "translation": "و اما اگر از ياران راست باشد،"
  },
  {
    "surah_id": 56,
    "ayah_number": 91,
    "global_ayah_id": 5070,
    "translation": "از ياران راست بر تو سلام باد."
  },
  {
    "surah_id": 56,
    "ayah_number": 92,
    "global_ayah_id": 5071,
    "translation": "و اما اگر از دروغزنان گمراه است،"
  },
  {
    "surah_id": 56,
    "ayah_number": 93,
    "global_ayah_id": 5072,
    "translation": "پس با آبى جوشان پذيرايى خواهد شد،"
  },
  {
    "surah_id": 56,
    "ayah_number": 94,
    "global_ayah_id": 5073,
    "translation": "و [فرجامش‌] درافتادن به جهنم است."
  },
  {
    "surah_id": 56,
    "ayah_number": 95,
    "global_ayah_id": 5074,
    "translation": "اين است همان حقيقت راست [و] يقين."
  },
  {
    "surah_id": 56,
    "ayah_number": 96,
    "global_ayah_id": 5075,
    "translation": "پس به نام پروردگار بزرگ خود تسبيح گوى."
  }
]