[
  {
    "surah_id": 56,
    "ayah_number": 1,
    "global_ayah_id": 4980,
    "translation": "When the Event (the resurrection) comes"
  },
  {
    "surah_id": 56,
    "ayah_number": 2,
    "global_ayah_id": 4981,
    "translation": "there is no denying its coming"
  },
  {
    "surah_id": 56,
    "ayah_number": 3,
    "global_ayah_id": 4982,
    "translation": "(it will) abase (some) and exalt (others)."
  },
  {
    "surah_id": 56,
    "ayah_number": 4,
    "global_ayah_id": 4983,
    "translation": "When the earth is shaken"
  },
  {
    "surah_id": 56,
    "ayah_number": 5,
    "global_ayah_id": 4984,
    "translation": "and the mountains fragmented"
  },
  {
    "surah_id": 56,
    "ayah_number": 6,
    "global_ayah_id": 4985,
    "translation": "becoming scattered dust,"
  },
  {
    "surah_id": 56,
    "ayah_number": 7,
    "global_ayah_id": 4986,
    "translation": "you shall be divided into three parties,"
  },
  {
    "surah_id": 56,
    "ayah_number": 8,
    "global_ayah_id": 4987,
    "translation": "Companions of the Right, what are the Companions of the Right?"
  },
  {
    "surah_id": 56,
    "ayah_number": 9,
    "global_ayah_id": 4988,
    "translation": "Companions of the Left, what are the Companions of the Left?"
  },
  {
    "surah_id": 56,
    "ayah_number": 10,
    "global_ayah_id": 4989,
    "translation": "And the Outstrippers, the Outstrippers"
  },
  {
    "surah_id": 56,
    "ayah_number": 11,
    "global_ayah_id": 4990,
    "translation": "those are they brought near (to their Lord)"
  },
  {
    "surah_id": 56,
    "ayah_number": 12,
    "global_ayah_id": 4991,
    "translation": "in the Gardens of Delight,"
  },
  {
    "surah_id": 56,
    "ayah_number": 13,
    "global_ayah_id": 4992,
    "translation": "a host of the ancients"
  },
  {
    "surah_id": 56,
    "ayah_number": 14,
    "global_ayah_id": 4993,
    "translation": "but only a few from the later generations."
  },
  {
    "surah_id": 56,
    "ayah_number": 15,
    "global_ayah_id": 4994,
    "translation": "on lavish couches"
  },
  {
    "surah_id": 56,
    "ayah_number": 16,
    "global_ayah_id": 4995,
    "translation": "they shall recline, facing each other,"
  },
  {
    "surah_id": 56,
    "ayah_number": 17,
    "global_ayah_id": 4996,
    "translation": "(and there) shall wait on them immortal youths"
  },
  {
    "surah_id": 56,
    "ayah_number": 18,
    "global_ayah_id": 4997,
    "translation": "with goblets and ewers, and a cup from a spring"
  },
  {
    "surah_id": 56,
    "ayah_number": 19,
    "global_ayah_id": 4998,
    "translation": "that will neither make the head throb, nor intoxicate,"
  },
  {
    "surah_id": 56,
    "ayah_number": 20,
    "global_ayah_id": 4999,
    "translation": "with fruits of their own choice"
  },
  {
    "surah_id": 56,
    "ayah_number": 21,
    "global_ayah_id": 5000,
    "translation": "and any flesh of fowl that they desire."
  },
  {
    "surah_id": 56,
    "ayah_number": 22,
    "global_ayah_id": 5001,
    "translation": "And wideeyed houris"
  },
  {
    "surah_id": 56,
    "ayah_number": 23,
    "global_ayah_id": 5002,
    "translation": "like hidden pearls,"
  },
  {
    "surah_id": 56,
    "ayah_number": 24,
    "global_ayah_id": 5003,
    "translation": "a recompense for all that they did."
  },
  {
    "surah_id": 56,
    "ayah_number": 25,
    "global_ayah_id": 5004,
    "translation": "There they shall hear no idle talk, no cause of sin,"
  },
  {
    "surah_id": 56,
    "ayah_number": 26,
    "global_ayah_id": 5005,
    "translation": "but only the saying: 'Peace, Peace'"
  },
  {
    "surah_id": 56,
    "ayah_number": 27,
    "global_ayah_id": 5006,
    "translation": "The Companions of the Right"
  },
  {
    "surah_id": 56,
    "ayah_number": 28,
    "global_ayah_id": 5007,
    "translation": "(will be) among thornless Lote trees."
  },
  {
    "surah_id": 56,
    "ayah_number": 29,
    "global_ayah_id": 5008,
    "translation": "Bananatrees, piled"
  },
  {
    "surah_id": 56,
    "ayah_number": 30,
    "global_ayah_id": 5009,
    "translation": "and continuous shade,"
  },
  {
    "surah_id": 56,
    "ayah_number": 31,
    "global_ayah_id": 5010,
    "translation": "and flowing water"
  },
  {
    "surah_id": 56,
    "ayah_number": 32,
    "global_ayah_id": 5011,
    "translation": "and an abundance of fruits,"
  },
  {
    "surah_id": 56,
    "ayah_number": 33,
    "global_ayah_id": 5012,
    "translation": "unfailing and not forbidden."
  },
  {
    "surah_id": 56,
    "ayah_number": 34,
    "global_ayah_id": 5013,
    "translation": "And couches raised up."
  },
  {
    "surah_id": 56,
    "ayah_number": 35,
    "global_ayah_id": 5014,
    "translation": "Indeed We formed them (the houris and all believing women),"
  },
  {
    "surah_id": 56,
    "ayah_number": 36,
    "global_ayah_id": 5015,
    "translation": "and made them virgins,"
  },
  {
    "surah_id": 56,
    "ayah_number": 37,
    "global_ayah_id": 5016,
    "translation": "chaste, loving companions of the same age"
  },
  {
    "surah_id": 56,
    "ayah_number": 38,
    "global_ayah_id": 5017,
    "translation": "for the Companions of the Right"
  },
  {
    "surah_id": 56,
    "ayah_number": 39,
    "global_ayah_id": 5018,
    "translation": "a multitude of the ancients,"
  },
  {
    "surah_id": 56,
    "ayah_number": 40,
    "global_ayah_id": 5019,
    "translation": "and a multitude of the later people."
  },
  {
    "surah_id": 56,
    "ayah_number": 41,
    "global_ayah_id": 5020,
    "translation": "As for the Companions of the Left"
  },
  {
    "surah_id": 56,
    "ayah_number": 42,
    "global_ayah_id": 5021,
    "translation": "(they shall live) amid burning winds and boiling water,"
  },
  {
    "surah_id": 56,
    "ayah_number": 43,
    "global_ayah_id": 5022,
    "translation": "in the shadow of a smoking blaze,"
  },
  {
    "surah_id": 56,
    "ayah_number": 44,
    "global_ayah_id": 5023,
    "translation": "neither cool nor good."
  },
  {
    "surah_id": 56,
    "ayah_number": 45,
    "global_ayah_id": 5024,
    "translation": "Before they lived at ease,"
  },
  {
    "surah_id": 56,
    "ayah_number": 46,
    "global_ayah_id": 5025,
    "translation": "and persisted in the great sin"
  },
  {
    "surah_id": 56,
    "ayah_number": 47,
    "global_ayah_id": 5026,
    "translation": "and constantly said: 'What, when we are dead and become dust and bones, shall we then be restored to life?"
  },
  {
    "surah_id": 56,
    "ayah_number": 48,
    "global_ayah_id": 5027,
    "translation": "What, and our fathers, the ancients'"
  },
  {
    "surah_id": 56,
    "ayah_number": 49,
    "global_ayah_id": 5028,
    "translation": "Say: 'Those of ancient times and those of later times"
  },
  {
    "surah_id": 56,
    "ayah_number": 50,
    "global_ayah_id": 5029,
    "translation": "shall be gathered together to the appointed time on a known Day'"
  },
  {
    "surah_id": 56,
    "ayah_number": 51,
    "global_ayah_id": 5030,
    "translation": "Then you went astray, you that belied,"
  },
  {
    "surah_id": 56,
    "ayah_number": 52,
    "global_ayah_id": 5031,
    "translation": "you shall eat (the fruit) of the Tree of Zakkum."
  },
  {
    "surah_id": 56,
    "ayah_number": 53,
    "global_ayah_id": 5032,
    "translation": "You shall fill your bellies with it,"
  },
  {
    "surah_id": 56,
    "ayah_number": 54,
    "global_ayah_id": 5033,
    "translation": "and drink boiling water on top of that,"
  },
  {
    "surah_id": 56,
    "ayah_number": 55,
    "global_ayah_id": 5034,
    "translation": "and you will drink as the lapping of thirsty camels."
  },
  {
    "surah_id": 56,
    "ayah_number": 56,
    "global_ayah_id": 5035,
    "translation": "Such shall be your hospitality on the Day of Recompense."
  },
  {
    "surah_id": 56,
    "ayah_number": 57,
    "global_ayah_id": 5036,
    "translation": "We created you, why will you not believe!"
  },
  {
    "surah_id": 56,
    "ayah_number": 58,
    "global_ayah_id": 5037,
    "translation": "Have you thought about what (sperm) you ejaculate?"
  },
  {
    "surah_id": 56,
    "ayah_number": 59,
    "global_ayah_id": 5038,
    "translation": "Did you create it, or are We the Creator?"
  },
  {
    "surah_id": 56,
    "ayah_number": 60,
    "global_ayah_id": 5039,
    "translation": "It was We who decreed death among you. We will not be surpassed"
  },
  {
    "surah_id": 56,
    "ayah_number": 61,
    "global_ayah_id": 5040,
    "translation": "that We will change you and cause you to grow again in a way you do not know."
  },
  {
    "surah_id": 56,
    "ayah_number": 62,
    "global_ayah_id": 5041,
    "translation": "You have surely known of the first creation. Why then, will you not remember!"
  },
  {
    "surah_id": 56,
    "ayah_number": 63,
    "global_ayah_id": 5042,
    "translation": "Ponder upon the soil you till,"
  },
  {
    "surah_id": 56,
    "ayah_number": 64,
    "global_ayah_id": 5043,
    "translation": "is it you that sow it, or are We the Sower?"
  },
  {
    "surah_id": 56,
    "ayah_number": 65,
    "global_ayah_id": 5044,
    "translation": "If We will, We would make it broken stubble and you would remain wondering,"
  },
  {
    "surah_id": 56,
    "ayah_number": 66,
    "global_ayah_id": 5045,
    "translation": "(Saying:) 'We are laden with debts!"
  },
  {
    "surah_id": 56,
    "ayah_number": 67,
    "global_ayah_id": 5046,
    "translation": "Rather, we have been prevented'"
  },
  {
    "surah_id": 56,
    "ayah_number": 68,
    "global_ayah_id": 5047,
    "translation": "Have you thought about the water you drink?"
  },
  {
    "surah_id": 56,
    "ayah_number": 69,
    "global_ayah_id": 5048,
    "translation": "Is it you that send it down from the clouds or We?"
  },
  {
    "surah_id": 56,
    "ayah_number": 70,
    "global_ayah_id": 5049,
    "translation": "If We will, We would make it bitter, why then do you not give thanks?"
  },
  {
    "surah_id": 56,
    "ayah_number": 71,
    "global_ayah_id": 5050,
    "translation": "Have you thought about the fire you kindle?"
  },
  {
    "surah_id": 56,
    "ayah_number": 72,
    "global_ayah_id": 5051,
    "translation": "Is it you that originated its tree, or are We the Originator?"
  },
  {
    "surah_id": 56,
    "ayah_number": 73,
    "global_ayah_id": 5052,
    "translation": "We have made it a reminder, and a blessing to the traveler."
  },
  {
    "surah_id": 56,
    "ayah_number": 74,
    "global_ayah_id": 5053,
    "translation": "Then, exalt the Name of your Lord, the Great."
  },
  {
    "surah_id": 56,
    "ayah_number": 75,
    "global_ayah_id": 5054,
    "translation": "I swear by the fallings of the stars"
  },
  {
    "surah_id": 56,
    "ayah_number": 76,
    "global_ayah_id": 5055,
    "translation": "and that is a mighty oath, if you but knew"
  },
  {
    "surah_id": 56,
    "ayah_number": 77,
    "global_ayah_id": 5056,
    "translation": "it is indeed a Glorious Koran,"
  },
  {
    "surah_id": 56,
    "ayah_number": 78,
    "global_ayah_id": 5057,
    "translation": "in a Book protected (from tampering)"
  },
  {
    "surah_id": 56,
    "ayah_number": 79,
    "global_ayah_id": 5058,
    "translation": "which none shall touch except the purified;"
  },
  {
    "surah_id": 56,
    "ayah_number": 80,
    "global_ayah_id": 5059,
    "translation": "a sending down from the Lord of all the Worlds."
  },
  {
    "surah_id": 56,
    "ayah_number": 81,
    "global_ayah_id": 5060,
    "translation": "What, do you hold this discourse in disdain,"
  },
  {
    "surah_id": 56,
    "ayah_number": 82,
    "global_ayah_id": 5061,
    "translation": "do you make it your provision to belie it?"
  },
  {
    "surah_id": 56,
    "ayah_number": 83,
    "global_ayah_id": 5062,
    "translation": "Why, then, when the soul leaps up to the throat of the dying"
  },
  {
    "surah_id": 56,
    "ayah_number": 84,
    "global_ayah_id": 5063,
    "translation": "and you are watching at that time"
  },
  {
    "surah_id": 56,
    "ayah_number": 85,
    "global_ayah_id": 5064,
    "translation": "We are nearer to him than you, but you do not see"
  },
  {
    "surah_id": 56,
    "ayah_number": 86,
    "global_ayah_id": 5065,
    "translation": "why then, if you are not revived,"
  },
  {
    "surah_id": 56,
    "ayah_number": 87,
    "global_ayah_id": 5066,
    "translation": "do you not restore his soul, if you are truthful?"
  },
  {
    "surah_id": 56,
    "ayah_number": 88,
    "global_ayah_id": 5067,
    "translation": "If he is among the near"
  },
  {
    "surah_id": 56,
    "ayah_number": 89,
    "global_ayah_id": 5068,
    "translation": "there shall be calmness and ease, a Garden of Delight."
  },
  {
    "surah_id": 56,
    "ayah_number": 90,
    "global_ayah_id": 5069,
    "translation": "If he is a Companion of the Right"
  },
  {
    "surah_id": 56,
    "ayah_number": 91,
    "global_ayah_id": 5070,
    "translation": "(he will be greeted with): 'Peace be upon you, Companion of the Right'"
  },
  {
    "surah_id": 56,
    "ayah_number": 92,
    "global_ayah_id": 5071,
    "translation": "But, if he is of those who belied, and went astray,"
  },
  {
    "surah_id": 56,
    "ayah_number": 93,
    "global_ayah_id": 5072,
    "translation": "there shall be a hospitality of boiling water,"
  },
  {
    "surah_id": 56,
    "ayah_number": 94,
    "global_ayah_id": 5073,
    "translation": "and a roasting in Hell."
  },
  {
    "surah_id": 56,
    "ayah_number": 95,
    "global_ayah_id": 5074,
    "translation": "Indeed, this is the certain truth."
  },
  {
    "surah_id": 56,
    "ayah_number": 96,
    "global_ayah_id": 5075,
    "translation": "So exalt the Name of your Lord, the Great."
  }
]