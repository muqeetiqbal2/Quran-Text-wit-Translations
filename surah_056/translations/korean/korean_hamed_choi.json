[
  {
    "surah_id": 56,
    "ayah_number": 1,
    "global_ayah_id": 4980,
    "translation": "불가피한 사건이 있을 때"
  },
  {
    "surah_id": 56,
    "ayah_number": 2,
    "global_ayah_id": 4981,
    "translation": "그것이 오는 것에 대하여 어 느 누구도 거짓이라 하지 못하며"
  },
  {
    "surah_id": 56,
    "ayah_number": 3,
    "global_ayah_id": 4982,
    "translation": "어떤 무리는 굴욕을 받을 것이 요 어떤 무리는 찬양을 받으리라"
  },
  {
    "surah_id": 56,
    "ayah_number": 4,
    "global_ayah_id": 4983,
    "translation": "그때 대지가 깊숙이 흔들릴 것이요"
  },
  {
    "surah_id": 56,
    "ayah_number": 5,
    "global_ayah_id": 4984,
    "translation": "산들은 산산조각이 나며"
  },
  {
    "surah_id": 56,
    "ayah_number": 6,
    "global_ayah_id": 4985,
    "translation": "먼지가 되어 산산히 흩어지니라"
  },
  {
    "surah_id": 56,
    "ayah_number": 7,
    "global_ayah_id": 4986,
    "translation": "그리고 너희는 세 무리로 분 류되나니"
  },
  {
    "surah_id": 56,
    "ayah_number": 8,
    "global_ayah_id": 4987,
    "translation": "그 중 하나는 우편의 동료가 될 것이라 너희는 우편의 동료가 무엇인지 아느뇨"
  },
  {
    "surah_id": 56,
    "ayah_number": 9,
    "global_ayah_id": 4988,
    "translation": "그리고 좌편의 동료가 될 것 이라 너희는 좌편의 동료가 무엇 인지 아느뇨"
  },
  {
    "surah_id": 56,
    "ayah_number": 10,
    "global_ayah_id": 4989,
    "translation": "앞서는 자가 될 것이라 너 희는 앞서는 자에 대하여 아느뇨"
  },
  {
    "surah_id": 56,
    "ayah_number": 11,
    "global_ayah_id": 4990,
    "translation": "이들은 하나님 가까이 가서"
  },
  {
    "surah_id": 56,
    "ayah_number": 12,
    "global_ayah_id": 4991,
    "translation": "축복의 천국에서 기거하노라"
  },
  {
    "surah_id": 56,
    "ayah_number": 13,
    "global_ayah_id": 4992,
    "translation": "그곳에는 옛 선조들도 있으나"
  },
  {
    "surah_id": 56,
    "ayah_number": 14,
    "global_ayah_id": 4993,
    "translation": "후세의 사람들은 소수더라"
  },
  {
    "surah_id": 56,
    "ayah_number": 15,
    "global_ayah_id": 4994,
    "translation": "그들은 금으로 장식된 금좌 에 앉아"
  },
  {
    "surah_id": 56,
    "ayah_number": 16,
    "global_ayah_id": 4995,
    "translation": "서로가 서로에게 얼굴을 마 주보며 기대니"
  },
  {
    "surah_id": 56,
    "ayah_number": 17,
    "global_ayah_id": 4996,
    "translation": "영원히 사는 소년들이 그들 주위를 돌며"
  },
  {
    "surah_id": 56,
    "ayah_number": 18,
    "global_ayah_id": 4997,
    "translation": "술잔과 주전자와 깨끗한 물 그리고 가득찬 잔들로 봉사하더라"
  },
  {
    "surah_id": 56,
    "ayah_number": 19,
    "global_ayah_id": 4998,
    "translation": "그것으로 그들은 두통을 앓 지도 취하지도 아니하며"
  },
  {
    "surah_id": 56,
    "ayah_number": 20,
    "global_ayah_id": 4999,
    "translation": "그들은 취향에 따라 과일을 선택하노라"
  },
  {
    "surah_id": 56,
    "ayah_number": 21,
    "global_ayah_id": 5000,
    "translation": "그들이 원하는 조류의 고기 를 즐기며"
  },
  {
    "surah_id": 56,
    "ayah_number": 22,
    "global_ayah_id": 5001,
    "translation": "눈이 크고 아름다운 배우자 가 있으매"
  },
  {
    "surah_id": 56,
    "ayah_number": 23,
    "global_ayah_id": 5002,
    "translation": "잘 보호된 진주와 같노라"
  },
  {
    "surah_id": 56,
    "ayah_number": 24,
    "global_ayah_id": 5003,
    "translation": "이것들은 그들이 행한 것에 대한 보상이라"
  },
  {
    "surah_id": 56,
    "ayah_number": 25,
    "global_ayah_id": 5004,
    "translation": "그들은 그곳에서 무익하고 욕된 말들을 듣지 아니하며"
  },
  {
    "surah_id": 56,
    "ayah_number": 26,
    "global_ayah_id": 5005,
    "translation": "단지 평안하소서 평안하소서라는 말만 듣노라"
  },
  {
    "surah_id": 56,
    "ayah_number": 27,
    "global_ayah_id": 5006,
    "translation": "우편의 동료가 있나니 너희 는 우편의 동료에 대하여 아느뇨"
  },
  {
    "surah_id": 56,
    "ayah_number": 28,
    "global_ayah_id": 5007,
    "translation": "그들은 가시가 없는 시드라 나무 가운데 있을 것이며"
  },
  {
    "surah_id": 56,
    "ayah_number": 29,
    "global_ayah_id": 5008,
    "translation": "송이송이 열매 맺힌 딸하 나 무 가운데 있노라"
  },
  {
    "surah_id": 56,
    "ayah_number": 30,
    "global_ayah_id": 5009,
    "translation": "그늘이 길게 펼쳐져 있고"
  },
  {
    "surah_id": 56,
    "ayah_number": 31,
    "global_ayah_id": 5010,
    "translation": "물이 끊임없이 흘러나오며"
  },
  {
    "surah_id": 56,
    "ayah_number": 32,
    "global_ayah_id": 5011,
    "translation": "풍성한 과일이 있노라"
  },
  {
    "surah_id": 56,
    "ayah_number": 33,
    "global_ayah_id": 5012,
    "translation": "계절에 제한받지 않는 것들 이라"
  },
  {
    "surah_id": 56,
    "ayah_number": 34,
    "global_ayah_id": 5013,
    "translation": "높은 곳에 옥좌가 있노라"
  },
  {
    "surah_id": 56,
    "ayah_number": 35,
    "global_ayah_id": 5014,
    "translation": "하나님은 그들을 위해 새로 운 배우자들을 두시고"
  },
  {
    "surah_id": 56,
    "ayah_number": 36,
    "global_ayah_id": 5015,
    "translation": "그녀들을 순결케 하였으며"
  },
  {
    "surah_id": 56,
    "ayah_number": 37,
    "global_ayah_id": 5016,
    "translation": "나이가 같으며 사랑받게 하 셨느니라"
  },
  {
    "surah_id": 56,
    "ayah_number": 38,
    "global_ayah_id": 5017,
    "translation": "이는 우편의 동료들을 위해 서라"
  },
  {
    "surah_id": 56,
    "ayah_number": 39,
    "global_ayah_id": 5018,
    "translation": "그 곳에는 옛 선조들도 많으 며"
  },
  {
    "surah_id": 56,
    "ayah_number": 40,
    "global_ayah_id": 5019,
    "translation": "후세의 사람들도 많이 있노라"
  },
  {
    "surah_id": 56,
    "ayah_number": 41,
    "global_ayah_id": 5020,
    "translation": "좌편의 동료가 있나니 너희는좌편의 동료가 무엇인지 아느뇨"
  },
  {
    "surah_id": 56,
    "ayah_number": 42,
    "global_ayah_id": 5021,
    "translation": "그들은 작열하는 볼지옥과 들끓는 물속에 있게 되고"
  },
  {
    "surah_id": 56,
    "ayah_number": 43,
    "global_ayah_id": 5022,
    "translation": "검은 연기 속에 있게 되니"
  },
  {
    "surah_id": 56,
    "ayah_number": 44,
    "global_ayah_id": 5023,
    "translation": "시원한 것도 즐길 수 없노라"
  },
  {
    "surah_id": 56,
    "ayah_number": 45,
    "global_ayah_id": 5024,
    "translation": "이는 그들이 이전에 재물과 사치에 탐닉하여"
  },
  {
    "surah_id": 56,
    "ayah_number": 46,
    "global_ayah_id": 5025,
    "translation": "크게 사악하고 오만하였으며"
  },
  {
    "surah_id": 56,
    "ayah_number": 47,
    "global_ayah_id": 5026,
    "translation": "죽어 흙이되어 뼈만 남는 우 리가 다시 부활한단 말이뇨 라고 말하였더라"
  },
  {
    "surah_id": 56,
    "ayah_number": 48,
    "global_ayah_id": 5027,
    "translation": "우리 선조들도 그렇단 말이 요 라고 말했더라"
  },
  {
    "surah_id": 56,
    "ayah_number": 49,
    "global_ayah_id": 5028,
    "translation": "일러가로되 그러하니라 옛 선조들도 그리고 후세의 사람들도"
  },
  {
    "surah_id": 56,
    "ayah_number": 50,
    "global_ayah_id": 5029,
    "translation": "모두가 잘 알려진 어떤 날 상봉을 위하여 다같이 모이니"
  },
  {
    "surah_id": 56,
    "ayah_number": 51,
    "global_ayah_id": 5030,
    "translation": "방황하고 거짓했던 자들이여"
  },
  {
    "surah_id": 56,
    "ayah_number": 52,
    "global_ayah_id": 5031,
    "translation": "너희는 자꿈나무를 맛보리 라"
  },
  {
    "surah_id": 56,
    "ayah_number": 53,
    "global_ayah_id": 5032,
    "translation": "그때 너희 배들은 그것으로 부풀어 오르고"
  },
  {
    "surah_id": 56,
    "ayah_number": 54,
    "global_ayah_id": 5033,
    "translation": "그 위로 들끓는 물을 마시매"
  },
  {
    "surah_id": 56,
    "ayah_number": 55,
    "global_ayah_id": 5034,
    "translation": "갈증에 허덕이는 낙타가 마 시는 것과 같더라"
  },
  {
    "surah_id": 56,
    "ayah_number": 56,
    "global_ayah_id": 5035,
    "translation": "그러함이 그들이 받을 보상 의 날 대접이라"
  },
  {
    "surah_id": 56,
    "ayah_number": 57,
    "global_ayah_id": 5036,
    "translation": "하나님이 너희를 창조하였으 되 너희는 그 진리를 믿으려 하지 않느뇨"
  },
  {
    "surah_id": 56,
    "ayah_number": 58,
    "global_ayah_id": 5037,
    "translation": "너희는 인간의 정액을 생각해 보았느뇨"
  },
  {
    "surah_id": 56,
    "ayah_number": 59,
    "global_ayah_id": 5038,
    "translation": "그것은 너희가 창조한 것이뇨아니면 하나님이 창조한 것이뇨"
  },
  {
    "surah_id": 56,
    "ayah_number": 60,
    "global_ayah_id": 5039,
    "translation": "하나님은 너희 가운데 누구 에게라도 죽음을 이르게 할 수 있 으되 좌절하지 아니하며"
  },
  {
    "surah_id": 56,
    "ayah_number": 61,
    "global_ayah_id": 5040,
    "translation": "너희의 양상을 바꾸어 너희 가 알지 못하는 양상으로 너희를 재창조 하시니라"
  },
  {
    "surah_id": 56,
    "ayah_number": 62,
    "global_ayah_id": 5041,
    "translation": "너희는 최초의 창조를 알고 있으면서 그것을 교훈으로 삼지 않느뇨"
  },
  {
    "surah_id": 56,
    "ayah_number": 63,
    "global_ayah_id": 5042,
    "translation": "너희가 땅에 심는 씨앗을 보 지 아니 했느뇨"
  },
  {
    "surah_id": 56,
    "ayah_number": 64,
    "global_ayah_id": 5043,
    "translation": "너희가 그것을 자라게 하느 뇨 아니면 하나님이 성장케 하느 뇨"
  },
  {
    "surah_id": 56,
    "ayah_number": 65,
    "global_ayah_id": 5044,
    "translation": "하나님이 원한다면 그분은 그것을 산산조각으로 만드시니라 그때 너희는 비탄에 빠지며"
  },
  {
    "surah_id": 56,
    "ayah_number": 66,
    "global_ayah_id": 5045,
    "translation": "실로 저희는 부채만을 지게 되었으며"
  },
  {
    "surah_id": 56,
    "ayah_number": 67,
    "global_ayah_id": 5046,
    "translation": "모든 것이 헛되었도다 라고 말할 것이라"
  },
  {
    "surah_id": 56,
    "ayah_number": 68,
    "global_ayah_id": 5047,
    "translation": "너희는 너희가 마시는 물을 생각하여 보았느뇨"
  },
  {
    "surah_id": 56,
    "ayah_number": 69,
    "global_ayah_id": 5048,
    "translation": "너희가 비를 내리게 하느뇨 아니면 하나님이 비를 내리게 하 느뇨"
  },
  {
    "surah_id": 56,
    "ayah_number": 70,
    "global_ayah_id": 5049,
    "translation": "하나님이 원했다면 그분은 그것을 짜게 하셨으리라 그래도 너희는 감사하려 하지 않느뇨"
  },
  {
    "surah_id": 56,
    "ayah_number": 71,
    "global_ayah_id": 5050,
    "translation": "너희가 킨 불을 생각하여 보았느뇨"
  },
  {
    "surah_id": 56,
    "ayah_number": 72,
    "global_ayah_id": 5051,
    "translation": "불을 켜기위해 나무를 심은 자가 너희이뇨 아니면 하나님이 그것을 성장케 하느뇨"
  },
  {
    "surah_id": 56,
    "ayah_number": 73,
    "global_ayah_id": 5052,
    "translation": "하나님은 그것으로 교훈이 되게 하였고 여행자들에게 유용 하도록 하였노라"
  },
  {
    "surah_id": 56,
    "ayah_number": 74,
    "global_ayah_id": 5053,
    "translation": "그러므로 위대한 그대 주님 의 이름으로 찬미하라"
  },
  {
    "surah_id": 56,
    "ayah_number": 75,
    "global_ayah_id": 5054,
    "translation": "실로 지는 별들을 두고 맹 세하나니"
  },
  {
    "surah_id": 56,
    "ayah_number": 76,
    "global_ayah_id": 5055,
    "translation": "너희가 알고만 있다면 실로 이것은 하나의 위대한 맹세로"
  },
  {
    "surah_id": 56,
    "ayah_number": 77,
    "global_ayah_id": 5056,
    "translation": "이것이 성스러운 꾸란이라"
  },
  {
    "surah_id": 56,
    "ayah_number": 78,
    "global_ayah_id": 5057,
    "translation": "잘 보호된 성서로"
  },
  {
    "surah_id": 56,
    "ayah_number": 79,
    "global_ayah_id": 5058,
    "translation": "청결한 자 외에는 아무도 스치지 아니한"
  },
  {
    "surah_id": 56,
    "ayah_number": 80,
    "global_ayah_id": 5059,
    "translation": "만유의 주님으로부터 계시된 것이라"
  },
  {
    "surah_id": 56,
    "ayah_number": 81,
    "global_ayah_id": 5060,
    "translation": "그래도 너희는 이 말씀을 조롱하느뇨"
  },
  {
    "surah_id": 56,
    "ayah_number": 82,
    "global_ayah_id": 5061,
    "translation": "너희의 양식으로 감사하지 아니하고 불신하려 하느뇨"
  },
  {
    "surah_id": 56,
    "ayah_number": 83,
    "global_ayah_id": 5062,
    "translation": "너희의 영혼이 목까지 이를 때"
  },
  {
    "surah_id": 56,
    "ayah_number": 84,
    "global_ayah_id": 5063,
    "translation": "그때 너희는 지켜 보리라"
  },
  {
    "surah_id": 56,
    "ayah_number": 85,
    "global_ayah_id": 5064,
    "translation": "하나님이 그것 가까이 있으 되 너희가 알지 못하노라"
  },
  {
    "surah_id": 56,
    "ayah_number": 86,
    "global_ayah_id": 5065,
    "translation": "너희가 주장했듯 계산을 받 지 아니하고"
  },
  {
    "surah_id": 56,
    "ayah_number": 87,
    "global_ayah_id": 5066,
    "translation": "너희가 진실이라면 그 영혼 을 불러오지 못하느뇨"
  },
  {
    "surah_id": 56,
    "ayah_number": 88,
    "global_ayah_id": 5067,
    "translation": "그러나 하나님 가까이 있는 자를 위해"
  },
  {
    "surah_id": 56,
    "ayah_number": 89,
    "global_ayah_id": 5068,
    "translation": "행복과 풍성함과 축복받은 천국이 그를 위해 있노라"
  },
  {
    "surah_id": 56,
    "ayah_number": 90,
    "global_ayah_id": 5069,
    "translation": "우편의 동료들 중에 있다면"
  },
  {
    "surah_id": 56,
    "ayah_number": 91,
    "global_ayah_id": 5070,
    "translation": "우편의 동료들로부터 평안하소서 라는 인사를 받을 것이며"
  },
  {
    "surah_id": 56,
    "ayah_number": 92,
