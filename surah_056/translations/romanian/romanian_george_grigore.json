[
  {
    "surah_id": 56,
    "ayah_number": 1,
    "global_ayah_id": 4980,
    "translation": "Când faptul se va împlini,"
  },
  {
    "surah_id": 56,
    "ayah_number": 2,
    "global_ayah_id": 4981,
    "translation": "nimeni nu-l va mai socoti minciună."
  },
  {
    "surah_id": 56,
    "ayah_number": 3,
    "global_ayah_id": 4982,
    "translation": "El coboară, El ridică!"
  },
  {
    "surah_id": 56,
    "ayah_number": 4,
    "global_ayah_id": 4983,
    "translation": "Când pământul va fi zgâlţâit din ţâţâni,"
  },
  {
    "surah_id": 56,
    "ayah_number": 5,
    "global_ayah_id": 4984,
    "translation": "când munţii vor fi făcuţi fărâme"
  },
  {
    "surah_id": 56,
    "ayah_number": 6,
    "global_ayah_id": 4985,
    "translation": "şi vor fi precum praful spulberat,"
  },
  {
    "surah_id": 56,
    "ayah_number": 7,
    "global_ayah_id": 4986,
    "translation": "atunci veţi fi voi de trei feluri."
  },
  {
    "surah_id": 56,
    "ayah_number": 8,
    "global_ayah_id": 4987,
    "translation": "Cei de-a dreapta! Cine vor fi oare cei de-a dreapta?"
  },
  {
    "surah_id": 56,
    "ayah_number": 9,
    "global_ayah_id": 4988,
    "translation": "Cei de-a stânga! Cine vor fi oare cei de-a stânga?"
  },
  {
    "surah_id": 56,
    "ayah_number": 10,
    "global_ayah_id": 4989,
    "translation": "Cei înainte mergători. Înainte mergătorii,"
  },
  {
    "surah_id": 56,
    "ayah_number": 11,
    "global_ayah_id": 4990,
    "translation": "ei vor fi cei apropiaţi."
  },
  {
    "surah_id": 56,
    "ayah_number": 12,
    "global_ayah_id": 4991,
    "translation": "În Grădinile Plăcerii"
  },
  {
    "surah_id": 56,
    "ayah_number": 13,
    "global_ayah_id": 4992,
    "translation": "vor fi mulţime dintre primii"
  },
  {
    "surah_id": 56,
    "ayah_number": 14,
    "global_ayah_id": 4993,
    "translation": "şi puţinii dintre ultimii,"
  },
  {
    "surah_id": 56,
    "ayah_number": 15,
    "global_ayah_id": 4994,
    "translation": "pe paturi împletite,"
  },
  {
    "surah_id": 56,
    "ayah_number": 16,
    "global_ayah_id": 4995,
    "translation": "întinşi pe ele faţă în faţă."
  },
  {
    "surah_id": 56,
    "ayah_number": 17,
    "global_ayah_id": 4996,
    "translation": "Flăcăiandri nemuritori vor umbla printre ei"
  },
  {
    "surah_id": 56,
    "ayah_number": 18,
    "global_ayah_id": 4997,
    "translation": "cu potire şi ibrice, şi un pocal de la izvor"
  },
  {
    "surah_id": 56,
    "ayah_number": 19,
    "global_ayah_id": 4998,
    "translation": "de care nu-i va durea capul şi nici nu se vor îmbăta;"
  },
  {
    "surah_id": 56,
    "ayah_number": 20,
    "global_ayah_id": 4999,
    "translation": "fructele vor fi pe alese"
  },
  {
    "surah_id": 56,
    "ayah_number": 21,
    "global_ayah_id": 5000,
    "translation": "şi carnea de pasăre după poftă."
  },
  {
    "surah_id": 56,
    "ayah_number": 22,
    "global_ayah_id": 5001,
    "translation": "Vor avea acolo hurii cu ochi"
  },
  {
    "surah_id": 56,
    "ayah_number": 23,
    "global_ayah_id": 5002,
    "translation": "asemenea mărgăritarelor ascunse"
  },
  {
    "surah_id": 56,
    "ayah_number": 24,
    "global_ayah_id": 5003,
    "translation": "drept răsplată a faptelor lor."
  },
  {
    "surah_id": 56,
    "ayah_number": 25,
    "global_ayah_id": 5004,
    "translation": "Şi nu vor auzi acolo vorbe deşarte şi nici învinuiri de păcate"
  },
  {
    "surah_id": 56,
    "ayah_number": 26,
    "global_ayah_id": 5005,
    "translation": "ci numai un singur cuvânt: “Pace!... Pace!”"
  },
  {
    "surah_id": 56,
    "ayah_number": 27,
    "global_ayah_id": 5006,
    "translation": "Cei de-a dreapta! Ce va fi cu cei de-a dreapta?"
  },
  {
    "surah_id": 56,
    "ayah_number": 28,
    "global_ayah_id": 5007,
    "translation": "Ei vor sta sub lotuşi despinaţi,"
  },
  {
    "surah_id": 56,
    "ayah_number": 29,
    "global_ayah_id": 5008,
    "translation": "sub salcâmi frumos înşiraţi."
  },
  {
    "surah_id": 56,
    "ayah_number": 30,
    "global_ayah_id": 5009,
    "translation": "sub umbră întinsă,"
  },
  {
    "surah_id": 56,
    "ayah_number": 31,
    "global_ayah_id": 5010,
    "translation": "lângă apă curgătoare,"
  },
  {
    "surah_id": 56,
    "ayah_number": 32,
    "global_ayah_id": 5011,
    "translation": "cu fructe din belşug"
  },
  {
    "surah_id": 56,
    "ayah_number": 33,
    "global_ayah_id": 5012,
    "translation": "neculese dinainte şi neoprite,"
  },
  {
    "surah_id": 56,
    "ayah_number": 34,
    "global_ayah_id": 5013,
    "translation": "pe aşternuturi înălţate."
  },
  {
    "surah_id": 56,
    "ayah_number": 35,
    "global_ayah_id": 5014,
    "translation": "Noi le-am făcut pe ele în chip deosebit,"
  },
  {
    "surah_id": 56,
    "ayah_number": 36,
    "global_ayah_id": 5015,
    "translation": "Noi le-am făcut fecioare,"
  },
  {
    "surah_id": 56,
    "ayah_number": 37,
    "global_ayah_id": 5016,
    "translation": "iubitoare, însoţitoare"
  },
  {
    "surah_id": 56,
    "ayah_number": 38,
    "global_ayah_id": 5017,
    "translation": "celor de-a dreapta."
  },
  {
    "surah_id": 56,
    "ayah_number": 39,
    "global_ayah_id": 5018,
    "translation": "Mulţi vor fi dintre cei dintâi"
  },
  {
    "surah_id": 56,
    "ayah_number": 40,
    "global_ayah_id": 5019,
    "translation": "şi mulţi vor fi dintre cei de pe urmă."
  },
  {
    "surah_id": 56,
    "ayah_number": 41,
    "global_ayah_id": 5020,
    "translation": "Cei de-a stânga! Ce va fi cu cei de-a stânga?"
  },
  {
    "surah_id": 56,
    "ayah_number": 42,
    "global_ayah_id": 5021,
    "translation": "Ei vor sta sub un vânt arzător într-o apă clocotindă,"
  },
  {
    "surah_id": 56,
    "ayah_number": 43,
    "global_ayah_id": 5022,
    "translation": "sub o umbră de fum negru,"
  },
  {
    "surah_id": 56,
    "ayah_number": 44,
    "global_ayah_id": 5023,
    "translation": "nici răcoroasă şi nici plăcută."
  },
  {
    "surah_id": 56,
    "ayah_number": 45,
    "global_ayah_id": 5024,
    "translation": "Înainte îndestulaţi fiind,"
  },
  {
    "surah_id": 56,
    "ayah_number": 46,
    "global_ayah_id": 5025,
    "translation": "stăruiau în marele păcat."
  },
  {
    "surah_id": 56,
    "ayah_number": 47,
    "global_ayah_id": 5026,
    "translation": "Ei spuneau: “După ce vom muri şi vom fi ţărână şi oase, vom mai fi noi oare sculaţi"
  },
  {
    "surah_id": 56,
    "ayah_number": 48,
    "global_ayah_id": 5027,
    "translation": "ori strămoşii noştri dintâi?”"
  },
  {
    "surah_id": 56,
    "ayah_number": 49,
    "global_ayah_id": 5028,
    "translation": "Spune: “Cei dintâi şi cei de pe urmă,"
  },
  {
    "surah_id": 56,
    "ayah_number": 50,
    "global_ayah_id": 5029,
    "translation": "vor fi adunaţi la vremea cunoscută a unei Zile.”"
  },
  {
    "surah_id": 56,
    "ayah_number": 51,
    "global_ayah_id": 5030,
    "translation": "O, voi cei rătăciţi, cei hulitori!"
  },
  {
    "surah_id": 56,
    "ayah_number": 52,
    "global_ayah_id": 5031,
    "translation": "Veţi mânca fructe din copacul Zaqqum"
  },
  {
    "surah_id": 56,
    "ayah_number": 53,
    "global_ayah_id": 5032,
    "translation": "până vă veţi umple burţile,"
  },
  {
    "surah_id": 56,
    "ayah_number": 54,
    "global_ayah_id": 5033,
    "translation": "apoi veţi bea după ele apă clocotindă —"
  },
  {
    "surah_id": 56,
    "ayah_number": 55,
    "global_ayah_id": 5034,
    "translation": "veţi bea precum cămilele însetate."
  },
  {
    "surah_id": 56,
    "ayah_number": 56,
    "global_ayah_id": 5035,
    "translation": "Aşa va fi găzduirea lor în Ziua Judecăţii!"
  },
  {
    "surah_id": 56,
    "ayah_number": 57,
    "global_ayah_id": 5036,
    "translation": "Noi v-am creat. De ce nu credeţi totuşi?"
  },
  {
    "surah_id": 56,
    "ayah_number": 58,
    "global_ayah_id": 5037,
    "translation": "Vedeţi sămânţa pe care o vărsaţi?"
  },
  {
    "surah_id": 56,
    "ayah_number": 59,
    "global_ayah_id": 5038,
    "translation": "Voi aţi creat-o ori Noi suntem Creatorii?"
  },
  {
    "surah_id": 56,
    "ayah_number": 60,
    "global_ayah_id": 5039,
    "translation": "Noi am sorocit moartea printre voi şi nimeni nu Ne-o poate lua înainte"
  },
  {
    "surah_id": 56,
    "ayah_number": 61,
    "global_ayah_id": 5040,
    "translation": "ca să vă înlocuim cu alţii asemenea vouă şi să vă facem cum voi nici nu ştiţi."
  },
  {
    "surah_id": 56,
    "ayah_number": 62,
    "global_ayah_id": 5041,
    "translation": "Cunoaşteţi întâia facere? De ce nu vă aduceţi aminte însă?"
  },
  {
    "surah_id": 56,
    "ayah_number": 63,
    "global_ayah_id": 5042,
    "translation": "Aţi văzut ceea ce aţi arat?"
  },
  {
    "surah_id": 56,
    "ayah_number": 64,
    "global_ayah_id": 5043,
    "translation": "Voi îl veţi semăna ori Noi vom fi Semănătorii?"
  },
  {
    "surah_id": 56,
    "ayah_number": 65,
    "global_ayah_id": 5044,
    "translation": "Dacă am vrea, l-am face pustiu. V-ar mai arde, atunci, de glume?"
  },
  {
    "surah_id": 56,
    "ayah_number": 66,
    "global_ayah_id": 5045,
    "translation": "“Iată-ne datornici,"
  },
  {
    "surah_id": 56,
    "ayah_number": 67,
    "global_ayah_id": 5046,
    "translation": "ba chiar de tot lipsiţi!”"
  },
  {
    "surah_id": 56,
    "ayah_number": 68,
    "global_ayah_id": 5047,
    "translation": "Aţi văzut apa pe care o beţi?"
  },
  {
    "surah_id": 56,
    "ayah_number": 69,
    "global_ayah_id": 5048,
    "translation": "Voi aţi pogorât-o din nori ori Noi suntem Cei care am pogorât-o?"
  },
  {
    "surah_id": 56,
    "ayah_number": 70,
    "global_ayah_id": 5049,
    "translation": "Dacă am vrea, am face-o amară! De ce nu mulţumiţi totuşi!"
  },
  {
    "surah_id": 56,
    "ayah_number": 71,
    "global_ayah_id": 5050,
    "translation": "Aţi văzut focul pe care-l aprindeţi?"
  },
  {
    "surah_id": 56,
    "ayah_number": 72,
    "global_ayah_id": 5051,
    "translation": "Voi aţi făcut să crească copacul lui ori Noi suntem cei care l-am făcut?"
  },
  {
    "surah_id": 56,
    "ayah_number": 73,
    "global_ayah_id": 5052,
    "translation": "Noi am făcut toate acestea drept amintire şi bucurie pentru călătorii pustiului."
  },
  {
    "surah_id": 56,
    "ayah_number": 74,
    "global_ayah_id": 5053,
    "translation": "Preamăreşte numele Domnului tău cel Mare."
  },
  {
    "surah_id": 56,
    "ayah_number": 75,
    "global_ayah_id": 5054,
    "translation": "Nu!... Jur pe asfinţitul stelelor!"
  },
  {
    "surah_id": 56,
    "ayah_number": 76,
    "global_ayah_id": 5055,
    "translation": "Şi este un jurământ, dacă ştiţi, greu!"
  },
  {
    "surah_id": 56,
    "ayah_number": 77,
    "global_ayah_id": 5056,
    "translation": "Acesta este un Coran Prea-cinstit."
  },
  {
    "surah_id": 56,
    "ayah_number": 78,
    "global_ayah_id": 5057,
    "translation": "dintr-o Carte ascunsă."
  },
  {
    "surah_id": 56,
    "ayah_number": 79,
    "global_ayah_id": 5058,
    "translation": "Să nu-l atingă decât cei curaţi,"
  },
  {
    "surah_id": 56,
    "ayah_number": 80,
    "global_ayah_id": 5059,
    "translation": "căci este o Pogorâre de la Domnul lumilor!"
  },
  {
    "surah_id": 56,
    "ayah_number": 81,
    "global_ayah_id": 5060,
    "translation": "Vă îndoiţi de această spusă?"
  },
  {
    "surah_id": 56,
    "ayah_number": 82,
    "global_ayah_id": 5061,
    "translation": "Vreţi să vă câştigaţi traiul hulind?"
  },
  {
    "surah_id": 56,
    "ayah_number": 83,
    "global_ayah_id": 5062,
    "translation": "Când sufletul dă să iasă"
  },
  {
    "surah_id": 56,
    "ayah_number": 84,
    "global_ayah_id": 5063,
    "translation": "şi voi, în clipa aceea îl priviţi,"
  },
  {
    "surah_id": 56,
    "ayah_number": 85,
    "global_ayah_id": 5064,
    "translation": "Noi suntem mult mai aproape de el decât voi cei ce-l înconjuraţi, însă nu Ne puteţi zări."
  },
  {
    "surah_id": 56,
    "ayah_number": 86,
    "global_ayah_id": 5065,
    "translation": "Dacă nu aţi fi printre cei care vor fi judecaţi,"
  },
  {
    "surah_id": 56,
    "ayah_number": 87,
    "global_ayah_id": 5066,
    "translation": "de ce nu întoarceţi acest suflet, dacă spuneţi adevărul?"
  },
  {
    "surah_id": 56,
    "ayah_number": 88,
    "global_ayah_id": 5067,
    "translation": "Dacă acest om este dintre cei apropiaţi de Dumnezeu,"
  },
  {
    "surah_id": 56,
    "ayah_number": 89,
    "global_ayah_id": 5068,
    "translation": "va găsi tihna, parfumurile şi Grădinile Plăcerii."
  },
  {
    "surah_id": 56,
    "ayah_number": 90,
    "global_ayah_id": 5069,
    "translation": "Dacă este dintre cei de-a dreapta:"
  },
  {
    "surah_id": 56,
    "ayah_number": 91,
    "global_ayah_id": 5070,
    "translation": "“Pace ţie!... Tu eşti cu cei de-a dreapta!”"
  },
  {
    "surah_id": 56,
    "ayah_number": 92,
    "global_ayah_id": 5071,
    "translation": "Dacă este însă dintre hulitorii rătăciţi,"
  },
  {
    "surah_id": 56,
    "ayah_number": 93,
    "global_ayah_id": 5072,
    "translation": "va fi găzduit în apă clocotindă"
  },
  {
    "surah_id": 56,
    "ayah_number": 94,
    "global_ayah_id": 5073,
    "translation": "şi apoi aruncat în Iadul cu flăcări."
  },
  {
    "surah_id": 56,
    "ayah_number": 95,
    "global_ayah_id": 5074,
    "translation": "Acesta este Adevărul sigur!"
  },
  {
    "surah_id": 56,
    "ayah_number": 96,
    "global_ayah_id": 5075,
    "translation": "Preamăreşte Numele Domnului tău cel Mare!"
  }
]