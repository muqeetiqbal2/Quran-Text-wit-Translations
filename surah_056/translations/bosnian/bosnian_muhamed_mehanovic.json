[
  {
    "surah_id": 56,
    "ayah_number": 1,
    "global_ayah_id": 4980,
    "translation": "Kada se Neizbježni događaj zbije,"
  },
  {
    "surah_id": 56,
    "ayah_number": 2,
    "global_ayah_id": 4981,
    "translation": "događanju njegovom nema poništenja,"
  },
  {
    "surah_id": 56,
    "ayah_number": 3,
    "global_ayah_id": 4982,
    "translation": "neke će poniziti, a neke uzvisiti."
  },
  {
    "surah_id": 56,
    "ayah_number": 4,
    "global_ayah_id": 4983,
    "translation": "Kad se Zemlja jako potrese"
  },
  {
    "surah_id": 56,
    "ayah_number": 5,
    "global_ayah_id": 4984,
    "translation": "i brda se u komadiće zdrobe,"
  },
  {
    "surah_id": 56,
    "ayah_number": 6,
    "global_ayah_id": 4985,
    "translation": "i postanu prašina razasuta,"
  },
  {
    "surah_id": 56,
    "ayah_number": 7,
    "global_ayah_id": 4986,
    "translation": "vas će tri vrste biti:"
  },
  {
    "surah_id": 56,
    "ayah_number": 8,
    "global_ayah_id": 4987,
    "translation": "oni zdesna - šta će biti s onim zdesna?!"
  },
  {
    "surah_id": 56,
    "ayah_number": 9,
    "global_ayah_id": 4988,
    "translation": "i oni slijeva - šta će biti s onim slijeva?"
  },
  {
    "surah_id": 56,
    "ayah_number": 10,
    "global_ayah_id": 4989,
    "translation": "i oni koji prednjače - oni će prednjačiti!"
  },
  {
    "surah_id": 56,
    "ayah_number": 11,
    "global_ayah_id": 4990,
    "translation": "To su oni bliski,"
  },
  {
    "surah_id": 56,
    "ayah_number": 12,
    "global_ayah_id": 4991,
    "translation": "u džennetskim baščama naslada bit će."
  },
  {
    "surah_id": 56,
    "ayah_number": 13,
    "global_ayah_id": 4992,
    "translation": "Bit će ih mnogo iz prvih,"
  },
  {
    "surah_id": 56,
    "ayah_number": 14,
    "global_ayah_id": 4993,
    "translation": "a malo iz zadnjih!"
  },
  {
    "surah_id": 56,
    "ayah_number": 15,
    "global_ayah_id": 4994,
    "translation": "na divanima izvezenim,"
  },
  {
    "surah_id": 56,
    "ayah_number": 16,
    "global_ayah_id": 4995,
    "translation": "jedni prema drugima na njima će naslonjeni biti;"
  },
  {
    "surah_id": 56,
    "ayah_number": 17,
    "global_ayah_id": 4996,
    "translation": "služit će ih vječno mladi dječaci,"
  },
  {
    "surah_id": 56,
    "ayah_number": 18,
    "global_ayah_id": 4997,
    "translation": "sa čašama i ibricima, i peharom punim pića iz izvora tekućeg"
  },
  {
    "surah_id": 56,
    "ayah_number": 19,
    "global_ayah_id": 4998,
    "translation": "od koga ih glava neće boljeti i zbog koga neće pamet izgubiti,"
  },
  {
    "surah_id": 56,
    "ayah_number": 20,
    "global_ayah_id": 4999,
    "translation": "i voćem koje će sami birati,"
  },
  {
    "surah_id": 56,
    "ayah_number": 21,
    "global_ayah_id": 5000,
    "translation": "i mesom ptičijim kakvo budu željeli."
  },
  {
    "surah_id": 56,
    "ayah_number": 22,
    "global_ayah_id": 5001,
    "translation": "U njima će biti i hurije očiju krupnih,"
  },
  {
    "surah_id": 56,
    "ayah_number": 23,
    "global_ayah_id": 5002,
    "translation": "slične biseru u školjkama skrivenom,"
  },
  {
    "surah_id": 56,
    "ayah_number": 24,
    "global_ayah_id": 5003,
    "translation": "kao nagrada za ono što su činili."
  },
  {
    "surah_id": 56,
    "ayah_number": 25,
    "global_ayah_id": 5004,
    "translation": "U njima neće slušati prazne besjede, ni govor grešni,"
  },
  {
    "surah_id": 56,
    "ayah_number": 26,
    "global_ayah_id": 5005,
    "translation": "nego samo riječi: \"Selam, selam!\""
  },
  {
    "surah_id": 56,
    "ayah_number": 27,
    "global_ayah_id": 5006,
    "translation": "A oni s desne strane - šta će biti s onim s desne strane?"
  },
  {
    "surah_id": 56,
    "ayah_number": 28,
    "global_ayah_id": 5007,
    "translation": "Bit će među lotosovim drvećem bez bodlji,"
  },
  {
    "surah_id": 56,
    "ayah_number": 29,
    "global_ayah_id": 5008,
    "translation": "i među drvećem akacije plodovima nanizanim,"
  },
  {
    "surah_id": 56,
    "ayah_number": 30,
    "global_ayah_id": 5009,
    "translation": "i u hladovini prostranoj,"
  },
  {
    "surah_id": 56,
    "ayah_number": 31,
    "global_ayah_id": 5010,
    "translation": "pored vode tekuće"
  },
  {
    "surah_id": 56,
    "ayah_number": 32,
    "global_ayah_id": 5011,
    "translation": "i usred voća svakovrsnog"
  },
  {
    "surah_id": 56,
    "ayah_number": 33,
    "global_ayah_id": 5012,
    "translation": "koje će uvijek imati i koje neće zabranjeno biti"
  },
  {
    "surah_id": 56,
    "ayah_number": 34,
    "global_ayah_id": 5013,
    "translation": "i na posteljama uzdignutim."
  },
  {
    "surah_id": 56,
    "ayah_number": 35,
    "global_ayah_id": 5014,
    "translation": "Stvaranje njihovo, zaista, ćemo obnoviti."
  },
  {
    "surah_id": 56,
    "ayah_number": 36,
    "global_ayah_id": 5015,
    "translation": "i djevicama ih učiniti,"
  },
  {
    "surah_id": 56,
    "ayah_number": 37,
    "global_ayah_id": 5016,
    "translation": "te onim koje se umiljavaju muževima svojim i godina istih"
  },
  {
    "surah_id": 56,
    "ayah_number": 38,
    "global_ayah_id": 5017,
    "translation": "za one s desne strane."
  },
  {
    "surah_id": 56,
    "ayah_number": 39,
    "global_ayah_id": 5018,
    "translation": "Bit će ih mnogo iz prvih,"
  },
  {
    "surah_id": 56,
    "ayah_number": 40,
    "global_ayah_id": 5019,
    "translation": "a mnogo iz kasnijih."
  },
  {
    "surah_id": 56,
    "ayah_number": 41,
    "global_ayah_id": 5020,
    "translation": "A oni s lijeve strane - šta je s onima s lijeve strane?!"
  },
  {
    "surah_id": 56,
    "ayah_number": 42,
    "global_ayah_id": 5021,
    "translation": "Oni će biti u vrelom dašku vatre i vodi ključaloj,"
  },
  {
    "surah_id": 56,
    "ayah_number": 43,
    "global_ayah_id": 5022,
    "translation": "i u sjeni dima mrkog,"
  },
  {
    "surah_id": 56,
    "ayah_number": 44,
    "global_ayah_id": 5023,
    "translation": "u kojoj neće biti svježine ni bilo kakve ugodnosti."
  },
  {
    "surah_id": 56,
    "ayah_number": 45,
    "global_ayah_id": 5024,
    "translation": "Oni su prije toga raskošnim životom živjeli"
  },
  {
    "surah_id": 56,
    "ayah_number": 46,
    "global_ayah_id": 5025,
    "translation": "i uporno teške grijehe činili"
  },
  {
    "surah_id": 56,
    "ayah_number": 47,
    "global_ayah_id": 5026,
    "translation": "i govorili: \"Zar kad umremo i zemlja i kosti postanemo - zar ćemo zbilja biti oživljeni;"
  },
  {
    "surah_id": 56,
    "ayah_number": 48,
    "global_ayah_id": 5027,
    "translation": "zar i drevni naši preci?!\""
  },
  {
    "surah_id": 56,
    "ayah_number": 49,
    "global_ayah_id": 5028,
    "translation": "Reci: \"I drevni i kasniji,"
  },
  {
    "surah_id": 56,
    "ayah_number": 50,
    "global_ayah_id": 5029,
    "translation": "u određeno vrijeme, i u Dan određeni bit će sakupljeni,"
  },
  {
    "surah_id": 56,
    "ayah_number": 51,
    "global_ayah_id": 5030,
    "translation": "i tada ćete vi, o zabludjeli, koji poričete oživljavanje,"
  },
  {
    "surah_id": 56,
    "ayah_number": 52,
    "global_ayah_id": 5031,
    "translation": "sigurno s drveta zekkum jesti,"
  },
  {
    "surah_id": 56,
    "ayah_number": 53,
    "global_ayah_id": 5032,
    "translation": "i njime ćete trbuhe puniti,"
  },
  {
    "surah_id": 56,
    "ayah_number": 54,
    "global_ayah_id": 5033,
    "translation": "pa zatim na to vodu ključalu piti,"
  },
  {
    "surah_id": 56,
    "ayah_number": 55,
    "global_ayah_id": 5034,
    "translation": "poput kamila koje ne mogu žeđ ugasiti\","
  },
  {
    "surah_id": 56,
    "ayah_number": 56,
    "global_ayah_id": 5035,
    "translation": "to će im na Dan polaganja računa ugošćenje biti!"
  },
  {
    "surah_id": 56,
    "ayah_number": 57,
    "global_ayah_id": 5036,
    "translation": "Mi smo vas stvorili - pa zašto ne povjerujete?"
  },
  {
    "surah_id": 56,
    "ayah_number": 58,
    "global_ayah_id": 5037,
    "translation": "Kažite vi Meni: da li sjemenu koje ubacujete"
  },
  {
    "surah_id": 56,
    "ayah_number": 59,
    "global_ayah_id": 5038,
    "translation": "vi oblik dajete ili Mi to činimo?"
  },
  {
    "surah_id": 56,
    "ayah_number": 60,
    "global_ayah_id": 5039,
    "translation": "Mi određujemo kad će ko od vas umrijeti, i niko Nas ne može spriječiti"
  },
  {
    "surah_id": 56,
    "ayah_number": 61,
    "global_ayah_id": 5040,
    "translation": "da likove vaše izmijenimo i da vas iznova u likovima koje vi ne poznajete stvorimo."
  },
  {
    "surah_id": 56,
    "ayah_number": 62,
    "global_ayah_id": 5041,
    "translation": "Poznato vam je kako ste prvi put stvoreni, pa zašto se ne urazumite?"
  },
  {
    "surah_id": 56,
    "ayah_number": 63,
    "global_ayah_id": 5042,
    "translation": "Kažite vi Meni: šta biva s onim što posijete?"
  },
  {
    "surah_id": 56,
    "ayah_number": 64,
    "global_ayah_id": 5043,
    "translation": "Da li mu vi dajete snagu da niče, ili to Mi činimo?"
  },
  {
    "surah_id": 56,
    "ayah_number": 65,
    "global_ayah_id": 5044,
    "translation": "Ako hoćemo, možemo ga u suho rastinje pretvoriti, pa biste se snebivali:"
  },
  {
    "surah_id": 56,
    "ayah_number": 66,
    "global_ayah_id": 5045,
    "translation": "\"Mi smo, doista, oštećeni,"
  },
  {
    "surah_id": 56,
    "ayah_number": 67,
    "global_ayah_id": 5046,
    "translation": "čak smo svega lišeni!\""
  },
  {
    "surah_id": 56,
    "ayah_number": 68,
    "global_ayah_id": 5047,
    "translation": "Kažite vi Meni: vodu koju pijete -"
  },
  {
    "surah_id": 56,
    "ayah_number": 69,
    "global_ayah_id": 5048,
    "translation": "da li je vi ili Mi iz oblaka spuštamo?"
  },
  {
    "surah_id": 56,
    "ayah_number": 70,
    "global_ayah_id": 5049,
    "translation": "Ako želimo, možemo je slanom učiniti - pa zašto niste zahvalni?"
  },
  {
    "surah_id": 56,
    "ayah_number": 71,
    "global_ayah_id": 5050,
    "translation": "Kažite vi Meni: vatru koju palite -"
  },
  {
    "surah_id": 56,
    "ayah_number": 72,
    "global_ayah_id": 5051,
    "translation": "da li drvo za nju Mi stvaramo ili vi?"
  },
  {
    "surah_id": 56,
    "ayah_number": 73,
    "global_ayah_id": 5052,
    "translation": "Mi činimo da ona podsjeća i da bude korisna putnicima kada konače;"
  },
  {
    "surah_id": 56,
    "ayah_number": 74,
    "global_ayah_id": 5053,
    "translation": "zato slavi i veličaj ime Gospodara svoga Veličanstvenog!"
  },
  {
    "surah_id": 56,
    "ayah_number": 75,
    "global_ayah_id": 5054,
    "translation": "I kunem se mjestima postepenog spuštanja Kur'ana,"
  },
  {
    "surah_id": 56,
    "ayah_number": 76,
    "global_ayah_id": 5055,
    "translation": "a to je, da znate, zakletva velika!"
  },
  {
    "surah_id": 56,
    "ayah_number": 77,
    "global_ayah_id": 5056,
    "translation": "On je, zaista, Kur'an plemeniti"
  },
  {
    "surah_id": 56,
    "ayah_number": 78,
    "global_ayah_id": 5057,
    "translation": "u Knjizi brižljivo čuvanoj."
  },
  {
    "surah_id": 56,
    "ayah_number": 79,
    "global_ayah_id": 5058,
    "translation": "Dodirnuti ga smiju samo oni koji su čisti!"
  },
  {
    "surah_id": 56,
    "ayah_number": 80,
    "global_ayah_id": 5059,
    "translation": "On je objava od Gospodara svjetova,"
  },
  {
    "surah_id": 56,
    "ayah_number": 81,
    "global_ayah_id": 5060,
    "translation": "pa kako ovaj govor omalovažavate,"
  },
  {
    "surah_id": 56,
    "ayah_number": 82,
    "global_ayah_id": 5061,
    "translation": "i umjesto zahvalnosti što vam je opskrba darovana, vi u njega ne vjerujete?"
  },
  {
    "surah_id": 56,
    "ayah_number": 83,
    "global_ayah_id": 5062,
    "translation": "A zašto vi, kad duša do guše dopre,"
  },
  {
    "surah_id": 56,
    "ayah_number": 84,
    "global_ayah_id": 5063,
    "translation": "i kad vi budete tada gledali -"
  },
  {
    "surah_id": 56,
    "ayah_number": 85,
    "global_ayah_id": 5064,
    "translation": "a Mi smo mu bliži od vas, ali vi ne vidite -"
  },
  {
    "surah_id": 56,
    "ayah_number": 86,
    "global_ayah_id": 5065,
    "translation": "zašto je onda, ako račun nećete polagati,"
  },
  {
    "surah_id": 56,
    "ayah_number": 87,
    "global_ayah_id": 5066,
    "translation": "ne povratite, ako istinu govorite?"
  },
  {
    "surah_id": 56,
    "ayah_number": 88,
    "global_ayah_id": 5067,
    "translation": "I ako bude jedan od onih koji su Allahu bliski -"
  },
  {
    "surah_id": 56,
    "ayah_number": 89,
    "global_ayah_id": 5068,
    "translation": "udobnost i opskrba lijepa i džennetske blagodati pripast će njemu!"
  },
  {
    "surah_id": 56,
    "ayah_number": 90,
    "global_ayah_id": 5069,
    "translation": "A ako bude jedan od onih koji su s desne strane,"
  },
  {
    "surah_id": 56,
    "ayah_number": 91,
    "global_ayah_id": 5070,
    "translation": "pa, selam tebi od onih s desne sretne!"
  },
  {
    "surah_id": 56,
    "ayah_number": 92,
    "global_ayah_id": 5071,
    "translation": "A ako bude jedan od onih koji su poricali i u zabludi ostali,"
  },
  {
    "surah_id": 56,
    "ayah_number": 93,
    "global_ayah_id": 5072,
    "translation": "pa, ključalom vodom bit će ugošćen"
  },
  {
    "surah_id": 56,
    "ayah_number": 94,
    "global_ayah_id": 5073,
    "translation": "i u Ognju pržen."
  },
  {
    "surah_id": 56,
    "ayah_number": 95,
    "global_ayah_id": 5074,
    "translation": "Sama je istina, zbilja, sve ovo!"
  },
  {
    "surah_id": 56,
    "ayah_number": 96,
    "global_ayah_id": 5075,
    "translation": "Pa, slavi i veličaj ime Gospodara svoga Veličanstvenog!"
  }
]