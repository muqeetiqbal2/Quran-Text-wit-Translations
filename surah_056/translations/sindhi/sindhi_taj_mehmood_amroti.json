[
  {
    "surah_id": 56,
    "ayah_number": 1,
    "global_ayah_id": 4980,
    "translation": "جڏھن قيامت ايندي."
  },
  {
    "surah_id": 56,
    "ayah_number": 2,
    "global_ayah_id": 4981,
    "translation": "جنھنجي اچڻ ۾ ڪو ڪوڙ نه آھي."
  },
  {
    "surah_id": 56,
    "ayah_number": 3,
    "global_ayah_id": 4982,
    "translation": "ڪن کي جھڪي ڪرڻ واري ۽ ڪن کي مٿاھين ڪرڻ واري."
  },
  {
    "surah_id": 56,
    "ayah_number": 4,
    "global_ayah_id": 4983,
    "translation": "جڏھن زمين سخت ڌوڏبي."
  },
  {
    "surah_id": 56,
    "ayah_number": 5,
    "global_ayah_id": 4984,
    "translation": "۽ جبل پوري طرح ڀڃي پڻي ڪيا ويندا."
  },
  {
    "surah_id": 56,
    "ayah_number": 6,
    "global_ayah_id": 4985,
    "translation": "پوءِ اُڏاريل دُز وانگر ٿيندا."
  },
  {
    "surah_id": 56,
    "ayah_number": 7,
    "global_ayah_id": 4986,
    "translation": "۽ اوھين تڏھن ٽي ٽوليون ٿيندؤ."
  },
  {
    "surah_id": 56,
    "ayah_number": 8,
    "global_ayah_id": 4987,
    "translation": "پوءِ سڄي پاسي وارا، سڄي پاسي وارا ڪھڙا ته چڱا ھوندا."
  },
  {
    "surah_id": 56,
    "ayah_number": 9,
    "global_ayah_id": 4988,
    "translation": "۽ کٻي پاسي وارا، کٻي پاسي وارا ڪھڙا (ته) بدحال ھوندا؟"
  },
  {
    "surah_id": 56,
    "ayah_number": 10,
    "global_ayah_id": 4989,
    "translation": "۽ (چڱاين ۾) اڳرائي ڪرڻ وارا اڳي ٿيڻ وارا."
  },
  {
    "surah_id": 56,
    "ayah_number": 11,
    "global_ayah_id": 4990,
    "translation": "اھي (ئي) مقرب آھن."
  },
  {
    "surah_id": 56,
    "ayah_number": 12,
    "global_ayah_id": 4991,
    "translation": "نعمتن وارن باغن ۾ ھوندا."
  },
  {
    "surah_id": 56,
    "ayah_number": 13,
    "global_ayah_id": 4992,
    "translation": "گھڻا پھرين مان."
  },
  {
    "surah_id": 56,
    "ayah_number": 14,
    "global_ayah_id": 4993,
    "translation": "۽ ٿورا پوين مان."
  },
  {
    "surah_id": 56,
    "ayah_number": 15,
    "global_ayah_id": 4994,
    "translation": "(سون سان) اُڻيل تخت تي."
  },
  {
    "surah_id": 56,
    "ayah_number": 16,
    "global_ayah_id": 4995,
    "translation": "ھڪ ٻئي جي آمھون سامھون ٿي مٿن ٽيڪ ڏئي ويٺل ھوندا."
  },
  {
    "surah_id": 56,
    "ayah_number": 17,
    "global_ayah_id": 4996,
    "translation": "ھميشه رھڻ وارا نينگر وٽن پيا ايندا ويندا."
  },
  {
    "surah_id": 56,
    "ayah_number": 18,
    "global_ayah_id": 4997,
    "translation": "آبخورن ۽ ڪوزن سان ۽ وھندڙ شراب مان (ڀريل) پيالا (آڻيندن)."
  },
  {
    "surah_id": 56,
    "ayah_number": 19,
    "global_ayah_id": 4998,
    "translation": "(اھڙو صاف) جنھن کان نڪي مٿي ۾ سور پوندن ۽ نڪي بيھوش ھوندا."
  },
  {
    "surah_id": 56,
    "ayah_number": 20,
    "global_ayah_id": 4999,
    "translation": "۽ (پڻ ھر جنس جو) ميوو جتان وڻندن."
  },
  {
    "surah_id": 56,
    "ayah_number": 21,
    "global_ayah_id": 5000,
    "translation": "۽ پکين جو گوشت جنھن قسم مان (پيو) گھرين."
  },
  {
    "surah_id": 56,
    "ayah_number": 22,
    "global_ayah_id": 5001,
    "translation": "۽ وڏين اکين وارون حورون."
  },
  {
    "surah_id": 56,
    "ayah_number": 23,
    "global_ayah_id": 5002,
    "translation": "(ڄڻڪ) ڍڪيل موتين جھڙيون."
  },
  {
    "surah_id": 56,
    "ayah_number": 24,
    "global_ayah_id": 5003,
    "translation": "جيڪي ڪمايو ھوائون تنھنجي بدلي ۾."
  },
  {
    "surah_id": 56,
    "ayah_number": 25,
    "global_ayah_id": 5004,
    "translation": "اتي نڪا اجائي بَڪ نڪا گناھ جھڙي ڳالھ ٻڌندا."
  },
  {
    "surah_id": 56,
    "ayah_number": 26,
    "global_ayah_id": 5005,
    "translation": "پر ھر ڪو سلام سلام پيو چوندو."
  },
  {
    "surah_id": 56,
    "ayah_number": 27,
    "global_ayah_id": 5006,
    "translation": "۽ سڄي پاسي وارا، سڄي پاسي وارا ڪھڙي حال ھوندا."
  },
  {
    "surah_id": 56,
    "ayah_number": 28,
    "global_ayah_id": 5007,
    "translation": "لاسڙين ٻيرين ۾."
  },
  {
    "surah_id": 56,
    "ayah_number": 29,
    "global_ayah_id": 5008,
    "translation": "۽ ڀريل ڦردار ڪيوڙن ۾."
  },
  {
    "surah_id": 56,
    "ayah_number": 30,
    "global_ayah_id": 5009,
    "translation": "۽ ڊگھن پاڇن ۾."
  },
  {
    "surah_id": 56,
    "ayah_number": 31,
    "global_ayah_id": 5010,
    "translation": "۽ (ھيٺ) ڪرندڙ پاڻي ۾."
  },
  {
    "surah_id": 56,
    "ayah_number": 32,
    "global_ayah_id": 5011,
    "translation": "۽ گھڻن ميون ۾."
  },
  {
    "surah_id": 56,
    "ayah_number": 33,
    "global_ayah_id": 5012,
    "translation": "نڪي کُٽندا ۽ نڪي (کائن) جھلبا."
  },
  {
    "surah_id": 56,
    "ayah_number": 34,
    "global_ayah_id": 5013,
    "translation": "۽ اُچا وڇاڻا."
  },
  {
    "surah_id": 56,
    "ayah_number": 35,
    "global_ayah_id": 5014,
    "translation": "بيشڪ اسان حورن کي ھڪ نموني تي پيدا ڪيو آھي."
  },
  {
    "surah_id": 56,
    "ayah_number": 36,
    "global_ayah_id": 5015,
    "translation": "پوءِ کين ڪنواريون بڻايوسون."
  },
  {
    "surah_id": 56,
    "ayah_number": 37,
    "global_ayah_id": 5016,
    "translation": "مڙسن کي وڻندڙ ھڪ جيڏيون."
  },
  {
    "surah_id": 56,
    "ayah_number": 38,
    "global_ayah_id": 5017,
    "translation": "سڄي پاسي وارن لاءِ."
  },
  {
    "surah_id": 56,
    "ayah_number": 39,
    "global_ayah_id": 5018,
    "translation": "گھڻي جماعت پھرين مان آھي."
  },
  {
    "surah_id": 56,
    "ayah_number": 40,
    "global_ayah_id": 5019,
    "translation": "۽ گھڻي جماعت پوين مان آھي."
  },
  {
    "surah_id": 56,
    "ayah_number": 41,
    "global_ayah_id": 5020,
    "translation": "۽ کٻي پاسي وارا، کٻي پاسي وارا ڪھڙا بدحال ھوندا."
  },
  {
    "surah_id": 56,
    "ayah_number": 42,
    "global_ayah_id": 5021,
    "translation": "ڪوسي جھولي ۽ تَتي پاڻيءَ ۾ ھوندا."
  },
  {
    "surah_id": 56,
    "ayah_number": 43,
    "global_ayah_id": 5022,
    "translation": "۽ ڪاري دونھين جي پاڇي ۾ ھوندا."
  },
  {
    "surah_id": 56,
    "ayah_number": 44,
    "global_ayah_id": 5023,
    "translation": "جو نڪي ٿڌو ھوندو ۽ نڪي سھائيندڙ."
  },
  {
    "surah_id": 56,
    "ayah_number": 45,
    "global_ayah_id": 5024,
    "translation": "بيشڪ اُھي ھن کان اڳ (دُنيا ۾) سُک ۾ پيل ھوا."
  },
  {
    "surah_id": 56,
    "ayah_number": 46,
    "global_ayah_id": 5025,
    "translation": "۽ وڏي گناھ (شرڪ) تي ضد ڪندا ھوا."
  },
  {
    "surah_id": 56,
    "ayah_number": 47,
    "global_ayah_id": 5026,
    "translation": "۽ چوندا ھوا ته، جڏھن مرنداسون ۽ مٽي ۽ ھڏا ٿينداسون (تڏھن) اسين وري (قبرن مان) اُٿاريا وينداسون ڇا؟"
  },
  {
    "surah_id": 56,
    "ayah_number": 48,
    "global_ayah_id": 5027,
    "translation": "يا اسان جا پھريان پيءُ ڏاڏا."
  },
  {
    "surah_id": 56,
    "ayah_number": 49,
    "global_ayah_id": 5028,
    "translation": "(اي پيغمبر) چؤ ته بيشڪ اڳيان ۽ پويان."
  },
  {
    "surah_id": 56,
    "ayah_number": 50,
    "global_ayah_id": 5029,
    "translation": "ھڪ مقرّر ڪيل ڏينھن جي وقت تي ضرور گڏ ڪيا ويندا."
  },
  {
    "surah_id": 56,
    "ayah_number": 51,
    "global_ayah_id": 5030,
    "translation": "وري بيشڪ اوھين اي گمراھو ڪوڙ ڀائيندڙؤ."
  },
  {
    "surah_id": 56,
    "ayah_number": 52,
    "global_ayah_id": 5031,
    "translation": "ضرور اوھين ٿوھر جي وڻ مان کائيندؤ."
  },
  {
    "surah_id": 56,
    "ayah_number": 53,
    "global_ayah_id": 5032,
    "translation": "پوءِ منجھانئس پيٽن کي ڀريندؤ."
  },
  {
    "surah_id": 56,
    "ayah_number": 54,
    "global_ayah_id": 5033,
    "translation": "پوءِ مٿانئس تَتل پاڻيءَ مان پيئندؤ."
  },
  {
    "surah_id": 56,
    "ayah_number": 55,
    "global_ayah_id": 5034,
    "translation": "پوءِ اُڃايل اُٺن جي پيئڻ وانگر پيئندؤ."
  },
  {
    "surah_id": 56,
    "ayah_number": 56,
    "global_ayah_id": 5035,
    "translation": "قيامت جي ڏينھن اِھا سندن مھماني آھي."
  },
  {
    "surah_id": 56,
    "ayah_number": 57,
    "global_ayah_id": 5036,
    "translation": "اسان اوھان کي پيدا ڪيو پوءِ (وري جيارڻ کي) ڇونه سچ ڀائيندا آھيو."
  },
  {
    "surah_id": 56,
    "ayah_number": 58,
    "global_ayah_id": 5037,
    "translation": "ڀلا ڏسو ته سھي ته جيڪا مني وجھندا آھيو."
  },
  {
    "surah_id": 56,
    "ayah_number": 59,
    "global_ayah_id": 5038,
    "translation": "تنھن مان اوھين خلقيو ٿا ڇا؟ يا اسين خلقڻ وارا آھيون؟"
  },
  {
    "surah_id": 56,
    "ayah_number": 60,
    "global_ayah_id": 5039,
    "translation": "اسان اوھان ۾ موت مقرّر ڪيو آھي ۽ اسين عاجز نه آھيون."
  },
  {
    "surah_id": 56,
    "ayah_number": 61,
    "global_ayah_id": 5040,
    "translation": "ته اوھان جھڙن کي مٽائي پيدا ڪريون ۽ اوھان کي اھڙي (شڪل) ۾ پيدا ڪريون جنھن کي ڄاڻندا ئي ئي نه ھجو."
  },
  {
    "surah_id": 56,
    "ayah_number": 62,
    "global_ayah_id": 5041,
    "translation": "۽ بيشڪ پھرين پيدائش ڄاڻي چڪؤ پوءِ ڇونه ٿا نصيحت وٺو؟"
  },
  {
    "surah_id": 56,
    "ayah_number": 63,
    "global_ayah_id": 5042,
    "translation": "ڏسو ته سھي جيڪي اوھين پوکيندا آھيو."
  },
  {
    "surah_id": 56,
    "ayah_number": 64,
    "global_ayah_id": 5043,
    "translation": "سو اوھين ڄمائيندا آھيو ڇا يا اسين ڄمائيندا آھيون؟"
  },
  {
    "surah_id": 56,
    "ayah_number": 65,
    "global_ayah_id": 5044,
    "translation": "جيڪڏھن گھُرون ته اُن کي ناس ڪري ڇڏيون پوءِ اوھين حيرت ۾ رھجي وڃو."
  },
  {
    "surah_id": 56,
    "ayah_number": 66,
    "global_ayah_id": 5045,
    "translation": "(۽ پيا چئو) ته بيشڪ اسين ٽوٽي ۾ پئجي وياسون."
  },
  {
    "surah_id": 56,
    "ayah_number": 67,
    "global_ayah_id": 5046,
    "translation": "بلڪ اسين بي نصيب آھيون."
  },
  {
    "surah_id": 56,
    "ayah_number": 68,
    "global_ayah_id": 5047,
    "translation": "ڀلا ڏسو ته سھي جيڪو پاڻي پيئندا آھيو."
  },
  {
    "surah_id": 56,
    "ayah_number": 69,
    "global_ayah_id": 5048,
    "translation": "اُھو اوھين ڪڪرن مان ھيٺ لاھيندا آھيو ڇا يا اسين ھيٺ لاھيندا آھيون؟"
  },
  {
    "surah_id": 56,
    "ayah_number": 70,
    "global_ayah_id": 5049,
    "translation": "جيڪڏھن گھُرون ته اُن کي کارو ڪري ڇڏيون پوءِ ڇونه شڪرانو ڪندا آھيو؟"
  },
  {
    "surah_id": 56,
    "ayah_number": 71,
    "global_ayah_id": 5050,
    "translation": "ڀلا ڏسو ته سھي ته جا باھ ٻاريندا آھيو."
  },
  {
    "surah_id": 56,
    "ayah_number": 72,
    "global_ayah_id": 5051,
    "translation": "تنھن جي وڻ کي اوھان پيدا ڪيو آھيو آھي ڇا؟ يا اسين پيدا ڪندڙ آھيون."
  },
  {
    "surah_id": 56,
    "ayah_number": 73,
    "global_ayah_id": 5052,
    "translation": "اسان اُن (وڻ) کي نصيحت وٺڻ لاءِ ۽ مسافرن جي فائدي لاءِ پيدا ڪيو آھي."
  },
  {
    "surah_id": 56,
    "ayah_number": 74,
    "global_ayah_id": 5053,
    "translation": "تنھنڪري پنھنجي وڏي پالڻھار جي نالي کي پاڪائي سان ياد ڪر."
  },
  {
    "surah_id": 56,
    "ayah_number": 75,
    "global_ayah_id": 5054,
    "translation": "پوءِ تارن جي ڪِرڻ جي جاءِ جو قسم کڻان ٿو."
  },
  {
    "surah_id": 56,
    "ayah_number": 76,
    "global_ayah_id": 5055,
    "translation": "۽ جيڪڏھن ڄاڻو ته بيشڪ اُھو قسم وڏو آھي."
  },
  {
    "surah_id": 56,
    "ayah_number": 77,
    "global_ayah_id": 5056,
    "translation": "بيشڪ اھو سڳورو قرآن آھي."
  },
  {
    "surah_id": 56,
    "ayah_number": 78,
    "global_ayah_id": 5057,
    "translation": "لڪل ڪتاب ۾ لکيل آھي."
  },
  {
    "surah_id": 56,
    "ayah_number": 79,
    "global_ayah_id": 5058,
    "translation": "پاڪائيءَ وارن کانسواءِ ٻيو ڪو اُن کي ھٿ نه لائيندو آھي."
  },
  {
    "surah_id": 56,
    "ayah_number": 80,
    "global_ayah_id": 5059,
    "translation": "جھانن جي پالڻھار وٽان نازل ڪيل آھي."
  },
  {
    "surah_id": 56,
    "ayah_number": 81,
    "global_ayah_id": 5060,
    "translation": "پوءِ اوھين ھن ڳالھ (جي مڃڻ) ۾ سُستي ڪرڻ وارا آھيو ڇا."
  },
  {
    "surah_id": 56,
    "ayah_number": 82,
    "global_ayah_id": 5061,
    "translation": "۽ اُن کي ڪوڙ ڀانئين پنھنجو حصّو ڪريو ٿا."
  },
  {
    "surah_id": 56,
    "ayah_number": 83,
    "global_ayah_id": 5062,
    "translation": "پوءِ جنھن مھل (ڪنھنجو) ساھ نر گھٽ وٽ پھچي."
  },
  {
    "surah_id": 56,
    "ayah_number": 84,
    "global_ayah_id": 5063,
    "translation": "۽ اوھين انھيءَ مھل پيا ٿا ڏسو."
  },
  {
    "surah_id": 56,
    "ayah_number": 85,
    "global_ayah_id": 5064,
    "translation": "۽ اسين اوھان جي به نسبت اُن ڏانھن تمام ويجھا آھيون پر اوھين نه ڏسندا آھيو."
  },
  {
    "surah_id": 56,
    "ayah_number": 86,
    "global_ayah_id": 5065,
    "translation": "پوءِ جيڪڏھن (اوھين خدا جي حُڪم ۾) لاچار ٿيل نه آھيو."
  },
  {
    "surah_id": 56,
    "ayah_number": 87,
    "global_ayah_id": 5066,
    "translation": "ته جيڪڏھن سچا آھيو ته روح کي ڇو نه موٽايو."
  },
  {
    "surah_id": 56,
    "ayah_number": 88,
    "global_ayah_id": 5067,
    "translation": "پوءِ جيڪڏھن (مئل الله جي) ويجھن ٻانھن مان ھوندو."
  },
  {
    "surah_id": 56,
    "ayah_number": 89,
    "global_ayah_id": 5068,
    "translation": "ته اُن لاءِ خوشي ۽ سُرھاڻ ۽ نعمت وارو باغ آھي."
  },
  {
    "surah_id": 56,
    "ayah_number": 90,
    "global_ayah_id": 5069,
    "translation": "۽ جيڪڏھن سڄي پاسي وارن مان ھوندو."
  },
  {
    "surah_id": 56,
    "ayah_number": 91,
    "global_ayah_id": 5070,
