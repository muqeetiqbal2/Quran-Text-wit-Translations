[
  {
    "surah_id": 56,
    "ayah_number": 0,
    "global_ayah_id": 5034,
    "translation": "اللہ کے «<a href=614> نام </a>» سے جو بےانتہا «<a href=600> مہربان </a>» اور رحم فرمانے والا ہے"
  },
  {
    "surah_id": 56,
    "ayah_number": 1,
    "global_ayah_id": 5035,
    "translation": "جب وہ ہونے والا واقعہ «<a href=181> پیش </a>» آجائے گا"
  },
  {
    "surah_id": 56,
    "ayah_number": 2,
    "global_ayah_id": 5036,
    "translation": "تو کوئی اس کے وقوع کو جھٹلانے والا نہ ہوگا"
  },
  {
    "surah_id": 56,
    "ayah_number": 3,
    "global_ayah_id": 5037,
    "translation": "وہ «<a href=209> تہ </a>» وبالا کردینے والی آفت ہوگی"
  },
  {
    "surah_id": 56,
    "ayah_number": 4,
    "global_ayah_id": 5038,
    "translation": "زمین اس «<a href=639> وقت </a>» یکبارگی ہلا ڈالی جائے گی"
  },
  {
    "surah_id": 56,
    "ayah_number": 5,
    "global_ayah_id": 5039,
    "translation": "اور «<a href=160> پہاڑ </a>» اس طرح «<a href=268> ریزہ </a>» ریزہ کردیے جائیں گے،"
  },
  {
    "surah_id": 56,
    "ayah_number": 6,
    "global_ayah_id": 5040,
    "translation": "کہ پراگندہ «<a href=448> غبار </a>» بن کر رہ جائیں گے"
  },
  {
    "surah_id": 56,
    "ayah_number": 7,
    "global_ayah_id": 5041,
    "translation": "تم لوگ اس «<a href=639> وقت </a>» تین گروہوں میں تقسیم ہوجاؤ گے"
  },
  {
    "surah_id": 56,
    "ayah_number": 8,
    "global_ayah_id": 5042,
    "translation": "دائیں «<a href=77> بازو </a>» والے ، سودائیں «<a href=77> بازو </a>» والوں (کی «<a href=308> خوش </a>» نصیبی ) کا کیا کہنا"
  },
  {
    "surah_id": 56,
    "ayah_number": 9,
    "global_ayah_id": 5043,
    "translation": "اور بائیں «<a href=77> بازو </a>» والے ، تو بائیں «<a href=77> بازو </a>» والوں (کی بدنصیبی) کا کیا ٹھکانا"
  },
  {
    "surah_id": 56,
    "ayah_number": 10,
    "global_ayah_id": 5044,
    "translation": "اور آگے والے تو پھر آگے والے ہی ہیں"
  },
  {
    "surah_id": 56,
    "ayah_number": 11,
    "global_ayah_id": 5045,
    "translation": "وہی تو مقرب لوگ ہیں"
  },
  {
    "surah_id": 56,
    "ayah_number": 12,
    "global_ayah_id": 5046,
    "translation": "نعمت بھری جنتوں میں رہیں گے"
  },
  {
    "surah_id": 56,
    "ayah_number": 13,
    "global_ayah_id": 5047,
    "translation": "اگلوں میں سے بہت ہوں گے"
  },
  {
    "surah_id": 56,
    "ayah_number": 14,
    "global_ayah_id": 5048,
    "translation": "اور پچھلوں میں سے کم"
  },
  {
    "surah_id": 56,
    "ayah_number": 15,
    "global_ayah_id": 5049,
    "translation": "مرصع تختوں پر"
  },
  {
    "surah_id": 56,
    "ayah_number": 16,
    "global_ayah_id": 5050,
    "translation": "تکیے لگائے آمنے «<a href=386> سامنے </a>» بیٹھیں گے"
