    "surah_id": 56,
    "ayah_number": 75,
    "global_ayah_id": 5109,
    "translation": "پس میں «<a href=472> قسم </a>» نہیں کھاتا تاروں کے مواقع کی"
  },
  {
    "surah_id": 56,
    "ayah_number": 76,
    "global_ayah_id": 5110,
    "translation": "اور اگر تم سمجھو تو یہ بہت بڑی «<a href=472> قسم </a>» ہے"
  },
  {
    "surah_id": 56,
    "ayah_number": 77,
    "global_ayah_id": 5111,
