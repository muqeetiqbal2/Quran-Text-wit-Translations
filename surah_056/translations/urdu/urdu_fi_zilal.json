    "surah_id": 56,
    "ayah_number": 17,
    "global_ayah_id": 5051,
    "translation": "ان کی مجلسوں میں ابدی لڑکےدوڑتے پھرتے ہوں گے"
  },
  {
    "surah_id": 56,
    "ayah_number": 18,
    "global_ayah_id": 5052,
    "translation": "شراب «<a href=260> چشمہ </a>» جاری سے لبریز پیالے ، اور کنٹر اور ساغر لیے"
  },
  {
    "surah_id": 56,
    "ayah_number": 19,
    "global_ayah_id": 5053,
    "translation": "نہ ان کو اس سے جدا کیا جائے گا اور نہ وہ «<a href=294> ختم </a>» ہوگا"
  },
  {
    "surah_id": 56,
    "ayah_number": 20,
    "global_ayah_id": 5054,
    "translation": "اور وہ ان کے «<a href=386> سامنے </a>» طرح طرح کے لذیذ «<a href=170> پھل </a>» «<a href=181> پیش </a>» کریں گے کہ جسے چاہیں «<a href=266> چن </a>» لیں"
  },
  {
    "surah_id": 56,
    "ayah_number": 21,
    "global_ayah_id": 5055,
    "translation": "اور پرندوں کے گوشت «<a href=181> پیش </a>» کریں گے کہ جس پرندے کا چاہیں استعمال کریں"
  },
  {
    "surah_id": 56,
    "ayah_number": 22,
    "global_ayah_id": 5056,
    "translation": "اور ان کے لیے «<a href=306> خوبصورت </a>» آنکھوں والی حوریں ہوں گی"
  },
  {
    "surah_id": 56,
    "ayah_number": 23,
    "global_ayah_id": 5057,
    "translation": "ایسی حسین جیسے چھپا کر رکھے ہوئے موتی"
  },
  {
    "surah_id": 56,
    "ayah_number": 24,
    "global_ayah_id": 5058,
    "translation": "یہ سب کچھ ان «<a href=42> اعمال </a>» کی جزا کے طور پر انہیں ملے گا جو وہ «<a href=327> دنیا </a>» میں کرتے رہے تھے"
  },
  {
    "surah_id": 56,
    "ayah_number": 25,
    "global_ayah_id": 5059,
    "translation": "وہاں وہ کوئی بےہودہ کلام یا «<a href=531> گناہ </a>» کی «<a href=71> بات </a>» نہ سنیں گے"
  },
  {
    "surah_id": 56,
    "ayah_number": 26,
    "global_ayah_id": 5060,
    "translation": "جو «<a href=71> بات </a>» بھی ہوگی ٹھیک ٹھیک ہوگی"
  },
  {
    "surah_id": 56,
    "ayah_number": 27,
    "global_ayah_id": 5061,
    "translation": "اور دائیں «<a href=77> بازو </a>» والے ، دائیں «<a href=77> بازو </a>» والوں (کی «<a href=308> خوش </a>» نصیبی) کا کیا کہنا"
  },
  {
    "surah_id": 56,
    "ayah_number": 28,
    "global_ayah_id": 5062,
    "translation": "وہ بے خار بیریوں،"
  },
  {
    "surah_id": 56,
    "ayah_number": 29,
    "global_ayah_id": 5063,
    "translation": "اور «<a href=209> تہ </a>» بہ «<a href=209> تہ </a>» چڑھے ہوئے کیلوں،"
  },
  {
    "surah_id": 56,
    "ayah_number": 30,
    "global_ayah_id": 5064,
    "translation": "اور «<a href=328> دور </a>» تک پھیلی ہوئی چھاؤں،"
  },
  {
    "surah_id": 56,
    "ayah_number": 31,
    "global_ayah_id": 5065,
    "translation": "اور ہر دم رواں پانی،"
  },
  {
    "surah_id": 56,
    "ayah_number": 32,
    "global_ayah_id": 5066,
    "translation": "اور بکثرت پھل،"
  },
  {
    "surah_id": 56,
    "ayah_number": 33,
    "global_ayah_id": 5067,
    "translation": "کبھی «<a href=294> ختم </a>» نہ ہونے والےاور بےروک ٹوک ملنے والے"
  },
  {
    "surah_id": 56,
    "ayah_number": 34,
    "global_ayah_id": 5068,
    "translation": "اور اونچی نشست گاہوں میں ہوں گے"
  },
  {
    "surah_id": 56,
    "ayah_number": 35,
    "global_ayah_id": 5069,
    "translation": "ان کی بیویوں کو ہم خاص طور پر نئے سرے سے «<a href=180> پیدا </a>» کریں گے"
  },
  {
    "surah_id": 56,
    "ayah_number": 36,
    "global_ayah_id": 5070,
    "translation": "اور انہیں باکرہ بنادیں گے"
  },
  {
    "surah_id": 56,
    "ayah_number": 37,
    "global_ayah_id": 5071,
    "translation": "اپنے شوہروں کی عاشق اور عمر میں ہم سن"
  },
  {
    "surah_id": 56,
    "ayah_number": 38,
    "global_ayah_id": 5072,
    "translation": "یہ کچھ دائیں «<a href=77> بازو </a>» والوں کے لیے ہے"
  },
  {
    "surah_id": 56,
    "ayah_number": 39,
    "global_ayah_id": 5073,
    "translation": "وہ اگلوں میں سے بھی بہت ہوں گے"
  },
  {
    "surah_id": 56,
    "ayah_number": 40,
    "global_ayah_id": 5074,
    "translation": "وہ پچھلوں میں سے بھی بہت"
  },
  {
    "surah_id": 56,
    "ayah_number": 41,
    "global_ayah_id": 5075,
    "translation": "اور بائیں «<a href=77> بازو </a>» والے ، بائیں «<a href=77> بازو </a>» والوں (کی بدنصیبی) کا کیا پوچھنا"
  },
  {
    "surah_id": 56,
    "ayah_number": 42,
    "global_ayah_id": 5076,
    "translation": "وہ لو کی لپٹ اور کھولتے ہوئے پانی،"
  },
  {
    "surah_id": 56,
    "ayah_number": 43,
    "global_ayah_id": 5077,
    "translation": "اور کالے دھوئیں کے سائے میں ہوں گے"
  },
  {
    "surah_id": 56,
    "ayah_number": 44,
    "global_ayah_id": 5078,
    "translation": "جو نہ «<a href=219> ٹھنڈا </a>» ہوگا نہ «<a href=4> آرام </a>» دہ"
  },
  {
    "surah_id": 56,
    "ayah_number": 45,
    "global_ayah_id": 5079,
    "translation": "یہ وہ لوگ ہوں گے جو اس «<a href=55> انجام </a>» کو پہنچنے سے «<a href=162> پہلے </a>» خوشحال تھے"
  },
  {
    "surah_id": 56,
    "ayah_number": 46,
    "global_ayah_id": 5080,
    "translation": "اور «<a href=531> گناہ </a>» عظیم پر اصرار کرتے تھے"
  },
  {
    "surah_id": 56,
    "ayah_number": 47,
    "global_ayah_id": 5081,
    "translation": "کہتے تھے کیا جب ہم مرکر خاک ہوجائیں گے اور ہڈیوں کا پنجر رہ جائیں گے تو پھر اٹھا کھڑے کیے جائیں گے ؟"
  },
  {
    "surah_id": 56,
    "ayah_number": 48,
    "global_ayah_id": 5082,
    "translation": "اور کیا ہمارے «<a href=69> باپ </a>» دادا بھی اٹھائے جائیں گے جو «<a href=162> پہلے </a>» گزر چکے ہیں ؟"
  },
  {
    "surah_id": 56,
    "ayah_number": 49,
    "global_ayah_id": 5083,
    "translation": "اے نبی ان لوگوں سے کہو ، یقیناً اگلے اور پچھلے،"
  },
  {
    "surah_id": 56,
    "ayah_number": 50,
    "global_ayah_id": 5084,
    "translation": "سب ایک «<a href=326> دن </a>» ضرور جمع کیے جانے والے ہیں جس کا «<a href=639> وقت </a>» «<a href=593> مقرر </a>» کیا جاچکا ہے"
  },
  {
    "surah_id": 56,
    "ayah_number": 51,
    "global_ayah_id": 5085,
    "translation": "پھر اے گمراہو اور جھٹلانے والو"
  },
  {
    "surah_id": 56,
    "ayah_number": 52,
    "global_ayah_id": 5086,
    "translation": "تم زقوم کے «<a href=319> درخت </a>» کی غذا کھانے والے ہو"
  },
  {
    "surah_id": 56,
    "ayah_number": 53,
    "global_ayah_id": 5087,
    "translation": "اسی سے تم پیٹ بھرو گے"
  },
  {
    "surah_id": 56,
    "ayah_number": 54,
    "global_ayah_id": 5088,
    "translation": "اور اوپر سے کھولتا «<a href=654> ہوا </a>» پانی،"
  },
  {
    "surah_id": 56,
    "ayah_number": 55,
    "global_ayah_id": 5089,
    "translation": "تو نس لگے ہوئے اونٹ کی طرح پیو گے"
  },
  {
    "surah_id": 56,
    "ayah_number": 56,
    "global_ayah_id": 5090,
    "translation": "یہ ہے (ان بائیں «<a href=77> بازو </a>» والوں) کی ضیافت کا «<a href=385> سامان </a>» روز جزا میں"
  },
  {
    "surah_id": 56,
    "ayah_number": 57,
    "global_ayah_id": 5091,
    "translation": "ہم نے تمہیں «<a href=180> پیدا </a>» کیا ہے پھر کیوں تصدیق نہیں کرتے ؟"
  },
  {
    "surah_id": 56,
    "ayah_number": 58,
    "global_ayah_id": 5092,
    "translation": "کبھی تم نے «<a href=451> غور </a>» کیا ، یہ نطفہ جو تم ڈالتے ہو"
  },
  {
    "surah_id": 56,
    "ayah_number": 59,
    "global_ayah_id": 5093,
    "translation": "اس سے بچہ تم بناتے ہو یا اس کے بنانے والے ہم ہیں ؟"
  },
  {
    "surah_id": 56,
    "ayah_number": 60,
    "global_ayah_id": 5094,
    "translation": "ہم نے تمہارے «<a href=321> درمیان </a>» موت کو تقسیم کیا ہے اور ہم اس سے «<a href=436> عاجز </a>» نہیں ہیں"
  },
  {
    "surah_id": 56,
    "ayah_number": 61,
    "global_ayah_id": 5095,
    "translation": "کہ تم جیسے اور لوگ لے آئیں اور کسی ایسے جہان میں تمہیں «<a href=180> پیدا </a>» کردیں جس کو تم نہیں جانتے"
  },
  {
    "surah_id": 56,
    "ayah_number": 62,
    "global_ayah_id": 5096,
    "translation": "اپنی پہلی پیدائش کو تو تم جانتے ہی ہو ، پھر کیوں سبق نہیں لیتے ؟"
  },
  {
    "surah_id": 56,
    "ayah_number": 63,
    "global_ayah_id": 5097,
    "translation": "کبھی تم نے سوچا ، یہ بیج جو تم بوتے ہو"
  },
  {
    "surah_id": 56,
    "ayah_number": 64,
    "global_ayah_id": 5098,
    "translation": "ان سے کھیتیاں تم اگاتے ہو یا ان کے اگانے والے ہم ہیں ؟"
  },
  {
    "surah_id": 56,
    "ayah_number": 65,
    "global_ayah_id": 5099,
    "translation": "ہم چاہیں تو ان کھیتوں کو بھس بنا کر رکھ دیں اور تم طرح طرح کی باتیں بناتے رہ جاؤ"
  },
  {
    "surah_id": 56,
    "ayah_number": 66,
    "global_ayah_id": 5100,
    "translation": "کہ ہم پر تو الٹی چٹی پڑ گئی"
  },
  {
    "surah_id": 56,
    "ayah_number": 67,
    "global_ayah_id": 5101,
    "translation": "بلکہ ہمارے تو نصیب ہی پھوٹے ہوئے ہیں"
  },
  {
    "surah_id": 56,
    "ayah_number": 68,
    "global_ayah_id": 5102,
    "translation": "کبھی تم نے آنکھیں کھول کر دیکھا ، یہ «<a href=144> پانی </a>» جو تم پیتے ہو"
  },
  {
    "surah_id": 56,
    "ayah_number": 69,
    "global_ayah_id": 5103,
    "translation": "اسے تم نے «<a href=73> بادل </a>» سے برسایا ہے یا اس کے برسانے والے ہم ہیں ؟"
  },
  {
    "surah_id": 56,
    "ayah_number": 70,
    "global_ayah_id": 5104,
    "translation": "ہم چاہیں تو اسے «<a href=391> سخت </a>» کھاری بنا کر رکھ دیں ، پھر کیوں تم شکرگزار نہیں ہوتے ؟"
  },
  {
    "surah_id": 56,
    "ayah_number": 71,
    "global_ayah_id": 5105,
    "translation": "کبھی تم نے خیال کیا یہ «<a href=12> آگ </a>» جو تم سلگاتے ہو"
  },
  {
    "surah_id": 56,
    "ayah_number": 72,
    "global_ayah_id": 5106,
    "translation": "اس کا «<a href=319> درخت </a>» تم نے «<a href=180> پیدا </a>» کیا ہے یا اس کے «<a href=180> پیدا </a>» کرنے والے ہم ہیں ؟"
  },
  {
    "surah_id": 56,
    "ayah_number": 73,
    "global_ayah_id": 5107,
    "translation": "ہم نے اس کو یاددہانی کا «<a href=352> ذریعہ </a>» اور «<a href=278> حاجت </a>» مندوں کے لیے «<a href=385> سامان </a>» زیست بنایا ہے"
  },
  {
    "surah_id": 56,
    "ayah_number": 74,
    "global_ayah_id": 5108,
    "translation": "پس اے نبی! اپنے رب عظیم کے «<a href=614> نام </a>» کی تسبیح کرو"
