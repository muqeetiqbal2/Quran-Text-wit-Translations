[
  {
    "surah_id": 56,
    "ayah_number": 0,
    "global_ayah_id": 5034,
    "translation": "اللہ کے نام سے جو رحمان و رحیم ہے"
  },
  {
    "surah_id": 56,
    "ayah_number": 1,
    "global_ayah_id": 5035,
    "translation": "جب ہو پڑے ہو پڑنے والی"
  },
  {
    "surah_id": 56,
    "ayah_number": 2,
    "global_ayah_id": 5036,
    "translation": "نہیں ہے اُسکے ہو پڑے میں کچھ جھوٹ"
  },
  {
    "surah_id": 56,
    "ayah_number": 3,
    "global_ayah_id": 5037,
    "translation": "پست کرنے والی ہے بلند کرنے والی"
  },
  {
    "surah_id": 56,
    "ayah_number": 4,
    "global_ayah_id": 5038,
    "translation": "جب لرزے زمین کپکپا کر"
  },
  {
    "surah_id": 56,
    "ayah_number": 5,
    "global_ayah_id": 5039,
    "translation": "اور ریزہ ریزہ ہوں پہاڑ ٹوٹ پھوٹ کر"
  },
  {
    "surah_id": 56,
    "ayah_number": 6,
    "global_ayah_id": 5040,
    "translation": "پھر ہو جائیں غبار اڑتا ہوا"
  },
  {
    "surah_id": 56,
    "ayah_number": 7,
    "global_ayah_id": 5041,
    "translation": "اور ہو جاؤ تین قسم پر"
  },
  {
    "surah_id": 56,
    "ayah_number": 8,
    "global_ayah_id": 5042,
    "translation": "پھر داہنے والے کیا خوب ہیں داہنے والے"
  },
  {
    "surah_id": 56,
    "ayah_number": 9,
    "global_ayah_id": 5043,
    "translation": "اور بائیں والے کیا برے لوگ ہیں بائیں والے"
  },
  {
    "surah_id": 56,
    "ayah_number": 10,
    "global_ayah_id": 5044,
    "translation": "اور اگاڑی والے تو اگاڑی والے"
  },
  {
    "surah_id": 56,
    "ayah_number": 11,
    "global_ayah_id": 5045,
    "translation": "وہ لوگ ہیں مقرب"
  },
  {
    "surah_id": 56,
    "ayah_number": 12,
    "global_ayah_id": 5046,
    "translation": "باغوں میں نعمت کے"
  },
  {
    "surah_id": 56,
    "ayah_number": 13,
    "global_ayah_id": 5047,
    "translation": "انبوہ ہے پہلوں میں سے"
  },
  {
    "surah_id": 56,
    "ayah_number": 14,
    "global_ayah_id": 5048,
    "translation": "اور تھوڑے ہیں پچھلوں میں سے"
  },
  {
    "surah_id": 56,
    "ayah_number": 15,
    "global_ayah_id": 5049,
    "translation": "بیٹھے ہیں جڑاؤ تختوں پر"
  },
  {
    "surah_id": 56,
    "ayah_number": 16,
    "global_ayah_id": 5050,
    "translation": "تکیہ لگائےاُن پر ایک دوسرے کے سامنے"
  },
  {
    "surah_id": 56,
    "ayah_number": 17,
    "global_ayah_id": 5051,
    "translation": "لئے پھرتے ہیں اُنکے پاس لڑکے سدا رہنے والے"
  },
  {
    "surah_id": 56,
    "ayah_number": 18,
    "global_ayah_id": 5052,
    "translation": "آبخورے اور کوزے اور پیالہ نتھری شراب کا"
  },
  {
    "surah_id": 56,
    "ayah_number": 19,
    "global_ayah_id": 5053,
    "translation": "جس سے نہ سر دکھے اور نہ بکواس لگے"
  },
  {
    "surah_id": 56,
    "ayah_number": 20,
    "global_ayah_id": 5054,
    "translation": "اور میوہ جونسا پسند کر لیں"
  },
  {
    "surah_id": 56,
    "ayah_number": 21,
    "global_ayah_id": 5055,
    "translation": "اور گوشت اڑتے جانوروں کا جس قسم کو جی چاہے"
  },
  {
    "surah_id": 56,
    "ayah_number": 22,
    "global_ayah_id": 5056,
    "translation": "اور عورتیں گوری بڑی آنکھوں والیاں"
  },
  {
    "surah_id": 56,
    "ayah_number": 23,
    "global_ayah_id": 5057,
    "translation": "جیسے موتی کے دانے اپنے غلاف کے اندر"
  },
  {
    "surah_id": 56,
    "ayah_number": 24,
    "global_ayah_id": 5058,
    "translation": "بدلہ اُن کاموں کا جو کرتے تھے"
  },
  {
    "surah_id": 56,
    "ayah_number": 25,
    "global_ayah_id": 5059,
    "translation": "نہیں سنیں گے وہاں بکواس اور گناہ کی بات"
  },
  {
    "surah_id": 56,
    "ayah_number": 26,
    "global_ayah_id": 5060,
    "translation": "مگر ایک بولنا سلام سلام"
  },
  {
    "surah_id": 56,
    "ayah_number": 27,
    "global_ayah_id": 5061,
    "translation": "اور داہنے والے کیا کہنے داہنے والوں کے"
  },
  {
    "surah_id": 56,
    "ayah_number": 28,
    "global_ayah_id": 5062,
    "translation": "رہتے ہیں بیری کے درختوں میں جن میں کانٹا نہیں"
  },
  {
    "surah_id": 56,
    "ayah_number": 29,
    "global_ayah_id": 5063,
    "translation": "اور کیلے تہہ پر تہہ"
  },
  {
    "surah_id": 56,
    "ayah_number": 30,
    "global_ayah_id": 5064,
    "translation": "اور سایہ لنبا"
  },
  {
    "surah_id": 56,
    "ayah_number": 31,
    "global_ayah_id": 5065,
    "translation": "اور پانی بہتا ہوا"
  },
  {
    "surah_id": 56,
    "ayah_number": 32,
    "global_ayah_id": 5066,
    "translation": "اور میوہ بہت"
  },
  {
    "surah_id": 56,
    "ayah_number": 33,
    "global_ayah_id": 5067,
    "translation": "نہ اُس میں سے ٹوٹا اور نہ روکا ہوا"
  },
  {
    "surah_id": 56,
    "ayah_number": 34,
    "global_ayah_id": 5068,
    "translation": "اور بچھونے اونچے"
  },
  {
    "surah_id": 56,
    "ayah_number": 35,
    "global_ayah_id": 5069,
    "translation": "ہم نے اٹھایا اُن عورتوں کو ایک اچھے اٹھان پر"
  },
  {
    "surah_id": 56,
    "ayah_number": 36,
    "global_ayah_id": 5070,
    "translation": "پھر کیا اُنکو کنواریاں"
  },
  {
    "surah_id": 56,
    "ayah_number": 37,
    "global_ayah_id": 5071,
    "translation": "پیار دلانے والیاں ہم عمر"
  },
  {
    "surah_id": 56,
    "ayah_number": 38,
    "global_ayah_id": 5072,
    "translation": "واسطے داہنے والوں کے"
  },
  {
    "surah_id": 56,
    "ayah_number": 39,
    "global_ayah_id": 5073,
    "translation": "انبوہ ہے پہلوں میں سے"
  },
  {
    "surah_id": 56,
    "ayah_number": 40,
    "global_ayah_id": 5074,
    "translation": "اور انبوہ ہے پچھلوں میں سے"
  },
  {
    "surah_id": 56,
    "ayah_number": 41,
    "global_ayah_id": 5075,
    "translation": "اور بائیں والے کیسے بائیں والے"
  },
  {
    "surah_id": 56,
    "ayah_number": 42,
    "global_ayah_id": 5076,
    "translation": "تیز بھاپ میں اور جلتے پانی میں"
  },
  {
    "surah_id": 56,
    "ayah_number": 43,
    "global_ayah_id": 5077,
    "translation": "اور سایہ میں دھوئیں کے"
  },
  {
    "surah_id": 56,
    "ayah_number": 44,
    "global_ayah_id": 5078,
    "translation": "نہ ٹھنڈا اور نہ عزت کا"
  },
  {
    "surah_id": 56,
    "ayah_number": 45,
    "global_ayah_id": 5079,
    "translation": "وہ لوگ تھے اس سے پہلے خوشحال"
  },
  {
    "surah_id": 56,
    "ayah_number": 46,
    "global_ayah_id": 5080,
    "translation": "اور ضد کرتے تھے اُس بڑے گناہ پر"
  },
  {
    "surah_id": 56,
    "ayah_number": 47,
    "global_ayah_id": 5081,
    "translation": "اور کہا کرتے تھے کیا جب ہم مر گئے اور ہو چکے مٹی اور ہڈیاں کیا ہم پھر اٹھائے جائیں گے"
  },
  {
    "surah_id": 56,
    "ayah_number": 48,
    "global_ayah_id": 5082,
    "translation": "اور کیا ہمارے اگلے باپ دادے بھی"
  },
  {
    "surah_id": 56,
    "ayah_number": 49,
    "global_ayah_id": 5083,
    "translation": "تو کہہ دے کہ اگلے اور پچھلے"
  },
  {
    "surah_id": 56,
    "ayah_number": 50,
    "global_ayah_id": 5084,
    "translation": "سب اکٹھے ہونے والے ہیں ایک دن مقرر کے وقت پر"
  },
  {
    "surah_id": 56,
    "ayah_number": 51,
    "global_ayah_id": 5085,
    "translation": "پھر تو جو ہو اے بہکے ہوؤ جھٹلانے والو"
  },
  {
    "surah_id": 56,
    "ayah_number": 52,
    "global_ayah_id": 5086,
    "translation": "البتہ کھاؤ گے ایک درخت سینڈکے سے"
  },
  {
    "surah_id": 56,
    "ayah_number": 53,
    "global_ayah_id": 5087,
    "translation": "پھر بھرو گے اس سے پیٹ"
  },
  {
    "surah_id": 56,
    "ayah_number": 54,
    "global_ayah_id": 5088,
    "translation": "پھر پیو گے اُس پر ایک جلتا پانی"
  },
  {
    "surah_id": 56,
    "ayah_number": 55,
    "global_ayah_id": 5089,
    "translation": "پھر پیو گے جیسے پئیں اونٹ تونسے ہوئے"
  },
  {
    "surah_id": 56,
    "ayah_number": 56,
    "global_ayah_id": 5090,
    "translation": "یہ مہمانی ہے اُنکی انصاف کے دن"
  },
  {
    "surah_id": 56,
    "ayah_number": 57,
    "global_ayah_id": 5091,
    "translation": "ہم نے تم کو بنایا پھر کیوں نہیں سچ مانتے"
  },
  {
    "surah_id": 56,
    "ayah_number": 58,
    "global_ayah_id": 5092,
    "translation": "بھلا دیکھو تو جو پانی تم ٹپکاتے ہو"
  },
  {
    "surah_id": 56,
    "ayah_number": 59,
    "global_ayah_id": 5093,
    "translation": "اب تم اُسکو بناتے ہو یا ہم ہیں بنانے والے"
  },
  {
    "surah_id": 56,
    "ayah_number": 60,
    "global_ayah_id": 5094,
    "translation": "ہم ٹھہرا چکے تم میں مرنا اور ہم عاجز نہیں"
  },
  {
    "surah_id": 56,
    "ayah_number": 61,
    "global_ayah_id": 5095,
    "translation": "اس بات سے کہ بدلے میں لے آئیں تمہاری طرح کے لوگ اور اٹھا کھڑا کریں تم کو وہاں جہاں تم نہیں جانتے"
  },
  {
    "surah_id": 56,
    "ayah_number": 62,
    "global_ayah_id": 5096,
    "translation": "اور تم جان چکے ہو پہلا اٹھان پھر کیوں نہیں یاد کرتے"
  },
  {
    "surah_id": 56,
    "ayah_number": 63,
    "global_ayah_id": 5097,
    "translation": "بھلا دیکھو تو جو تم بوتے ہو"
  },
  {
    "surah_id": 56,
    "ayah_number": 64,
    "global_ayah_id": 5098,
    "translation": "کیا تم اُسکو کر تے ہو کھیتی یا ہم ہیں کھیتی کر دینے والے"
  },
  {
    "surah_id": 56,
    "ayah_number": 65,
    "global_ayah_id": 5099,
    "translation": "اگر ہم چاہیں تو کر ڈالیں اُسکو روندا ہوا گھانس پھر تم سارے دن رہو باتیں بناتے"
  },
  {
    "surah_id": 56,
    "ayah_number": 66,
    "global_ayah_id": 5100,
    "translation": "ہم تو قرضدار رہ گئے"
  },
  {
    "surah_id": 56,
    "ayah_number": 67,
    "global_ayah_id": 5101,
    "translation": "بلکہ ہم بے نصیب ہو گئے"
  },
  {
    "surah_id": 56,
    "ayah_number": 68,
    "global_ayah_id": 5102,
    "translation": "بھلا دیکھو تو پانی کو جو تم پیتے ہو"
  },
  {
    "surah_id": 56,
    "ayah_number": 69,
    "global_ayah_id": 5103,
    "translation": "کیا تم نے اتارا اُسکو بادل سے ہا ہم ہیں اتارنے والے"
  },
  {
    "surah_id": 56,
    "ayah_number": 70,
    "global_ayah_id": 5104,
    "translation": "اگر ہم چاہیں کر دیں اُسکو کھارا پھر کیوں نہیں احسان مانتے"
  },
  {
    "surah_id": 56,
    "ayah_number": 71,
    "global_ayah_id": 5105,
    "translation": "بھلا دیکھو تو آگ جس کو تم سلگاتے ہو"
  },
  {
    "surah_id": 56,
    "ayah_number": 72,
    "global_ayah_id": 5106,
    "translation": "کیا تم نے پیدا کیا اُس کا درخت یا ہم ہیں پیدا کرنے والے"
  },
  {
    "surah_id": 56,
    "ayah_number": 73,
    "global_ayah_id": 5107,
    "translation": "ہم نے ہی تو بنایا وہ درخت یاد دلانے کو اور برتنے کو جنگل والوں کے"
  },
  {
    "surah_id": 56,
    "ayah_number": 74,
    "global_ayah_id": 5108,
    "translation": "سو بول پاکی اپنے رب کے نام کی جو سب سے بڑا"
  },
  {
    "surah_id": 56,
    "ayah_number": 75,
    "global_ayah_id": 5109,
    "translation": "سو میں قسم کھاتا ہوں تاروں کے ڈوبنے کی"
  },
  {
    "surah_id": 56,
    "ayah_number": 76,
    "global_ayah_id": 5110,
    "translation": "اور یہ قسم ہے اگر سمجھو تو بڑی قسم"
  },
  {
    "surah_id": 56,
    "ayah_number": 77,
    "global_ayah_id": 5111,
    "translation": "بیشک یہ قرآن ہے عزت والا"
  },
  {
    "surah_id": 56,
    "ayah_number": 78,
    "global_ayah_id": 5112,
    "translation": "لکھا ہوا ہے ایک پوشیدہ کتاب میں"
  },
  {
    "surah_id": 56,
    "ayah_number": 79,
    "global_ayah_id": 5113,
    "translation": "اُس کو وہی چھوتے ہیں جو پاک بنائے گئے ہیں"
  },
  {
    "surah_id": 56,
    "ayah_number": 80,
    "global_ayah_id": 5114,
    "translation": "اتارا ہوا ہے اپنے پروردگار عالم کی طرف سے"
  },
  {
    "surah_id": 56,
    "ayah_number": 81,
    "global_ayah_id": 5115,
    "translation": "اب کیا اس بات میں تم سستی کرتے ہو"
  },
  {
    "surah_id": 56,
    "ayah_number": 82,
    "global_ayah_id": 5116,
    "translation": "اور اپنا حصہ تم یہی لیتے ہو کہ اُسکو جھٹلاتے ہو"
  },
  {
    "surah_id": 56,
    "ayah_number": 83,
    "global_ayah_id": 5117,
    "translation": "پھر کیوں نہیں جس وقت جان پہنچے حلق کو"
  },
  {
    "surah_id": 56,
    "ayah_number": 84,
    "global_ayah_id": 5118,
    "translation": "اور تم اُس وقت دیکھ رہے ہو"
  },
  {
    "surah_id": 56,
    "ayah_number": 85,
    "global_ayah_id": 5119,
    "translation": "اور ہم اُسکے پاس ہیں تم سے زیادہ پر تم نہیں دیکھتے"
  },
  {
    "surah_id": 56,
    "ayah_number": 86,
    "global_ayah_id": 5120,
    "translation": "پھر کیوں نہیں اگر تم نہیں ہو کسی کے حکم میں"
  },
  {
    "surah_id": 56,
    "ayah_number": 87,
    "global_ayah_id": 5121,
    "translation": "تو کیوں نہیں پھیر لیتے اُس روح کو اگر ہو تم سچے"
  },
  {
    "surah_id": 56,
    "ayah_number": 88,
    "global_ayah_id": 5122,
    "translation": "سو جو اگر وہ مردہ ہوا مقرب لوگوں میں"
  },
  {
    "surah_id": 56,
    "ayah_number": 89,
    "global_ayah_id": 5123,
    "translation": "تو راحت ہے اور روزی ہے اور باغ نعمت کا"
  },
  {
    "surah_id": 56,
    "ayah_number": 90,
    "global_ayah_id": 5124,
    "translation": "اور جو اگر وہ ہوا داہنے والوں میں"
  },
  {
    "surah_id": 56,
    "ayah_number": 91,
    "global_ayah_id": 5125,
    "translation": "تو سلامتی پہنچے تجھ کو داہنے والوں سے"
  },
  {
    "surah_id": 56,
    "ayah_number": 92,
    "global_ayah_id": 5126,
    "translation": "اور جو اگر وہ ہوا جھٹلانے والوں بہکنے والوں میں سے"
  },
  {
    "surah_id": 56,
    "ayah_number": 93,
    "global_ayah_id": 5127,
    "translation": "تو مہمانی ہے جلتا پانی"
  },
  {
    "surah_id": 56,
    "ayah_number": 94,
    "global_ayah_id": 5128,
