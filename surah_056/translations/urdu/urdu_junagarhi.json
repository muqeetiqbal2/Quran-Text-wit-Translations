  {
    "surah_id": 56,
    "ayah_number": 80,
    "global_ayah_id": 5114,
    "translation": " یہ رب العالمین کی طرف سے اترا «<a href=654> ہوا </a>» ہے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 81,
    "global_ayah_id": 5115,
    "translation": " پس کیا تم ایسی «<a href=71> بات </a>» کو سرسری ( اور معمولی ) سمجھ رہے\nہو؟ "
  },
  {
    "surah_id": 56,
    "ayah_number": 82,
    "global_ayah_id": 5116,
    "translation": " اور اپنے حصے میں یہی لیتے ہو کہ جھٹلاتے پھرو ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 83,
    "global_ayah_id": 5117,
    "translation": " پس جبکہ روح نرخرے تک پہنچ جائے ۔ "
