  {
    "surah_id": 56,
    "ayah_number": 84,
    "global_ayah_id": 5118,
    "translation": " اور تم اس «<a href=639> وقت </a>» آنکھوں سے دیکھتے رہو ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 85,
    "global_ayah_id": 5119,
    "translation": " ہم اس شخص سے بہ نسبت تمہارے بہت «<a href=636> زیادہ </a>» قریب ہوتے\nہیں لیکن تم نہیں دیکھ سکتے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 86,
    "global_ayah_id": 5120,
    "translation": " پس اگر تم کسی کے زیر فرمان نہیں ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 87,
    "global_ayah_id": 5121,
    "translation": " اور اس قول میں سچے ہو تو ( ذرا ) اس روح کو تو لوٹاؤ ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 88,
    "global_ayah_id": 5122,
    "translation": " پس جو کوئی بارگاہ الٰہی سے قریب کیا «<a href=654> ہوا </a>» ہوگا ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 89,
    "global_ayah_id": 5123,
    "translation": " اسے تو راحت ہے اور غذائیں ہیں اور «<a href=4> آرام </a>» والی «<a\n  href=237> جنت </a>» ہے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 90,
    "global_ayah_id": 5124,
    "translation": " اور جو شخص داہنے ( «<a href=640> ہاتھ </a>» ) والوں میں سے ہے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 91,
    "global_ayah_id": 5125,
    "translation": " تو بھی سلامتی ہے تیرے لئے کہ تو داہنے والوں میں سے ہے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 92,
    "global_ayah_id": 5126,
    "translation": " لیکن اگر کوئی جھٹلانے والوں گمراہوں میں سے ہے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 93,
    "global_ayah_id": 5127,
    "translation": " تو کھولتے ہوئے گرم «<a href=144> پانی </a>» کی مہمانی ہے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 94,
    "global_ayah_id": 5128,
    "translation": " اور «<a href=331> دوزخ </a>» میں جانا ہے ۔ "
