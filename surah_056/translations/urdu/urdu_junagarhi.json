[
  {
    "surah_id": 56,
    "ayah_number": 0,
    "global_ayah_id": 5034,
    "translation": " «<a href=416> شروع </a>» کرتا ہوں اللہ تعا لٰی کے «<a href=614> نام\n</a>» سے جو بڑا «<a href=600> مہربان </a>» نہایت رحم والا ہے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 1,
    "global_ayah_id": 5035,
    "translation": " جب «<a href=476> قیامت </a>» قائم ہو جائے گی ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 2,
    "global_ayah_id": 5036,
    "translation": " جس کے واقع ہونے میں کوئی «<a href=249> جھوٹ </a>» نہیں ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 3,
    "global_ayah_id": 5037,
    "translation": " وہ پست کرنے والی اور «<a href=106> بلند </a>» کرنے والی ہوگی ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 4,
    "global_ayah_id": 5038,
    "translation": " جبکہ «<a href=379> زمین </a>» زلزلہ کے ساتھ ہلا دی جائے گی ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 5,
    "global_ayah_id": 5039,
    "translation": " اور «<a href=160> پہاڑ </a>» بالکل «<a href=268> ریزہ </a>» ریزہ کر\nدیئے جائیں گے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 6,
    "global_ayah_id": 5040,
    "translation": " پھر وہ مثل پراگندہ «<a href=448> غبار </a>» کے ہوجائیں گے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 7,
    "global_ayah_id": 5041,
    "translation": " اور تم تین جماعتوں میں ہو جاؤ گے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 8,
    "global_ayah_id": 5042,
    "translation": " پس داہنے «<a href=640> ہاتھ </a>» والے کیسے اچھے ہیں داہنے «<a\n  href=640> ہاتھ </a>» والے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 9,
    "global_ayah_id": 5043,
    "translation": " اور بائیں «<a href=640> ہاتھ </a>» والے کا کیا حال ہے بائیں «<a\n  href=640> ہاتھ </a>» والوں کا ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 10,
    "global_ayah_id": 5044,
    "translation": " اور جو آگے والے ہیں وہ تو آگے والے ہی ہیں ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 11,
    "global_ayah_id": 5045,
    "translation": " وہ بالکل نزدیکی حاصل کئے ہوئے ہیں ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 12,
    "global_ayah_id": 5046,
    "translation": " نعمتوں والی جنتوں میں ہیں ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 13,
    "global_ayah_id": 5047,
    "translation": " ۔ ( بہت بڑا ) گروہ تو اگلے لوگوں میں سے ہوگا ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 14,
    "global_ayah_id": 5048,
    "translation": " اور تھوڑے سے پچھلے لوگوں میں سے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 15,
    "global_ayah_id": 5049,
    "translation": " یہ لوگ سونے کے تاروں سے بنے ہوئے تختوں پر ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 16,
    "global_ayah_id": 5050,
    "translation": " ایک دوسرے کے «<a href=386> سامنے </a>» تکیہ لگائے بیٹھے ہونگے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 17,
    "global_ayah_id": 5051,
    "translation": " ان کے «<a href=141> پاس </a>» ایسے لڑکے جو «<a href=652> ہمیشہ </a>» (\nلڑکے ہی ) رہیں گے آمد و رفت کریں گے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 18,
    "global_ayah_id": 5052,
    "translation": " آبخورے اور جگ لے کر اور ایسا جام لے کر جو بہتی ہوئی «<a href=414> شراب\n</a>» سے پر ہو ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 19,
    "global_ayah_id": 5053,
    "translation": " جس سے نہ «<a href=393> سر </a>» میں درد ہو نہ «<a href=442> عقل </a>»\nمیں فتور آئے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 20,
    "global_ayah_id": 5054,
    "translation": " اور ایسے میوے لئے ہوئے جو ان کی «<a href=153> پسند </a>» کے ہوں ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 21,
    "global_ayah_id": 5055,
    "translation": " اور پرندوں کے گوشت جو انہیں مرغوب ہوں ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 22,
    "global_ayah_id": 5056,
    "translation": " اور بڑی بڑی آنکھوں والی حوریں ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 23,
    "global_ayah_id": 5057,
    "translation": " جو چھپے ہوئے موتیوں کی طرح ہیں ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 24,
    "global_ayah_id": 5058,
    "translation": " یہ صلہ ہے ان کے «<a href=42> اعمال </a>» کا ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 25,
    "global_ayah_id": 5059,
    "translation": " نہ وہاں بکواس سنیں گے اور نہ «<a href=531> گناہ </a>» کی «<a href=71>\n  بات </a>» ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 26,
    "global_ayah_id": 5060,
    "translation": " صرف سلام ہی سلام کی «<a href=19> آواز </a>» ہوگی ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 27,
    "global_ayah_id": 5061,
    "translation": " اور داہنے «<a href=640> ہاتھ </a>» والے کیا ہی اچھے ہیں داہنے «<a\n  href=640> ہاتھ </a>» والے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 28,
    "global_ayah_id": 5062,
    "translation": " وہ بغیر کانٹوں کی بیریوں ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 29,
    "global_ayah_id": 5063,
    "translation": " اور «<a href=209> تہ </a>» بہ «<a href=209> تہ </a>» کیلوں ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 30,
    "global_ayah_id": 5064,
    "translation": " اور لمبے لمبے سایوں ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 31,
    "global_ayah_id": 5065,
    "translation": " اور بہتے ہوئے پانیوں ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 32,
    "global_ayah_id": 5066,
    "translation": " اور بکثرت پھلوں میں ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 33,
    "global_ayah_id": 5067,
    "translation": " جو نہ «<a href=294> ختم </a>» ہوں نہ روک لئے جائیں ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 34,
    "global_ayah_id": 5068,
    "translation": " اور اونچے اونچے فرشوں میں ہونگے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 35,
    "global_ayah_id": 5069,
    "translation": " ہم نے ان ( کی بیویوں کو ) خاص طور پر بنایا ہے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 36,
    "global_ayah_id": 5070,
    "translation": " اور ہم نے انہیں کنواریاں بنا دیا ہے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 37,
    "global_ayah_id": 5071,
    "translation": " «<a href=571> محبت </a>» والیاں اور ہم عمر ہیں ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 38,
    "global_ayah_id": 5072,
    "translation": " دائیں «<a href=640> ہاتھ </a>» والوں کے لئے ہیں ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 39,
    "global_ayah_id": 5073,
    "translation": " جم غفیر ہے اگلوں میں سے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 40,
    "global_ayah_id": 5074,
    "translation": " اور بہت بڑی «<a href=235> جماعت </a>» ہے پچھلوں میں سے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 41,
    "global_ayah_id": 5075,
    "translation": " اور بائیں «<a href=640> ہاتھ </a>» والے کیا ہیں بائیں «<a href=640>\n  ہاتھ </a>» والے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 42,
    "global_ayah_id": 5076,
    "translation": " گرم «<a href=654> ہوا </a>» اور گرم «<a href=144> پانی </a>» میں ( ہوں\nگے ) ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 43,
    "global_ayah_id": 5077,
    "translation": " اور سیاہ دھوئیں کے سائے میں ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 44,
    "global_ayah_id": 5078,
    "translation": " جو نہ «<a href=219> ٹھنڈا </a>» ہے نہ فرحت بخش ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 45,
    "global_ayah_id": 5079,
    "translation": " بیشک یہ لوگ اس سے «<a href=162> پہلے </a>» بہت نازوں میں پلے ہوئے تھے\n۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 46,
    "global_ayah_id": 5080,
    "translation": " اور بڑے بڑے گناہوں پر اصرار کرتے تھے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 47,
    "global_ayah_id": 5081,
    "translation": " اور کہتے تھے کہ کیا جب ہم مر جائیں گے اور «<a href=568> مٹی </a>» اور\nہڈی ہو جائیں گے تو کیا ہم پھردوبارہ اٹھا کھڑے کئے جائیں گے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 48,
    "global_ayah_id": 5082,
    "translation": " اور کیا ہمارے اگلے «<a href=69> باپ </a>» دادا بھی؟ "
  },
  {
    "surah_id": 56,
    "ayah_number": 49,
    "global_ayah_id": 5083,
    "translation": " آپ کہہ دیجئے کہ یقیناً سب اگلے اور پچھلے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 50,
    "global_ayah_id": 5084,
    "translation": " ضرور جمع کئے جائیں گے ایک «<a href=593> مقرر </a>» «<a href=326> دن\n</a>» کے «<a href=639> وقت </a>» ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 51,
    "global_ayah_id": 5085,
    "translation": " پھر تم اے گمراہو جھٹلانے والو ! "
  },
  {
    "surah_id": 56,
    "ayah_number": 52,
    "global_ayah_id": 5086,
    "translation": " البتہ کھانے والے ہو تھوہر کا «<a href=319> درخت </a>» ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 53,
    "global_ayah_id": 5087,
    "translation": " اور اسی سے پیٹ بھرنے والے ہو ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 54,
    "global_ayah_id": 5088,
    "translation": " پھر اس پر گرم کھولتا «<a href=144> پانی </a>» پینے والے ہو ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 55,
    "global_ayah_id": 5089,
    "translation": " پھر پینے والے بھی پیاسے اونٹوں کی طرح ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 56,
    "global_ayah_id": 5090,
    "translation": " «<a href=476> قیامت </a>» کے «<a href=326> دن </a>» ان کی مہمانی یہ ہے\n۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 57,
    "global_ayah_id": 5091,
    "translation": " ہم ہی نے تم سب کو «<a href=180> پیدا </a>» کیا ہے پھر تم کیوں باور\nنہیں کرتے؟ "
  },
  {
    "surah_id": 56,
    "ayah_number": 58,
    "global_ayah_id": 5092,
    "translation": " «<a href=31> اچھا </a>» پھر یہ تو بتلاؤ کہ جو منی تم ٹپکاتے ہو ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 59,
    "global_ayah_id": 5093,
    "translation": " کیا اس کا ( «<a href=3> انسان </a>» ) تم بناتے ہو یا «<a href=180>\n  پیدا </a>» کرنے والے ہم ہی ہیں؟ "
  },
  {
    "surah_id": 56,
    "ayah_number": 60,
    "global_ayah_id": 5094,
    "translation": " ہم ہی نے تم میں موت کو معین کر دیا ہے اور ہم اس سے ہارے ہوئے نہیں ہیں\n۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 61,
    "global_ayah_id": 5095,
    "translation": " کہ تمہاری «<a href=232> جگہ </a>» تم جیسے اور «<a href=180> پیدا </a>»\nکر دیں اور تمہیں نئے سرے سے اس «<a href=438> عالم </a>» میں «<a href=180> پیدا </a>» کریں جس سے تم ( بالکل ) بے «<a\n  href=293> خبر </a>» ہو ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 62,
    "global_ayah_id": 5096,
    "translation": " تمہیں یقینی طور پر پہلی دفعہ کی پیدائش معلوم ہی ہے پھر کیوں عبرت حاصل\nنہیں کرتے؟ "
  },
  {
    "surah_id": 56,
    "ayah_number": 63,
    "global_ayah_id": 5097,
    "translation": " «<a href=31> اچھا </a>» پھر یہ بھی بتلاؤ کہ تم جو کچھ بوتے ہو ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 64,
    "global_ayah_id": 5098,
    "translation": " اسے تم ہی اگاتے ہو یا ہم اگانے والے ہیں ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 65,
    "global_ayah_id": 5099,
    "translation": " اگر ہم چاہیں تو اسے «<a href=268> ریزہ </a>» ریزہ کر ڈالیں اور تم حیرت\nکے ساتھ باتیں بناتے ہی رہ جاؤ ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 66,
    "global_ayah_id": 5100,
    "translation": " کہ ہم پر تو تاوان ہی پڑ گیا ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 67,
    "global_ayah_id": 5101,
    "translation": " بلکہ ہم بالکل محروم ہی رہ گئے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 68,
    "global_ayah_id": 5102,
    "translation": " «<a href=31> اچھا </a>» یہ بتاؤ کہ جس «<a href=144> پانی </a>» کو تم\nپیتے ہو ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 69,
    "global_ayah_id": 5103,
    "translation": " اسے بادلوں سے بھی تم ہی اتارتے ہو یا ہم برساتے ہیں؟ "
  },
  {
    "surah_id": 56,
    "ayah_number": 70,
    "global_ayah_id": 5104,
    "translation": " اگر ہماری منشا ہو تو ہم اسے «<a href=489> کڑوا </a>» زہر کر دیں پھرتم\nہماری شکر گزاری کیوں نہیں کرتے؟ "
  },
  {
    "surah_id": 56,
    "ayah_number": 71,
    "global_ayah_id": 5105,
    "translation": " «<a href=31> اچھا </a>» ذرا یہ بھی بتاؤ کہ جو «<a href=12> آگ </a>» تم\nسلگاتے ہو ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 72,
    "global_ayah_id": 5106,
    "translation": " اس کے «<a href=319> درخت </a>» کو تم نے «<a href=180> پیدا </a>» کیا\nہے یا ہم اس کے «<a href=180> پیدا </a>» کرنے والے ہیں؟ "
  },
  {
    "surah_id": 56,
    "ayah_number": 73,
    "global_ayah_id": 5107,
    "translation": " ہم نے اسے سبب «<a href=622> نصیحت </a>» اور مسافروں کے فائدے کی چیز\nبنایا ہے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 74,
    "global_ayah_id": 5108,
    "translation": " پس اپنے بہت بڑے رب کے «<a href=614> نام </a>» کی تسبیح کیا کرو ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 75,
    "global_ayah_id": 5109,
    "translation": " پس میں «<a href=472> قسم </a>» کھاتا ہوں ستاروں کے گرنے کی ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 76,
    "global_ayah_id": 5110,
    "translation": " اور اگر تمہیں علم ہو تو یہ بہت بڑی «<a href=472> قسم </a>» ہے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 77,
    "global_ayah_id": 5111,
    "translation": " کہ بیشک یہ «<a href=470> قرآن </a>» بہت بڑی «<a href=441> عزت </a>»\nوالا ہے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 78,
    "global_ayah_id": 5112,
    "translation": " جو ایک محفوظ «<a href=485> کتاب </a>» میں درج ہے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 79,
    "global_ayah_id": 5113,
    "translation": " جسے صرف «<a href=142> پاک </a>» لوگ ہی چھو سکتے ہیں ۔ "
