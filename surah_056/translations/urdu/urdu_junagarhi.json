    "ayah_number": 95,
    "global_ayah_id": 5129,
    "translation": " یہ «<a href=293> خبر </a>» سراسر حق اور قطعاً یقینی ہے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 96,
