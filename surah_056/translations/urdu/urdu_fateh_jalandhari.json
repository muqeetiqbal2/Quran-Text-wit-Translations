[
  {
    "surah_id": 56,
    "ayah_number": 0,
    "global_ayah_id": 5034,
    "translation": " «<a href=416> شروع </a>» خدائے رحمٰن ورحیم کے «<a href=614> نام </a>» سے "
  },
  {
    "surah_id": 56,
    "ayah_number": 1,
    "global_ayah_id": 5035,
    "translation": " ۔ ( «<a href=657> یاد </a>» رکھو ) جبکہ واقع ہو پڑے گی واقع ہونے والی ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 2,
    "global_ayah_id": 5036,
    "translation": " اس کے واقع ہونے میں کسی «<a href=249> جھوٹ </a>» کا شائبہ نہیں ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 3,
    "global_ayah_id": 5037,
    "translation": " وہ پست کرنے والی اور «<a href=106> بلند </a>» کرنے والی ہوگی ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 4,
    "global_ayah_id": 5038,
    "translation": " جبکہ «<a href=379> زمین </a>» بالکل جھنجھوڑ دی جائے گی ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 5,
    "global_ayah_id": 5039,
    "translation": " اور «<a href=160> پہاڑ </a>» بالکل «<a href=268> ریزہ </a>» ریزہ ہوکر ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 6,
    "global_ayah_id": 5040,
    "translation": " منتشر «<a href=448> غبار </a>» بن جائیں گے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 7,
    "global_ayah_id": 5041,
    "translation": " اور تم تین گروہوں میں تقسیم ہوجاؤ گے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 8,
    "global_ayah_id": 5042,
    "translation": " سو ایک گروہ داہنے والوں کا ہوگا ، تو کیا کہنے ہیں داہنے والوں کے! "
  },
  {
    "surah_id": 56,
    "ayah_number": 9,
    "global_ayah_id": 5043,
    "translation": " اور دوسرا گروہ بائیں والوں کا ہوگا تو کیا حال ہوگا بائیں والوں کا! "
  },
  {
    "surah_id": 56,
    "ayah_number": 10,
    "global_ayah_id": 5044,
    "translation": " رہے سابقون ، تو وہ تو سبقت کرنے والے ہی ہیں! "
  },
  {
    "surah_id": 56,
    "ayah_number": 11,
    "global_ayah_id": 5045,
    "translation": " وہی لوگ مقرب ہوں گے "
  },
  {
    "surah_id": 56,
    "ayah_number": 12,
    "global_ayah_id": 5046,
    "translation": " «<a href=623> نعمت </a>» کے باغوں میں "
  },
  {
    "surah_id": 56,
    "ayah_number": 13,
    "global_ayah_id": 5047,
    "translation": " ان میں بڑی تعداد اگلوں کی ہوگی "
  },
  {
    "surah_id": 56,
    "ayah_number": 14,
    "global_ayah_id": 5048,
    "translation": " اور تھوڑے پچھلوں میں سے ہوں گے "
  },
  {
    "surah_id": 56,
    "ayah_number": 15,
    "global_ayah_id": 5049,
    "translation": " جڑاؤ تختوں پر "
  },
  {
    "surah_id": 56,
    "ayah_number": 16,
    "global_ayah_id": 5050,
    "translation": " «<a href=223> ٹیک </a>» لگائے ، آمنے «<a href=386> سامنے </a>» بیٹھے ہوں گے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 17,
    "global_ayah_id": 5051,
    "translation": " ان کی خدمت میں غلمان، جو «<a href=652> ہمیشہ </a>» غلمان ہیں رہیں گے۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 18,
    "global_ayah_id": 5052,
    "translation": " پیالے جگ اور «<a href=414> شراب </a>» خالص کے جام لیے ہوئے گردش کر رہے ہوں گے "
  },
  {
    "surah_id": 56,
    "ayah_number": 19,
    "global_ayah_id": 5053,
    "translation": " جس سے نہ تو ان کو دردِ «<a href=393> سر </a>» لاحق ہوگا اور نہ وہ فتورِ «<a\n  href=442> عقل </a>» میں مبتلا ہوں گے "
  },
  {
    "surah_id": 56,
    "ayah_number": 20,
    "global_ayah_id": 5054,
    "translation": " اور میوے ان کی «<a href=153> پسند </a>» کے "
  },
  {
    "surah_id": 56,
    "ayah_number": 21,
    "global_ayah_id": 5055,
    "translation": " اور پرندوں کے گوشت ان کی «<a href=366> رغبت </a>» کے "
  },
  {
    "surah_id": 56,
    "ayah_number": 22,
    "global_ayah_id": 5056,
    "translation": " اور ( ان کیلئے ) غزال چشم حوریں ہوں گی "
  },
  {
    "surah_id": 56,
    "ayah_number": 23,
    "global_ayah_id": 5057,
    "translation": " محفوظ کیے ہوئے موتیوں کی مانند "
  },
  {
    "surah_id": 56,
    "ayah_number": 24,
    "global_ayah_id": 5058,
    "translation": " صلہ ان کے ان «<a href=42> اعمال </a>» کا جو وہ کرتے رہے "
  },
  {
    "surah_id": 56,
    "ayah_number": 25,
    "global_ayah_id": 5059,
    "translation": " ان میں وہ کوئی لغو اور «<a href=531> گناہ </a>» کی «<a href=71> بات </a>» نہیں سنیں\nگے "
  },
  {
    "surah_id": 56,
    "ayah_number": 26,
    "global_ayah_id": 5060,
    "translation": " صرف مبارک سلامت کے چرچے ہوں گے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 27,
    "global_ayah_id": 5061,
    "translation": " اور رہے داہنے والے ، تو کیا کہنے ہیں داہنے والوں کے! "
  },
  {
    "surah_id": 56,
    "ayah_number": 28,
    "global_ayah_id": 5062,
    "translation": " بےخار بیریوں "
  },
  {
    "surah_id": 56,
    "ayah_number": 29,
    "global_ayah_id": 5063,
    "translation": " تہہ بہ تہہ کیلوں "
  },
  {
    "surah_id": 56,
    "ayah_number": 30,
    "global_ayah_id": 5064,
    "translation": " اور پھیلے ہوئے سایوں میں "
  },
  {
    "surah_id": 56,
    "ayah_number": 31,
    "global_ayah_id": 5065,
    "translation": " اور «<a href=144> پانی </a>» بہایا «<a href=654> ہوا </a>» "
  },
  {
    "surah_id": 56,
    "ayah_number": 32,
    "global_ayah_id": 5066,
    "translation": " اور میوے فراواں "
  },
  {
    "surah_id": 56,
    "ayah_number": 33,
    "global_ayah_id": 5067,
    "translation": " نہ کبھی منقطع ہونے والے نہ کبھی ممنوع "
  },
  {
    "surah_id": 56,
    "ayah_number": 34,
    "global_ayah_id": 5068,
    "translation": " اور اونچے بستر ہوں گے "
  },
  {
    "surah_id": 56,
    "ayah_number": 35,
    "global_ayah_id": 5069,
    "translation": " ۔ ( اور ان کی بیویاں ہوں گی ) «<a href=236> جن </a>» کو ہم نے ایک خاص اٹھان پر\nاٹھایا ہوگا ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 36,
    "global_ayah_id": 5070,
    "translation": " پس ہم ان کو رکھیں گے کنواریاں "
  },
  {
    "surah_id": 56,
    "ayah_number": 37,
    "global_ayah_id": 5071,
    "translation": " دلربا اور ہم سنیں ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 38,
    "global_ayah_id": 5072,
    "translation": " ۔ ( نعمتیں ) داہنے والوں کیلئے ہوں گی ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 39,
    "global_ayah_id": 5073,
    "translation": " ۔ ( ان میں ) اگلوں میں سے بھی ایک بڑا گروہ ہوگا "
  },
  {
    "surah_id": 56,
    "ayah_number": 40,
    "global_ayah_id": 5074,
    "translation": " اور پچھلوں میں سے بھی ایک بڑا گروہ ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 41,
    "global_ayah_id": 5075,
    "translation": " اور بائیں والے تو کیا ہی برا حال ہوگا بائیں والوں کا! "
  },
  {
    "surah_id": 56,
    "ayah_number": 42,
    "global_ayah_id": 5076,
    "translation": " وہ لو کی لپٹ، کھولتے پانی "
  },
  {
    "surah_id": 56,
    "ayah_number": 43,
    "global_ayah_id": 5077,
    "translation": " اور دھوئیں کے سایہ میں ہوں گے "
  },
  {
    "surah_id": 56,
    "ayah_number": 44,
    "global_ayah_id": 5078,
    "translation": " جس میں نہ کوئی ٹھنڈک ہوگی اور نہ کسی طرح کی کوئی افادیت ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 45,
    "global_ayah_id": 5079,
    "translation": " یہ لوگ اس سے «<a href=162> پہلے </a>» خوشحالوں میں تھے "
  },
  {
    "surah_id": 56,
    "ayah_number": 46,
    "global_ayah_id": 5080,
    "translation": " اور سب سے بڑے «<a href=531> گناہ </a>» پر اصرار کرتے رہے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 47,
    "global_ayah_id": 5081,
    "translation": " اور کہتے تھے کہ کیا جب ہم مرجائیں گے اور «<a href=568> مٹی </a>» اور ہڈیاں بن جائیں\nگے تو کیا از «<a href=393> سر </a>» نو «<a href=381> زندہ </a>» کرکے اٹھائے جائیں گے؟ "
  },
  {
    "surah_id": 56,
    "ayah_number": 48,
    "global_ayah_id": 5082,
    "translation": " اور کیا ہمارے اگلے آباء واجداد بھی؟ "
  },
  {
    "surah_id": 56,
    "ayah_number": 49,
    "global_ayah_id": 5083,
    "translation": " کہہ دو: یقینًا اگلے اور پچھلے "
  },
  {
    "surah_id": 56,
    "ayah_number": 50,
    "global_ayah_id": 5084,
    "translation": " سب جمع کیے جائیں گے ، ایک معین «<a href=326> دن </a>» کی مقررہ «<a href=576> مدت\n</a>» تک "
  },
  {
    "surah_id": 56,
    "ayah_number": 51,
    "global_ayah_id": 5085,
    "translation": " پھر تم لوگ ، اے گمراہو اور جھٹلانے والو! "
  },
  {
    "surah_id": 56,
    "ayah_number": 52,
    "global_ayah_id": 5086,
    "translation": " زقوم کے «<a href=319> درخت </a>» میں سے کھاؤ گے "
  },
  {
    "surah_id": 56,
    "ayah_number": 53,
    "global_ayah_id": 5087,
    "translation": " اور اسی سے اپنے پیٹ بھرو گے "
  },
  {
    "surah_id": 56,
    "ayah_number": 54,
    "global_ayah_id": 5088,
    "translation": " پھر اس پر کھولتا «<a href=144> پانی </a>» پیو گے "
  },
  {
    "surah_id": 56,
    "ayah_number": 55,
    "global_ayah_id": 5089,
    "translation": " تون سے ہوئے اونٹوں کی طرح پیو گے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 56,
    "global_ayah_id": 5090,
    "translation": " یہ جزا کے «<a href=326> دن </a>» ان کی پہلی ضیافت ہوگی! "
  },
  {
    "surah_id": 56,
    "ayah_number": 57,
    "global_ayah_id": 5091,
    "translation": " ہم نے تم کو «<a href=180> پیدا </a>» کیا ہے ، تو تم ( «<a href=476> قیامت </a>» کی\n) تصدیق کیوں نہیں کرتے؟ "
  },
  {
    "surah_id": 56,
    "ayah_number": 58,
    "global_ayah_id": 5092,
    "translation": " کیا تم نے «<a href=451> غور </a>» کیا ہے اس چیز پر جو تم ٹپکا دیتے ہو؟ "
  },
  {
    "surah_id": 56,
    "ayah_number": 59,
    "global_ayah_id": 5093,
    "translation": " اس کی «<a href=421> صورت </a>» گری تم کرتے ہو یا «<a href=421> صورت </a>» گری کرنے\nوالے ہم ہیں؟ "
  },
  {
    "surah_id": 56,
    "ayah_number": 60,
    "global_ayah_id": 5094,
    "translation": " ہم نے تمہارے «<a href=321> درمیان </a>» موت مقدر کی ہے اور ہم «<a href=436> عاجز\n</a>» رہنے والے نہیں ہیں! "
  },
  {
    "surah_id": 56,
    "ayah_number": 61,
    "global_ayah_id": 5095,
    "translation": " ۔ ( بلکہ قادر ہیں ) اس «<a href=71> بات </a>» پر کہ ہم تمہاری «<a href=232> جگہ\n</a>» تمہارے مانند بنادیں اور تم کو اٹھائیں اس «<a href=438> عالم </a>» میں جس کو تم نہیں جانتے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 62,
    "global_ayah_id": 5096,
    "translation": " اور پہلی پیدائش کو تو تم جانتے ہی ہو ، تو ( اس سے ) کیوں «<a href=657> یاد </a>»\nدہانی نہیں حاصل کرتے؟ "
  },
  {
    "surah_id": 56,
    "ayah_number": 63,
    "global_ayah_id": 5097,
    "translation": " کیا تم نے «<a href=451> غور </a>» کیا ہے اس چیز پر جو تم بوتے ہو؟ "
  },
  {
    "surah_id": 56,
    "ayah_number": 64,
    "global_ayah_id": 5098,
    "translation": " اس کو تم پروان چڑھاتے ہو یا پروان چڑھانے والے ہم ہیں؟ "
  },
  {
    "surah_id": 56,
    "ayah_number": 65,
    "global_ayah_id": 5099,
    "translation": " ہم چاہیں تو اس کو «<a href=268> ریزہ </a>» ریزہ کر چھوڑیں تو تم باتیں ہی بناتے رہ\nجاؤ ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 66,
    "global_ayah_id": 5100,
    "translation": " بیشک ہم تو تاوان میں پڑے! "
  },
  {
    "surah_id": 56,
    "ayah_number": 67,
    "global_ayah_id": 5101,
    "translation": " بلکہ ہم تو بالکل ہی محروم رہے! "
  },
  {
    "surah_id": 56,
    "ayah_number": 68,
    "global_ayah_id": 5102,
    "translation": " ذرا «<a href=451> غور </a>» تو کرو اس «<a href=144> پانی </a>» پر جو تم پیتے ہو! "
  },
  {
    "surah_id": 56,
    "ayah_number": 69,
    "global_ayah_id": 5103,
    "translation": " کیا تم نے اس کو اتارا ہے بادلوں سے یا اس کے اتارنے والے ہم ہیں؟ "
  },
  {
    "surah_id": 56,
    "ayah_number": 70,
    "global_ayah_id": 5104,
    "translation": " اگر ہم چاہیں تو اس کو بالکل ہی تلخ بنادیں ، تو تم لوگ شکر کیوں نہیں کرتے؟ "
  },
  {
    "surah_id": 56,
    "ayah_number": 71,
    "global_ayah_id": 5105,
    "translation": " ذرا «<a href=451> غور </a>» تو کرو اس «<a href=12> آگ </a>» پر جس کو تم جلاتے ہو! "
  },
  {
    "surah_id": 56,
    "ayah_number": 72,
    "global_ayah_id": 5106,
    "translation": " کیا تم نے «<a href=180> پیدا </a>» کیا ہے اس کے «<a href=319> درخت </a>» کو یا اس\nکے «<a href=180> پیدا </a>» کرنے والے ہم ہیں؟ "
  },
  {
    "surah_id": 56,
    "ayah_number": 73,
    "global_ayah_id": 5107,
    "translation": " ہم نے اس کو یاددہانی اور صحرا کے مسافروں کیلئے ایک نہایت نفع بخش چیز بنایا ہے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 74,
    "global_ayah_id": 5108,
    "translation": " تو تم اپنے ربِ عظیم کے «<a href=614> نام </a>» کی تسبیح کرو! "
  },
  {
    "surah_id": 56,
    "ayah_number": 75,
    "global_ayah_id": 5109,
    "translation": " پس نہیں ، میں «<a href=472> قسم </a>» کھاتا ہوں ستاروں کے گرنے کے ٹھکانوں کی! "
  },
  {
    "surah_id": 56,
    "ayah_number": 76,
    "global_ayah_id": 5110,
    "translation": " اور بیشک یہ ایک بہت بڑی «<a href=472> قسم </a>» ہے اگر تم جانو! "
  },
  {
    "surah_id": 56,
    "ayah_number": 77,
    "global_ayah_id": 5111,
    "translation": " بیشک یہ ایک باعزت «<a href=470> قرآن </a>» ہے ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 78,
    "global_ayah_id": 5112,
    "translation": " ایک محفوظ «<a href=485> کتاب </a>» میں ۔ "
  },
  {
    "surah_id": 56,
    "ayah_number": 79,
    "global_ayah_id": 5113,
