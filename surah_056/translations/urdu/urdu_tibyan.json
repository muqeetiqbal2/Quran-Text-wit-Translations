[
  {
    "surah_id": 56,
    "ayah_number": 0,
    "global_ayah_id": 5034,
    "translation": "اللہ ہی کے «<a href=614> نام </a>» سے  ( «<a href=416> شروع </a>» کرتا ہوں )  جو نہایت رحم فرمانے والا بہت «<a href=600> مہربان </a>» ہے"
  },
  {
    "surah_id": 56,
    "ayah_number": 1,
    "global_ayah_id": 5035,
    "translation": "جب «<a href=476> قیامت </a>» واقع ہوجائے گی"
  },
  {
    "surah_id": 56,
    "ayah_number": 2,
    "global_ayah_id": 5036,
    "translation": "۔  ( تو )  اس کے وقوع کے متعلق کوئی «<a href=249> جھوٹ </a>» بولنے والا نہیں ہوگا"
  },
  {
    "surah_id": 56,
    "ayah_number": 3,
    "global_ayah_id": 5037,
    "translation": "وہ پست کرنے والی، «<a href=106> بلند </a>» کرنے والی ہوگی"
  },
  {
    "surah_id": 56,
    "ayah_number": 4,
    "global_ayah_id": 5038,
    "translation": "جب «<a href=379> زمین </a>» بڑے زور سے ہلا دی جائے گی"
  },
  {
    "surah_id": 56,
    "ayah_number": 5,
    "global_ayah_id": 5039,
    "translation": "اور «<a href=160> پہاڑ </a>» «<a href=268> ریزہ </a>» ریزہ کردیے جائیں گی"
  },
  {
    "surah_id": 56,
    "ayah_number": 6,
    "global_ayah_id": 5040,
    "translation": "پس وہ منتشر «<a href=448> غبار </a>» ہوجائیں گے"
  },
  {
    "surah_id": 56,
    "ayah_number": 7,
    "global_ayah_id": 5041,
    "translation": "اور تم لوگوں کے تین گروہ ہوجائیں گے"
  },
  {
    "surah_id": 56,
    "ayah_number": 8,
    "global_ayah_id": 5042,
    "translation": "سو دائیں طرف والے کیا ہی اچھے ہیں دائیں طرف والے"
  },
  {
    "surah_id": 56,
    "ayah_number": 9,
    "global_ayah_id": 5043,
    "translation": "اور بائیں طرف والے کیسے برے ہیں بائیں طرف والے"
  },
  {
    "surah_id": 56,
    "ayah_number": 10,
    "global_ayah_id": 5044,
    "translation": "اور آگے بڑھنے والے ہی آگے بڑھنے والے ہیں"
  },
  {
    "surah_id": 56,
    "ayah_number": 11,
    "global_ayah_id": 5045,
    "translation": "وہی  ( اللہ کے )  مقربین ہیں"
  },
  {
    "surah_id": 56,
    "ayah_number": 12,
    "global_ayah_id": 5046,
    "translation": "وہ «<a href=623> نعمت </a>» والی جنتوں میں ہیں"
  },
  {
    "surah_id": 56,
    "ayah_number": 13,
    "global_ayah_id": 5047,
    "translation": "بڑا گروہ «<a href=162> پہلے </a>» لوگوں سے ہے"
  },
  {
    "surah_id": 56,
    "ayah_number": 14,
    "global_ayah_id": 5048,
    "translation": "اور تھوڑے پچھلے لوگوں سے ہیں"
  },
  {
    "surah_id": 56,
    "ayah_number": 15,
    "global_ayah_id": 5049,
    "translation": "وہ  ( زر اور جواہر سے )  مرصّع تختوں پر ہوں گے"
  },
  {
    "surah_id": 56,
    "ayah_number": 16,
    "global_ayah_id": 5050,
    "translation": "ان پر تکیے لگائے ہوئے ایک دوسرے کے سامنے"
  },
  {
    "surah_id": 56,
    "ayah_number": 17,
    "global_ayah_id": 5051,
    "translation": "ان کے «<a href=141> پاس </a>» «<a href=652> ہمیشہ </a>» رہنے والے لڑکے گھوم رہے ہوں گے"
  },
  {
    "surah_id": 56,
    "ayah_number": 18,
    "global_ayah_id": 5052,
    "translation": "مٹکوں اور جگوں اور «<a href=414> شراب </a>» کے لبریز جاموں کے ساتھ"
  },
  {
    "surah_id": 56,
    "ayah_number": 19,
    "global_ayah_id": 5053,
    "translation": "جس سے نہ ان کے «<a href=393> سر </a>» میں درد ہو اور نہ ان کی «<a href=442> عقل </a>» میں فتور ہو"
  },
  {
    "surah_id": 56,
    "ayah_number": 20,
    "global_ayah_id": 5054,
    "translation": "ان کے پسندیدہ پھل"
  },
  {
    "surah_id": 56,
    "ayah_number": 21,
    "global_ayah_id": 5055,
    "translation": "اور پرندوں کا وہ گوشت جس کو وہ چاہیں"
  },
  {
    "surah_id": 56,
    "ayah_number": 22,
    "global_ayah_id": 5056,
    "translation": "اور بڑی آنکھوں والی حوریں"
  },
  {
    "surah_id": 56,
    "ayah_number": 23,
    "global_ayah_id": 5057,
    "translation": "جیسے چھپے ہوئے موتی"
  },
  {
    "surah_id": 56,
    "ayah_number": 24,
    "global_ayah_id": 5058,
    "translation": "۔  ( یہ )  ان  ( «<a href=634> نیک </a>» )  کاموں کی جزا ہے جو وہ کرتے تھے"
  },
  {
    "surah_id": 56,
    "ayah_number": 25,
    "global_ayah_id": 5059,
    "translation": "وہ اس میں نہ کوئی بےہودہ «<a href=71> بات </a>» سنیں گے نہ «<a href=531> گناہ </a>» کی بات"
  },
  {
    "surah_id": 56,
    "ayah_number": 26,
    "global_ayah_id": 5060,
    "translation": "مگر ہر طرف سے سلام سلام کی آواز"
  },
  {
    "surah_id": 56,
    "ayah_number": 27,
    "global_ayah_id": 5061,
    "translation": "اور دائیں طرف والے کیا ہی اچھے ہیں دائیں طرف والے"
  },
  {
    "surah_id": 56,
    "ayah_number": 28,
    "global_ayah_id": 5062,
    "translation": "وہ بےکانٹوں کی بیریوں میں ہوں گے"
  },
  {
    "surah_id": 56,
    "ayah_number": 29,
    "global_ayah_id": 5063,
    "translation": "اور «<a href=209> تہ </a>» بہ «<a href=209> تہ </a>» کیلوں میں"
  },
  {
    "surah_id": 56,
    "ayah_number": 30,
    "global_ayah_id": 5064,
    "translation": "اور پھیلے ہوئے لمبے سایوں میں"
  },
  {
    "surah_id": 56,
    "ayah_number": 31,
    "global_ayah_id": 5065,
    "translation": "اور چھلکتے ہوئے «<a href=144> پانی </a>» میں"
  },
  {
    "surah_id": 56,
    "ayah_number": 32,
    "global_ayah_id": 5066,
    "translation": "اور بہ کثرت پھلوں میں"
  },
  {
    "surah_id": 56,
    "ayah_number": 33,
    "global_ayah_id": 5067,
    "translation": "جو نہ کبھی «<a href=294> ختم </a>» ہوں گے نہ ان سے منع کیا جائے گا"
  },
  {
    "surah_id": 56,
    "ayah_number": 34,
    "global_ayah_id": 5068,
    "translation": "اور اونچے بستروں میں"
  },
  {
    "surah_id": 56,
    "ayah_number": 35,
    "global_ayah_id": 5069,
    "translation": "ہم نے ان کی بیویوں کو خصوصیت سے «<a href=180> پیدا </a>» کیا ہے"
  },
  {
    "surah_id": 56,
    "ayah_number": 36,
    "global_ayah_id": 5070,
    "translation": "ہم نے ان کو دوشیزہ بنایا"
  },
  {
    "surah_id": 56,
    "ayah_number": 37,
    "global_ayah_id": 5071,
    "translation": "محبت کرنے والیاں ہم عمر"
  },
  {
    "surah_id": 56,
    "ayah_number": 38,
    "global_ayah_id": 5072,
    "translation": "جو دائیں طرف والے لوگوں کے لیے ہیں"
  },
  {
    "surah_id": 56,
    "ayah_number": 39,
    "global_ayah_id": 5073,
    "translation": "۔  ( دائیں طرف والوں کا )  بڑا گروہ «<a href=162> پہلے </a>» لوگوں میں سے ہوگا"
  },
  {
    "surah_id": 56,
    "ayah_number": 40,
    "global_ayah_id": 5074,
    "translation": "اور ایک بڑا گروہ بعد کے لوگوں میں سے ہوگا"
  },
  {
    "surah_id": 56,
    "ayah_number": 41,
    "global_ayah_id": 5075,
    "translation": "اور بائیں طرف والے کیسے برے ہیں بائیں طرف والے"
  },
  {
    "surah_id": 56,
    "ayah_number": 42,
    "global_ayah_id": 5076,
    "translation": "وہ گرم «<a href=654> ہوا </a>» اور کھولتے ہوئے «<a href=144> پانی </a>» میں ہوں گے"
  },
  {
    "surah_id": 56,
    "ayah_number": 43,
    "global_ayah_id": 5077,
    "translation": "اور سیاہ دھوئیں کے سائے میں ہوں گے"
  },
  {
    "surah_id": 56,
    "ayah_number": 44,
    "global_ayah_id": 5078,
    "translation": "جو نہ «<a href=219> ٹھنڈا </a>» ہوگا نہ فرحت بخش"
  },
  {
    "surah_id": 56,
    "ayah_number": 45,
    "global_ayah_id": 5079,
    "translation": "بیشک وہ اس سے «<a href=162> پہلے </a>» بہت نعمتوں میں تھے"
  },
  {
    "surah_id": 56,
    "ayah_number": 46,
    "global_ayah_id": 5080,
    "translation": "اور وہ «<a href=531> گناہ </a>» کبیرہ پر اصرار کرتے تھے"
  },
  {
    "surah_id": 56,
    "ayah_number": 47,
    "global_ayah_id": 5081,
    "translation": "اور وہ یہ کہا کرتے تھے کہ کیا جب ہم مرجائیں گے اور «<a href=568> مٹی </a>» اور ہڈیاں ہوجائیں گے تو ہم کو دوبارہ اٹھایا جائے گا"
  },
  {
    "surah_id": 56,
    "ayah_number": 48,
    "global_ayah_id": 5082,
    "translation": "اور کیا ہمارے «<a href=162> پہلے </a>» «<a href=69> باپ </a>» دادا کو بھی ؟"
  },
  {
    "surah_id": 56,
    "ayah_number": 49,
    "global_ayah_id": 5083,
    "translation": "آپ کہیے : بیشک تمام اوّلین اور آخرین"
  },
  {
    "surah_id": 56,
    "ayah_number": 50,
    "global_ayah_id": 5084,
    "translation": "ضرور «<a href=593> مقرر </a>» «<a href=326> دن </a>» کے «<a href=639> وقت </a>» پر جمع کیے جائیں گے"
  },
  {
    "surah_id": 56,
    "ayah_number": 51,
    "global_ayah_id": 5085,
    "translation": "پھر بیشک تم اے گمراہو جھٹلانے والو!"
  },
  {
    "surah_id": 56,
    "ayah_number": 52,
    "global_ayah_id": 5086,
    "translation": "تم ضرور تھوہر کے «<a href=319> درخت </a>» سے کھانے والے ہو"
  },
  {
    "surah_id": 56,
    "ayah_number": 53,
    "global_ayah_id": 5087,
    "translation": "پھر اسی سے پیٹوں کو بھرنے والے ہو"
  },
  {
    "surah_id": 56,
    "ayah_number": 54,
    "global_ayah_id": 5088,
    "translation": "پھر اس پر کھولتے ہوئے «<a href=144> پانی </a>» کو پینے والے ہو"
  },
  {
    "surah_id": 56,
    "ayah_number": 55,
    "global_ayah_id": 5089,
    "translation": "پس تم «<a href=391> سخت </a>» پیاسے اونٹ کی طرح پینے والے ہو گے"
  },
  {
    "surah_id": 56,
    "ayah_number": 56,
    "global_ayah_id": 5090,
    "translation": "یہ «<a href=476> قیامت </a>» کے «<a href=326> دن </a>» ان کے لیے ضیافت ہے"
  },
  {
    "surah_id": 56,
    "ayah_number": 57,
    "global_ayah_id": 5091,
    "translation": "ہم نے تم کو «<a href=180> پیدا </a>» کیا ہے سو تم کیوں تصدیق نہیں کرتے"
  },
  {
    "surah_id": 56,
    "ayah_number": 58,
    "global_ayah_id": 5092,
    "translation": "بھلا یہ بتاؤ کہ تم جو منی  ( رحم میں )  ٹپکاتے ہو"
  },
  {
    "surah_id": 56,
    "ayah_number": 59,
    "global_ayah_id": 5093,
    "translation": "کیا اس سے تم  (  «<a href=3> انسان </a>» کی )  تخلیق کرتے ہو یا ہم تخلیق کرنے والے ہیں"
  },
  {
    "surah_id": 56,
    "ayah_number": 60,
    "global_ayah_id": 5094,
    "translation": "ہم ہی نے تمہارے «<a href=321> درمیان </a>» موت  (  کا «<a href=639> وقت </a>» )  مقدر فرمادیا ہے اور ہم «<a href=436> عاجز </a>» نہیں ہیں"
  },
  {
    "surah_id": 56,
    "ayah_number": 61,
    "global_ayah_id": 5095,
    "translation": "کہ ہم تمہارے بدلے میں تم جیسے اور «<a href=180> پیدا </a>» کردیں اور تمہیں از «<a href=393> سر </a>» نو اس طرح «<a href=180> پیدا </a>» کردیں جس کو تم بالکل نہیں جانتے"
  },
  {
    "surah_id": 56,
    "ayah_number": 62,
    "global_ayah_id": 5096,
    "translation": "اور بیشک تم «<a href=162> پہلے </a>» پیدائش کو خوب جانتے ہو تو کیا سبق حاصل نہیں کرتے"
  },
  {
    "surah_id": 56,
    "ayah_number": 63,
    "global_ayah_id": 5097,
    "translation": "بھلا یہ بتاؤکہ تم جو کچھ  ( بظاہر )  کاشت کرتے ہو"
  },
  {
    "surah_id": 56,
    "ayah_number": 64,
    "global_ayah_id": 5098,
    "translation": "اس کو  ( حقیقت میں )  تم اگاتے ہو یا ہم اگانے والے ہیں"
  },
  {
    "surah_id": 56,
    "ayah_number": 65,
    "global_ayah_id": 5099,
    "translation": "اگر ہم چاہیں تو اس کو بالکل چورا چورا کردیں پھر تم باتیں بناتے رہ جاؤ"
  },
  {
    "surah_id": 56,
    "ayah_number": 66,
    "global_ayah_id": 5100,
    "translation": "کہ ہم پر تاوان پڑگیا"
  },
  {
    "surah_id": 56,
    "ayah_number": 67,
    "global_ayah_id": 5101,
    "translation": "بلکہ ہم تو محروم ہوگئے"
  },
  {
    "surah_id": 56,
    "ayah_number": 68,
    "global_ayah_id": 5102,
    "translation": "بھلا بتاؤ کہ جس «<a href=144> پانی </a>» کو تم پیتے ہو"
  },
  {
    "surah_id": 56,
    "ayah_number": 69,
    "global_ayah_id": 5103,
    "translation": "کیا تم نے اس کو «<a href=73> بادل </a>» سے نازل کیا ہے یا ہم نازل کرنے والے ہیں"
  },
  {
    "surah_id": 56,
    "ayah_number": 70,
    "global_ayah_id": 5104,
    "translation": "اگر ہم چاہیں تو اس  (  «<a href=144> پانی </a>» کو )  «<a href=391> سخت </a>» «<a href=489> کڑوا </a>» بنادیں تو پھر تم کیوں شکر ادا نہیں کرتے ؟"
  },
  {
    "surah_id": 56,
    "ayah_number": 71,
    "global_ayah_id": 5105,
    "translation": "بھلا بتاؤ کہ جس «<a href=12> آگ </a>» کو تم سلگاتے ہو"
  },
  {
    "surah_id": 56,
    "ayah_number": 72,
    "global_ayah_id": 5106,
    "translation": "کیا اس کے لیے درختوں کو تم نے «<a href=180> پیدا </a>» کیا ہے یا ہم «<a href=180> پیدا </a>» کرنے والے ہیں"
  },
  {
    "surah_id": 56,
    "ayah_number": 73,
    "global_ayah_id": 5107,
    "translation": "ہم نے اس کو «<a href=622> نصیحت </a>» بنایا اور مسافروں کے لیے «<a href=452> فائدہ </a>» کی چیز"
  },
  {
    "surah_id": 56,
    "ayah_number": 74,
    "global_ayah_id": 5108,
    "translation": "سو آپ اپنے رب کے اسم کی تسبیح کرتے رہیے"
  },
