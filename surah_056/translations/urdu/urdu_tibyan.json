    "surah_id": 56,
    "ayah_number": 75,
    "global_ayah_id": 5109,
    "translation": "پس مجھے ستاروں کے وقوع کی جگہوں کی قسم!"
  },
  {
    "surah_id": 56,
    "ayah_number": 76,
    "global_ayah_id": 5110,
    "translation": "اور اگر تم سمجھو تو یہ بہت عظیم «<a href=472> قسم </a>» ہے"
  },
  {
    "surah_id": 56,
    "ayah_number": 77,
    "global_ayah_id": 5111,
    "translation": "بیشک یہ بہت «<a href=441> عزت </a>» والا «<a href=470> قرآن </a>» ہے"
  },
  {
    "surah_id": 56,
    "ayah_number": 78,
    "global_ayah_id": 5112,
    "translation": "جو «<a href=485> کتاب </a>»  ( لوح )  محفوظ میں ہے"
  },
  {
    "surah_id": 56,
    "ayah_number": 79,
    "global_ayah_id": 5113,
    "translation": "اس «<a href=485> کتاب </a>» کو صرف «<a href=142> پاک </a>» لوگ ہی چھوسکتے ہیں"
  },
