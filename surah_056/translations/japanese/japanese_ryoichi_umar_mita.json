[
  {
    "surah_id": 56,
    "ayah_number": 1,
    "global_ayah_id": 4980,
    "translation": "（起るべき）出来事が起る時，"
  },
  {
    "surah_id": 56,
    "ayah_number": 2,
    "global_ayah_id": 4981,
    "translation": "（誰も）その起るのを，嘘であるとしなくなる。"
  },
  {
    "surah_id": 56,
    "ayah_number": 3,
    "global_ayah_id": 4982,
    "translation": "（或る者は）低く落され，（或る者は）高く挙げられよう。"
  },
  {
    "surah_id": 56,
    "ayah_number": 4,
    "global_ayah_id": 4983,
    "translation": "その時，大地は大揺れに揺れる。"
  },
  {
    "surah_id": 56,
    "ayah_number": 5,
    "global_ayah_id": 4984,
    "translation": "山々は砕けて崩れ，"
  },
  {
    "surah_id": 56,
    "ayah_number": 6,
    "global_ayah_id": 4985,
    "translation": "粉粉になって飛散する。"
  },
  {
    "surah_id": 56,
    "ayah_number": 7,
    "global_ayah_id": 4986,
    "translation": "その時あなたがたは，3つの組に分けられる。"
  },
  {
    "surah_id": 56,
    "ayah_number": 8,
    "global_ayah_id": 4987,
    "translation": "まず右手の仲間（がいる）。右手の仲間とは何であろう。"
  },
  {
    "surah_id": 56,
    "ayah_number": 9,
    "global_ayah_id": 4988,
    "translation": "また左手の仲間（がいる）。左手の仲間とは何であろう。"
  },
  {
    "surah_id": 56,
    "ayah_number": 10,
    "global_ayah_id": 4989,
    "translation": "（信仰の）先頭に立つ者は，（楽園においても）先頭に立ち，"
  },
  {
    "surah_id": 56,
    "ayah_number": 11,
    "global_ayah_id": 4990,
    "translation": "これらの者（先頭に立つ者）は，（アッラーの）側近にはべり，"
  },
  {
    "surah_id": 56,
    "ayah_number": 12,
    "global_ayah_id": 4991,
    "translation": "至福の楽園の中に（住む）。"
  },
  {
    "surah_id": 56,
    "ayah_number": 13,
    "global_ayah_id": 4992,
    "translation": "昔からの者が多数で，"
  },
  {
    "surah_id": 56,
    "ayah_number": 14,
    "global_ayah_id": 4993,
    "translation": "後世の者は僅かである。"
  },
  {
    "surah_id": 56,
    "ayah_number": 15,
    "global_ayah_id": 4994,
    "translation": "（かれらは錦の織物を）敷いた寝床の上に，"
  },
  {
    "surah_id": 56,
    "ayah_number": 16,
    "global_ayah_id": 4995,
    "translation": "向い合ってそれに寄り掛かる。"
  },
  {
    "surah_id": 56,
    "ayah_number": 17,
    "global_ayah_id": 4996,
    "translation": "永遠の（若さを保つ）少年たちがかれらの間を巡り，"
  },
  {
    "surah_id": 56,
    "ayah_number": 18,
    "global_ayah_id": 4997,
    "translation": "（手に手に）高坏や（輝く）水差し，汲立の飲物盃（を捧げる）。"
  },
  {
    "surah_id": 56,
    "ayah_number": 19,
    "global_ayah_id": 4998,
    "translation": "かれらは，それで後の障を残さず，泥酔することもない。"
  },
  {
    "surah_id": 56,
    "ayah_number": 20,
    "global_ayah_id": 4999,
    "translation": "また果実は，かれらの選ぶに任せ，"
  },
  {
    "surah_id": 56,
    "ayah_number": 21,
    "global_ayah_id": 5000,
    "translation": "種々の鳥の肉は，かれらの好みのまま。"
  },
  {
    "surah_id": 56,
    "ayah_number": 22,
    "global_ayah_id": 5001,
    "translation": "大きい輝くまなざしの，美しい乙女は，"
  },
  {
    "surah_id": 56,
    "ayah_number": 23,
    "global_ayah_id": 5002,
    "translation": "丁度秘蔵の真珠のよう。"
  },
  {
    "surah_id": 56,
    "ayah_number": 24,
    "global_ayah_id": 5003,
    "translation": "（これらは）かれらの行いに対する報奨である。"
  },
  {
    "surah_id": 56,
    "ayah_number": 25,
    "global_ayah_id": 5004,
    "translation": "そこでは，無益な言葉や，罪作りな話も聞くことはない。"
  },
  {
    "surah_id": 56,
    "ayah_number": 26,
    "global_ayah_id": 5005,
    "translation": "只「平安あれ，平安あれ。」と言う（のを耳にする）だけである。"
  },
  {
    "surah_id": 56,
    "ayah_number": 27,
    "global_ayah_id": 5006,
    "translation": "右手の仲間，右手の仲間とは何であろう。"
  },
  {
    "surah_id": 56,
    "ayah_number": 28,
    "global_ayah_id": 5007,
    "translation": "（かれらは）刺のないスィドラの木，"
  },
  {
    "surah_id": 56,
    "ayah_number": 29,
    "global_ayah_id": 5008,
    "translation": "累々と実るタルフ木（の中に住み），"
  },
  {
    "surah_id": 56,
    "ayah_number": 30,
    "global_ayah_id": 5009,
    "translation": "長く伸びる木陰の，"
  },
  {
    "surah_id": 56,
    "ayah_number": 31,
    "global_ayah_id": 5010,
    "translation": "絶え間なく流れる水の間で，"
  },
  {
    "surah_id": 56,
    "ayah_number": 32,
    "global_ayah_id": 5011,
    "translation": "豊かな果物が"
  },
  {
    "surah_id": 56,
    "ayah_number": 33,
    "global_ayah_id": 5012,
    "translation": "絶えることなく，禁じられることもなく（取り放題）。"
  },
  {
    "surah_id": 56,
    "ayah_number": 34,
    "global_ayah_id": 5013,
    "translation": "高く上げられた（位階の）臥所に（着く）。"
  },
  {
    "surah_id": 56,
    "ayah_number": 35,
    "global_ayah_id": 5014,
    "translation": "本当にわれは，かれら（の配偶として乙女）を特別に創り，"
  },
  {
    "surah_id": 56,
    "ayah_number": 36,
    "global_ayah_id": 5015,
    "translation": "かの女らを（永遠に汚れない）処女にした。"
  },
  {
    "surah_id": 56,
    "ayah_number": 37,
    "global_ayah_id": 5016,
    "translation": "愛しい，同じ年配の者。"
  },
  {
    "surah_id": 56,
    "ayah_number": 38,
    "global_ayah_id": 5017,
    "translation": "（これらは）右手の仲間のためである。"
  },
  {
    "surah_id": 56,
    "ayah_number": 39,
    "global_ayah_id": 5018,
    "translation": "昔の者が大勢いるが，"
  },
  {
    "surah_id": 56,
    "ayah_number": 40,
    "global_ayah_id": 5019,
    "translation": "後世の者も多い。"
  },
  {
    "surah_id": 56,
    "ayah_number": 41,
    "global_ayah_id": 5020,
    "translation": "左手の仲間，かれらは何であろう。"
  },
  {
    "surah_id": 56,
    "ayah_number": 42,
    "global_ayah_id": 5021,
    "translation": "（かれらは）焼け焦がすような風と，煮え立つ湯の中，"
  },
  {
    "surah_id": 56,
    "ayah_number": 43,
    "global_ayah_id": 5022,
    "translation": "黒煙の影に，"
  },
  {
    "surah_id": 56,
    "ayah_number": 44,
    "global_ayah_id": 5023,
    "translation": "涼しくもなく，爽やかでもない（中にいる）。"
  },
  {
    "surah_id": 56,
    "ayah_number": 45,
    "global_ayah_id": 5024,
    "translation": "かれらはそれ以前，裕福で（享楽に耽り）。"
  },
  {
    "surah_id": 56,
    "ayah_number": 46,
    "global_ayah_id": 5025,
    "translation": "大罪を敢て犯していた。"
  },
  {
    "surah_id": 56,
    "ayah_number": 47,
    "global_ayah_id": 5026,
    "translation": "そして何時も言っていた。「わたしたちは死んでから，土と骨になり，本当に甦されるのでしょうか。"
  },
  {
    "surah_id": 56,
    "ayah_number": 48,
    "global_ayah_id": 5027,
    "translation": "わたしたちの古い祖先も（甦されるの）ですか。」"
  },
  {
    "surah_id": 56,
    "ayah_number": 49,
    "global_ayah_id": 5028,
    "translation": "言ってやるがいい。「そうだとも，昔の者も後世の者も。"
  },
  {
    "surah_id": 56,
    "ayah_number": 50,
    "global_ayah_id": 5029,
    "translation": "必ず一緒に召集されるのである。定められた日の，定められた時に。」"
  },
  {
    "surah_id": 56,
    "ayah_number": 51,
    "global_ayah_id": 5030,
    "translation": "その時あなたがたは（どうであろう），迷って（真理を）虚偽であるとした者よ。"
  },
  {
    "surah_id": 56,
    "ayah_number": 52,
    "global_ayah_id": 5031,
    "translation": "必ずあなたがたはザックームの木（の実）を食べ，"
  },
  {
    "surah_id": 56,
    "ayah_number": 53,
    "global_ayah_id": 5032,
    "translation": "それで腹は一杯。"
  },
  {
    "surah_id": 56,
    "ayah_number": 54,
    "global_ayah_id": 5033,
    "translation": "その上煮え立つ湯を飲む，"
  },
  {
    "surah_id": 56,
    "ayah_number": 55,
    "global_ayah_id": 5034,
    "translation": "喉が乾いたラクダが飲むように。"
  },
  {
    "surah_id": 56,
    "ayah_number": 56,
    "global_ayah_id": 5035,
    "translation": "これが審きの日の，かれらの持て成しである。"
  },
  {
    "surah_id": 56,
    "ayah_number": 57,
    "global_ayah_id": 5036,
    "translation": "われはあなたがたを創った。あなたがたはどうして真実を信じようとしないのか。"
  },
  {
    "surah_id": 56,
    "ayah_number": 58,
    "global_ayah_id": 5037,
    "translation": "あなたがたは，あなたがたの射出するもの（精液）に就いて考えたか。"
  },
  {
    "surah_id": 56,
    "ayah_number": 59,
    "global_ayah_id": 5038,
    "translation": "それを創ったのはあなたがたなのか，それともわれがその創造者であるのか。"
  },
  {
    "surah_id": 56,
    "ayah_number": 60,
    "global_ayah_id": 5039,
    "translation": "われは，あなたがたに死（期）を定めた。われは，（決して）出し抜かれたりすることはない。"
  },
  {
    "surah_id": 56,
    "ayah_number": 61,
    "global_ayah_id": 5040,
    "translation": "だがわれは同類の者で取り替え（世代の交替），またはあなたがたが知らない（他の形態の）ものに，あなたがたを創（り変え）る。"
  },
  {
    "surah_id": 56,
    "ayah_number": 62,
    "global_ayah_id": 5041,
    "translation": "あなたがたは，確かに最初の創造を知っている。それでも何故留意しないのか。"
  },
  {
    "surah_id": 56,
    "ayah_number": 63,
    "global_ayah_id": 5042,
    "translation": "あなたがたは，あなたがたが耕す（畑の）ことを考えたか。"
  },
  {
    "surah_id": 56,
    "ayah_number": 64,
    "global_ayah_id": 5043,
    "translation": "あなたがたがそれ（植物）を育てるのか，それともわれが育てるのか。"
  },
  {
    "surah_id": 56,
    "ayah_number": 65,
    "global_ayah_id": 5044,
    "translation": "もしわれが欲するならば，それを枯れた屑にしてしまう。あなたがたは驚愕して止まない。"
  },
  {
    "surah_id": 56,
    "ayah_number": 66,
    "global_ayah_id": 5045,
    "translation": "（そして言うであろう。）「わたしたちは本当に負債を課せられた。"
  },
  {
    "surah_id": 56,
    "ayah_number": 67,
    "global_ayah_id": 5046,
    "translation": "いや，わたしたちは（労働の成果を）取り上げられた。」"
  },
  {
    "surah_id": 56,
    "ayah_number": 68,
    "global_ayah_id": 5047,
    "translation": "またあなたがたの飲む水に就いて考えたか。"
  },
  {
    "surah_id": 56,
    "ayah_number": 69,
    "global_ayah_id": 5048,
    "translation": "あなたがたが雲から（雨を）降らせるのか，それともわれが降らせるのか。"
  },
  {
    "surah_id": 56,
    "ayah_number": 70,
    "global_ayah_id": 5049,
    "translation": "われがもし欲するならば，それを塩辛くすることが出来る。あなたがたはどうして感謝しないのか。"
  },
  {
    "surah_id": 56,
    "ayah_number": 71,
    "global_ayah_id": 5050,
    "translation": "あなたがたは，灯火に就いて考えたか。"
  },
  {
    "surah_id": 56,
    "ayah_number": 72,
    "global_ayah_id": 5051,
    "translation": "その（燃やす）木を，あなたがたが創ったのか，それともわれが創ったのか。"
  },
  {
    "surah_id": 56,
    "ayah_number": 73,
    "global_ayah_id": 5052,
    "translation": "われはそれを教訓とし，また荒野の住民の便利のために創った。"
  },
  {
    "surah_id": 56,
    "ayah_number": 74,
    "global_ayah_id": 5053,
    "translation": "だから偉大であられるあなたの主の御名を讃えなさい。"
  },
  {
    "surah_id": 56,
    "ayah_number": 75,
    "global_ayah_id": 5054,
    "translation": "わたしは，沈んでゆく星にかけて誓う。"
  },
  {
    "surah_id": 56,
    "ayah_number": 76,
    "global_ayah_id": 5055,
    "translation": "それは本当に偉大な誓いである。もしあなたがたに分るならば，"
  },
  {
    "surah_id": 56,
    "ayah_number": 77,
    "global_ayah_id": 5056,
    "translation": "本当にこれは，非常に尊いクルアーンである。"
  },
  {
    "surah_id": 56,
    "ayah_number": 78,
    "global_ayah_id": 5057,
    "translation": "（それは）秘蔵の啓典の中に（書かれてあり），"
  },
  {
    "surah_id": 56,
    "ayah_number": 79,
    "global_ayah_id": 5058,
    "translation": "清められた者の外，触れることが出来ない。"
  },
  {
    "surah_id": 56,
    "ayah_number": 80,
    "global_ayah_id": 5059,
    "translation": "万有の主からの啓示である。"
  },
  {
    "surah_id": 56,
    "ayah_number": 81,
    "global_ayah_id": 5060,
    "translation": "これは，あなたがたが軽んじるような教えであろうか。"
  },
  {
    "surah_id": 56,
    "ayah_number": 82,
    "global_ayah_id": 5061,
    "translation": "またあなたがたは（それを）虚偽であると申し立て，あなたがたの暮らしを立てるのか。"
  },
  {
    "surah_id": 56,
    "ayah_number": 83,
    "global_ayah_id": 5062,
    "translation": "それならあなたがたは，（臨終の人の魂が）喉もとを塞ぐ時，"
  },
  {
    "surah_id": 56,
    "ayah_number": 84,
    "global_ayah_id": 5063,
    "translation": "（座って只）見守るばかりなのか。"
  },
  {
    "surah_id": 56,
    "ayah_number": 85,
    "global_ayah_id": 5064,
    "translation": "われはあなたがたよりもかれに近いのである。だがあなたがたには見えはしない。"
  },
  {
    "surah_id": 56,
    "ayah_number": 86,
    "global_ayah_id": 5065,
    "translation": "あなたがたがもし（来世の）報いを除外されているというのなら，あなたがたは何故，"
  },
  {
    "surah_id": 56,
    "ayah_number": 87,
    "global_ayah_id": 5066,
    "translation": "その（魂）を（体内に）呼び戻さないのか。もしあなたがたが，真実（を語っているの）ならば。"
  },
  {
    "surah_id": 56,
    "ayah_number": 88,
    "global_ayah_id": 5067,
    "translation": "もしかれが，（アッラー）に近付けられた者であるなら，"
  },
  {
    "surah_id": 56,
    "ayah_number": 89,
    "global_ayah_id": 5068,
    "translation": "（かれに対する報奨は）安心と満悦，そして至福の楽園である。"
  },
  {
    "surah_id": 56,
    "ayah_number": 90,
    "global_ayah_id": 5069,
    "translation": "もしかれが，右手の仲間であるならば，"
  },
  {
    "surah_id": 56,
    "ayah_number": 91,
    "global_ayah_id": 5070,
    "translation": "「あなたに平安あれ。」と右手の仲間から（挨拶される）。"
  },
  {
    "surah_id": 56,
    "ayah_number": 92,
    "global_ayah_id": 5071,
    "translation": "もしかれが，嘘付きで，迷った者であるならば，"
  },
  {
    "surah_id": 56,
    "ayah_number": 93,
    "global_ayah_id": 5072,
    "translation": "煮え立つ湧の待遇を受け，"
  },
  {
    "surah_id": 56,
    "ayah_number": 94,
    "global_ayah_id": 5073,
    "translation": "獄火で焼かれよう。"
  },
  {
    "surah_id": 56,
    "ayah_number": 95,
    "global_ayah_id": 5074,
    "translation": "本当にこれは，揺ぎのない確かな真理である。"
  },
  {
    "surah_id": 56,
    "ayah_number": 96,
    "global_ayah_id": 5075,
    "translation": "だから偉大であられるあなたの主の御名を讃えなさい。"
  }
]