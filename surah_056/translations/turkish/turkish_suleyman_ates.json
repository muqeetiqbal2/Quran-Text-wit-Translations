[
  {
    "surah_id": 56,
    "ayah_number": 1,
    "global_ayah_id": 4980,
    "translation": "Olacak vak'a olduğu (kıyamet koptuğu) zaman,"
  },
  {
    "surah_id": 56,
    "ayah_number": 2,
    "global_ayah_id": 4981,
    "translation": "Onun oluşunu yalanlayacak yoktur."
  },
  {
    "surah_id": 56,
    "ayah_number": 3,
    "global_ayah_id": 4982,
    "translation": "O alçaltıcı, yükselticidir (yerleri alt üst eder),"
  },
  {
    "surah_id": 56,
    "ayah_number": 4,
    "global_ayah_id": 4983,
    "translation": "Yer şiddetliesarsıldığı,"
  },
  {
    "surah_id": 56,
    "ayah_number": 5,
    "global_ayah_id": 4984,
    "translation": "Dağlar serpildikçe serpildiği,"
  },
  {
    "surah_id": 56,
    "ayah_number": 6,
    "global_ayah_id": 4985,
    "translation": "Dağılan toz duman haline geldiği"
  },
  {
    "surah_id": 56,
    "ayah_number": 7,
    "global_ayah_id": 4986,
    "translation": "Ve sizler üç sınıf olduğunuz zaman;"
  },
  {
    "surah_id": 56,
    "ayah_number": 8,
    "global_ayah_id": 4987,
    "translation": "Sağın adamları (amel defterleri sağ tarafından verilenler), ne uğurlulardır onlar!"
  },
  {
    "surah_id": 56,
    "ayah_number": 9,
    "global_ayah_id": 4988,
    "translation": "Solun adamları (amel defterleri sol tarafından verilenler), ne uğursuzlardır onlar!"
  },
  {
    "surah_id": 56,
    "ayah_number": 10,
    "global_ayah_id": 4989,
    "translation": "Ve o sabıklar, sabıklar!"
  },
  {
    "surah_id": 56,
    "ayah_number": 11,
    "global_ayah_id": 4990,
    "translation": "İşte, onlardır (Allah'a) yaklaştırılanlar,"
  },
  {
    "surah_id": 56,
    "ayah_number": 12,
    "global_ayah_id": 4991,
    "translation": "Ni'met cennetlerinde."
  },
  {
    "surah_id": 56,
    "ayah_number": 13,
    "global_ayah_id": 4992,
    "translation": "Çoğu öncekilerden,"
  },
  {
    "surah_id": 56,
    "ayah_number": 14,
    "global_ayah_id": 4993,
    "translation": "Birazı da sonrakilerden (olan bu insanlar),"
  },
  {
    "surah_id": 56,
    "ayah_number": 15,
    "global_ayah_id": 4994,
    "translation": "Altın ve cevahirle işlenmiş tahtlar üzerindedirler."
  },
  {
    "surah_id": 56,
    "ayah_number": 16,
    "global_ayah_id": 4995,
    "translation": "Onların üzerinde karşılıklı yaslanırlar."
  },
  {
    "surah_id": 56,
    "ayah_number": 17,
    "global_ayah_id": 4996,
    "translation": "Çevrelerinde, ebedi yaşamağa erdirilmiş gençler dolaşır;"
  },
  {
    "surah_id": 56,
    "ayah_number": 18,
    "global_ayah_id": 4997,
    "translation": "Akıp giden şarap kaynağından doldurulmuş testiler, ibrikler ve kadehlerle."
  },
  {
    "surah_id": 56,
    "ayah_number": 19,
    "global_ayah_id": 4998,
    "translation": "(Bir şarap ki) Ondan ne başları ağrıtılır, ne de akılları giderilir."
  },
  {
    "surah_id": 56,
    "ayah_number": 20,
    "global_ayah_id": 4999,
    "translation": "Beğendikleri meyva(lar),"
  },
  {
    "surah_id": 56,
    "ayah_number": 21,
    "global_ayah_id": 5000,
    "translation": "Canlarının çektiği kuş et(ler)i,"
  },
  {
    "surah_id": 56,
    "ayah_number": 22,
    "global_ayah_id": 5001,
    "translation": "İri gözlü huriler,"
  },
  {
    "surah_id": 56,
    "ayah_number": 23,
    "global_ayah_id": 5002,
    "translation": "Saklı inciler gibi;"
  },
  {
    "surah_id": 56,
    "ayah_number": 24,
    "global_ayah_id": 5003,
    "translation": "Yaptıklarına karşılık olarak."
  },
  {
    "surah_id": 56,
    "ayah_number": 25,
    "global_ayah_id": 5004,
    "translation": "Orada ne boş bir söz ve ne de günaha sokan bir laf işitirler."
  },
  {
    "surah_id": 56,
    "ayah_number": 26,
    "global_ayah_id": 5005,
    "translation": "Duydukları söz, yalnız \"Selam, selam\" dır."
  },
  {
    "surah_id": 56,
    "ayah_number": 27,
    "global_ayah_id": 5006,
    "translation": "Sağın adamları, nedir o sağın adamları!"
  },
  {
    "surah_id": 56,
    "ayah_number": 28,
    "global_ayah_id": 5007,
    "translation": "(Onlar) Dikensiz kirazlar,"
  },
  {
    "surah_id": 56,
    "ayah_number": 29,
    "global_ayah_id": 5008,
    "translation": "(Kökünden tepesine kadar) meyva dizili muzlar,"
  },
  {
    "surah_id": 56,
    "ayah_number": 30,
    "global_ayah_id": 5009,
    "translation": "Uzamış gölge(ler),"
  },
  {
    "surah_id": 56,
    "ayah_number": 31,
    "global_ayah_id": 5010,
    "translation": "Fışkıran sular,"
  },
  {
    "surah_id": 56,
    "ayah_number": 32,
    "global_ayah_id": 5011,
    "translation": "Pek çok mevya arasında;"
  },
  {
    "surah_id": 56,
    "ayah_number": 33,
    "global_ayah_id": 5012,
    "translation": "Tükenmeyen ve yasaklanmayan!"
  },
  {
    "surah_id": 56,
    "ayah_number": 34,
    "global_ayah_id": 5013,
    "translation": "Ve yükseltilmiş döşekler üstündedirler."
  },
  {
    "surah_id": 56,
    "ayah_number": 35,
    "global_ayah_id": 5014,
    "translation": "Biz (oradaki) kadınları da yeniden bir güzel inşa' etmişiz,"
  },
  {
    "surah_id": 56,
    "ayah_number": 36,
    "global_ayah_id": 5015,
    "translation": "Onları bakireler yapmışızdır."
  },
  {
    "surah_id": 56,
    "ayah_number": 37,
    "global_ayah_id": 5016,
    "translation": "Hep yaşıt sevgililer;"
  },
  {
    "surah_id": 56,
    "ayah_number": 38,
    "global_ayah_id": 5017,
    "translation": "Sağın adamları için."
  },
  {
    "surah_id": 56,
    "ayah_number": 39,
    "global_ayah_id": 5018,
    "translation": "(Bu sağcıların) Bir bölümü öncekilerdendir,"
  },
  {
    "surah_id": 56,
    "ayah_number": 40,
    "global_ayah_id": 5019,
    "translation": "Bir bölümü de sonrakilerdendir."
  },
  {
    "surah_id": 56,
    "ayah_number": 41,
    "global_ayah_id": 5020,
    "translation": "Solun adamları (amel defterleri, sol tarafından verilenler), nedir o solcular!"
  },
  {
    "surah_id": 56,
    "ayah_number": 42,
    "global_ayah_id": 5021,
    "translation": "(Onlar) Delikçiklere işleyen bir ateş ve kaynar su içinde,"
  },
  {
    "surah_id": 56,
    "ayah_number": 43,
    "global_ayah_id": 5022,
    "translation": "Kara dumandan bir gölge altında,"
  },
  {
    "surah_id": 56,
    "ayah_number": 44,
    "global_ayah_id": 5023,
    "translation": "Ki ne serindir, ne faydalı."
  },
  {
    "surah_id": 56,
    "ayah_number": 45,
    "global_ayah_id": 5024,
    "translation": "Çünkü onlar bundan önce varlık içinde şımartılmışlardı."
  },
  {
    "surah_id": 56,
    "ayah_number": 46,
    "global_ayah_id": 5025,
    "translation": "Büyük günahı işlemekte ısrar ediyorlardı."
  },
  {
    "surah_id": 56,
    "ayah_number": 47,
    "global_ayah_id": 5026,
    "translation": "Ve diyorlardı ki: \"Biz öldükten, toprak ve kemik yığını olduktan sonra, biz mi bir daha diriltileceğiz?\""
  },
  {
    "surah_id": 56,
    "ayah_number": 48,
    "global_ayah_id": 5027,
    "translation": "Önceki atalarımız da mı?"
  },
  {
    "surah_id": 56,
    "ayah_number": 49,
    "global_ayah_id": 5028,
    "translation": "De ki: \"Öncekiler de sonrakiler de.\""
  },
  {
    "surah_id": 56,
    "ayah_number": 50,
    "global_ayah_id": 5029,
    "translation": "Belli bir günün buluşma vakti için mutlaka toplanacaklardır."
  },
  {
    "surah_id": 56,
    "ayah_number": 51,
    "global_ayah_id": 5030,
    "translation": "Sonra siz de, ey sapık yalanlayıcılar (o zaman toplanacaksınız)."
  },
  {
    "surah_id": 56,
    "ayah_number": 52,
    "global_ayah_id": 5031,
    "translation": "(Suçlular) Mutlaka bir Zakkum ağacından yiyecekler,"
  },
  {
    "surah_id": 56,
    "ayah_number": 53,
    "global_ayah_id": 5032,
    "translation": "Onunla karınları(nı) dolduracaklar,"
  },
  {
    "surah_id": 56,
    "ayah_number": 54,
    "global_ayah_id": 5033,
    "translation": "Üzerine de kaynar su içeceklerdir."
  },
  {
    "surah_id": 56,
    "ayah_number": 55,
    "global_ayah_id": 5034,
    "translation": "Susuzluk hastalığına tutulmuş develerin içişi gibi içeceklerdir!"
  },
  {
    "surah_id": 56,
    "ayah_number": 56,
    "global_ayah_id": 5035,
    "translation": "İşte ceza gününde onların ağırlanışı böyledir."
  },
  {
    "surah_id": 56,
    "ayah_number": 57,
    "global_ayah_id": 5036,
    "translation": "Biz sizi yarattık; doğrulamanız gerekmez mi?"
  },
  {
    "surah_id": 56,
    "ayah_number": 58,
    "global_ayah_id": 5037,
    "translation": "Akıttığınız meniyi gördünüz mü?"
  },
  {
    "surah_id": 56,
    "ayah_number": 59,
    "global_ayah_id": 5038,
    "translation": "Siz mi onu yaratıyorsunuz, yoksa yaratıcılar biz miyiz?"
  },
  {
    "surah_id": 56,
    "ayah_number": 60,
    "global_ayah_id": 5039,
    "translation": "Aranızda ölümü takdir eden biziz ve bizim önümüze geçilmiş değildir (kimse ölüme engel olamaz)."
  },
  {
    "surah_id": 56,
    "ayah_number": 61,
    "global_ayah_id": 5040,
    "translation": "(Size böyle ölümü takdir ettik) Ki sizin yerinize benzerlerinizi getirelim ve sizi, bilmediğiniz bir biçimde yeniden inşa' edelim."
  },
  {
    "surah_id": 56,
    "ayah_number": 62,
    "global_ayah_id": 5041,
    "translation": "Andolsun, ilk yaratmayı bildiniz, (bunu) düşünüp ibret almanız gerekmez mi?"
  },
  {
    "surah_id": 56,
    "ayah_number": 63,
    "global_ayah_id": 5042,
    "translation": "Ektiğinizi gördünüz mü?"
  },
  {
    "surah_id": 56,
    "ayah_number": 64,
    "global_ayah_id": 5043,
    "translation": "Siz mi onu bitiyorsunuz, yoksa bitirenler biz miyiz?"
  },
  {
    "surah_id": 56,
    "ayah_number": 65,
    "global_ayah_id": 5044,
    "translation": "Dileseydik, onu kuru bir çöp yapardık, sızlanıp dururdunuz:"
  },
  {
    "surah_id": 56,
    "ayah_number": 66,
    "global_ayah_id": 5045,
    "translation": "Biz borçlandık, (yaptığmız masraflar boşa gitti)!"
  },
  {
    "surah_id": 56,
    "ayah_number": 67,
    "global_ayah_id": 5046,
    "translation": "Doğrusu, biz yoksun bırakıldık! (derdiniz)."
  },
  {
    "surah_id": 56,
    "ayah_number": 68,
    "global_ayah_id": 5047,
    "translation": "İçtiğiniz suya baktınız mı?"
  },
  {
    "surah_id": 56,
    "ayah_number": 69,
    "global_ayah_id": 5048,
    "translation": "Siz mi onu buluttan indirdiniz, yoksa indirenler biz miyiz?"
  },
  {
    "surah_id": 56,
    "ayah_number": 70,
    "global_ayah_id": 5049,
    "translation": "Dileseydik onu tuzlu yapardık. Şüketmeniz gerekmez mi?"
  },
  {
    "surah_id": 56,
    "ayah_number": 71,
    "global_ayah_id": 5050,
    "translation": "(İki dalı birbirine sürterek) Çıkardığınız ateşi gördünüz mü?"
  },
  {
    "surah_id": 56,
    "ayah_number": 72,
    "global_ayah_id": 5051,
    "translation": "Onun ağacını siz mi yarattınız, yoksa yaratanlar biz miyiz?"
  },
  {
    "surah_id": 56,
    "ayah_number": 73,
    "global_ayah_id": 5052,
    "translation": "Biz onu bir ibret ve çölden gelip geçenlere bir fayda yaptık."
  },
  {
    "surah_id": 56,
    "ayah_number": 74,
    "global_ayah_id": 5053,
    "translation": "Öyleyse büyük Rabbinin adını yücelt."
  },
  {
    "surah_id": 56,
    "ayah_number": 75,
    "global_ayah_id": 5054,
    "translation": "Yoo, yıldızların yerlerine yemin ederim,"
  },
  {
    "surah_id": 56,
    "ayah_number": 76,
    "global_ayah_id": 5055,
    "translation": "Bilirseniz, bu büyük bir yemindir."
  },
  {
    "surah_id": 56,
    "ayah_number": 77,
    "global_ayah_id": 5056,
    "translation": "O, elbette değerli bir Kur'an'dır,"
  },
  {
    "surah_id": 56,
    "ayah_number": 78,
    "global_ayah_id": 5057,
    "translation": "Saklı bir Kitaptadır."
  },
  {
    "surah_id": 56,
    "ayah_number": 79,
    "global_ayah_id": 5058,
    "translation": "Ki ona temizlerden başkası dokunmaz."
  },
  {
    "surah_id": 56,
    "ayah_number": 80,
    "global_ayah_id": 5059,
    "translation": "(O), Alemlerin Rabbinden indirilmiştir."
  },
  {
    "surah_id": 56,
    "ayah_number": 81,
    "global_ayah_id": 5060,
    "translation": "Şimdi siz, bu sözü mü küçümsüyorsunuz?"
  },
  {
    "surah_id": 56,
    "ayah_number": 82,
    "global_ayah_id": 5061,
    "translation": "(Kur'an'dan istifade edeceğiniz yerde) Rızkınızı, yalanlamanızdan ibaret mi kılıyorsunuz (sizin ondan elde ettiğiniz nasib, sadece onu yalanlamanız mıdır)?"
  },
  {
    "surah_id": 56,
    "ayah_number": 83,
    "global_ayah_id": 5062,
    "translation": "Ya can boğaza dayandığı zaman?"
  },
  {
    "surah_id": 56,
    "ayah_number": 84,
    "global_ayah_id": 5063,
    "translation": "Ki siz de o zaman (can çekişen kimseye) bakıp durursunuz."
  },
  {
    "surah_id": 56,
    "ayah_number": 85,
    "global_ayah_id": 5064,
    "translation": "Biz ona sizden daha yakınız, fakat siz görmezsiniz."
  },
  {
    "surah_id": 56,
    "ayah_number": 86,
    "global_ayah_id": 5065,
    "translation": "Eğer (öldükten sonra) cezalandırılmayacaksanız"
  },
  {
    "surah_id": 56,
    "ayah_number": 87,
    "global_ayah_id": 5066,
    "translation": "(Bu sözünüzde doğru iseniz) o(çıkmakta olan ca)nı geri döndürsenize!"
  },
  {
    "surah_id": 56,
    "ayah_number": 88,
    "global_ayah_id": 5067,
    "translation": "(O can, Allah'a) Yaklaştırılanlardan ise,"
  },
  {
    "surah_id": 56,
    "ayah_number": 89,
    "global_ayah_id": 5068,
    "translation": "O'na rahatlık, güzel rızık ve ni'met cenneti var."
  },
  {
    "surah_id": 56,
    "ayah_number": 90,
    "global_ayah_id": 5069,
    "translation": "Eğer sağcılardan (amel defteri sağ tarafından verilenlerden) ise,"
  },
  {
    "surah_id": 56,
    "ayah_number": 91,
    "global_ayah_id": 5070,
    "translation": "(Ey sağcı) Sana sağcılardan selam var!"
  },
  {
    "surah_id": 56,
    "ayah_number": 92,
    "global_ayah_id": 5071,
    "translation": "Ama yalanlayıcı sapıklardan ise;"
  },
  {
    "surah_id": 56,
    "ayah_number": 93,
    "global_ayah_id": 5072,
    "translation": "Kaynar sudan bir ziyafet,"
  },
  {
    "surah_id": 56,
    "ayah_number": 94,
    "global_ayah_id": 5073,
    "translation": "Ve cehenneme atılma var."
  },
  {
    "surah_id": 56,
    "ayah_number": 95,
    "global_ayah_id": 5074,
    "translation": "Kesin gerçek budur işte."
  },
  {
    "surah_id": 56,
    "ayah_number": 96,
    "global_ayah_id": 5075,
    "translation": "Öyleyse büyük Rabbinin adını tesbih et (O'nu, kendisine layık olmayan sıfatlardan tenzih eyle)."
  }
]