[
  {
    "surah_id": 56,
    "ayah_number": 1,
    "global_ayah_id": 4980,
    "translation": "Когато Събитието настъпи,"
  },
  {
    "surah_id": 56,
    "ayah_number": 2,
    "global_ayah_id": 4981,
    "translation": "никой не ще възпре неговото настъпване -"
  },
  {
    "surah_id": 56,
    "ayah_number": 3,
    "global_ayah_id": 4982,
    "translation": "принизяващо и въздигащо."
  },
  {
    "surah_id": 56,
    "ayah_number": 4,
    "global_ayah_id": 4983,
    "translation": "Когато земята се разтърси в трус"
  },
  {
    "surah_id": 56,
    "ayah_number": 5,
    "global_ayah_id": 4984,
    "translation": "и планините се разломят на отломки,"
  },
  {
    "surah_id": 56,
    "ayah_number": 6,
    "global_ayah_id": 4985,
    "translation": "и станат разпиляна прах,"
  },
  {
    "surah_id": 56,
    "ayah_number": 7,
    "global_ayah_id": 4986,
    "translation": "вие ще станете на три групи:"
  },
  {
    "surah_id": 56,
    "ayah_number": 8,
    "global_ayah_id": 4987,
    "translation": "едни - отдясно, - какво ще е за тези отдясно?;"
  },
  {
    "surah_id": 56,
    "ayah_number": 9,
    "global_ayah_id": 4988,
    "translation": "и други - отляво, - какво ще е за тези отляво?;"
  },
  {
    "surah_id": 56,
    "ayah_number": 10,
    "global_ayah_id": 4989,
    "translation": "и първенците [в богобоязливостта], - те са първенците [в Рая]"
  },
  {
    "surah_id": 56,
    "ayah_number": 11,
    "global_ayah_id": 4990,
    "translation": "тези са приближените [на Аллах]"
  },
  {
    "surah_id": 56,
    "ayah_number": 12,
    "global_ayah_id": 4991,
    "translation": "в Градините на блаженството"
  },
  {
    "surah_id": 56,
    "ayah_number": 13,
    "global_ayah_id": 4992,
    "translation": "повечето са от предците"
  },
  {
    "surah_id": 56,
    "ayah_number": 14,
    "global_ayah_id": 4993,
    "translation": "и малцина от сетните"
  },
  {
    "surah_id": 56,
    "ayah_number": 15,
    "global_ayah_id": 4994,
    "translation": "на украсени престоли,"
  },
  {
    "surah_id": 56,
    "ayah_number": 16,
    "global_ayah_id": 4995,
    "translation": "облегнати там един срещу друг."
  },
  {
    "surah_id": 56,
    "ayah_number": 17,
    "global_ayah_id": 4996,
    "translation": "Вечномлади юноши им поднасят"
  },
  {
    "surah_id": 56,
    "ayah_number": 18,
    "global_ayah_id": 4997,
    "translation": "бокали и кани, и чаши [вино] от извор."
  },
  {
    "surah_id": 56,
    "ayah_number": 19,
    "global_ayah_id": 4998,
    "translation": "Не ще ги боли глава от това и не ще губят ум."
  },
  {
    "surah_id": 56,
    "ayah_number": 20,
    "global_ayah_id": 4999,
    "translation": "И плод, какъвто изберат,"
  },
  {
    "surah_id": 56,
    "ayah_number": 21,
    "global_ayah_id": 5000,
    "translation": "и птиче месо, каквото обичат."
  },
  {
    "surah_id": 56,
    "ayah_number": 22,
    "global_ayah_id": 5001,
    "translation": "И ще имат хубавици с големи очи,"
  },
  {
    "surah_id": 56,
    "ayah_number": 23,
    "global_ayah_id": 5002,
    "translation": "подобни на скрити бисери -"
  },
  {
    "surah_id": 56,
    "ayah_number": 24,
    "global_ayah_id": 5003,
    "translation": "въздаяние за делата им."
  },
  {
    "surah_id": 56,
    "ayah_number": 25,
    "global_ayah_id": 5004,
    "translation": "Не ще слушат там нито празнословие, нито подбуда към грях,"
  },
  {
    "surah_id": 56,
    "ayah_number": 26,
    "global_ayah_id": 5005,
    "translation": "а само словото: “Мир! Мир!”."
  },
  {
    "surah_id": 56,
    "ayah_number": 27,
    "global_ayah_id": 5006,
    "translation": "А онези отдясно... Какво ще е за онези отдясно?"
  },
  {
    "surah_id": 56,
    "ayah_number": 28,
    "global_ayah_id": 5007,
    "translation": "Сред лотоси без бодли"
  },
  {
    "surah_id": 56,
    "ayah_number": 29,
    "global_ayah_id": 5008,
    "translation": "и натежали бананови дървета,"
  },
  {
    "surah_id": 56,
    "ayah_number": 30,
    "global_ayah_id": 5009,
    "translation": "и просторна сянка,"
  },
  {
    "surah_id": 56,
    "ayah_number": 31,
    "global_ayah_id": 5010,
    "translation": "и лееща се вода,"
  },
  {
    "surah_id": 56,
    "ayah_number": 32,
    "global_ayah_id": 5011,
    "translation": "и обилен плод,"
  },
  {
    "surah_id": 56,
    "ayah_number": 33,
    "global_ayah_id": 5012,
    "translation": "несекващ и невъзбранен,"
  },
  {
    "surah_id": 56,
    "ayah_number": 34,
    "global_ayah_id": 5013,
    "translation": "и въздигнати постели."
  },
  {
    "surah_id": 56,
    "ayah_number": 35,
    "global_ayah_id": 5014,
    "translation": "Сътворихме ги Ние с [прекрасно] сътворяване"
  },
  {
    "surah_id": 56,
    "ayah_number": 36,
    "global_ayah_id": 5015,
    "translation": "и отредихме да са девици"
  },
  {
    "surah_id": 56,
    "ayah_number": 37,
    "global_ayah_id": 5016,
    "translation": "любещи, връстнички -"
  },
  {
    "surah_id": 56,
    "ayah_number": 38,
    "global_ayah_id": 5017,
    "translation": "за онези отдясно -"
  },
  {
    "surah_id": 56,
    "ayah_number": 39,
    "global_ayah_id": 5018,
    "translation": "група от предците"
  },
  {
    "surah_id": 56,
    "ayah_number": 40,
    "global_ayah_id": 5019,
    "translation": "и група от сетните."
  },
  {
    "surah_id": 56,
    "ayah_number": 41,
    "global_ayah_id": 5020,
    "translation": "А онези отляво... Какво ще е за онези отляво?"
  },
  {
    "surah_id": 56,
    "ayah_number": 42,
    "global_ayah_id": 5021,
    "translation": "Сред изгарящ вятър и вряща вода,"
  },
  {
    "surah_id": 56,
    "ayah_number": 43,
    "global_ayah_id": 5022,
    "translation": "и сянка от черен дим,"
  },
  {
    "surah_id": 56,
    "ayah_number": 44,
    "global_ayah_id": 5023,
    "translation": "нито прохладна, нито приятна."
  },
  {
    "surah_id": 56,
    "ayah_number": 45,
    "global_ayah_id": 5024,
    "translation": "Те живееха сред разкош преди това."
  },
  {
    "surah_id": 56,
    "ayah_number": 46,
    "global_ayah_id": 5025,
    "translation": "И упорстваха в огромния грях."
  },
  {
    "surah_id": 56,
    "ayah_number": 47,
    "global_ayah_id": 5026,
    "translation": "И казваха: “Нима като умрем и станем пръст и кости, нима наистина ще бъдем възкресени?"
  },
  {
    "surah_id": 56,
    "ayah_number": 48,
    "global_ayah_id": 5027,
    "translation": "А нима и древните ни предци?”"
  },
  {
    "surah_id": 56,
    "ayah_number": 49,
    "global_ayah_id": 5028,
    "translation": "Кажи [о, Мухаммад]: “И древните, и сетните"
  },
  {
    "surah_id": 56,
    "ayah_number": 50,
    "global_ayah_id": 5029,
    "translation": "наистина ще бъдат събрани по време на знайния Ден.”"
  },
  {
    "surah_id": 56,
    "ayah_number": 51,
    "global_ayah_id": 5030,
    "translation": "После, о, вие, заблудените, отричащите,"
  },
  {
    "surah_id": 56,
    "ayah_number": 52,
    "global_ayah_id": 5031,
    "translation": "наистина ще ядете от дървото Зокум"
  },
  {
    "surah_id": 56,
    "ayah_number": 53,
    "global_ayah_id": 5032,
    "translation": "и ще си пълните от него стомасите,"
  },
  {
    "surah_id": 56,
    "ayah_number": 54,
    "global_ayah_id": 5033,
    "translation": "и ще пиете след това от врящата вода."
  },
  {
    "surah_id": 56,
    "ayah_number": 55,
    "global_ayah_id": 5034,
    "translation": "Ще пиете, както пият прежаднелите камили."
  },
  {
    "surah_id": 56,
    "ayah_number": 56,
    "global_ayah_id": 5035,
    "translation": "Това е угощението им в Съдния ден."
  },
  {
    "surah_id": 56,
    "ayah_number": 57,
    "global_ayah_id": 5036,
    "translation": "Ние ви сътворихме. Защо тогава не повярвате?"
  },
  {
    "surah_id": 56,
    "ayah_number": 58,
    "global_ayah_id": 5037,
    "translation": "Не виждате ли семето, което изливате?"
  },
  {
    "surah_id": 56,
    "ayah_number": 59,
    "global_ayah_id": 5038,
    "translation": "Вие ли го сътворявате, или Ние сме Твореца?"
  },
  {
    "surah_id": 56,
    "ayah_number": 60,
    "global_ayah_id": 5039,
    "translation": "Ние отредихме смъртта за вас и не ще бъдем възпрени"
  },
  {
    "surah_id": 56,
    "ayah_number": 61,
    "global_ayah_id": 5040,
    "translation": "да променим такива като вас и да ви пресъздадем в нещо, което не ви е познато."
  },
  {
    "surah_id": 56,
    "ayah_number": 62,
    "global_ayah_id": 5041,
    "translation": "И узнахте вече първото сътворяване. Не ще ли се поучите?"
  },
  {
    "surah_id": 56,
    "ayah_number": 63,
    "global_ayah_id": 5042,
    "translation": "И не виждате ли какво сеете?"
  },
  {
    "surah_id": 56,
    "ayah_number": 64,
    "global_ayah_id": 5043,
    "translation": "Вие ли го карате да расте, или Ние го караме?"
  },
  {
    "surah_id": 56,
    "ayah_number": 65,
    "global_ayah_id": 5044,
    "translation": "Ако пожелаехме, бихме го сторили на сухи съчки и щяхте да останете слисани:"
  },
  {
    "surah_id": 56,
    "ayah_number": 66,
    "global_ayah_id": 5045,
    "translation": "“Наистина сме задлъжнели."
  },
  {
    "surah_id": 56,
    "ayah_number": 67,
    "global_ayah_id": 5046,
    "translation": "Да, и сме лишени [от прехрана].”"
  },
  {
    "surah_id": 56,
    "ayah_number": 68,
    "global_ayah_id": 5047,
    "translation": "И не виждате ли водата, която пиете?"
  },
  {
    "surah_id": 56,
    "ayah_number": 69,
    "global_ayah_id": 5048,
    "translation": "Вие ли я изсипвате от облака или Ние я изсипваме?"
  },
  {
    "surah_id": 56,
    "ayah_number": 70,
    "global_ayah_id": 5049,
    "translation": "Ако пожелаехме, бихме я сторили солена, защо тогава не сте признателни?"
  },
  {
    "surah_id": 56,
    "ayah_number": 71,
    "global_ayah_id": 5050,
    "translation": "Не виждате ли огъня, който разпалвате?"
  },
  {
    "surah_id": 56,
    "ayah_number": 72,
    "global_ayah_id": 5051,
    "translation": "Вие ли създавате дървото за него, или Ние сме Създателя?"
  },
  {
    "surah_id": 56,
    "ayah_number": 73,
    "global_ayah_id": 5052,
    "translation": "Ние го сторихме за поучение и за ползване от онези, които се нуждаят."
  },
  {
    "surah_id": 56,
    "ayah_number": 74,
    "global_ayah_id": 5053,
    "translation": "Затова прославяй името на твоя Господ, Превеликия!"
  },
  {
    "surah_id": 56,
    "ayah_number": 75,
    "global_ayah_id": 5054,
    "translation": "Но не, кълна се в залезите на звездите -"
  },
  {
    "surah_id": 56,
    "ayah_number": 76,
    "global_ayah_id": 5055,
    "translation": "а това е клетва - ако знаете - велика,"
  },
  {
    "surah_id": 56,
    "ayah_number": 77,
    "global_ayah_id": 5056,
    "translation": "това наистина е свещен Коран"
  },
  {
    "surah_id": 56,
    "ayah_number": 78,
    "global_ayah_id": 5057,
    "translation": "в съхранената Книга [-майка]."
  },
  {
    "surah_id": 56,
    "ayah_number": 79,
    "global_ayah_id": 5058,
    "translation": "Докосват го само пречистените."
  },
  {
    "surah_id": 56,
    "ayah_number": 80,
    "global_ayah_id": 5059,
    "translation": "Низпослание от Господа на световете."
  },
  {
    "surah_id": 56,
    "ayah_number": 81,
    "global_ayah_id": 5060,
    "translation": "Нима това Слово пренебрегвате?"
  },
  {
    "surah_id": 56,
    "ayah_number": 82,
    "global_ayah_id": 5061,
    "translation": "И [вместо благодарност] за препитанието вие го взимате за лъжа?"
  },
  {
    "surah_id": 56,
    "ayah_number": 83,
    "global_ayah_id": 5062,
    "translation": "И когато [душата на умиращия] стигне гърлото,"
  },
  {
    "surah_id": 56,
    "ayah_number": 84,
    "global_ayah_id": 5063,
    "translation": "тогава вие само гледате,"
  },
  {
    "surah_id": 56,
    "ayah_number": 85,
    "global_ayah_id": 5064,
    "translation": "а Ние сме по-близо до него от вас, ала не виждате -"
  },
  {
    "surah_id": 56,
    "ayah_number": 86,
    "global_ayah_id": 5065,
    "translation": "и защо, ако не ще бъдете съдени,"
  },
  {
    "surah_id": 56,
    "ayah_number": 87,
    "global_ayah_id": 5066,
    "translation": "не я върнете обратно, ако говорите истината?"
  },
  {
    "surah_id": 56,
    "ayah_number": 88,
    "global_ayah_id": 5067,
    "translation": "И ако [умиращият] е от приближените [на Аллах],"
  },
  {
    "surah_id": 56,
    "ayah_number": 89,
    "global_ayah_id": 5068,
    "translation": "тогава - покой и удовлетворение, и Градината на блаженството."
  },
  {
    "surah_id": 56,
    "ayah_number": 90,
    "global_ayah_id": 5069,
    "translation": "А ако е от онези отдясно,"
  },
  {
    "surah_id": 56,
    "ayah_number": 91,
    "global_ayah_id": 5070,
    "translation": "тогава [ще му се каже]: “Мир на теб, защото си от онези отдясно!”"
  },
  {
    "surah_id": 56,
    "ayah_number": 92,
    "global_ayah_id": 5071,
    "translation": "А ако е от отричащите, заблудените,"
  },
  {
    "surah_id": 56,
    "ayah_number": 93,
    "global_ayah_id": 5072,
    "translation": "тогава - угощение от вряща вода"
  },
  {
    "surah_id": 56,
    "ayah_number": 94,
    "global_ayah_id": 5073,
    "translation": "и изгаряне в Огъня."
  },
  {
    "surah_id": 56,
    "ayah_number": 95,
    "global_ayah_id": 5074,
    "translation": "Това е достоверната истина."
  },
  {
    "surah_id": 56,
    "ayah_number": 96,
    "global_ayah_id": 5075,
    "translation": "Затова прославяй името на твоя Господ, Превеликия!"
  }
]