[
  {
    "surah_id": 56,
    "ayah_number": 1,
    "global_ayah_id": 4980,
    "translation": "ആ സംഭവം സംഭവിച്ച് കഴിഞ്ഞാല്‍."
  },
  {
    "surah_id": 56,
    "ayah_number": 2,
    "global_ayah_id": 4981,
    "translation": "അതിന്‍റെ സംഭവ്യതയെ നിഷേധിക്കുന്ന ആരും ഉണ്ടായിരിക്കുകയില്ല."
  },
  {
    "surah_id": 56,
    "ayah_number": 3,
    "global_ayah_id": 4982,
    "translation": "(ആ സംഭവം, ചിലരെ) താഴ്ത്തുന്നതും (ചിലരെ) ഉയര്‍ത്തുന്നതുമായിരിക്കും."
  },
  {
    "surah_id": 56,
    "ayah_number": 4,
    "global_ayah_id": 4983,
    "translation": "ഭൂമി കിടുകിടാ വിറപ്പിക്കപ്പെടുകയും,"
  },
  {
    "surah_id": 56,
    "ayah_number": 5,
    "global_ayah_id": 4984,
    "translation": "പര്‍വ്വതങ്ങള്‍ ഇടിച്ച് പൊടിയാക്കപ്പെടുകയും;"
  },
  {
    "surah_id": 56,
    "ayah_number": 6,
    "global_ayah_id": 4985,
    "translation": "അങ്ങനെ അത് പാറിപ്പറക്കുന്ന ധൂളിയായിത്തീരുകയും,"
  },
  {
    "surah_id": 56,
    "ayah_number": 7,
    "global_ayah_id": 4986,
    "translation": "നിങ്ങള്‍ മൂന്ന് തരക്കാരായിത്തീരുകയും ചെയ്യുന്ന സന്ദര്‍ഭമത്രെ അത്‌."
  },
  {
    "surah_id": 56,
    "ayah_number": 8,
    "global_ayah_id": 4987,
    "translation": "അപ്പോള്‍ ഒരു വിഭാഗം വലതുപക്ഷക്കാര്‍. എന്താണ് ഈ വലതുപക്ഷക്കാരുടെ അവസ്ഥ!"
  },
  {
    "surah_id": 56,
    "ayah_number": 9,
    "global_ayah_id": 4988,
    "translation": "മറ്റൊരു വിഭാഗം ഇടതുപക്ഷക്കാര്‍. എന്താണ് ഈ ഇടതുപക്ഷക്കാരുടെ അവസ്ഥ!"
  },
  {
    "surah_id": 56,
    "ayah_number": 10,
    "global_ayah_id": 4989,
    "translation": "(സത്യവിശ്വാസത്തിലും സല്‍പ്രവൃത്തികളിലും) മുന്നേറിയവര്‍ (പരലോകത്തും) മുന്നോക്കക്കാര്‍ തന്നെ."
  },
  {
    "surah_id": 56,
    "ayah_number": 11,
    "global_ayah_id": 4990,
    "translation": "അവരാകുന്നു സാമീപ്യം നല്‍കപ്പെട്ടവര്‍."
  },
  {
    "surah_id": 56,
    "ayah_number": 12,
    "global_ayah_id": 4991,
    "translation": "സുഖാനുഭൂതികളുടെ സ്വര്‍ഗത്തോപ്പുകളില്‍."
  },
  {
    "surah_id": 56,
    "ayah_number": 13,
    "global_ayah_id": 4992,
    "translation": "പൂര്‍വ്വികന്‍മാരില്‍ നിന്ന് ഒരു വിഭാഗവും"
  },
  {
    "surah_id": 56,
    "ayah_number": 14,
    "global_ayah_id": 4993,
    "translation": "പില്‍ക്കാലക്കാരില്‍ നിന്ന് കുറച്ചു പേരുമത്രെ ഇവര്‍."
  },
  {
    "surah_id": 56,
    "ayah_number": 15,
    "global_ayah_id": 4994,
    "translation": "സ്വര്‍ണനൂലുകൊണ്ട് മെടഞ്ഞുണ്ടാക്കപ്പെട്ട കട്ടിലുകളില്‍ ആയിരിക്കും. അവര്‍."
  },
  {
    "surah_id": 56,
    "ayah_number": 16,
    "global_ayah_id": 4995,
    "translation": "അവയില്‍ അവര്‍ പരസ്പരം അഭിമുഖമായി ചാരിയിരിക്കുന്നവരായിരിക്കും."
  },
  {
    "surah_id": 56,
    "ayah_number": 17,
    "global_ayah_id": 4996,
    "translation": "നിത്യജീവിതം നല്‍കപ്പെട്ട ബാലന്‍മാര്‍ അവരുടെ ഇടയില്‍ ചുറ്റി നടക്കും."
  },
  {
    "surah_id": 56,
    "ayah_number": 18,
    "global_ayah_id": 4997,
    "translation": "കോപ്പകളും കൂജകളും ശുദ്ധമായ ഉറവു ജലം നിറച്ച പാനപാത്രവും കൊണ്ട്‌."
  },
  {
    "surah_id": 56,
    "ayah_number": 19,
    "global_ayah_id": 4998,
    "translation": "അതു (കുടിക്കുക) മൂലം അവര്‍ക്ക് തലവേദനയുണ്ടാവുകയോ, ലഹരി ബാധിക്കുകയോ ഇല്ല."
  },
  {
    "surah_id": 56,
    "ayah_number": 20,
    "global_ayah_id": 4999,
    "translation": "അവര്‍ ഇഷ്ടപ്പെട്ടു തെരഞ്ഞെടുക്കുന്ന തരത്തില്‍ പെട്ട പഴവര്‍ഗങ്ങളും."
  },
  {
    "surah_id": 56,
    "ayah_number": 21,
    "global_ayah_id": 5000,
    "translation": "അവര്‍ കൊതിക്കുന്ന തരത്തില്‍ പെട്ട പക്ഷിമാംസവും കൊണ്ട് (അവര്‍ ചുറ്റി നടക്കും.)"
  },
  {
    "surah_id": 56,
    "ayah_number": 22,
    "global_ayah_id": 5001,
    "translation": "വിശാലമായ നയനങ്ങളുള്ള വെളുത്ത തരുണികളും. (അവര്‍ക്കുണ്ട്‌.)"
  },
  {
    "surah_id": 56,
    "ayah_number": 23,
    "global_ayah_id": 5002,
    "translation": "(ചിപ്പികളില്‍) ഒളിച്ചു വെക്കപ്പെട്ട മുത്തുപോലെയുള്ളവര്‍,"
  },
  {
    "surah_id": 56,
    "ayah_number": 24,
    "global_ayah_id": 5003,
    "translation": "അവര്‍ പ്രവര്‍ത്തിച്ച് കൊണ്ടിരുന്നതിനുള്ള പ്രതിഫലമായികൊണ്ടാണ് (അതെല്ലാം നല്‍കപ്പെടുന്നത്‌)"
  },
  {
    "surah_id": 56,
    "ayah_number": 25,
    "global_ayah_id": 5004,
    "translation": "അനാവശ്യവാക്കോ കുറ്റപ്പെടുത്തലോ അവര്‍ അവിടെ വെച്ച് കേള്‍ക്കുകയില്ല."
  },
  {
    "surah_id": 56,
    "ayah_number": 26,
    "global_ayah_id": 5005,
    "translation": "സമാധാനം! സമാധാനം! എന്നുള്ള വാക്കല്ലാതെ."
  },
  {
    "surah_id": 56,
    "ayah_number": 27,
    "global_ayah_id": 5006,
    "translation": "വലതുപക്ഷക്കാര്‍! എന്താണീ വലതുപക്ഷക്കാരുടെ അവസ്ഥ!"
  },
  {
    "surah_id": 56,
    "ayah_number": 28,
    "global_ayah_id": 5007,
    "translation": "മുള്ളിലാത്ത ഇലന്തമരം,"
  },
  {
    "surah_id": 56,
    "ayah_number": 29,
    "global_ayah_id": 5008,
    "translation": "അടുക്കടുക്കായി കുലകളുള്ള വാഴ,"
  },
  {
    "surah_id": 56,
    "ayah_number": 30,
    "global_ayah_id": 5009,
    "translation": "വിശാലമായ തണല്‍,"
  },
  {
    "surah_id": 56,
    "ayah_number": 31,
    "global_ayah_id": 5010,
    "translation": "സദാ ഒഴുക്കപ്പെട്ടു കൊണ്ടിരിക്കുന്ന വെള്ളം,"
  },
  {
    "surah_id": 56,
    "ayah_number": 32,
    "global_ayah_id": 5011,
    "translation": "ധാരാളം പഴവര്‍ഗങ്ങള്‍,"
  },
  {
    "surah_id": 56,
    "ayah_number": 33,
    "global_ayah_id": 5012,
    "translation": "നിലച്ചു പോവാത്തതും തടസ്സപ്പെട്ടുപോവാത്തതുമായ"
  },
  {
    "surah_id": 56,
    "ayah_number": 34,
    "global_ayah_id": 5013,
    "translation": "ഉയര്‍ന്നമെത്തകള്‍ എന്നീ സുഖാനുഭവങ്ങളിലായിരിക്കും അവര്‍."
  },
  {
    "surah_id": 56,
    "ayah_number": 35,
    "global_ayah_id": 5014,
    "translation": "തീര്‍ച്ചയായും അവരെ (സ്വര്‍ഗസ്ത്രീകളെ) നാം ഒരു പ്രത്യേക പ്രകൃതിയോടെ സൃഷ്ടിച്ചുണ്ടാക്കിയിരിക്കുകയാണ്‌."
  },
  {
    "surah_id": 56,
    "ayah_number": 36,
    "global_ayah_id": 5015,
    "translation": "അങ്ങനെ അവരെ നാം കന്യകമാരാക്കിയിരിക്കുന്നു."
  },
  {
    "surah_id": 56,
    "ayah_number": 37,
    "global_ayah_id": 5016,
    "translation": "സ്നേഹവതികളും സമപ്രായക്കാരും ആക്കിയിരിക്കുന്നു."
  },
  {
    "surah_id": 56,
    "ayah_number": 38,
    "global_ayah_id": 5017,
    "translation": "വലതുപക്ഷക്കാര്‍ക്ക് വേണ്ടിയത്രെ അത്‌."
  },
  {
    "surah_id": 56,
    "ayah_number": 39,
    "global_ayah_id": 5018,
    "translation": "പൂര്‍വ്വികന്‍മാരില്‍ നിന്ന് ഒരു വിഭാഗവും"
  },
  {
    "surah_id": 56,
    "ayah_number": 40,
    "global_ayah_id": 5019,
    "translation": "പിന്‍ഗാമികളില്‍ നിന്ന് ഒരു വിഭാഗവും ആയിരിക്കും അവര്‍."
  },
  {
    "surah_id": 56,
    "ayah_number": 41,
    "global_ayah_id": 5020,
    "translation": "ഇടതുപക്ഷക്കാര്‍, എന്താണീ ഇടതുപക്ഷക്കാരുടെ അവസ്ഥ!"
  },
  {
    "surah_id": 56,
    "ayah_number": 42,
    "global_ayah_id": 5021,
    "translation": "തുളച്ചു കയറുന്ന ഉഷ്ണകാറ്റ്‌, ചുട്ടുതിളക്കുന്ന വെള്ളം,"
  },
  {
    "surah_id": 56,
    "ayah_number": 43,
    "global_ayah_id": 5022,
    "translation": "കരിമ്പുകയുടെ തണല്‍"
  },
  {
    "surah_id": 56,
    "ayah_number": 44,
    "global_ayah_id": 5023,
    "translation": "തണുപ്പുള്ളതോ, സുഖദായകമോ അല്ലാത്ത (എന്നീ ദുരിതങ്ങളിലായിരിക്കും അവര്‍.)"
  },
  {
    "surah_id": 56,
    "ayah_number": 45,
    "global_ayah_id": 5024,
    "translation": "എന്തുകൊണ്ടെന്നാല്‍ തീര്‍ച്ചയായും അവര്‍ അതിനു മുമ്പ് സുഖലോലുപന്‍മാരായിരുന്നു."
  },
  {
    "surah_id": 56,
    "ayah_number": 46,
    "global_ayah_id": 5025,
    "translation": "അവര്‍ ഗുരുതരമായ പാപത്തില്‍ ശഠിച്ചുനില്‍ക്കുന്നവരുമായിരുന്നു."
  },
  {
    "surah_id": 56,
    "ayah_number": 47,
    "global_ayah_id": 5026,
    "translation": "അവര്‍ ഇപ്രകാരം പറയുകയും ചെയ്തിരുന്നു: ഞങ്ങള്‍ മരിച്ചിട്ട് മണ്ണും അസ്ഥിശകലങ്ങളുമായിക്കഴിഞ്ഞിട്ടാണോ ഞങ്ങള്‍ ഉയിര്‍ത്തെഴുന്നേല്‍പിക്കപ്പെടാന്‍ പോകുന്നത്‌?"
  },
  {
    "surah_id": 56,
    "ayah_number": 48,
    "global_ayah_id": 5027,
    "translation": "ഞങ്ങളുടെ പൂര്‍വ്വികരായ പിതാക്കളും (ഉയിര്‍ത്തെഴുന്നേല്‍പിക്കപ്പെടുമെന്നോ?)"
  },
  {
    "surah_id": 56,
    "ayah_number": 49,
    "global_ayah_id": 5028,
    "translation": "നീ പറയുക: തീര്‍ച്ചയായും പൂര്‍വ്വികരും പില്‍ക്കാലക്കാരും എല്ലാം-"
  },
  {
    "surah_id": 56,
    "ayah_number": 50,
    "global_ayah_id": 5029,
    "translation": "ഒരു നിശ്ചിത ദിവസത്തെ കൃത്യമായ ഒരു അവധിക്ക് ഒരുമിച്ചുകൂട്ടപ്പെടുന്നവര്‍ തന്നെയാകുന്നു."
  },
  {
    "surah_id": 56,
    "ayah_number": 51,
    "global_ayah_id": 5030,
    "translation": "എന്നിട്ട്‌, ഹേ; സത്യനിഷേധികളായ ദുര്‍മാര്‍ഗികളേ,"
  },
  {
    "surah_id": 56,
    "ayah_number": 52,
    "global_ayah_id": 5031,
    "translation": "തീര്‍ച്ചയായും നിങ്ങള്‍ ഒരു വൃക്ഷത്തില്‍ നിന്ന് അതായത് സഖ്ഖൂമില്‍ നിന്ന് ഭക്ഷിക്കുന്നവരാകുന്നു."
  },
  {
    "surah_id": 56,
    "ayah_number": 53,
    "global_ayah_id": 5032,
    "translation": "അങ്ങനെ അതില്‍ നിന്ന് വയറുകള്‍ നിറക്കുന്നവരും,"
  },
  {
    "surah_id": 56,
    "ayah_number": 54,
    "global_ayah_id": 5033,
    "translation": "അതിന്‍റെ മീതെ തിളച്ചുപൊള്ളുന്ന വെള്ളത്തില്‍ നിന്ന് കുടിക്കുന്നവരുമാകുന്നു."
  },
  {
    "surah_id": 56,
    "ayah_number": 55,
    "global_ayah_id": 5034,
    "translation": "അങ്ങനെ ദാഹിച്ചു വലഞ്ഞ ഒട്ടകം കുടിക്കുന്നപോലെ കുടിക്കുന്നവരാകുന്നു."
  },
  {
    "surah_id": 56,
    "ayah_number": 56,
    "global_ayah_id": 5035,
    "translation": "ഇതായിരിക്കും പ്രതിഫലത്തിന്‍റെ നാളില്‍ അവര്‍ക്കുള്ള സല്‍ക്കാരം."
  },
  {
    "surah_id": 56,
    "ayah_number": 57,
    "global_ayah_id": 5036,
    "translation": "നാമാണ് നിങ്ങളെ സൃഷ്ടിച്ചിരിക്കുന്നത്‌. എന്നിരിക്കെ നിങ്ങളെന്താണ് (എന്‍റെ സന്ദേശങ്ങളെ) സത്യമായി അംഗീകരിക്കാത്തത്‌?"
  },
  {
    "surah_id": 56,
    "ayah_number": 58,
    "global_ayah_id": 5037,
    "translation": "അപ്പോള്‍ നിങ്ങള്‍ സ്രവിക്കുന്ന ശുക്ലത്തെപ്പറ്റി നിങ്ങള്‍ ചിന്തിച്ചു നോക്കിയിട്ടുണ്ടോ?"
  },
  {
    "surah_id": 56,
    "ayah_number": 59,
    "global_ayah_id": 5038,
    "translation": "നിങ്ങളാണോ അത് സൃഷ്ടിച്ചുണ്ടാക്കുന്നത്‌. അതല്ല, നാമാണോ സൃഷ്ടികര്‍ത്താവ്‌?"
  },
  {
    "surah_id": 56,
    "ayah_number": 60,
    "global_ayah_id": 5039,
    "translation": "നാം നിങ്ങള്‍ക്കിടയില്‍ മരണം കണക്കാക്കിയിരിക്കുന്നു. നാം ഒരിക്കലും തോല്‍പിക്കപ്പെടുന്നവനല്ല."
  },
  {
    "surah_id": 56,
    "ayah_number": 61,
    "global_ayah_id": 5040,
    "translation": "(നിങ്ങള്‍ക്കു) പകരം നിങ്ങളെ പോലുള്ളവരെ കൊണ്ടുവരികയും. നിങ്ങള്‍ക്ക് അറിവില്ലാത്ത വിധത്തില്‍ നിങ്ങളെ (വീണ്ടും) സൃഷ്ടിച്ചുണ്ടാക്കുകയും ചെയ്യുന്ന കാര്യത്തില്‍"
  },
  {
    "surah_id": 56,
    "ayah_number": 62,
    "global_ayah_id": 5041,
    "translation": "ആദ്യതവണ സൃഷ്ടിക്കപ്പെട്ടതിനെപ്പറ്റി തീര്‍ച്ചയായും നിങ്ങള്‍ മനസ്സിലാക്കിയിട്ടുണ്ട്‌. എന്നിട്ടും നിങ്ങള്‍ എന്തുകൊണ്ട് ആലോചിച്ചു നോക്കുന്നില്ല."
  },
  {
    "surah_id": 56,
    "ayah_number": 63,
    "global_ayah_id": 5042,
    "translation": "എന്നാല്‍ നിങ്ങള്‍ കൃഷി ചെയ്യുന്നതിനെ പറ്റി നിങ്ങള്‍ ചിന്തിച്ചു നോക്കിയിട്ടുണ്ടോ?"
  },
  {
    "surah_id": 56,
    "ayah_number": 64,
    "global_ayah_id": 5043,
    "translation": "നിങ്ങളാണോ അത് മുളപ്പിച്ചു വളര്‍ത്തുന്നത്‌. അതല്ല നാമാണോ, അത് മുളപ്പിച്ച് വളര്‍ത്തുന്നവന്‍?"
  },
  {
    "surah_id": 56,
    "ayah_number": 65,
    "global_ayah_id": 5044,
    "translation": "നാം ഉദ്ദേശിച്ചിരുന്നെങ്കില്‍ അത് (വിള) നാം തുരുമ്പാക്കിത്തീര്‍ക്കുമായിരുന്നു. അപ്പോള്‍ നിങ്ങള്‍ അതിശയപ്പെട്ടു പറഞ്ഞുകൊണേ്ടയിരിക്കുമായിരന്നു;"
  },
  {
    "surah_id": 56,
    "ayah_number": 66,
    "global_ayah_id": 5045,
    "translation": "തീര്‍ച്ചയായും ഞങ്ങള്‍ കടബാധിതര്‍ തന്നെയാകുന്നു."
  },
  {
    "surah_id": 56,
    "ayah_number": 67,
    "global_ayah_id": 5046,
    "translation": "അല്ല, ഞങ്ങള്‍ (ഉപജീവന മാര്‍ഗം) തടയപ്പെട്ടവരാകുന്നു എന്ന്‌."
  },
  {
    "surah_id": 56,
    "ayah_number": 68,
    "global_ayah_id": 5047,
    "translation": "ഇനി, നിങ്ങള്‍ കുടിക്കുന്ന വെള്ളത്തെപ്പറ്റി നിങ്ങള്‍ ചിന്തിച്ചു നോക്കിയിട്ടുണ്ടോ?"
  },
  {
    "surah_id": 56,
    "ayah_number": 69,
    "global_ayah_id": 5048,
    "translation": "നിങ്ങളാണോ അത് മേഘത്തിന്‍ നിന്ന് ഇറക്കിയത്‌? അതല്ല, നാമാണോ ഇറക്കിയവന്‍?."
  },
  {
    "surah_id": 56,
    "ayah_number": 70,
    "global_ayah_id": 5049,
    "translation": "നാം ഉദ്ദേശിച്ചിരുന്നെങ്കില്‍ അത് നാം ദുസ്സ്വാദുള്ള ഉപ്പുവെള്ളമാക്കുമായിരുന്നു. എന്നിരിക്കെ നിങ്ങള്‍ നന്ദികാണിക്കാത്തതെന്താണ്‌?"
  },
  {
    "surah_id": 56,
    "ayah_number": 71,
    "global_ayah_id": 5050,
    "translation": "നിങ്ങള്‍ ഉരസികത്തിക്കുന്നതായ തീയിനെ പറ്റി നിങ്ങള്‍ ചിന്തിച്ചു നോക്കിയിട്ടുണ്ടോ?"
  },
  {
    "surah_id": 56,
    "ayah_number": 72,
    "global_ayah_id": 5051,
    "translation": "നിങ്ങളാണോ അതിന്‍റെ മരം സൃഷ്ടിച്ചുണ്ടാക്കിയത്‌? അതല്ല നാമാണോ സൃഷ്ടിച്ചുണ്ടാക്കിയവന്‍?"
  },
  {
    "surah_id": 56,
    "ayah_number": 73,
    "global_ayah_id": 5052,
    "translation": "നാം അതിനെ ഒരു ചിന്താവിഷയമാക്കിയിരിക്കുന്നു. ദരിദ്രരായ സഞ്ചാരികള്‍ക്ക് ഒരു ജീവിതസൌകര്യവും."
  },
  {
    "surah_id": 56,
    "ayah_number": 74,
    "global_ayah_id": 5053,
    "translation": "ആകയാല്‍ നിന്‍റെ മഹാനായ രക്ഷിതാവിന്‍റെ നാമത്തെ നീ പ്രകീര്‍ത്തിക്കുക."
  },
  {
    "surah_id": 56,
    "ayah_number": 75,
    "global_ayah_id": 5054,
    "translation": "അല്ല, നക്ഷത്രങ്ങളുടെ അസ്തമന സ്ഥാനങ്ങളെകൊണ്ട് ഞാന്‍ സത്യം ചെയ്തു പറയുന്നു."
  },
  {
    "surah_id": 56,
    "ayah_number": 76,
    "global_ayah_id": 5055,
    "translation": "തീര്‍ച്ചയായും, നിങ്ങള്‍ക്കറിയാമെങ്കില്‍, അതൊരു വമ്പിച്ച സത്യം തന്നെയാണ്‌."
  },
  {
    "surah_id": 56,
    "ayah_number": 77,
    "global_ayah_id": 5056,
    "translation": "തീര്‍ച്ചയായും ഇത് ആദരണീയമായ ഒരു ഖുര്‍ആന്‍ തന്നെയാകുന്നു."
  },
  {
    "surah_id": 56,
    "ayah_number": 78,
    "global_ayah_id": 5057,
    "translation": "ഭദ്രമായി സൂക്ഷിക്കപ്പെട്ട ഒരു രേഖയിലാകുന്നു അത്‌."
  },
  {
    "surah_id": 56,
    "ayah_number": 79,
    "global_ayah_id": 5058,
    "translation": "പരിശുദ്ധി നല്‍കപ്പെട്ടവരല്ലാതെ അത് സ്പര്‍ശിക്കുകയില്ല."
  },
  {
    "surah_id": 56,
    "ayah_number": 80,
    "global_ayah_id": 5059,
    "translation": "ലോകരക്ഷിതാവിങ്കല്‍ നിന്ന് അവതരിപ്പിക്കപ്പെട്ടതത്രെ അത്‌."
  },
  {
    "surah_id": 56,
    "ayah_number": 81,
    "global_ayah_id": 5060,
    "translation": "അപ്പോള്‍ ഈ വര്‍ത്തമാനത്തിന്‍റെ കാര്യത്തിലാണോ നിങ്ങള്‍ പുറംപൂച്ച് കാണിക്കുന്നത്‌?"
  },
  {
    "surah_id": 56,
    "ayah_number": 82,
    "global_ayah_id": 5061,
    "translation": "സത്യത്തെ നിഷേധിക്കുക എന്നത് നിങ്ങള്‍ നിങ്ങളുടെ വിഹിതമാക്കുകയാണോ?"
  },
  {
    "surah_id": 56,
    "ayah_number": 83,
    "global_ayah_id": 5062,
    "translation": "എന്നാല്‍ അത് (ജീവന്‍) തൊണ്ടക്കുഴിയില്‍ എത്തുമ്പോള്‍ എന്തുകൊണ്ടാണ് (നിങ്ങള്‍ക്കത് പിടിച്ചു നിര്‍ത്താനാകാത്തത്‌?)"
  },
  {
    "surah_id": 56,
    "ayah_number": 84,
    "global_ayah_id": 5063,
    "translation": "നിങ്ങള്‍ അന്നേരത്ത് നോക്കിക്കൊണ്ടിരിക്കുമല്ലോ."
  },
  {
    "surah_id": 56,
    "ayah_number": 85,
    "global_ayah_id": 5064,
    "translation": "നാമാണ് ആ വ്യക്തിയെ സംബന്ധിച്ചിടത്തോളം നിങ്ങളെക്കാളും അടുത്തവന്‍. പക്ഷെ നിങ്ങള്‍ കണ്ടറിയുന്നില്ല."
  },
  {
    "surah_id": 56,
    "ayah_number": 86,
    "global_ayah_id": 5065,
    "translation": "അപ്പോള്‍ നിങ്ങള്‍ (ദൈവിക നിയമത്തിന്‌) വിധേയരല്ലാത്തവരാണെങ്കില്‍"
  },
  {
    "surah_id": 56,
    "ayah_number": 87,
    "global_ayah_id": 5066,
    "translation": "നിങ്ങള്‍ക്കെന്തുകൊണ്ട് അത് (ജീവന്‍) മടക്കി എടുക്കാനാവുന്നില്ല; നിങ്ങള്‍ സത്യവാദികളാണെങ്കില്‍."
  },
  {
    "surah_id": 56,
    "ayah_number": 88,
    "global_ayah_id": 5067,
    "translation": "അപ്പോള്‍ അവന്‍ (മരിച്ചവന്‍) സാമീപ്യം സിദ്ധിച്ചവരില്‍ പെട്ടവനാണെങ്കില്‍-"
  },
  {
    "surah_id": 56,
    "ayah_number": 89,
    "global_ayah_id": 5068,
    "translation": "(അവന്ന്‌) ആശ്വാസവും വിശിഷ്ടമായ ഉപജീവനവും സുഖാനുഭൂതിയുടെ സ്വര്‍ഗത്തോപ്പും ഉണ്ടായിരിക്കും."
  },
  {
    "surah_id": 56,
    "ayah_number": 90,
    "global_ayah_id": 5069,
    "translation": "എന്നാല്‍ അവന്‍ വലതുപക്ഷക്കാരില്‍ പെട്ടവനാണെങ്കിലോ,"
  },
  {
    "surah_id": 56,
    "ayah_number": 91,
    "global_ayah_id": 5070,
    "translation": "വലതുപക്ഷക്കാരില്‍പെട്ട നിനക്ക് സമാധാനം എന്നായിരിക്കും (അവന്നു ലഭിക്കുന്ന അഭിവാദ്യം)"
  },
  {
    "surah_id": 56,
    "ayah_number": 92,
    "global_ayah_id": 5071,
    "translation": "ഇനി അവന്‍ ദുര്‍മാര്‍ഗികളായ സത്യനിഷേധികളില്‍ പെട്ടവനാണെങ്കിലോ,"
  },
  {
    "surah_id": 56,
    "ayah_number": 93,
    "global_ayah_id": 5072,
    "translation": "ചുട്ടുതിളക്കുന്ന വെള്ളം കൊണ്ടുള്ള സല്‍ക്കാരവും"
  },
  {
    "surah_id": 56,
    "ayah_number": 94,
    "global_ayah_id": 5073,
    "translation": "നരകത്തില്‍ വെച്ചുള്ള ചുട്ടെരിക്കലുമാണ്‌. (അവന്നുള്ളത്‌.)"
  },
  {
    "surah_id": 56,
    "ayah_number": 95,
    "global_ayah_id": 5074,
    "translation": "തീര്‍ച്ചയായും ഇതു തന്നെയാണ് ഉറപ്പുള്ള യാഥാര്‍ത്ഥ്യം."
  },
  {
    "surah_id": 56,
    "ayah_number": 96,
    "global_ayah_id": 5075,
    "translation": "ആകയാല്‍ നീ നിന്‍റെ മഹാനായ രക്ഷിതാവിന്‍റെ നാമം പ്രകീര്‍ത്തിക്കുക."
  }
]