[
  {
    "surah_id": 56,
    "ayah_number": 1,
    "global_ayah_id": 4980,
    "translation": "መከራይቱ በወደቀች ጊዜ፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 2,
    "global_ayah_id": 4981,
    "translation": "ለመውደቋ አስተባባይ (ነፍስ) የለችም፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 3,
    "global_ayah_id": 4982,
    "translation": "ዝቅ አድራጊና ከፍ አድራጊ ናት፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 4,
    "global_ayah_id": 4983,
    "translation": "ምድር መናወጥን በተናወጠች ጊዜ፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 5,
    "global_ayah_id": 4984,
    "translation": "ተራራዎችም መፍፈርፈርን በተፈረፈሩ ጊዜ (እንደተፈጨ ዱቄት በኾኑ ጊዜ)፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 6,
    "global_ayah_id": 4985,
    "translation": "የተበተነ ብናኝ በኾኑም ጊዜ"
  },
  {
    "surah_id": 56,
    "ayah_number": 7,
    "global_ayah_id": 4986,
    "translation": "ሦስት ዓይነቶችም በኾናችሁ ጊዜ (ታዋርዳለች፤ ታነሳለችም)፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 8,
    "global_ayah_id": 4987,
    "translation": "የቀኝ ጓዶችም ምን (የተከበሩ) የቀኝ ጓዶች ናቸው፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 9,
    "global_ayah_id": 4988,
    "translation": "የግራ ጓዶችም ምን (የተዋረዱ) የግራ ጓዶች ናቸው፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 10,
    "global_ayah_id": 4989,
    "translation": "(ለበጎ ሥራ) ቀዳሚዎቹም (ለገነት) ቀዳሚዎች ናቸው፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 11,
    "global_ayah_id": 4990,
    "translation": "እነዚያ ባለሟሎቹ ናቸው፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 12,
    "global_ayah_id": 4991,
    "translation": "በመጠቀሚያ ገነቶች ውስጥ ሲኾኑ፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 13,
    "global_ayah_id": 4992,
    "translation": "ከፊተኞቹ ብዙ ጭፍሮች ናቸው፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 14,
    "global_ayah_id": 4993,
    "translation": "ከኋለኞቹም ጥቂቶች ናቸው፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 15,
    "global_ayah_id": 4994,
    "translation": "በተታቱ አልጋዎች ላይ ይኾናሉ፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 16,
    "global_ayah_id": 4995,
    "translation": "በእርሷ ላይ የተመቻቹና ፊት ለፊት የተቅጣጩ ሲኾኑ፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 17,
    "global_ayah_id": 4996,
    "translation": "በእነርሱ ላይ ሁል ጊዜ የማያረጁ ወጣቶች ልጆች ይዘዋወራሉ፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 18,
    "global_ayah_id": 4997,
    "translation": "ከጠጅ ምንጭም በብርጭቆዎችና በኩስኩስቶች በጽዋም (በእነርሱ ላይ ይዝዞራሉ)፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 19,
    "global_ayah_id": 4998,
    "translation": "ከእርሷ የራስ ምታት አያገኛቸውም፤ አይሰክሩምም፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 20,
    "global_ayah_id": 4999,
    "translation": "ከሚመርጡትም ዓይነት በእሸቶች፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 21,
    "global_ayah_id": 5000,
    "translation": "ከሚሹትም በኾነ የበራሪ ሥጋ (ይዞሩባቸዋል)፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 22,
    "global_ayah_id": 5001,
    "translation": "ዓይናማዎች የኾኑ ነጫጭ ቆንጆዎችም አሏቸው፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 23,
    "global_ayah_id": 5002,
    "translation": "ልክ እንደተሸፈነ ሉል መሰሎች የኾኑ፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 24,
    "global_ayah_id": 5003,
    "translation": "በዚያ ይሠሩት በነበሩት ምክንያት ዋጋ ይኾን ዘንድ (ይህንን አደረግንላቸው)፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 25,
    "global_ayah_id": 5004,
    "translation": "በውስጥዋ ውድቅ ንግግርንና መውወንጀልን አይሰሙም፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 26,
    "global_ayah_id": 5005,
    "translation": "ግን ሰላም መባባልን (ይሰማሉ)፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 27,
    "global_ayah_id": 5006,
    "translation": "የቀኝም ጓዶች ምንኛ (የከበሩ) የቀኝ ጓዶች!"
  },
  {
    "surah_id": 56,
    "ayah_number": 28,
    "global_ayah_id": 5007,
    "translation": "በተቀፈቀፈ (እሾህ በሌለው) ቁርቁራ ውስጥ ናቸው፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 29,
    "global_ayah_id": 5008,
    "translation": "(ፍሬው) በተነባበረ በሙዝ ዛፍም፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 30,
    "global_ayah_id": 5009,
    "translation": "በተዘረጋ ጥላ ሥርም፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 31,
    "global_ayah_id": 5010,
    "translation": "በሚንቧቧ ውሃ አጠገብም፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 32,
    "global_ayah_id": 5011,
    "translation": "ብዙ (ዓይነት) በኾኑ ፍራፍሬዎችም፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 33,
    "global_ayah_id": 5012,
    "translation": "የማትቋረጥም የማትከለከልም የኾነች፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 34,
    "global_ayah_id": 5013,
    "translation": "ከፍ በተደረጉ ምንጣፎችም (ሴቶችም መካከል)፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 35,
    "global_ayah_id": 5014,
    "translation": "እኛ አዲስ ፍጥረት አድርገን (ለእነርሱ) ፈጠርናቸው፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 36,
    "global_ayah_id": 5015,
    "translation": "ደናግሎችም አደረግናቸው፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 37,
    "global_ayah_id": 5016,
    "translation": "ለባሎቻቸው ተሽሞርሟሪዎች እኩያዎች (አደረግናቸው)፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 38,
    "global_ayah_id": 5017,
    "translation": "ለቀኝ ጓዶች (አዘጋጀናቸው)፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 39,
    "global_ayah_id": 5018,
    "translation": "ከፊተኞቹ ብዙ ጭፍሮች ናቸው፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 40,
    "global_ayah_id": 5019,
    "translation": "ከኋለኞቹም ብዙ ጭፍሮች ናቸው፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 41,
    "global_ayah_id": 5020,
    "translation": "የግራ ጓደኞችም ምንኛ (የተዋረዱ) የግራ ጓዶች! ናቸው፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 42,
    "global_ayah_id": 5021,
    "translation": "በመርዛም ነፋስ በጣም በፈላ ውሃም ውስጥ ናቸው፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 43,
    "global_ayah_id": 5022,
    "translation": "ከጥቁር ጭስም በኾነ ጥላ ውስጥ፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 44,
    "global_ayah_id": 5023,
    "translation": "ቀዝቃዛም መልካምም ያልኾነ፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 45,
    "global_ayah_id": 5024,
    "translation": "እነርሱ ከዚህ በፊት ቅምጥሎች ነበሩና፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 46,
    "global_ayah_id": 5025,
    "translation": "በታላቅ ኀጢአትም ላይ ይዘወትሩ ነበሩና፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 47,
    "global_ayah_id": 5026,
    "translation": "ይሉም ነበሩ፡- «በሞትንና ዐፈር፣ ዐጥንቶችም በኾን ጊዜ እኛ በእርግጥ የምንቀሰቀስ ነን?"
  },
  {
    "surah_id": 56,
    "ayah_number": 48,
    "global_ayah_id": 5027,
    "translation": "«የፊተኞቹ አባቶቻችንም?»"
  },
  {
    "surah_id": 56,
    "ayah_number": 49,
    "global_ayah_id": 5028,
    "translation": "በላቸው፡- «ፊተኞቹም ኋለኞቹም፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 50,
    "global_ayah_id": 5029,
    "translation": "«በተወሰነ ቀን ቀጠሮ በእርግጥ ተሰብሳቢዎች ናቸው፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 51,
    "global_ayah_id": 5030,
    "translation": "«ከዚያም እናንተ ጠማሞች አስተባባዮች ሆይ!"
  },
  {
    "surah_id": 56,
    "ayah_number": 52,
    "global_ayah_id": 5031,
    "translation": "« ከዘቁም ዛፍ በእርግጥ በይዎች ናችሁ፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 53,
    "global_ayah_id": 5032,
    "translation": "«ከእርሷም ሆዶቻችሁን ሞይዎች ናችሁ፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 54,
    "global_ayah_id": 5033,
    "translation": "«በእርሱ ላይም ከፈላ ውሃ ጠጪዎች ናችሁ፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 55,
    "global_ayah_id": 5034,
    "translation": "«የተጠሙንም ግመሎች አጠጣጥ ብጤ ጠጪዎች ናችሁ፡፡»"
  },
  {
    "surah_id": 56,
    "ayah_number": 56,
    "global_ayah_id": 5035,
    "translation": "ይህ በፍርዱ ቀን መስተንግዷቸው ነው፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 57,
    "global_ayah_id": 5036,
    "translation": "እኛ ፈጠርናችሁ አታምኑምን?"
  },
  {
    "surah_id": 56,
    "ayah_number": 58,
    "global_ayah_id": 5037,
    "translation": "(በማኅፀኖች) የምታፈሱትን አያችሁን?"
  },
  {
    "surah_id": 56,
    "ayah_number": 59,
    "global_ayah_id": 5038,
    "translation": "እናንተ ትፈጥሩታላችሁን? ወይስ እኛ ፈጣሪዎቹን ነን?"
  },
  {
    "surah_id": 56,
    "ayah_number": 60,
    "global_ayah_id": 5039,
    "translation": "እኛ ሞትን (ጊዜውን) በመካከላችሁ ወሰንን፡፡ እኛም ተሸናፊዎች አይደለንም፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 61,
    "global_ayah_id": 5040,
    "translation": "ብጤዎቻችሁን በመለወጥና በዚያ በማታውቁትም (ቅርጽ) እናንተን በመፍጠር ላይ (አንሸነፍም)፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 62,
    "global_ayah_id": 5041,
    "translation": "የፊተኛይቱንም አፈጣጠር በእርግጥ ዐውቃችኋል፡፡ አትገነዘቡምን?"
  },
  {
    "surah_id": 56,
    "ayah_number": 63,
    "global_ayah_id": 5042,
    "translation": "የምትዘሩትንም አያችሁን?"
  },
  {
    "surah_id": 56,
    "ayah_number": 64,
    "global_ayah_id": 5043,
    "translation": "እናንተ ታበቅሉታላችሁን? ወይስ እኛ አብቃዮቹ ነን?"
  },
  {
    "surah_id": 56,
    "ayah_number": 65,
    "global_ayah_id": 5044,
    "translation": "ብነሻ ኖሮ ደረቅ ስብርብር ባደረግነውና የምትደነቁም በኾናችሁ ነበር፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 66,
    "global_ayah_id": 5045,
    "translation": "«እኛ በዕዳ ተያዦች ነን፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 67,
    "global_ayah_id": 5046,
    "translation": "«በእርግጥም እኛ (ከመጠቀም) የተከለከልን ነን» (ትሉ ነበር)፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 68,
    "global_ayah_id": 5047,
    "translation": "ያንንም የምትጠጡትን ውሃ አየችሁን?"
  },
  {
    "surah_id": 56,
    "ayah_number": 69,
    "global_ayah_id": 5048,
    "translation": "እናንተ ከደመናው አወረዳችሁትን? ወይስ እኛ አውራጆቹ ነን?"
  },
  {
    "surah_id": 56,
    "ayah_number": 70,
    "global_ayah_id": 5049,
    "translation": "ብንሻ ኖሮ መርጋጋ ባደረግነው ነበር፡፡ አታመሰግኑምን?"
  },
  {
    "surah_id": 56,
    "ayah_number": 71,
    "global_ayah_id": 5050,
    "translation": "ያቺንም የምትሰብቋትን እሳት አያችሁን?"
  },
  {
    "surah_id": 56,
    "ayah_number": 72,
    "global_ayah_id": 5051,
    "translation": "እናንተ ዛፏን ፈጠራችሁን? ወይስ እኛ ፈጣሪዎችዋ ነን?"
  },
  {
    "surah_id": 56,
    "ayah_number": 73,
    "global_ayah_id": 5052,
    "translation": "እኛ (ለገሀናም) ማስታወሻ ለመንገደኞችም መጠቀሚያ አደረግናት፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 74,
    "global_ayah_id": 5053,
    "translation": "የታላቁን ጌታህንም ስም አወድስ፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 75,
    "global_ayah_id": 5054,
    "translation": "በከዋክብትም መጥለቂያዎች እምላለሁ፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 76,
    "global_ayah_id": 5055,
    "translation": "እርሱም ብታወቁ ታላቅ መሓላ ነው፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 77,
    "global_ayah_id": 5056,
    "translation": "እርሱ የከበረ ቁርኣን ነው፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 78,
    "global_ayah_id": 5057,
    "translation": "በተጠበቀ መጽሐፍ ውስጥ ነው፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 79,
    "global_ayah_id": 5058,
    "translation": "የተጥራሩት እንጅ ሌላ አይነካውም፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 80,
    "global_ayah_id": 5059,
    "translation": "ከዓለማት ጌታ የተወረደ ነው፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 81,
    "global_ayah_id": 5060,
    "translation": "በዚህ ንግግር እናንተ ቸልተኞች ናችሁን?"
  },
  {
    "surah_id": 56,
    "ayah_number": 82,
    "global_ayah_id": 5061,
    "translation": "ሲሳያችሁንም (ዝናምን) እናንተ የምታስተባብሉት ታደርጋላችሁን?"
  },
  {
    "surah_id": 56,
    "ayah_number": 83,
    "global_ayah_id": 5062,
    "translation": "(ነፍስ) ጉረሮንም በደረሰች ጊዜ፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 84,
    "global_ayah_id": 5063,
    "translation": "እናንተ ያን ጊዜ የምታዩ ስትኾኑ፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 85,
    "global_ayah_id": 5064,
    "translation": "እኛም ግን አታዩም እንጅ ከእናንተ ይልቅ ወደእርሱ የቀረብን ስንኾን፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 86,
    "global_ayah_id": 5065,
    "translation": "የማትዳኙም ከኾናችሁ፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 87,
    "global_ayah_id": 5066,
    "translation": "እውነተኞች እንደ ኾናችሁ (ነፍሲቱን ወደ አካሉ) ለምን አትመልሷትም፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 88,
    "global_ayah_id": 5067,
    "translation": "(ሟቹ) ከባለሟሎቹ ቢኾንማ፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 89,
    "global_ayah_id": 5068,
    "translation": "(ለእርሱ) ዕረፍት፣ መልካም ሲሳይም፣ የመጠቀሚያ ገነትም አልለው፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 90,
    "global_ayah_id": 5069,
    "translation": "ከቀኝ ጓዶችም ቢኾንማ፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 91,
    "global_ayah_id": 5070,
    "translation": "ከቀኝ ጓዶች ስለ ኾንክ ላንተ ሰላም አልለህ (ይባላል)፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 92,
    "global_ayah_id": 5071,
    "translation": "ከሚያስዋሹት ጠማማዎችም ቢኾንማ፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 93,
    "global_ayah_id": 5072,
    "translation": "ከፈላ ውሃ የኾነ መስተንግዶ አልለው፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 94,
    "global_ayah_id": 5073,
    "translation": "በገሀነም መቃጠልም (አልለው)፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 95,
    "global_ayah_id": 5074,
    "translation": "ይህ እርሱ እርግጠኛ እውነት ነው፡፡"
  },
  {
    "surah_id": 56,
    "ayah_number": 96,
    "global_ayah_id": 5075,
    "translation": "የታላቁንም ጌታህን ስም አወድስ፡፡"
  }
]