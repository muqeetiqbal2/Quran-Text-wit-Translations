[
  {
    "surah_id": 37,
    "ayah_number": 1,
    "global_ayah_id": 3789,
    "translation": "以列班者發誓，"
  },
  {
    "surah_id": 37,
    "ayah_number": 2,
    "global_ayah_id": 3790,
    "translation": "以驅策者發誓，"
  },
  {
    "surah_id": 37,
    "ayah_number": 3,
    "global_ayah_id": 3791,
    "translation": "以誦讀教誨者發誓，"
  },
  {
    "surah_id": 37,
    "ayah_number": 4,
    "global_ayah_id": 3792,
    "translation": "你們所當崇拜者，確是獨一的，"
  },
  {
    "surah_id": 37,
    "ayah_number": 5,
    "global_ayah_id": 3793,
    "translation": "他是天地萬物之主，是一切東方的主。"
  },
  {
    "surah_id": 37,
    "ayah_number": 6,
    "global_ayah_id": 3794,
    "translation": "我確已用文采即繁星點綴最近的天，"
  },
  {
    "surah_id": 37,
    "ayah_number": 7,
    "global_ayah_id": 3795,
    "translation": "我對一切叛逆的惡魔保護它，"
  },
  {
    "surah_id": 37,
    "ayah_number": 8,
    "global_ayah_id": 3796,
    "translation": "他們不得竊聽上界的眾天神，他們自各方被射擊，"
  },
  {
    "surah_id": 37,
    "ayah_number": 9,
    "global_ayah_id": 3797,
    "translation": "被驅逐，他們將受永久的刑罰。"
  },
  {
    "surah_id": 37,
    "ayah_number": 10,
    "global_ayah_id": 3798,
    "translation": "但竊聽一次的，燦爛的流星就追趕上他。"
  },
  {
    "surah_id": 37,
    "ayah_number": 11,
    "global_ayah_id": 3799,
    "translation": "你問他們吧！究竟是他們更難造呢？還是我所創造的更難造呢？我確已用黏泥創造了他們。"
  },
  {
    "surah_id": 37,
    "ayah_number": 12,
    "global_ayah_id": 3800,
    "translation": "不然！你感到驚奇，而他們卻嘲笑你。"
  },
  {
    "surah_id": 37,
    "ayah_number": 13,
    "global_ayah_id": 3801,
    "translation": "他們雖聞教誨，卻不覺悟。"
  },
  {
    "surah_id": 37,
    "ayah_number": 14,
    "global_ayah_id": 3802,
    "translation": "他們雖見蹟象，卻加以嘲笑。"
  },
  {
    "surah_id": 37,
    "ayah_number": 15,
    "global_ayah_id": 3803,
    "translation": "他們說：「這個只是明顯的魔術。"
  },
  {
    "surah_id": 37,
    "ayah_number": 16,
    "global_ayah_id": 3804,
    "translation": "難道我們死後，已變為塵土和朽骨的時候，必定復活嗎？"
  },
  {
    "surah_id": 37,
    "ayah_number": 17,
    "global_ayah_id": 3805,
    "translation": "連我們的祖先，也要復活嗎？」"
  },
  {
    "surah_id": 37,
    "ayah_number": 18,
    "global_ayah_id": 3806,
    "translation": "你說：「是的！你們都要卑賤地復活。」"
  },
  {
    "surah_id": 37,
    "ayah_number": 19,
    "global_ayah_id": 3807,
    "translation": "才聽見一聲吶喊，他們就瞻望著，"
  },
  {
    "surah_id": 37,
    "ayah_number": 20,
    "global_ayah_id": 3808,
    "translation": "他們說：「傷哉我們！這就是報應之日。」"
  },
  {
    "surah_id": 37,
    "ayah_number": 21,
    "global_ayah_id": 3809,
    "translation": "這就是你們所否認的判決之日。"
  },
  {
    "surah_id": 37,
    "ayah_number": 22,
    "global_ayah_id": 3810,
    "translation": "你們應當集合不義者和他們的伴侶，以及他們捨真主而崇拜的，"
  },
  {
    "surah_id": 37,
    "ayah_number": 23,
    "global_ayah_id": 3811,
    "translation": "然後指示他們火獄的道路，"
  },
  {
    "surah_id": 37,
    "ayah_number": 24,
    "global_ayah_id": 3812,
    "translation": "並攔住他們，因為他們的確要受審問。"
  },
  {
    "surah_id": 37,
    "ayah_number": 25,
    "global_ayah_id": 3813,
    "translation": "你們怎麼不互助呢？"
  },
  {
    "surah_id": 37,
    "ayah_number": 26,
    "global_ayah_id": 3814,
    "translation": "不然！他們在今日是歸順的。"
  },
  {
    "surah_id": 37,
    "ayah_number": 27,
    "global_ayah_id": 3815,
    "translation": "於是他們大家走向前來，互相談論，"
  },
  {
    "surah_id": 37,
    "ayah_number": 28,
    "global_ayah_id": 3816,
    "translation": "這些人說：「你們確已用權力脅迫我們。」"
  },
  {
    "surah_id": 37,
    "ayah_number": 29,
    "global_ayah_id": 3817,
    "translation": "那些人說：「不然！你們自己原來不是信道者，"
  },
  {
    "surah_id": 37,
    "ayah_number": 30,
    "global_ayah_id": 3818,
    "translation": "我們對你們絕無權力。不然！你們是悖逆的民眾。"
  },
  {
    "surah_id": 37,
    "ayah_number": 31,
    "global_ayah_id": 3819,
    "translation": "故我們應當受我們的主的判決，我們確是嘗試的。"
  },
  {
    "surah_id": 37,
    "ayah_number": 32,
    "global_ayah_id": 3820,
    "translation": "所以我們使你們迷誤，我們自己也確是迷誤的。」"
  },
  {
    "surah_id": 37,
    "ayah_number": 33,
    "global_ayah_id": 3821,
    "translation": "在那日，他們必定同受刑罰。"
  },
  {
    "surah_id": 37,
    "ayah_number": 34,
    "global_ayah_id": 3822,
    "translation": "我必定這樣對待犯罪者。"
  },
  {
    "surah_id": 37,
    "ayah_number": 35,
    "global_ayah_id": 3823,
    "translation": "他們確是這樣的：有人對他們說：「除真主外，絕無應受崇拜的」，他們就妄自尊大，"
  },
  {
    "surah_id": 37,
    "ayah_number": 36,
    "global_ayah_id": 3824,
    "translation": "並且說：「難道我們務必要為一個狂妄的詩人，而拋棄我們的眾神靈嗎？」"
  },
  {
    "surah_id": 37,
    "ayah_number": 37,
    "global_ayah_id": 3825,
    "translation": "不然！他昭示了真理，並証實了歷代的使者。"
  },
  {
    "surah_id": 37,
    "ayah_number": 38,
    "global_ayah_id": 3826,
    "translation": "你們必定嘗試痛苦的刑罰，"
  },
  {
    "surah_id": 37,
    "ayah_number": 39,
    "global_ayah_id": 3827,
    "translation": "你們只依自己的行為而受報酬。"
  },
  {
    "surah_id": 37,
    "ayah_number": 40,
    "global_ayah_id": 3828,
    "translation": "惟真主的虔誠的眾僕，"
  },
  {
    "surah_id": 37,
    "ayah_number": 41,
    "global_ayah_id": 3829,
    "translation": "將享受一種可知的給養——"
  },
  {
    "surah_id": 37,
    "ayah_number": 42,
    "global_ayah_id": 3830,
    "translation": "各種水果，同時他們是受優待的；"
  },
  {
    "surah_id": 37,
    "ayah_number": 43,
    "global_ayah_id": 3831,
    "translation": "他們在恩澤的樂園中，"
  },
  {
    "surah_id": 37,
    "ayah_number": 44,
    "global_ayah_id": 3832,
    "translation": "他們坐在床上，彼此相對；"
  },
  {
    "surah_id": 37,
    "ayah_number": 45,
    "global_ayah_id": 3833,
    "translation": "有人以杯子在他們之間挨次傳遞，杯中滿盛醴泉，"
  },
  {
    "surah_id": 37,
    "ayah_number": 46,
    "global_ayah_id": 3834,
    "translation": "顏色潔白，飲者無不稱為美味；"
  },
  {
    "surah_id": 37,
    "ayah_number": 47,
    "global_ayah_id": 3835,
    "translation": "醴泉中無麻醉物，他們也不因它而酩酊；"
  },
  {
    "surah_id": 37,
    "ayah_number": 48,
    "global_ayah_id": 3836,
    "translation": "他們將有不視非禮的、美目的伴侶，"
  },
  {
    "surah_id": 37,
    "ayah_number": 49,
    "global_ayah_id": 3837,
    "translation": "她們彷彿被珍藏的鴕卵樣；"
  },
  {
    "surah_id": 37,
    "ayah_number": 50,
    "global_ayah_id": 3838,
    "translation": "於是他們走向前來，互相談論。"
  },
  {
    "surah_id": 37,
    "ayah_number": 51,
    "global_ayah_id": 3839,
    "translation": "他們中有一個人說：「我有一個朋友，"
  },
  {
    "surah_id": 37,
    "ayah_number": 52,
    "global_ayah_id": 3840,
    "translation": "他問我：『你確是誠信的嗎？"
  },
  {
    "surah_id": 37,
    "ayah_number": 53,
    "global_ayah_id": 3841,
    "translation": "難道我們死後，已變為塵土和朽骨的時候，還必定要受報酬嗎？』」"
  },
  {
    "surah_id": 37,
    "ayah_number": 54,
    "global_ayah_id": 3842,
    "translation": "他說：「你們願看他嗎？」"
  },
  {
    "surah_id": 37,
    "ayah_number": 55,
    "global_ayah_id": 3843,
    "translation": "他俯視下面，就看見他在火獄的中央，"
  },
  {
    "surah_id": 37,
    "ayah_number": 56,
    "global_ayah_id": 3844,
    "translation": "他說：「以真主發誓，你的確幾乎陷害了我。"
  },
  {
    "surah_id": 37,
    "ayah_number": 57,
    "global_ayah_id": 3845,
    "translation": "如果沒有我的主的恩惠，我必在被拘禁者之列。"
  },
  {
    "surah_id": 37,
    "ayah_number": 58,
    "global_ayah_id": 3846,
    "translation": "我們不是再死的嗎？"
  },
  {
    "surah_id": 37,
    "ayah_number": 59,
    "global_ayah_id": 3847,
    "translation": "唯有我們初次的死亡，而我們絕不會受懲罰嗎？"
  },
  {
    "surah_id": 37,
    "ayah_number": 60,
    "global_ayah_id": 3848,
    "translation": "這確是偉大的成功，"
  },
  {
    "surah_id": 37,
    "ayah_number": 61,
    "global_ayah_id": 3849,
    "translation": "工作者應當為獲得這樣的成功而工作。」"
  },
  {
    "surah_id": 37,
    "ayah_number": 62,
    "global_ayah_id": 3850,
    "translation": "那是更善的款待呢？還是欑楛樹？"
  },
  {
    "surah_id": 37,
    "ayah_number": 63,
    "global_ayah_id": 3851,
    "translation": "我以它為不義者的折磨。"
  },
  {
    "surah_id": 37,
    "ayah_number": 64,
    "global_ayah_id": 3852,
    "translation": "它是在火獄底生長的一棵樹，"
  },
  {
    "surah_id": 37,
    "ayah_number": 65,
    "global_ayah_id": 3853,
    "translation": "它的花篦，彷彿魔頭。"
  },
  {
    "surah_id": 37,
    "ayah_number": 66,
    "global_ayah_id": 3854,
    "translation": "他們必定要吃那些果實，而以它充實肚腹。"
  },
  {
    "surah_id": 37,
    "ayah_number": 67,
    "global_ayah_id": 3855,
    "translation": "然後他們必定要在那些果實上加飲沸水的混湯，"
  },
  {
    "surah_id": 37,
    "ayah_number": 68,
    "global_ayah_id": 3856,
    "translation": "然後他們必定要歸於火獄。"
  },
  {
    "surah_id": 37,
    "ayah_number": 69,
    "global_ayah_id": 3857,
    "translation": "他們必定會發現他們的祖先是迷誤的，"
  },
  {
    "surah_id": 37,
    "ayah_number": 70,
    "global_ayah_id": 3858,
    "translation": "他們卻依著他們的蹤跡而奔馳。"
  },
  {
    "surah_id": 37,
    "ayah_number": 71,
    "global_ayah_id": 3859,
    "translation": "在他們之前，大半的古人確已迷誤了。"
  },
  {
    "surah_id": 37,
    "ayah_number": 72,
    "global_ayah_id": 3860,
    "translation": "我在他們之間，確已派遣過許多警告者。"
  },
  {
    "surah_id": 37,
    "ayah_number": 73,
    "global_ayah_id": 3861,
    "translation": "你看！被警告者的結局是怎樣的？"
  },
  {
    "surah_id": 37,
    "ayah_number": 74,
    "global_ayah_id": 3862,
    "translation": "除非真主的純潔的僕人們。"
  },
  {
    "surah_id": 37,
    "ayah_number": 75,
    "global_ayah_id": 3863,
    "translation": "努哈確已向我祈禱，我是最善於應答的！"
  },
  {
    "surah_id": 37,
    "ayah_number": 76,
    "global_ayah_id": 3864,
    "translation": "我拯救他和他的信徒們脫離大難。"
  },
  {
    "surah_id": 37,
    "ayah_number": 77,
    "global_ayah_id": 3865,
    "translation": "我只使他的子孫得以生存。"
  },
  {
    "surah_id": 37,
    "ayah_number": 78,
    "global_ayah_id": 3866,
    "translation": "我使他的令名，永存於後代。"
  },
  {
    "surah_id": 37,
    "ayah_number": 79,
    "global_ayah_id": 3867,
    "translation": "在各民族中，都有人說：「祝努哈平安！」"
  },
  {
    "surah_id": 37,
    "ayah_number": 80,
    "global_ayah_id": 3868,
    "translation": "我必定要這樣報酬行善者們。"
  },
  {
    "surah_id": 37,
    "ayah_number": 81,
    "global_ayah_id": 3869,
    "translation": "他確是我的信道的僕人。"
  },
  {
    "surah_id": 37,
    "ayah_number": 82,
    "global_ayah_id": 3870,
    "translation": "然後，我使別的人淹死。"
  },
  {
    "surah_id": 37,
    "ayah_number": 83,
    "global_ayah_id": 3871,
    "translation": "他的宗派中，確有易卜拉欣。"
  },
  {
    "surah_id": 37,
    "ayah_number": 84,
    "global_ayah_id": 3872,
    "translation": "當時，他帶著健全的心靈，來見他的主。"
  },
  {
    "surah_id": 37,
    "ayah_number": 85,
    "global_ayah_id": 3873,
    "translation": "當時，他對他的父親和宗族說：「你們崇拜甚麼？"
  },
  {
    "surah_id": 37,
    "ayah_number": 86,
    "global_ayah_id": 3874,
    "translation": "難道你們欲捨真主而悖謬地崇拜許多神靈嗎？"
  },
  {
    "surah_id": 37,
    "ayah_number": 87,
    "global_ayah_id": 3875,
    "translation": "你們對全世界的主，究竟作甚麼猜測？」"
  },
  {
    "surah_id": 37,
    "ayah_number": 88,
    "global_ayah_id": 3876,
    "translation": "他看一看星宿，"
  },
  {
    "surah_id": 37,
    "ayah_number": 89,
    "global_ayah_id": 3877,
    "translation": "然後說：「我勢必要害病。」"
  },
  {
    "surah_id": 37,
    "ayah_number": 90,
    "global_ayah_id": 3878,
    "translation": "他們就背離了他，"
  },
  {
    "surah_id": 37,
    "ayah_number": 91,
    "global_ayah_id": 3879,
    "translation": "他就俏悄地走向他們的眾神靈，他說：「你們怎麼不吃東西呢？"
  },
  {
    "surah_id": 37,
    "ayah_number": 92,
    "global_ayah_id": 3880,
    "translation": "你們怎麼不說話呢？」"
  },
  {
    "surah_id": 37,
    "ayah_number": 93,
    "global_ayah_id": 3881,
    "translation": "他就悄俏地以右手打擊他們。"
  },
  {
    "surah_id": 37,
    "ayah_number": 94,
    "global_ayah_id": 3882,
    "translation": "眾人就急急忙忙地來看他，"
  },
  {
    "surah_id": 37,
    "ayah_number": 95,
    "global_ayah_id": 3883,
    "translation": "他說：「你們崇拜自己所雕刻的偶像嗎？"
  },
  {
    "surah_id": 37,
    "ayah_number": 96,
    "global_ayah_id": 3884,
    "translation": "真主創造你們，和你們的行為。」"
  },
  {
    "surah_id": 37,
    "ayah_number": 97,
    "global_ayah_id": 3885,
    "translation": "他們說：「你們應當為他而修一個火爐，然後，將他投在烈火中。」"
  },
  {
    "surah_id": 37,
    "ayah_number": 98,
    "global_ayah_id": 3886,
    "translation": "他們欲謀害他，而我卻使他們變成佔下風的。"
  },
  {
    "surah_id": 37,
    "ayah_number": 99,
    "global_ayah_id": 3887,
    "translation": "他說：「我果然要遷移到我的主所啟示我的地方去，他將指導我。"
  },
  {
    "surah_id": 37,
    "ayah_number": 100,
    "global_ayah_id": 3888,
    "translation": "我的主呀！求你賞賜我一個善良的兒子。」"
  },
  {
    "surah_id": 37,
    "ayah_number": 101,
    "global_ayah_id": 3889,
    "translation": "我就以一個寬厚的兒童向他報喜。"
  },
  {
    "surah_id": 37,
    "ayah_number": 102,
    "global_ayah_id": 3890,
    "translation": "當他長到能幫著他操作的時候，他說：「我的小子啊！我確已夢見我宰你為犧牲。你考慮一下！你究竟有甚麼意見？」他說：「我的父親啊！請你執行你所奉的命令吧！如果真主意欲，你將發現我是堅忍的。」"
  },
  {
    "surah_id": 37,
    "ayah_number": 103,
    "global_ayah_id": 3891,
    "translation": "他們倆既已順服真主，而他使他的兒子側臥著。"
  },
  {
    "surah_id": 37,
    "ayah_number": 104,
    "global_ayah_id": 3892,
    "translation": "我喊叫說：「易卜拉欣啊！"
  },
  {
    "surah_id": 37,
    "ayah_number": 105,
    "global_ayah_id": 3893,
    "translation": "你確已証實那個夢了。」我必定要這樣報酬行善的人們。"
  },
  {
    "surah_id": 37,
    "ayah_number": 106,
    "global_ayah_id": 3894,
    "translation": "這確是明顯的考驗。"
  },
  {
    "surah_id": 37,
    "ayah_number": 107,
    "global_ayah_id": 3895,
    "translation": "我以一個偉大的犧牲贖了他。"
  },
  {
    "surah_id": 37,
    "ayah_number": 108,
    "global_ayah_id": 3896,
    "translation": "我使他的令名，永存於後代。"
  },
  {
    "surah_id": 37,
    "ayah_number": 109,
    "global_ayah_id": 3897,
    "translation": "「祝易卜拉欣平安！」"
  },
  {
    "surah_id": 37,
    "ayah_number": 110,
    "global_ayah_id": 3898,
    "translation": "我要這樣報酬行善者。"
  },
  {
    "surah_id": 37,
    "ayah_number": 111,
    "global_ayah_id": 3899,
    "translation": "他確是我的信道的僕人，"
  },
  {
    "surah_id": 37,
    "ayah_number": 112,
    "global_ayah_id": 3900,
    "translation": "我以將為先知和善人的易司哈格向他報喜。"
  },
  {
    "surah_id": 37,
    "ayah_number": 113,
    "global_ayah_id": 3901,
    "translation": "我降福於他和易司哈格。他們倆的子孫中，將有行善者和公然自暴自棄者。"
  },
  {
    "surah_id": 37,
    "ayah_number": 114,
    "global_ayah_id": 3902,
    "translation": "我確已施恩於穆薩和哈倫。"
  },
  {
    "surah_id": 37,
    "ayah_number": 115,
    "global_ayah_id": 3903,
    "translation": "我曾使他們倆及其宗族，得免於大難。"
  },
  {
    "surah_id": 37,
    "ayah_number": 116,
    "global_ayah_id": 3904,
    "translation": "我曾援助他們，所以他們是勝利者。"
  },
  {
    "surah_id": 37,
    "ayah_number": 117,
    "global_ayah_id": 3905,
    "translation": "我授予他們倆詳明的經典，"
  },
  {
    "surah_id": 37,
    "ayah_number": 118,
    "global_ayah_id": 3906,
    "translation": "我指引他們倆正直的道路，"
  },
  {
    "surah_id": 37,
    "ayah_number": 119,
    "global_ayah_id": 3907,
    "translation": "我使他們倆的令名，永存於後代。"
  },
  {
    "surah_id": 37,
    "ayah_number": 120,
    "global_ayah_id": 3908,
    "translation": "「祝穆薩和哈倫平安！」"
  },
  {
    "surah_id": 37,
    "ayah_number": 121,
    "global_ayah_id": 3909,
    "translation": "我必定要這樣報酬行善者。"
  },
  {
    "surah_id": 37,
    "ayah_number": 122,
    "global_ayah_id": 3910,
    "translation": "他們倆確是我的信道的僕人。"
  },
  {
    "surah_id": 37,
    "ayah_number": 123,
    "global_ayah_id": 3911,
    "translation": "易勒雅斯確是使者。"
  },
  {
    "surah_id": 37,
    "ayah_number": 124,
    "global_ayah_id": 3912,
    "translation": "當時，他對他的宗族說：「難道你們不敬畏真主嗎？"
  },
  {
    "surah_id": 37,
    "ayah_number": 125,
    "global_ayah_id": 3913,
    "translation": "難道你們祈禱白耳利，而捨棄最優越的創造者——"
  },
  {
    "surah_id": 37,
    "ayah_number": 126,
    "global_ayah_id": 3914,
    "translation": "真主，你們的主，你們祖先的主嗎？」"
  },
  {
    "surah_id": 37,
    "ayah_number": 127,
    "global_ayah_id": 3915,
    "translation": "他們否認他，所以他們必定要被拘禁。"
  },
  {
    "surah_id": 37,
    "ayah_number": 128,
    "global_ayah_id": 3916,
    "translation": "惟真主的純潔的眾僕則不然。"
  },
  {
    "surah_id": 37,
    "ayah_number": 129,
    "global_ayah_id": 3917,
    "translation": "我使他的令名，永存於後代。"
  },
  {
    "surah_id": 37,
    "ayah_number": 130,
    "global_ayah_id": 3918,
    "translation": "「祝易勒雅斯平安！」"
  },
  {
    "surah_id": 37,
    "ayah_number": 131,
    "global_ayah_id": 3919,
    "translation": "我必定要這樣報酬行善者。"
  },
  {
    "surah_id": 37,
    "ayah_number": 132,
    "global_ayah_id": 3920,
    "translation": "他確是我的信道的僕人。"
  },
  {
    "surah_id": 37,
    "ayah_number": 133,
    "global_ayah_id": 3921,
    "translation": "魯特確是使者。"
  },
  {
    "surah_id": 37,
    "ayah_number": 134,
    "global_ayah_id": 3922,
    "translation": "當時，我拯救了他，和他的全體信徒；"
  },
  {
    "surah_id": 37,
    "ayah_number": 135,
    "global_ayah_id": 3923,
    "translation": "惟有一個老婦人和其餘的人，沒有獲得拯救。"
  },
  {
    "surah_id": 37,
    "ayah_number": 136,
    "global_ayah_id": 3924,
    "translation": "然後，我毀滅了別的許多人。"
  },
  {
    "surah_id": 37,
    "ayah_number": 137,
    "global_ayah_id": 3925,
    "translation": "你們的確朝夕經過他們的遺蹟，"
  },
  {
    "surah_id": 37,
    "ayah_number": 138,
    "global_ayah_id": 3926,
    "translation": "難道你們不了解嗎？"
  },
  {
    "surah_id": 37,
    "ayah_number": 139,
    "global_ayah_id": 3927,
    "translation": "優努司確是使者。"
  },
  {
    "surah_id": 37,
    "ayah_number": 140,
    "global_ayah_id": 3928,
    "translation": "當時，他逃到那只滿載的船舶上。"
  },
  {
    "surah_id": 37,
    "ayah_number": 141,
    "global_ayah_id": 3929,
    "translation": "他就拈【門龜】，他卻是失敗的，"
  },
  {
    "surah_id": 37,
    "ayah_number": 142,
    "global_ayah_id": 3930,
    "translation": "大魚就吞了他，同時，他是應受譴責的。"
  },
  {
    "surah_id": 37,
    "ayah_number": 143,
    "global_ayah_id": 3931,
    "translation": "假若他不是常讚頌真主者，"
  },
  {
    "surah_id": 37,
    "ayah_number": 144,
    "global_ayah_id": 3932,
    "translation": "他必葬身魚腹，直到世人復活之日。"
  },
  {
    "surah_id": 37,
    "ayah_number": 145,
    "global_ayah_id": 3933,
    "translation": "然後，我將他拋在旱地上，當時他是有病的。"
  },
  {
    "surah_id": 37,
    "ayah_number": 146,
    "global_ayah_id": 3934,
    "translation": "我使一棵瓠瓜，長起來遮著他。"
  },
  {
    "surah_id": 37,
    "ayah_number": 147,
    "global_ayah_id": 3935,
    "translation": "我曾派遣他去教化十多萬民眾。"
  },
  {
    "surah_id": 37,
    "ayah_number": 148,
    "global_ayah_id": 3936,
    "translation": "他們便歸信他，我使他們享樂至一定期。"
  },
  {
    "surah_id": 37,
    "ayah_number": 149,
    "global_ayah_id": 3937,
    "translation": "你問他們吧！你的主有許多女兒，他們卻有多少兒子呢？"
  },
  {
    "surah_id": 37,
    "ayah_number": 150,
    "global_ayah_id": 3938,
    "translation": "還是我曾將眾天神造成女性的，他們曾眼見我的創造呢？"
  },
  {
    "surah_id": 37,
    "ayah_number": 151,
    "global_ayah_id": 3939,
    "translation": "真的，他們因為自己的悖謬，必定要說："
  },
  {
    "surah_id": 37,
    "ayah_number": 152,
    "global_ayah_id": 3940,
    "translation": "「真主已生育了。」他們確是說謊者。"
  },
  {
    "surah_id": 37,
    "ayah_number": 153,
    "global_ayah_id": 3941,
    "translation": "難道他不要兒子，卻要女兒嗎？"
  },
  {
    "surah_id": 37,
    "ayah_number": 154,
    "global_ayah_id": 3942,
    "translation": "你們有甚麼理由？你們怎麼這樣判斷呢？"
  },
  {
    "surah_id": 37,
    "ayah_number": 155,
    "global_ayah_id": 3943,
    "translation": "你們還不覺悟嗎？"
  },
  {
    "surah_id": 37,
    "ayah_number": 156,
    "global_ayah_id": 3944,
    "translation": "難道你們有一個明証嗎？"
  },
  {
    "surah_id": 37,
    "ayah_number": 157,
    "global_ayah_id": 3945,
    "translation": "拿出你們的經典來吧，倘若你們是誠實的人！"
  },
  {
    "surah_id": 37,
    "ayah_number": 158,
    "global_ayah_id": 3946,
    "translation": "他們妄言他與精靈之間，有姻親關係。精靈確已知道他們將被拘禁"
  },
  {
    "surah_id": 37,
    "ayah_number": 159,
    "global_ayah_id": 3947,
    "translation": "——超絕哉真主！他是超乎他們的敘述的"
  },
  {
    "surah_id": 37,
    "ayah_number": 160,
    "global_ayah_id": 3948,
    "translation": "——惟真主的純潔的眾僕，不被拘禁。"
  },
  {
    "surah_id": 37,
    "ayah_number": 161,
    "global_ayah_id": 3949,
    "translation": "你們和你們所崇拜的，"
  },
  {
    "surah_id": 37,
    "ayah_number": 162,
    "global_ayah_id": 3950,
    "translation": "絕不能把任何人引誘去崇拜他們，"
  },
  {
    "surah_id": 37,
    "ayah_number": 163,
    "global_ayah_id": 3951,
    "translation": "除非是將入火獄的人。"
  },
  {
    "surah_id": 37,
    "ayah_number": 164,
    "global_ayah_id": 3952,
    "translation": "（眾天神說）：「我們人人都有一個指定的地位，"
  },
  {
    "surah_id": 37,
    "ayah_number": 165,
    "global_ayah_id": 3953,
    "translation": "我們必定是排班的，"
  },
  {
    "surah_id": 37,
    "ayah_number": 166,
    "global_ayah_id": 3954,
    "translation": "我們必定是讚頌真主的。」"
  },
  {
    "surah_id": 37,
    "ayah_number": 167,
    "global_ayah_id": 3955,
    "translation": "他們的確常說："
  },
  {
    "surah_id": 37,
    "ayah_number": 168,
    "global_ayah_id": 3956,
    "translation": "「假若我們有古人所遺留的教誨，"
  },
  {
    "surah_id": 37,
    "ayah_number": 169,
    "global_ayah_id": 3957,
    "translation": "那末，我們必是真主的純潔的僕人。」"
  },
  {
    "surah_id": 37,
    "ayah_number": 170,
    "global_ayah_id": 3958,
    "translation": "他們卻不信真主，他們不久就知道了。"
  },
  {
    "surah_id": 37,
    "ayah_number": 171,
    "global_ayah_id": 3959,
    "translation": "我對我所派遣的僕人們已有約言在先了，"
  },
  {
    "surah_id": 37,
    "ayah_number": 172,
    "global_ayah_id": 3960,
    "translation": "他們必定是被援助的，"
  },
  {
    "surah_id": 37,
    "ayah_number": 173,
    "global_ayah_id": 3961,
    "translation": "我的軍隊，必定是勝利的。"
  },
  {
    "surah_id": 37,
    "ayah_number": 174,
    "global_ayah_id": 3962,
    "translation": "你暫時退避他們吧！"
  },
  {
    "surah_id": 37,
    "ayah_number": 175,
    "global_ayah_id": 3963,
    "translation": "你看著吧！他們不久就看見了。"
  },
  {
    "surah_id": 37,
    "ayah_number": 176,
    "global_ayah_id": 3964,
    "translation": "難道他們要求我的刑罰早日實現嗎？"
  },
  {
    "surah_id": 37,
    "ayah_number": 177,
    "global_ayah_id": 3965,
    "translation": "我的刑罰一旦降於他們的庭院的時候，被警告者的早晨，真惡劣呀！"
  },
  {
    "surah_id": 37,
    "ayah_number": 178,
    "global_ayah_id": 3966,
    "translation": "你暫時退避他們吧！"
  },
  {
    "surah_id": 37,
    "ayah_number": 179,
    "global_ayah_id": 3967,
    "translation": "你看著吧！他們不久就看見了。"
  },
  {
    "surah_id": 37,
    "ayah_number": 180,
    "global_ayah_id": 3968,
    "translation": "超絕哉你的主——尊榮的主宰！他是超乎他們的敘述的。"
  },
  {
    "surah_id": 37,
    "ayah_number": 181,
    "global_ayah_id": 3969,
    "translation": "祝眾使者平安！"
  },
  {
    "surah_id": 37,
    "ayah_number": 182,
    "global_ayah_id": 3970,
    "translation": "一切讚頌，全歸真主——全世界的主！"
  }
]