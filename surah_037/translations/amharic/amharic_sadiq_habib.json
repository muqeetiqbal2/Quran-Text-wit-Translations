[
  {
    "surah_id": 37,
    "ayah_number": 1,
    "global_ayah_id": 3789,
    "translation": "መሰለፍን በሚሰለፉት፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 2,
    "global_ayah_id": 3790,
    "translation": "መገሠጽንም በሚገሥጹት፤"
  },
  {
    "surah_id": 37,
    "ayah_number": 3,
    "global_ayah_id": 3791,
    "translation": "ቁርኣንንም በሚያነቡት እምላለሁ፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 4,
    "global_ayah_id": 3792,
    "translation": "አምላካችሁ በእርግጥ አንድ ነው፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 5,
    "global_ayah_id": 3793,
    "translation": "የሰማያትና የምድር በመካከላቸው ያለውም ፍጡር ሁሉ ጌታ ነው፡፡ የምሥራቆችም ጌታ ነው፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 6,
    "global_ayah_id": 3794,
    "translation": "እኛ ቅርቢቱን ሰማይ በከዋክብት ጌጥ አጌጥናት፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 7,
    "global_ayah_id": 3795,
    "translation": "አመጸኛም ከሆነ ሰይጣን ሁሉ መጠበቅን ጠበቅናት፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 8,
    "global_ayah_id": 3796,
    "translation": "ወደላይኛው ሰራዊት አያዳምጡም፡፡ ከየወገኑም ሁሉ ችቦ ይጣልባቸዋል፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 9,
    "global_ayah_id": 3797,
    "translation": "የሚባረሩ ሲሆኑ (ይጣልባቸዋል)፡፡ ለእነሱም ዘውታሪ ቅጣት አላቸው፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 10,
    "global_ayah_id": 3798,
    "translation": "ንጥቂያን የነጠቀ ወዲያውም አብሪ ኮከብ የተከተለው ሲቀር፤ (እርሱ ይሰማዋል)፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 11,
    "global_ayah_id": 3799,
    "translation": "ጠይቃቸውም፤ እነርሱ በአፈጣጠር ይበልጥ የበረቱ ናቸውን? ወይስ እኛ (ከእነርሱ በፊት) የፈጠርነው? (ፍጡር) እኛ ከሚጣበቅ ጭቃ ፈጠርናቸው፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 12,
    "global_ayah_id": 3800,
    "translation": "ይልቁንም (በማስተባበላቸው) ተደነቅህ፤(ከመደነቅህ) ይሳለቃሉም፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 13,
    "global_ayah_id": 3801,
    "translation": "በተገሠጹም ጊዜ አይመለሱም፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 14,
    "global_ayah_id": 3802,
    "translation": "ተዓምርን ባዩም ጊዜ ለመሳለቅ ይጠራራሉ፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 15,
    "global_ayah_id": 3803,
    "translation": "ይላሉም «ይህ ግልጽ ድግምት እንጂ ሌላ አይደለም፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 16,
    "global_ayah_id": 3804,
    "translation": "«በሞትንና ዐፈርና አጥንቶችም በኾን ጊዜ እኛ የምንቀሰቀስ ነን?"
  },
  {
    "surah_id": 37,
    "ayah_number": 17,
    "global_ayah_id": 3805,
    "translation": "«የቀድሞዎቹ አባቶችንም? (ይላሉ)፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 18,
    "global_ayah_id": 3806,
    "translation": "«አዎን እናንተ ወራዶች ሆናችሁ (ትነሳላችሁ)» በላቸው፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 19,
    "global_ayah_id": 3807,
    "translation": "እርሷም አንዲት ጩኸት ብቻ ናት፡፡ እነርሱም ወዲያውኑ (ምን እንደሚፈጸምባቸው) ያያሉ፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 20,
    "global_ayah_id": 3808,
    "translation": "«ዋ ጥፋታችን! ይህ የፍርዱ ቀን ነው» ይላሉም፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 21,
    "global_ayah_id": 3809,
    "translation": "«ይህ ያ በእርሱ ታስተባብሉ የነበራችሁት መለያው ቀን ነው» (ይባላሉ)፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 22,
    "global_ayah_id": 3810,
    "translation": "(ለመላእክቶችም) «እነዚያን ነፍሶቻቸውን የበደሉትን ሰዎች ጓደኞቻቸውንም ይግገዟቸው የነበሩትንም (ጣዖታት) ሰብስቡ፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 23,
    "global_ayah_id": 3811,
    "translation": "«ከአላህ ሌላ (የሚገዙዋቸውን ሰብስቧቸው) ወደ እሳት መንገድም ምሩዋቸው፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 24,
    "global_ayah_id": 3812,
    "translation": "«አቁሟቸውም፡፡ እነርሱ ተጠያቂዎች ናቸውና» (ይባላል)፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 25,
    "global_ayah_id": 3813,
    "translation": "(ለእነርሱም) «የማትረዳዱት ለእናንተ ምን አላችሁ? (ይባላሉ)፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 26,
    "global_ayah_id": 3814,
    "translation": "በእርግጥ እነርሱ ዛሬ እጃቸውን የሰጡ ወራዳዎች ናቸው፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 27,
    "global_ayah_id": 3815,
    "translation": "የሚወቃቀሱም ሆነው ከፊላቸው በከፊሉ ላይ ይመጣሉ፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 28,
    "global_ayah_id": 3816,
    "translation": "(ለአስከታዮቹ) እናንተ ከስተቀኝ ትመጡብን ነበር ይላሉ፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 29,
    "global_ayah_id": 3817,
    "translation": "(አስከታዮቹም) ይላሉ «አይደለም ፈጽሞ ምእምናን አልነበራችሁም፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 30,
    "global_ayah_id": 3818,
    "translation": "«ለእኛም በእናንተ ላይ ምንም ስልጣን አልነበረንም፡፡ በእርግጥ እናንተ ጠማሞች ሕዝቦች ነበራችሁ፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 31,
    "global_ayah_id": 3819,
    "translation": "«በእኛም ላይ የጌታችን ቃል ተረጋገጠብን፤ እኛ (ሁላችንም ቅጣቱን) ቀማሾች ነን፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 32,
    "global_ayah_id": 3820,
    "translation": "«ወደ ጥምመት ጠራናችሁም፡፡ እኛ ጠማሞች ነበርንና» (ይላሉ)፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 33,
    "global_ayah_id": 3821,
    "translation": "ስለዚህ እነርሱ በዚያ ቀን በቅጣቱ ነጋሪዎች ናቸው፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 34,
    "global_ayah_id": 3822,
    "translation": "እኛ በአመጸኞች ሁሉ እንደዚሁ እንሠራለን፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 35,
    "global_ayah_id": 3823,
    "translation": "እነርሱ ከአላህ ሌላ አምላክ የለም በተባሉ ጊዜ ይኮሩ ነበሩ፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 36,
    "global_ayah_id": 3824,
    "translation": "እኛ ለዕብድ ባለቅኔ ብለን አማልክቶቻችንን የምንተው ነን? ይሉም ነበር፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 37,
    "global_ayah_id": 3825,
    "translation": "አይደለም እውነቱን (ሃይማኖት) አመጣ፡፡ መልክተኞቹንም እውነተኛነታቸውን አረጋገጠ፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 38,
    "global_ayah_id": 3826,
    "translation": "እናንተ አሳማሚውን ቅጣት በእርግጥ ቀማሾች ናችሁ፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 39,
    "global_ayah_id": 3827,
    "translation": "ትሠሩትም የነበራችሁትን እንጂ ሌላን አትመነዱም፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 40,
    "global_ayah_id": 3828,
    "translation": "ግን ምርጥ የሆኑት የአላህ ባሮች (ቅጣትን አይቀምሱም)፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 41,
    "global_ayah_id": 3829,
    "translation": "እነዚያ ለእነርሱ የታወቀ ሲሳይ አላቸው፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 42,
    "global_ayah_id": 3830,
    "translation": "ፍራፍሬዎች (አሏቸው) እነርሱም የተከበሩ ናቸው፤"
  },
  {
    "surah_id": 37,
    "ayah_number": 43,
    "global_ayah_id": 3831,
    "translation": "በድሎት ገነቶች ውስጥ፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 44,
    "global_ayah_id": 3832,
    "translation": "ፊት ለፊት የሚታያዩ ሲሆኑ በአልጋዎች ላይ (ይንፈላሰሳሉ)፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 45,
    "global_ayah_id": 3833,
    "translation": "ከሚመነጭ ወይን ጠጅ በያዘ ብርጭቆ በእነርሱ ላይ ይዞርባቸዋል፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 46,
    "global_ayah_id": 3834,
    "translation": "ነጭ ለጠጪዎች ጣፋጭ ከኾነች፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 47,
    "global_ayah_id": 3835,
    "translation": "በእርሷ ውስጥም ምታት የለባትም፡፡ እነርሱም ከእርሷ የሚሰክሩ አይደሉም፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 48,
    "global_ayah_id": 3836,
    "translation": "እነርሱም ዘንድ ዓይናቸውን (በባሎቻቸው ላይ) አሳጣሪዎች የኾኑ ዓይናማዎች አልሉ፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 49,
    "global_ayah_id": 3837,
    "translation": "እነርሱ ልክ የተሸፈነ (የሰጎን) ዕንቁላል ይመስላሉ፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 50,
    "global_ayah_id": 3838,
    "translation": "የሚጠያየቁም ሆነው ከፊላቸው ወደ ከፊሉ ይመጣሉ፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 51,
    "global_ayah_id": 3839,
    "translation": "ከእነርሱ የሆነ ተናጋሪ ይላል «እኔ ጓደኛ ነበረኝ፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 52,
    "global_ayah_id": 3840,
    "translation": "«በእርግጥ አንተ ከሚያምኑት ነህን? የሚል፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 53,
    "global_ayah_id": 3841,
    "translation": "«በሞትንና ዐፈር አጥንቶችም በሆን ጊዜ እኛ በእርግጥ እንመረመራለን?» (የሚል)፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 54,
    "global_ayah_id": 3842,
    "translation": "እናንተ ተመልካቾች ናችሁን? ይላል፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 55,
    "global_ayah_id": 3843,
    "translation": "ይመለከታልም፤ በገሀነም መካከልም (ጓደኛውን) ያየዋል፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 56,
    "global_ayah_id": 3844,
    "translation": "ይላል «በአላህ እምላለሁ፤ በእርግጥ ልታጠፋኝ ቀርበህ ነበር፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 57,
    "global_ayah_id": 3845,
    "translation": "«የጌታየም ጸጋ ባልነበረ ኖሮ ወደ እሳት ከሚቀርቡት እሆን ነበር፡፡»"
  },
  {
    "surah_id": 37,
    "ayah_number": 58,
    "global_ayah_id": 3846,
    "translation": "(የገነት ሰዎች ይላሉ) «እኛ የምንሞት አይደለንምን?"
  },
  {
    "surah_id": 37,
    "ayah_number": 59,
    "global_ayah_id": 3847,
    "translation": "«የመጀመሪያይቱ መሞታችን ብቻ ስትቀር፡፡ እኛም የምንቅቀጣ አይደለንምን?» (ይላሉ)፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 60,
    "global_ayah_id": 3848,
    "translation": "ይህ (ለገነት ሰዎች የተወሳው) እርሱ በእርግጥ ታላቅ ዕድል ነው፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 61,
    "global_ayah_id": 3849,
    "translation": "ለዚህ ብጤ ሠሪዎች ይሥሩ፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 62,
    "global_ayah_id": 3850,
    "translation": "በመስተንግዶነት ይህ ይበልጣልን? ወይስ የዘቁም ዛፍ?"
  },
  {
    "surah_id": 37,
    "ayah_number": 63,
    "global_ayah_id": 3851,
    "translation": "እኛ ለበዳዮች ፈተና አድርገናታል፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 64,
    "global_ayah_id": 3852,
    "translation": "እርሷ በገሀነም አዘቅት ውስጥ የምትወጣ ዛፍ ናት፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 65,
    "global_ayah_id": 3853,
    "translation": "እንቡጧ ልክ የሰይጣናት ራሶች ይመስላል፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 66,
    "global_ayah_id": 3854,
    "translation": "እነርሱም ከእርሷ በይዎች ናቸው፤ ሆዶችንም ከእርሷ ሞይዎች ናቸው፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 67,
    "global_ayah_id": 3855,
    "translation": "ከዚያም ለእነርሱ በእርሷ ላይ ከተኳሳ ውሃ ቅልቅል (መጠጥ) አልላቸው፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 68,
    "global_ayah_id": 3856,
    "translation": "ከዚያም መመለሻቸው ወደ ተጋጋመች እሳት ነው፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 69,
    "global_ayah_id": 3857,
    "translation": "እነሱ አባቶቻቸውን የተሳሳቱ ሆነው አግኝተዋልና፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 70,
    "global_ayah_id": 3858,
    "translation": "እነሱም በፈለጎቻቸው ላይ ይገሰግሳሉና፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 71,
    "global_ayah_id": 3859,
    "translation": "ከእነርሱ በፊትም የቀድሞዎቹ (ሕዝቦች) አብዛኞቻቸው በእርግጥ ተሳስተዋል፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 72,
    "global_ayah_id": 3860,
    "translation": "በውስጣቸውም አስፈራሪዎችን በእርግጥ ልከናል፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 73,
    "global_ayah_id": 3861,
    "translation": "የተስፈራሪዎቹም መጨረሻ እንዴት እንደነበረ ተመልከት፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 74,
    "global_ayah_id": 3862,
    "translation": "ምርጥ የሆኑት የአላህ ባሮች ብቻ ሲቀሩ፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 75,
    "global_ayah_id": 3863,
    "translation": "ኑሕም በእርግጥ ጠራን፡፡ ጥሪውን ተቀባዮቹም ምንኛ አማርን!"
  },
  {
    "surah_id": 37,
    "ayah_number": 76,
    "global_ayah_id": 3864,
    "translation": "እርሱንም ቤተሰቦቹንም ከከባድ ጭንቅ አዳንን፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 77,
    "global_ayah_id": 3865,
    "translation": "ዘሮቹንም እነርሱን ብቻ ቀሪዎች አደረግን፤"
  },
  {
    "surah_id": 37,
    "ayah_number": 78,
    "global_ayah_id": 3866,
    "translation": "በርሱም ላይ በኋለኞቹ ሕዝቦች ውስጥ (መልካም ዝናን) ተውን፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 79,
    "global_ayah_id": 3867,
    "translation": "«በዓለማት ውስጥ ሰላም በኑሕ ላይ ይኹን፡፡»"
  },
  {
    "surah_id": 37,
    "ayah_number": 80,
    "global_ayah_id": 3868,
    "translation": "እኛ እንደዚሁ መልካም ሠሪዎችን እንመነዳለን፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 81,
    "global_ayah_id": 3869,
    "translation": "እርሱ ከምእምናን ባሮቻችን ነውና፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 82,
    "global_ayah_id": 3870,
    "translation": "ከዚያም ሌሎቹን አሰጠምን፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 83,
    "global_ayah_id": 3871,
    "translation": "ኢብራሂምም በእርግጥ ከተከታዮቹ ነው፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 84,
    "global_ayah_id": 3872,
    "translation": "ወደ ጌታው በቅን ልብ በመጣ ጊዜ (የኾነውን አስታውስ)፡፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 85,
    "global_ayah_id": 3873,
    "translation": "«ለአባቱና ለሕዝቦቹ ምንን ትግገዛላችሁ?» ባለ ጊዜ፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 86,
    "global_ayah_id": 3874,
    "translation": "«ለቅጥፈት ብላችሁ ከአላህ ሌላ አማልክትን ትሻላችሁን?"
  },
  {
    "surah_id": 37,
    "ayah_number": 87,
    "global_ayah_id": 3875,
    "translation": "«በዓለማትም ጌታ ሃሳባችሁ ምንድን ነው?» አለ፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 88,
    "global_ayah_id": 3876,
    "translation": "በከዋክብትም መመልከትን ተመለከተ፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 89,
    "global_ayah_id": 3877,
    "translation": "«እኔ በሽተኛ ነኝም» አለ፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 90,
    "global_ayah_id": 3878,
    "translation": "ከእርሱም የሸሹ ሆነው ኼዱ፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 91,
    "global_ayah_id": 3879,
    "translation": "ወደ አማልክቶቻቸውም ተዘነበለ፡፡ አለም፡- «አትበሉምን?»"
  },
  {
    "surah_id": 37,
    "ayah_number": 92,
    "global_ayah_id": 3880,
    "translation": "«የማትናገሩት ለናንተ ምን አላችሁ?»"
  },
  {
    "surah_id": 37,
    "ayah_number": 93,
    "global_ayah_id": 3881,
    "translation": "በኀይል የሚመታቸውም ሆኖ በእነርሱ ላይ በድብቅ ተዘነበለ፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 94,
    "global_ayah_id": 3882,
    "translation": "ወደእርሱም (ሰዎቹ) እየሮጡ መጡ፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 95,
    "global_ayah_id": 3883,
    "translation": "አላቸው «የምትጠርቡትን ትግገዛላችሁን?»"
  },
  {
    "surah_id": 37,
    "ayah_number": 96,
    "global_ayah_id": 3884,
    "translation": "«አላህ እናንተንም የምትሠሩትንም የፈጠረ ሲኾን፡፡»"
  },
  {
    "surah_id": 37,
    "ayah_number": 97,
    "global_ayah_id": 3885,
    "translation": "«ለእርሱም ግንብን ገንቡ በእሳት ነበልባል ውስጥ ጣሉትም» አሉ፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 98,
    "global_ayah_id": 3886,
    "translation": "በእርሱም ተንኮልን አሰቡ፡፡ ዝቅተኞችም አደረግናቸው፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 99,
    "global_ayah_id": 3887,
    "translation": "አለም «እኔ ወደ ጌታዬ ኼያጅ ነኝ፡፡ በእርግጥ ይመራኛልና፡፡»"
  },
  {
    "surah_id": 37,
    "ayah_number": 100,
    "global_ayah_id": 3888,
    "translation": "ጌታዬ ሆይ! ከመልካሞቹ የሆነን (ልጅ) ስጠኝ፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 101,
    "global_ayah_id": 3889,
    "translation": "ታጋሽ በሆነ ወጣት ልጅም አበሰርነው፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 102,
    "global_ayah_id": 3890,
    "translation": "ከእርሱ ጋርም ለሥራ በደረሰ ጊዜ «ልጄ ሆይ! እኔ በሕልሜ እኔ የማርድህ ሆኜ አያለሁ፡፡ ተመልከትም፤ ምን ታያለህ?» አለው፡፡ «አባቴ ሆይ! የታዘዝከውን ሥራ፡፡ አላህ ቢሻ ከታጋሾቹ ሆኜ ታገኘኛለህ» አለ፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 103,
    "global_ayah_id": 3891,
    "translation": "ሁለቱም ትዕዛዙን በተቀበሉና በግንባሩም ጎን ላይ በጣለው ጊዜ (የሆነው ሆነ)፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 104,
    "global_ayah_id": 3892,
    "translation": "ጠራነውም፤ (አልነው) «ኢብራሂም ሆይ!"
  },
  {
    "surah_id": 37,
    "ayah_number": 105,
    "global_ayah_id": 3893,
    "translation": "ራእይቱን በእውነት አረጋገጥክ፡፡» እኛ እንደዚሁ መልካም ሠሪዎችን እንመነዳለን፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 106,
    "global_ayah_id": 3894,
    "translation": "ይህ እርሱ በእውነት ግልጽ ፈተና ነው፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 107,
    "global_ayah_id": 3895,
    "translation": "በታላቅ ዕርድም (መስዋዕት) ተቤዠነው፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 108,
    "global_ayah_id": 3896,
    "translation": "በእርሱም ላይ በኋለኞቹ ሕዝቦች ውስጥ መልካም ዝናን አስቀረንለት፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 109,
    "global_ayah_id": 3897,
    "translation": "ሰላም በኢብራሂም ላይ ይሁን፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 110,
    "global_ayah_id": 3898,
    "translation": "እንደዚሁ መልካም ሠሪዎችን ሁሉ እንመነዳለን፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 111,
    "global_ayah_id": 3899,
    "translation": "እርሱ በእርግጥ ካመኑት ባሮቻችን ነው፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 112,
    "global_ayah_id": 3900,
    "translation": "በኢስሐቅም አበሰርነው፡፡ ከመልካሞቹ የሆነ ነቢይ ሲሆን፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 113,
    "global_ayah_id": 3901,
    "translation": "በእርሱና በኢስሐቅ ላይም ባረክን፡፡ ከሁለቱም ዘሮች በጎ ሠሪ አልለ፡፡ ለነፍሱ ግልጽ በዳይም አለ፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 114,
    "global_ayah_id": 3902,
    "translation": "በሙሳና በሃሩን ላይም በእርግጥ ለገስን፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 115,
    "global_ayah_id": 3903,
    "translation": "እነርሱንም ሕዝቦቻቸውንም ከታላቅ ጭንቅ አዳንን፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 116,
    "global_ayah_id": 3904,
    "translation": "ረዳናቸውም፡፡ እነርሱም አሸናፊዎች ነበሩ፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 117,
    "global_ayah_id": 3905,
    "translation": "በጣም የተብራራውንም መጽሐፍ ሰጠናቸው፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 118,
    "global_ayah_id": 3906,
    "translation": "ቀጥተኛውንም መንገድ መራናቸው፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 119,
    "global_ayah_id": 3907,
    "translation": "በሁለቱም ላይ በኋለኞቹ ሕዝቦች ውስጥ መልካም ዝናን ተውንላቸው፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 120,
    "global_ayah_id": 3908,
    "translation": "ሰላም በሙሳና በሃሩን ላይ ይሁን፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 121,
    "global_ayah_id": 3909,
    "translation": "እኛ እንደዚሁ በጎ አድራጊዎችን ሁሉ እንመነዳለን፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 122,
    "global_ayah_id": 3910,
    "translation": "ሁለቱም በእርግጥ ከአመኑት ባሮቻችን ናቸው፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 123,
    "global_ayah_id": 3911,
    "translation": "ኢልያስም በእርግጥ ከመልክተኞቹ ነው፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 124,
    "global_ayah_id": 3912,
    "translation": "ለሕዝቦቹ ባለ ጊዜ (አስታውስ)፤ አላህን አትፈሩምን?"
  },
  {
    "surah_id": 37,
    "ayah_number": 125,
    "global_ayah_id": 3913,
    "translation": "በዕልን ትገዛላችሁን? ከሰዓሊዎቹ ሁሉ ይበልጥ በጣም አሳማሪ የሆነውንም አምላክ ትተዋላችሁን?"
  },
  {
    "surah_id": 37,
    "ayah_number": 126,
    "global_ayah_id": 3914,
    "translation": "አላህን ጌታችሁንና የቀድሞዎቹ አባቶቻችሁን ጌታ (ትተዋላችሁን)?"
  },
  {
    "surah_id": 37,
    "ayah_number": 127,
    "global_ayah_id": 3915,
    "translation": "አስተባበሉትም፡፡ ስለዚህ እነርሱ (ለቅጣት) የሚጣዱ ናቸው፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 128,
    "global_ayah_id": 3916,
    "translation": "ንጹሕ የተደረጉት የአላህ ባሮች ብቻ ሲቀሩ፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 129,
    "global_ayah_id": 3917,
    "translation": "በእርሱ ላይም በኋለኞቹ ሕዝቦች ውስጥ መልካም ዝናን ተውንለት፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 130,
    "global_ayah_id": 3918,
    "translation": "ሰላም በኢልያሲን ላይ ይሁን፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 131,
    "global_ayah_id": 3919,
    "translation": "እኛ እንደዚሁ መልካም ሠሪዎችን እንመነዳለን፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 132,
    "global_ayah_id": 3920,
    "translation": "እርሱ በእርግጥ ከምእመናን ባሮቻችን ነው፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 133,
    "global_ayah_id": 3921,
    "translation": "ሉጥም በእርግጥ ከመልክተኞቹ ነው፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 134,
    "global_ayah_id": 3922,
    "translation": "እርሱንና ቤተሰቦቹን ሁሉንም በአዳንናቸው ጊዜ (አስታውስ)፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 135,
    "global_ayah_id": 3923,
    "translation": "(በቅጣቱ ውስጥ) ከቀሪዎቹ የሆነችው አሮጊት ብቻ ስትቀር፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 136,
    "global_ayah_id": 3924,
    "translation": "ከዚያም ሌሎቹን አጠፋን፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 137,
    "global_ayah_id": 3925,
    "translation": "እናንተም ያነጋችሁ ስትሆኑ በእነርሱ (መኖሪያዎች) ላይ (በቀን) ታልፋላችሁ፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 138,
    "global_ayah_id": 3926,
    "translation": "በሌሊትም (ታልፋላችሁ)፤ ልብም አታደርጉምን?"
  },
  {
    "surah_id": 37,
    "ayah_number": 139,
    "global_ayah_id": 3927,
    "translation": "ዩኑስም በእርግጥ ከመልክተኞቹ ነው፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 140,
    "global_ayah_id": 3928,
    "translation": "ወደ ተመላው መርከብ በኮበለለ ጊዜ (አስታውስ)፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 141,
    "global_ayah_id": 3929,
    "translation": "ዕጣም ተጣጣለ፡፡ ከተሸነፉትም ሆነ፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 142,
    "global_ayah_id": 3930,
    "translation": "እርሱም ተወቃሽ ሲሆን ዐሳው ዋጠው፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 143,
    "global_ayah_id": 3931,
    "translation": "እርሱ ለጌታው ከአወዳሾቹ ባልሆነም ኖሮ፤"
  },
  {
    "surah_id": 37,
    "ayah_number": 144,
    "global_ayah_id": 3932,
    "translation": "እስከሚቀሰቀሱበት ቀን ድረስ በሆዱ ውስጥ በቆየ ነበር፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 145,
    "global_ayah_id": 3933,
    "translation": "እርሱ በሽተኛ ሆኖ በቃይ በሌለው (በባሕር) ዳርቻ ላይ ጣልነውም፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 146,
    "global_ayah_id": 3934,
    "translation": "በእርሱም ላይ (በአጠገቡ) ከቅል የሆነችን ዛፍ አበቀልን፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 147,
    "global_ayah_id": 3935,
    "translation": "ወደ መቶ ሺሕ ሰዎችም (ዳግመኛ) ላክነው፡፡ ከቶውንም ይጨምራሉ፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 148,
    "global_ayah_id": 3936,
    "translation": "አመኑም፡፡ እስከ ጊዜ ድረስም አጣቀምናቸው፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 149,
    "global_ayah_id": 3937,
    "translation": "(የመካን ሰዎች) ጠይቃቸውም፡፡ «ለጌታህ ሴቶች ልጆች ለእነርሱም ወንዶች ልጆች ይኖራልን?»"
  },
  {
    "surah_id": 37,
    "ayah_number": 150,
    "global_ayah_id": 3938,
    "translation": "ወይስ እኛ እነርሱ የተጣዱ ሆነው መላእክትን ሴቶች አድርገን ፈጠርን?"
  },
  {
    "surah_id": 37,
    "ayah_number": 151,
    "global_ayah_id": 3939,
    "translation": "ንቁ! እነርሱ ከቅጥፈታቸው (የተነሳ) ይላሉ፡-"
  },
  {
    "surah_id": 37,
    "ayah_number": 152,
    "global_ayah_id": 3940,
    "translation": "«አላህ (መላእክትን) ወለደ፡፡» እነርሱም በእርግጥ ውሸታሞች ናቸው፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 153,
    "global_ayah_id": 3941,
    "translation": "በወንዶች ልጆች ላይ ይልቅ ሴቶችን ልጆች መረጥን?"
  },
  {
    "surah_id": 37,
    "ayah_number": 154,
    "global_ayah_id": 3942,
    "translation": "ለእናንተ ምን (አስረጅ) አላችሁ? እንዴት ትፈርዳላችሁ!"
  },
  {
    "surah_id": 37,
    "ayah_number": 155,
    "global_ayah_id": 3943,
    "translation": "አትገነዘቡምን?"
  },
  {
    "surah_id": 37,
    "ayah_number": 156,
    "global_ayah_id": 3944,
    "translation": "ወይስ ለእናንተ ግልጽ አስረጅ አላችሁን?"
  },
  {
    "surah_id": 37,
    "ayah_number": 157,
    "global_ayah_id": 3945,
    "translation": "«እውነተኞች እንደ ሆናችሁ መጽሐፋችሁን አምጡ» (በላቸው)፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 158,
    "global_ayah_id": 3946,
    "translation": "በአላህና በአጋንንት መካከልም ዝምድናን አደረጉ፡፡ አጋንንትም እነርሱ (ይህን ባዮች በእሳት) የሚጣዱ መሆናቸውን በእርግጥ ዐውቀዋል፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 159,
    "global_ayah_id": 3947,
    "translation": "አላህ ከሚመጥኑት ሁሉ ጠራ፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 160,
    "global_ayah_id": 3948,
    "translation": "ግን የተመረጡት የአላህ ባሮች (በአላህ ላይ አይዋሹም)፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 161,
    "global_ayah_id": 3949,
    "translation": "እናንተም የምትገዟቸውም ሁሉ፤"
  },
  {
    "surah_id": 37,
    "ayah_number": 162,
    "global_ayah_id": 3950,
    "translation": "በእርሱ (በአላህ) ላይ አንድንም አጥማሚዎች አይደላችሁም፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 163,
    "global_ayah_id": 3951,
    "translation": "ያንን እርሱ ገሀነምን ገቢ የሆነውን ሰው ቢሆን እንጅ፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 164,
    "global_ayah_id": 3952,
    "translation": "(ጂብሪል አለ) ከእኛም አንድም የለም፤ ለእርሱ የታወቀ ደረጃ ያለው ቢሆን እንጅ፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 165,
    "global_ayah_id": 3953,
    "translation": "እኛም (ጌታን ለመግገዛት) ተሰላፊዎቹ እኛ ነን፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 166,
    "global_ayah_id": 3954,
    "translation": "እኛም (አላህን) አጥሪዎቹ እኛ ነን፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 167,
    "global_ayah_id": 3955,
    "translation": "እነርሱም (ከሓዲዎቹ) በእርግጥ ይሉ ነበሩ፡-"
  },
  {
    "surah_id": 37,
    "ayah_number": 168,
    "global_ayah_id": 3956,
    "translation": "«ከቀድሞዎቹ (መጻሕፍት) ገሳጭ መጽሐፍ እኛ ዘንድ በነበረን ኖሮ፤"
  },
  {
    "surah_id": 37,
    "ayah_number": 169,
    "global_ayah_id": 3957,
    "translation": "«የአላህ ምርጦች ባሮች በሆን ነበር፡፡»"
  },
  {
    "surah_id": 37,
    "ayah_number": 170,
    "global_ayah_id": 3958,
    "translation": "ግን (ቁርኣኑ በመጣላቸው ጊዜ) በእርሱ ካዱ፡፡ ወደፊትም በእርግጥ ያውቃሉ፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 171,
    "global_ayah_id": 3959,
    "translation": "(የእርዳታ) ቃላችንም መልክተኞች ለሆኑት ባሮቻችን በእውነት አልፋለች፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 172,
    "global_ayah_id": 3960,
    "translation": "እነርሱ ተረጂዎቹ እነርሱ ናቸው፡፡"
  },
  {
    "surah_id": 37,
    "ayah_number": 173,
    "global_ayah_id": 3961,
    "translation": "ሰራዊቶቻችንም በእርግጥ አሸናፊዎቹ እነርሱ ናቸው፡፡"
  },
  {
