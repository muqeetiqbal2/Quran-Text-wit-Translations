[
  {
    "surah_id": 37,
    "ayah_number": 1,
    "global_ayah_id": 3789,
    "translation": "整然と列をなす者たちにおいて。"
  },
  {
    "surah_id": 37,
    "ayah_number": 2,
    "global_ayah_id": 3790,
    "translation": "駆り立て追う者において。"
  },
  {
    "surah_id": 37,
    "ayah_number": 3,
    "global_ayah_id": 3791,
    "translation": "また訓戒（のグルアーン）を読み聞かせる者において，誓う。"
  },
  {
    "surah_id": 37,
    "ayah_number": 4,
    "global_ayah_id": 3792,
    "translation": "本当にあなたがたの神は，唯一の主である。"
  },
  {
    "surah_id": 37,
    "ayah_number": 5,
    "global_ayah_id": 3793,
    "translation": "天と地，そしてその間にある凡てのものの主，また日の出を司どる主である。"
  },
  {
    "surah_id": 37,
    "ayah_number": 6,
    "global_ayah_id": 3794,
    "translation": "本当にわれは，星々で下層の天を飾り，"
  },
  {
    "surah_id": 37,
    "ayah_number": 7,
    "global_ayah_id": 3795,
    "translation": "（アッラーの命令に）逆らう悪魔にたいする守りとした。"
  },
  {
    "surah_id": 37,
    "ayah_number": 8,
    "global_ayah_id": 3796,
    "translation": "かれらは八方から撃たれ，最高の会議を盗み聞くことは出来ない。"
  },
  {
    "surah_id": 37,
    "ayah_number": 9,
    "global_ayah_id": 3797,
    "translation": "撃退されて，かれらは永久の懲罰を受ける。"
  },
  {
    "surah_id": 37,
    "ayah_number": 10,
    "global_ayah_id": 3798,
    "translation": "盗聴し得た者があっても，白熱の炎が追跡する。"
  },
  {
    "surah_id": 37,
    "ayah_number": 11,
    "global_ayah_id": 3799,
    "translation": "かれら（マッカの多神教徒）に問え。「かれらとわれの創った者（天使）のどちらが強く創られているか。」われはもともと，粘りのある泥でかれらを創ったのである。"
  },
  {
    "surah_id": 37,
    "ayah_number": 12,
    "global_ayah_id": 3800,
    "translation": "あなたは感嘆しているというのに，かれらは嘲笑する。"
  },
  {
    "surah_id": 37,
    "ayah_number": 13,
    "global_ayah_id": 3801,
    "translation": "警告されても，かれらは警告を受け入れない。"
  },
  {
    "surah_id": 37,
    "ayah_number": 14,
    "global_ayah_id": 3802,
    "translation": "またかれらは，印を見ても嘲笑するばかり。"
  },
  {
    "surah_id": 37,
    "ayah_number": 15,
    "global_ayah_id": 3803,
    "translation": "そしてかれらは言う。「これは明らかに魔術にちがいありません。"
  },
  {
    "surah_id": 37,
    "ayah_number": 16,
    "global_ayah_id": 3804,
    "translation": "わたしたちが死んで土と骨になってから，（また）呼び起こされましようか。"
  },
  {
    "surah_id": 37,
    "ayah_number": 17,
    "global_ayah_id": 3805,
    "translation": "遠い祖先たちも（一緒にですか）と言う。"
  },
  {
    "surah_id": 37,
    "ayah_number": 18,
    "global_ayah_id": 3806,
    "translation": "言ってやるがいい。「その通り。あなたがたは卑しめられるのである。」"
  },
  {
    "surah_id": 37,
    "ayah_number": 19,
    "global_ayah_id": 3807,
    "translation": "それは只一声の叫びである。その時かれらは（恐ろしい光景を）目の当たりに見て，"
  },
  {
    "surah_id": 37,
    "ayah_number": 20,
    "global_ayah_id": 3808,
    "translation": "「ああ情けない，これが審判の日ですか。」と言う。"
  },
  {
    "surah_id": 37,
    "ayah_number": 21,
    "global_ayah_id": 3809,
    "translation": "「これはあなたがたが信じなかった区分の日である。"
  },
  {
    "surah_id": 37,
    "ayah_number": 22,
    "global_ayah_id": 3810,
    "translation": "不義を行っていた者たち，その妻たち，またかれらがアッラーを差し置いて拝していたものたちを集めなさい。"
  },
  {
    "surah_id": 37,
    "ayah_number": 23,
    "global_ayah_id": 3811,
    "translation": "かれらを火獄への道に連れて行け。"
  },
  {
    "surah_id": 37,
    "ayah_number": 24,
    "global_ayah_id": 3812,
    "translation": "いや，かれらを待たせておけ。かれらに尋ねることがある。"
  },
  {
    "surah_id": 37,
    "ayah_number": 25,
    "global_ayah_id": 3813,
    "translation": "あなたがたが助け合わないのはどうしたことか。」"
  },
  {
    "surah_id": 37,
    "ayah_number": 26,
    "global_ayah_id": 3814,
    "translation": "いや，今日ばかりは，かれらも（審判に）服する。"
  },
  {
    "surah_id": 37,
    "ayah_number": 27,
    "global_ayah_id": 3815,
    "translation": "かれらは互いに近づき尋ね合う。"
  },
  {
    "surah_id": 37,
    "ayah_number": 28,
    "global_ayah_id": 3816,
    "translation": "一方は言う。「本当にあなたがたは，右から来ました。」"
  },
  {
    "surah_id": 37,
    "ayah_number": 29,
    "global_ayah_id": 3817,
    "translation": "すると他方は言う。「いや，あなたがたは，（もともと）信者ではありませんでした。"
  },
  {
    "surah_id": 37,
    "ayah_number": 30,
    "global_ayah_id": 3818,
    "translation": "また，わたしたちはあなたがたに押し付ける権威もありませんでした。それにあなたがたは反逆の徒でした。"
  },
  {
    "surah_id": 37,
    "ayah_number": 31,
    "global_ayah_id": 3819,
    "translation": "それで主の御言葉が，わたしたちに実証された今，わたしたちは，（懲罰を）味わわねばならない。"
  },
  {
    "surah_id": 37,
    "ayah_number": 32,
    "global_ayah_id": 3820,
    "translation": "わたしたちはあなたがたを迷わせたが，わたしたち自身も迷っていたのです。」"
  },
  {
    "surah_id": 37,
    "ayah_number": 33,
    "global_ayah_id": 3821,
    "translation": "こうしてその日，かれらは，（凡て）共に懲罰を受ける。"
  },
  {
    "surah_id": 37,
    "ayah_number": 34,
    "global_ayah_id": 3822,
    "translation": "本当にわれはこのように罪を犯した者を処分する。"
  },
  {
    "surah_id": 37,
    "ayah_number": 35,
    "global_ayah_id": 3823,
    "translation": "かれらは，「アッラーの外に神はありません。」と告げられると，いつも高慢になった。"
  },
  {
    "surah_id": 37,
    "ayah_number": 36,
    "global_ayah_id": 3824,
    "translation": "そして，「気狂い詩人のために，わたしたちの神々を捨ててなるものですか。」と言っていた。"
  },
  {
    "surah_id": 37,
    "ayah_number": 37,
    "global_ayah_id": 3825,
    "translation": "いや，かれは真理を(お?)して，（かれ以前の）預言者たち（の啓典）を確証する者である。"
  },
  {
    "surah_id": 37,
    "ayah_number": 38,
    "global_ayah_id": 3826,
    "translation": "あなたがたは，必ず痛ましい懲罰を味わうであろう。"
  },
  {
    "surah_id": 37,
    "ayah_number": 39,
    "global_ayah_id": 3827,
    "translation": "どうせ皆あなたがたが行ったことの報いである。"
  },
  {
    "surah_id": 37,
    "ayah_number": 40,
    "global_ayah_id": 3828,
    "translation": "だがアッラーの忠誠なしもべたちは，別である。"
  },
  {
    "surah_id": 37,
    "ayah_number": 41,
    "global_ayah_id": 3829,
    "translation": "それらの者には，定めの恩恵があり，"
  },
  {
    "surah_id": 37,
    "ayah_number": 42,
    "global_ayah_id": 3830,
    "translation": "（喜ばしい）果実，そして栄誉が（授けられ），"
  },
  {
    "surah_id": 37,
    "ayah_number": 43,
    "global_ayah_id": 3831,
    "translation": "至福の楽園の中で，"
  },
  {
    "surah_id": 37,
    "ayah_number": 44,
    "global_ayah_id": 3832,
    "translation": "寝床の上で向かい合う。"
  },
  {
    "surah_id": 37,
    "ayah_number": 45,
    "global_ayah_id": 3833,
    "translation": "清い泉からくんだ杯は，かれらにゆきわたり，"
  },
  {
    "surah_id": 37,
    "ayah_number": 46,
    "global_ayah_id": 3834,
    "translation": "真白（な美酒は），飲む者に心地よい甘さ。"
  },
  {
    "surah_id": 37,
    "ayah_number": 47,
    "global_ayah_id": 3835,
    "translation": "これは，頭痛を催さず，酔わせもしない。"
  },
  {
    "surah_id": 37,
    "ayah_number": 48,
    "global_ayah_id": 3836,
    "translation": "またかれらの側には，伏し目がちな大きい目（の乙女）がいる。"
  },
  {
    "surah_id": 37,
    "ayah_number": 49,
    "global_ayah_id": 3837,
    "translation": "かの女らは，注意深く守られている卵のよう。"
  },
  {
    "surah_id": 37,
    "ayah_number": 50,
    "global_ayah_id": 3838,
    "translation": "やがてかれらは，互いに近づき尋ね合う。"
  },
  {
    "surah_id": 37,
    "ayah_number": 51,
    "global_ayah_id": 3839,
    "translation": "かれらの一人が，口を切って言う。「わたしに一人の親しい友がいました。"
  },
  {
    "surah_id": 37,
    "ayah_number": 52,
    "global_ayah_id": 3840,
    "translation": "かれは言っていた。『あなたまで（復活の日を）信じているのですか。"
  },
  {
    "surah_id": 37,
    "ayah_number": 53,
    "global_ayah_id": 3841,
    "translation": "わたしたちが死んで土と骨になってから，本当に審判されるのでしょうか。』」"
  },
  {
    "surah_id": 37,
    "ayah_number": 54,
    "global_ayah_id": 3842,
    "translation": "また言った。「まあ皆さん見下ろしてみなさい。」"
  },
  {
    "surah_id": 37,
    "ayah_number": 55,
    "global_ayah_id": 3843,
    "translation": "そこでかれが見下ろすと，火獄の只中にかれの姿が見えた。"
  },
  {
    "surah_id": 37,
    "ayah_number": 56,
    "global_ayah_id": 3844,
    "translation": "かれは言った。「アッラーにかけて，あなたはもう少しでわたしを破滅させるところでした。"
  },
  {
    "surah_id": 37,
    "ayah_number": 57,
    "global_ayah_id": 3845,
    "translation": "もし主の御恵みがなかったならば，わたしは必ず引き立てられる者の中にいたでしょう。」"
  },
  {
    "surah_id": 37,
    "ayah_number": 58,
    "global_ayah_id": 3846,
    "translation": "「わたしたち（楽園の仲間）は，最初の死だけでまた，"
  },
  {
    "surah_id": 37,
    "ayah_number": 59,
    "global_ayah_id": 3847,
    "translation": "死ぬことはないのですか。また，わたしたちが，懲罰を受けることはないのでしょうか。」"
  },
  {
    "surah_id": 37,
    "ayah_number": 60,
    "global_ayah_id": 3848,
    "translation": "「そうであるならこれは，至上の幸福の成就です。"
  },
  {
    "surah_id": 37,
    "ayah_number": 61,
    "global_ayah_id": 3849,
    "translation": "このようなことのために，行動し努力すべきです。」"
  },
  {
    "surah_id": 37,
    "ayah_number": 62,
    "global_ayah_id": 3850,
    "translation": "それは結構な歓待ではないか。それともザックームの木（をとるの）か。"
  },
  {
    "surah_id": 37,
    "ayah_number": 63,
    "global_ayah_id": 3851,
    "translation": "われはこの木を不義を行う者への試みとして，用意したのである。"
  },
  {
    "surah_id": 37,
    "ayah_number": 64,
    "global_ayah_id": 3852,
    "translation": "それは地獄の底に生える木で，"
  },
  {
    "surah_id": 37,
    "ayah_number": 65,
    "global_ayah_id": 3853,
    "translation": "その実は，悪魔の頭のようである。"
  },
  {
    "surah_id": 37,
    "ayah_number": 66,
    "global_ayah_id": 3854,
    "translation": "かれらはこれを食べて，腹はそれでいっばい。"
  },
  {
    "surah_id": 37,
    "ayah_number": 67,
    "global_ayah_id": 3855,
    "translation": "それから上に沸騰する湯を注ぎ足され，"
  },
  {
    "surah_id": 37,
    "ayah_number": 68,
    "global_ayah_id": 3856,
    "translation": "それから火獄に帰り着くのである。"
  },
  {
    "surah_id": 37,
    "ayah_number": 69,
    "global_ayah_id": 3857,
    "translation": "かれらは祖先の迷っていたのを認めながらも，"
  },
  {
    "surah_id": 37,
    "ayah_number": 70,
    "global_ayah_id": 3858,
    "translation": "その足跡を急いで（歩いて）いたのである。"
  },
  {
    "surah_id": 37,
    "ayah_number": 71,
    "global_ayah_id": 3859,
    "translation": "昔の多くの祖先たちも，確かに迷っていた。"
  },
  {
    "surah_id": 37,
    "ayah_number": 72,
    "global_ayah_id": 3860,
    "translation": "だがわれはかれらに，必ず警告者を遺わした。"
  },
  {
    "surah_id": 37,
    "ayah_number": 73,
    "global_ayah_id": 3861,
    "translation": "見るがいい。警告されても無視した者の最後が，どうであったかを。"
  },
  {
    "surah_id": 37,
    "ayah_number": 74,
    "global_ayah_id": 3862,
    "translation": "（だが）アッラーの忠誠なしもべたちは，別である。"
  },
  {
    "surah_id": 37,
    "ayah_number": 75,
    "global_ayah_id": 3863,
    "translation": "且つてヌーフはわれに哀願した。われは最も優れた応答者である。"
  },
  {
    "surah_id": 37,
    "ayah_number": 76,
    "global_ayah_id": 3864,
    "translation": "われは，かれとその家族を大難から救った。"
  },
  {
    "surah_id": 37,
    "ayah_number": 77,
    "global_ayah_id": 3865,
    "translation": "そしてかれの子孫を生き残らせた。"
  },
  {
    "surah_id": 37,
    "ayah_number": 78,
    "global_ayah_id": 3866,
    "translation": "また後の幾世代に渡り，かれのために（祝福の言葉を）留めた。"
  },
  {
    "surah_id": 37,
    "ayah_number": 79,
    "global_ayah_id": 3867,
    "translation": "「万物（人間，天使，ジン）の中で特にヌーフの上に平安あれ。」と（われからの有難い御言葉を）。"
  },
  {
    "surah_id": 37,
    "ayah_number": 80,
    "global_ayah_id": 3868,
    "translation": "われはこのように，正しい行いの者に報いる。"
  },
  {
    "surah_id": 37,
    "ayah_number": 81,
    "global_ayah_id": 3869,
    "translation": "本当にかれは，信心深いわがしもべであった。"
  },
  {
    "surah_id": 37,
    "ayah_number": 82,
    "global_ayah_id": 3870,
    "translation": "それからわれはその外の者を，溺れさせた。"
  },
  {
    "surah_id": 37,
    "ayah_number": 83,
    "global_ayah_id": 3871,
    "translation": "またかれの後継者の中にはイブラーヒームがいた。"
  },
  {
    "surah_id": 37,
    "ayah_number": 84,
    "global_ayah_id": 3872,
    "translation": "かれが純正な心をもってかれの主の許にやって来た折に，"
  },
  {
    "surah_id": 37,
    "ayah_number": 85,
    "global_ayah_id": 3873,
    "translation": "自分の父やその一族に向かって言った。「あなたがたの崇拝するものは何ですか。"
  },
  {
    "surah_id": 37,
    "ayah_number": 86,
    "global_ayah_id": 3874,
    "translation": "アッラーを差し置いて瞞しの神々を御望みなのですか。"
  },
  {
    "surah_id": 37,
    "ayah_number": 87,
    "global_ayah_id": 3875,
    "translation": "いったい，万有の主に就いて，あなたがたはどのように考えておいでなのですか。」"
  },
  {
    "surah_id": 37,
    "ayah_number": 88,
    "global_ayah_id": 3876,
    "translation": "その時かれは諸星を一目見て，"
  },
  {
    "surah_id": 37,
    "ayah_number": 89,
    "global_ayah_id": 3877,
    "translation": "言った。「わたしは，本当に（心が）痛む。」"
  },
  {
    "surah_id": 37,
    "ayah_number": 90,
    "global_ayah_id": 3878,
    "translation": "人々はかれに背を向けて去った。"
  },
  {
    "surah_id": 37,
    "ayah_number": 91,
    "global_ayah_id": 3879,
    "translation": "その時かれ（イブラーヒーム）は，かれらの神々に向かって言った。「あなたがたは食べないのですか。"
  },
  {
    "surah_id": 37,
    "ayah_number": 92,
    "global_ayah_id": 3880,
    "translation": "あなたがたは，どうしてものを言わないのですか。」"
  },
  {
    "surah_id": 37,
    "ayah_number": 93,
    "global_ayah_id": 3881,
    "translation": "そこでかれは，かれら（偶像）を右手で打った。"
  },
  {
    "surah_id": 37,
    "ayah_number": 94,
    "global_ayah_id": 3882,
    "translation": "その時人びとは，慌ててかれの処へやって来た。"
  },
  {
    "surah_id": 37,
    "ayah_number": 95,
    "global_ayah_id": 3883,
    "translation": "するとかれは言った。「あなたがたは，（自分で）刻んだものを崇拝するのですか。"
  },
  {
    "surah_id": 37,
    "ayah_number": 96,
    "global_ayah_id": 3884,
    "translation": "本当にアッラーは，あなたがたを創り，またあなたがたが，造るものをも（創られる）。」"
  },
  {
    "surah_id": 37,
    "ayah_number": 97,
    "global_ayah_id": 3885,
    "translation": "人びとは言った。「かれ（イブラーヒーム）のために炉を築き，燃え盛る火の中に投げ込みなさい。」"
  },
  {
    "surah_id": 37,
    "ayah_number": 98,
    "global_ayah_id": 3886,
    "translation": "このようにかれに策謀を巡らせようとしたが，われはかれらを散々な目に会わせた。"
  },
  {
    "surah_id": 37,
    "ayah_number": 99,
    "global_ayah_id": 3887,
    "translation": "かれは言った。「わたしは主の御許に行こう。必ずわたしを導かれるであろう。"
  },
  {
    "surah_id": 37,
    "ayah_number": 100,
    "global_ayah_id": 3888,
    "translation": "主よ，正しい人物になるような（息子）を，わたしに御授け下さい。」"
  },
  {
    "surah_id": 37,
    "ayah_number": 101,
    "global_ayah_id": 3889,
    "translation": "それでわれは，優しい思いやりのある男児を（授けるという）昔報を伝えた。"
  },
  {
    "surah_id": 37,
    "ayah_number": 102,
    "global_ayah_id": 3890,
    "translation": "（この子が）かれと共に働く年頃になった時，かれは言った。「息子よ，わたしはあなたを犠牲に捧げる夢を見ました。さあ，あなたはどう考えるのですか。」かれは（答えて）言った。「父よ，あなたが命じられたようにして下さい。もしアッラーが御望みならば，わたしが耐え忍ぶことが御分りでしょう。」"
  },
  {
    "surah_id": 37,
    "ayah_number": 103,
    "global_ayah_id": 3891,
    "translation": "そこでかれら両人は（命令に）服して，かれ（子供）が額を（地に付け）うつ伏せになった時，"
  },
  {
    "surah_id": 37,
    "ayah_number": 104,
    "global_ayah_id": 3892,
    "translation": "われは告げた。「イブラーヒームよ。"
  },
  {
    "surah_id": 37,
    "ayah_number": 105,
    "global_ayah_id": 3893,
    "translation": "あなたは確かにあの夢を実践した。本当にわれは，このように正しい行いをする者に報いる。"
  },
  {
    "surah_id": 37,
    "ayah_number": 106,
    "global_ayah_id": 3894,
    "translation": "これは明らかに試みであった。」"
  },
  {
    "surah_id": 37,
    "ayah_number": 107,
    "global_ayah_id": 3895,
    "translation": "われは大きな犠牲でかれを贖い，"
  },
  {
    "surah_id": 37,
    "ayah_number": 108,
    "global_ayah_id": 3896,
    "translation": "末永くかれのために（この祝福を）留めた。"
  },
  {
    "surah_id": 37,
    "ayah_number": 109,
    "global_ayah_id": 3897,
    "translation": "「イブラーヒームに平安あれ。」（と言って）。"
  },
  {
    "surah_id": 37,
    "ayah_number": 110,
    "global_ayah_id": 3898,
    "translation": "このようにわれは，正しい行いをする者に報いる。"
  },
  {
    "surah_id": 37,
    "ayah_number": 111,
    "global_ayah_id": 3899,
    "translation": "本当にかれは，わが信心深いしもべであった。"
  },
  {
    "surah_id": 37,
    "ayah_number": 112,
    "global_ayah_id": 3900,
    "translation": "またわれは正しい人物，預言者イスハークの（誕生の）吉報をかれに伝えた。"
  },
  {
    "surah_id": 37,
    "ayah_number": 113,
    "global_ayah_id": 3901,
    "translation": "そしてわれは，かれとイスハークを祝福した。だがかれらの子孫の中には正しい行いをする者もあり，また明らかに自らを損なう者もあった。"
  },
  {
    "surah_id": 37,
    "ayah_number": 114,
    "global_ayah_id": 3902,
    "translation": "われは，ムーサーとハールーンに恩恵を施した。"
  },
  {
    "surah_id": 37,
    "ayah_number": 115,
    "global_ayah_id": 3903,
    "translation": "またかれら両人，そしてその民を大きな災難から救い出し，"
  },
  {
    "surah_id": 37,
    "ayah_number": 116,
    "global_ayah_id": 3904,
    "translation": "われが助けたためにかれらは（その困難を）克服することが出来た。"
  },
  {
    "surah_id": 37,
    "ayah_number": 117,
    "global_ayah_id": 3905,
    "translation": "なおわれは，両人に（事理を）明瞭にさせる啓典を授け，"
  },
  {
    "surah_id": 37,
    "ayah_number": 118,
    "global_ayah_id": 3906,
    "translation": "かれらを正しい道に導いた。"
  },
  {
    "surah_id": 37,
    "ayah_number": 119,
    "global_ayah_id": 3907,
    "translation": "われは後の幾世代に渡り，かれらのために（この祝福を）留めた。"
  },
  {
    "surah_id": 37,
    "ayah_number": 120,
    "global_ayah_id": 3908,
    "translation": "「ムーサーとハールーンに平安あれ。」（と言って）。"
  },
  {
    "surah_id": 37,
    "ayah_number": 121,
    "global_ayah_id": 3909,
    "translation": "このようにわれは，正しい行いをする者に報いる。"
  },
  {
    "surah_id": 37,
    "ayah_number": 122,
    "global_ayah_id": 3910,
    "translation": "本当にかれら両人は信心深いわがしもべであった。"
  },
  {
    "surah_id": 37,
    "ayah_number": 123,
    "global_ayah_id": 3911,
    "translation": "本当にイルヤースも，使徒であった。"
  },
  {
    "surah_id": 37,
    "ayah_number": 124,
    "global_ayah_id": 3912,
    "translation": "かれがその民にこう言った時を思え。「あなたがたは主を畏れないのですか。"
  },
  {
    "surah_id": 37,
    "ayah_number": 125,
    "global_ayah_id": 3913,
    "translation": "あなたがたはバアルに祈って，最高の創造主（アッラー）を見捨てるのですか。"
  },
  {
    "surah_id": 37,
    "ayah_number": 126,
    "global_ayah_id": 3914,
    "translation": "アッラーこそあなたがたの主，昔の父祖たちの主ではないのですか。」"
  },
  {
    "surah_id": 37,
    "ayah_number": 127,
    "global_ayah_id": 3915,
    "translation": "だがかれらはかれ（イルヤース）を嘘付きであるとした。だから必ず（処罰に）臨むであろう。"
  },
  {
    "surah_id": 37,
    "ayah_number": 128,
    "global_ayah_id": 3916,
    "translation": "（かれらの中）敬虔な，アッラーのしもべは別である。"
  },
  {
    "surah_id": 37,
    "ayah_number": 129,
    "global_ayah_id": 3917,
    "translation": "われは後の幾世代に渡り，かれのために（この祝福を）留めた。"
  },
  {
    "surah_id": 37,
    "ayah_number": 130,
    "global_ayah_id": 3918,
    "translation": "「イルヤースに平安あれ。」（と言って）。"
  },
  {
    "surah_id": 37,
    "ayah_number": 131,
    "global_ayah_id": 3919,
    "translation": "このようにわれは，正しい行いをする者に報いる。"
  },
  {
    "surah_id": 37,
    "ayah_number": 132,
    "global_ayah_id": 3920,
    "translation": "本当にかれは信心深いわがしもべであった。"
  },
  {
    "surah_id": 37,
    "ayah_number": 133,
    "global_ayah_id": 3921,
    "translation": "ルートも（われが）遣わした者であった。"
  },
  {
    "surah_id": 37,
    "ayah_number": 134,
    "global_ayah_id": 3922,
    "translation": "見よ，われはかれとその家族の凡てを救った。"
  },
  {
    "surah_id": 37,
    "ayah_number": 135,
    "global_ayah_id": 3923,
    "translation": "後に残る者の中にいた，老婆の外は。"
  },
  {
    "surah_id": 37,
    "ayah_number": 136,
    "global_ayah_id": 3924,
    "translation": "そうしてわれは，外の者を滅ぼしてしまった。"
  },
  {
    "surah_id": 37,
    "ayah_number": 137,
    "global_ayah_id": 3925,
    "translation": "あなたがたはかれらの（遺跡の）傍らを，昼"
  },
  {
    "surah_id": 37,
    "ayah_number": 138,
    "global_ayah_id": 3926,
    "translation": "夜通っている。あなたがたはそれでも悟らないのか。"
  },
  {
    "surah_id": 37,
    "ayah_number": 139,
    "global_ayah_id": 3927,
    "translation": "本当にユーヌスも，使徒であった。"
  },
  {
    "surah_id": 37,
    "ayah_number": 140,
    "global_ayah_id": 3928,
    "translation": "かれが（荷を）満載した舟に（乗って）逃れた時，"
  },
  {
    "surah_id": 37,
    "ayah_number": 141,
    "global_ayah_id": 3929,
    "translation": "かれは籤を引いて，負けてしまった。"
  },
  {
    "surah_id": 37,
    "ayah_number": 142,
    "global_ayah_id": 3930,
    "translation": "（そして海に投げ込まれると）大魚に丸呑みにされ，かれは自責の念にかられた。"
  },
  {
    "surah_id": 37,
    "ayah_number": 143,
    "global_ayah_id": 3931,
    "translation": "かれが（梅悟して主を）讃えなかったならば，"
  },
  {
    "surah_id": 37,
    "ayah_number": 144,
    "global_ayah_id": 3932,
    "translation": "かれら（人びと）が（復活して）起こされる日まで，必ずかれは魚の腹の中に留まったであろう"
  },
  {
    "surah_id": 37,
    "ayah_number": 145,
    "global_ayah_id": 3933,
    "translation": "だがわれは，荒れ果てた（岸辺）にかれを打ち上げた。かれは病んでいた。"
  },
  {
    "surah_id": 37,
    "ayah_number": 146,
    "global_ayah_id": 3934,
    "translation": "われはかれの上に，1本のヒサゴ木を繁らせ（影を作った）。"
  },
  {
    "surah_id": 37,
    "ayah_number": 147,
    "global_ayah_id": 3935,
    "translation": "そして10万人，またはそれ以上（の民）にかれを遣わした。"
  },
  {
    "surah_id": 37,
    "ayah_number": 148,
    "global_ayah_id": 3936,
    "translation": "かれらが信仰に入ったので，われはしばし現世の享楽を許した。"
  },
  {
    "surah_id": 37,
    "ayah_number": 149,
    "global_ayah_id": 3937,
    "translation": "さてかれらに問え。「あなたがたの主は娘を持ち，かれら（マッカの多神教徒）は息子を持つというのか。"
  },
  {
    "surah_id": 37,
    "ayah_number": 150,
    "global_ayah_id": 3938,
    "translation": "それともかれらは，われが天使たちを女に創ったと証言するのか。」"
  },
  {
    "surah_id": 37,
    "ayah_number": 151,
    "global_ayah_id": 3939,
    "translation": "見よ，かれらの言うことは作りごとである。"
  },
  {
    "surah_id": 37,
    "ayah_number": 152,
    "global_ayah_id": 3940,
    "translation": "アッラーが子を生まれるとは，かれらも嘘付きの徒である。"
  },
  {
    "surah_id": 37,
    "ayah_number": 153,
    "global_ayah_id": 3941,
    "translation": "かれは息子よりも，娘を選ばれるとするのか。"
  },
  {
    "surah_id": 37,
    "ayah_number": 154,
    "global_ayah_id": 3942,
    "translation": "どうしたのか。あなたがたはどう判断するのか。"
  },
  {
    "surah_id": 37,
    "ayah_number": 155,
    "global_ayah_id": 3943,
    "translation": "あなたがたはなお訓戒を受け入れないのか。"
  },
  {
    "surah_id": 37,
    "ayah_number": 156,
    "global_ayah_id": 3944,
    "translation": "それともあなたがたに明瞭な権能があるのか。"
  },
  {
    "surah_id": 37,
    "ayah_number": 157,
    "global_ayah_id": 3945,
    "translation": "あなたがたのいうことが真実ならば，あなたがたの啓典を出してみなさい。"
  },
  {
    "surah_id": 37,
    "ayah_number": 158,
    "global_ayah_id": 3946,
    "translation": "かれらは，かれとジンは親類であるといっている。だがジンは自分たちが（懲罰に）臨むことをよく知っている。"
  },
  {
    "surah_id": 37,
    "ayah_number": 159,
    "global_ayah_id": 3947,
    "translation": "アッラーに讃えあれ。（かれは）かれらが配するものから（超絶なされる）。"
  },
  {
    "surah_id": 37,
    "ayah_number": 160,
    "global_ayah_id": 3948,
    "translation": "だが謙虚に奉仕するアッラーのしもべたちは，別である。"
  },
  {
    "surah_id": 37,
    "ayah_number": 161,
    "global_ayah_id": 3949,
    "translation": "だがあなたがたにしても，あなたがたが崇拝するものでも，"
  },
  {
    "surah_id": 37,
    "ayah_number": 162,
    "global_ayah_id": 3950,
    "translation": "かれに反抗して（信者たちを）誘惑することが出来ようか。"
  },
  {
    "surah_id": 37,
    "ayah_number": 163,
    "global_ayah_id": 3951,
    "translation": "燃え盛る火で，焼かれる者は別にして。"
  },
  {
    "surah_id": 37,
    "ayah_number": 164,
    "global_ayah_id": 3952,
    "translation": "（整列している者たちが言う。）「わたしたちは各々定めの部署を持っています。"
  },
  {
    "surah_id": 37,
    "ayah_number": 165,
    "global_ayah_id": 3953,
    "translation": "わたしたちは（奉仕のため）整列して，"
  },
  {
    "surah_id": 37,
    "ayah_number": 166,
    "global_ayah_id": 3954,
    "translation": "慎んで（アッラーを）讃え唱念します。」"
  },
  {
    "surah_id": 37,
    "ayah_number": 167,
    "global_ayah_id": 3955,
    "translation": "また，かれらはいつも言っていた。"
  },
  {
    "surah_id": 37,
    "ayah_number": 168,
    "global_ayah_id": 3956,
    "translation": "「もしわたしたちが，昔から訓戒を持っていたなら，"
  },
  {
    "surah_id": 37,
    "ayah_number": 169,
    "global_ayah_id": 3957,
    "translation": "わたしたちも，確かにアッラーの謙虚なしもべであったでしょう。」"
  },
  {
    "surah_id": 37,
    "ayah_number": 170,
    "global_ayah_id": 3958,
    "translation": "ところが（実際にクルアーンが与えられれば）それを拒否する。だが間もなくかれらは知るであろう。"
  },
  {
    "surah_id": 37,
    "ayah_number": 171,
    "global_ayah_id": 3959,
    "translation": "確かにわれの言葉は，わが遣わしたしもべたちに既に下されている。"
  },
  {
    "surah_id": 37,
    "ayah_number": 172,
    "global_ayah_id": 3960,
    "translation": "かれらは，必ず助けられよう。"
  },
  {
    "surah_id": 37,
    "ayah_number": 173,
    "global_ayah_id": 3961,
    "translation": "本当にわれの軍勢は，必ず勝利を得るのである。"
  },
  {
    "surah_id": 37,
    "ayah_number": 174,
    "global_ayah_id": 3962,
    "translation": "あなた（ムハンマド）はかれらから暫くの間遠ざかって，"
  },
  {
    "surah_id": 37,
    "ayah_number": 175,
    "global_ayah_id": 3963,
    "translation": "かれらを監視しなさい。やがて，かれらは目覚めるであろう。"
  },
  {
    "surah_id": 37,
    "ayah_number": 176,
    "global_ayah_id": 3964,
    "translation": "だがかれらは，わが懲罰を急ぎ求めている。"
  },
  {
    "surah_id": 37,
    "ayah_number": 177,
    "global_ayah_id": 3965,
    "translation": "だがそれが実際にかれらに下ると，それまで警告を受けているだけに寝覚めの悪い朝となろう。"
  },
  {
    "surah_id": 37,
    "ayah_number": 178,
    "global_ayah_id": 3966,
    "translation": "それであなたはかれらから暫くの間遠ざかって，"
  },
  {
    "surah_id": 37,
    "ayah_number": 179,
    "global_ayah_id": 3967,
    "translation": "かれらを監視しなさい。やがて，かれらも目覚めるであろう。"
  },
  {
    "surah_id": 37,
    "ayah_number": 180,
    "global_ayah_id": 3968,
    "translation": "あなたの主，威徳の主，かれらが配するものから（超絶なされる）主に讃えあれ。"
  },
  {
    "surah_id": 37,
    "ayah_number": 181,
    "global_ayah_id": 3969,
    "translation": "使徒たちに平安あれ。"
  },
  {
    "surah_id": 37,
    "ayah_number": 182,
    "global_ayah_id": 3970,
    "translation": "万有の主，アッラーに讃えあれ。"
  }
]