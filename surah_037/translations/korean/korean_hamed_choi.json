[
  {
    "surah_id": 37,
    "ayah_number": 1,
    "global_ayah_id": 3789,
    "translation": "스스로 열지어 선 그들로 하여 맹세하고"
  },
  {
    "surah_id": 37,
    "ayah_number": 2,
    "global_ayah_id": 3790,
    "translation": "사악함을 저지하는 그들로 하여 맹세하고"
  },
  {
    "surah_id": 37,
    "ayah_number": 3,
    "global_ayah_id": 3791,
    "translation": "하나님의 말씀을 염원하는 그들로 하여 맹세하나니"
  },
  {
    "surah_id": 37,
    "ayah_number": 4,
    "global_ayah_id": 3792,
    "translation": "실로 너희의 하나님은 흘로 계시니라"
  },
  {
    "surah_id": 37,
    "ayah_number": 5,
    "global_ayah_id": 3793,
    "translation": "그분은 하늘과 대지의 주님이시며 그 사이에 있는 만물과 동서 의 주님이시라"
  },
  {
    "surah_id": 37,
    "ayah_number": 6,
    "global_ayah_id": 3794,
    "translation": "하나님께서 지상의 하늘을 별 들로 아름답게 장식하였나니"
  },
  {
    "surah_id": 37,
    "ayah_number": 7,
    "global_ayah_id": 3795,
    "translation": "거역하는 모든 악마로부터 보 호하기 위해서라"
  },
  {
    "surah_id": 37,
    "ayah_number": 8,
    "global_ayah_id": 3796,
    "translation": "그리하여 그들은 천사들의 회의를 엿들을 수 없고 사방에서 화염의 돌을 맞으며"
  },
  {
    "surah_id": 37,
    "ayah_number": 9,
    "global_ayah_id": 3797,
    "translation": "쫓겨나 영원한 벌을 받으리라"
  },
  {
    "surah_id": 37,
    "ayah_number": 10,
    "global_ayah_id": 3798,
    "translation": "몰래 무엇인가 훔쳐가는 자 있다면 치솟는 화염의 불길이 그 를 추적하리라"
  },
  {
    "surah_id": 37,
    "ayah_number": 11,
    "global_ayah_id": 3799,
    "translation": "그들에게 물어보라 그들이 만든 것이 하나님이 창조한 것과 어느 것이 강하뇨 하나님은 그들 을 진흙으로 창조하였노라"
  },
  {
    "surah_id": 37,
    "ayah_number": 12,
    "global_ayah_id": 3800,
    "translation": "그대는 놀라고 감탄하나 그 들은 비웃고 있노라"
  },
  {
    "surah_id": 37,
    "ayah_number": 13,
    "global_ayah_id": 3801,
    "translation": "그들은 훈계를 받으나 주의 하지 아니하며"
  },
  {
    "surah_id": 37,
    "ayah_number": 14,
    "global_ayah_id": 3802,
    "translation": "그들은 예증을 지켜보나 조 롱하며"
  },
  {
    "surah_id": 37,
    "ayah_number": 15,
    "global_ayah_id": 3803,
    "translation": "이것은 분명한 마술에 불과 하다고 하더라"
  },
  {
    "surah_id": 37,
    "ayah_number": 16,
    "global_ayah_id": 3804,
    "translation": "우리가 죽어 흙과 뼈가 된 후 다시 부활된다는 말이뇨"
  },
  {
    "surah_id": 37,
    "ayah_number": 17,
    "global_ayah_id": 3805,
    "translation": "우리의 지나간 선조들도 그 렇게 된단 말이뇨"
  },
  {
    "surah_id": 37,
    "ayah_number": 18,
    "global_ayah_id": 3806,
    "translation": "일러가로되 그러하너라 그때너희는 너희의 사악함으로 인하여 비참하게 되리라"
  },
  {
    "surah_id": 37,
    "ayah_number": 19,
    "global_ayah_id": 3807,
    "translation": "그때 한 소리가 울려 퍼지리니 보라 그때 그들은 서로 보게 되매"
  },
  {
    "surah_id": 37,
    "ayah_number": 20,
    "global_ayah_id": 3808,
    "translation": "그들은 말하리라 슬프도다 이것이 심판의 날이구나"
  },
  {
    "surah_id": 37,
    "ayah_number": 21,
    "global_ayah_id": 3809,
    "translation": "이것이 바로 너희가 거역했 던 심판의 날이라"
  },
  {
    "surah_id": 37,
    "ayah_number": 22,
    "global_ayah_id": 3810,
    "translation": "불러 모으라 말씀이 있으니 죄인들과 그들의 아내들과 그들이 숭배했던 것들이라"
  },
  {
    "surah_id": 37,
    "ayah_number": 23,
    "global_ayah_id": 3811,
    "translation": "하나님 외에 숭배한 것들이 라 그리하여 하나님은 그들을 불 지옥으로 안내하여"
  },
  {
    "surah_id": 37,
    "ayah_number": 24,
    "global_ayah_id": 3812,
    "translation": "그들을 멈추게 하니 그들은 질문을 받게 되노라"
  },
  {
    "surah_id": 37,
    "ayah_number": 25,
    "global_ayah_id": 3813,
    "translation": "너희가 서로 돕지 못하는 것 은 어찌된 일이뇨"
  },
  {
    "surah_id": 37,
    "ayah_number": 26,
    "global_ayah_id": 3814,
    "translation": "그렇지 못하니라 그날 그들 은 심판에 복종하게 되나니"
  },
  {
    "surah_id": 37,
    "ayah_number": 27,
    "global_ayah_id": 3815,
    "translation": "그들은 서로 다가서며 서로 가 서로에게 질문하더라"
  },
  {
    "surah_id": 37,
    "ayah_number": 28,
    "global_ayah_id": 3816,
    "translation": "실로 너희가 오른편으로 부 터 우리에게 왔으며 라고 말하니"
  },
  {
    "surah_id": 37,
    "ayah_number": 29,
    "global_ayah_id": 3817,
    "translation": "아니라 너희 스스로가 믿음 이 없었노라"
  },
  {
    "surah_id": 37,
    "ayah_number": 30,
    "global_ayah_id": 3818,
    "translation": "우리는 너희를 다스릴 아무 런 힘도 없도다 그것은 오히려 너희가 오만한 백성중에 있었노라"
  },
  {
    "surah_id": 37,
    "ayah_number": 31,
    "global_ayah_id": 3819,
    "translation": "진리인 주님의 말씀이 입증 되었으니 이제 우리는 우리 죄에 대한 벌을 받아야 할 뿐이라"
  },
  {
    "surah_id": 37,
    "ayah_number": 32,
    "global_ayah_id": 3820,
    "translation": "실로 우리는 너희를 방황케 했으며 우리 스스로도 방황했노라"
  },
  {
    "surah_id": 37,
    "ayah_number": 33,
    "global_ayah_id": 3821,
    "translation": "실로 그들 모두는 그날 벌을받음에 함께 하리라"
  },
  {
    "surah_id": 37,
    "ayah_number": 34,
    "global_ayah_id": 3822,
    "translation": "하나님은 이렇듯 죄지은 자 를 다스리니"
  },
  {
    "surah_id": 37,
    "ayah_number": 35,
    "global_ayah_id": 3823,
    "translation": "하나님 외에 신이 없다는 말씀이 그들에게 있었을 때 그들은 오만하곤 하였으며"
  },
  {
    "surah_id": 37,
    "ayah_number": 36,
    "global_ayah_id": 3824,
    "translation": "제정신이 아닌 시인을 위하 여 우리의 신들을 포기해야 되느 뇨 라고 그들은 말했더라"
  },
  {
    "surah_id": 37,
    "ayah_number": 37,
    "global_ayah_id": 3825,
    "translation": "그렇지 않노라 그는 진리로 도래하여 선지자들을 확증하였노라"
  },
  {
    "surah_id": 37,
    "ayah_number": 38,
    "global_ayah_id": 3826,
    "translation": "실로 너희는 고통스러운 벌 을 맛볼 것이요"
  },
  {
    "surah_id": 37,
    "ayah_number": 39,
    "global_ayah_id": 3827,
    "translation": "너희가 행한 것으로 대가를 받으리라"
  },
  {
    "surah_id": 37,
    "ayah_number": 40,
    "global_ayah_id": 3828,
    "translation": "그러나 성실한 하나님의 종 들은 제의이며"
  },
  {
    "surah_id": 37,
    "ayah_number": 41,
    "global_ayah_id": 3829,
    "translation": "그들을 위해서는 알려진 일 용할 양식이 있으니"
  },
  {
    "surah_id": 37,
    "ayah_number": 42,
    "global_ayah_id": 3830,
    "translation": "기쁨의 과일들과 명예와 존 엄이 그것이라"
  },
  {
    "surah_id": 37,
    "ayah_number": 43,
    "global_ayah_id": 3831,
    "translation": "그들은 가장 축복받은 천국 에서"
  },
  {
    "surah_id": 37,
    "ayah_number": 44,
    "global_ayah_id": 3832,
    "translation": "옥좌에 앉아 서로 마주보고 앉아서"
  },
  {
    "surah_id": 37,
    "ayah_number": 45,
    "global_ayah_id": 3833,
    "translation": "흐르는 샘물에서 잔으로 순배를 들게 되나니"
  },
  {
    "surah_id": 37,
    "ayah_number": 46,
    "global_ayah_id": 3834,
    "translation": "그것은 수정같이 하얗고 마 시는 이들에게 맛이 있더라"
  },
  {
    "surah_id": 37,
    "ayah_number": 47,
    "global_ayah_id": 3835,
    "translation": "그것은 머리가 아프지 아니 하고 취하지도 않더라"
  },
  {
    "surah_id": 37,
    "ayah_number": 48,
    "global_ayah_id": 3836,
    "translation": "그들 주위에는 순결한 여성 들이 있나니 그녀의 눈은 잘 보호 되었고 눈은 크고 아름다우매"
  },
  {
    "surah_id": 37,
    "ayah_number": 49,
    "global_ayah_id": 3837,
    "translation": "마치 잘 보호받은 달걀과 같 더라"
  },
  {
    "surah_id": 37,
    "ayah_number": 50,
    "global_ayah_id": 3838,
    "translation": "그들은 서로 마주보며 서로 가 질문을 하니"
  },
  {
    "surah_id": 37,
    "ayah_number": 51,
    "global_ayah_id": 3839,
    "translation": "그 중에 한 사람이 말을 시 작하더라 현세에서 저에게 한 친 구가 있었는데"
  },
  {
    "surah_id": 37,
    "ayah_number": 52,
    "global_ayah_id": 3840,
    "translation": "그가 말하길 당신은 계시를 믿는자 중에 있느뇨"
  },
  {
    "surah_id": 37,
    "ayah_number": 53,
    "global_ayah_id": 3841,
    "translation": "우리가 죽어 흙이되고 뼈만 남는데도 보상과 벌을 받는단 말 이뇨"
  },
  {
    "surah_id": 37,
    "ayah_number": 54,
    "global_ayah_id": 3842,
    "translation": "이때 여러분이 내려다 보고 싶은가요 라는 한 음성이 들려와"
  },
  {
    "surah_id": 37,
    "ayah_number": 55,
    "global_ayah_id": 3843,
    "translation": "그가 내려와 보고 지옥에 있는 그 친구를 발견하고서"
  },
  {
    "surah_id": 37,
    "ayah_number": 56,
    "global_ayah_id": 3844,
    "translation": "그가 말하길 하나님께 맹세 하나니 너는 나를 멸망으로 유혹 하려 했노라"
  },
  {
    "surah_id": 37,
    "ayah_number": 57,
    "global_ayah_id": 3845,
    "translation": "내 주님의 은혜가 없었던들 실로 나는 그곳에 끌려온 자중에 있었으리라"
  },
  {
    "surah_id": 37,
    "ayah_number": 58,
    "global_ayah_id": 3846,
    "translation": "우리가 죽지 아니할 것이라 는 것은 그와 같지 않느뇨"
  },
  {
    "surah_id": 37,
    "ayah_number": 59,
    "global_ayah_id": 3847,
    "translation": "우리가 한번 죽으면 벌을 받지 아니할 것이라 생각했느뇨"
  },
  {
    "surah_id": 37,
    "ayah_number": 60,
    "global_ayah_id": 3848,
    "translation": "실로 이것은 최후의 승리라"
  },
  {
    "surah_id": 37,
    "ayah_number": 61,
    "global_ayah_id": 3849,
    "translation": "이러한 겄을 위하여 모든 인간은 노력해야 되니라"
  },
  {
    "surah_id": 37,
    "ayah_number": 62,
    "global_ayah_id": 3850,
    "translation": "그와 같은 환대가 더 나으뇨 아니면 자꾸무 나무가 더 나으뇨"
  },
  {
    "surah_id": 37,
    "ayah_number": 63,
    "global_ayah_id": 3851,
    "translation": "하나님은 죄인들을 위한 시 험으로 그것을 두었노라"
  },
  {
    "surah_id": 37,
    "ayah_number": 64,
    "global_ayah_id": 3852,
    "translation": "그것은 불지옥의 밑바닥에서 자라는 나무로"
  },
  {
    "surah_id": 37,
    "ayah_number": 65,
    "global_ayah_id": 3853,
    "translation": "열매를 맺는 새싹은 사탄의 우두머리들과 같으니"
  },
  {
    "surah_id": 37,
    "ayah_number": 66,
    "global_ayah_id": 3854,
    "translation": "그들은 그것을 먹어 배를 채우며"
  },
  {
    "surah_id": 37,
    "ayah_number": 67,
    "global_ayah_id": 3855,
    "translation": "그 위에 이글거리는 물이 더 하여 채워지고"
  },
  {
    "surah_id": 37,
    "ayah_number": 68,
    "global_ayah_id": 3856,
    "translation": "그들은 타오르는 불지옥으로 향하니라"
  },
  {
    "surah_id": 37,
    "ayah_number": 69,
    "global_ayah_id": 3857,
    "translation": "그들은 방황하는 그들의 선 조들을 발견하고"
  },
  {
    "surah_id": 37,
    "ayah_number": 70,
    "global_ayah_id": 3858,
    "translation": "서둘러 그들의 발자취를 따 랐노라"
  },
  {
    "surah_id": 37,
    "ayah_number": 71,
    "global_ayah_id": 3859,
    "translation": "그들 이전의 많은 선조들도 방황하고 있었더라"
  },
  {
    "surah_id": 37,
    "ayah_number": 72,
    "global_ayah_id": 3860,
    "translation": "하나님이 그들 가운데 한 선지자를 보내어 그들을 충고하도록 하였으니"
  },
  {
    "surah_id": 37,
    "ayah_number": 73,
    "global_ayah_id": 3861,
    "translation": "경고를 받고도 주의하지 아 니한 이들의 종말이 어떠 했더뇨"
  },
  {
    "surah_id": 37,
    "ayah_number": 74,
    "global_ayah_id": 3862,
    "translation": "그러나 하나님의 성실한 종 들은 제외라"
  },
  {
    "surah_id": 37,
    "ayah_number": 75,
    "global_ayah_id": 3863,
    "translation": "노아가 하나님에게 구원했을때 하나님이 그의 기도에 응하사"
  },
  {
    "surah_id": 37,
    "ayah_number": 76,
    "global_ayah_id": 3864,
    "translation": "큰 재앙으로부터 그와 그의가족을 구하고"
  },
  {
    "surah_id": 37,
    "ayah_number": 77,
    "global_ayah_id": 3865,
    "translation": "그의 자손으로 하여금 생존 케 하였노라"
  },
  {
    "surah_id": 37,
    "ayah_number": 78,
    "global_ayah_id": 3866,
    "translation": "하나님은 후에 을 세대들을 위해 그에게 축복을 남겨"
  },
  {
    "surah_id": 37,
    "ayah_number": 79,
    "global_ayah_id": 3867,
    "translation": "후세대 가운데 노아에게 평 안이 있도록 하였노라"
  },
  {
    "surah_id": 37,
    "ayah_number": 80,
    "global_ayah_id": 3868,
    "translation": "이처럼 하나님은 선을 행하 는 자들에게 보상하나니"
  },
  {
    "surah_id": 37,
    "ayah_number": 81,
    "global_ayah_id": 3869,
    "translation": "하나님의 충실한 한 종이었 노라"
  },
  {
    "surah_id": 37,
    "ayah_number": 82,
    "global_ayah_id": 3870,
    "translation": "그리고 하나님은 불신한 나 머지를 익사케 하였노라"
  },
  {
    "surah_id": 37,
    "ayah_number": 83,
    "global_ayah_id": 3871,
    "translation": "실로 그를 따르는 무리중에 아브라함이 있었노라"
  },
  {
    "surah_id": 37,
    "ayah_number": 84,
    "global_ayah_id": 3872,
    "translation": "그가 경건하 마음으로 주 께로 왔을 때"
  },
  {
    "surah_id": 37,
    "ayah_number": 85,
    "global_ayah_id": 3873,
    "translation": "아버지와 그의 백성에게 여 러분이 숭배하는 것이 무엇이뇨"
  },
  {
    "surah_id": 37,
    "ayah_number": 86,
    "global_ayah_id": 3874,
    "translation": "여러분이 숭배하는 그것은 하나님이 아닌 허위의 우상이 아 니더뇨"
  },
  {
    "surah_id": 37,
    "ayah_number": 87,
    "global_ayah_id": 3875,
    "translation": "만유의 주님에 관하여 여러 분은 어떻게 생라하느뇨"
  },
  {
    "surah_id": 37,
    "ayah_number": 88,
    "global_ayah_id": 3876,
    "translation": "그런 후 그는 별들을 쳐다 보고서"
  },
  {
    "surah_id": 37,
    "ayah_number": 89,
    "global_ayah_id": 3877,
    "translation": "말하길 실로 내 마음이 아프도다"
  },
  {
    "surah_id": 37,
    "ayah_number": 90,
    "global_ayah_id": 3878,
    "translation": "그러자 사람들이 등을 돌리 고 떠났더라"
  },
  {
    "surah_id": 37,
    "ayah_number": 91,
    "global_ayah_id": 3879,
    "translation": "그후 그가 그들의 신에게 다 가가 너희는 너희 앞에 마련된 음 식을 먹지 못하느뇨"
  },
  {
    "surah_id": 37,
    "ayah_number": 92,
    "global_ayah_id": 3880,
    "translation": "말을 하지 않는데 어떤 일이 있었느뇨"
  },
  {
    "surah_id": 37,
    "ayah_number": 93,
    "global_ayah_id": 3881,
    "translation": "그런 후 그는 다가가 오른 손으로 그것을 부수워 버렸더라"
  },
  {
    "surah_id": 37,
    "ayah_number": 94,
    "global_ayah_id": 3882,
    "translation": "그후 우상 숭배자들이 급히 서둘러 달려와 그를 대하니"
  },
  {
    "surah_id": 37,
    "ayah_number": 95,
    "global_ayah_id": 3883,
    "translation": "그가 말하길 여러분이 만든 우상을 숭배한단 말이뇨"
  },
  {
    "surah_id": 37,
    "ayah_number": 96,
    "global_ayah_id": 3884,
    "translation": "하나님께서 여러분을 창조하셨고 여러분이 만든 것도 그러하 다고 하니"
  },
  {
    "surah_id": 37,
    "ayah_number": 97,
    "global_ayah_id": 3885,
    "translation": "그들이 말하길 화덕을 만들어타오르는 불속으로 그를 던지라"
  },
  {
    "surah_id": 37,
    "ayah_number": 98,
    "global_ayah_id": 3886,
    "translation": "이것이 실패하니 그들은 다 른 음모를 꾸몄으나 하나님은 그 들을 가장 비천한 자들로 만들었 노라"
  },
  {
    "surah_id": 37,
    "ayah_number": 99,
    "global_ayah_id": 3887,
    "translation": "그가 말하길 나의 주님께로 가리니 그분께서 나를 인도하여 주실 것이라"
  },
  {
    "surah_id": 37,
    "ayah_number": 100,
    "global_ayah_id": 3888,
    "translation": "주여 저에게 순종할 자손을주옵소서"
  },
  {
    "surah_id": 37,
    "ayah_number": 101,
    "global_ayah_id": 3889,
    "translation": "그리하여 하나님은 인내하 며 순종할 아이가 있을 복음의 소 식을 그에게 주었노라"
  },
  {
    "surah_id": 37,
    "ayah_number": 102,
    "global_ayah_id": 3890,
    "translation": "아들의 나이가 그와 함께 일할 나이에 이르렀을 때 그가 말하길 내 아들아 너를 제단에 을 리라는 명령을 내가 꿈에서 보았 노라 너의 생각이 어떤지 알고 싶 구나 라고 하니 아들이 말하길 아 버지 당신께서 명령받은 대로 하 옵소서 하나님께서 인내하는 종으 로부터 원하신다면 당신께서 저를 발견할 것입니다 하였더라"
  },
  {
    "surah_id": 37,
    "ayah_number": 103,
    "global_ayah_id": 3891,
    "translation": "그 둘이서 하나님께 순종하고 그는 그로 하여금 그의 이마 를 숙이도록 했을 때"
  },
  {
    "surah_id": 37,
    "ayah_number": 104,
    "global_ayah_id": 3892,
    "translation": "하나님은 그를 불러 아브라함아"
  },
  {
    "surah_id": 37,
    "ayah_number": 105,
    "global_ayah_id": 3893,
    "translation": "그대는 이미 그 꿈을 이행 하였노라 하나님은 이렇듯 선을 행하는 자들에게 보상을 내리니라"
  },
  {
    "surah_id": 37,
    "ayah_number": 106,
    "global_ayah_id": 3894,
    "translation": "실로 이것은 분명한 하나의시험이었나니"
  },
  {
    "surah_id": 37,
    "ayah_number": 107,
    "global_ayah_id": 3895,
    "translation": "하나님은 훌륭한 희생으로 그를 대신하였노라"
  },
  {
    "surah_id": 37,
    "ayah_number": 108,
    "global_ayah_id": 3896,
    "translation": "하나님은 그에게 측복을 내려 후에 올 세대들의 기억속에 남 게 했노라"
  },
  {
    "surah_id": 37,
    "ayah_number": 109,
    "global_ayah_id": 3897,
    "translation": "아브라함에게 평안이 있을 것이라"
  },
  {
    "surah_id": 37,
    "ayah_number": 110,
    "global_ayah_id": 3898,
    "translation": "이렇듯 하나님은 선을 행하는 그들에게 보상을 내리니라"
  },
  {
    "surah_id": 37,
    "ayah_number": 111,
    "global_ayah_id": 3899,
    "translation": "그는 믿음이 강한 하나님의종들 중에 있었노라"
  },
  {
    "surah_id": 37,
    "ayah_number": 112,
    "global_ayah_id": 3900,
    "translation": "하나님은 그에게 의로운 자증에 있을 한 예언자 이삭의 소 식을 주어"
  },
  {
    "surah_id": 37,
    "ayah_number": 113,
    "global_ayah_id": 3901,
    "translation": "그와 그리고 이삭에게 축복을 내렸으나 그들의 후손 중의 무 리는 의로움을 행하였으되 다른 무리는 사악한 행위를 했었노라"
  },
  {
    "surah_id": 37,
    "ayah_number": 114,
    "global_ayah_id": 3902,
    "translation": "다시 하나님은 모세와 아론에게 은혜를 베풀었노라"
  },
  {
    "surah_id": 37,
    "ayah_number": 115,
    "global_ayah_id": 3903,
    "translation": "하나님은 그들과 그들의 백"
  },
  {
    "surah_id": 37,
    "ayah_number": 116,
    "global_ayah_id": 3904,
    "translation": "그들을 도왔으매 그들은 그재앙을 극복하였고"
  },
  {
    "surah_id": 37,
    "ayah_number": 117,
    "global_ayah_id": 3905,
    "translation": "그들에게 사실을 밝혀 주는성서를 주었으며"
  },
  {
    "surah_id": 37,
    "ayah_number": 118,
    "global_ayah_id": 3906,
    "translation": "그들을 옳은 길로 인도한 후"
  },
  {
    "surah_id": 37,
    "ayah_number": 119,
    "global_ayah_id": 3907,
    "translation": "그들에게 축복을 내려 후에올 세대들의 기억 속에 남게 하였 노라"
  },
  {
    "surah_id": 37,
    "ayah_number": 120,
    "global_ayah_id": 3908,
    "translation": "모세와 아론에게 평안이 있을 것이라"
  },
  {
    "surah_id": 37,
    "ayah_number": 121,
    "global_ayah_id": 3909,
    "translation": "하나님은 그와 같이 하여 선을 행하는 이들에게 보상을 내 리노라"
  },
  {
    "surah_id": 37,
    "ayah_number": 122,
    "global_ayah_id": 3910,
    "translation": "실로 그들은 믿음이 강한 우리 하나님의 종들 증 두 종이었 노라"
  },
  {
    "surah_id": 37,
    "ayah_number": 123,
    "global_ayah_id": 3911,
    "translation": "엘리야스도 하나님이 보 낸 선지자 중 한 선지자로"
  },
  {
    "surah_id": 37,
    "ayah_number": 124,
    "global_ayah_id": 3912,
    "translation": "그가 그의 백성들에게 너희는 하나님을 두려워 하지 않느뇨"
  },
  {
    "surah_id": 37,
    "ayah_number": 125,
    "global_ayah_id": 3913,
    "translation": "바을라를 숭배하고 가장 훌륭한 창조주를 버리느뇨"
  },
  {
    "surah_id": 37,
    "ayah_number": 126,
    "global_ayah_id": 3914,
    "translation": "하나님은 너희 주님이사 지나간 선조들의 주님이 아니더뇨 라고 말하였으나"
  },
  {
    "surah_id": 37,
    "ayah_number": 127,
    "global_ayah_id": 3915,
    "translation": "그들은 그에게 거역하였으 니 그들은 분명 불리워 갔으리라"
  },
  {
    "surah_id": 37,
    "ayah_number": 128,
    "global_ayah_id": 3916,
    "translation": "그러나 성실한 하나님의 종들은 그렇지 아니했노라"
  },
  {
    "surah_id": 37,
    "ayah_number": 129,
    "global_ayah_id": 3917,
    "translation": "하나님은 그에게 축복을 내려 후에 올 세대들의 기억속에 남 게 하였노라"
  },
  {
    "surah_id": 37,
    "ayah_number": 130,
    "global_ayah_id": 3918,
    "translation": "일리야스와 같은 이들에게 평안이 있을 것이라"
  },
  {
    "surah_id": 37,
    "ayah_number": 131,
    "global_ayah_id": 3919,
    "translation": "이렇듯 하나님은 선을 행하는 자들에게 보상을 베푸니라"
  },
  {
    "surah_id": 37,
    "ayah_number": 132,
    "global_ayah_id": 3920,
    "translation": "실로 그는 믿음이 강한 하 나님의 종 중의 한 종이었노라"
  },
  {
    "surah_id": 37,
    "ayah_number": 133,
    "global_ayah_id": 3921,
    "translation": "롯도 하나님이 보낸 선지 자 중 한 선지자로"
  },
  {
    "surah_id": 37,
    "ayah_number": 134,
    "global_ayah_id": 3922,
    "translation": "하나님은 그와 그리고 그의추종자 모두를 구하였노라"
  },
  {
    "surah_id": 37,
    "ayah_number": 135,
    "global_ayah_id": 3923,
    "translation": "그러나 뒤에 남은 한 늙은 여성은 제외되었노라"
  },
  {
    "surah_id": 37,
    "ayah_number": 136,
    "global_ayah_id": 3924,
    "translation": "그후 하나님은 나머지도 멸망케 했나니"
  },
  {
    "surah_id": 37,
    "ayah_number": 137,
    "global_ayah_id": 3925,
    "translation": "실로 너희가 아침이 되매 그들의 사적지를 지나갔노라"
  },
  {
    "surah_id": 37,
    "ayah_number": 138,
    "global_ayah_id": 3926,
    "translation": "저녁에도 그러하거늘 너희는 이해하지 못하느뇨"
  },
  {
    "surah_id": 37,
    "ayah_number": 139,
    "global_ayah_id": 3927,
    "translation": "요나도 하나님이 보낸 선 지자 중 한 선지자로"
  },
  {
    "surah_id": 37,
    "ayah_number": 140,
    "global_ayah_id": 3928,
    "translation": "그는 한 노예처럼 가득 실은 배로 도주하여"
  },
  {
    "surah_id": 37,
    "ayah_number": 141,
    "global_ayah_id": 3929,
    "translation": "점술을 던졌으니 그가 비난을 받았더라"
  },
  {
    "surah_id": 37,
    "ayah_number": 142,
    "global_ayah_id": 3930,
    "translation": "그때 큰 고기가 그를 삼켜 버렸으니 이는 그의 비난받을 행 위 때문이었노라"
  },
  {
    "surah_id": 37,
    "ayah_number": 143,
    "global_ayah_id": 3931,
    "translation": "하나님께 영광이 있으소서 라고 그가 회개하지 아니했다면"
  },
  {
    "surah_id": 37,
    "ayah_number": 144,
    "global_ayah_id": 3932,
    "translation": "그는 분명 그 물고기 뱃속 에 부활의 그날까지 있었으리라"
  },
  {
    "surah_id": 37,
    "ayah_number": 145,
    "global_ayah_id": 3933,
    "translation": "하나님이 그를 불모의 해변으로 구제하니 그는 병들어 있었 더라"
  },
  {
    "surah_id": 37,
    "ayah_number": 146,
    "global_ayah_id": 3934,
    "translation": "하나님은 조롱박 나무가 그 의 위로 자라게 하였노라"
  },
  {
    "surah_id": 37,
    "ayah_number": 147,
    "global_ayah_id": 3935,
    "translation": "하나님이 십만명 이상의 백 성들에게 그를 보냈더니"
  },
  {
    "surah_id": 37,
    "ayah_number": 148,
    "global_ayah_id": 3936,
    "translation": "그들이 믿음을 가겼더라 그리하여 하나님은 그들에게 잠시동안 그들의 삶을 즐기도록 허락하였노라"
  },
  {
    "surah_id": 37,
    "ayah_number": 149,
    "global_ayah_id": 3937,
    "translation": "그대의 주님에게는 딸들만 있고 그들에게는 아들만 있는지 물어보라"
  },
  {
    "surah_id": 37,
    "ayah_number": 150,
    "global_ayah_id": 3938,
    "translation": "아니면 하나님이 천사를 여 성으로 창조한 것을 그들이 목격 이라도 했느뇨"
  },
  {
    "surah_id": 37,
    "ayah_number": 151,
    "global_ayah_id": 3939,
    "translation": "실로 그들이 말하는 것은 꾸며낸 것에 불과하니라"
  },
  {
    "surah_id": 37,
    "ayah_number": 152,
    "global_ayah_id": 3940,
    "translation": "하나님께서 자손을 낳는다 하니 그들은 거짓하는 자들이라"
  },
  {
    "surah_id": 37,
    "ayah_number": 153,
    "global_ayah_id": 3941,
    "translation": "하나님께서 아들보다 딸들 을 선택했단 말이뇨"
  },
  {
    "surah_id": 37,
    "ayah_number": 154,
    "global_ayah_id": 3942,
    "translation": "어떤 이유로 그렇게 판단하 느뇨"
  },
  {
    "surah_id": 37,
    "ayah_number": 155,
    "global_ayah_id": 3943,
    "translation": "너희는 교훈을 받지 아니했 더뇨"
  },
  {
    "surah_id": 37,
    "ayah_number": 156,
    "global_ayah_id": 3944,
    "translation": "아니면 너희가 어떤 분명한 권능이라도 있단 말이뇨"
  },
  {
    "surah_id": 37,
    "ayah_number": 157,
    "global_ayah_id": 3945,
    "translation": "너희가 진실이라면 권능을 입중하는 너희의 성서를 가져오라"
  },
  {
    "surah_id": 37,
    "ayah_number": 158,
    "global_ayah_id": 3946,
    "translation": "그들은 하나님과 영마 사이 가 혈연관계라고 꾸며대더라 그 러나 영마들은 자신들이 하나님 앞에 서지 아니하면 아니됨을 잘 알고 있노라"
  },
  {
    "surah_id": 37,
    "ayah_number": 159,
    "global_ayah_id": 3947,
    "translation": "그들이 묘사한 것과는 관계 가 없으신 하나님께 영광이 있으 소서"
  },
  {
    "surah_id": 37,
    "ayah_number": 160,
    "global_ayah_id": 3948,
    "translation": "그러나 성실한 하나님의 종 들은 그렇지 아니 하니라"
  },
  {
    "surah_id": 37,
    "ayah_number": 161,
    "global_ayah_id": 3949,
    "translation": "너희와 그리고 너희가 숭배 하는 우상들은"
  },
  {
    "surah_id": 37,
    "ayah_number": 162,
    "global_ayah_id": 3950,
    "translation": "어느 누구도 하나님에 관하 여 유혹할 수 없노라"
  },
  {
    "surah_id": 37,
    "ayah_number": 163,
    "global_ayah_id": 3951,
    "translation": "그러나 스스로 타오르는 불 지옥으로 가는 자는 제외라"
  },
  {
    "surah_id": 37,
    "ayah_number": 164,
    "global_ayah_id": 3952,
    "translation": "주어진 임무가 있는 우리는 어느 누구도 그렇지 아니하며"
  },
  {
    "surah_id": 37,
    "ayah_number": 165,
    "global_ayah_id": 3953,
    "translation": "우리는 줄을 지어"
  },
  {
    "surah_id": 37,
    "ayah_number": 166,
    "global_ayah_id": 3954,
    "translation": "하나님을 찬미하는 자들이라"
  },
  {
    "surah_id": 37,
    "ayah_number": 167,
    "global_ayah_id": 3955,
    "translation": "그러나 그렇게 말하는 자들은"
  },
  {
    "surah_id": 37,
    "ayah_number": 168,
    "global_ayah_id": 3956,
    "translation": "선조들로부터 우리에게 메 세지가 있었다면"
  },
  {
    "surah_id": 37,
    "ayah_number": 169,
    "global_ayah_id": 3957,
    "translation": "실로 우리는 성실한 하나님의 종들이 되었으리라"
  },
  {
    "surah_id": 37,
    "ayah_number": 170,
    "global_ayah_id": 3958,
    "translation": "이에 꾸란이 왔으나 그들은거역하였으니 그들은 곧 알게 되 리라"
  },
  {
    "surah_id": 37,
    "ayah_number": 171,
    "global_ayah_id": 3959,
    "translation": "하나님의 말씀은 그분의 종들을 통하여 이미 전하여 졌으니"
  },
  {
    "surah_id": 37,
    "ayah_number": 172,
    "global_ayah_id": 3960,
    "translation": "그들은 실로 승리하리라"
  },
  {
    "surah_id": 37,
    "ayah_number": 173,
    "global_ayah_id": 3961,
    "translation": "그리고 하나님의 군대는 정복을 할 것이니"
  },
  {
    "surah_id": 37,
    "ayah_number": 174,
    "global_ayah_id": 3962,
    "translation": "잠시 동안 그들로부터 떨어져"
  },
  {
    "surah_id": 37,
    "ayah_number": 175,
    "global_ayah_id": 3963,
    "translation": "그들을 지켜보라 그들도 지켜 보리라"
  },
  {
    "surah_id": 37,
    "ayah_number": 176,
    "global_ayah_id": 3964,
    "translation": "그들은 하나님의 벌을 서둘러 구함이뇨"
  },
  {
    "surah_id": 37,
    "ayah_number": 177,
    "global_ayah_id": 3965,
    "translation": "그러나 벌이 그들의 넓은 뜰에 이르니 경고받고 주의하지 아니한 사악한 자들의 아침이 비 천하더라"
  },
  {
    "surah_id": 37,
    "ayah_number": 178,
    "global_ayah_id": 3966,
    "translation": "그러므로 잠시 동안 그들로부터 떨어져"
  },
  {
    "surah_id": 37,
    "ayah_number": 179,
    "global_ayah_id": 3967,
    "translation": "그들을 지켜보라 그들도 지켜보리라"
  },
  {
    "surah_id": 37,
    "ayah_number": 180,
    "global_ayah_id": 3968,
    "translation": "영광과 권능으로 충만한 그대의 주님을 찬양하라 그분은 그 들이 묘사한 것과는 관계가 없노 라"
  },
  {
    "surah_id": 37,
    "ayah_number": 181,
    "global_ayah_id": 3969,
    "translation": "선지자들 위에 평안이 있을것이라"
  },
  {
    "surah_id": 37,
    "ayah_number": 182,
    "global_ayah_id": 3970,
    "translation": "만유의 주님이신 하나님이 여 찬미를 받으소서"
  }
]