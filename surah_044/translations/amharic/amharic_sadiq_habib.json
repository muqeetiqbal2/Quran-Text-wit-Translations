[
  {
    "surah_id": 44,
    "ayah_number": 1,
    "global_ayah_id": 4415,
    "translation": "ሐ.መ (ሓ ሚም)፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 2,
    "global_ayah_id": 4416,
    "translation": "አብራሪ በኾነው መጽሐፍ እንምላለን፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 3,
    "global_ayah_id": 4417,
    "translation": "እኛ (ቁርኣኑን) በተባረከች ሌሊት ውስጥ አወረድነው፡፡ እኛ አስፈራሪዎች ነበርንና፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 4,
    "global_ayah_id": 4418,
    "translation": "በውስጧ የተወሰነው ነገር ሁሉ ይልለያል፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 5,
    "global_ayah_id": 4419,
    "translation": "ከእኛ ዘንድ የኾነ ትእዛዝ ሲኾን (አወረድነው)፡፡ እኛ (መልክተኞችን) ላኪዎች ነበርን፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 6,
    "global_ayah_id": 4420,
    "translation": "ከጌታህ በኾነው ችሮታ (ተላኩ)፡፡ እነሆ እርሱ ሰሚው ዐዋቂው ነውና፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 7,
    "global_ayah_id": 4421,
    "translation": "የሰማያትና የምድር በመካከላቸውም ያለው ነገር ሁሉ ጌታ ከኾነው (ተላኩ)፡፡ የምታረጋግጡ እንደኾናችሁ (ነገሩ እንዳልነው መኾኑን እወቁ)፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 8,
    "global_ayah_id": 4422,
    "translation": "ከእርሱ ሌላ አምላክ የለም፡፡ ሕያው ያደርጋል፡፡ ይገድላልም፡፡ ጌታችሁ የመጀመሪያዎቹ አባቶቻችሁም ጌታ ነው፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 9,
    "global_ayah_id": 4423,
    "translation": "በእውነቱ እነርሱ የሚጫወቱ ሲኾኑ በመጠራጠር ውስጥ ናቸው፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 10,
    "global_ayah_id": 4424,
    "translation": "ሰማይም በግልጽ ጭስ የምትመጣበትን ቀን ተጠባበቅ፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 11,
    "global_ayah_id": 4425,
    "translation": "ሰዎችን የሚሸፍን (በኾነ ጭስ) ይህ አሳማሚ ቅጣት ነው፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 12,
    "global_ayah_id": 4426,
    "translation": "«ጌታችን ሆይ! ከእኛ ላይ ቅጣቱን ግለጥልን፡፡ እኛ አማኞች እንኾናለንና» (ይላሉም)፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 13,
    "global_ayah_id": 4427,
    "translation": "(ቅጣቱ በወረደ ጊዜ) ለእነርሱ መግገሰጽ እንዴት ይኖራቸዋል? አስረጅ መልክተኛ የመጣቸው ሲኾን (የካዱም ሲኾኑ)፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 14,
    "global_ayah_id": 4428,
    "translation": "ከዚያም ከእርሱ የዞሩ፤ (ከሰው) «የተሰተማረ ዕብድ ነው» ያሉም ሲኾኑ፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 15,
    "global_ayah_id": 4429,
    "translation": "እኛ ቅጣቱን ለጥቂት ጊዜ ገላጮች ነን፡፡ እናንተ (ወደ ክህደታችሁ) በእርግጥ ተመላሾች ናችሁ፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 16,
    "global_ayah_id": 4430,
    "translation": "ታላቂቱን ብርቱ አያያዝ በምንይዝበት ቀን፤ እኛ ተበቃዮች ነን፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 17,
    "global_ayah_id": 4431,
    "translation": "ከእነርሱም በፊት የፈርዖንን ሕዝቦች በእርግጥ ሞከርን፡፡ ክቡር መልእክተኛም መጣላቸው፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 18,
    "global_ayah_id": 4432,
    "translation": "«የአላህን ባሮች ወደኔ አድርሱ፡፡ እኔ ለእናንተ ታማኝ መልክተኛ ነኝና፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 19,
    "global_ayah_id": 4433,
    "translation": "«በአላህም ላይ አትኩሩ፡፡ እኔ ግልጽ የኾነን አስረጅ ያመጣሁላችሁ ነኝና (በማለት መጣላቸው)፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 20,
    "global_ayah_id": 4434,
    "translation": "«እኔም እንዳትወግሩኝ በጌታየና በጌታችሁ ተጠብቂያለሁ፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 21,
    "global_ayah_id": 4435,
    "translation": "«በእኔም ባታምኑ ራቁኝ» (ተዉኝ አለ)፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 22,
    "global_ayah_id": 4436,
    "translation": "ቀጥሎም (ስለ ዛቱበት) «እነዚህ አመጸኞች ሕዝቦች ናቸው» (አጥፋቸው) ሲል ጌታውን ለመነ፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 23,
    "global_ayah_id": 4437,
    "translation": "(ጌታው) «ባሮቼንም ይዘህ በሌሊት ኺድ፡፡ እናንተ የሚከተሉዋችሁ ናችሁና፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 24,
    "global_ayah_id": 4438,
    "translation": "«ባሕሩንም የተከፈተ ኾኖ ተወው፡፡ እነርሱ የሚሰጥጠሙ ሰራዊት ናቸውና» (አለው)፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 25,
    "global_ayah_id": 4439,
    "translation": "ከአትክልቶችና ከምንጮችም ብዙ ነገሮችን ተዉ፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 26,
    "global_ayah_id": 4440,
    "translation": "ከአዝመራዎችም ከመልካም መቀመጫም፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 27,
    "global_ayah_id": 4441,
    "translation": "በእርሷ ተደሳቾች ከነበሩባትም ድሎት (ብዙን ነገር ተዉ)፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 28,
    "global_ayah_id": 4442,
    "translation": "(ነገሩ) እንደዚሁ ኾነ፡፡ ሌሎችንም ሕዝቦች አወረስናት፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 29,
    "global_ayah_id": 4443,
    "translation": "ሰማይና ምድርም በእነርሱ ላይ አላለቀሱም፡፡ የሚቆዩም አልነበሩም፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 30,
    "global_ayah_id": 4444,
    "translation": "የእስራኤልንም ልጆች አዋራጅ ከኾነ ስቃይ በእርግጥ አዳንናቸው፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 31,
    "global_ayah_id": 4445,
    "translation": "ከፈርዖን፤ እርሱ የኮራ ከወሰን አላፊዎቹ ነበርና፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 32,
    "global_ayah_id": 4446,
    "translation": "ከማወቅም ጋር በዓለማት ላይ በእርግጥ መረጥናቸው፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 33,
    "global_ayah_id": 4447,
    "translation": "ከታምራቶችም በውስጡ ግልጽ የኾነ ፈተና ያለበትን ሰጠናቸው፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 34,
    "global_ayah_id": 4448,
    "translation": "እነዚህ (የመካ ከሓዲዎች) በእርግጥ ይላሉ፡-"
  },
  {
    "surah_id": 44,
    "ayah_number": 35,
    "global_ayah_id": 4449,
    "translation": "እርሷ የፊተኛይቱ ሞታችን እንጅ አይደለችም፡፡ እኛም የምንቀሰቀስ አይደለንም፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 36,
    "global_ayah_id": 4450,
    "translation": "እውነተኞችም እንደ ኾናችሁ አባቶቻችንን አምጡልን፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 37,
    "global_ayah_id": 4451,
    "translation": "እነርሱ በላጮች ናቸውን ወይስ የቱብበዕ ሕዝቦችና እነዚያ ከእነርሱ በፊት የነበሩት? አጠፋናቸው፡፡ እነርሱ አመጸኞች ነበሩና፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 38,
    "global_ayah_id": 4452,
    "translation": "ሰማያትንና ምድርንም በሁለቱ መካከል ያለውንም ሁሉ ቀላጆች ኾነን አልፈጠርንም፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 39,
    "global_ayah_id": 4453,
    "translation": "ሁለቱንም በምር እንጅ አልፈጠርናቸውም፡፡ ግን አብዛኞቻቸው አያውቁም፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 40,
    "global_ayah_id": 4454,
    "translation": "የመለያው ቀን ለሁሉም ቀጠሯቸው ነው፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 41,
    "global_ayah_id": 4455,
    "translation": "ዘመድ ከዘመዱ ምንንም የማይጠቅምበት እነርሱም የማይርረዱበት ቀን ነው፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 42,
    "global_ayah_id": 4456,
    "translation": "አላህ ያዘነለት ሰውና ያመነ ብቻ ሲቀር፡፡ (እርሱስ ይርረዳል)፡፡ እርሱ አሸናፊው አዛኙ ነውና፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 43,
    "global_ayah_id": 4457,
    "translation": "የዘቁመ ዛፍ"
  },
  {
    "surah_id": 44,
    "ayah_number": 44,
    "global_ayah_id": 4458,
    "translation": "የኀጢኣተኛው ምግብ ነው፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 45,
    "global_ayah_id": 4459,
    "translation": "እንደ ዘይት አተላ ነው፡፡ በሆዶች ውስጥ የሚፈላ ሲኾን፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 46,
    "global_ayah_id": 4460,
    "translation": "እንደ ገነፈለ ውሃ አፈላል (የሚፈላ ሲኾን)፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 47,
    "global_ayah_id": 4461,
    "translation": "ያዙት፤ ወደ ገሀነም መካከልም በኀይል ጎትቱት፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 48,
    "global_ayah_id": 4462,
    "translation": "ከዚያም «ከራሱ በላይ ከፈላ ውሃ ስቃይ አንቧቡበት፡፡»"
  },
  {
    "surah_id": 44,
    "ayah_number": 49,
    "global_ayah_id": 4463,
    "translation": "«ቅመስ፤ አንተ አሸናፊው ክብሩ ነህና» (ይባላል)፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 50,
    "global_ayah_id": 4464,
    "translation": "«ይህ ያ በእርሱ ትጠራጠሩበት የነበራችሁት ነው» (ይባላሉ)፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 51,
    "global_ayah_id": 4465,
    "translation": "ጥንቁቆቹ በእርግጥ በጸጥተኛ መኖሪያ ውስጥ ናቸው፡፡"
  },
  {
    "surah_id": 44,
    "ayah_number": 52,
    "global_ayah_id": 4466,
    "translation": "በአትክልቶችና በምንጮች ውስጥ ናቸው፡፡"
