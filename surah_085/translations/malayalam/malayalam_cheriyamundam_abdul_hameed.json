[
  {
    "surah_id": 85,
    "ayah_number": 1,
    "global_ayah_id": 5910,
    "translation": "നക്ഷത്രമണ്ഡലങ്ങളുള്ള ആകാശം തന്നെയാണ സത്യം."
  },
  {
    "surah_id": 85,
    "ayah_number": 2,
    "global_ayah_id": 5911,
    "translation": "വാഗ്ദാനം ചെയ്യപ്പെട്ട ആ ദിവസം തന്നെയാണ സത്യം."
  },
  {
    "surah_id": 85,
    "ayah_number": 3,
    "global_ayah_id": 5912,
    "translation": "സാക്ഷിയും സാക്ഷ്യം വഹിക്കപ്പെടുന്ന കാര്യവും തന്നെയാണ സത്യം."
  },
  {
    "surah_id": 85,
    "ayah_number": 4,
    "global_ayah_id": 5913,
    "translation": "ആ കിടങ്ങിന്‍റെ ആള്‍ക്കാര്‍ നശിച്ചു പോകട്ടെ."
  },
  {
    "surah_id": 85,
    "ayah_number": 5,
    "global_ayah_id": 5914,
    "translation": "അതായത് വിറകു നിറച്ച തീയുടെ ആള്‍ക്കാര്‍."
  },
  {
    "surah_id": 85,
    "ayah_number": 6,
    "global_ayah_id": 5915,
    "translation": "അവര്‍ അതിങ്കല്‍ ഇരിക്കുന്നവരായിരുന്ന സന്ദര്‍ഭം."
  },
  {
    "surah_id": 85,
    "ayah_number": 7,
    "global_ayah_id": 5916,
    "translation": "സത്യവിശ്വാസികളെക്കൊണ്ട് തങ്ങള്‍ ചെയ്യുന്നതിന് അവര്‍ ദൃക്‌സാക്ഷികളായിരുന്നു."
  },
  {
    "surah_id": 85,
    "ayah_number": 8,
    "global_ayah_id": 5917,
    "translation": "പ്രതാപശാലിയും സ്തുത്യര്‍ഹനുമായ അല്ലാഹുവില്‍ അവര്‍ വിശ്വസിക്കുന്നു എന്നത് മാത്രമായിരുന്നു അവരുടെ (സത്യവിശ്വാസികളുടെ) മേല്‍ അവര്‍ (മര്‍ദ്ദകര്‍) ചുമത്തിയ കുറ്റം."
  },
  {
    "surah_id": 85,
    "ayah_number": 9,
    "global_ayah_id": 5918,
    "translation": "ആകാശങ്ങളുടെയും ഭൂമിയുടെയും മേല്‍ ആധിപത്യം ഉള്ളവനുമായ (അല്ലാഹുവില്‍). അല്ലാഹു എല്ലാകാര്യത്തിനും സാക്ഷിയാകുന്നു."
  },
  {
    "surah_id": 85,
    "ayah_number": 10,
    "global_ayah_id": 5919,
    "translation": "സത്യവിശ്വാസികളെയും സത്യവിശ്വാസിനികളെയും മര്‍ദ്ദിക്കുകയും, പിന്നീട് പശ്ചാത്തപിക്കാതിരിക്കുകയും ചെയ്തവരാരോ അവര്‍ക്കു നരകശിക്ഷയുണ്ട്‌. തീര്‍ച്ച. അവര്‍ക്ക് ചുട്ടുകരിക്കുന്ന ശിക്ഷയുണ്ട്‌."
  },
  {
    "surah_id": 85,
    "ayah_number": 11,
    "global_ayah_id": 5920,
    "translation": "വിശ്വസിക്കുകയും സല്‍കര്‍മ്മങ്ങള്‍ പ്രവര്‍ത്തിക്കുകയും ചെയ്തവരാരോ അവര്‍ക്ക് താഴ്ഭാഗത്തുകൂടി അരുവികള്‍ ഒഴുകുന്ന സ്വര്‍ഗത്തോപ്പുകളുണ്ട്‌; തീര്‍ച്ച. അതത്രെ വലിയ വിജയം."
  },
  {
    "surah_id": 85,
    "ayah_number": 12,
    "global_ayah_id": 5921,
    "translation": "തീര്‍ച്ചയായും നിന്‍റെ രക്ഷിതാവിന്‍റെ പിടുത്തം കഠിനമായത് തന്നെയാകുന്നു."
  },
  {
    "surah_id": 85,
    "ayah_number": 13,
    "global_ayah_id": 5922,
    "translation": "തീര്‍ച്ചയായും അവന്‍ തന്നെയാണ് ആദ്യമായി ഉണ്ടാക്കുന്നതും ആവര്‍ത്തിച്ച് ഉണ്ടാക്കുന്നതും."
  },
  {
    "surah_id": 85,
    "ayah_number": 14,
    "global_ayah_id": 5923,
    "translation": "അവന്‍ ഏറെ പൊറുക്കുന്നവനും ഏറെ സ്നേഹമുള്ളവനും,"
  },
  {
    "surah_id": 85,
    "ayah_number": 15,
    "global_ayah_id": 5924,
    "translation": "സിംഹാസനത്തിന്‍റെ ഉടമയും, മഹത്വമുള്ളവനും,"
  },
  {
    "surah_id": 85,
    "ayah_number": 16,
    "global_ayah_id": 5925,
    "translation": "താന്‍ ഉദ്ദേശിക്കുന്നതെന്തോ അത് തികച്ചും പ്രാവര്‍ത്തികമാക്കുന്നവനുമാണ്‌."
  },
  {
    "surah_id": 85,
    "ayah_number": 17,
    "global_ayah_id": 5926,
    "translation": "ആ സൈന്യങ്ങളുടെ വര്‍ത്തമാനം നിനക്ക് വന്നുകിട്ടിയിരിക്കുന്നോ?"
  },
  {
    "surah_id": 85,
    "ayah_number": 18,
    "global_ayah_id": 5927,
    "translation": "അഥവാ ഫിര്‍ഔന്‍റെയും ഥമൂദിന്‍റെയും (വര്‍ത്തമാനം)."
  },
  {
    "surah_id": 85,
    "ayah_number": 19,
    "global_ayah_id": 5928,
    "translation": "അല്ല, സത്യനിഷേധികള്‍ നിഷേധിച്ചു തള്ളുന്നതിലാകുന്നു ഏര്‍പെട്ടിട്ടുള്ളത്‌."
  },
  {
    "surah_id": 85,
    "ayah_number": 20,
    "global_ayah_id": 5929,
    "translation": "അല്ലാഹു അവരുടെ പിന്‍വശത്തുകൂടി (അവരെ) വലയം ചെയ്തുകൊണ്ടിരിക്കുന്നവനാകുന്നു."
  },
  {
    "surah_id": 85,
    "ayah_number": 21,
    "global_ayah_id": 5930,
    "translation": "അല്ല, അത് മഹത്വമേറിയ ഒരു ഖുര്‍ആനാകുന്നു."
  },
  {
    "surah_id": 85,
    "ayah_number": 22,
    "global_ayah_id": 5931,
    "translation": "സംരക്ഷിതമായ ഒരു ഫലകത്തിലാണ് അതുള്ളത്‌."
  }
]