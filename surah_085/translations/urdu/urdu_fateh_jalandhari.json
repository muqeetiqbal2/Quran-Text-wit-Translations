  {
    "surah_id": 85,
    "ayah_number": 8,
    "global_ayah_id": 6001,
    "translation": " اور انہوں نے اس پر محض اس وجہ سے «<a href=449> غصہ </a>» نکالا کہ وہ ایمان لائے اس\nخدائے عزیز وحمید پر ۔ "
  },
  {
    "surah_id": 85,
    "ayah_number": 9,
    "global_ayah_id": 6002,
    "translation": " جس کی ہی «<a href=72> بادشاہی </a>» ہے آسمانوں اور «<a href=379> زمین </a>» میں اور\nاللہ ہر چیز کو دیکھ رہا ہے ۔ "
  },
  {
    "surah_id": 85,
    "ayah_number": 10,
    "global_ayah_id": 6003,
    "translation": " «<a href=236> جن </a>» لوگوں نے مؤمن مردوں اور مؤمن عورتوں کو ستایا پھر توبہ نہ کی\n، ان کیلئے لازماً جہنم کی سزا اور جلنے کا «<a href=440> عذاب </a>» ہے ۔ "
  },
  {
    "surah_id": 85,
    "ayah_number": 11,
    "global_ayah_id": 6004,
    "translation": " البتہ جو پختہ ایمان لائے اور انہوں نے «<a href=634> نیک </a>» عمل کیے ، ان کیلئے\n«<a href=78> باغ </a>» ہوں گے «<a href=236> جن </a>» میں نہریں جاری ہوں گی ۔ بڑی کامیابی دراصل یہ ہے! "
  },
  {
    "surah_id": 85,
    "ayah_number": 12,
    "global_ayah_id": 6005,
    "translation": " بیشک تیرے رب کی پکڑ بڑی ہی «<a href=391> سخت </a>» ہے ۔ "
