  {
    "surah_id": 85,
    "ayah_number": 14,
    "global_ayah_id": 6007,
    "translation": " اور وہ بخشنے والا ، پیار کرنے والا ہے ۔ "
  },
  {
    "surah_id": 85,
    "ayah_number": 15,
    "global_ayah_id": 6008,
    "translation": " عرش کا «<a href=564> مالک </a>» ، عظمت والا "
  },
  {
    "surah_id": 85,
    "ayah_number": 16,
    "global_ayah_id": 6009,
    "translation": " جو چاہے کر ڈالنے والا! "
  },
  {
    "surah_id": 85,
    "ayah_number": 17,
    "global_ayah_id": 6010,
    "translation": " تجھے لشکروں کی «<a href=293> خبر </a>» پہنچی ہے؟ "
