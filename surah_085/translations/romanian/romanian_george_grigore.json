[
  {
    "surah_id": 85,
    "ayah_number": 1,
    "global_ayah_id": 5910,
    "translation": "Pe cer cu zodiile sale!"
  },
  {
    "surah_id": 85,
    "ayah_number": 2,
    "global_ayah_id": 5911,
    "translation": "Pe Ziua făgăduită!"
  },
  {
    "surah_id": 85,
    "ayah_number": 3,
    "global_ayah_id": 5912,
    "translation": "Pe martor şi pe mărturisit!"
  },
  {
    "surah_id": 85,
    "ayah_number": 4,
    "global_ayah_id": 5913,
    "translation": "Moarte stăpânilor peste Ukhdud"
  },
  {
    "surah_id": 85,
    "ayah_number": 5,
    "global_ayah_id": 5914,
    "translation": "unde focul are ceea ce arde,"
  },
  {
    "surah_id": 85,
    "ayah_number": 6,
    "global_ayah_id": 5915,
    "translation": "în vreme ce ei stau acolo"
  },
  {
    "surah_id": 85,
    "ayah_number": 7,
    "global_ayah_id": 5916,
    "translation": "martori a ceea ce le făceau credincioşilor"
  },
  {
    "surah_id": 85,
    "ayah_number": 8,
    "global_ayah_id": 5917,
    "translation": "răzbunându-se pe ei doar fiindcă au crezut în Dumnezeu, Puternicul, Lăudatul,"
  },
  {
    "surah_id": 85,
    "ayah_number": 9,
    "global_ayah_id": 5918,
    "translation": "Cel ce are împărăţia cerurilor şi a pământului. Dumnezeu, Cel ce, asupra tuturor, este Martor!"
  },
  {
    "surah_id": 85,
    "ayah_number": 10,
    "global_ayah_id": 5919,
    "translation": "Cei care îi duc în ispită pe credincioşi şi pe credincioase, iar apoi nu se căiesc, vor avea parte de osânda Gheenei, vor avea parte de osânda Pârjolului."
  },
  {
    "surah_id": 85,
    "ayah_number": 11,
    "global_ayah_id": 5920,
    "translation": "Cei care cred şi săvârşesc fapte bune, vor avea parte de Grădini pe sub care curg râuri: aceasta este izbânda cea mare!"
  },
  {
    "surah_id": 85,
    "ayah_number": 12,
    "global_ayah_id": 5921,
    "translation": "Asprimea Domnului tău este mare!"
  },
  {
    "surah_id": 85,
    "ayah_number": 13,
    "global_ayah_id": 5922,
    "translation": "El este La-iveală-dătătorul şi Inapoi-aducătorul."
  },
  {
    "surah_id": 85,
    "ayah_number": 14,
    "global_ayah_id": 5923,
    "translation": "El este Iertătorul, Iubitorul,"
  },
  {
    "surah_id": 85,
    "ayah_number": 15,
    "global_ayah_id": 5924,
    "translation": "Stăpânul slăvit al tronului,"
  },
  {
    "surah_id": 85,
    "ayah_number": 16,
    "global_ayah_id": 5925,
    "translation": "Făcătorul a ceea ce voieşte."
  },
  {
    "surah_id": 85,
    "ayah_number": 17,
    "global_ayah_id": 5926,
    "translation": "A venit la tine oare spusa despre oşti?"
  },
  {
    "surah_id": 85,
    "ayah_number": 18,
    "global_ayah_id": 5927,
    "translation": "Despre Faraon şi despre tamudiţi?"
  },
  {
    "surah_id": 85,
    "ayah_number": 19,
    "global_ayah_id": 5928,
    "translation": "Doar cei care tăgăduiesc hulesc,"
  },
  {
    "surah_id": 85,
    "ayah_number": 20,
    "global_ayah_id": 5929,
    "translation": "în vreme ce Dumnezeu, prin spate, îi cuprinde."
  },
  {
    "surah_id": 85,
    "ayah_number": 21,
    "global_ayah_id": 5930,
    "translation": "Acesta este un preaslăvit Coran"
  },
  {
    "surah_id": 85,
    "ayah_number": 22,
    "global_ayah_id": 5931,
    "translation": "de pe Tabla Păstrată!"
  }
]