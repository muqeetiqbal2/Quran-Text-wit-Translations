[
  {
    "surah_id": 85,
    "ayah_number": 1,
    "global_ayah_id": 5910,
    "translation": "Tako mi neba punog galaksija,"
  },
  {
    "surah_id": 85,
    "ayah_number": 2,
    "global_ayah_id": 5911,
    "translation": "I Dana obećanog,"
  },
  {
    "surah_id": 85,
    "ayah_number": 3,
    "global_ayah_id": 5912,
    "translation": "I svjedoka i svjedočenog:"
  },
  {
    "surah_id": 85,
    "ayah_number": 4,
    "global_ayah_id": 5913,
    "translation": "Prokleti neka su vlasnici rova,"
  },
  {
    "surah_id": 85,
    "ayah_number": 5,
    "global_ayah_id": 5914,
    "translation": "Vatre pune goriva,"
  },
  {
    "surah_id": 85,
    "ayah_number": 6,
    "global_ayah_id": 5915,
    "translation": "Kad su oni nad njom sjedili,"
  },
  {
    "surah_id": 85,
    "ayah_number": 7,
    "global_ayah_id": 5916,
    "translation": "I oni onome šta su činili vjernicima, svjedoci bili."
  },
  {
    "surah_id": 85,
    "ayah_number": 8,
    "global_ayah_id": 5917,
    "translation": "A svetili su im se samo što su vjerovali u Allaha, Moćnog, Hvaljenog,"
  },
  {
    "surah_id": 85,
    "ayah_number": 9,
    "global_ayah_id": 5918,
    "translation": "Onog čija je vlast nebesa i Zemlje! A Allah je nad svakom stvari Svjedok."
  },
  {
    "surah_id": 85,
    "ayah_number": 10,
    "global_ayah_id": 5919,
    "translation": "Uistinu, oni koji progone vjernike i vjernice, zatim se ne pokaju - pa imaće oni kaznu Džehennema, a njihova kazna je gorenje."
  },
  {
    "surah_id": 85,
    "ayah_number": 11,
    "global_ayah_id": 5920,
    "translation": "Uistinu, oni koji vjeruju i čine dobra djela, imaće oni bašče ispod kojih teku rijeke. To je uspjeh veliki."
  },
  {
    "surah_id": 85,
    "ayah_number": 12,
    "global_ayah_id": 5921,
    "translation": "Uistinu, sila Gospodara tvog je žestoka."
  },
  {
    "surah_id": 85,
    "ayah_number": 13,
    "global_ayah_id": 5922,
    "translation": "Uistinu, On, On počinje i ponavlja,"
  },
  {
    "surah_id": 85,
    "ayah_number": 14,
    "global_ayah_id": 5923,
    "translation": "I On je Oprosnik, Onaj koji voli,"
  },
  {
    "surah_id": 85,
    "ayah_number": 15,
    "global_ayah_id": 5924,
    "translation": "Vlasnik Arša, Slavni,"
  },
  {
    "surah_id": 85,
    "ayah_number": 16,
    "global_ayah_id": 5925,
    "translation": "Onaj koji čini šta želi."
  },
  {
    "surah_id": 85,
    "ayah_number": 17,
    "global_ayah_id": 5926,
    "translation": "Da li ti je došo hadis o vojskama,"
  },
  {
    "surah_id": 85,
    "ayah_number": 18,
    "global_ayah_id": 5927,
    "translation": "Faraonu i Semudu?"
  },
  {
    "surah_id": 85,
    "ayah_number": 19,
    "global_ayah_id": 5928,
    "translation": "Naprotiv! Oni koji ne vjeruju, u poricanju su,"
  },
  {
    "surah_id": 85,
    "ayah_number": 20,
    "global_ayah_id": 5929,
    "translation": "A Allah je njih Okružitelj."
  },
  {
    "surah_id": 85,
    "ayah_number": 21,
    "global_ayah_id": 5930,
    "translation": "Naprotiv! To je Kur'an slavni,"
  },
  {
    "surah_id": 85,
    "ayah_number": 22,
    "global_ayah_id": 5931,
    "translation": "Na Ploči čuvanoj."
  }
]