[
  {
    "surah_id": 85,
    "ayah_number": 1,
    "global_ayah_id": 5910,
    "translation": "Клянусь небом, обладателем созвездий Зодиака;"
  },
  {
    "surah_id": 85,
    "ayah_number": 2,
    "global_ayah_id": 5911,
    "translation": "клянусь днем, который обещан;"
  },
  {
    "surah_id": 85,
    "ayah_number": 3,
    "global_ayah_id": 5912,
    "translation": "клянусь свидетелем и тем, о чем он свидетельствовал:"
  },
  {
    "surah_id": 85,
    "ayah_number": 4,
    "global_ayah_id": 5913,
    "translation": "Да сгинут губители [невинных] возле рва -"
  },
  {
    "surah_id": 85,
    "ayah_number": 5,
    "global_ayah_id": 5914,
    "translation": "[губители], которым [был уготован] огонь пылающий,"
  },
  {
    "surah_id": 85,
    "ayah_number": 6,
    "global_ayah_id": 5915,
    "translation": "в тот самый миг, когда они собрались возле этого [т. е. пылающего рва],"
  },
  {
    "surah_id": 85,
    "ayah_number": 7,
    "global_ayah_id": 5916,
    "translation": "радуясь тому, что они творят с верующими."
  },
  {
    "surah_id": 85,
    "ayah_number": 8,
    "global_ayah_id": 5917,
    "translation": "Они питали злобу против них только за то, что те верили в Аллаха, великого, хвалимого,"
  },
  {
    "surah_id": 85,
    "ayah_number": 9,
    "global_ayah_id": 5918,
    "translation": "которому принадлежит владычество над небесами и землей. Ведь Аллах - свидетель всему сущему."
  },
  {
    "surah_id": 85,
    "ayah_number": 10,
    "global_ayah_id": 5919,
    "translation": "А тем, которые подвергли верующих, мужчин и женщин, испытанию [сожжением] и не раскаялись, уготовано наказание адом, наказание огнем."
  },
  {
    "surah_id": 85,
    "ayah_number": 11,
    "global_ayah_id": 5920,
    "translation": "Воистину, тем, которые уверовали и вершили добрые дела, уготованы сады с ручьями текучими. Это и есть великое преуспеяние."
  },
  {
    "surah_id": 85,
    "ayah_number": 12,
    "global_ayah_id": 5921,
    "translation": "Воистину, кара твоего Господа сурова!"
  },
  {
    "surah_id": 85,
    "ayah_number": 13,
    "global_ayah_id": 5922,
    "translation": "Воистину, он создает изначально и возвращает [к жизни вторично]."
  },
  {
    "surah_id": 85,
    "ayah_number": 14,
    "global_ayah_id": 5923,
    "translation": "Он - прощающий, любящий,"
  },
  {
    "surah_id": 85,
    "ayah_number": 15,
    "global_ayah_id": 5924,
    "translation": "Властитель Трона, достославный,"
  },
  {
    "surah_id": 85,
    "ayah_number": 16,
    "global_ayah_id": 5925,
    "translation": "Он вершит то, что пожелает."
  },
  {
    "surah_id": 85,
    "ayah_number": 17,
    "global_ayah_id": 5926,
    "translation": "Слышал ли ты рассказ о воинствах [неверных],"
  },
  {
    "surah_id": 85,
    "ayah_number": 18,
    "global_ayah_id": 5927,
    "translation": "о Фир'ауне и самудитах?"
  },
  {
    "surah_id": 85,
    "ayah_number": 19,
    "global_ayah_id": 5928,
    "translation": "Хотя те, которые не уверовали, отрицают [Коран], -"
  },
  {
    "surah_id": 85,
    "ayah_number": 20,
    "global_ayah_id": 5929,
    "translation": "а Аллах объемлет их деяния [знанием], -"
  },
  {
    "surah_id": 85,
    "ayah_number": 21,
    "global_ayah_id": 5930,
    "translation": "но это - достославный Коран,"
  },
  {
    "surah_id": 85,
    "ayah_number": 22,
    "global_ayah_id": 5931,
    "translation": "в Небесной скрижали хранимый."
  }
]