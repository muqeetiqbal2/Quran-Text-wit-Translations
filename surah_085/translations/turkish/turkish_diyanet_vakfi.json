[
  {
    "surah_id": 85,
    "ayah_number": 1,
    "global_ayah_id": 5910,
    "translation": "Burçlara sahip gökyüzüne,"
  },
  {
    "surah_id": 85,
    "ayah_number": 2,
    "global_ayah_id": 5911,
    "translation": "Geleceği bildirilmiş olan güne,"
  },
  {
    "surah_id": 85,
    "ayah_number": 3,
    "global_ayah_id": 5912,
    "translation": "(O günde) tanıklık edene ve edilene andolsun ki,"
  },
  {
    "surah_id": 85,
    "ayah_number": 4,
    "global_ayah_id": 5913,
    "translation": "Kahroldu o hendeğin sahipleri,"
  },
  {
    "surah_id": 85,
    "ayah_number": 5,
    "global_ayah_id": 5914,
    "translation": "O çıralı ateşin,"
  },
  {
    "surah_id": 85,
    "ayah_number": 6,
    "global_ayah_id": 5915,
    "translation": "Onlar (yakanlar) da başlarına oturmuşlar,"
  },
  {
    "surah_id": 85,
    "ayah_number": 7,
    "global_ayah_id": 5916,
    "translation": "Müminlere yapmakta oldukları işkenceyi seyrediyorlardı."
  },
  {
    "surah_id": 85,
    "ayah_number": 8,
    "global_ayah_id": 5917,
    "translation": "Onlardan, sırf, aziz ve hamid olan Allah'a iman ettikleri için intikam aldılar."
  },
  {
    "surah_id": 85,
    "ayah_number": 9,
    "global_ayah_id": 5918,
    "translation": "O Allah ki, göklerin ve yerin mülkü kendisine aittir, ve Allah her şeye şahittir."
  },
  {
    "surah_id": 85,
    "ayah_number": 10,
    "global_ayah_id": 5919,
    "translation": "Şüphesiz inanmış erkeklerle inanmış kadınlara işkence edip sonra tevbe de etmeyenlere cehennem azabı ve (orada) yanma cezası vardır."
  },
  {
    "surah_id": 85,
    "ayah_number": 11,
    "global_ayah_id": 5920,
    "translation": "İman edip salih ameller işleyenlere ise, zemininden ırmaklar akan cennetler vardır. İşte büyük kurtuluş budur."
  },
  {
    "surah_id": 85,
    "ayah_number": 12,
    "global_ayah_id": 5921,
    "translation": "Şüphesiz Rabbinin yakalaması çok şiddetlidir."
  },
  {
    "surah_id": 85,
    "ayah_number": 13,
    "global_ayah_id": 5922,
    "translation": "Bilin ki O, (kainat yokken) ilk olarak yaratan, (ölümden sonra tekrar hayatı) geri getirendir."
  },
  {
    "surah_id": 85,
    "ayah_number": 14,
    "global_ayah_id": 5923,
    "translation": "O, çok bağışlayan ve çok sevendir."
  },
  {
    "surah_id": 85,
    "ayah_number": 15,
    "global_ayah_id": 5924,
    "translation": "Şerefli Arş'ın sahibidir."
  },
  {
    "surah_id": 85,
    "ayah_number": 16,
    "global_ayah_id": 5925,
    "translation": "Dilediği şeyleri mutlaka yapandır."
  },
  {
    "surah_id": 85,
    "ayah_number": 17,
    "global_ayah_id": 5926,
    "translation": "Orduların, haberi sana geldi mi?"
  },
  {
    "surah_id": 85,
    "ayah_number": 18,
    "global_ayah_id": 5927,
    "translation": "Yani Firavun ve Semud'un"
  },
  {
    "surah_id": 85,
    "ayah_number": 19,
    "global_ayah_id": 5928,
    "translation": "Doğrusu inkarcılar (gerçeği) yalanlayıp dururlar."
  },
  {
    "surah_id": 85,
    "ayah_number": 20,
    "global_ayah_id": 5929,
    "translation": "Allah onları arkalarından kuşatmıştır."
  },
  {
    "surah_id": 85,
    "ayah_number": 21,
    "global_ayah_id": 5930,
    "translation": "Hayır o şerefli bir Kur'an'dır."
  },
  {
    "surah_id": 85,
    "ayah_number": 22,
    "global_ayah_id": 5931,
    "translation": "Levh-i Mahfuz'dadır."
  }
]