[
  {
    "surah_id": 85,
    "ayah_number": 1,
    "global_ayah_id": 5910,
    "translation": "Burçlar sahibi göğe andolsun,"
  },
  {
    "surah_id": 85,
    "ayah_number": 2,
    "global_ayah_id": 5911,
    "translation": "Va'dedilen güne andolsun,"
  },
  {
    "surah_id": 85,
    "ayah_number": 3,
    "global_ayah_id": 5912,
    "translation": "(O gün) Şahide ve şahidlik edilene andolsun,"
  },
  {
    "surah_id": 85,
    "ayah_number": 4,
    "global_ayah_id": 5913,
    "translation": "Ki kahroldu o hendeğin adamları"
  },
  {
    "surah_id": 85,
    "ayah_number": 5,
    "global_ayah_id": 5914,
    "translation": "O yakıt doldurulup tutuşturulmuş ateş (hendeğinin adamları)!"
  },
  {
    "surah_id": 85,
    "ayah_number": 6,
    "global_ayah_id": 5915,
    "translation": "Onlar, o(ateş hendeği)nin başında oturmuşlardı."
  },
  {
    "surah_id": 85,
    "ayah_number": 7,
    "global_ayah_id": 5916,
    "translation": "Ve onlar, mü'minlere yaptıklarını seyrediyorlardı."
  },
  {
    "surah_id": 85,
    "ayah_number": 8,
    "global_ayah_id": 5917,
    "translation": "Mü'minler sırf aziz, övgüye layık Allah'a inandıkları için o (zalim)ler onlardan öc aldılar."
  },
  {
    "surah_id": 85,
    "ayah_number": 9,
    "global_ayah_id": 5918,
    "translation": "O (Allah) ki göklerin ve yerin hükümranlığı O'nundur. Allah, her şeye tanıktır."
  },
  {
    "surah_id": 85,
    "ayah_number": 10,
    "global_ayah_id": 5919,
    "translation": "İnanmış erkek ve kadınlara işkence edip sonra (yaptıklarına) tevbe etmeyenler (yok mu), onlar için cehennem azabı vardır ve onlar için yangın azabı vardır."
  },
  {
    "surah_id": 85,
    "ayah_number": 11,
    "global_ayah_id": 5920,
    "translation": "İnanan ve iyi işler yapan kimseler için de altlarından ırmaklar akan cennetler vardır. İşte büyük başarı budur."
  },
  {
    "surah_id": 85,
    "ayah_number": 12,
    "global_ayah_id": 5921,
    "translation": "Şüphesiz Rabbinin tutuşu şiddetlidir."
  },
  {
    "surah_id": 85,
    "ayah_number": 13,
    "global_ayah_id": 5922,
    "translation": "İlkin var eden, sonra geri çevirip yeniden yaratan O'dur."
  },
  {
    "surah_id": 85,
    "ayah_number": 14,
    "global_ayah_id": 5923,
    "translation": "O bağışlayandır, sevendir."
  },
  {
    "surah_id": 85,
    "ayah_number": 15,
    "global_ayah_id": 5924,
    "translation": "Arş'ın sahibidir, yücedir."
  },
  {
    "surah_id": 85,
    "ayah_number": 16,
    "global_ayah_id": 5925,
    "translation": "İstediğini yapandır."
  },
  {
    "surah_id": 85,
    "ayah_number": 17,
    "global_ayah_id": 5926,
    "translation": "O orduların haberi sana geldi mi?"
  },
  {
    "surah_id": 85,
    "ayah_number": 18,
    "global_ayah_id": 5927,
    "translation": "(Yani) Fir'avn ve Semud(kavimlerin)in?"
  },
  {
    "surah_id": 85,
    "ayah_number": 19,
    "global_ayah_id": 5928,
    "translation": "Doğrusu, nankörler bir yalanlama içindedirler."
  },
  {
    "surah_id": 85,
    "ayah_number": 20,
    "global_ayah_id": 5929,
    "translation": "Allah ise onları arkalarından kuşatmıştır."
  },
  {
    "surah_id": 85,
    "ayah_number": 21,
    "global_ayah_id": 5930,
    "translation": "Hayır, (Kur'an, onların dedikleri gibi bir söz değil), o şerefli bir Kur'an'dır."
  },
  {
    "surah_id": 85,
    "ayah_number": 22,
    "global_ayah_id": 5931,
    "translation": "Korunan bir levhada(yazılı)dır."
  }
]