[
  {
    "surah_id": 85,
    "ayah_number": 1,
    "global_ayah_id": 5910,
    "translation": "별들의 궤도를 둔 하늘을 두고 맹세하사"
  },
  {
    "surah_id": 85,
    "ayah_number": 2,
    "global_ayah_id": 5911,
    "translation": "약속된 심판의 날을 두고 맹세하며"
  },
  {
    "surah_id": 85,
    "ayah_number": 3,
    "global_ayah_id": 5912,
    "translation": "증언하는 자들과 증언받는 그들을 두고 맹세하며"
  },
  {
    "surah_id": 85,
    "ayah_number": 4,
    "global_ayah_id": 5913,
    "translation": "함정을 만든 그들에게 저주 가 있으리라"
  },
  {
    "surah_id": 85,
    "ayah_number": 5,
    "global_ayah_id": 5914,
    "translation": "그들은 화염을 그곳에 던졌노라"
  },
  {
    "surah_id": 85,
    "ayah_number": 6,
    "global_ayah_id": 5915,
    "translation": "그들은 그 화염 옆에 앉아"
  },
  {
    "surah_id": 85,
    "ayah_number": 7,
    "global_ayah_id": 5916,
    "translation": "그들이 믿는 신도들에게 저지를 모든 것을 증언하노라"
  },
  {
    "surah_id": 85,
    "ayah_number": 8,
    "global_ayah_id": 5917,
    "translation": "그들은 그들이 권능과 찬미 로 충만하신 하나님을 믿는다는 이유로 그들을 학대하였노라"
  },
  {
    "surah_id": 85,
    "ayah_number": 9,
    "global_ayah_id": 5918,
    "translation": "하늘과 대지의 왕국이 하나님 께 있으며 그분은 모든 것을 지켜 보고 계시니라"
  },
  {
    "surah_id": 85,
    "ayah_number": 10,
    "global_ayah_id": 5919,
    "translation": "실로 믿음을 가진 남성과 여성을 학대하고 회개하지 아니한 자들에게는 지옥의 응벌이 있을 것이니 그들은 타오르는 불지옥의 응벌을 맛보리라"
  },
  {
    "surah_id": 85,
    "ayah_number": 11,
    "global_ayah_id": 5920,
    "translation": "그러나 믿음으로 선을 행하 는 의로운 자들에게는 강물이 흐 르는 천국이 있나니 실로 그것이 위대한 숭리라"
  },
  {
    "surah_id": 85,
    "ayah_number": 12,
    "global_ayah_id": 5921,
    "translation": "실로 그대 주님의 응벌은 엄하니라"
  },
  {
    "surah_id": 85,
    "ayah_number": 13,
    "global_ayah_id": 5922,
    "translation": "그분께서 창시하셨기에 다시생명을 주실 수 있노라"
  },
  {
    "surah_id": 85,
    "ayah_number": 14,
    "global_ayah_id": 5923,
    "translation": "그분은 관용과 사랑으로 충 만하사"
  },
  {
    "surah_id": 85,
    "ayah_number": 15,
    "global_ayah_id": 5924,
    "translation": "영광의 권좌에 앉아 계시며"
  },
  {
    "surah_id": 85,
    "ayah_number": 16,
    "global_ayah_id": 5925,
    "translation": "뜻하시는 모든 것을 행하시 니라"
  },
  {
    "surah_id": 85,
    "ayah_number": 17,
    "global_ayah_id": 5926,
    "translation": "군대의 이야기가 그대에게 이르렀느뇨"
  },
  {
    "surah_id": 85,
    "ayah_number": 18,
    "global_ayah_id": 5927,
    "translation": "파라오와 사무드 군대의 이야기라"
  },
  {
    "surah_id": 85,
    "ayah_number": 19,
    "global_ayah_id": 5928,
    "translation": "그런데도 불신자들은 그 진리를 거역하고 있나니"
  },
  {
    "surah_id": 85,
    "ayah_number": 20,
    "global_ayah_id": 5929,
    "translation": "하나님은 그들 뒤에서 그들 을 포위하시니라"
  },
  {
    "surah_id": 85,
    "ayah_number": 21,
    "global_ayah_id": 5930,
    "translation": "실로 이것이 영광의 꾸란으 로"
  },
  {
    "surah_id": 85,
    "ayah_number": 22,
    "global_ayah_id": 5931,
    "translation": "보호된 곳에 보관된 것이라"
  }
]