    "translation": "शुरु अत्यन्त करुणामय, परम दयालु अल्लाहको नामबाट ।"
  },
  {
    "surah_id": 105,
    "ayah_number": 1,
    "global_ayah_id": 6293,
    "translation": "के तिमीले देखेनौं कि तिम्रा रबले हात्तीवालाहरूसित कस्तो व्यवहार गरे ?"
  },
  {
    "surah_id": 105,
    "ayah_number": 2,
    "global_ayah_id": 6294,
    "translation": "के उनले तिनीहरूको योजना विफल तुल्याइदिएनन् ?"
  },
  {
    "surah_id": 105,
    "ayah_number": 3,
    "global_ayah_id": 6295,
    "translation": "र तिनीहरूमाथि हुलका हुल पंक्षीहरू पनि पठाइदिए"
  },
  {
    "surah_id": 105,
    "ayah_number": 4,
    "global_ayah_id": 6296,
    "translation": "जो तिनीहरूलाई मट्याङ्ग्राले हिर्काइरहन्थे ।"
  },
  {
    "surah_id": 105,
    "ayah_number": 5,
    "global_ayah_id": 6297,
    "translation": "अन्ततः उनले तिनीहरूलाई खाएको बिरुवाझैं बनाइदिए ।"
  }
]