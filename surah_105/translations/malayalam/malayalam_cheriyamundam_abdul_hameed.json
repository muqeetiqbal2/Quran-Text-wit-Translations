[
  {
    "surah_id": 105,
    "ayah_number": 1,
    "global_ayah_id": 6189,
    "translation": "ആനക്കാരെക്കൊണ്ട് നിന്‍റെ രക്ഷിതാവ് പ്രവര്‍ത്തിച്ചത് എങ്ങനെ എന്ന് നീ കണ്ടില്ലേ?"
  },
  {
    "surah_id": 105,
    "ayah_number": 2,
    "global_ayah_id": 6190,
    "translation": "അവരുടെ തന്ത്രം അവന്‍ പിഴവിലാക്കിയില്ലേ?"
  },
  {
    "surah_id": 105,
    "ayah_number": 3,
    "global_ayah_id": 6191,
    "translation": "കൂട്ടംകൂട്ടമായിക്കൊണ്ടുള്ള പക്ഷികളെ അവരുടെ നേര്‍ക്ക് അവന്‍ അയക്കുകയും ചെയ്തു."
  },
  {
    "surah_id": 105,
    "ayah_number": 4,
    "global_ayah_id": 6192,
    "translation": "ചുട്ടുപഴുപ്പിച്ച കളിമണ്‍കല്ലുകള്‍കൊണ്ട് അവരെ എറിയുന്നതായ."
  },
  {
    "surah_id": 105,
    "ayah_number": 5,
    "global_ayah_id": 6193,
    "translation": "അങ്ങനെ അവന്‍ അവരെ തിന്നൊടുക്കപ്പെട്ട വൈക്കോല്‍ തുരുമ്പുപോലെയാക്കി."
  }
]