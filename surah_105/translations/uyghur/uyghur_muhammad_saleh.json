    "global_ayah_id": 6189,
    "translation": "پەرۋەردىگارىڭنىڭ فىل ئىگىلىرىنى قانداق قىلغانلىقىنى كۆرمىدىڭمۇ؟"
  },
  {
    "surah_id": 105,
    "ayah_number": 2,
    "global_ayah_id": 6190,
    "translation": "ئۇ ئۇلارنىڭ ھىيلە - مىكرىنى بەربات قىلمىدىمۇ؟"
  },
  {
    "surah_id": 105,
    "ayah_number": 3,
    "global_ayah_id": 6191,
    "translation": "ئۇ ئۇلارنىڭ ئۈستىگە توپ - توپ قۇشلارنى ئەۋەتتى"
  },
  {
    "surah_id": 105,
    "ayah_number": 4,
    "global_ayah_id": 6192,
    "translation": "قۇشلار ئۇلارغا ساپال تاشلارنى ئېتىپ،"
  },
  {
    "surah_id": 105,
    "ayah_number": 5,
    "global_ayah_id": 6193,
    "translation": "ئۇلارنى چاينىۋېتىلگەن ساماندەك قىلىۋەتتى"
  }
