[
  {
    "surah_id": 105,
    "ayah_number": 1,
    "global_ayah_id": 6189,
    "translation": "Оё надидаӣ, ки Парвардигорат бо асҳоби фил чӣ кард?"
  },
  {
    "surah_id": 105,
    "ayah_number": 2,
    "global_ayah_id": 6190,
    "translation": "Оё макрашонро ботил насохт?"
  },
  {
    "surah_id": 105,
    "ayah_number": 3,
    "global_ayah_id": 6191,
    "translation": "Ва бар сари онҳо паррандагоне села - села фиристод,"
  },
  {
    "surah_id": 105,
    "ayah_number": 4,
    "global_ayah_id": 6192,
    "translation": "то онҳоро бо сиҷҷил сангборон карданд."
  },
  {
    "surah_id": 105,
    "ayah_number": 5,
    "global_ayah_id": 6193,
    "translation": "Ва ононро чун коҳи пасмонда дар охур сохт."
  }
]