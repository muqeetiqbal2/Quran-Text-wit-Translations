[
  {
    "surah_id": 1,
    "ayah_number": 1,
    "global_ayah_id": 1,
    "translation": "Ба номи Худованди бахшояндаи меҳрубон!"
  },
  {
    "surah_id": 1,
    "ayah_number": 2,
    "global_ayah_id": 2,
    "translation": "Ситоиш Худоро, ки Парвардигори ҷаҳониён аст."
  },
  {
    "surah_id": 1,
    "ayah_number": 3,
    "global_ayah_id": 3,
    "translation": "Бахшояндаи меҳрубон,"
  },
  {
    "surah_id": 1,
    "ayah_number": 4,
    "global_ayah_id": 4,
    "translation": "Фармонравои рӯзи ҷазо."
  },
  {
    "surah_id": 1,
    "ayah_number": 5,
    "global_ayah_id": 5,
    "translation": "Танҳо Туро мепарастем ва танҳо аз Ту ёри меҷӯем."
  },
  {
    "surah_id": 1,
    "ayah_number": 6,
    "global_ayah_id": 6,
    "translation": "Моро ба роҳи рост ҳидоят кун:"
  },
  {
    "surah_id": 1,
    "ayah_number": 7,
    "global_ayah_id": 7,
    "translation": "роҳи касоне, ки онҳоро неъмат додаи, на хашмгирифтагонӣ бар онҳо ва на гумроҳон."
  }
]