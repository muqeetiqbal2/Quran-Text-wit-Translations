    "global_ayah_id": 1,
    "translation": "Во имя Аллаха, Милостивого, Милосердного."
  },
  {
    "surah_id": 1,
    "ayah_number": 2,
    "global_ayah_id": 2,
    "translation": "Хвала Аллаху - Господу [обитателей] миров,"
  },
  {
    "surah_id": 1,
    "ayah_number": 3,
    "global_ayah_id": 3,
    "translation": "милостивому, милосердному,"
  },
  {
    "surah_id": 1,
    "ayah_number": 4,
    "global_ayah_id": 4,
    "translation": "властителю дня Суда!"
  },
  {
    "surah_id": 1,
    "ayah_number": 5,
    "global_ayah_id": 5,
    "translation": "Тебе мы поклоняемся и к Тебе взываем о помощи:"
  },
  {
    "surah_id": 1,
    "ayah_number": 6,
    "global_ayah_id": 6,
    "translation": "веди нас прямым путем,"
  },
  {
    "surah_id": 1,
    "ayah_number": 7,
    "global_ayah_id": 7,
    "translation": "путем тех, которых Ты облагодетельствовал, не тех, что [подпали под Твой] гнев, и не [путем] заблудших."
