  {
    "surah_id": 1,
    "ayah_number": 1,
    "global_ayah_id": 1,
    "translation": "慈悲あまねく慈愛深きアッラーの御名において。"
  },
  {
    "surah_id": 1,
    "ayah_number": 2,
    "global_ayah_id": 2,
    "translation": "万有の主，アッラーにこそ凡ての称讃あれ，"
  },
  {
    "surah_id": 1,
    "ayah_number": 3,
    "global_ayah_id": 3,
    "translation": "慈悲あまねく慈愛深き御方，"
  },
  {
    "surah_id": 1,
    "ayah_number": 4,
    "global_ayah_id": 4,
    "translation": "最後の審きの日の主宰者に。"
  },
  {
    "surah_id": 1,
    "ayah_number": 5,
    "global_ayah_id": 5,
    "translation": "わたしたちはあなたにのみ崇め仕え，あなたにのみ御助けを請い願う。"
  },
  {
    "surah_id": 1,
    "ayah_number": 6,
    "global_ayah_id": 6,
    "translation": "わたしたちを正しい道に導きたまえ，"
  },
  {
    "surah_id": 1,
    "ayah_number": 7,
    "global_ayah_id": 7,
    "translation": "あなたが御恵みを下された人々の道に，あなたの怒りを受けし者，また踏み迷える人々の道ではなく。"
  }
]