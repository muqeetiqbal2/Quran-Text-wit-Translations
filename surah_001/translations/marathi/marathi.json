  {
    "surah_id": 1,
    "ayah_number": 0,
    "global_ayah_id": 1,
    "translation": "﻿अल्लाहच्या नावाने, जो अत्यंत दयावंत व असीम कृपावंत आहे."
  },
  {
    "surah_id": 1,
    "ayah_number": 1,
    "global_ayah_id": 2,
    "translation": "स्तवन फक्त अल्लाहसाठीच आहे जो सर्व सृष्टीचा रब (पालनकर्ता) आहे."
  },
  {
    "surah_id": 1,
    "ayah_number": 2,
    "global_ayah_id": 3,
    "translation": "एकमात्र कृपावंत आणि दयावंत,"
  },
  {
    "surah_id": 1,
    "ayah_number": 3,
    "global_ayah_id": 4,
    "translation": "निर्णयाच्या दिवसाचा स्वामी आहे."
  },
  {
    "surah_id": 1,
    "ayah_number": 4,
    "global_ayah_id": 5,
    "translation": "आम्ही तुझीच बंदगी (भक्ती) करतो आणि तुजपाशीच मदत मागतो."
  },
  {
    "surah_id": 1,
    "ayah_number": 5,
    "global_ayah_id": 6,
    "translation": "आम्हाला सरळ मार्ग दाखव."
  },
  {
    "surah_id": 1,
    "ayah_number": 6,
    "global_ayah_id": 7,
    "translation": "त्या लोकांचा मार्ग ज्याना तू अनुग्रहित केलेस."
  },
  {
    "surah_id": 1,
    "ayah_number": 7,
    "global_ayah_id": 8,
    "translation": "जे कोपग्रस्त झाले नाहीत व जे मार्गभ्रष्ट नाहीत."
  }
]