[
  {
    "surah_id": 1,
    "ayah_number": 1,
    "global_ayah_id": 1,
    "translation": "I Guds, den Barmhjertiges, den Nåderikes navn"
  },
  {
    "surah_id": 1,
    "ayah_number": 2,
    "global_ayah_id": 2,
    "translation": "Lovet være Gud, all verdens Herre,"
  },
  {
    "surah_id": 1,
    "ayah_number": 3,
    "global_ayah_id": 3,
    "translation": "Han, den Barmhjertige, den Nåderike,"
  },
  {
    "surah_id": 1,
    "ayah_number": 4,
    "global_ayah_id": 4,
    "translation": "Han, Herren over dommens dag."
  },
  {
    "surah_id": 1,
    "ayah_number": 5,
    "global_ayah_id": 5,
    "translation": "Deg tilber vi, vi søker hjelp hos Deg."
  },
  {
    "surah_id": 1,
    "ayah_number": 6,
    "global_ayah_id": 6,
    "translation": "Led oss på den rette vei!"
  },
  {
    "surah_id": 1,
    "ayah_number": 7,
    "global_ayah_id": 7,
    "translation": "Deres vei, som Du har beredt glede, ikke deres, som har vakt Din vrede, eller deres, som har valgt den falske vei."
  }
]