[
  {
    "surah_id": 1,
    "ayah_number": 1,
    "global_ayah_id": 1,
    "translation": "പരമകാരുണികനും കരുണാനിധിയുമായ അല്ലാഹുവിന്റെ നാമത്തില്‍ ."
  },
  {
    "surah_id": 1,
    "ayah_number": 2,
    "global_ayah_id": 2,
    "translation": "സ്തുതി സര്‍വ്വലോക പരിപാലകനായ അല്ലാഹുവിന്നാകുന്നു."
  },
  {
    "surah_id": 1,
    "ayah_number": 3,
    "global_ayah_id": 3,
    "translation": "പരമകാരുണികനും കരുണാനിധിയും."
  },
  {
    "surah_id": 1,
    "ayah_number": 4,
    "global_ayah_id": 4,
    "translation": "പ്രതിഫല ദിവസത്തിന്റെ ഉടമസ്ഥന്‍."
  },
  {
    "surah_id": 1,
    "ayah_number": 5,
    "global_ayah_id": 5,
    "translation": "നിന്നെ മാത്രം ഞങ്ങള്‍ ആരാധിക്കുന്നു. നിന്നോട് മാത്രം ഞങ്ങള്‍ സഹായം തേടുന്നു."
  },
  {
    "surah_id": 1,
    "ayah_number": 6,
    "global_ayah_id": 6,
    "translation": "ഞങ്ങളെ നീ നേര്‍മാര്‍ഗത്തില്‍ ചേര്‍ക്കേണമേ."
  },
  {
    "surah_id": 1,
    "ayah_number": 7,
    "global_ayah_id": 7,
    "translation": "നീ അനുഗ്രഹിച്ചവരുടെ മാര്‍ഗത്തില്‍ . കോപത്തിന്ന് ഇരയായവരുടെ മാര്‍ഗത്തിലല്ല. പിഴച്ചുപോയവരുടെ മാര്‍ഗത്തിലുമല്ല."
  }
]