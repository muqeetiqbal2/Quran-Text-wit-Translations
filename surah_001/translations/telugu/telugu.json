    "ayah_number": 0,
    "global_ayah_id": 1,
    "translation": "అనంత కరుణామయుడు అపార కరుణా ప్రదాత అయిన అల్లాహ్  పేరుతో."
  },
  {
    "surah_id": 1,
    "ayah_number": 1,
    "global_ayah_id": 2,
    "translation": "సర్వలోకాలకు ప్రభువైన  అల్లాహ్ మాత్రమే సమస్త స్తోత్రాలకు అర్హుడు."
  },
  {
    "surah_id": 1,
    "ayah_number": 2,
    "global_ayah_id": 3,
    "translation": "అనంత కరుణామయుడు, అపార కరుణా ప్రదాత."
  },
  {
    "surah_id": 1,
    "ayah_number": 3,
    "global_ayah_id": 4,
    "translation": "తీర్పు దినానికి స్వామి."
  },
  {
    "surah_id": 1,
    "ayah_number": 4,
    "global_ayah_id": 5,
    "translation": "మేము నిన్నే ఆరాధిస్తున్నాము మరియు నీ సహాయాన్నే అర్థిస్తున్నాము."
  },
  {
    "surah_id": 1,
    "ayah_number": 5,
    "global_ayah_id": 6,
    "translation": "మాకు ఋజుమార్గం  వైపునకు మార్గదర్శ కత్వం చేయి."
  },
  {
    "surah_id": 1,
    "ayah_number": 6,
    "global_ayah_id": 7,
    "translation": "నీవు అనుగ్రహించినవారి  మార్గం మాత్రమే (చూపు)."
  },
  {
    "surah_id": 1,
    "ayah_number": 7,
    "global_ayah_id": 8,
    "translation": "నీ ఆగ్రహానికి  గురి అయిన వారి (మార్గం కానీ) లేక మార్గ భ్రష్టులైన వారి (మార్గం కానీ) కాదు."
  }
