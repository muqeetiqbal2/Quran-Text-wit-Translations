[
  {
    "surah_id": 104,
    "ayah_number": 0,
    "global_ayah_id": 6282,
    "translation": "शुरु अत्यन्त करुणामय, परम दयालु अल्लाहको नामबाट ।"
  },
  {
    "surah_id": 104,
    "ayah_number": 1,
    "global_ayah_id": 6283,
    "translation": "यस्तो प्रत्येक व्यक्तिको सर्वनाश होस् जो व्यङ्ग्य र हेला गर्छ ।"
  },
  {
    "surah_id": 104,
    "ayah_number": 2,
    "global_ayah_id": 6284,
    "translation": "जो धन–सम्पत्ति थुपार्छ र गन्ती गर्दै थन्क्याउँछ ।"
  },
  {
    "surah_id": 104,
    "ayah_number": 3,
    "global_ayah_id": 6285,
    "translation": "उसको सम्पत्तिले उसलाई अमर बनाउनेछ भन्ने कुरा ठान्दछ ।"
  },
  {
    "surah_id": 104,
    "ayah_number": 4,
    "global_ayah_id": 6286,
    "translation": "कदापि होइन, निश्चय नै उसलाई हुतमह्मा होमिनेछ ।"
  },
  {
    "surah_id": 104,
    "ayah_number": 5,
    "global_ayah_id": 6287,
    "translation": "हुतमह् के हो तिमीलाई के थाहा ?"
  },
  {
    "surah_id": 104,
    "ayah_number": 6,
    "global_ayah_id": 6288,
    "translation": "अल्लाहको दन्कँदो अग्नि"
  },
  {
    "surah_id": 104,
    "ayah_number": 7,
    "global_ayah_id": 6289,
    "translation": "जुन मुटुसम्म पुग्नेछ ।"
  },
  {
    "surah_id": 104,
    "ayah_number": 8,
    "global_ayah_id": 6290,
    "translation": "निस्सन्देह त्यसलाई तिनीहरूमाथि चारैतिरबाट छोपेर बन्द गरिनेछ ।"
  },
  {
    "surah_id": 104,
    "ayah_number": 9,
    "global_ayah_id": 6291,
    "translation": "अग्ला–अग्ला स्तम्भहरूमा ।"
  }
]