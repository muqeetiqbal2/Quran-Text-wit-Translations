[
  {
    "surah_id": 104,
    "ayah_number": 1,
    "global_ayah_id": 6180,
    "translation": "Вой бар ҳар ғайбаткунандаи айбҷӯе,"
  },
  {
    "surah_id": 104,
    "ayah_number": 2,
    "global_ayah_id": 6181,
    "translation": "он ки моле ҷамъ кард ва ҳисоби он нигаҳ дошт."
  },
  {
    "surah_id": 104,
    "ayah_number": 3,
    "global_ayah_id": 6182,
    "translation": "Мепиндорад, ки дороияш ҷовидонаш гардонад."
  },
  {
    "surah_id": 104,
    "ayah_number": 4,
    "global_ayah_id": 6183,
    "translation": "На чунин аст! ки Ӯро дар ҳутамаҳ андозанд."
  },
  {
    "surah_id": 104,
    "ayah_number": 5,
    "global_ayah_id": 6184,
    "translation": "Ва ту чӣ донӣ, ки ҳутамаҳ чист?"
  },
  {
    "surah_id": 104,
    "ayah_number": 6,
    "global_ayah_id": 6185,
    "translation": "Оташи афрӯхтаи Худост,"
  },
  {
    "surah_id": 104,
    "ayah_number": 7,
    "global_ayah_id": 6186,
    "translation": "ки бар дилҳо ғалаба меёбад."
  },
  {
    "surah_id": 104,
    "ayah_number": 8,
    "global_ayah_id": 6187,
    "translation": "Он оташ аз ҳар сӯ дар миёнашон гирифтааст,"
  },
  {
    "surah_id": 104,
    "ayah_number": 9,
    "global_ayah_id": 6188,
    "translation": "дар сутунҳои дарози оташӣ дароварда шудааст."
  }
]