  {
    "surah_id": 104,
    "ayah_number": 1,
    "global_ayah_id": 6180,
    "translation": "Halaag Wuxuu u Sugnaaday xanle wax ceebeya oo Dhan,"
  },
  {
    "surah_id": 104,
    "ayah_number": 2,
    "global_ayah_id": 6181,
    "translation": "Oo Xoolaha kulmiya (xaqana ku bixinin)."
  },
  {
    "surah_id": 104,
    "ayah_number": 3,
    "global_ayah_id": 6182,
    "translation": "Ma wuxuu malayn in xoolihiisu waarin."
  },
  {
    "surah_id": 104,
    "ayah_number": 4,
    "global_ayah_id": 6183,
    "translation": "Saas ma aha ee waxaa lagu tuuri (Naarta) Xudhama."
  },
  {
    "surah_id": 104,
    "ayah_number": 5,
    "global_ayah_id": 6184,
    "translation": "Ma taqaannaa Xudhama."
  },
  {
    "surah_id": 104,
    "ayah_number": 6,
    "global_ayah_id": 6185,
    "translation": "Waa Naarta Eebe ee la huriyay."
  },
  {
    "surah_id": 104,
    "ayah_number": 7,
    "global_ayah_id": 6186,
    "translation": "Gubaysana Quluubta (Kulayl dartiis)."
  },
  {
    "surah_id": 104,
    "ayah_number": 8,
    "global_ayah_id": 6187,
    "translation": "Waana lagu dabooli Naartaas Gaalada."
  },
  {
    "surah_id": 104,
    "ayah_number": 9,
    "global_ayah_id": 6188,
    "translation": "Tiraar la fidiyay yayna ahaan dhexdeeda."
  }
]