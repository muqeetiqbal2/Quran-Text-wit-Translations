[
  {
    "surah_id": 104,
    "ayah_number": 1,
    "global_ayah_id": 6180,
    "translation": "Ҳар бир обрў тўкувчи ва айбловчига «вайл» бўлсин."
  },
  {
    "surah_id": 104,
    "ayah_number": 2,
    "global_ayah_id": 6181,
    "translation": "У мол жамлади ва уни санаб турди."
  },
  {
    "surah_id": 104,
    "ayah_number": 3,
    "global_ayah_id": 6182,
    "translation": "У, албатта, уни абадий қолдирур, деб ҳисоблар."
  },
  {
    "surah_id": 104,
    "ayah_number": 4,
    "global_ayah_id": 6183,
    "translation": "Йўқ! Албатта у «ҳутома»га хор-зор этиб ташланар."
  },
  {
    "surah_id": 104,
    "ayah_number": 5,
    "global_ayah_id": 6184,
    "translation": "«Ҳутома» қандоқ нарса эканини сенга нима билдирар?"
  },
  {
    "surah_id": 104,
    "ayah_number": 6,
    "global_ayah_id": 6185,
    "translation": "У Аллоҳнинг шиддатли, ўчмас оловидир."
  },
  {
    "surah_id": 104,
    "ayah_number": 7,
    "global_ayah_id": 6186,
    "translation": "Қалбгача етиб борадир."
  },
  {
    "surah_id": 104,
    "ayah_number": 8,
    "global_ayah_id": 6187,
    "translation": "Албатта, у уларни устидан қоплангандир."
  },
  {
    "surah_id": 104,
    "ayah_number": 9,
    "global_ayah_id": 6188,
    "translation": "Узун-узун устунларга боғлангандирлар."
  }
]