[
  {
    "surah_id": 104,
    "ayah_number": 1,
    "global_ayah_id": 6180,
    "translation": "Bone ya tabbata ga duk mai nune, mai zunɗe (mai raɗa)."
  },
  {
    "surah_id": 104,
    "ayah_number": 2,
    "global_ayah_id": 6181,
    "translation": "Wanda ya tara dũkiya, kuma ya mayar da ita abar tattalinsa."
  },
  {
    "surah_id": 104,
    "ayah_number": 3,
    "global_ayah_id": 6182,
    "translation": "Yana zaton cẽwa dũkiyarsa za ta dawwamar da shi."
  },
  {
    "surah_id": 104,
    "ayah_number": 4,
    "global_ayah_id": 6183,
    "translation": "A'aha! Lalle ne zã a jẽfa shi a cikin Huɗama."
  },
  {
    "surah_id": 104,
    "ayah_number": 5,
    "global_ayah_id": 6184,
    "translation": "Kuma me ya sanar da kai abin da ake ce wa Huɗama?"
  },
  {
    "surah_id": 104,
    "ayah_number": 6,
    "global_ayah_id": 6185,
    "translation": "Wutar Allah ce wadda ake hurawa."
  },
  {
    "surah_id": 104,
    "ayah_number": 7,
    "global_ayah_id": 6186,
    "translation": "Wadda take lẽƙãwa a kan zukata."
  },
  {
    "surah_id": 104,
    "ayah_number": 8,
    "global_ayah_id": 6187,
    "translation": "Lalle ne ita abar kullẽwa cea kansu."
  },
  {
    "surah_id": 104,
    "ayah_number": 9,
    "global_ayah_id": 6188,
    "translation": "A cikin wasu ginshiƙai mĩƙaƙƙu."
  }
]