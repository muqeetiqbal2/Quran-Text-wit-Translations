[
  {
    "surah_id": 104,
    "ayah_number": 0,
    "global_ayah_id": 6282,
    "translation": "اللہ دے ناں نال ( شروع ) جیہڑا حدوں مہربان ، بوہت رحم والا اے ۔"
  },
  {
    "surah_id": 104,
    "ayah_number": 1,
    "global_ayah_id": 6283,
    "translation": "وڈی ہلاکت اے ہر بوہت طعنےدین والے عیب لون والے لئی"
  },
  {
    "surah_id": 104,
    "ayah_number": 2,
    "global_ayah_id": 6284,
    "translation": "جنھے مال جوڑیا تے اوہنوں گِن گِن کے رکھیا"
  },
  {
    "surah_id": 104,
    "ayah_number": 3,
    "global_ayah_id": 6285,
    "translation": "اوہ سمجھدا اے واقعی اوہدے مال اوہنوں سدا رہن والا بنا دے گا"
  },
  {
    "surah_id": 104,
    "ayah_number": 4,
    "global_ayah_id": 6286,
    "translation": "ہرگز نئیں ! ضرور اوہنوں حطمہ وچ سٹیا جائے گا"
  },
  {
    "surah_id": 104,
    "ayah_number": 5,
    "global_ayah_id": 6287,
    "translation": "تے تینوں کیہہ پتا ہووے اوہ حطمہ کیہہ اے ؟"
  },
  {
    "surah_id": 104,
    "ayah_number": 6,
    "global_ayah_id": 6288,
    "translation": "اللہ دی بھکھائی ہوئی اگ اے"
  },
  {
    "surah_id": 104,
    "ayah_number": 7,
    "global_ayah_id": 6289,
    "translation": "اوہ جیہڑی دلاں نوں جا ٹوہندی اے"
  },
  {
    "surah_id": 104,
    "ayah_number": 8,
    "global_ayah_id": 6290,
    "translation": "بیشک اوہ اوہناں تے ( ہر پاسیوں ) ڈھکی ہوئی اے"
  },
  {
    "surah_id": 104,
    "ayah_number": 9,
    "global_ayah_id": 6291,
    "translation": "لمّے لمّے تھماں وچ ( جکڑے )"
  }
]