  {
    "surah_id": 104,
    "ayah_number": 1,
    "global_ayah_id": 6180,
    "translation": "傷哉！每個誹謗者, 詆毀者,"
  },
  {
    "surah_id": 104,
    "ayah_number": 2,
    "global_ayah_id": 6181,
    "translation": "他聚積財產, 而當作武器,"
  },
  {
    "surah_id": 104,
    "ayah_number": 3,
    "global_ayah_id": 6182,
    "translation": "他以為他的財產, 能使他不滅。"
  },
  {
    "surah_id": 104,
    "ayah_number": 4,
    "global_ayah_id": 6183,
    "translation": "絕不然, 他必定要被投在毀滅坑中。"
  },
  {
    "surah_id": 104,
    "ayah_number": 5,
    "global_ayah_id": 6184,
    "translation": "你怎能知道毀滅坑是什麼？"
  },
  {
    "surah_id": 104,
    "ayah_number": 6,
    "global_ayah_id": 6185,
    "translation": "是真主的燃著的烈活。"
  },
  {
    "surah_id": 104,
    "ayah_number": 7,
    "global_ayah_id": 6186,
    "translation": "能升到人的心上。"
  },
  {
    "surah_id": 104,
    "ayah_number": 8,
    "global_ayah_id": 6187,
    "translation": "他們必定要被關在烈火中,"
  },
  {
    "surah_id": 104,
    "ayah_number": 9,
    "global_ayah_id": 6188,
    "translation": "吊在許多很高的柱子上。"
  }
]