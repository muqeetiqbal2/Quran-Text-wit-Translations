[
  {
    "surah_id": 104,
    "ayah_number": 1,
    "global_ayah_id": 6180,
    "translation": "災いなるかな，凡ての悪口を言って中傷する者。"
  },
  {
    "surah_id": 104,
    "ayah_number": 2,
    "global_ayah_id": 6181,
    "translation": "財を集めて計算する（のに余念のない）者。"
  },
  {
    "surah_id": 104,
    "ayah_number": 3,
    "global_ayah_id": 6182,
    "translation": "本当にその財が，かれを永久に生かすと考えている。"
  },
  {
    "surah_id": 104,
    "ayah_number": 4,
    "global_ayah_id": 6183,
    "translation": "断じてそうではない。かれは必ず業火の中に，投げ込まれる。"
  },
  {
    "surah_id": 104,
    "ayah_number": 5,
    "global_ayah_id": 6184,
    "translation": "業火が，何であるかをあなたに理解させるものは何か。"
  },
  {
    "surah_id": 104,
    "ayah_number": 6,
    "global_ayah_id": 6185,
    "translation": "（それは）ぼうぼうと燃えているアッラーの火，"
  },
  {
    "surah_id": 104,
    "ayah_number": 7,
    "global_ayah_id": 6186,
    "translation": "心臓を焼き尽し，"
  },
  {
    "surah_id": 104,
    "ayah_number": 8,
    "global_ayah_id": 6187,
    "translation": "かれらの頭上に完全に覆い被さり，"
  },
  {
    "surah_id": 104,
    "ayah_number": 9,
    "global_ayah_id": 6188,
    "translation": "（逃れることの出来ない）列柱の中に。"
  }
]