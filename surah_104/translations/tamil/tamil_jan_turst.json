[
  {
    "surah_id": 104,
    "ayah_number": 1,
    "global_ayah_id": 6180,
    "translation": "குறை சொல்லிப் புறம் பேசித் திரியும் ஒவ்வொருவனுக்கும் கேடுதான்."
  },
  {
    "surah_id": 104,
    "ayah_number": 2,
    "global_ayah_id": 6181,
    "translation": "(அத்தகையவன் செல்வமே சாசுவதமென எண்ணிப்) பொருளைச் சேகரித்து எண்ணிக் கொண்டே இருக்கின்றான்."
  },
  {
    "surah_id": 104,
    "ayah_number": 3,
    "global_ayah_id": 6182,
    "translation": "நிச்சயமாகத், தன் பொருள் தன்னை (உலகில் நித்தியனாக) என்றும் நிலைத்திருக்கச் செய்யுமென்று அவன் எண்ணுகிறான்."
  },
  {
    "surah_id": 104,
    "ayah_number": 4,
    "global_ayah_id": 6183,
    "translation": "அப்படியல்ல, நிச்சயமாக அவன் ஹுதமாவில் எறியப்படுவான்."
  },
  {
    "surah_id": 104,
    "ayah_number": 5,
    "global_ayah_id": 6184,
    "translation": "ஹுதமா என்ன என்பதை உமக்கு அறிவித்தது எது?"
  },
  {
    "surah_id": 104,
    "ayah_number": 6,
    "global_ayah_id": 6185,
    "translation": "அது எரிந்து கொண்டிருக்கும் அல்லாஹ்வின் நெருப்பாகும்."
  },
  {
    "surah_id": 104,
    "ayah_number": 7,
    "global_ayah_id": 6186,
    "translation": "அது (உடலில் பட்டதும்) இருதயங்களில் பாயும்."
  },
  {
    "surah_id": 104,
    "ayah_number": 8,
    "global_ayah_id": 6187,
    "translation": "நிச்சயமாக அது அவர்களைச் சூழ்ந்து மூட்டப்படும்."
  },
  {
    "surah_id": 104,
    "ayah_number": 9,
    "global_ayah_id": 6188,
    "translation": "நீண்ட கம்பங்களில் (அவர்கள் கட்டப்பட்டவர்களாக)."
  }
]