[
  {
    "surah_id": 104,
    "ayah_number": 1,
    "global_ayah_id": 6180,
    "translation": "Горе всякому хулителю и обидчику,"
  },
  {
    "surah_id": 104,
    "ayah_number": 2,
    "global_ayah_id": 6181,
    "translation": "который копит состояние и пересчитывает его,"
  },
  {
    "surah_id": 104,
    "ayah_number": 3,
    "global_ayah_id": 6182,
    "translation": "думая, что богатство увековечит его."
  },
  {
    "surah_id": 104,
    "ayah_number": 4,
    "global_ayah_id": 6183,
    "translation": "Но нет! Его непременно ввергнут в Огонь сокрушающий."
  },
  {
    "surah_id": 104,
    "ayah_number": 5,
    "global_ayah_id": 6184,
    "translation": "Откуда ты мог знать, что такое Огонь сокрушающий?"
  },
  {
    "surah_id": 104,
    "ayah_number": 6,
    "global_ayah_id": 6185,
    "translation": "Это - разожженный Огонь Аллаха,"
  },
  {
    "surah_id": 104,
    "ayah_number": 7,
    "global_ayah_id": 6186,
    "translation": "который вздымается над сердцами."
  },
  {
    "surah_id": 104,
    "ayah_number": 8,
    "global_ayah_id": 6187,
    "translation": "Воистину, он сомкнется над ними"
  },
  {
    "surah_id": 104,
    "ayah_number": 9,
    "global_ayah_id": 6188,
    "translation": "высокими столбами (мученики будут прикованы к этим столбам или врата Ада будут заперты и закреплены этими столбами)."
  }
]