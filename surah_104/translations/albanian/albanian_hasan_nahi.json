[
  {
    "surah_id": 104,
    "ayah_number": 1,
    "global_ayah_id": 6180,
    "translation": "Mjer për çdo përqeshës – shpifës,"
  },
  {
    "surah_id": 104,
    "ayah_number": 2,
    "global_ayah_id": 6181,
    "translation": "që grumbullon pasuri dhe e ruan, (për ardhmërinë e ëndërruar)"
  },
  {
    "surah_id": 104,
    "ayah_number": 3,
    "global_ayah_id": 6182,
    "translation": "dhe mendon që ajo pasuri e tij, do ta bëjë të pavdekshëm!"
  },
  {
    "surah_id": 104,
    "ayah_number": 4,
    "global_ayah_id": 6183,
    "translation": "Jo, jo! Mashtrohet! Ai, me të vërtetë, do të hidhet (në) Hutameh (Skëterrë), i habitur;"
  },
  {
    "surah_id": 104,
    "ayah_number": 5,
    "global_ayah_id": 6184,
    "translation": "E kush të tregon ty se ç’është el-Hutameh?"
  },
  {
    "surah_id": 104,
    "ayah_number": 6,
    "global_ayah_id": 6185,
    "translation": "Ai është zjarri i ndezur i Zotit,"
  },
  {
    "surah_id": 104,
    "ayah_number": 7,
    "global_ayah_id": 6186,
    "translation": "i cili do të depërtojë deri në zemër."
  },
  {
    "surah_id": 104,
    "ayah_number": 8,
    "global_ayah_id": 6187,
    "translation": "Ai (zjarri) do të jetë i mbyllur mbi ta (si saç),"
  },
  {
    "surah_id": 104,
    "ayah_number": 9,
    "global_ayah_id": 6188,
    "translation": "në shtylla të gjata flakëruese."
  }
]