[
  {
    "surah_id": 104,
    "ayah_number": 0,
    "global_ayah_id": 6282,
    "translation": "అనంత కరుణామయుడు అపార కరుణాప్రదాత అయిన అల్లాహ్‌ పేరుతో"
  },
  {
    "surah_id": 104,
    "ayah_number": 1,
    "global_ayah_id": 6283,
    "translation": "అపనిందలు మోపే, చాడీలు చెప్పే ప్రతి ఒక్కడికీ వినాశం తప్పదు."
  },
  {
    "surah_id": 104,
    "ayah_number": 2,
    "global_ayah_id": 6284,
    "translation": "ఎవడైతే ధనాన్ని కూడబెట్టి, మాటిమాటికి దాన్ని లెక్కబెడుతూ ఉంటాడో!"
  },
  {
    "surah_id": 104,
    "ayah_number": 3,
    "global_ayah_id": 6285,
    "translation": "తన ధనం, తనను శాశ్వతంగా ఉంచుతుందని అతడు భావిస్తున్నాడు!"
  },
  {
    "surah_id": 104,
    "ayah_number": 4,
    "global_ayah_id": 6286,
    "translation": "ఎంత మాత్రం కాదు! అతడు (రాబోయే జీవితంలో) తప్పకుండా అణగ ద్రొక్కబడే నరకాగ్నిలో వేయబడతాడు."
  },
  {
    "surah_id": 104,
    "ayah_number": 5,
    "global_ayah_id": 6287,
    "translation": "ఆ (అణగద్రొక్కబడే) నరకాగ్ని అంటే ఏమిటో నీకు తెలుసా?"
  },
  {
    "surah_id": 104,
    "ayah_number": 6,
    "global_ayah_id": 6288,
    "translation": "అల్లాహ్‌, తీవ్రంగా ప్రజ్వలింపజేసిన అగ్ని"
  },
  {
    "surah_id": 104,
    "ayah_number": 7,
    "global_ayah_id": 6289,
    "translation": "అది గుండెల దాకా చేరుకుంటుంది."
  },
  {
    "surah_id": 104,
    "ayah_number": 8,
    "global_ayah_id": 6290,
    "translation": "నిశ్చయంగా, అది వారి మీద క్రమ్ము కొంటుంది"
  },
  {
    "surah_id": 104,
    "ayah_number": 9,
    "global_ayah_id": 6291,
    "translation": "పొడుగాటి (అగ్ని) స్తంభాలవలె!"
  }
]