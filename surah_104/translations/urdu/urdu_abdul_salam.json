  {
    "surah_id": 104,
    "ayah_number": 4,
    "global_ayah_id": 6286,
    "translation": "ہرگز نہیں، یقینا وہ ضرور حُطمہ میں پھینکا جائے گا۔ [4]"
  },
  {
    "surah_id": 104,
    "ayah_number": 5,
    "global_ayah_id": 6287,
    "translation": "اور تجھے کس چیز نے معلوم کروایا کہ وہ حطمہ کیا ہے؟ [5]"
  },
  {
    "surah_id": 104,
    "ayah_number": 6,
    "global_ayah_id": 6288,
    "translation": "اللہ کی بھڑکائی ہوئی «<a href=12> آگ </a>» ہے۔ [6]"
  },
  {
    "surah_id": 104,
    "ayah_number": 7,
    "global_ayah_id": 6289,
    "translation": "وہ جو دلوں پر جھانکتی ہے ۔ [7]"
  },
  {
    "surah_id": 104,
    "ayah_number": 8,
    "global_ayah_id": 6290,
    "translation": "یقینا وہ ان پر ( ہر طرف سے) «<a href=108> بند </a>» کی ہوئی ہے ۔ [8]"
  },
  {
    "surah_id": 104,
    "ayah_number": 9,
