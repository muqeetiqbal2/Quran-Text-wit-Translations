  {
    "surah_id": 104,
    "ayah_number": 3,
    "global_ayah_id": 6285,
    "translation": "وہ «<a href=530> گمان </a>» کرتا ہے کہ اس کا «<a href=563> مال </a>» اسے «<a href=652> ہمیشہ </a>» «<a href=381> زندہ\n</a>» رکھے گا۔ [3]"
