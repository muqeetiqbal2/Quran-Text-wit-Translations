[
  {
    "surah_id": 104,
    "ayah_number": 0,
    "global_ayah_id": 6282,
    "translation": "اللہ کے نام سے جو رحمان و رحیم ہے"
  },
  {
    "surah_id": 104,
    "ayah_number": 1,
    "global_ayah_id": 6283,
    "translation": "خرابی ہے ہر طعنہ دینے والے عیب چننے والے کی"
  },
  {
    "surah_id": 104,
    "ayah_number": 2,
    "global_ayah_id": 6284,
    "translation": "جس نے سمیٹا مال اور گن گن کر رکھا"
  },
  {
    "surah_id": 104,
    "ayah_number": 3,
    "global_ayah_id": 6285,
    "translation": "خیال رکھتا ہے کہ اُس کا مال سدا کو رہے گا اُسکے ساتھ"
  },
  {
    "surah_id": 104,
    "ayah_number": 4,
    "global_ayah_id": 6286,
    "translation": "کوئی نہیں وہ پھینکا جائے گا اُس روندنے والی میں"
  },
  {
    "surah_id": 104,
    "ayah_number": 5,
    "global_ayah_id": 6287,
    "translation": "اور تو کیا سمجھا کون ہے وہ روندنے والی"
  },
  {
    "surah_id": 104,
    "ayah_number": 6,
    "global_ayah_id": 6288,
    "translation": "ایک آگ ہے اللہ کی سلگائی ہوئی"
  },
  {
    "surah_id": 104,
    "ayah_number": 7,
    "global_ayah_id": 6289,
    "translation": "وہ جھانک لیتی ہے دل کو"
  },
  {
    "surah_id": 104,
    "ayah_number": 8,
    "global_ayah_id": 6290,
    "translation": "اُنکو اُس میں موند دیا ہے"
  },
  {
    "surah_id": 104,
    "ayah_number": 9,
    "global_ayah_id": 6291,
    "translation": "لنبے لنبے ستونوں میں"
  }
]