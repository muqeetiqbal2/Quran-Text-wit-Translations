  {
    "surah_id": 104,
    "ayah_number": 1,
    "global_ayah_id": 6180,
    "translation": "(انھيءَ) سڀڪنھن گلا ڪندڙ عيب ڳوليندڙ لاءِ ويل آھي."
  },
  {
    "surah_id": 104,
    "ayah_number": 2,
    "global_ayah_id": 6181,
    "translation": "جنھن مال گڏ ڪيو ۽ اُھو ڳڻي ڳڻي رکيائين."
  },
  {
    "surah_id": 104,
    "ayah_number": 3,
    "global_ayah_id": 6182,
    "translation": "ڀانئيندو آھي ته سندس مال سدائين رھندو."
  },
  {
    "surah_id": 104,
    "ayah_number": 4,
    "global_ayah_id": 6183,
    "translation": "ھرگز ائين نه آھي ضرور حُطمه ۾ اُڇلائبس."
  },
  {
    "surah_id": 104,
    "ayah_number": 5,
    "global_ayah_id": 6184,
    "translation": "۽ ڪنھن سمجھايئي ته حُطَمَه ڇا آھي؟"
  },
  {
    "surah_id": 104,
    "ayah_number": 6,
    "global_ayah_id": 6185,
    "translation": "الله جي ٻاريل باھ آھي."
  },
  {
    "surah_id": 104,
    "ayah_number": 7,
    "global_ayah_id": 6186,
    "translation": "جا دلين تي پھچندي."
  },
  {
    "surah_id": 104,
    "ayah_number": 8,
    "global_ayah_id": 6187,
    "translation": "بيشڪ اُھا مٿن در بند ڪيل آھي."
  },
  {
    "surah_id": 104,
    "ayah_number": 9,
    "global_ayah_id": 6188,
    "translation": "(جنھن حالت ۾ اُھي) ڊگھن ٿنڀن ۾ (ٻڌل ھوندا)."
  }
]