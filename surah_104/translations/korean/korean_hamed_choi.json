[
  {
    "surah_id": 104,
    "ayah_number": 1,
    "global_ayah_id": 6180,
    "translation": "뒤에서 중상모략하는 자에게재앙이 있을지니"
  },
  {
    "surah_id": 104,
    "ayah_number": 2,
    "global_ayah_id": 6181,
    "translation": "그는 재산을 모아 계산에 열 중하며"
  },
  {
    "surah_id": 104,
    "ayah_number": 3,
    "global_ayah_id": 6182,
    "translation": "그 재산이 현세에서 그를 영 원케 하리라 생각하도다"
  },
  {
    "surah_id": 104,
    "ayah_number": 4,
    "global_ayah_id": 6183,
    "translation": "그러나 그렇지 아니하니 그는 지옥에 던져지리라"
  },
  {
    "surah_id": 104,
    "ayah_number": 5,
    "global_ayah_id": 6184,
    "translation": "그 지옥이 무엇이지 무엇이 그대에게 알려주리요"
  },
  {
    "surah_id": 104,
    "ayah_number": 6,
    "global_ayah_id": 6185,
    "translation": "그것은 하나님의 분노가 타는 불지옥이거늘"
  },
  {
    "surah_id": 104,
    "ayah_number": 7,
    "global_ayah_id": 6186,
    "translation": "그 뜨거움이 가습을 에워싸고"
  },
  {
    "surah_id": 104,
    "ayah_number": 8,
    "global_ayah_id": 6187,
    "translation": "그들에게 문이 잠겨져 버리며"
  },
  {
    "surah_id": 104,
    "ayah_number": 9,
    "global_ayah_id": 6188,
    "translation": "기둥들로 빗장이 내려지노라"
  }
]