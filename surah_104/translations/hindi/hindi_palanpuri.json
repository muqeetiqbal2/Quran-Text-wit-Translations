    "surah_id": 104,
    "ayah_number": 0,
    "global_ayah_id": 6282,
    "translation": "अल्लाह के नाम से जो बड़ा कृपालु और अत्यन्त दयावान है।"
  },
  {
    "surah_id": 104,
    "ayah_number": 1,
    "global_ayah_id": 6283,
    "translation": "तबाही है हर कचोके लगाने वाले, ऐब निकालने वाले के लिए,"
  },
  {
    "surah_id": 104,
    "ayah_number": 2,
    "global_ayah_id": 6284,
    "translation": "जो माल इकट्ठा करता और उसे गिनता रहा"
  },
  {
    "surah_id": 104,
    "ayah_number": 3,
    "global_ayah_id": 6285,
    "translation": "समझता है कि उस के माल ने उसे अमर कर दिया"
  },
  {
    "surah_id": 104,
    "ayah_number": 4,
    "global_ayah_id": 6286,
    "translation": "कदापि नहीं, वह चूर-चूर कर देने वाली में फेंक दिया जाएगा,"
  },
  {
    "surah_id": 104,
    "ayah_number": 5,
    "global_ayah_id": 6287,
    "translation": "और तुम्हें क्या मालूम कि वह चूर-चूर कर देने वाली क्या है?"
  },
  {
    "surah_id": 104,
    "ayah_number": 6,
    "global_ayah_id": 6288,
    "translation": "वह अल्लाह की दहकाई हुई आग है,"
  },
  {
    "surah_id": 104,
    "ayah_number": 7,
    "global_ayah_id": 6289,
    "translation": "जो झाँक लेती है दिलों को"
  },
  {
    "surah_id": 104,
    "ayah_number": 8,
    "global_ayah_id": 6290,
    "translation": "वह उन पर ढाँककर बन्द कर दी गई होगी,"
  },
  {
    "surah_id": 104,
    "ayah_number": 9,
    "global_ayah_id": 6291,
    "translation": "लम्बे-लम्बे स्तम्भों में"
  }
