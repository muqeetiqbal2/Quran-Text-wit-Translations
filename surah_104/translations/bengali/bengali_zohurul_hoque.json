[
  {
    "surah_id": 104,
    "ayah_number": 1,
    "global_ayah_id": 6180,
    "translation": "ধিক্ প্রত্যেক নিন্দাকারী কুৎসারটনাকারীর প্রতি,"
  },
  {
    "surah_id": 104,
    "ayah_number": 2,
    "global_ayah_id": 6181,
    "translation": "যে ধনসম্পদ জমা করছে এবং তা গুনছে,"
  },
  {
    "surah_id": 104,
    "ayah_number": 3,
    "global_ayah_id": 6182,
    "translation": "সে ভাবছে যে তার ধনসম্পত্তি তাকে অমর করবে।"
  },
  {
    "surah_id": 104,
    "ayah_number": 4,
    "global_ayah_id": 6183,
    "translation": "কখনো না! তাকে অবশ্যই নিক্ষেপ করা হবে সর্বনাশা দুর্ঘটনায়।"
  },
  {
    "surah_id": 104,
    "ayah_number": 5,
    "global_ayah_id": 6184,
    "translation": "আর কিসে তোমাকে বোঝানো যাবে সেই হুতামাহ্ কি?"
  },
  {
    "surah_id": 104,
    "ayah_number": 6,
    "global_ayah_id": 6185,
    "translation": "তা আল্লাহ্‌র হুতাশন, প্রজ্জ্বলিত রয়েছে --"
  },
  {
    "surah_id": 104,
    "ayah_number": 7,
    "global_ayah_id": 6186,
    "translation": "যা উদিত হয়েছে হৃদয়ের উপরে।"
  },
  {
    "surah_id": 104,
    "ayah_number": 8,
    "global_ayah_id": 6187,
    "translation": "নিঃসন্দেহ এটি হচ্ছে তাদের চারপাশে এক বেড়া --"
  },
  {
    "surah_id": 104,
    "ayah_number": 9,
    "global_ayah_id": 6188,
    "translation": "সারিসারি খুটিরঁ ভেতরে।"
  }
]