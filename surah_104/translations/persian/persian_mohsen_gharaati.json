[
  {
    "surah_id": 104,
    "ayah_number": 1,
    "global_ayah_id": 6180,
    "translation": "وای بر هر عیب‌جوی طعنه‌زن!"
  },
  {
    "surah_id": 104,
    "ayah_number": 2,
    "global_ayah_id": 6181,
    "translation": "آن که ثروتی فراهم آورده و [پی در پی] آن را می‌شمارد."
  },
  {
    "surah_id": 104,
    "ayah_number": 3,
    "global_ayah_id": 6182,
    "translation": "می‌پندارد که دارایی‌اش او را جاودان ساخته است."
  },
  {
    "surah_id": 104,
    "ayah_number": 4,
    "global_ayah_id": 6183,
    "translation": "هرگز! سوگند که او در آتش افکنده می‌شود."
  },
  {
    "surah_id": 104,
    "ayah_number": 5,
    "global_ayah_id": 6184,
    "translation": "و چه می‌دانی که آن آتش چیست؟"
  },
  {
    "surah_id": 104,
    "ayah_number": 6,
    "global_ayah_id": 6185,
    "translation": "آتش افروخته‌ی خداست،"
  },
  {
    "surah_id": 104,
    "ayah_number": 7,
    "global_ayah_id": 6186,
    "translation": "که بر دل‌ها راه می‌یابد."
  },
  {
    "surah_id": 104,
    "ayah_number": 8,
    "global_ayah_id": 6187,
    "translation": "آن آتش بر آنان سربسته است [و راه گریزی ندارند آن نیست]،"
  },
  {
    "surah_id": 104,
    "ayah_number": 9,
    "global_ayah_id": 6188,
    "translation": "[آتشی] در ستون‌هایی بلند و کشیده."
  }
]