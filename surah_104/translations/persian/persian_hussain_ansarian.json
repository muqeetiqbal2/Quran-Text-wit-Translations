[
  {
    "surah_id": 104,
    "ayah_number": 1,
    "global_ayah_id": 6180,
    "translation": "وای بر هر عیب جوی بدگوی!"
  },
  {
    "surah_id": 104,
    "ayah_number": 2,
    "global_ayah_id": 6181,
    "translation": "همان که ثروتی فراهم آورده و [پی در پی] آن را شمرد [و ذخیره کرد.]"
  },
  {
    "surah_id": 104,
    "ayah_number": 3,
    "global_ayah_id": 6182,
    "translation": "گمان می کند که ثروتش او را جاودانه خواهد کرد."
  },
  {
    "surah_id": 104,
    "ayah_number": 4,
    "global_ayah_id": 6183,
    "translation": "این چنین نیست، بی تردید او را در آن شکننده، اندازند؛"
  },
  {
    "surah_id": 104,
    "ayah_number": 5,
    "global_ayah_id": 6184,
    "translation": "و تو چه می دانی آن شکننده چیست؟"
  },
  {
    "surah_id": 104,
    "ayah_number": 6,
    "global_ayah_id": 6185,
    "translation": "آتش برافروخته خداست"
  },
  {
    "surah_id": 104,
    "ayah_number": 7,
    "global_ayah_id": 6186,
    "translation": "[آتشی] که بر دل ها برآید و چیره شود."
  },
  {
    "surah_id": 104,
    "ayah_number": 8,
    "global_ayah_id": 6187,
    "translation": "آن آتش بر آنان سربسته است [که هیچ راه گریزی از آن ندارند؛]"
  },
  {
    "surah_id": 104,
    "ayah_number": 9,
    "global_ayah_id": 6188,
    "translation": "[آتشی] در ستون هایی بلند و کشیده."
  }
]