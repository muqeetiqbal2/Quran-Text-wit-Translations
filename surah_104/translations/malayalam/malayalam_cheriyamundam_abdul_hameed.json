[
  {
    "surah_id": 104,
    "ayah_number": 1,
    "global_ayah_id": 6180,
    "translation": "കുത്തുവാക്ക് പറയുന്നവനും അവഹേളിക്കുന്നവനുമായ ഏതൊരാള്‍ക്കും നാശം."
  },
  {
    "surah_id": 104,
    "ayah_number": 2,
    "global_ayah_id": 6181,
    "translation": "അതായത് ധനം ശേഖരിക്കുകയും അത് എണ്ണിനോക്കിക്കൊണ്ടിരിക്കുകയും ചെയ്യുന്നവന്‌."
  },
  {
    "surah_id": 104,
    "ayah_number": 3,
    "global_ayah_id": 6182,
    "translation": "അവന്‍റെ ധനം അവന് ശാശ്വത ജീവിതം നല്‍കിയിരിക്കുന്നു എന്ന് അവന്‍ വിചാരിക്കുന്നു."
  },
  {
    "surah_id": 104,
    "ayah_number": 4,
    "global_ayah_id": 6183,
    "translation": "നിസ്സംശയം, അവന്‍ ഹുത്വമയില്‍ എറിയപ്പെടുക തന്നെ ചെയ്യും."
  },
  {
    "surah_id": 104,
    "ayah_number": 5,
    "global_ayah_id": 6184,
    "translation": "ഹുത്വമ എന്നാല്‍ എന്താണെന്ന് നിനക്കറിയാമോ?"
  },
  {
    "surah_id": 104,
    "ayah_number": 6,
    "global_ayah_id": 6185,
    "translation": "അത് അല്ലാഹുവിന്‍റെ ജ്വലിപ്പിക്കപ്പെട്ട അഗ്നിയാകുന്നു."
  },
  {
    "surah_id": 104,
    "ayah_number": 7,
    "global_ayah_id": 6186,
    "translation": "ഹൃദയങ്ങളിലേക്ക് കത്തിപ്പടരുന്നതായ"
  },
  {
    "surah_id": 104,
    "ayah_number": 8,
    "global_ayah_id": 6187,
    "translation": "തീര്‍ച്ചയായും അത് അവരുടെ മേല്‍ അടച്ചുമൂടപ്പെടുന്നതായിരിക്കും."
  },
  {
    "surah_id": 104,
    "ayah_number": 9,
    "global_ayah_id": 6188,
    "translation": "നീട്ടിയുണ്ടാക്കപ്പെട്ട സ്തംഭങ്ങളിലായിക്കൊണ്ട്‌."
  }
]