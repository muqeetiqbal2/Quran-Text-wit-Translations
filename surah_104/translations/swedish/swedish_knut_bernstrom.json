[
  {
    "surah_id": 104,
    "ayah_number": 1,
    "global_ayah_id": 6180,
    "translation": "ILLA SKALL det gå den som försöker finna fel hos [andra] och baktalar dem!"
  },
  {
    "surah_id": 104,
    "ayah_number": 2,
    "global_ayah_id": 6181,
    "translation": "[Och] som samlar pengar på hög och [i stället för att göra gott] ägnar sig åt att räkna dem"
  },
  {
    "surah_id": 104,
    "ayah_number": 3,
    "global_ayah_id": 6182,
    "translation": "i förhoppningen att hans rikedom skall ge honom evigt liv!"
  },
  {
    "surah_id": 104,
    "ayah_number": 4,
    "global_ayah_id": 6183,
    "translation": "Nej [han misstar sig]! Han kommer att kastas i Hutamah!"
  },
  {
    "surah_id": 104,
    "ayah_number": 5,
    "global_ayah_id": 6184,
    "translation": "Och vad kan låta dig förstå vad Hutamah betyder"
  },
  {
    "surah_id": 104,
    "ayah_number": 6,
    "global_ayah_id": 6185,
    "translation": "[Det är] Guds eld,"
  },
  {
    "surah_id": 104,
    "ayah_number": 7,
    "global_ayah_id": 6186,
    "translation": "som skall blossa upp och tränga in i [syndarnas] hjärtan;"
  },
  {
    "surah_id": 104,
    "ayah_number": 8,
    "global_ayah_id": 6187,
    "translation": "och sluta sig omkring dem"
  },
  {
    "surah_id": 104,
    "ayah_number": 9,
    "global_ayah_id": 6188,
    "translation": "i ändlösa kolonnader av eld!"
  }
]