[
  {
    "surah_id": 79,
    "ayah_number": 1,
    "global_ayah_id": 5713,
    "translation": "በኃይል አውጪዎች በኾኑት፤"
  },
  {
    "surah_id": 79,
    "ayah_number": 2,
    "global_ayah_id": 5714,
    "translation": "በቀስታ መምዘዝንም መዘዦች በኾኑት፤"
  },
  {
    "surah_id": 79,
    "ayah_number": 3,
    "global_ayah_id": 5715,
    "translation": "መዋኘትም ዋኚዎች በኾኑት፤"
  },
  {
    "surah_id": 79,
    "ayah_number": 4,
    "global_ayah_id": 5716,
    "translation": "መቅደምንም ቀዳሚዎች በኾኑት፤"
  },
  {
    "surah_id": 79,
    "ayah_number": 5,
    "global_ayah_id": 5717,
    "translation": "ነገርንም አስተናባሪዎች በኾኑት (መላእክት) እምላለሁ፡፡ (በእርግጥ ትቀሰቀሳላችሁ)፡፡"
  },
  {
    "surah_id": 79,
    "ayah_number": 6,
    "global_ayah_id": 5718,
    "translation": "ተርገፍጋፊይቱ (ምድር) በምትርገፈገፍበት ቀን፤"
  },
  {
    "surah_id": 79,
    "ayah_number": 7,
    "global_ayah_id": 5719,
    "translation": "ለጣቂይቱ የምትከተላት ስትኾን (ትቀሰቀሳላችሁ)፡፡"
  },
  {
    "surah_id": 79,
    "ayah_number": 8,
    "global_ayah_id": 5720,
    "translation": "በዚያ ቀን ልቦች ተሸባሪዎች ናቸው፡፡"
  },
  {
    "surah_id": 79,
    "ayah_number": 9,
    "global_ayah_id": 5721,
    "translation": "ዓይኖቻቸው ተዋራጆች (አቀርቃሪዎች) ናቸው፡፡"
  },
  {
    "surah_id": 79,
    "ayah_number": 10,
    "global_ayah_id": 5722,
    "translation": "«እኛ ወደ መጀመሪያይቱ ኹነታ ተመላሾች ነን?» ይላሉ፡፡"
  },
  {
    "surah_id": 79,
    "ayah_number": 11,
    "global_ayah_id": 5723,
    "translation": "«የበሰበሱ አጥንቶች በኾን ጊዜ (እንቀሰቀሳለን?)»"
  },
  {
    "surah_id": 79,
    "ayah_number": 12,
    "global_ayah_id": 5724,
    "translation": "«ይህቺ ያን ጊዜ ባለ ከሳራ መመለስ ናት» ይላሉ፡፡"
  },
  {
    "surah_id": 79,
    "ayah_number": 13,
    "global_ayah_id": 5725,
    "translation": "እርሷም አንዲት ጩኸት ብቻ ናት፡፡"
  },
  {
    "surah_id": 79,
    "ayah_number": 14,
    "global_ayah_id": 5726,
    "translation": "ወዲያውኑም እነርሱ እንቅልፍ በሌለባት (ምድር) ላይ ይኾናሉ፡፡"
  },
  {
    "surah_id": 79,
    "ayah_number": 15,
    "global_ayah_id": 5727,
    "translation": "የሙሳ ወሬ መጣልህን?"
  },
  {
    "surah_id": 79,
    "ayah_number": 16,
    "global_ayah_id": 5728,
    "translation": "ጌታው በተቀደሰው ሸለቆ በጡዋ በጠራው ጊዜ፤"
  },
  {
    "surah_id": 79,
    "ayah_number": 17,
    "global_ayah_id": 5729,
    "translation": "ወደ ፈርዖን ኺድ፡፡ እርሱ ወሰን አልፏልና፡፡"
  },
  {
    "surah_id": 79,
    "ayah_number": 18,
    "global_ayah_id": 5730,
    "translation": "በለውም፡- «ወደ መጥራራትህ ላንተ (መንገድ) አለህን?»"
  },
  {
    "surah_id": 79,
    "ayah_number": 19,
    "global_ayah_id": 5731,
    "translation": "«ወደ ጌታህም ልመራህ ትፈራውም ዘንድ፤ (መንገድ አለህን?)» አለው፡፡"
  },
  {
    "surah_id": 79,
    "ayah_number": 20,
    "global_ayah_id": 5732,
    "translation": "ታላቂቱንም ተዓምር አሳየው፡፡"
  },
  {
    "surah_id": 79,
    "ayah_number": 21,
    "global_ayah_id": 5733,
    "translation": "አስተባበለም፤ አመጸም፡፡"
  },
  {
    "surah_id": 79,
    "ayah_number": 22,
    "global_ayah_id": 5734,
    "translation": "ከዚያም (ለማጥፋት) የሚተጋ ኾኖ ዞረ፡፡"
  },
  {
    "surah_id": 79,
    "ayah_number": 23,
    "global_ayah_id": 5735,
    "translation": "(ሰራዊቶቹን) ሰበሰበም፤ ተጣራም፡፡"
  },
  {
    "surah_id": 79,
    "ayah_number": 24,
    "global_ayah_id": 5736,
    "translation": "አለም፡- «እኔ ታላቁ ጌታችሁ ነኝ፡፡»"
  },
  {
    "surah_id": 79,
    "ayah_number": 25,
    "global_ayah_id": 5737,
    "translation": "አላህም በኋለኛይቱና በፊተኛይቱ (ቃል) ቅጣት ያዘው፡፡"
  },
  {
    "surah_id": 79,
    "ayah_number": 26,
    "global_ayah_id": 5738,
    "translation": "በዚህ ውስጥ ለሚፈራ ሰው በእርግጥ መገምገሚያ አለበት፡፡"
  },
  {
    "surah_id": 79,
    "ayah_number": 27,
    "global_ayah_id": 5739,
    "translation": "ባፈጣጠር እናንተ ይበልጥ የበረታችሁ ናችሁን? ወይንስ ሰማይ? (አላህ) ገነባት፡፡"
  },
  {
    "surah_id": 79,
    "ayah_number": 28,
    "global_ayah_id": 5740,
    "translation": "ከፍታዋን አጓነ፤ አስተካከላትም፡፡"
  },
  {
    "surah_id": 79,
    "ayah_number": 29,
    "global_ayah_id": 5741,
    "translation": "ሌሊቷንም አጨለመ፡፡ ቀንዋንም ገለጸ፡፡"
  },
  {
    "surah_id": 79,
    "ayah_number": 30,
    "global_ayah_id": 5742,
    "translation": "ምድርንም ከዚህ በኋላ ዘረጋት፡፡"
  },
  {
    "surah_id": 79,
    "ayah_number": 31,
    "global_ayah_id": 5743,
    "translation": "ውሃዋንና ግጦሿን ከእርሷ አወጣ፡፡"
  },
  {
    "surah_id": 79,
    "ayah_number": 32,
    "global_ayah_id": 5744,
    "translation": "ጋራዎችንም አደላደላቸው፡፡"
  },
  {
    "surah_id": 79,
    "ayah_number": 33,
    "global_ayah_id": 5745,
    "translation": "ለእናንተና ለእንስሶቻችሁ መጣቀሚያ ይኾን ዘንድ (ይህን አደረገ)፡፡"
  },
  {
    "surah_id": 79,
    "ayah_number": 34,
    "global_ayah_id": 5746,
    "translation": "ታላቂቱም መዐት በመጣች ጊዜ፣"
  },
  {
    "surah_id": 79,
    "ayah_number": 35,
    "global_ayah_id": 5747,
    "translation": "ሰው ሁሉ የሠራውን በሚያስታውስበት ቀን፣"
  },
  {
    "surah_id": 79,
    "ayah_number": 36,
    "global_ayah_id": 5748,
    "translation": "ገሀነምም ለሚያይ ሰው በተገለጠች ጊዜ፣"
  },
  {
    "surah_id": 79,
    "ayah_number": 37,
    "global_ayah_id": 5749,
    "translation": "የካደ ሰውማ፣"
  },
  {
    "surah_id": 79,
    "ayah_number": 38,
    "global_ayah_id": 5750,
    "translation": "ቅርቢቱንም ሕይወት የመረጠ፣"
  },
  {
    "surah_id": 79,
    "ayah_number": 39,
    "global_ayah_id": 5751,
    "translation": "ገሀነም እርሷ በእርግጥ መኖሪያው ናት፡፡"
  },
  {
    "surah_id": 79,
    "ayah_number": 40,
    "global_ayah_id": 5752,
    "translation": "በጌታው ፊት መቆምን የፈራ ሰውማ ነፍሱንም ከዝንባሌዋ የከለከለ"
  },
  {
    "surah_id": 79,
    "ayah_number": 41,
    "global_ayah_id": 5753,
    "translation": "ገነት እርሷ በእርግጥ መኖሪያው ናት፡፡"
  },
  {
    "surah_id": 79,
    "ayah_number": 42,
    "global_ayah_id": 5754,
    "translation": "«ከሰዓቲቱ መቼ ነው መኾኛዋ?» ሲሉ ይጠይቁሃል፡፡"
  },
  {
    "surah_id": 79,
    "ayah_number": 43,
    "global_ayah_id": 5755,
    "translation": "አንተ እርሷን ከማስታወስ በምን ውስጥ ነህ?"
  },
  {
    "surah_id": 79,
    "ayah_number": 44,
    "global_ayah_id": 5756,
    "translation": "(የዕውቀት) መጨረሻዋ ወደ ጌታህ ብቻ ነው፡፡"
  },
  {
    "surah_id": 79,
    "ayah_number": 45,
    "global_ayah_id": 5757,
    "translation": "አንተ የሚፈራትን ሰው አስፈራሪ ብቻ ነህ፡፡"
  },
  {
    "surah_id": 79,
    "ayah_number": 46,
    "global_ayah_id": 5758,
    "translation": "እነርሱ በሚያዩዋት ቀን ያንዲት ቀን ምሽትን ወይም ረፏዷን እንጅ ያልቆዩ ይመስላሉ፡፡"
  }
]