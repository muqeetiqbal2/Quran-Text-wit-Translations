[
  {
    "surah_id": 79,
    "ayah_number": 1,
    "global_ayah_id": 5713,
    "translation": "Кълна се в изтръгващите [душите] с все сила"
  },
  {
    "surah_id": 79,
    "ayah_number": 2,
    "global_ayah_id": 5714,
    "translation": "и в изваждащите [ги] нежно,"
  },
  {
    "surah_id": 79,
    "ayah_number": 3,
    "global_ayah_id": 5715,
    "translation": "и в спускащите се бързо,"
  },
  {
    "surah_id": 79,
    "ayah_number": 4,
    "global_ayah_id": 5716,
    "translation": "и в гонещите се в надпревара,"
  },
  {
    "surah_id": 79,
    "ayah_number": 5,
    "global_ayah_id": 5717,
    "translation": "и в изпълняващите повелите!"
  },
  {
    "surah_id": 79,
    "ayah_number": 6,
    "global_ayah_id": 5718,
    "translation": "В Деня, когато [се протръби с първия Рог] ще се разтърси тресящата се [вселена],"
  },
  {
    "surah_id": 79,
    "ayah_number": 7,
    "global_ayah_id": 5719,
    "translation": "ще последва второто [протръбяване]."
  },
  {
    "surah_id": 79,
    "ayah_number": 8,
    "global_ayah_id": 5720,
    "translation": "Някои сърца в този Ден ще тръпнат."
  },
  {
    "surah_id": 79,
    "ayah_number": 9,
    "global_ayah_id": 5721,
    "translation": "Погледите им ще бъдат сведени."
  },
  {
    "surah_id": 79,
    "ayah_number": 10,
    "global_ayah_id": 5722,
    "translation": "Ще кажат: “Нима ще бъдем върнати към предишното,"
  },
  {
    "surah_id": 79,
    "ayah_number": 11,
    "global_ayah_id": 5723,
    "translation": "нима, след като бяхме прогнили кости?”"
  },
  {
    "surah_id": 79,
    "ayah_number": 12,
    "global_ayah_id": 5724,
    "translation": "Ще кажат: “Това тогава е завръщане със загуба.”"
  },
  {
    "surah_id": 79,
    "ayah_number": 13,
    "global_ayah_id": 5725,
    "translation": "То е само едно протръбяване -"
  },
  {
    "surah_id": 79,
    "ayah_number": 14,
    "global_ayah_id": 5726,
    "translation": "и ето всички - възкръснали!"
  },
  {
    "surah_id": 79,
    "ayah_number": 15,
    "global_ayah_id": 5727,
    "translation": "[О, Мухаммад], стигна ли до теб разказът за Муса?"
  },
  {
    "surah_id": 79,
    "ayah_number": 16,
    "global_ayah_id": 5728,
    "translation": "Когато неговият Господ го призова в свещената долина Туа:"
  },
  {
    "surah_id": 79,
    "ayah_number": 17,
    "global_ayah_id": 5729,
    "translation": "“Иди при Фараона! Той престъпи."
  },
  {
    "surah_id": 79,
    "ayah_number": 18,
    "global_ayah_id": 5730,
    "translation": "И кажи: “Не ще ли се пречистиш,"
  },
  {
    "surah_id": 79,
    "ayah_number": 19,
    "global_ayah_id": 5731,
    "translation": "да те напътя към твоя Господ и да се побоиш?””"
  },
  {
    "surah_id": 79,
    "ayah_number": 20,
    "global_ayah_id": 5732,
    "translation": "И му показа [Муса] най-голямото знамение."
  },
  {
    "surah_id": 79,
    "ayah_number": 21,
    "global_ayah_id": 5733,
    "translation": "И взе го за лъжа, и се възпротиви."
  },
  {
    "surah_id": 79,
    "ayah_number": 22,
    "global_ayah_id": 5734,
    "translation": "После се отвърна с упорство."
  },
  {
    "surah_id": 79,
    "ayah_number": 23,
    "global_ayah_id": 5735,
    "translation": "И насъбра [хората си], и прогласи."
  },
  {
    "surah_id": 79,
    "ayah_number": 24,
    "global_ayah_id": 5736,
    "translation": "Каза: “Аз съм вашият господ, върховният.”"
  },
  {
    "surah_id": 79,
    "ayah_number": 25,
    "global_ayah_id": 5737,
    "translation": "И Аллах го сграбчи с наказание в отвъдния и в земния живот."
  },
  {
    "surah_id": 79,
    "ayah_number": 26,
    "global_ayah_id": 5738,
    "translation": "В това има поучение за всеки богобоязлив."
  },
  {
    "surah_id": 79,
    "ayah_number": 27,
    "global_ayah_id": 5739,
    "translation": "Вие ли сте по-трудни за сътворяване или небето? Той го съгради."
  },
  {
    "surah_id": 79,
    "ayah_number": 28,
    "global_ayah_id": 5740,
    "translation": "Въздигна неговия свод и го изравни,"
  },
  {
    "surah_id": 79,
    "ayah_number": 29,
    "global_ayah_id": 5741,
    "translation": "и потъмни нощта му, и изведе утрото му,"
  },
  {
    "surah_id": 79,
    "ayah_number": 30,
    "global_ayah_id": 5742,
    "translation": "и земята след това разпростря."
  },
  {
    "surah_id": 79,
    "ayah_number": 31,
    "global_ayah_id": 5743,
    "translation": "Извади от нея водите и пасбищата й,"
  },
  {
    "surah_id": 79,
    "ayah_number": 32,
    "global_ayah_id": 5744,
    "translation": "и планините поби"
  },
  {
    "surah_id": 79,
    "ayah_number": 33,
    "global_ayah_id": 5745,
    "translation": "за ползване от вас и от вашия добитък."
  },
  {
    "surah_id": 79,
    "ayah_number": 34,
    "global_ayah_id": 5746,
    "translation": "И когато настъпи Голямото прииждане,"
  },
  {
    "surah_id": 79,
    "ayah_number": 35,
    "global_ayah_id": 5747,
    "translation": "тогава в Деня човек ще си припомни за какво се е старал,"
  },
  {
    "surah_id": 79,
    "ayah_number": 36,
    "global_ayah_id": 5748,
    "translation": "и Адът ще бъде показан на всеки, който вижда..."
  },
  {
    "surah_id": 79,
    "ayah_number": 37,
    "global_ayah_id": 5749,
    "translation": "За който е престъпвал"
  },
  {
    "surah_id": 79,
    "ayah_number": 38,
    "global_ayah_id": 5750,
    "translation": "и е предпочел земния живот,"
  },
  {
    "surah_id": 79,
    "ayah_number": 39,
    "global_ayah_id": 5751,
    "translation": "обиталището е Адът."
  },
  {
    "surah_id": 79,
    "ayah_number": 40,
    "global_ayah_id": 5752,
    "translation": "За който се е страхувал да не застане пред своя Господ [с грях] и е въздържал душата от страстта,"
  },
  {
    "surah_id": 79,
    "ayah_number": 41,
    "global_ayah_id": 5753,
    "translation": "обиталището е Раят."
  },
  {
    "surah_id": 79,
    "ayah_number": 42,
    "global_ayah_id": 5754,
    "translation": "Питат те [о, Мухаммад] за Часа: “Кога ще настъпи?”"
  },
  {
    "surah_id": 79,
    "ayah_number": 43,
    "global_ayah_id": 5755,
    "translation": "Какво [знание имаш] ти да го споменеш?"
  },
  {
    "surah_id": 79,
    "ayah_number": 44,
    "global_ayah_id": 5756,
    "translation": "При твоя Господ е пределът му."
  },
  {
    "surah_id": 79,
    "ayah_number": 45,
    "global_ayah_id": 5757,
    "translation": "Ти си само предупредител за всеки, който се страхува от него."
  },
  {
    "surah_id": 79,
    "ayah_number": 46,
    "global_ayah_id": 5758,
    "translation": "В Деня, когато го видят, те сякаш ще са пребивавали само една привечер или утрин."
  }
]