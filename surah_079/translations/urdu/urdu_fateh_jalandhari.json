[
  {
    "surah_id": 79,
    "ayah_number": 0,
    "global_ayah_id": 5790,
    "translation": " «<a href=416> شروع </a>» خدائے رحمٰن ورحیم کے «<a href=614> نام </a>» سے "
  },
  {
    "surah_id": 79,
    "ayah_number": 1,
    "global_ayah_id": 5791,
    "translation": " شاہد ہیں جڑوں سے اکھاڑ پھینکنے والی ہوائیں! "
  },
  {
    "surah_id": 79,
    "ayah_number": 2,
    "global_ayah_id": 5792,
    "translation": " اور شاہد ہیں «<a href=20> آہستہ </a>» چلنے والی ہوائیں! "
  },
  {
    "surah_id": 79,
    "ayah_number": 3,
    "global_ayah_id": 5793,
    "translation": " اور شاہد ہیں فضاؤں میں تیرنے والے بادل! "
  },
  {
    "surah_id": 79,
    "ayah_number": 4,
    "global_ayah_id": 5794,
    "translation": " پھر ایک دوسرے پر سبقت کرنے والے! "
  },
  {
    "surah_id": 79,
    "ayah_number": 5,
    "global_ayah_id": 5795,
    "translation": " اور خدا کے «<a href=288> حکم </a>» سے نازل کرنے والے ( کہ جس چیز سے تمہیں ڈرایا\nجارہا ہے وہ شدنی ہے! ) "
  },
  {
    "surah_id": 79,
    "ayah_number": 6,
    "global_ayah_id": 5796,
    "translation": " ( اس «<a href=326> دن </a>» سے ڈرو ) جس «<a href=326> دن </a>» کپکپی پڑے گی ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 7,
    "global_ayah_id": 5797,
    "translation": " اس کے «<a href=179> پیچھے </a>» ایک دوسرا جھٹکا آئے گا ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 8,
    "global_ayah_id": 5798,
    "translation": " کتنے «<a href=324> دل </a>» اس «<a href=326> دن </a>» دھڑکتے ہوں گے ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 9,
    "global_ayah_id": 5799,
    "translation": " ان کی نگاہیں پست ہوں گی ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 10,
    "global_ayah_id": 5800,
    "translation": " پوچھتے ہیں: کیا ہم پھر پہلی «<a href=280> حالت </a>» میں لوٹائے جائیں گے؟ "
  },
  {
    "surah_id": 79,
    "ayah_number": 11,
    "global_ayah_id": 5801,
    "translation": " کیا جبکہ ہم کھنکھناتی ہڈیاں ہوچکیں گے؟ "
  },
  {
    "surah_id": 79,
    "ayah_number": 12,
    "global_ayah_id": 5802,
    "translation": " کہتے ہیں: یہ لوٹایا جانا تو بڑے ہی خسارے کا ہوگا ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 13,
    "global_ayah_id": 5803,
    "translation": " وہ تو بس ایک ڈانٹ ہوگی ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 14,
    "global_ayah_id": 5804,
    "translation": " کہ دفعۃً وہ میدان میں آموجود ہوں گے ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 15,
    "global_ayah_id": 5805,
    "translation": " کیا موسیٰ کی سرگزشت تمہیں پہنچی ہے؟ "
  },
  {
    "surah_id": 79,
    "ayah_number": 16,
    "global_ayah_id": 5806,
    "translation": " جبکہ اس کے رب نے وادیٔ مقدس – طویٰ – میں اس کو پکارا "
  },
  {
    "surah_id": 79,
    "ayah_number": 17,
    "global_ayah_id": 5807,
    "translation": " کہ تم فرعون کے «<a href=141> پاس </a>» جاؤ! اس نے بہت «<a href=393> سر </a>» اٹھایا\nہے ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 18,
    "global_ayah_id": 5808,
    "translation": " تو اس سے کہو کہ کیا تم میں کچھ اپنے کو سدھارنے کا جذبہ ہے؟ "
  },
  {
    "surah_id": 79,
    "ayah_number": 19,
    "global_ayah_id": 5809,
    "translation": " تو کیا میں تمہیں تمہارے رب کی راہ دکھاؤں کہ تم اس سے ڈرنے والے بنو؟ "
  },
  {
    "surah_id": 79,
    "ayah_number": 20,
    "global_ayah_id": 5810,
    "translation": " پس اس نے اس کو بڑی «<a href=620> نشانی </a>» دکھائی ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 21,
    "global_ayah_id": 5811,
    "translation": " تو اس نے جھٹلایا اور «<a href=71> بات </a>» نہ مانی ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 22,
    "global_ayah_id": 5812,
    "translation": " پھر پلٹا اپنی سرگرمیوں کو تیز کرتے ہوئے ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 23,
    "global_ayah_id": 5813,
    "translation": " پس جمع کیا اور اعلان کیا ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 24,
    "global_ayah_id": 5814,
    "translation": " تو اس نے کہا کہ تمہارا ربِ اعلیٰ تو میں ہوں! "
  },
  {
    "surah_id": 79,
    "ayah_number": 25,
    "global_ayah_id": 5815,
    "translation": " پس اللہ نے اس کو «<a href=2> آخرت </a>» اور «<a href=327> دنیا </a>» کے «<a\n  href=440> عذاب </a>» میں پکڑا ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 26,
    "global_ayah_id": 5816,
    "translation": " بیشک اس میں سبق ہے ان لوگوں کیلئے جو ڈر رکھنے والے ہیں ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 27,
    "global_ayah_id": 5817,
    "translation": " کیا تمہارا بنانا «<a href=636> زیادہ </a>» دشوار ہے یا «<a href=10> آسمان </a>» کا؟\nاس کو اٹھایا "
  },
  {
    "surah_id": 79,
    "ayah_number": 28,
    "global_ayah_id": 5818,
    "translation": " اس کے گنبد کو «<a href=106> بلند </a>» کیا ، پس اس کو ٹھیک ٹھاک کیا ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 29,
    "global_ayah_id": 5819,
    "translation": " اور اس کی «<a href=356> رات </a>» ڈھانک دی اور اس کے «<a href=326> دن </a>» کو بے\nنقاب کیا ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 30,
    "global_ayah_id": 5820,
    "translation": " اور «<a href=379> زمین </a>» کو اس کے بعد «<a href=651> ہموار </a>» کیا ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 31,
    "global_ayah_id": 5821,
    "translation": " نکالا اس سے اس کا «<a href=144> پانی </a>» اور «<a href=253> چارہ </a>» ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 32,
    "global_ayah_id": 5822,
    "translation": " اور پہاڑوں کو اس میں گاڑا ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 33,
    "global_ayah_id": 5823,
    "translation": " تمہاری اور تمہارے مویشیوں کی نفع رسانی کیلئے ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 34,
    "global_ayah_id": 5824,
    "translation": " پس جب وہ بڑا ہنگامہ برپا ہوگا ( تو یہ سب کچھ درہم برہم ہوجائے گا ) "
  },
  {
    "surah_id": 79,
    "ayah_number": 35,
    "global_ayah_id": 5825,
    "translation": " اس «<a href=326> دن </a>» «<a href=3> انسان </a>» اپنے کیے کو «<a href=657> یاد\n</a>» کرے گا ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 36,
    "global_ayah_id": 5826,
    "translation": " اور «<a href=331> دوزخ </a>» ان لوگوں کیلئے بے نقاب کردی جائے گی ، «<a href=236> جن\n</a>» کو اس سے دوچار ہونا ہے ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 37,
    "global_ayah_id": 5827,
    "translation": " تو جس نے «<a href=396> سرکشی </a>» کی "
  },
  {
    "surah_id": 79,
    "ayah_number": 38,
    "global_ayah_id": 5828,
    "translation": " اور ( «<a href=2> آخرت </a>» کے بالمقابل ) «<a href=327> دنیا </a>» کی زندگی کو\nترجیح دی "
  },
  {
    "surah_id": 79,
    "ayah_number": 39,
    "global_ayah_id": 5829,
    "translation": " اس کا ٹھکانا تو بس جہنم ہی بنے گی "
  },
  {
    "surah_id": 79,
    "ayah_number": 40,
    "global_ayah_id": 5830,
    "translation": " اور وہ جو اپنے رب کے حضور پیشی سے ڈرا اور جس نے اپنے نفس کو «<a href=305> خواہش\n</a>» کی پیروی سے روکا "
  },
  {
    "surah_id": 79,
    "ayah_number": 41,
    "global_ayah_id": 5831,
    "translation": " تو اس کا ٹھکانا لاریب «<a href=237> جنت </a>» ہے ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 42,
    "global_ayah_id": 5832,
    "translation": " وہ تم سے «<a href=476> قیامت </a>» کے بارے میں سوال کرتے ہیں کہ وہ کب کھڑی ہوگی؟ "
  },
  {
    "surah_id": 79,
    "ayah_number": 43,
    "global_ayah_id": 5833,
    "translation": " تم اس بحث میں کہاں پڑے ہو! "
  },
  {
    "surah_id": 79,
    "ayah_number": 44,
    "global_ayah_id": 5834,
    "translation": " یہ معاملہ تو تیرے رب کے حوالہ ہے ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 45,
    "global_ayah_id": 5835,
    "translation": " تم تو بس ان لوگوں کو اس سے «<a href=13> آگاہ </a>» کرنے والے ہو جو اس سے ڈریں ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 46,
    "global_ayah_id": 5836,
    "translation": " جس روز وہ اس کو دیکھیں گے تو گویا انہیں ایک «<a href=412> شام </a>» یا اس کی صبح سے\n«<a href=636> زیادہ </a>» وقفہ نہیں گذرا ۔ "
  }
]