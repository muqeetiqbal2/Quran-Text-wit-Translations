[
  {
    "surah_id": 79,
    "ayah_number": 0,
    "global_ayah_id": 5790,
    "translation": " «<a href=416> شروع </a>» کرتا ہوں اللہ تعا لٰی کے «<a href=614> نام\n</a>» سے جو بڑا «<a href=600> مہربان </a>» نہایت رحم والا ہے ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 1,
    "global_ayah_id": 5791,
    "translation": " ڈوب کر «<a href=392> سختی </a>» سے کھنچنے والوں کی قسم! "
  },
  {
    "surah_id": 79,
    "ayah_number": 2,
    "global_ayah_id": 5792,
    "translation": " «<a href=108> بند </a>» کھول کر چھڑا دینے والوں کی قسم! "
  },
  {
    "surah_id": 79,
    "ayah_number": 3,
    "global_ayah_id": 5793,
    "translation": " اور تیرنے پھرنے والوں کی قسم! "
  },
  {
    "surah_id": 79,
    "ayah_number": 4,
    "global_ayah_id": 5794,
    "translation": " پھر دوڑ کر آگے بڑھنے والوں کی قسم! "
  },
  {
    "surah_id": 79,
    "ayah_number": 5,
    "global_ayah_id": 5795,
    "translation": " پھر «<a href=481> کام </a>» کی «<a href=192> تدبیر </a>» کرنے والوں کی\nقسم! "
  },
  {
    "surah_id": 79,
    "ayah_number": 6,
    "global_ayah_id": 5796,
    "translation": " جس «<a href=326> دن </a>» کانپنے والی کانپے گی "
  },
  {
    "surah_id": 79,
    "ayah_number": 7,
    "global_ayah_id": 5797,
    "translation": " اس کے بعد ایک «<a href=179> پیچھے </a>» آنے والی ( «<a href=179> پیچھے\n</a>» پیچھے ) آئے گی ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 8,
    "global_ayah_id": 5798,
    "translation": " ۔ ( بہت سے ) «<a href=324> دل </a>» اس «<a href=326> دن </a>» دھڑ کتے\nہونگے ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 9,
    "global_ayah_id": 5799,
    "translation": " «<a href=236> جن </a>» کی نگاہیں نیچی ہونگی ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 10,
    "global_ayah_id": 5800,
    "translation": " کہتے ہیں کہ کیا ہم پہلی کی سی «<a href=280> حالت </a>» کی طرف پھر\nلوٹائے جائیں گے؟ "
  },
  {
    "surah_id": 79,
    "ayah_number": 11,
    "global_ayah_id": 5801,
    "translation": " کیا اس «<a href=639> وقت </a>» جب کہ ہم «<a href=113> بوسیدہ </a>»\nہڈیاں ہو جائیں گے؟ "
  },
  {
    "surah_id": 79,
    "ayah_number": 12,
    "global_ayah_id": 5802,
    "translation": " کہتے ہیں کہ پھر تو یہ لوٹنا «<a href=624> نقصان </a>» دہ ہے ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 13,
    "global_ayah_id": 5803,
    "translation": " ( معلوم ہونا چاہیئے ) وہ تو صرف ایک ( خوفناک ) ڈانٹ ہے ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 14,
    "global_ayah_id": 5804,
    "translation": " کہ ( جس کے «<a href=435> ظاہر </a>» ہوتے ہی ) وہ ایک دم میدان میں جمع\nہو جائیں گے ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 15,
    "global_ayah_id": 5805,
    "translation": " کیا موسیٰ ( علیہ السلام ) کی «<a href=293> خبر </a>» تمہیں پہنچی ہے؟ "
  },
  {
    "surah_id": 79,
    "ayah_number": 16,
    "global_ayah_id": 5806,
    "translation": " جب کہ انہیں ان کے رب نے «<a href=142> پاک </a>» میدان طویٰ میں پکارا ۔\n "
  },
  {
    "surah_id": 79,
    "ayah_number": 17,
    "global_ayah_id": 5807,
    "translation": " ۔ ( کہ ) تم فرعون کے «<a href=141> پاس </a>» جاؤ اس نے «<a href=396>\n  سرکشی </a>» «<a href=34> اختیار </a>» کر لی ہے ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 18,
    "global_ayah_id": 5808,
    "translation": " اس سے کہو کہ کیا تو اپنی درستگی اور اصلاح چاہتا ہے ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 19,
    "global_ayah_id": 5809,
    "translation": " اور یہ کہ میں تجھے تیرے رب کی راہ دکھاؤں تاکہ تو ( اس سے ) ڈرنے لگے ۔\n "
  },
  {
    "surah_id": 79,
    "ayah_number": 20,
    "global_ayah_id": 5810,
    "translation": " پس اسے بڑی «<a href=620> نشانی </a>» دکھائی ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 21,
    "global_ayah_id": 5811,
    "translation": " تو اس نے جھٹلایا اور «<a href=612> نافرمانی </a>» کی ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 22,
    "global_ayah_id": 5812,
    "translation": " پھر پلٹا دوڑ «<a href=336> دھوپ </a>» کرتے ہوئے ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 23,
    "global_ayah_id": 5813,
    "translation": " پھر سب کو جمع کر کے پکارا ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 24,
    "global_ayah_id": 5814,
    "translation": " تم سب کا رب میں ہی ہوں ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 25,
    "global_ayah_id": 5815,
    "translation": " تو ( سب سے «<a href=106> بلند </a>» و بالا ) اللہ نے بھی اسے «<a\n  href=2> آخرت </a>» کے اور «<a href=327> دنیا </a>» کے «<a href=440> عذاب </a>» میں گرفتار کر لیا ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 26,
    "global_ayah_id": 5816,
    "translation": " بیشک اس میں اس شخص کے لئے عبرت ہے جو ڈرے ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 27,
    "global_ayah_id": 5817,
    "translation": " کیا تمہارا «<a href=180> پیدا </a>» کرنا «<a href=636> زیادہ </a>»\nدشوار ہے یا «<a href=10> آسمان </a>» کا؟ اللہ تعا لٰی نے اسے بنایا ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 28,
    "global_ayah_id": 5818,
    "translation": " اس کی بلندی اونچی کی پھر اسے ٹھیک ٹھاک کر دیا ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 29,
    "global_ayah_id": 5819,
    "translation": " اسکی «<a href=356> رات </a>» کو تاریک بنایا اور اسکے «<a href=326> دن\n</a>» کو نکالا ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 30,
    "global_ayah_id": 5820,
    "translation": " اوراس کے بعد «<a href=379> زمین </a>» کو ( «<a href=651> ہموار </a>» )\nبچھا دیا ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 31,
    "global_ayah_id": 5821,
    "translation": " اس میں سے «<a href=144> پانی </a>» اور «<a href=253> چارہ </a>» نکالا\n۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 32,
    "global_ayah_id": 5822,
    "translation": " اور پہاڑوں کو ( «<a href=590> مضبوط </a>» ) گاڑ دیا ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 33,
    "global_ayah_id": 5823,
    "translation": " یہ سب تمہارے اور تمہارے جانوروں کے فائدے کے لئے ( ہیں ) "
  },
  {
    "surah_id": 79,
    "ayah_number": 34,
    "global_ayah_id": 5824,
    "translation": " پس جب وہ بڑی آفت ( «<a href=476> قیامت </a>» ) آ جائے گی ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 35,
    "global_ayah_id": 5825,
    "translation": " جس «<a href=326> دن </a>» کہ «<a href=3> انسان </a>» اپنے کیے ہوئے\nکاموں کو «<a href=657> یاد </a>» کرے گا ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 36,
    "global_ayah_id": 5826,
    "translation": " اور ( ہر ) دیکھنے والے کے «<a href=386> سامنے </a>» جہنم «<a href=435>\n  ظاہر </a>» کی جائے گی ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 37,
    "global_ayah_id": 5827,
    "translation": " تو جس ( شخص ) نے «<a href=396> سرکشی </a>» کی ( ہوگی ) ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 38,
    "global_ayah_id": 5828,
    "translation": " اور دنیوی زندگی کو ترجیح دی ( ہوگی ) ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 39,
    "global_ayah_id": 5829,
    "translation": " ۔ ( اسکا ) ٹھکانا جہنم ہی ہے ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 40,
    "global_ayah_id": 5830,
    "translation": " ہاں جو شخص اپنے رب کے «<a href=386> سامنے </a>» کھڑے ہونے سے ڈرتا رہا\nہوگا اور اپنے نفس کو «<a href=305> خواہش </a>» سے روکا ہوگا ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 41,
    "global_ayah_id": 5831,
    "translation": " تو اس کا ٹھکانا «<a href=237> جنت </a>» ہی ہے ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 42,
    "global_ayah_id": 5832,
    "translation": " لوگ آپ سے «<a href=476> قیامت </a>» کے واقع ہونے کا «<a href=639> وقت\n</a>» دریافت کرتے ہیں ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 43,
    "global_ayah_id": 5833,
    "translation": " آپ کو اس کے «<a href=126> بیان </a>» کرنے سے کیا تعلق؟ "
  },
  {
    "surah_id": 79,
    "ayah_number": 44,
    "global_ayah_id": 5834,
    "translation": " اس کے علم کی انتہا تو اللہ کی «<a href=227> جانب </a>» ہے ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 45,
    "global_ayah_id": 5835,
    "translation": " آپ تو صرف اس سے ڈرتے رہنے والوں کو «<a href=13> آگاہ </a>» کرنے والے\nہیں ۔ "
  },
  {
    "surah_id": 79,
    "ayah_number": 46,
    "global_ayah_id": 5836,
    "translation": " جس روز یہ اسے دیکھ لیں گے تو ایسا معلوم ہوگا کہ صرف «<a href=326> دن\n</a>» کا آخری «<a href=285> حصہ </a>» یا اول «<a href=285> حصہ </a>» ہی ( «<a href=327> دنیا </a>» میں ) رہے ہیں ۔ "
  }
]