[
  {
    "surah_id": 79,
    "ayah_number": 0,
    "global_ayah_id": 5790,
    "translation": "اللہ کے «<a href=614> نام </a>» سے جو بےانتہا «<a href=600> مہربان </a>» اور رحم فرمانے والا ہے"
  },
  {
    "surah_id": 79,
    "ayah_number": 1,
    "global_ayah_id": 5791,
    "translation": "قسم ہے ان کی جو ڈوب کر کھینچتے ہیں"
  },
  {
    "surah_id": 79,
    "ayah_number": 2,
    "global_ayah_id": 5792,
    "translation": "اور آہستگی سے نکال لے جاتے ہیں"
  },
  {
    "surah_id": 79,
    "ayah_number": 3,
    "global_ayah_id": 5793,
    "translation": "اور تیزی سے تیرتے پھرتے ہیں"
  },
  {
    "surah_id": 79,
    "ayah_number": 4,
    "global_ayah_id": 5794,
    "translation": "پھر سبقت کرتے ہیں"
  },
  {
    "surah_id": 79,
    "ayah_number": 5,
    "global_ayah_id": 5795,
    "translation": "پھر معاملات کا انتظام چلاتے ہیں"
  },
  {
    "surah_id": 79,
    "ayah_number": 6,
    "global_ayah_id": 5796,
    "translation": "جس روز ہلا مارے گا ، زلزلے کا جھٹکا"
  },
  {
    "surah_id": 79,
    "ayah_number": 7,
    "global_ayah_id": 5797,
    "translation": "اور اس کے «<a href=179> پیچھے </a>» ایک اور جھٹکا پڑے گا"
  },
  {
    "surah_id": 79,
    "ayah_number": 8,
    "global_ayah_id": 5798,
    "translation": "کچھ «<a href=324> دل </a>» ہوں گے جو اس روز خوف سے کانپ رہے ہوں گے"
  },
  {
    "surah_id": 79,
    "ayah_number": 9,
    "global_ayah_id": 5799,
    "translation": "نگاہیں ان کی سہمی ہوئی ہوں گی"
  },
  {
    "surah_id": 79,
    "ayah_number": 10,
    "global_ayah_id": 5800,
    "translation": "یہ لوگ کہیں گے ” کیا واقعی ہم پلٹا کر پھر واپس لائے گئے ہیں ؟"
  },
  {
    "surah_id": 79,
    "ayah_number": 11,
    "global_ayah_id": 5801,
    "translation": "جب کہ ہم کھوکھلی «<a href=113> بوسیدہ </a>» ہڈیاں بن چکے تھے ؟"
  },
  {
    "surah_id": 79,
    "ayah_number": 12,
    "global_ayah_id": 5802,
    "translation": "کہیں گے ” یہ واپسی تو پھر بڑے گھاٹے کی ہے"
  },
  {
    "surah_id": 79,
    "ayah_number": 13,
    "global_ayah_id": 5803,
    "translation": "حالانکہ یہ بس اتنا «<a href=481> کام </a>» ہے کہ ایک زور کی ڈانٹ پڑے گی"
  },
  {
    "surah_id": 79,
    "ayah_number": 14,
    "global_ayah_id": 5804,
    "translation": "اور یکایک یہ کھلے میدان میں موجود ہوں گے"
  },
  {
    "surah_id": 79,
    "ayah_number": 15,
    "global_ayah_id": 5805,
    "translation": "کیا تمہیں موسیٰ کے قصے کی «<a href=293> خبر </a>» پہنچی ہے ؟"
  },
  {
    "surah_id": 79,
    "ayah_number": 16,
    "global_ayah_id": 5806,
    "translation": "جب اس کے رب نے اسے طویٰ کی مقدس وادی میں پکارا تھا ،"
  },
  {
    "surah_id": 79,
    "ayah_number": 17,
    "global_ayah_id": 5807,
    "translation": "کہ  فرعون کے «<a href=141> پاس </a>» جا وہ سرکش ہوگیا ہے"
  },
  {
    "surah_id": 79,
    "ayah_number": 18,
    "global_ayah_id": 5808,
    "translation": "اور اس سے کہہ کیا تو اس کے لیے «<a href=213> تیار </a>» ہے کہ «<a href=196> پاکیزگی </a>» «<a href=34> اختیار </a>» کرے"
  },
  {
    "surah_id": 79,
    "ayah_number": 19,
    "global_ayah_id": 5809,
    "translation": "اور میں تیرے رب کی طرف تیری رہنمائی کروں تو (اس کا) خوف تیرے «<a href=57> اندر </a>» «<a href=180> پیدا </a>» ہو ؟"
  },
  {
    "surah_id": 79,
    "ayah_number": 20,
    "global_ayah_id": 5810,
    "translation": "پھر موسیٰ نے (فرعون کے «<a href=141> پاس </a>» جاکر) اس کو بڑی «<a href=620> نشانی </a>» دکھائی"
  },
  {
    "surah_id": 79,
    "ayah_number": 21,
    "global_ayah_id": 5811,
    "translation": "مگر اس نے جھٹلا دیا اور نہ مانا ؟"
  },
  {
    "surah_id": 79,
    "ayah_number": 22,
    "global_ayah_id": 5812,
    "translation": "پھر چال بازیاں کرنے کے لیے پلٹا"
  },
  {
    "surah_id": 79,
    "ayah_number": 23,
    "global_ayah_id": 5813,
    "translation": "اور لوگوں کو جمع کرکے اس نے پکار کر کہا"
  },
  {
    "surah_id": 79,
    "ayah_number": 24,
    "global_ayah_id": 5814,
    "translation": "میں تمہارا سب سے بڑا رب ہوں"
  },
  {
    "surah_id": 79,
    "ayah_number": 25,
    "global_ayah_id": 5815,
    "translation": "آخر کار اللہ نے اسے «<a href=2> آخرت </a>» اور «<a href=327> دنیا </a>» کے «<a href=440> عذاب </a>» میں پکڑ لیا"
  },
  {
    "surah_id": 79,
    "ayah_number": 26,
    "global_ayah_id": 5816,
    "translation": "درحقیقت اس میں بڑی عبرت ہے ہر اس شخص کے لیے جو ڈرے"
  },
  {
    "surah_id": 79,
    "ayah_number": 27,
    "global_ayah_id": 5817,
    "translation": "کیا تم لوگوں کی تخلیق «<a href=636> زیادہ </a>» «<a href=391> سخت </a>» «<a href=481> کام </a>» ہے یا «<a href=10> آسمان </a>» کی ؟"
  },
  {
    "surah_id": 79,
    "ayah_number": 28,
    "global_ayah_id": 5818,
    "translation": "اللہ نے اس کو بنایا ، اس کی «<a href=273> چھت </a>» خوب اونچی اٹھائی"
  },
  {
    "surah_id": 79,
    "ayah_number": 29,
    "global_ayah_id": 5819,
    "translation": "پھر اس کا توازن قائم کیا ، اور اس کی «<a href=356> رات </a>» ڈھانکی اور اس کا «<a href=326> دن </a>» نکالا"
  },
  {
    "surah_id": 79,
    "ayah_number": 30,
    "global_ayah_id": 5820,
    "translation": "اس کے بعد «<a href=379> زمین </a>» کو اس نے بچھایا"
  },
  {
    "surah_id": 79,
    "ayah_number": 31,
    "global_ayah_id": 5821,
    "translation": "اس کے «<a href=57> اندر </a>» سے اس کا «<a href=144> پانی </a>» اور «<a href=253> چارہ </a>» نکالا"
  },
  {
    "surah_id": 79,
    "ayah_number": 32,
    "global_ayah_id": 5822,
    "translation": "اور «<a href=160> پہاڑ </a>» اس میں گاڑ دیے"
  },
  {
    "surah_id": 79,
    "ayah_number": 33,
    "global_ayah_id": 5823,
    "translation": "سامان زیست کے طور پر تمہارے لیے اور تمہارے مویشیوں کے لیے"
  },
  {
    "surah_id": 79,
    "ayah_number": 34,
    "global_ayah_id": 5824,
    "translation": "پھر جب وہ ہنگامہ عظیم برپا ہوگا"
  },
  {
    "surah_id": 79,
    "ayah_number": 35,
    "global_ayah_id": 5825,
    "translation": "جس روز «<a href=3> انسان </a>» اپنا سب کیا دھرا «<a href=657> یاد </a>» کرے گا"
  },
  {
    "surah_id": 79,
    "ayah_number": 36,
    "global_ayah_id": 5826,
    "translation": "اور ہر دیکھنے والے کے «<a href=386> سامنے </a>» «<a href=331> دوزخ </a>» کھول کر رکھ دی جائے گی"
  },
  {
    "surah_id": 79,
    "ayah_number": 37,
    "global_ayah_id": 5827,
    "translation": "تو جس نے «<a href=396> سرکشی </a>» کی تھی"
  },
  {
    "surah_id": 79,
    "ayah_number": 38,
    "global_ayah_id": 5828,
    "translation": "اور «<a href=327> دنیا </a>» کی زندگی کو ترجیح دی تھی"
  },
  {
    "surah_id": 79,
    "ayah_number": 39,
    "global_ayah_id": 5829,
    "translation": "دوزخ ہی اس کا ٹھکانا ہوگی"
  },
  {
    "surah_id": 79,
    "ayah_number": 40,
    "global_ayah_id": 5830,
    "translation": "اور جس نے اپنے رب کے «<a href=386> سامنے </a>» کھڑے ہونے کا خوف کیا تھا اور نفس کو بری خواہشات سے بازرکھا تھا"
  },
  {
    "surah_id": 79,
    "ayah_number": 41,
    "global_ayah_id": 5831,
    "translation": "جنت اس کا ٹھکانہ ہوگی"
  },
  {
    "surah_id": 79,
    "ayah_number": 42,
    "global_ayah_id": 5832,
    "translation": "یہ لوگ تم سے پوچھتے ہیں کہ ” آخر وہ «<a href=540> گھڑی </a>» کب آکر ٹھہرے گی ؟"
  },
  {
    "surah_id": 79,
    "ayah_number": 43,
    "global_ayah_id": 5833,
    "translation": "تمہارا کیا «<a href=481> کام </a>»  کہ اس کا «<a href=639> وقت </a>» بتاؤ"
  },
  {
    "surah_id": 79,
    "ayah_number": 44,
    "global_ayah_id": 5834,
    "translation": "اس کا علم تو اللہ پر «<a href=294> ختم </a>» ہے"
  },
  {
    "surah_id": 79,
    "ayah_number": 45,
    "global_ayah_id": 5835,
    "translation": "تم صرف خبردار کرنے والے ہو۔ ہر اس شخص کو جو اس کا خوف کرے"
  },
  {
    "surah_id": 79,
    "ayah_number": 46,
    "global_ayah_id": 5836,
    "translation": "جس روز یہ لوگ اسے دیکھ لیں گے تو انہیں یوں محسوس ہوگا کہ (دنیا میں یا «<a href=280> حالت </a>» موت میں) یہ بس ایک «<a href=326> دن </a>» کے پچھلے پہر یا اگلے پہر تک ٹھہرے ہیں"
  }
]