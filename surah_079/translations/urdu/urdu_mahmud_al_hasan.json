[
  {
    "surah_id": 79,
    "ayah_number": 0,
    "global_ayah_id": 5790,
    "translation": "اللہ کے نام سے جو رحمان و رحیم ہے"
  },
  {
    "surah_id": 79,
    "ayah_number": 1,
    "global_ayah_id": 5791,
    "translation": "قسم ہے گھسیٹ لانے والوں کی غوطہ لگا کر"
  },
  {
    "surah_id": 79,
    "ayah_number": 2,
    "global_ayah_id": 5792,
    "translation": "اور بند چھڑا دینے والوں کی کھول کر"
  },
  {
    "surah_id": 79,
    "ayah_number": 3,
    "global_ayah_id": 5793,
    "translation": "اور پیرنے والوں کی تیزی سے"
  },
  {
    "surah_id": 79,
    "ayah_number": 4,
    "global_ayah_id": 5794,
    "translation": "پھر آگے بڑھنے والوں کی دوڑ کر"
  },
  {
    "surah_id": 79,
    "ayah_number": 5,
    "global_ayah_id": 5795,
    "translation": "پھر کام بنانے والوں کی حکم سے"
  },
  {
    "surah_id": 79,
    "ayah_number": 6,
    "global_ayah_id": 5796,
    "translation": "جس دن کانپے کانپنے والی"
  },
  {
    "surah_id": 79,
    "ayah_number": 7,
    "global_ayah_id": 5797,
    "translation": "اُسکے پیچھے آئے دوسری"
  },
  {
    "surah_id": 79,
    "ayah_number": 8,
    "global_ayah_id": 5798,
    "translation": "کتنے دل اُس دن دھڑکتے ہیں"
  },
  {
    "surah_id": 79,
    "ayah_number": 9,
    "global_ayah_id": 5799,
    "translation": "اُنکی آنکھیں جھک رہی ہیں"
  },
  {
    "surah_id": 79,
    "ayah_number": 10,
    "global_ayah_id": 5800,
    "translation": "لوگ کہتے ہیں کیا ہم پھر آئیں گے الٹے پاؤں"
  },
  {
    "surah_id": 79,
    "ayah_number": 11,
    "global_ayah_id": 5801,
    "translation": "کیا جب ہم ہو چکیں ہڈیاں کھوکھری"
  },
  {
    "surah_id": 79,
    "ayah_number": 12,
    "global_ayah_id": 5802,
    "translation": "بولے تو تو یہ پھر آنا ہے ٹوٹے کا"
  },
  {
    "surah_id": 79,
    "ayah_number": 13,
    "global_ayah_id": 5803,
    "translation": "سو وہ تو صرف ایک جھڑکی ہے"
  },
  {
    "surah_id": 79,
    "ayah_number": 14,
    "global_ayah_id": 5804,
    "translation": "پھر تبھی وہ آ رہیں میدان میں"
  },
  {
    "surah_id": 79,
    "ayah_number": 15,
    "global_ayah_id": 5805,
    "translation": "کیا پہنچی ہے تجھ کو بات موسٰی کی"
  },
  {
    "surah_id": 79,
    "ayah_number": 16,
    "global_ayah_id": 5806,
    "translation": "جب پکارا اُس کو اُسکے رب نے پاک میدان میں جس کا نام طویٰ ہے"
  },
  {
    "surah_id": 79,
    "ayah_number": 17,
    "global_ayah_id": 5807,
    "translation": "جا فرعون کے پاس اُس نے سر اٹھایا"
  },
  {
    "surah_id": 79,
    "ayah_number": 18,
    "global_ayah_id": 5808,
    "translation": "پھر کہہ تیرا جی چاہتا ہے کہ تو سنور جائے"
  },
  {
    "surah_id": 79,
    "ayah_number": 19,
    "global_ayah_id": 5809,
    "translation": "اور راہ بتلاؤں تجھ کو تیرے رب کی طرف پھر تجھ کو ڈر ہو"
  },
  {
    "surah_id": 79,
    "ayah_number": 20,
    "global_ayah_id": 5810,
    "translation": "پھر دکھلائی اسکو وہ بڑی نشانی"
  },
  {
    "surah_id": 79,
    "ayah_number": 21,
    "global_ayah_id": 5811,
    "translation": "پھر جھٹلایا اُس نے اور نہ مانا"
  },
  {
    "surah_id": 79,
    "ayah_number": 22,
    "global_ayah_id": 5812,
    "translation": "پھر چلا پیٹھ پھیر کر تلاش کرتا ہوا"
  },
  {
    "surah_id": 79,
    "ayah_number": 23,
    "global_ayah_id": 5813,
    "translation": "پھر سبکو جمع کیا پھر پکارا"
  },
  {
    "surah_id": 79,
    "ayah_number": 24,
    "global_ayah_id": 5814,
    "translation": "تو کہا میں ہوں رب تمہارا سب سے اوپر"
  },
  {
    "surah_id": 79,
    "ayah_number": 25,
    "global_ayah_id": 5815,
    "translation": "پھر پکڑا اسکو اللہ نے سزا میں آخرت کی اور دنیا کی"
  },
  {
    "surah_id": 79,
    "ayah_number": 26,
    "global_ayah_id": 5816,
    "translation": "بیشک اس میں سوچنے کی جگہ ہے جس کے دل میں ڈر ہے"
  },
  {
    "surah_id": 79,
    "ayah_number": 27,
    "global_ayah_id": 5817,
    "translation": "کیا تمہارا بنانا مشکل ہے یا آسمان کا اُس نے اُسکو بنا لیا"
  },
  {
    "surah_id": 79,
    "ayah_number": 28,
    "global_ayah_id": 5818,
    "translation": "اونچا کیا اس کا ابھار پھر اُسکو برابر کیا"
  },
  {
    "surah_id": 79,
    "ayah_number": 29,
    "global_ayah_id": 5819,
    "translation": "اور اندھیری کی رات اُسکی اور کھول نکالی اُسکی دھوپ"
  },
  {
    "surah_id": 79,
    "ayah_number": 30,
    "global_ayah_id": 5820,
    "translation": "اور زمین کو اُسکے پیچھے صاف بچھا دیا"
  },
  {
    "surah_id": 79,
    "ayah_number": 31,
    "global_ayah_id": 5821,
    "translation": "باہر نکالا زمین سے اُس کا پانی اور چارا"
  },
  {
    "surah_id": 79,
    "ayah_number": 32,
    "global_ayah_id": 5822,
    "translation": "اور پہاڑوں کو قائم کر دیا"
  },
  {
    "surah_id": 79,
    "ayah_number": 33,
    "global_ayah_id": 5823,
    "translation": "کام چلانے کو تمہارے اور تمہارے چوپایوں کے"
  },
  {
    "surah_id": 79,
    "ayah_number": 34,
    "global_ayah_id": 5824,
    "translation": "پھر جب آئے وہ بڑا ہنگامہ"
  },
  {
    "surah_id": 79,
    "ayah_number": 35,
    "global_ayah_id": 5825,
    "translation": "جس دن کہ یاد کرے گا آدمی جو اُس نے کمایا"
  },
  {
    "surah_id": 79,
    "ayah_number": 36,
    "global_ayah_id": 5826,
    "translation": "اور نکال ظاہر کر دیں دوزخ کو جو چاہے دیکھے"
  },
  {
    "surah_id": 79,
    "ayah_number": 37,
    "global_ayah_id": 5827,
    "translation": "سو جس نے کی ہو شرارت"
  },
  {
    "surah_id": 79,
    "ayah_number": 38,
    "global_ayah_id": 5828,
    "translation": "اور بہتر سمجھا ہو دنیا کا جینا"
  },
  {
    "surah_id": 79,
    "ayah_number": 39,
    "global_ayah_id": 5829,
    "translation": "سو دوزخ ہی ہے اُس کا ٹھکانہ"
  },
  {
    "surah_id": 79,
    "ayah_number": 40,
    "global_ayah_id": 5830,
    "translation": "اور جو کوئی ڈرا ہو اپنے رب کے سامنے کھڑے ہونے سے اور روکا ہو اُس نے جی کو خواہش سے"
  },
  {
    "surah_id": 79,
    "ayah_number": 41,
    "global_ayah_id": 5831,
    "translation": "سو بہشت ہے اُس کا ٹھکانہ"
  },
  {
    "surah_id": 79,
    "ayah_number": 42,
    "global_ayah_id": 5832,
    "translation": "تجھ سے پوچھتے ہیں وہ گھڑی کب ہو گا قیام اُس کا"
  },
  {
    "surah_id": 79,
    "ayah_number": 43,
    "global_ayah_id": 5833,
    "translation": "تجھ کو کیا کام اُسکے ذکر سے"
  },
  {
    "surah_id": 79,
    "ayah_number": 44,
    "global_ayah_id": 5834,
    "translation": "تیرے رب کی طرف ہے پہنچ اُسکی"
  },
  {
    "surah_id": 79,
    "ayah_number": 45,
    "global_ayah_id": 5835,
    "translation": "تو تو ڈر سنانے کے واسطے ہے اس کو جو اُس سے ڈرتا ہے"
  },
  {
    "surah_id": 79,
    "ayah_number": 46,
    "global_ayah_id": 5836,
    "translation": "ایسا لگے گا جس دن دیکھیں گے اُسکو کہ نہیں ٹھہرے تھے دنیا میں مگر ایک شام یا صبح اُسکی"
  }
]