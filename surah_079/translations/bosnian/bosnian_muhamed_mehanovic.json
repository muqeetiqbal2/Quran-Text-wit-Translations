[
  {
    "surah_id": 79,
    "ayah_number": 1,
    "global_ayah_id": 5713,
    "translation": "Tako Mi onih koji čupaju grubo,"
  },
  {
    "surah_id": 79,
    "ayah_number": 2,
    "global_ayah_id": 5714,
    "translation": "i onih koji vade blago,"
  },
  {
    "surah_id": 79,
    "ayah_number": 3,
    "global_ayah_id": 5715,
    "translation": "i onih koji plove brzo"
  },
  {
    "surah_id": 79,
    "ayah_number": 4,
    "global_ayah_id": 5716,
    "translation": "i onih koji baš prednjače"
  },
  {
    "surah_id": 79,
    "ayah_number": 5,
    "global_ayah_id": 5717,
    "translation": "i onih koji odredbe uređuju"
  },
  {
    "surah_id": 79,
    "ayah_number": 6,
    "global_ayah_id": 5718,
    "translation": "na Dan kada ono što potresa potrese,"
  },
  {
    "surah_id": 79,
    "ayah_number": 7,
    "global_ayah_id": 5719,
    "translation": "za kojim će doći slijedeći,"
  },
  {
    "surah_id": 79,
    "ayah_number": 8,
    "global_ayah_id": 5720,
    "translation": "srca taj dan bit će uplašena,"
  },
  {
    "surah_id": 79,
    "ayah_number": 9,
    "global_ayah_id": 5721,
    "translation": "a pogledi njihovi ponizni."
  },
  {
    "surah_id": 79,
    "ayah_number": 10,
    "global_ayah_id": 5722,
    "translation": "Govore oni: \"Zar ćemo, zaista, u kaburovima biti vraćeni u život?"
  },
  {
    "surah_id": 79,
    "ayah_number": 11,
    "global_ayah_id": 5723,
    "translation": "Zar kad truhle kosti postanemo?\""
  },
  {
    "surah_id": 79,
    "ayah_number": 12,
    "global_ayah_id": 5724,
    "translation": "I još kažu: \"E to je, dakle, štetan povratak.\""
  },
  {
    "surah_id": 79,
    "ayah_number": 13,
    "global_ayah_id": 5725,
    "translation": "A bit će to samo naredba jedna,"
  },
  {
    "surah_id": 79,
    "ayah_number": 14,
    "global_ayah_id": 5726,
    "translation": "a oni već na površini Zemlje."
  },
  {
    "surah_id": 79,
    "ayah_number": 15,
    "global_ayah_id": 5727,
    "translation": "Da li je doprla do tebe vijest o Musau,"
  },
  {
    "surah_id": 79,
    "ayah_number": 16,
    "global_ayah_id": 5728,
    "translation": "kad ga je Gospodar njegov u blagoslovljenoj, čistoj dolini Tuva zovnuo?"
  },
  {
    "surah_id": 79,
    "ayah_number": 17,
    "global_ayah_id": 5729,
    "translation": "Idi faraonu, on se, doista, osilio,"
  },
  {
    "surah_id": 79,
    "ayah_number": 18,
    "global_ayah_id": 5730,
    "translation": "i reci: \"Da li bi ti da se očistiš,"
  },
  {
    "surah_id": 79,
    "ayah_number": 19,
    "global_ayah_id": 5731,
    "translation": "da te Gospodaru tvome uputim, pa da Ga se bojiš?\""
  },
  {
    "surah_id": 79,
    "ayah_number": 20,
    "global_ayah_id": 5732,
    "translation": "I onda mu je najveći znak pokazao,"
  },
  {
    "surah_id": 79,
    "ayah_number": 21,
    "global_ayah_id": 5733,
    "translation": "ali je on porekao i nije poslušao,"
  },
  {
    "surah_id": 79,
    "ayah_number": 22,
    "global_ayah_id": 5734,
    "translation": "već se okrenuo i potrudio"
  },
  {
    "surah_id": 79,
    "ayah_number": 23,
    "global_ayah_id": 5735,
    "translation": "i sabrao i povikao:"
  },
  {
    "surah_id": 79,
    "ayah_number": 24,
    "global_ayah_id": 5736,
    "translation": "\"Ja sam gospodar vaš najveći!\", on je rekao,"
  },
  {
    "surah_id": 79,
    "ayah_number": 25,
    "global_ayah_id": 5737,
    "translation": "i Allah ga je, primjernom kaznom drugog, a i prvoga kaznio."
  },
  {
    "surah_id": 79,
    "ayah_number": 26,
    "global_ayah_id": 5738,
    "translation": "U tome ima pouka za svakoga koji se bude Allaha bojao!"
  },
  {
    "surah_id": 79,
    "ayah_number": 27,
    "global_ayah_id": 5739,
    "translation": "A šta je teže: vas ili nebo stvoriti? On ga je sazdao,"
  },
  {
    "surah_id": 79,
    "ayah_number": 28,
    "global_ayah_id": 5740,
    "translation": "svod njegov visoko digao i usavršio,"
  },
  {
    "surah_id": 79,
    "ayah_number": 29,
    "global_ayah_id": 5741,
    "translation": "noći njegove mračnim, a dane svijetlim učinio."
  },
  {
    "surah_id": 79,
    "ayah_number": 30,
    "global_ayah_id": 5742,
    "translation": "Poslije toga je Zemlju rasprostro,"
  },
  {
    "surah_id": 79,
    "ayah_number": 31,
    "global_ayah_id": 5743,
    "translation": "iz nje je vodu i pašnjake izveo,"
  },
  {
    "surah_id": 79,
    "ayah_number": 32,
    "global_ayah_id": 5744,
    "translation": "i planine nepomičnim učinio,"
  },
  {
    "surah_id": 79,
    "ayah_number": 33,
    "global_ayah_id": 5745,
    "translation": "na uživanje vama i stoci vašoj."
  },
  {
    "surah_id": 79,
    "ayah_number": 34,
    "global_ayah_id": 5746,
    "translation": "A kad dođe Nevolja najveća,"
  },
  {
    "surah_id": 79,
    "ayah_number": 35,
    "global_ayah_id": 5747,
    "translation": "tada će se čovjek prisjetiti onoga što je radio,"
  },
  {
    "surah_id": 79,
    "ayah_number": 36,
    "global_ayah_id": 5748,
    "translation": "i Oganj će svakome ko vidi biti ukazan."
  },
  {
    "surah_id": 79,
    "ayah_number": 37,
    "global_ayah_id": 5749,
    "translation": "Pa, onom ko je osion bio"
  },
  {
    "surah_id": 79,
    "ayah_number": 38,
    "global_ayah_id": 5750,
    "translation": "i život dunjalučki više volio,"
  },
  {
    "surah_id": 79,
    "ayah_number": 39,
    "global_ayah_id": 5751,
    "translation": "Oganj će baš prebivalište biti."
  },
  {
    "surah_id": 79,
    "ayah_number": 40,
    "global_ayah_id": 5752,
    "translation": "A onom ko je od stajanja pred Gospodarom svojim strepio i dušu od prohtjeva uzdržao,"
  },
  {
    "surah_id": 79,
    "ayah_number": 41,
    "global_ayah_id": 5753,
    "translation": "Džennet će baš boravište biti."
  },
  {
    "surah_id": 79,
    "ayah_number": 42,
    "global_ayah_id": 5754,
    "translation": "Pitaju te o Času kijameta: \"Kada će se dogoditi?\""
  },
  {
    "surah_id": 79,
    "ayah_number": 43,
    "global_ayah_id": 5755,
    "translation": "Šta ti o spomenu njegovom znaš!?,"
  },
  {
    "surah_id": 79,
    "ayah_number": 44,
    "global_ayah_id": 5756,
    "translation": "znanje o njemu kod Gospodara tvoga skončava."
  },
  {
    "surah_id": 79,
    "ayah_number": 45,
    "global_ayah_id": 5757,
    "translation": "Tvoje upozorenje na njega prihvata samo onaj koji Ga se boji,"
  },
  {
    "surah_id": 79,
    "ayah_number": 46,
    "global_ayah_id": 5758,
    "translation": "a njima će se učiniti, Dan taj, kada ga dožive, da su samo jedno poslijepodne ili jedno jutro na dunjaluku ostali."
  }
]