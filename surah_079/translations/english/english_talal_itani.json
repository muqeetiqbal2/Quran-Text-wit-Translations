[
  {
    "surah_id": 79,
    "ayah_number": 1,
    "global_ayah_id": 5713,
    "translation": "By those who snatch violently."
  },
  {
    "surah_id": 79,
    "ayah_number": 2,
    "global_ayah_id": 5714,
    "translation": "And those who remove gently."
  },
  {
    "surah_id": 79,
    "ayah_number": 3,
    "global_ayah_id": 5715,
    "translation": "And those who glide smoothly."
  },
  {
    "surah_id": 79,
    "ayah_number": 4,
    "global_ayah_id": 5716,
    "translation": "And those who race swiftly."
  },
  {
    "surah_id": 79,
    "ayah_number": 5,
    "global_ayah_id": 5717,
    "translation": "And those who regulate events."
  },
  {
    "surah_id": 79,
    "ayah_number": 6,
    "global_ayah_id": 5718,
    "translation": "On the Day when the Quake quakes."
  },
  {
    "surah_id": 79,
    "ayah_number": 7,
    "global_ayah_id": 5719,
    "translation": "And is followed by the Successor."
  },
  {
    "surah_id": 79,
    "ayah_number": 8,
    "global_ayah_id": 5720,
    "translation": "Hearts on that Day will be pounding."
  },
  {
    "surah_id": 79,
    "ayah_number": 9,
    "global_ayah_id": 5721,
    "translation": "Their sights downcast."
  },
  {
    "surah_id": 79,
    "ayah_number": 10,
    "global_ayah_id": 5722,
    "translation": "They say, “Are we to be restored to the original condition?"
  },
  {
    "surah_id": 79,
    "ayah_number": 11,
    "global_ayah_id": 5723,
    "translation": "When we have become hollow bones?”"
  },
  {
    "surah_id": 79,
    "ayah_number": 12,
    "global_ayah_id": 5724,
    "translation": "They say, “This is a losing proposition.”"
  },
  {
    "surah_id": 79,
    "ayah_number": 13,
    "global_ayah_id": 5725,
    "translation": "But it will be only a single nudge."
  },
  {
    "surah_id": 79,
    "ayah_number": 14,
    "global_ayah_id": 5726,
    "translation": "And they will be awake."
  },
  {
    "surah_id": 79,
    "ayah_number": 15,
    "global_ayah_id": 5727,
    "translation": "Has the story of Moses reached you?"
  },
  {
    "surah_id": 79,
    "ayah_number": 16,
    "global_ayah_id": 5728,
    "translation": "When His Lord called out to him in the sacred valley of Tuwa."
  },
  {
    "surah_id": 79,
    "ayah_number": 17,
    "global_ayah_id": 5729,
    "translation": "“Go to Pharaoh—he has transgressed.”"
  },
  {
    "surah_id": 79,
    "ayah_number": 18,
    "global_ayah_id": 5730,
    "translation": "And say, “Do you care to be cleansed?"
  },
  {
    "surah_id": 79,
    "ayah_number": 19,
    "global_ayah_id": 5731,
    "translation": "And I will guide you to your Lord, and you will turn reverent.”"
  },
  {
    "surah_id": 79,
    "ayah_number": 20,
    "global_ayah_id": 5732,
    "translation": "He showed him the Greatest Miracle."
  },
  {
    "surah_id": 79,
    "ayah_number": 21,
    "global_ayah_id": 5733,
    "translation": "But he denied and defied."
  },
  {
    "surah_id": 79,
    "ayah_number": 22,
    "global_ayah_id": 5734,
    "translation": "Then turned his back, and tried."
  },
  {
    "surah_id": 79,
    "ayah_number": 23,
    "global_ayah_id": 5735,
    "translation": "And gathered and proclaimed."
  },
  {
    "surah_id": 79,
    "ayah_number": 24,
    "global_ayah_id": 5736,
    "translation": "He said, “I am your Lord, the most high.”"
  },
  {
    "surah_id": 79,
    "ayah_number": 25,
    "global_ayah_id": 5737,
    "translation": "So God seized him with an exemplary punishment, in the last and in the first."
  },
  {
    "surah_id": 79,
    "ayah_number": 26,
    "global_ayah_id": 5738,
    "translation": "In this is a lesson for whoever fears."
  },
  {
    "surah_id": 79,
    "ayah_number": 27,
    "global_ayah_id": 5739,
    "translation": "Are you more difficult to create, or the heaven? He constructed it."
  },
  {
    "surah_id": 79,
    "ayah_number": 28,
    "global_ayah_id": 5740,
    "translation": "He raised its masses, and proportioned it."
  },
  {
    "surah_id": 79,
    "ayah_number": 29,
    "global_ayah_id": 5741,
    "translation": "And He dimmed its night, and brought out its daylight."
  },
  {
    "surah_id": 79,
    "ayah_number": 30,
    "global_ayah_id": 5742,
    "translation": "And the earth after that He spread."
  },
  {
    "surah_id": 79,
    "ayah_number": 31,
    "global_ayah_id": 5743,
    "translation": "And from it, He produced its water and its pasture."
  },
  {
    "surah_id": 79,
    "ayah_number": 32,
    "global_ayah_id": 5744,
    "translation": "And the mountains, He anchored."
  },
  {
    "surah_id": 79,
    "ayah_number": 33,
    "global_ayah_id": 5745,
    "translation": "A source of enjoyment for you and for your animals."
  },
  {
    "surah_id": 79,
    "ayah_number": 34,
    "global_ayah_id": 5746,
    "translation": "But when the Great Cataclysm arrives."
  },
  {
    "surah_id": 79,
    "ayah_number": 35,
    "global_ayah_id": 5747,
    "translation": "A Day when man will remember what he has endeavored."
  },
  {
    "surah_id": 79,
    "ayah_number": 36,
    "global_ayah_id": 5748,
    "translation": "And Hell will be displayed to whoever sees."
  },
  {
    "surah_id": 79,
    "ayah_number": 37,
    "global_ayah_id": 5749,
    "translation": "As for him who was defiant."
  },
  {
    "surah_id": 79,
    "ayah_number": 38,
    "global_ayah_id": 5750,
    "translation": "And preferred the life of this world."
  },
  {
    "surah_id": 79,
    "ayah_number": 39,
    "global_ayah_id": 5751,
    "translation": "Then Hell is the shelter."
  },
  {
    "surah_id": 79,
    "ayah_number": 40,
    "global_ayah_id": 5752,
    "translation": "But as for him who feared the Standing of his Lord, and restrained the self from desires."
  },
  {
    "surah_id": 79,
    "ayah_number": 41,
    "global_ayah_id": 5753,
    "translation": "Then Paradise is the shelter."
  },
  {
    "surah_id": 79,
    "ayah_number": 42,
    "global_ayah_id": 5754,
    "translation": "They ask you about the Hour, “When will it take place?”"
  },
  {
    "surah_id": 79,
    "ayah_number": 43,
    "global_ayah_id": 5755,
    "translation": "You have no knowledge of it."
  },
  {
    "surah_id": 79,
    "ayah_number": 44,
    "global_ayah_id": 5756,
    "translation": "To your Lord is its finality."
  },
  {
    "surah_id": 79,
    "ayah_number": 45,
    "global_ayah_id": 5757,
    "translation": "You are just a warner for whoever dreads it."
  },
  {
    "surah_id": 79,
    "ayah_number": 46,
    "global_ayah_id": 5758,
    "translation": "On the Day when they witness it—as though they only stayed an evening, or its morning."
  }
]