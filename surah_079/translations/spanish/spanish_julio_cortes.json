[
  {
    "surah_id": 79,
    "ayah_number": 1,
    "global_ayah_id": 5713,
    "translation": "¡Por los que arrancan violentamente!"
  },
  {
    "surah_id": 79,
    "ayah_number": 2,
    "global_ayah_id": 5714,
    "translation": "¡Por los que van rápidamente!"
  },
  {
    "surah_id": 79,
    "ayah_number": 3,
    "global_ayah_id": 5715,
    "translation": "¡Por los que nadan libremente!"
  },
  {
    "surah_id": 79,
    "ayah_number": 4,
    "global_ayah_id": 5716,
    "translation": "¡Por los que van a la cabeza!"
  },
  {
    "surah_id": 79,
    "ayah_number": 5,
    "global_ayah_id": 5717,
    "translation": "¡Por los que llevan un asunto!"
  },
  {
    "surah_id": 79,
    "ayah_number": 6,
    "global_ayah_id": 5718,
    "translation": "El día que ocurra el temblor,"
  },
  {
    "surah_id": 79,
    "ayah_number": 7,
    "global_ayah_id": 5719,
    "translation": "sucedido por el siguiente,"
  },
  {
    "surah_id": 79,
    "ayah_number": 8,
    "global_ayah_id": 5720,
    "translation": "ese día, los corazones se estremecerán,"
  },
  {
    "surah_id": 79,
    "ayah_number": 9,
    "global_ayah_id": 5721,
    "translation": "se humillarán las miradas."
  },
  {
    "surah_id": 79,
    "ayah_number": 10,
    "global_ayah_id": 5722,
    "translation": "Dicen: «¿Es verdad que seremos restituidos a nuestra primera condición,"
  },
  {
    "surah_id": 79,
    "ayah_number": 11,
    "global_ayah_id": 5723,
    "translation": "luego de convertirnos en pútridos huesos?»"
  },
  {
    "surah_id": 79,
    "ayah_number": 12,
    "global_ayah_id": 5724,
    "translation": "Dicen: «¡Sería un retorno pernicioso!»"
  },
  {
    "surah_id": 79,
    "ayah_number": 13,
    "global_ayah_id": 5725,
    "translation": "No habrá más que un solo Grito"
  },
  {
    "surah_id": 79,
    "ayah_number": 14,
    "global_ayah_id": 5726,
    "translation": "y ¡helos despiertos!"
  },
  {
    "surah_id": 79,
    "ayah_number": 15,
    "global_ayah_id": 5727,
    "translation": "¿Te has enterado de la historia de Moisés?"
  },
  {
    "surah_id": 79,
    "ayah_number": 16,
    "global_ayah_id": 5728,
    "translation": "Cuando su Señor le llamó en el valle sagrado de Tuwa:"
  },
  {
    "surah_id": 79,
    "ayah_number": 17,
    "global_ayah_id": 5729,
    "translation": "«Ve a Faraón. Se ha excedido."
  },
  {
    "surah_id": 79,
    "ayah_number": 18,
    "global_ayah_id": 5730,
    "translation": "Y di: '¿Estás dispuesto a purificarte"
  },
  {
    "surah_id": 79,
    "ayah_number": 19,
    "global_ayah_id": 5731,
    "translation": "y a que te dirija a tu Señor y, así, tengas miedo?»"
  },
  {
    "surah_id": 79,
    "ayah_number": 20,
    "global_ayah_id": 5732,
    "translation": "Le mostró el signo tan grande."
  },
  {
    "surah_id": 79,
    "ayah_number": 21,
    "global_ayah_id": 5733,
    "translation": "Pero él desmintió y desobedeció."
  },
  {
    "surah_id": 79,
    "ayah_number": 22,
    "global_ayah_id": 5734,
    "translation": "Luego, volvió la espalda bruscamente."
  },
  {
    "surah_id": 79,
    "ayah_number": 23,
    "global_ayah_id": 5735,
    "translation": "Y convocó y dirigió una proclama."
  },
  {
    "surah_id": 79,
    "ayah_number": 24,
    "global_ayah_id": 5736,
    "translation": "Dijo: «Soy yo vuestro altísimo Señor»."
  },
  {
    "surah_id": 79,
    "ayah_number": 25,
    "global_ayah_id": 5737,
    "translation": "Alá le infligió el castigo de la otra vida y de ésta."
  },
  {
    "surah_id": 79,
    "ayah_number": 26,
    "global_ayah_id": 5738,
    "translation": "Hay en ello, sí, motivo de reflexión para quien tenga miedo de Alá."
  },
  {
    "surah_id": 79,
    "ayah_number": 27,
    "global_ayah_id": 5739,
    "translation": "¿Sois vosotros más difíciles de crear que el cielo que él ha edificado?"
  },
  {
    "surah_id": 79,
    "ayah_number": 28,
    "global_ayah_id": 5740,
    "translation": "Alzó su bóveda y le dio forma armoniosa."
  },
  {
    "surah_id": 79,
    "ayah_number": 29,
    "global_ayah_id": 5741,
    "translation": "Obscureció la noche y sacó la mañana."
  },
  {
    "surah_id": 79,
    "ayah_number": 30,
    "global_ayah_id": 5742,
    "translation": "Extendió, luego, la tierra,"
  },
  {
    "surah_id": 79,
    "ayah_number": 31,
    "global_ayah_id": 5743,
    "translation": "sacó de ella el agua y los pastos,"
  },
  {
    "surah_id": 79,
    "ayah_number": 32,
    "global_ayah_id": 5744,
    "translation": "fijó las montañas."
  },
  {
    "surah_id": 79,
    "ayah_number": 33,
    "global_ayah_id": 5745,
    "translation": "Para disfrute vuestro y de vuestros rebaños."
  },
  {
    "surah_id": 79,
    "ayah_number": 34,
    "global_ayah_id": 5746,
    "translation": "Pero, cuando venga la tan grande Calamidad,"
  },
  {
    "surah_id": 79,
    "ayah_number": 35,
    "global_ayah_id": 5747,
    "translation": "el día que recuerde el hombre sus esfuerzos"
  },
  {
    "surah_id": 79,
    "ayah_number": 36,
    "global_ayah_id": 5748,
    "translation": "y se haga aparecer el fuego de la gehena a quien pueda ver,"
  },
  {
    "surah_id": 79,
    "ayah_number": 37,
    "global_ayah_id": 5749,
    "translation": "quien se haya mostrado rebelde"
  },
  {
    "surah_id": 79,
    "ayah_number": 38,
    "global_ayah_id": 5750,
    "translation": "y preferido la vida de acá"
  },
  {
    "surah_id": 79,
    "ayah_number": 39,
    "global_ayah_id": 5751,
    "translation": "tendrá por morada el fuego de la gehena,"
  },
  {
    "surah_id": 79,
    "ayah_number": 40,
    "global_ayah_id": 5752,
    "translation": "mientras que quien haya temidoí comparecer ante su Señor y preservado su alma de la pasión"
  },
  {
    "surah_id": 79,
    "ayah_number": 41,
    "global_ayah_id": 5753,
    "translation": "tendrá el Jardín por morada."
  },
  {
    "surah_id": 79,
    "ayah_number": 42,
    "global_ayah_id": 5754,
    "translation": "Te preguntan por la Hora: «¿Cuándo sucederá?»"
  },
  {
    "surah_id": 79,
    "ayah_number": 43,
    "global_ayah_id": 5755,
    "translation": "¡No te ocupes tú de eso!"
  },
  {
    "surah_id": 79,
    "ayah_number": 44,
    "global_ayah_id": 5756,
    "translation": "A tu Señor Le toca fijarla."
  },
  {
    "surah_id": 79,
    "ayah_number": 45,
    "global_ayah_id": 5757,
    "translation": "¡Tú sólo tienes que advertir a quien tiene miedo de ella!"
  },
  {
    "surah_id": 79,
    "ayah_number": 46,
    "global_ayah_id": 5758,
    "translation": "El día que la vivan, les parecerá no haber permanecido más de una tarde o de una mañana."
  }
]