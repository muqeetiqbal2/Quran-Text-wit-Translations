[
  {
    "surah_id": 79,
    "ayah_number": 1,
    "global_ayah_id": 5713,
    "translation": "Andolsun söküp çıkaranlara,"
  },
  {
    "surah_id": 79,
    "ayah_number": 2,
    "global_ayah_id": 5714,
    "translation": "Hemen çekip alanlara,"
  },
  {
    "surah_id": 79,
    "ayah_number": 3,
    "global_ayah_id": 5715,
    "translation": "Yüzüp gidenlere,"
  },
  {
    "surah_id": 79,
    "ayah_number": 4,
    "global_ayah_id": 5716,
    "translation": "Yarışıp, geçenlere,"
  },
  {
    "surah_id": 79,
    "ayah_number": 5,
    "global_ayah_id": 5717,
    "translation": "Derken işi düzenleyenlere!"
  },
  {
    "surah_id": 79,
    "ayah_number": 6,
    "global_ayah_id": 5718,
    "translation": "O gün o gürültü sarsar."
  },
  {
    "surah_id": 79,
    "ayah_number": 7,
    "global_ayah_id": 5719,
    "translation": "Ardından başka bir gürültü gelir."
  },
  {
    "surah_id": 79,
    "ayah_number": 8,
    "global_ayah_id": 5720,
    "translation": "O gün bazı yürekler çarpar."
  },
  {
    "surah_id": 79,
    "ayah_number": 9,
    "global_ayah_id": 5721,
    "translation": "Gözleri (korkudan) aşağı kayar."
  },
  {
    "surah_id": 79,
    "ayah_number": 10,
    "global_ayah_id": 5722,
    "translation": "Diyorlar ki: \"Biz yine eski halimize döndürülecek miyiz?\""
  },
  {
    "surah_id": 79,
    "ayah_number": 11,
    "global_ayah_id": 5723,
    "translation": "Biz çürümüş kemikler olduktan sonra ha?"
  },
  {
    "surah_id": 79,
    "ayah_number": 12,
    "global_ayah_id": 5724,
    "translation": "Öyle ise bu, ziyanlı bir dönüştür! dediler."
  },
  {
    "surah_id": 79,
    "ayah_number": 13,
    "global_ayah_id": 5725,
    "translation": "O (olay zor değil) bir tek haykırış(a bakmakta)dır."
  },
  {
    "surah_id": 79,
    "ayah_number": 14,
    "global_ayah_id": 5726,
    "translation": "Hemen onlar uyanıklık alanındadırlar."
  },
  {
    "surah_id": 79,
    "ayah_number": 15,
    "global_ayah_id": 5727,
    "translation": "Musa'nın haberi sana geldi mi?"
  },
  {
    "surah_id": 79,
    "ayah_number": 16,
    "global_ayah_id": 5728,
    "translation": "Hani Rabbi ona Kutsal Vadi'de, \"Tuva\"'da ünlemişti:"
  },
  {
    "surah_id": 79,
    "ayah_number": 17,
    "global_ayah_id": 5729,
    "translation": "Fir'avn'a git, çünkü o azdı."
  },
  {
    "surah_id": 79,
    "ayah_number": 18,
    "global_ayah_id": 5730,
    "translation": "De ki: Arınmağa gönlün var mı?"
  },
  {
    "surah_id": 79,
    "ayah_number": 19,
    "global_ayah_id": 5731,
    "translation": "Seni Rabbin(in yolun)a ileteyim de O'ndan korkasın."
  },
  {
    "surah_id": 79,
    "ayah_number": 20,
    "global_ayah_id": 5732,
    "translation": "Ona büyük mu'cizeyi gösterdi."
  },
  {
    "surah_id": 79,
    "ayah_number": 21,
    "global_ayah_id": 5733,
    "translation": "Fakat o yalanladı, karşı geldi."
  },
  {
    "surah_id": 79,
    "ayah_number": 22,
    "global_ayah_id": 5734,
    "translation": "Sonra sırtını döndü; (Musa'nın getirdiklerini iptal etmek için) çalışmağa koyuldu."
  },
  {
    "surah_id": 79,
    "ayah_number": 23,
    "global_ayah_id": 5735,
    "translation": "(Adamlarını) Topladı, (onlara) bağırdı:"
  },
  {
    "surah_id": 79,
    "ayah_number": 24,
    "global_ayah_id": 5736,
    "translation": "Ben sizin en yüce Rabbinizim! dedi."
  },
  {
    "surah_id": 79,
    "ayah_number": 25,
    "global_ayah_id": 5737,
    "translation": "Allah da onu, sonun ve ilkin (ahiretin ve dünyanın) azabıyle cezalandırdı."
  },
  {
    "surah_id": 79,
    "ayah_number": 26,
    "global_ayah_id": 5738,
    "translation": "Şüphesiz bunda (Allah'tan) korkacak kimse için ibret vardır."
  },
  {
    "surah_id": 79,
    "ayah_number": 27,
    "global_ayah_id": 5739,
    "translation": "Yaratılışça siz mi daha çetinsiniz, yoksa gök mü? (Allah) onu yaptı."
  },
  {
    "surah_id": 79,
    "ayah_number": 28,
    "global_ayah_id": 5740,
    "translation": "Kalınlığını (tavanını) yükseltti, onu düzenledi."
  },
  {
    "surah_id": 79,
    "ayah_number": 29,
    "global_ayah_id": 5741,
    "translation": "Gecesini örtüp kararttı, kuşluğunu (güneşinin ışığını) açığa çıkardı."
  },
  {
    "surah_id": 79,
    "ayah_number": 30,
    "global_ayah_id": 5742,
    "translation": "Bundan sonra da yeri yayıp yuvarlattı."
  },
  {
    "surah_id": 79,
    "ayah_number": 31,
    "global_ayah_id": 5743,
    "translation": "Ondan suyunu ve otlağını çıkardı,"
  },
  {
    "surah_id": 79,
    "ayah_number": 32,
    "global_ayah_id": 5744,
    "translation": "Dağları oturttu,"
  },
  {
    "surah_id": 79,
    "ayah_number": 33,
    "global_ayah_id": 5745,
    "translation": "Sizin ve hayvanlarınızın geçimi için."
  },
  {
    "surah_id": 79,
    "ayah_number": 34,
    "global_ayah_id": 5746,
    "translation": "Herşeyi bastıran o büyük felaket geldiği zaman,"
  },
  {
    "surah_id": 79,
    "ayah_number": 35,
    "global_ayah_id": 5747,
    "translation": "O gün insan, neyin peşinde koşmuş olduğunu hatırlar."
  },
  {
    "surah_id": 79,
    "ayah_number": 36,
    "global_ayah_id": 5748,
    "translation": "Gören kimseler için cehennem ortaya çıkarılmıştır."
  },
  {
    "surah_id": 79,
    "ayah_number": 37,
    "global_ayah_id": 5749,
    "translation": "Artık kim azmışsa,"
  },
  {
    "surah_id": 79,
    "ayah_number": 38,
    "global_ayah_id": 5750,
    "translation": "Ve şu yakın hayatı yeğlemişse,"
  },
  {
    "surah_id": 79,
    "ayah_number": 39,
    "global_ayah_id": 5751,
    "translation": "Onun barınağı cehennemdir."
  },
  {
    "surah_id": 79,
    "ayah_number": 40,
    "global_ayah_id": 5752,
    "translation": "Ama kim Rabbinin divanında dur(up hesap ver)mekten korkmuş ve nefsi(ni) kötü heves(ler) den men'etmişse"
  },
  {
    "surah_id": 79,
    "ayah_number": 41,
    "global_ayah_id": 5753,
    "translation": "Onun barınağı da cennettir."
  },
  {
    "surah_id": 79,
    "ayah_number": 42,
    "global_ayah_id": 5754,
    "translation": "Sana sa'atden soruyorlar: Demir atması (gelip çatması) ne zaman diye."
  },
  {
    "surah_id": 79,
    "ayah_number": 43,
    "global_ayah_id": 5755,
    "translation": "Sen nerede, onun vaktini söylemek nerede?!"
  },
  {
    "surah_id": 79,
    "ayah_number": 44,
    "global_ayah_id": 5756,
    "translation": "Onun bilgisi Rabbine aittir."
  },
  {
    "surah_id": 79,
    "ayah_number": 45,
    "global_ayah_id": 5757,
    "translation": "Sen ancak, ondan korkacak olanları uyarıcısın."
  },
  {
    "surah_id": 79,
    "ayah_number": 46,
    "global_ayah_id": 5758,
    "translation": "Onlar onu gördükleri zaman sanki (dünyada) bir akşam veya onun kuşluk vaktinden fazla kalmamış gibi olurlar."
  }
]