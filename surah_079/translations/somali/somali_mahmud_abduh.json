[
  {
    "surah_id": 79,
    "ayah_number": 1,
    "global_ayah_id": 5713,
    "translation": "Eebe wuxuu ku dhaartay Malaa'igta Nafta si daran uga siibta (gaalada)."
  },
  {
    "surah_id": 79,
    "ayah_number": 2,
    "global_ayah_id": 5714,
    "translation": "Iyo tan si fudud uga qaadda (mu'miniinta)."
  },
  {
    "surah_id": 79,
    "ayah_number": 3,
    "global_ayah_id": 5715,
    "translation": "Iyo Malaa'igta Hawada Dabbaalata (si amar fulin)."
  },
  {
    "surah_id": 79,
    "ayah_number": 4,
    "global_ayah_id": 5716,
    "translation": "Iyo tan u orotanta wanaagga."
  },
  {
    "surah_id": 79,
    "ayah_number": 5,
    "global_ayah_id": 5717,
    "translation": "Iyo kuwa Maamula amarka (Eebe)."
  },
  {
    "surah_id": 79,
    "ayah_number": 6,
    "global_ayah_id": 5718,
    "translation": "Maalinta ay gilgilan afuufka (hore)."
  },
  {
    "surah_id": 79,
    "ayah_number": 7,
    "global_ayah_id": 5719,
    "translation": "Oyna raaci tii dambe (waa sugantahay)."
  },
  {
    "surah_id": 79,
    "ayah_number": 8,
    "global_ayah_id": 5720,
    "translation": "Qalbiyaduna Maalintaa way cabsan."
  },
  {
    "surah_id": 79,
    "ayah_number": 9,
    "global_ayah_id": 5721,
    "translation": "Araggeeduna wuu dullaysnaan."
  },
  {
    "surah_id": 79,
    "ayah_number": 10,
    "global_ayah_id": 5722,
    "translation": "Waxayna dhihi (Gaaladu) Ma raadkiibaa naloo celin (Adduunkii)."
  },
  {
    "surah_id": 79,
    "ayah_number": 11,
    "global_ayah_id": 5723,
    "translation": "Markaan noqonno Lafo duugoobay."
  },
  {
    "surah_id": 79,
    "ayah_number": 12,
    "global_ayah_id": 5724,
    "translation": "Waxay dheheen taasi waa noqosho khasaara ah."
  },
  {
    "surah_id": 79,
    "ayah_number": 13,
    "global_ayah_id": 5725,
    "translation": "Waa uun Hal Qaylo kaliya."
  },
  {
    "surah_id": 79,
    "ayah_number": 14,
    "global_ayah_id": 5726,
    "translation": "Dadkuna markaas ay Dhulka kor iman."
  },
  {
    "surah_id": 79,
    "ayah_number": 15,
    "global_ayah_id": 5727,
    "translation": "Ma ku soo gaadhay warkii (Nabi) Muuse."
  },
  {
    "surah_id": 79,
    "ayah_number": 16,
    "global_ayah_id": 5728,
    "translation": "Markii Eebe uga yeedahy Toggii barakaysnaa ee Dhuwa."
  },
  {
    "surah_id": 79,
    "ayah_number": 17,
    "global_ayah_id": 5729,
    "translation": "Kuna yidhi u tag Fircoon wuu xadgudbaye."
  },
  {
    "surah_id": 79,
    "ayah_number": 18,
    "global_ayah_id": 5730,
    "translation": "Oo ku dheh ma rabtaa inaad daahir noqotid."
  },
  {
    "surah_id": 79,
    "ayah_number": 19,
    "global_ayah_id": 5731,
    "translation": "Oon Eebe Jidkiisa kugu hanuuniyo kana yaabtid."
  },
  {
    "surah_id": 79,
    "ayah_number": 20,
    "global_ayah_id": 5732,
    "translation": "Wuxuuna tusiyay (Nabi-Muuse) Aayad wayn."
  },
  {
    "surah_id": 79,
    "ayah_number": 21,
    "global_ayah_id": 5733,
    "translation": "Wuuse beeniyay oo caasiyay (Fircoon)."
  },
  {
    "surah_id": 79,
    "ayah_number": 22,
    "global_ayah_id": 5734,
    "translation": "Wuuna jeedsaday isagoo xumaan la socda."
  },
  {
    "surah_id": 79,
    "ayah_number": 23,
    "global_ayah_id": 5735,
    "translation": "Wuxuuna kulmiyay (Askartii) una Qaylyay."
  },
  {
    "surah_id": 79,
    "ayah_number": 24,
    "global_ayah_id": 5736,
    "translation": "Isagoo dhihi waxaan ahay Eebihiinna sare."
  },
  {
    "surah_id": 79,
    "ayah_number": 25,
    "global_ayah_id": 5737,
    "translation": "Markaasaa Eebe Ciqaabay Aakhiro iyo Adduunba."
  },
  {
    "surah_id": 79,
    "ayah_number": 26,
    "global_ayah_id": 5738,
    "translation": "Arrintaasna waano yaa ugu sugan Ruuxii Eebe ka yaabi."
  },
  {
    "surah_id": 79,
    "ayah_number": 27,
    "global_ayah_id": 5739,
    "translation": "Ma idinkaa daran abuuridda masc Samada Eebaa dhisay."
  },
  {
    "surah_id": 79,
    "ayah_number": 28,
    "global_ayah_id": 5740,
    "translation": "Korna yeelay jurmigeeda ekeeyayna."
  },
  {
    "surah_id": 79,
    "ayah_number": 29,
    "global_ayah_id": 5741,
    "translation": "Habeenkeedana madoobeeyay Maalinteedana soo bixiyay (Ifiyay)."
  },
  {
    "surah_id": 79,
    "ayah_number": 30,
    "global_ayah_id": 5742,
    "translation": "Dhulkana markaas ka dib fidiyay."
  },
  {
    "surah_id": 79,
    "ayah_number": 31,
    "global_ayah_id": 5743,
    "translation": "Biyahiisa iyo Daaqiisana soo bixiyay."
  },
  {
    "surah_id": 79,
    "ayah_number": 32,
    "global_ayah_id": 5744,
    "translation": "Buurahana sugay."
  },
  {
    "surah_id": 79,
    "ayah_number": 33,
    "global_ayah_id": 5745,
    "translation": "Si aad idinka iyo Xoolihiinnu ugu nacfidaan."
  },
  {
    "surah_id": 79,
    "ayah_number": 34,
    "global_ayah_id": 5746,
    "translation": "Markay timaaddo Musiibadii waynayd (qiyaamadu)."
  },
  {
    "surah_id": 79,
    "ayah_number": 35,
    "global_ayah_id": 5747,
    "translation": "Maalintaas Dadku way xusuusan waxay faleen."
  },
  {
    "surah_id": 79,
    "ayah_number": 36,
    "global_ayah_id": 5748,
    "translation": "Naarta Jaxiimana waxaa loo muujin Ruuxii Arki."
  },
  {
    "surah_id": 79,
    "ayah_number": 37,
    "global_ayah_id": 5749,
    "translation": "Ruuxiise xadgudba."
  },
  {
    "surah_id": 79,
    "ayah_number": 38,
    "global_ayah_id": 5750,
    "translation": "Nolosha Adduunyana doorta."
  },
  {
    "surah_id": 79,
    "ayah_number": 39,
    "global_ayah_id": 5751,
    "translation": "Wuxuu ku dheelman Naarta Jaxiimo."
  },
  {
    "surah_id": 79,
    "ayah_number": 40,
    "global_ayah_id": 5752,
    "translation": "Ruuxiise ka yaaba la kulanka Eebe Naftana ka reeba Hawada (xun)."
  },
  {
    "surah_id": 79,
    "ayah_number": 41,
    "global_ayah_id": 5753,
    "translation": "Wuxuu u dheelman Janno."
  },
  {
    "surah_id": 79,
    "ayah_number": 42,
    "global_ayah_id": 5754,
    "translation": "Waxay ku waydiin Saacadda (Qiyaamaha) markay sugnaan."
  },
  {
    "surah_id": 79,
    "ayah_number": 43,
    "global_ayah_id": 5755,
    "translation": "Maxaa ku ogaysiiyay waqtigeeda."
  },
  {
    "surah_id": 79,
    "ayah_number": 44,
    "global_ayah_id": 5756,
    "translation": "Eebe umbuu ku dhammaan ogaansheheedu."
  },
  {
    "surah_id": 79,
    "ayah_number": 45,
    "global_ayah_id": 5757,
    "translation": "Adugu waxaad tahay uun u digaha Ruuxii ka yaabi."
  },
  {
    "surah_id": 79,
    "ayah_number": 46,
    "global_ayah_id": 5758,
    "translation": "Waxay la mid noqon Malintay arkaan (Qiyaamada) yagon nagaanin Galab iyo Barqin mooyeen (Addunka)."
  }
]