[
  {
    "surah_id": 79,
    "ayah_number": 1,
    "global_ayah_id": 5713,
    "translation": "사악한 자들의 영혼을 강력하게 끌어가는 천사들을 두고 맹세 하사"
  },
  {
    "surah_id": 79,
    "ayah_number": 2,
    "global_ayah_id": 5714,
    "translation": "축복받은 자들의 형혼을 부드 럽게 인도하는 천사들을 두고 맹 세하며"
  },
  {
    "surah_id": 79,
    "ayah_number": 3,
    "global_ayah_id": 5715,
    "translation": "계시를 전달하는 천사를 두고 맹세하며"
  },
  {
    "surah_id": 79,
    "ayah_number": 4,
    "global_ayah_id": 5716,
    "translation": "경주하여 인도하는 천사들을 두고 맹세하며"
  },
  {
    "surah_id": 79,
    "ayah_number": 5,
    "global_ayah_id": 5717,
    "translation": "하나님의 명령들을 수행하는 천사들을 두고 맹세하나니"
  },
  {
    "surah_id": 79,
    "ayah_number": 6,
    "global_ayah_id": 5718,
    "translation": "어느날 동요하게 될 모든 것 은 크게 동요하고"
  },
  {
    "surah_id": 79,
    "ayah_number": 7,
    "global_ayah_id": 5719,
    "translation": "뒤를 이어 동요가 반복되도다"
  },
  {
    "surah_id": 79,
    "ayah_number": 8,
    "global_ayah_id": 5720,
    "translation": "그날의 마음들은 두근거리고"
  },
  {
    "surah_id": 79,
    "ayah_number": 9,
    "global_ayah_id": 5721,
    "translation": "그들의 눈들은 밑으로 척져있 으며"
  },
  {
    "surah_id": 79,
    "ayah_number": 10,
    "global_ayah_id": 5722,
    "translation": "저희가 실로 이전의 상태로 돌아갈 수 있느뇨 라고 말하며"
  },
  {
    "surah_id": 79,
    "ayah_number": 11,
    "global_ayah_id": 5723,
    "translation": "우리가 부패한 뼈들만 남는 데도 그러하느뇨"
  },
  {
    "surah_id": 79,
    "ayah_number": 12,
    "global_ayah_id": 5724,
    "translation": "그리하면 그것이 실로 잃은 귀로가 되리라 말하더라"
  },
  {
    "surah_id": 79,
    "ayah_number": 13,
    "global_ayah_id": 5725,
    "translation": "그러나 그것은 단 한번이 될 것이라"
  },
  {
    "surah_id": 79,
    "ayah_number": 14,
    "global_ayah_id": 5726,
    "translation": "그때 그들은 심판을 위하여 깨어나 있지 않느뇨"
  },
  {
    "surah_id": 79,
    "ayah_number": 15,
    "global_ayah_id": 5727,
    "translation": "모세의 이야기가 그대에게 이르렀느뇨"
  },
  {
    "surah_id": 79,
    "ayah_number": 16,
    "global_ayah_id": 5728,
    "translation": "주님께서 성스러운 계곡 뚜 와로 그를 불러"
  },
  {
    "surah_id": 79,
    "ayah_number": 17,
    "global_ayah_id": 5729,
    "translation": "파라오에게 가라 실로 그는 모든 영역을 벗어난 자이니"
  },
  {
    "surah_id": 79,
    "ayah_number": 18,
    "global_ayah_id": 5730,
    "translation": "그에게 이르러 죄악으로 부터스스로를 청결케 하고자 하느뇨"
  },
  {
    "surah_id": 79,
    "ayah_number": 19,
    "global_ayah_id": 5731,
    "translation": "그리하면 내가 당신을 주님께로 인도하여 주리니 당신은 그 분만을 두려워 하라고 하라"
  },
  {
    "surah_id": 79,
    "ayah_number": 20,
    "global_ayah_id": 5732,
    "translation": "그래서 모세는 그에게 큰 예증을 보였더라"
  },
  {
    "surah_id": 79,
    "ayah_number": 21,
    "global_ayah_id": 5733,
    "translation": "그러나 파라오는 그 진리를 거역하고 오만해 하였으며"
  },
  {
    "surah_id": 79,
    "ayah_number": 22,
    "global_ayah_id": 5734,
    "translation": "등을 돌리고 서둘러 떠나"
  },
  {
    "surah_id": 79,
    "ayah_number": 23,
    "global_ayah_id": 5735,
    "translation": "사람들을 불러 모아 소리쳐 말하길"
  },
  {
    "surah_id": 79,
    "ayah_number": 24,
    "global_ayah_id": 5736,
    "translation": "내가 가장 높이 있는 너희 주님이라 하였으니"
  },
  {
    "surah_id": 79,
    "ayah_number": 25,
    "global_ayah_id": 5737,
    "translation": "하나님은 그에게 내세와 현 세의 벌을 내리셨느니라"
  },
  {
    "surah_id": 79,
    "ayah_number": 26,
    "global_ayah_id": 5738,
    "translation": "실로 이 안에는 하나님을 두려워하는 자들을 위한 교훈이 있 노라"
  },
  {
    "surah_id": 79,
    "ayah_number": 27,
    "global_ayah_id": 5739,
    "translation": "너희를 창조하는 것이 더 어렵느뇨 아니면 그분이 세우신 하 늘이겠느뇨"
  },
  {
    "surah_id": 79,
    "ayah_number": 28,
    "global_ayah_id": 5740,
    "translation": "하나님은 하늘을 가장 높이 두시고 거기에 질서와 온전함을 두셨노라"
  },
  {
    "surah_id": 79,
    "ayah_number": 29,
    "global_ayah_id": 5741,
    "translation": "그분은 밤을 어둡게 두사 빛을 두셨노라"
  },
  {
    "surah_id": 79,
    "ayah_number": 30,
    "global_ayah_id": 5742,
    "translation": "대지를 두시되 넓다랗게 펼 치시어"
  },
  {
    "surah_id": 79,
    "ayah_number": 31,
    "global_ayah_id": 5743,
    "translation": "그곳으로 부터 물과 초목을 생산케 하셨으며"
  },
  {
    "surah_id": 79,
    "ayah_number": 32,
    "global_ayah_id": 5744,
    "translation": "산들을 두시되 온전하게 고 정하셨으니"
  },
  {
    "surah_id": 79,
    "ayah_number": 33,
    "global_ayah_id": 5745,
    "translation": "너희와 가축들에게 유용케 하기 위해서라"
  },
  {
    "surah_id": 79,
    "ayah_number": 34,
    "global_ayah_id": 5746,
    "translation": "그러나 대 재앙이 다가올 때"
  },
  {
    "surah_id": 79,
    "ayah_number": 35,
    "global_ayah_id": 5747,
    "translation": "그날은 인간이 행한 것들을 회상하는 날이며"
  },
  {
    "surah_id": 79,
    "ayah_number": 36,
    "global_ayah_id": 5748,
    "translation": "지옥이 보는 자 앞에 나타날때"
  },
  {
    "surah_id": 79,
    "ayah_number": 37,
    "global_ayah_id": 5749,
    "translation": "오만하며 불신하고"
  },
  {
    "surah_id": 79,
    "ayah_number": 38,
    "global_ayah_id": 5750,
    "translation": "현세의 삶만을 좋아했던 자 들에게는"
  },
  {
    "surah_id": 79,
    "ayah_number": 39,
    "global_ayah_id": 5751,
    "translation": "거주지가 불지옥이 될 것이라"
  },
  {
    "surah_id": 79,
    "ayah_number": 40,
    "global_ayah_id": 5752,
    "translation": "그러나 주님앞에 서는 것을 두려워하고 저속한 욕망들로부터 자신을 자제하였던 자들에게는"
  },
  {
    "surah_id": 79,
    "ayah_number": 41,
    "global_ayah_id": 5753,
    "translation": "거주지가 천국이 될 것이라"
  },
  {
    "surah_id": 79,
    "ayah_number": 42,
    "global_ayah_id": 5754,
    "translation": "그들은 그때가 언제 있을 것이냐고 그대에게 질문하나"
  },
  {
    "surah_id": 79,
    "ayah_number": 43,
    "global_ayah_id": 5755,
    "translation": "그것을 언급하는 것이 그대 에게 관계되는 일이뇨"
  },
  {
    "surah_id": 79,
    "ayah_number": 44,
    "global_ayah_id": 5756,
    "translation": "종말은 그대 주님만 아시는 것으로"
  },
  {
    "surah_id": 79,
    "ayah_number": 45,
    "global_ayah_id": 5757,
    "translation": "그대는 그것을 두려워 하는 자에게 경고하는 경고자에 불과하니라"
  },
  {
    "surah_id": 79,
    "ayah_number": 46,
    "global_ayah_id": 5758,
    "translation": "그것을 보는 날 그들은 저녁이나 아침시간의 정도 머문 것 같이 느껴질 것이라"
  }
]