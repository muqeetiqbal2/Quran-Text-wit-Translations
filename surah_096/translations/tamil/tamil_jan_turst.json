[
  {
    "surah_id": 96,
    "ayah_number": 1,
    "global_ayah_id": 6107,
    "translation": "(யாவற்றையும்) படைத்த உம்முடைய இறைவனின் திருநாமத்தைக் கொண்டு ஓதுவீராக."
  },
  {
    "surah_id": 96,
    "ayah_number": 2,
    "global_ayah_id": 6108,
    "translation": "'அலக்' என்ற நிலையிலிருந்து மனிதனை படைத்தான்."
  },
  {
    "surah_id": 96,
    "ayah_number": 3,
    "global_ayah_id": 6109,
    "translation": "ஓதுவீராக: உம் இறைவன் மாபெரும் கொடையாளி."
  },
  {
    "surah_id": 96,
    "ayah_number": 4,
    "global_ayah_id": 6110,
    "translation": "அவனே எழுது கோலைக் கொண்டு கற்றுக் கொடுத்தான்."
  },
  {
    "surah_id": 96,
    "ayah_number": 5,
    "global_ayah_id": 6111,
    "translation": "மனிதனுக்கு அவன் அறியாதவற்றையெல்லாம் கற்றுக் கொடுத்தான்."
  },
  {
    "surah_id": 96,
    "ayah_number": 6,
    "global_ayah_id": 6112,
    "translation": "எனினும் நிச்சயமாக மனிதன் வரம்பு மீறுகிறான்."
  },
  {
    "surah_id": 96,
    "ayah_number": 7,
    "global_ayah_id": 6113,
    "translation": "அவன் தன்னை (இறைவனிடமிருந்து) தேவையற்றவன் என்று காணும் போது,"
  },
  {
    "surah_id": 96,
    "ayah_number": 8,
    "global_ayah_id": 6114,
    "translation": "நிச்சயமாக அவன் மீளுதல் உம்முடைய இறைவன்பாலே இருக்கிறது."
  },
  {
    "surah_id": 96,
    "ayah_number": 9,
    "global_ayah_id": 6115,
    "translation": "தடை செய்கிறானே (அவனை) நீர் பார்த்தீரா?"
  },
  {
    "surah_id": 96,
    "ayah_number": 10,
    "global_ayah_id": 6116,
    "translation": "ஓர் அடியாரை - அவர் தொழும்போது,"
  },
  {
    "surah_id": 96,
    "ayah_number": 11,
    "global_ayah_id": 6117,
    "translation": "நீர் பார்த்தீரா? அவர் நேர்வழியில் இருந்து கொண்டும்,"
  },
  {
    "surah_id": 96,
    "ayah_number": 12,
    "global_ayah_id": 6118,
    "translation": "அல்லது அவர் பயபக்தியைக் கொண்டு ஏவியவாறு இருந்தும்,"
  },
  {
    "surah_id": 96,
    "ayah_number": 13,
    "global_ayah_id": 6119,
    "translation": "அவரை அவன் பொய்யாக்கி, முகத்தைத் திருப்பிக் கொண்டான் என்பதை நிர் பார்த்தீரா,"
  },
  {
    "surah_id": 96,
    "ayah_number": 14,
    "global_ayah_id": 6120,
    "translation": "நிச்சயமாக அல்லாஹ் (அவனைப்) பார்க்கிறான் என்பதை அவன் அறியவில்லையா?"
  },
  {
    "surah_id": 96,
    "ayah_number": 15,
    "global_ayah_id": 6121,
    "translation": "அப்படியல்ல: அவன் விலகிக் கொள்ளவில்லையானால், நிச்சயமாக நாம் (அவனுடைய) முன்னெற்றி ரோமத்தைப் பிடித்து அவனை இழுப்போம்."
  },
  {
    "surah_id": 96,
    "ayah_number": 16,
    "global_ayah_id": 6122,
    "translation": "தவறிழைத்து பொய்யுரைக்கும் முன்னெற்றி ரோமத்தை,"
  },
  {
    "surah_id": 96,
    "ayah_number": 17,
    "global_ayah_id": 6123,
    "translation": "ஆகவே, அவன் தன் சபையோரை அழைக்கட்டும்."
  },
  {
    "surah_id": 96,
    "ayah_number": 18,
    "global_ayah_id": 6124,
    "translation": "நாமும் நரகக் காவலாளிகளை அழைப்போம்."
  },
  {
    "surah_id": 96,
    "ayah_number": 19,
    "global_ayah_id": 6125,
    "translation": "(அவன் கூறுவது போலல்ல) அவனுக்கு நீர் வழிபடாதீர்; (உம் இறைவனுக்கு) ஸுஜூது செய்து (வணங்கி அவனை) நெருங்குவீராக."
  }
]