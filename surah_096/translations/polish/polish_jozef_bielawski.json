[
  {
    "surah_id": 96,
    "ayah_number": 1,
    "global_ayah_id": 6107,
    "translation": "Głoś! w imię twego Pana, który stworzył!"
  },
  {
    "surah_id": 96,
    "ayah_number": 2,
    "global_ayah_id": 6108,
    "translation": "Stworzył człowieka z grudki krwi zakrzepłej!"
  },
  {
    "surah_id": 96,
    "ayah_number": 3,
    "global_ayah_id": 6109,
    "translation": "Głoś! Twój Pan jest najszlachetniejszy!"
  },
  {
    "surah_id": 96,
    "ayah_number": 4,
    "global_ayah_id": 6110,
    "translation": "Ten, który nauczył człowieka przez pióro;"
  },
  {
    "surah_id": 96,
    "ayah_number": 5,
    "global_ayah_id": 6111,
    "translation": "Nauczył człowieka tego, czego on nie wiedział."
  },
  {
    "surah_id": 96,
    "ayah_number": 6,
    "global_ayah_id": 6112,
    "translation": "Niestety, nie! Zaprawdę, człowiek się buntuje,"
  },
  {
    "surah_id": 96,
    "ayah_number": 7,
    "global_ayah_id": 6113,
    "translation": "Ponieważ czuje się niezależnym!"
  },
  {
    "surah_id": 96,
    "ayah_number": 8,
    "global_ayah_id": 6114,
    "translation": "Zaprawdę, powrócisz przecież do twojego Pana!"
  },
  {
    "surah_id": 96,
    "ayah_number": 9,
    "global_ayah_id": 6115,
    "translation": "Czy widziałeś tego, który zabrania"
  },
  {
    "surah_id": 96,
    "ayah_number": 10,
    "global_ayah_id": 6116,
    "translation": "Słudze modlić się?"
  },
  {
    "surah_id": 96,
    "ayah_number": 11,
    "global_ayah_id": 6117,
    "translation": "Czy sądzisz, iż on jest na drodze prostej"
  },
  {
    "surah_id": 96,
    "ayah_number": 12,
    "global_ayah_id": 6118,
    "translation": "Albo że zaleca bogobojność?"
  },
  {
    "surah_id": 96,
    "ayah_number": 13,
    "global_ayah_id": 6119,
    "translation": "Czy też sądzisz, iż on za kłamstwo uznaje prawdę i odwraca się?"
  },
  {
    "surah_id": 96,
    "ayah_number": 14,
    "global_ayah_id": 6120,
    "translation": "Czyż on nie wie, że Bóg widzi?"
  },
  {
    "surah_id": 96,
    "ayah_number": 15,
    "global_ayah_id": 6121,
    "translation": "Niech się ma na baczności! Jeśli nie zaprzestanie, to, zaprawdę, pociągniemy go za kosmyk;"
  },
  {
    "surah_id": 96,
    "ayah_number": 16,
    "global_ayah_id": 6122,
    "translation": "Za kosmyk kłamliwy i grzeszny!"
  },
  {
    "surah_id": 96,
    "ayah_number": 17,
    "global_ayah_id": 6123,
    "translation": "Niech on wezwie swoich popleczników!"
  },
  {
    "surah_id": 96,
    "ayah_number": 18,
    "global_ayah_id": 6124,
    "translation": "My wezwiemy strażników!"
  },
  {
    "surah_id": 96,
    "ayah_number": 19,
    "global_ayah_id": 6125,
    "translation": "Ależ nie! Nie słuchaj go! Wybijaj pokłony i zbliż się!"
  }
]