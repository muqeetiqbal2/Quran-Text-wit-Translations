[
  {
    "surah_id": 96,
    "ayah_number": 1,
    "global_ayah_id": 6107,
    "translation": "তুমি পড়ো তোমার প্রভুর নামে যিনি সৃষ্টি করেছেন, --"
  },
  {
    "surah_id": 96,
    "ayah_number": 2,
    "global_ayah_id": 6108,
    "translation": "সৃষ্টি করেছেন মানুষকে এক রক্তপিন্ড থেকে।"
  },
  {
    "surah_id": 96,
    "ayah_number": 3,
    "global_ayah_id": 6109,
    "translation": "পড়ো! আর তোমার প্রভু মহাসম্মানিত --"
  },
  {
    "surah_id": 96,
    "ayah_number": 4,
    "global_ayah_id": 6110,
    "translation": "যিনি শিক্ষা দিয়েছেন কলমের সাহায্যে,"
  },
  {
    "surah_id": 96,
    "ayah_number": 5,
    "global_ayah_id": 6111,
    "translation": "শিক্ষা দিয়েছেন মানুষকে যা সে জানতোই না।"
  },
  {
    "surah_id": 96,
    "ayah_number": 6,
    "global_ayah_id": 6112,
    "translation": "বস্তুতঃ মানুষ নিশ্চয়ই সীমালংঘন করেই থাকে।"
  },
  {
    "surah_id": 96,
    "ayah_number": 7,
    "global_ayah_id": 6113,
    "translation": "কারণ সে নিজেকে স্বয়ংসমৃদ্ধ দেখে।"
  },
  {
    "surah_id": 96,
    "ayah_number": 8,
    "global_ayah_id": 6114,
    "translation": "নিশ্চয় তোমার প্রভুর কাছেই প্রত্যাবর্তন।"
  },
  {
    "surah_id": 96,
    "ayah_number": 9,
    "global_ayah_id": 6115,
    "translation": "তুমি কি তাকে দেখেছ যে বারণ করে --"
  },
  {
    "surah_id": 96,
    "ayah_number": 10,
    "global_ayah_id": 6116,
    "translation": "একজন বান্দাকে যখন সে নামায পড়ে?"
  },
  {
    "surah_id": 96,
    "ayah_number": 11,
    "global_ayah_id": 6117,
    "translation": "তুমি কি লক্ষ্য করেছ -- সে সৎপথে রয়েছে কি না,"
  },
  {
    "surah_id": 96,
    "ayah_number": 12,
    "global_ayah_id": 6118,
    "translation": "অথবা ধর্মভীরুতা অবলন্বনের নির্দেশ দেয় কিনা?"
  },
  {
    "surah_id": 96,
    "ayah_number": 13,
    "global_ayah_id": 6119,
    "translation": "তুমি কি দেখেছ -- সে মিথ্যারোপ করছে ও ফিরে যাচ্ছে কি না?"
  },
  {
    "surah_id": 96,
    "ayah_number": 14,
    "global_ayah_id": 6120,
    "translation": "সে কি জানে না যে আল্লাহ্ অবশ্যই দেখতে পাচ্ছেন?"
  },
  {
    "surah_id": 96,
    "ayah_number": 15,
    "global_ayah_id": 6121,
    "translation": "না, যদি সে না থামে তবে আমরা নিশ্চয় টেনে ধরব কপালের চুলের গোছা --"
  },
  {
    "surah_id": 96,
    "ayah_number": 16,
    "global_ayah_id": 6122,
    "translation": "মিথ্যাচারী পাপাচারী চুলের গোছা!"
  },
  {
    "surah_id": 96,
    "ayah_number": 17,
    "global_ayah_id": 6123,
    "translation": "তাহলে সে ডাকুক তার সাঙ্গোপাঙ্গদের,"
  },
  {
    "surah_id": 96,
    "ayah_number": 18,
    "global_ayah_id": 6124,
    "translation": "আমরাও সঙ্গে সঙ্গে ডাকবো দুর্ধর্ষ বাহিনীকে।"
  },
  {
    "surah_id": 96,
    "ayah_number": 19,
    "global_ayah_id": 6125,
    "translation": "না, তুমি তার আজ্ঞা পালন করো না, বরং তুমি সিজদা করো এবং নিকটবর্তী হও।"
  }
]