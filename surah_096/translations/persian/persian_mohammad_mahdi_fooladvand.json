[
  {
    "surah_id": 96,
    "ayah_number": 1,
    "global_ayah_id": 6107,
    "translation": "بخوان به نام پروردگارت كه آفريد."
  },
  {
    "surah_id": 96,
    "ayah_number": 2,
    "global_ayah_id": 6108,
    "translation": "انسان را از عَلَق آفريد."
  },
  {
    "surah_id": 96,
    "ayah_number": 3,
    "global_ayah_id": 6109,
    "translation": "بخوان، و پروردگار تو كريمترين [كريمان‌] است."
  },
  {
    "surah_id": 96,
    "ayah_number": 4,
    "global_ayah_id": 6110,
    "translation": "همان كس كه به وسيله قلم آموخت."
  },
  {
    "surah_id": 96,
    "ayah_number": 5,
    "global_ayah_id": 6111,
    "translation": "آنچه را كه انسان نمى‌دانست [بتدريج به او] آموخت."
  },
  {
    "surah_id": 96,
    "ayah_number": 6,
    "global_ayah_id": 6112,
    "translation": "حقاً كه انسان سركشى مى‌كند،"
  },
  {
    "surah_id": 96,
    "ayah_number": 7,
    "global_ayah_id": 6113,
    "translation": "همين كه خود را بى‌نياز پندارد."
  },
  {
    "surah_id": 96,
    "ayah_number": 8,
    "global_ayah_id": 6114,
    "translation": "در حقيقت، بازگشت به سوى پروردگار توست."
  },
  {
    "surah_id": 96,
    "ayah_number": 9,
    "global_ayah_id": 6115,
    "translation": "آيا ديدى آن كس را كه باز مى‌داشت،"
  },
  {
    "surah_id": 96,
    "ayah_number": 10,
    "global_ayah_id": 6116,
    "translation": "بنده‌اى را آنگاه كه نماز مى‌گزارد؟"
  },
  {
    "surah_id": 96,
    "ayah_number": 11,
    "global_ayah_id": 6117,
    "translation": "چه پندارى اگر او بر هدايت باشد،"
  },
  {
    "surah_id": 96,
    "ayah_number": 12,
    "global_ayah_id": 6118,
    "translation": "يا به پرهيزگارى وادارد [براى او بهتر نيست‌]؟"
  },
  {
    "surah_id": 96,
    "ayah_number": 13,
    "global_ayah_id": 6119,
    "translation": "[و باز] آيا چه پندارى [كه‌] اگر او به تكذيب پردازد و روى برگرداند [چه كيفرى در پيش دارد]؟"
  },
  {
    "surah_id": 96,
    "ayah_number": 14,
    "global_ayah_id": 6120,
    "translation": "مگر ندانسته كه خدا مى‌بيند؟"
  },
  {
    "surah_id": 96,
    "ayah_number": 15,
    "global_ayah_id": 6121,
    "translation": "زنهار، اگر باز نايستد، موى پيشانى [او] را سخت بگيريم؛"
  },
  {
    "surah_id": 96,
    "ayah_number": 16,
    "global_ayah_id": 6122,
    "translation": "[همان‌] موى پيشانى دروغزن گناه‌پيشه را."
  },
  {
    "surah_id": 96,
    "ayah_number": 17,
    "global_ayah_id": 6123,
    "translation": "[بگو] تا گروه خود را بخواند."
  },
  {
    "surah_id": 96,
    "ayah_number": 18,
    "global_ayah_id": 6124,
    "translation": "بزودى آتشبانان را فرا خوانيم."
  },
  {
    "surah_id": 96,
    "ayah_number": 19,
    "global_ayah_id": 6125,
    "translation": "زنهار! فرمانش مَبَر، و سجده كن، و خود را [به خدا] نزديك گردان."
  }
]