    "global_ayah_id": 6201,
    "translation": " «<a href=416> شروع </a>» کرتا ہوں اللہ تعا لٰی کے «<a href=614> نام\n</a>» سے جو بڑا «<a href=600> مہربان </a>» نہایت رحم والا ہے ۔ "
  },
  {
    "surah_id": 96,
    "ayah_number": 1,
    "global_ayah_id": 6202,
    "translation": " پڑھ اپنے رب کے «<a href=614> نام </a>» سے جس نے «<a href=180> پیدا\n</a>» کیا ۔ "
  },
  {
    "surah_id": 96,
    "ayah_number": 2,
    "global_ayah_id": 6203,
    "translation": " جس نے «<a href=3> انسان </a>» کو خون کے لوتھڑے سے «<a href=180> پیدا\n</a>» کیا ۔ "
  },
  {
    "surah_id": 96,
    "ayah_number": 3,
    "global_ayah_id": 6204,
    "translation": " تو پڑھتا رہ تیرا رب بڑے کرم والا ہے ۔ "
  },
  {
    "surah_id": 96,
    "ayah_number": 4,
    "global_ayah_id": 6205,
    "translation": " جس نے قلم کے ذریعے ( علم ) سکھایا ۔ "
  },
  {
    "surah_id": 96,
    "ayah_number": 5,
    "global_ayah_id": 6206,
    "translation": " جس نے «<a href=3> انسان </a>» کو وہ سکھایا جسے وہ نہیں جانتا تھا ۔ "
  },
  {
    "surah_id": 96,
    "ayah_number": 6,
    "global_ayah_id": 6207,
    "translation": " «<a href=390> سچ </a>» مچ «<a href=3> انسان </a>» تو آپے سے باہر ہو\nجاتا ہے ۔ "
  },
  {
    "surah_id": 96,
    "ayah_number": 7,
    "global_ayah_id": 6208,
    "translation": " اس لئے کہ وہ اپنے آپ کو بے پرواہ ( یا تونگر ) سمجھتا ہے ۔ "
  },
  {
    "surah_id": 96,
    "ayah_number": 8,
    "global_ayah_id": 6209,
    "translation": " یقیناً لوٹنا تیرے رب کی طرف ہے ۔ "
  },
  {
    "surah_id": 96,
    "ayah_number": 9,
    "global_ayah_id": 6210,
    "translation": " ۔ ( بھلا ) اسے بھی تو نے دیکھا جو بندے کو روکتا ہے ۔ "
  },
  {
    "surah_id": 96,
    "ayah_number": 10,
    "global_ayah_id": 6211,
    "translation": " جبکہ وہ بندہ نماز ادا کرتا ہے ۔ "
  },
  {
    "surah_id": 96,
    "ayah_number": 11,
    "global_ayah_id": 6212,
    "translation": " بھلا بتلا تو اگر وہ «<a href=644> ہدایت </a>» پر ہو ۔ "
  },
  {
    "surah_id": 96,
    "ayah_number": 12,
    "global_ayah_id": 6213,
    "translation": " یا پرہیزگاری کا «<a href=288> حکم </a>» دیتا ہو ۔ "
  },
  {
    "surah_id": 96,
    "ayah_number": 13,
    "global_ayah_id": 6214,
    "translation": " بھلا دیکھو تو اگر یہ جھٹلاتا ہو اور «<a href=597> منہ </a>» پھیرتا ہو\nتو ۔ "
  },
  {
    "surah_id": 96,
    "ayah_number": 14,
    "global_ayah_id": 6215,
    "translation": " کیا اس نے نہیں جانا کہ اللہ تعالٰی اسے خوب دیکھ رہا ہے ۔ "
  },
  {
    "surah_id": 96,
    "ayah_number": 15,
    "global_ayah_id": 6216,
    "translation": " یقیناً اگر یہ «<a href=76> باز </a>» نہ رہا تو ہم اس کی «<a href=182>\n  پیشانی </a>» کے «<a href=80> بال </a>» پکڑ کر گھسیٹیں گے ۔ "
  },
  {
    "surah_id": 96,
    "ayah_number": 16,
    "global_ayah_id": 6217,
    "translation": " ایسی «<a href=182> پیشانی </a>» جو جھوٹی خطا کار ہے ۔ "
  },
  {
    "surah_id": 96,
    "ayah_number": 17,
    "global_ayah_id": 6218,
    "translation": " یہ اپنی «<a href=570> مجلس </a>» والوں کو بلا لے ۔ "
  },
  {
    "surah_id": 96,
    "ayah_number": 18,
    "global_ayah_id": 6219,
    "translation": " ہم بھی ( «<a href=331> دوزخ </a>» کے ) پیادوں کو بلا لیں گے ۔ "
  },
  {
    "surah_id": 96,
    "ayah_number": 19,
    "global_ayah_id": 6220,
    "translation": " خبردار! اس کا کہنا ہرگز نہ ماننا اور سجدہ کر اور قریب ہو جا ۔ "
  }
]