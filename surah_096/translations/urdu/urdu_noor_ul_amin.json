    "global_ayah_id": 6201,
    "translation": "شروع اللہ کے «<a href=614> نام </a>» سے جو بڑا «<a href=600> مہربان </a>» اور نہایت رحم کرنے والا ہے"
  },
  {
    "surah_id": 96,
    "ayah_number": 1,
    "global_ayah_id": 6202,
    "translation": "اپنے رب کے «<a href=614> نام </a>» سے پڑھئے جس نے  ( ہرچیزکو )  «<a href=180> پیدا </a>» کیا  ہے"
  },
  {
    "surah_id": 96,
    "ayah_number": 2,
    "global_ayah_id": 6203,
    "translation": "( اور )  «<a href=3> انسان </a>» کو خون کے لوتھڑے سے «<a href=180> پیدا </a>» کیا"
  },
  {
    "surah_id": 96,
    "ayah_number": 3,
    "global_ayah_id": 6204,
    "translation": "پڑھئے اور آپ کارب بڑاکریم ہے"
  },
  {
    "surah_id": 96,
    "ayah_number": 4,
    "global_ayah_id": 6205,
    "translation": "جس نے قلم کے ذریعے سے علم سکھایا"
  },
  {
    "surah_id": 96,
    "ayah_number": 5,
    "global_ayah_id": 6206,
    "translation": "انسان کو وہ سکھلادیاجو نہیں جانتا تھا"
  },
  {
    "surah_id": 96,
    "ayah_number": 6,
    "global_ayah_id": 6207,
    "translation": "ہرگز ا یسا نہیں چاہیے کہ «<a href=3> انسان </a>» سرکش بن جاتا ہے"
  },
  {
    "surah_id": 96,
    "ayah_number": 7,
    "global_ayah_id": 6208,
    "translation": "جب دیکھتا ہے کہ وہ دولت مندہوگیا ہے"
  },
  {
    "surah_id": 96,
    "ayah_number": 8,
    "global_ayah_id": 6209,
    "translation": "یقینااسے اپنے رب کی طرف لوٹنا ہے"
  },
  {
    "surah_id": 96,
    "ayah_number": 9,
    "global_ayah_id": 6210,
    "translation": "کیا تم نے اس  ( ابوجہل کو  )  دیکھاجو منع کرتا ہے"
  },
  {
    "surah_id": 96,
    "ayah_number": 10,
    "global_ayah_id": 6211,
    "translation": "اس بندے  ( یعنی محمد )  کوجبکہ وہ نمازاداکرتا ہے"
  },
  {
    "surah_id": 96,
    "ayah_number": 11,
    "global_ayah_id": 6212,
    "translation": "ذرا سوچوتو ،  اگروہ «<a href=644> ہدایت </a>» پر ہو"
  },
  {
    "surah_id": 96,
    "ayah_number": 12,
    "global_ayah_id": 6213,
    "translation": "یاپرہیزگاری کا «<a href=288> حکم </a>» دیتا ہو"
  },
  {
    "surah_id": 96,
    "ayah_number": 13,
    "global_ayah_id": 6214,
    "translation": "ذراسوچو  ( وہ )  جھٹلاتا اور «<a href=597> منہ </a>» موڑتاہو"
  },
  {
    "surah_id": 96,
    "ayah_number": 14,
    "global_ayah_id": 6215,
    "translation": "کیا وہ نہیں جانتاکہ اللہ دیکھ رہا ہے"
  },
  {
    "surah_id": 96,
    "ayah_number": 15,
    "global_ayah_id": 6216,
    "translation": "یقینااگروہ «<a href=76> باز </a>» نہ آیاتوہم اس کی «<a href=182> پیشانی </a>» کے «<a href=80> بال </a>» سے پکڑکر گھسیٹیں گے"
  },
  {
    "surah_id": 96,
    "ayah_number": 16,
    "global_ayah_id": 6217,
    "translation": "پیشانی جو جھوٹی اور خطاکارہے"
  },
  {
    "surah_id": 96,
    "ayah_number": 17,
    "global_ayah_id": 6218,
    "translation": "سو وہ اپنی «<a href=570> مجلس </a>» والوں کو بلالے"
  },
  {
    "surah_id": 96,
    "ayah_number": 18,
    "global_ayah_id": 6219,
    "translation": "ہم «<a href=440> عذاب </a>» کے فرشتے کو بلائیں گے"
  },
  {
    "surah_id": 96,
    "ayah_number": 19,
    "global_ayah_id": 6220,
    "translation": "خبردار! اس کاکہناہرگز نہیں ماننا اور سجدہ کراور  ( اپنے رب کے )  قریب ہو جائیے"
  }
]