  {
    "surah_id": 96,
    "ayah_number": 3,
    "global_ayah_id": 6204,
    "translation": "پڑھیے اور آپکا رب ہی سب سے «<a href=636> زیادہ </a>» کریم ہے"
  },
  {
    "surah_id": 96,
    "ayah_number": 4,
    "global_ayah_id": 6205,
    "translation": "جس نے قلم سے  ( «<a href=553> لکھنا </a>» )  سکھایا"
