  {
    "surah_id": 96,
    "ayah_number": 19,
    "global_ayah_id": 6220,
    "translation": "ہرگز نہیں، آپ اس کی کوئی «<a href=71> بات </a>» نہ مانیں، آپ سجدہ کریں اور «<a href=636> زیادہ </a>» قریب ہوں"
  }
