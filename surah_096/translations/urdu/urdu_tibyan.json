  {
    "surah_id": 96,
    "ayah_number": 11,
    "global_ayah_id": 6212,
    "translation": "آپ بتائیں اگر وہ منع کرنے والا «<a href=644> ہدایت </a>» پر ہوتا"
  },
  {
    "surah_id": 96,
    "ayah_number": 12,
    "global_ayah_id": 6213,
    "translation": "یا وہ اللہ سے ڈرنے کا «<a href=288> حکم </a>» دیتا"
  },
  {
    "surah_id": 96,
    "ayah_number": 13,
    "global_ayah_id": 6214,
    "translation": "آپ بتائیں اگر وہ حق کی تکذیب کرے اور پیٹھ پھیرے"
  },
  {
    "surah_id": 96,
    "ayah_number": 14,
    "global_ayah_id": 6215,
    "translation": "کیا اس نے یہ نہیں جانا کہ بیشک اللہ سب کچھ دیکھ رہا ہے"
