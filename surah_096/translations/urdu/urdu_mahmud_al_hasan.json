[
  {
    "surah_id": 96,
    "ayah_number": 0,
    "global_ayah_id": 6201,
    "translation": "اللہ کے نام سے جو رحمان و رحیم ہے"
  },
  {
    "surah_id": 96,
    "ayah_number": 1,
    "global_ayah_id": 6202,
    "translation": "پڑھ اپنے رب کے نام سے جو سب کا بنانے والا ہے"
  },
  {
    "surah_id": 96,
    "ayah_number": 2,
    "global_ayah_id": 6203,
    "translation": "بنایا آدمی کو جمے ہوئے لہو سے"
  },
  {
    "surah_id": 96,
    "ayah_number": 3,
    "global_ayah_id": 6204,
    "translation": "پڑھ اور تیرا رب بڑا کریم ہے"
  },
  {
    "surah_id": 96,
    "ayah_number": 4,
    "global_ayah_id": 6205,
    "translation": "جس نے علم سکھایا قلم سے"
  },
  {
    "surah_id": 96,
    "ayah_number": 5,
    "global_ayah_id": 6206,
    "translation": "سکھلایا آدمی کو جو وہ نہ جانتا تھا"
  },
  {
    "surah_id": 96,
    "ayah_number": 6,
    "global_ayah_id": 6207,
    "translation": "کوئی نہیں آدمی سر چڑھتا ہے اس سے"
  },
  {
    "surah_id": 96,
    "ayah_number": 7,
    "global_ayah_id": 6208,
    "translation": "کہ دیکھے اپنے آپکو بے پروا"
  },
  {
    "surah_id": 96,
    "ayah_number": 8,
    "global_ayah_id": 6209,
    "translation": "بیشک تیرے رب کی طرف پھر جانا ہے"
  },
  {
    "surah_id": 96,
    "ayah_number": 9,
    "global_ayah_id": 6210,
    "translation": "تو نے دیکھا اُسکو جو منع کرتا ہے"
  },
  {
    "surah_id": 96,
    "ayah_number": 10,
    "global_ayah_id": 6211,
    "translation": "ایک بندہ کو جب وہ نماز پڑھے"
  },
  {
    "surah_id": 96,
    "ayah_number": 11,
    "global_ayah_id": 6212,
    "translation": "بھلا دیکھ تو اگر ہوتا نیک راہ پر"
  },
  {
    "surah_id": 96,
    "ayah_number": 12,
    "global_ayah_id": 6213,
    "translation": "یا سکھلاتا ڈر کے کام"
  },
  {
    "surah_id": 96,
    "ayah_number": 13,
    "global_ayah_id": 6214,
    "translation": "بھلا دیکھ تو اگر جھٹلایا اور منہ موڑا"
  },
  {
    "surah_id": 96,
    "ayah_number": 14,
    "global_ayah_id": 6215,
    "translation": "یہ نہ جانا کہ اللہ دیکھتا ہے"
  },
  {
    "surah_id": 96,
    "ayah_number": 15,
    "global_ayah_id": 6216,
    "translation": "کوئی نہیں اگر باز نہ آئے گا ہم گھسیٹیں گے چوٹی پکڑ کر"
  },
  {
    "surah_id": 96,
    "ayah_number": 16,
    "global_ayah_id": 6217,
    "translation": "کیسی چوٹی جھوٹی گنہگار"
  },
  {
    "surah_id": 96,
    "ayah_number": 17,
    "global_ayah_id": 6218,
    "translation": "اب بلا لیوے اپنے مجلس والوں کو"
  },
  {
    "surah_id": 96,
    "ayah_number": 18,
    "global_ayah_id": 6219,
    "translation": "ہم بھی بلاتے ہیں پیادے سیاست کرنے کو"
  },
  {
    "surah_id": 96,
    "ayah_number": 19,
    "global_ayah_id": 6220,
    "translation": "کوئی نہیں مت مان اُسکا کہا اور سجدہ کر اور نزدیک ہو"
  }
]