[
  {
    "surah_id": 96,
    "ayah_number": 1,
    "global_ayah_id": 6107,
    "translation": "Lees voor! In de naam van jouw Heer, Die heeft geschapen."
  },
  {
    "surah_id": 96,
    "ayah_number": 2,
    "global_ayah_id": 6108,
    "translation": "Hij heeft de mens geschapen van een bloedklomp."
  },
  {
    "surah_id": 96,
    "ayah_number": 3,
    "global_ayah_id": 6109,
    "translation": "Lees voor! En jouw Heer is de Meest Edele."
  },
  {
    "surah_id": 96,
    "ayah_number": 4,
    "global_ayah_id": 6110,
    "translation": "Degene Die onderwezen heeft met de pen."
  },
  {
    "surah_id": 96,
    "ayah_number": 5,
    "global_ayah_id": 6111,
    "translation": "Hij heeft de mens onderwezen wat hij niet wist."
  },
  {
    "surah_id": 96,
    "ayah_number": 6,
    "global_ayah_id": 6112,
    "translation": "Nee, voorwaar, de mens is zeker in overtreding."
  },
  {
    "surah_id": 96,
    "ayah_number": 7,
    "global_ayah_id": 6113,
    "translation": "Omdat hij zichzelf als behoefteloos beschouwt."
  },
  {
    "surah_id": 96,
    "ayah_number": 8,
    "global_ayah_id": 6114,
    "translation": "Voorwaar, tot jouw Heer is de terugkeer."
  },
  {
    "surah_id": 96,
    "ayah_number": 9,
    "global_ayah_id": 6115,
    "translation": "Wat denk jij van hem die verbiedt?"
  },
  {
    "surah_id": 96,
    "ayah_number": 10,
    "global_ayah_id": 6116,
    "translation": "Een dienaar wanneer hij de shalât verricht."
  },
  {
    "surah_id": 96,
    "ayah_number": 11,
    "global_ayah_id": 6117,
    "translation": "Wat denk je, als hij (Mohammed) de leiding volgt?"
  },
  {
    "surah_id": 96,
    "ayah_number": 12,
    "global_ayah_id": 6118,
    "translation": "Of hij tot Taqwa oproept?"
  },
  {
    "surah_id": 96,
    "ayah_number": 13,
    "global_ayah_id": 6119,
    "translation": "Wat denk jij, als hij (Abôe Djahl) loochent en zich afwendt?"
  },
  {
    "surah_id": 96,
    "ayah_number": 14,
    "global_ayah_id": 6120,
    "translation": "Weet hij dan niet dat Allah (hem) ziet?"
  },
  {
    "surah_id": 96,
    "ayah_number": 15,
    "global_ayah_id": 6121,
    "translation": "Nee, als hij niet ophoudt, dan zullen Wij hem bij zijn voorhoofdslok grijpen."
  },
  {
    "surah_id": 96,
    "ayah_number": 16,
    "global_ayah_id": 6122,
    "translation": "Een leugenachtige, zondige voorhoofdslok."
  },
  {
    "surah_id": 96,
    "ayah_number": 17,
    "global_ayah_id": 6123,
    "translation": "Laat hem dan zijn bondgenoten roepen."
  },
  {
    "surah_id": 96,
    "ayah_number": 18,
    "global_ayah_id": 6124,
    "translation": "Wij zullen de Zabâniyah roepen."
  },
  {
    "surah_id": 96,
    "ayah_number": 19,
    "global_ayah_id": 6125,
    "translation": "Nee, gehoorzaam hem niet, en kniel je neer en zoek toenadering (tot Allah)."
  }
]