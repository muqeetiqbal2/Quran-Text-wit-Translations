[
  {
    "surah_id": 96,
    "ayah_number": 1,
    "global_ayah_id": 6107,
    "translation": "Бихон ба номи Парвардигорат, ки биёфарид,"
  },
  {
    "surah_id": 96,
    "ayah_number": 2,
    "global_ayah_id": 6108,
    "translation": "одамиро аз лахтаи хуне биёфарид."
  },
  {
    "surah_id": 96,
    "ayah_number": 3,
    "global_ayah_id": 6109,
    "translation": "Бихон! Ва Парвардигори ту арҷмандтарин аст."
  },
  {
    "surah_id": 96,
    "ayah_number": 4,
    "global_ayah_id": 6110,
    "translation": "Худое, ки ба воситаи қалам омӯзиш дод,"
  },
  {
    "surah_id": 96,
    "ayah_number": 5,
    "global_ayah_id": 6111,
    "translation": "ба одами он чиро, ки намедонист, биёмухт."
  },
  {
    "surah_id": 96,
    "ayah_number": 6,
    "global_ayah_id": 6112,
    "translation": "Ҳаққо, ки одами аз ҳад мегузарад,"
  },
  {
    "surah_id": 96,
    "ayah_number": 7,
    "global_ayah_id": 6113,
    "translation": "ҳар гоҳ ки хештанро тавонгар бинад."
  },
  {
    "surah_id": 96,
    "ayah_number": 8,
    "global_ayah_id": 6114,
    "translation": "Албатта бозгашт ба сӯи Парвардигори туст."
  },
  {
    "surah_id": 96,
    "ayah_number": 9,
    "global_ayah_id": 6115,
    "translation": "Оё дидӣ он касро, ки, манъ мекунад,"
  },
  {
    "surah_id": 96,
    "ayah_number": 10,
    "global_ayah_id": 6116,
    "translation": "бандаеро, ки намоз мехонад?"
  },
  {
    "surah_id": 96,
    "ayah_number": 11,
    "global_ayah_id": 6117,
    "translation": "Канӣ бигӯ, агар он мард бар тариқи ҳидоят бошад?"
  },
  {
    "surah_id": 96,
    "ayah_number": 12,
    "global_ayah_id": 6118,
    "translation": "Ё ба парҳезгорӣ фармон диҳад?"
  },
  {
    "surah_id": 96,
    "ayah_number": 13,
    "global_ayah_id": 6119,
    "translation": "Канӣ бигӯ, агар дурӯғ барорад ва рӯйгардон шавад?"
  },
  {
    "surah_id": 96,
    "ayah_number": 14,
    "global_ayah_id": 6120,
    "translation": "Оё надонистааст, ки Худо мебинад?"
  },
  {
    "surah_id": 96,
    "ayah_number": 15,
    "global_ayah_id": 6121,
    "translation": "Ҳаққо, ки агар бознаистад, аз мӯи пеши сараш мегирему мекашем,"
  },
  {
    "surah_id": 96,
    "ayah_number": 16,
    "global_ayah_id": 6122,
    "translation": "мӯи пеши сари дурӯғгӯи хатокорро."
  },
  {
    "surah_id": 96,
    "ayah_number": 17,
    "global_ayah_id": 6123,
    "translation": "Пас ҳамдамони худро даъват кунад."
  },
  {
    "surah_id": 96,
    "ayah_number": 18,
    "global_ayah_id": 6124,
    "translation": "Мо низ коргузоронидӯзахро даъват мекунем!"
  },
  {
    "surah_id": 96,
    "ayah_number": 19,
    "global_ayah_id": 6125,
    "translation": "На, ҳаргиз, аз ӯ пайравӣ макун ва саҷда куну ба Худо наздик шав! (Саҷда)."
  }
]