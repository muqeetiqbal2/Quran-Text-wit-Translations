[
  {
    "surah_id": 96,
    "ayah_number": 1,
    "global_ayah_id": 6107,
    "translation": "സൃഷ്ടിച്ചവനായ നിന്‍റെ രക്ഷിതാവിന്‍റെ നാമത്തില്‍ വായിക്കുക."
  },
  {
    "surah_id": 96,
    "ayah_number": 2,
    "global_ayah_id": 6108,
    "translation": "മനുഷ്യനെ അവന്‍ ഭ്രൂണത്തില്‍ നിന്ന് സൃഷ്ടിച്ചിരിക്കുന്നു."
  },
  {
    "surah_id": 96,
    "ayah_number": 3,
    "global_ayah_id": 6109,
    "translation": "നീ വായിക്കുക നിന്‍റെ രക്ഷിതാവ് ഏറ്റവും വലിയ ഔദാര്യവാനാകുന്നു."
  },
  {
    "surah_id": 96,
    "ayah_number": 4,
    "global_ayah_id": 6110,
    "translation": "പേന കൊണ്ട് പഠിപ്പിച്ചവന്‍"
  },
  {
    "surah_id": 96,
    "ayah_number": 5,
    "global_ayah_id": 6111,
    "translation": "മനുഷ്യന് അറിയാത്തത് അവന്‍ പഠിപ്പിച്ചിരിക്കുന്നു."
  },
  {
    "surah_id": 96,
    "ayah_number": 6,
    "global_ayah_id": 6112,
    "translation": "നിസ്സംശയം മനുഷ്യന്‍ ധിക്കാരിയായി തീരുന്നു."
  },
  {
    "surah_id": 96,
    "ayah_number": 7,
    "global_ayah_id": 6113,
    "translation": "തന്നെ സ്വയം പര്യാപ്തനായി കണ്ടതിനാല്‍"
  },
  {
    "surah_id": 96,
    "ayah_number": 8,
    "global_ayah_id": 6114,
    "translation": "തീര്‍ച്ചയായും നിന്‍റെ രക്ഷിതാവിലേക്കാണ് മടക്കം."
  },
  {
    "surah_id": 96,
    "ayah_number": 9,
    "global_ayah_id": 6115,
    "translation": "വിലക്കുന്നവനെ നീ കണ്ടുവോ?"
  },
  {
    "surah_id": 96,
    "ayah_number": 10,
    "global_ayah_id": 6116,
    "translation": "ഒരു അടിയനെ, അവന്‍ നമസ്കരിച്ചാല്‍."
  },
  {
    "surah_id": 96,
    "ayah_number": 11,
    "global_ayah_id": 6117,
    "translation": "അദ്ദേഹം സന്‍മാര്‍ഗത്തിലാണെങ്കില്‍ , (ആ വിലക്കുന്നവന്‍റെ അവസ്ഥ എന്തായിരിക്കുമെന്ന്‌) നീ കണ്ടുവോ?"
  },
  {
    "surah_id": 96,
    "ayah_number": 12,
    "global_ayah_id": 6118,
    "translation": "അഥവാ അദ്ദേഹം സൂക്ഷ്മത കൈ കൊള്ളാന്‍ കല്‍പിച്ചിരിക്കുകയാണെങ്കില്‍"
  },
  {
    "surah_id": 96,
    "ayah_number": 13,
    "global_ayah_id": 6119,
    "translation": "അവന്‍ (ആ വിലക്കുന്നവന്‍) നിഷേധിച്ചു തള്ളുകയും തിരിഞ്ഞുകളയുകയും ചെയ്തിരിക്കയാണെങ്കില്‍ (അവന്‍റെ അവസ്ഥ എന്തായിരിക്കുമെന്ന്‌) നീ കണ്ടുവോ?"
  },
  {
    "surah_id": 96,
    "ayah_number": 14,
    "global_ayah_id": 6120,
    "translation": "അവന്‍ മനസ്സിലാക്കിയിട്ടില്ലേ, അല്ലാഹു കാണുന്നുണെ്ടന്ന്‌?"
  },
  {
    "surah_id": 96,
    "ayah_number": 15,
    "global_ayah_id": 6121,
    "translation": "നിസ്സംശയം. അവന്‍ വിരമിച്ചിട്ടില്ലെങ്കല്‍ നാം ആ കുടുമ പിടിച്ചു വലിക്കുക തന്നെ ചെയ്യും ."
  },
  {
    "surah_id": 96,
    "ayah_number": 16,
    "global_ayah_id": 6122,
    "translation": "കള്ളം പറയുന്ന , പാപം ചെയ്യുന്ന കുടുമ."
  },
  {
    "surah_id": 96,
    "ayah_number": 17,
    "global_ayah_id": 6123,
    "translation": "എന്നിട്ട് അവന്‍ അവന്‍റെ സഭയിലുള്ളവരെ വിളിച്ചുകൊള്ളട്ടെ."
  },
  {
    "surah_id": 96,
    "ayah_number": 18,
    "global_ayah_id": 6124,
    "translation": "നാം സബാനിയത്തിനെ (ശിക്ഷ നടപ്പാക്കുന്ന മലക്കുകളെ) വിളിച്ചുകൊള്ളാം."
  },
  {
    "surah_id": 96,
    "ayah_number": 19,
    "global_ayah_id": 6125,
    "translation": "നിസ്സംശയം; നീ അവനെ അനുസരിച്ചു പോകരുത് , നീ പ്രണമിക്കുകയും സാമീപ്യം നേടുകയും ചെയ്യുക."
  }
]