[
  {
    "surah_id": 96,
    "ayah_number": 1,
    "global_ayah_id": 6107,
    "translation": "¡Recita en el nombre de tu Señor, Que ha creado,"
  },
  {
    "surah_id": 96,
    "ayah_number": 2,
    "global_ayah_id": 6108,
    "translation": "ha creado al hombre de sangre coagulada!"
  },
  {
    "surah_id": 96,
    "ayah_number": 3,
    "global_ayah_id": 6109,
    "translation": "¡Recita! Tu Señor es el Munífico,"
  },
  {
    "surah_id": 96,
    "ayah_number": 4,
    "global_ayah_id": 6110,
    "translation": "que ha enseñado el uso del cálamo,"
  },
  {
    "surah_id": 96,
    "ayah_number": 5,
    "global_ayah_id": 6111,
    "translation": "ha enseñado al hombre lo que no sabía."
  },
  {
    "surah_id": 96,
    "ayah_number": 6,
    "global_ayah_id": 6112,
    "translation": "¡No! El hombre, en verdad, se rebela,"
  },
  {
    "surah_id": 96,
    "ayah_number": 7,
    "global_ayah_id": 6113,
    "translation": "ya que cree bastarse a sí mismo."
  },
  {
    "surah_id": 96,
    "ayah_number": 8,
    "global_ayah_id": 6114,
    "translation": "Pero todo vuelve a tu Señor."
  },
  {
    "surah_id": 96,
    "ayah_number": 9,
    "global_ayah_id": 6115,
    "translation": "¿Has visto a quien prohíbe"
  },
  {
    "surah_id": 96,
    "ayah_number": 10,
    "global_ayah_id": 6116,
    "translation": "A un siervo orar?"
  },
  {
    "surah_id": 96,
    "ayah_number": 11,
    "global_ayah_id": 6117,
    "translation": "¿Te parece que sigue la Dirección"
  },
  {
    "surah_id": 96,
    "ayah_number": 12,
    "global_ayah_id": 6118,
    "translation": "O que ordena el temor de Dios?"
  },
  {
    "surah_id": 96,
    "ayah_number": 13,
    "global_ayah_id": 6119,
    "translation": "¿No te parece que desmiente y se desvía?"
  },
  {
    "surah_id": 96,
    "ayah_number": 14,
    "global_ayah_id": 6120,
    "translation": "¿No sabe que Dios ve?"
  },
  {
    "surah_id": 96,
    "ayah_number": 15,
    "global_ayah_id": 6121,
    "translation": "¡No! Si no cesa, hemos de arrastrarle por el copete,"
  },
  {
    "surah_id": 96,
    "ayah_number": 16,
    "global_ayah_id": 6122,
    "translation": "copete que miente, que peca."
  },
  {
    "surah_id": 96,
    "ayah_number": 17,
    "global_ayah_id": 6123,
    "translation": "Y ¡que llame a sus secuaces,"
  },
  {
    "surah_id": 96,
    "ayah_number": 18,
    "global_ayah_id": 6124,
    "translation": "que Nosotros llamaremos a los que precipitan!"
  },
  {
    "surah_id": 96,
    "ayah_number": 19,
    "global_ayah_id": 6125,
    "translation": "¡No! ¡No le obedezcas, sino prostérnate y acércate!"
  }
]