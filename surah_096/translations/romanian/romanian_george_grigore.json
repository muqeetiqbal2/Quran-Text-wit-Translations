[
  {
    "surah_id": 96,
    "ayah_number": 1,
    "global_ayah_id": 6107,
    "translation": "Citeşte în numele Domnului tău ce a creat!"
  },
  {
    "surah_id": 96,
    "ayah_number": 2,
    "global_ayah_id": 6108,
    "translation": "Cel ce a creat omul dintr-un cheag de sânge."
  },
  {
    "surah_id": 96,
    "ayah_number": 3,
    "global_ayah_id": 6109,
    "translation": "Citeşte, căci Domnul tău este Mult-dăruitorul,"
  },
  {
    "surah_id": 96,
    "ayah_number": 4,
    "global_ayah_id": 6110,
    "translation": "El l-a învăţat pe om cu condeiul,"
  },
  {
    "surah_id": 96,
    "ayah_number": 5,
    "global_ayah_id": 6111,
    "translation": "l-a învăţat ceea ce nu ştia."
  },
  {
    "surah_id": 96,
    "ayah_number": 6,
    "global_ayah_id": 6112,
    "translation": "Omul, dimpotrivă, se îngâmfează"
  },
  {
    "surah_id": 96,
    "ayah_number": 7,
    "global_ayah_id": 6113,
    "translation": "îndată ce se vede bogat."
  },
  {
    "surah_id": 96,
    "ayah_number": 8,
    "global_ayah_id": 6114,
    "translation": "Tot la Domnul tău este însă întoarcerea!"
  },
  {
    "surah_id": 96,
    "ayah_number": 9,
    "global_ayah_id": 6115,
    "translation": "L-ai văzut pe cel care îl împiedica"
  },
  {
    "surah_id": 96,
    "ayah_number": 10,
    "global_ayah_id": 6116,
    "translation": "pe un rob (al lui Dumnezeu) să se roage?"
  },
  {
    "surah_id": 96,
    "ayah_number": 11,
    "global_ayah_id": 6117,
    "translation": "L-ai socotit c-ar fi pe Calea cea dreaptă,"
  },
  {
    "surah_id": 96,
    "ayah_number": 12,
    "global_ayah_id": 6118,
    "translation": "când poruncea pietate?"
  },
  {
    "surah_id": 96,
    "ayah_number": 13,
    "global_ayah_id": 6119,
    "translation": "L-ai văzut apoi hulind şi întorcând spatele?"
  },
  {
    "surah_id": 96,
    "ayah_number": 14,
    "global_ayah_id": 6120,
    "translation": "Nu ştie el oare că Dumnezeu este Atoatevăzător?"
  },
  {
    "surah_id": 96,
    "ayah_number": 15,
    "global_ayah_id": 6121,
    "translation": "Ba nu! Dacă nu încetează, îl vom scutura de cârlionţul din frunte,"
  },
  {
    "surah_id": 96,
    "ayah_number": 16,
    "global_ayah_id": 6122,
    "translation": "cârlionţ mincinos şi păcătos."
  },
  {
    "surah_id": 96,
    "ayah_number": 17,
    "global_ayah_id": 6123,
    "translation": "Să-şi cheme obştea lui!"
  },
  {
    "surah_id": 96,
    "ayah_number": 18,
    "global_ayah_id": 6124,
    "translation": "Noi vom chema îngerii-păzitorii!"
  },
  {
    "surah_id": 96,
    "ayah_number": 19,
    "global_ayah_id": 6125,
    "translation": "Nu! Nu-i da ascultare! Ci prosternează-te şi apropie-te (de Dumnezeu)!"
  }
]