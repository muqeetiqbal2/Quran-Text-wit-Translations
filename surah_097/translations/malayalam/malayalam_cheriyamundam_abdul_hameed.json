[
  {
    "surah_id": 97,
    "ayah_number": 1,
    "global_ayah_id": 6126,
    "translation": "തീര്‍ച്ചയായും നാം ഇതിനെ (ഖുര്‍ആനിനെ) നിര്‍ണയത്തിന്‍റെ രാത്രിയില്‍ അവതരിപ്പിച്ചിരിക്കുന്നു."
  },
  {
    "surah_id": 97,
    "ayah_number": 2,
    "global_ayah_id": 6127,
    "translation": "നിര്‍ണയത്തിന്‍റെ രാത്രി എന്നാല്‍ എന്താണെന്ന് നിനക്കറിയാമോ?"
  },
  {
    "surah_id": 97,
    "ayah_number": 3,
    "global_ayah_id": 6128,
    "translation": "നിര്‍ണയത്തിന്‍റെ രാത്രി ആയിരം മാസത്തെക്കാള്‍ ഉത്തമമാകുന്നു."
  },
  {
    "surah_id": 97,
    "ayah_number": 4,
    "global_ayah_id": 6129,
    "translation": "മലക്കുകളും ആത്മാവും അവരുടെ രക്ഷിതാവിന്‍റെ എല്ലാകാര്യത്തെ സംബന്ധിച്ചുമുള്ള ഉത്തരവുമായി ആ രാത്രിയില്‍ ഇറങ്ങി വരുന്നു."
  },
  {
    "surah_id": 97,
    "ayah_number": 5,
    "global_ayah_id": 6130,
    "translation": "പ്രഭാതോദയം വരെ അത് സമാധാനമത്രെ."
  }
]