[
  {
    "surah_id": 86,
    "ayah_number": 1,
    "global_ayah_id": 5932,
    "translation": "Күк белән һәм Тарыйк белән ант итәм."
  },
  {
    "surah_id": 86,
    "ayah_number": 2,
    "global_ayah_id": 5933,
    "translation": "Ул Тарыйкның нинди икәнен сиңа нәрсә белдерде?"
  },
  {
    "surah_id": 86,
    "ayah_number": 3,
    "global_ayah_id": 5934,
    "translation": "Ул Тарыйк раушән ялтыраучы йолдыздыр."
  },
  {
    "surah_id": 86,
    "ayah_number": 4,
    "global_ayah_id": 5935,
    "translation": "Юктыр һичбер кеше, мәгәр һәрбер кеше янында аның барча эшен язучы фәрештә бардыр."
  },
  {
    "surah_id": 86,
    "ayah_number": 5,
    "global_ayah_id": 5936,
    "translation": "Адәм баласы үзенә карасын нәрсәдән халык кылынды?"
  },
  {
    "surah_id": 86,
    "ayah_number": 6,
    "global_ayah_id": 5937,
    "translation": "Халык кылынды ятакка коелган судан."
  },
  {
    "surah_id": 86,
    "ayah_number": 7,
    "global_ayah_id": 5938,
    "translation": "Ул су чыгадыр ирнең арка сөякләре арасыннан вә хатынның күкрәк сөякләре арасыннан."
  },
  {
    "surah_id": 86,
    "ayah_number": 8,
    "global_ayah_id": 5939,
    "translation": "Ул – Аллаһ үлгән кешене тергезергә, әлбәттә, кадирдер."
  },
  {
    "surah_id": 86,
    "ayah_number": 9,
    "global_ayah_id": 5940,
    "translation": "Яшерен эшләр ачылган көндә,"
  },
  {
    "surah_id": 86,
    "ayah_number": 10,
    "global_ayah_id": 5941,
    "translation": "кешенең Аллаһ ґәзабыннан качарга куәте булмас һәм ярдәмчесе дә булмас."
  },
  {
    "surah_id": 86,
    "ayah_number": 11,
    "global_ayah_id": 5942,
    "translation": "Яңгыр иясе булган күк илә."
  },
  {
    "surah_id": 86,
    "ayah_number": 12,
    "global_ayah_id": 5943,
    "translation": "Вә үләннәр иясе булган җир белән ант итәм."
  },
  {
    "surah_id": 86,
    "ayah_number": 13,
    "global_ayah_id": 5944,
    "translation": "Тәхкыйк ул Коръән сүзе хакны батылдан аеручы хак сүздер."
  },
  {
    "surah_id": 86,
    "ayah_number": 14,
    "global_ayah_id": 5945,
    "translation": "Ул – Коръән уен вә батыл сүз түгелдер."
  },
  {
    "surah_id": 86,
    "ayah_number": 15,
    "global_ayah_id": 5946,
    "translation": "Тәхкыйк ул кәферләр Коръән сүзләрен юкка чыгарырга хәйлә төзиләр."
  },
  {
    "surah_id": 86,
    "ayah_number": 16,
    "global_ayah_id": 5947,
    "translation": "Вә аларны ґәзаб кылу өчен Мин чын хәйлә төзимен."
  },
  {
    "surah_id": 86,
    "ayah_number": 17,
    "global_ayah_id": 5948,
    "translation": "Кәферләргә вакыт бир, азганлыкларында йөрсеннәр аларга бик аз гына вакыт бит!"
  }
]