[
  {
    "surah_id": 86,
    "ayah_number": 1,
    "global_ayah_id": 5932,
    "translation": "Клянусь небом и ночным путником!"
  },
  {
    "surah_id": 86,
    "ayah_number": 2,
    "global_ayah_id": 5933,
    "translation": "Откуда ты мог знать, что такое ночной путник?"
  },
  {
    "surah_id": 86,
    "ayah_number": 3,
    "global_ayah_id": 5934,
    "translation": "Это - звезда пронизывающая небеса своим светом."
  },
  {
    "surah_id": 86,
    "ayah_number": 4,
    "global_ayah_id": 5935,
    "translation": "Нет души, при которой не было бы хранителя."
  },
  {
    "surah_id": 86,
    "ayah_number": 5,
    "global_ayah_id": 5936,
    "translation": "Пусть посмотрит человек, из чего он создан."
  },
  {
    "surah_id": 86,
    "ayah_number": 6,
    "global_ayah_id": 5937,
    "translation": "Он создан из изливающейся жидкости,"
  },
  {
    "surah_id": 86,
    "ayah_number": 7,
    "global_ayah_id": 5938,
    "translation": "которая выходит между чреслами и грудными костями."
  },
  {
    "surah_id": 86,
    "ayah_number": 8,
    "global_ayah_id": 5939,
    "translation": "Воистину, Он способен вернуть его."
  },
  {
    "surah_id": 86,
    "ayah_number": 9,
    "global_ayah_id": 5940,
    "translation": "В тот день будут испытаны (или раскроются) тайны,"
  },
  {
    "surah_id": 86,
    "ayah_number": 10,
    "global_ayah_id": 5941,
    "translation": "и тогда не будет у него ни силы, ни помощника."
  },
  {
    "surah_id": 86,
    "ayah_number": 11,
    "global_ayah_id": 5942,
    "translation": "Клянусь небом возвращающим (возвращающим воду земле или возвращающим небесные тела, которые восходят с одной стороны и заходят в другой)!"
  },
  {
    "surah_id": 86,
    "ayah_number": 12,
    "global_ayah_id": 5943,
    "translation": "Клянусь землей раскалываемой (при прорастании растений, или при выходе из земли воды, или при воскрешении мертвых)!"
  },
  {
    "surah_id": 86,
    "ayah_number": 13,
    "global_ayah_id": 5944,
    "translation": "Воистину, это - Слово различающее,"
  },
  {
    "surah_id": 86,
    "ayah_number": 14,
    "global_ayah_id": 5945,
    "translation": "а не шутка."
  },
  {
    "surah_id": 86,
    "ayah_number": 15,
    "global_ayah_id": 5946,
    "translation": "Они замышляют козни,"
  },
  {
    "surah_id": 86,
    "ayah_number": 16,
    "global_ayah_id": 5947,
    "translation": "и Я замышляю козни."
  },
  {
    "surah_id": 86,
    "ayah_number": 17,
    "global_ayah_id": 5948,
    "translation": "Предоставь же неверующим отсрочку, помедли с ними недолго!"
  }
]