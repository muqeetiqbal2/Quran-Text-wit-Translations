    "translation": "اللہ کے «<a href=614> نام </a>» سے «<a href=416> شروع </a>» جو بڑا «<a href=600> مہربان </a>» نہایت رحم فرمانے والا ہے"
  },
  {
    "surah_id": 86,
    "ayah_number": 1,
    "global_ayah_id": 6017,
    "translation": "قسم ہے «<a href=10> آسمان </a>» کی اور «<a href=356> رات </a>» کو آنے والے کی۔"
  },
  {
    "surah_id": 86,
    "ayah_number": 2,
    "global_ayah_id": 6018,
    "translation": "اور آپ کو کیا معلوم کہ «<a href=356> رات </a>» کو آنے والا کیا ہے؟"
  },
  {
    "surah_id": 86,
    "ayah_number": 3,
    "global_ayah_id": 6019,
    "translation": "۔(وہ) چمکتا «<a href=654> ہوا </a>» ستارہ ہے۔"
  },
  {
    "surah_id": 86,
    "ayah_number": 4,
    "global_ayah_id": 6020,
    "translation": "کوئی شخص ایسا نہیں جس پر کوئی محافظ نہ ہو۔"
  },
  {
    "surah_id": 86,
    "ayah_number": 5,
    "global_ayah_id": 6021,
    "translation": "لہٰذا «<a href=3> انسان </a>» کو «<a href=451> غور </a>» کرنا چاہئے (کہ) وہ کس چیز سے «<a href=180> پیدا </a>» کیا گیا ہے؟"
  },
  {
    "surah_id": 86,
    "ayah_number": 6,
    "global_ayah_id": 6022,
    "translation": "وہ ایک اُچھلتے ہوئے «<a href=144> پانی </a>» سے «<a href=180> پیدا </a>» کیا گیا ہے۔"
  },
  {
    "surah_id": 86,
    "ayah_number": 7,
    "global_ayah_id": 6023,
    "translation": "جو نکلتا ہے پیٹھ اور سینے (کی ہڈیوں) کے «<a href=321> درمیان </a>» سے۔"
  },
  {
    "surah_id": 86,
    "ayah_number": 8,
    "global_ayah_id": 6024,
    "translation": "بےشک (اللہ) اسے لوٹا دینے پر ضرور قادر ہے۔"
  },
  {
    "surah_id": 86,
    "ayah_number": 9,
    "global_ayah_id": 6025,
    "translation": "جس «<a href=326> دن </a>» سب راز «<a href=435> ظاہر </a>» کر دیئے جائیں گے۔"
  },
  {
    "surah_id": 86,
    "ayah_number": 10,
    "global_ayah_id": 6026,
    "translation": "پھر (اس وقت) اس (انسان) کے «<a href=141> پاس </a>» نہ کوئی «<a href=475> قوت </a>» ہوگی اور نہ کوئی مددگار۔"
  },
  {
    "surah_id": 86,
    "ayah_number": 11,
    "global_ayah_id": 6027,
    "translation": "قسم ہے «<a href=10> آسمان </a>» کی جو بار بار «<a href=75> بارش </a>» لانے والا ہے۔"
  },
  {
    "surah_id": 86,
    "ayah_number": 12,
    "global_ayah_id": 6028,
    "translation": "قسم ہے «<a href=379> زمین </a>» کی جو پھٹنے والی ہے۔"
  },
  {
    "surah_id": 86,
    "ayah_number": 13,
    "global_ayah_id": 6029,
    "translation": "بےشک یہ (قرآن) ضرور ایک «<a href=461> فیصلہ </a>» کن کلام ہے۔"
  },
  {
    "surah_id": 86,
    "ayah_number": 14,
    "global_ayah_id": 6030,
    "translation": "اور یہ ہنسی «<a href=579> مذاق </a>» نہیں ہے۔"
  },
  {
    "surah_id": 86,
    "ayah_number": 15,
    "global_ayah_id": 6031,
    "translation": "بےشک وہ (کافر) چال چل رہے ہیں۔"
  },
  {
    "surah_id": 86,
    "ayah_number": 16,
    "global_ayah_id": 6032,
    "translation": "اور میں بھی ایک خفیہ تدبیرکررہا ہوں۔"
  },
  {
    "surah_id": 86,
    "ayah_number": 17,
    "global_ayah_id": 6033,
    "translation": "تو آپ (صلی اللہ علیہ وآلہ وسلم) کافروں کو «<a href=602> مہلت </a>» دیجئے تھوڑی سی مہلت۔"
  }
]