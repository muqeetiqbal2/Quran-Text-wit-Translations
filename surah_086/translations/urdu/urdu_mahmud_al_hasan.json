[
  {
    "surah_id": 86,
    "ayah_number": 0,
    "global_ayah_id": 6016,
    "translation": "اللہ کے نام سے جو رحمان و رحیم ہے"
  },
  {
    "surah_id": 86,
    "ayah_number": 1,
    "global_ayah_id": 6017,
    "translation": "قسم ہے آسمان کی اور اندھیری میں آنے والے کی"
  },
  {
    "surah_id": 86,
    "ayah_number": 2,
    "global_ayah_id": 6018,
    "translation": "اور تو نے کیا سمجھاکیا ہے اندھیرے میں آنے والا"
  },
  {
    "surah_id": 86,
    "ayah_number": 3,
    "global_ayah_id": 6019,
    "translation": "وہ تارا چمکتا ہوا"
  },
  {
    "surah_id": 86,
    "ayah_number": 4,
    "global_ayah_id": 6020,
    "translation": "کوئی جی نہیں جس پر نہیں ایک نگہبان"
  },
  {
    "surah_id": 86,
    "ayah_number": 5,
    "global_ayah_id": 6021,
    "translation": "اب دیکھ لے آدمی کہ کاہے سے بنا ہے"
  },
  {
    "surah_id": 86,
    "ayah_number": 6,
    "global_ayah_id": 6022,
    "translation": "بنا ہے ایک اچھلتے ہوئے پانی سے"
  },
  {
    "surah_id": 86,
    "ayah_number": 7,
    "global_ayah_id": 6023,
    "translation": "جو نکلتا ہے پیٹھ کے بیچ سے اور چھاتی کے بیچ سے"
  },
  {
    "surah_id": 86,
    "ayah_number": 8,
    "global_ayah_id": 6024,
    "translation": "بیشک وہ اُسکو پھیر لا سکتا ہے"
  },
  {
    "surah_id": 86,
    "ayah_number": 9,
    "global_ayah_id": 6025,
    "translation": "جس دن جانچے جائیں بھید"
  },
  {
    "surah_id": 86,
    "ayah_number": 10,
    "global_ayah_id": 6026,
    "translation": "تو کچھ نہ ہو گا اُسکو زور اور نہ کوئی مدد کرنے والا"
  },
  {
    "surah_id": 86,
    "ayah_number": 11,
    "global_ayah_id": 6027,
    "translation": "قسم ہے آسمان چکر مارنے والے کی"
  },
  {
    "surah_id": 86,
    "ayah_number": 12,
    "global_ayah_id": 6028,
    "translation": "اور زمین پھوٹ نکلنے والی کی"
  },
  {
    "surah_id": 86,
    "ayah_number": 13,
    "global_ayah_id": 6029,
    "translation": "بیشک یہ بات ہے دوٹوک"
  },
  {
    "surah_id": 86,
    "ayah_number": 14,
    "global_ayah_id": 6030,
    "translation": "اور نہیں یہ بات ہنسی کی"
  },
  {
    "surah_id": 86,
    "ayah_number": 15,
    "global_ayah_id": 6031,
    "translation": "البتہ وہ لگے ہوئے ہیں ایک داؤ کرنے میں"
  },
  {
    "surah_id": 86,
    "ayah_number": 16,
    "global_ayah_id": 6032,
    "translation": "اور میں لگا ہوا ہوں ایک داؤ کرنے میں"
  },
  {
    "surah_id": 86,
    "ayah_number": 17,
    "global_ayah_id": 6033,
    "translation": "سو ڈھیل دے منکروں کو ڈھیل دے اُنکو تھوڑے دنوں"
  }
]