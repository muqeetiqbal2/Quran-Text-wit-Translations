[
  {
    "surah_id": 86,
    "ayah_number": 0,
    "global_ayah_id": 6016,
    "translation": "In the name of God, the Most Gracious, the Most Merciful"
  },
  {
    "surah_id": 86,
    "ayah_number": 1,
    "global_ayah_id": 6017,
    "translation": "1 By the heavens and that which comes in the night—"
  },
  {
    "surah_id": 86,
    "ayah_number": 2,
    "global_ayah_id": 6018,
    "translation": "2 and what could make you know what it is that comes in the night?"
  },
  {
    "surah_id": 86,
    "ayah_number": 3,
    "global_ayah_id": 6019,
    "translation": "3 It is the shining star—"
  },
  {
    "surah_id": 86,
    "ayah_number": 4,
    "global_ayah_id": 6020,
    "translation": "4 [for] no human being has been left unguarded."
  },
  {
    "surah_id": 86,
    "ayah_number": 5,
    "global_ayah_id": 6021,
    "translation": "5 Let man reflect on what he was created from."
  },
  {
    "surah_id": 86,
    "ayah_number": 6,
    "global_ayah_id": 6022,
    "translation": "6 He was created from spurting fluid,"
  },
  {
    "surah_id": 86,
    "ayah_number": 7,
    "global_ayah_id": 6023,
    "translation": "7 issuing from between the backbone and the breastbone:"
  },
  {
    "surah_id": 86,
    "ayah_number": 8,
    "global_ayah_id": 6024,
    "translation": "8 He certainly has the power to bring him back to life."
  },
  {
    "surah_id": 86,
    "ayah_number": 9,
    "global_ayah_id": 6025,
    "translation": "9 On the Day when secrets are disclosed,"
  },
  {
    "surah_id": 86,
    "ayah_number": 10,
    "global_ayah_id": 6026,
    "translation": "10 [man] will have no power, and no helper."
  },
  {
    "surah_id": 86,
    "ayah_number": 11,
    "global_ayah_id": 6027,
    "translation": "11 By the heavens, ever-revolving,"
  },
  {
    "surah_id": 86,
    "ayah_number": 12,
    "global_ayah_id": 6028,
    "translation": "12 by the earth cracking open with new growth."
  },
  {
    "surah_id": 86,
    "ayah_number": 13,
    "global_ayah_id": 6029,
    "translation": "13 It is surely a decisive utterance"
  },
  {
    "surah_id": 86,
    "ayah_number": 14,
    "global_ayah_id": 6030,
    "translation": "14 and is not to be taken lightly."
  },
  {
    "surah_id": 86,
    "ayah_number": 15,
    "global_ayah_id": 6031,
    "translation": "15 They are planning a scheme,"
  },
  {
    "surah_id": 86,
    "ayah_number": 16,
    "global_ayah_id": 6032,
    "translation": "16 and so am I:"
  },
  {
    "surah_id": 86,
    "ayah_number": 17,
    "global_ayah_id": 6033,
    "translation": "17 so bear with those who deny the truth, and let them be for a little while."
  }
]