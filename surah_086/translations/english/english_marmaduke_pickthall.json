[
  {
    "surah_id": 86,
    "ayah_number": 1,
    "global_ayah_id": 5932,
    "translation": "By the heaven and the Morning Star"
  },
  {
    "surah_id": 86,
    "ayah_number": 2,
    "global_ayah_id": 5933,
    "translation": "- Ah, what will tell thee what the Morning Star is!"
  },
  {
    "surah_id": 86,
    "ayah_number": 3,
    "global_ayah_id": 5934,
    "translation": "- The piercing Star!"
  },
  {
    "surah_id": 86,
    "ayah_number": 4,
    "global_ayah_id": 5935,
    "translation": "No human soul but hath a guardian over it."
  },
  {
    "surah_id": 86,
    "ayah_number": 5,
    "global_ayah_id": 5936,
    "translation": "So let man consider from what he is created."
  },
  {
    "surah_id": 86,
    "ayah_number": 6,
    "global_ayah_id": 5937,
    "translation": "He is created from a gushing fluid"
  },
  {
    "surah_id": 86,
    "ayah_number": 7,
    "global_ayah_id": 5938,
    "translation": "That issued from between the loins and ribs."
  },
  {
    "surah_id": 86,
    "ayah_number": 8,
    "global_ayah_id": 5939,
    "translation": "Lo! He verily is Able to return him (unto life)"
  },
  {
    "surah_id": 86,
    "ayah_number": 9,
    "global_ayah_id": 5940,
    "translation": "On the day when hidden thoughts shall be searched out."
  },
  {
    "surah_id": 86,
    "ayah_number": 10,
    "global_ayah_id": 5941,
    "translation": "Then will he have no might nor any helper."
  },
  {
    "surah_id": 86,
    "ayah_number": 11,
    "global_ayah_id": 5942,
    "translation": "By the heaven which giveth the returning rain,"
  },
  {
    "surah_id": 86,
    "ayah_number": 12,
    "global_ayah_id": 5943,
    "translation": "And the earth which splitteth (with the growth of trees and plants)"
  },
  {
    "surah_id": 86,
    "ayah_number": 13,
    "global_ayah_id": 5944,
    "translation": "Lo! this (Qur'an) is a conclusive word,"
  },
  {
    "surah_id": 86,
    "ayah_number": 14,
    "global_ayah_id": 5945,
    "translation": "It is no pleasantry."
  },
  {
    "surah_id": 86,
    "ayah_number": 15,
    "global_ayah_id": 5946,
    "translation": "Lo! they plot a plot (against thee, O Muhammad)"
  },
  {
    "surah_id": 86,
    "ayah_number": 16,
    "global_ayah_id": 5947,
    "translation": "And I plot a plot (against them)."
  },
  {
    "surah_id": 86,
    "ayah_number": 17,
    "global_ayah_id": 5948,
    "translation": "So give a respite to the disbelievers. Deal thou gently with them for a while."
  }
]