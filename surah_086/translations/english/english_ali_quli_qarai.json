[
  {
    "surah_id": 86,
    "ayah_number": 1,
    "global_ayah_id": 5932,
    "translation": "By the heaven, and by the nightly visitor"
  },
  {
    "surah_id": 86,
    "ayah_number": 2,
    "global_ayah_id": 5933,
    "translation": "(and what will show you what is the nightly visitor?"
  },
  {
    "surah_id": 86,
    "ayah_number": 3,
    "global_ayah_id": 5934,
    "translation": "It is the brilliant star):"
  },
  {
    "surah_id": 86,
    "ayah_number": 4,
    "global_ayah_id": 5935,
    "translation": "there is a guard over every soul."
  },
  {
    "surah_id": 86,
    "ayah_number": 5,
    "global_ayah_id": 5936,
    "translation": "So let man consider from what he was created."
  },
  {
    "surah_id": 86,
    "ayah_number": 6,
    "global_ayah_id": 5937,
    "translation": "He was created from an effusing fluid"
  },
  {
    "surah_id": 86,
    "ayah_number": 7,
    "global_ayah_id": 5938,
    "translation": "which issues from between the loins and the breast-bones."
  },
  {
    "surah_id": 86,
    "ayah_number": 8,
    "global_ayah_id": 5939,
    "translation": "Indeed He is able to bring him back [after death],"
  },
  {
    "surah_id": 86,
    "ayah_number": 9,
    "global_ayah_id": 5940,
    "translation": "on the day when the secrets are examined"
  },
  {
    "surah_id": 86,
    "ayah_number": 10,
    "global_ayah_id": 5941,
    "translation": "and he shall have neither power nor helper."
  },
  {
    "surah_id": 86,
    "ayah_number": 11,
    "global_ayah_id": 5942,
    "translation": "By the resurgent heaven,"
  },
  {
    "surah_id": 86,
    "ayah_number": 12,
    "global_ayah_id": 5943,
    "translation": "and by the furrowed earth:"
  },
  {
    "surah_id": 86,
    "ayah_number": 13,
    "global_ayah_id": 5944,
    "translation": "it is indeed a conclusive discourse,"
  },
  {
    "surah_id": 86,
    "ayah_number": 14,
    "global_ayah_id": 5945,
    "translation": "and not a jest."
  },
  {
    "surah_id": 86,
    "ayah_number": 15,
    "global_ayah_id": 5946,
    "translation": "Indeed they are devising a stratagem,"
  },
  {
    "surah_id": 86,
    "ayah_number": 16,
    "global_ayah_id": 5947,
    "translation": "and I [too] am devising a plan."
  },
  {
    "surah_id": 86,
    "ayah_number": 17,
    "global_ayah_id": 5948,
    "translation": "So respite the faithless; give them a gentle respite."
  }
]