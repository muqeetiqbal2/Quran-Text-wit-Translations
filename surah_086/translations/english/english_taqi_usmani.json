[
  {
    "surah_id": 86,
    "ayah_number": 0,
    "global_ayah_id": 6016,
    "translation": "In the name of Allah, the Most Gracious, the Most Merciful."
  },
  {
    "surah_id": 86,
    "ayah_number": 1,
    "global_ayah_id": 6017,
    "translation": "I swear by the sky and by the Night-Comer,-"
  },
  {
    "surah_id": 86,
    "ayah_number": 2,
    "global_ayah_id": 6018,
    "translation": "-and what may let you know what the Night-Comer is?"
  },
  {
    "surah_id": 86,
    "ayah_number": 3,
    "global_ayah_id": 6019,
    "translation": "The star of piercing brightness!- -"
  },
  {
    "surah_id": 86,
    "ayah_number": 4,
    "global_ayah_id": 6020,
    "translation": "-there is no human being, but there is a watcher over him."
  },
  {
    "surah_id": 86,
    "ayah_number": 5,
    "global_ayah_id": 6021,
    "translation": "So, let man consider of which stuff he is created."
  },
  {
    "surah_id": 86,
    "ayah_number": 6,
    "global_ayah_id": 6022,
    "translation": "He is created of spouting water"
  },
  {
    "surah_id": 86,
    "ayah_number": 7,
    "global_ayah_id": 6023,
    "translation": "that comes out from between the loins and the chest-bones."
  },
  {
    "surah_id": 86,
    "ayah_number": 8,
    "global_ayah_id": 6024,
    "translation": "Surely He is Powerful to bring him back"
  },
  {
    "surah_id": 86,
    "ayah_number": 9,
    "global_ayah_id": 6025,
    "translation": "on a day when all the secrets will be searched out,"
  },
  {
    "surah_id": 86,
    "ayah_number": 10,
    "global_ayah_id": 6026,
    "translation": "and he will have neither strength (to defend), nor a supporter."
  },
  {
    "surah_id": 86,
    "ayah_number": 11,
    "global_ayah_id": 6027,
    "translation": "I swear by the sky that rains,"
  },
  {
    "surah_id": 86,
    "ayah_number": 12,
    "global_ayah_id": 6028,
    "translation": "and the earth that cracks open (for plants),"
  },
  {
    "surah_id": 86,
    "ayah_number": 13,
    "global_ayah_id": 6029,
    "translation": "this is a decisive word,"
  },
  {
    "surah_id": 86,
    "ayah_number": 14,
    "global_ayah_id": 6030,
    "translation": "and it is not a joke."
  },
  {
    "surah_id": 86,
    "ayah_number": 15,
    "global_ayah_id": 6031,
    "translation": "They are devising plans,"
  },
  {
    "surah_id": 86,
    "ayah_number": 16,
    "global_ayah_id": 6032,
    "translation": "and I Am devising plans."
  },
  {
    "surah_id": 86,
    "ayah_number": 17,
    "global_ayah_id": 6033,
    "translation": "So leave the disbelievers alone at the moment; give them respite for a while."
  }
]