[
  {
    "surah_id": 86,
    "ayah_number": 1,
    "global_ayah_id": 5932,
    "translation": "By the heavens and al-tariq."
  },
  {
    "surah_id": 86,
    "ayah_number": 2,
    "global_ayah_id": 5933,
    "translation": "Do you know what al-tariq is?"
  },
  {
    "surah_id": 86,
    "ayah_number": 3,
    "global_ayah_id": 5934,
    "translation": "(It is a nightly radiant star)."
  },
  {
    "surah_id": 86,
    "ayah_number": 4,
    "global_ayah_id": 5935,
    "translation": "There is no soul which is not guarded (by the two angels who record all of its deeds)."
  },
  {
    "surah_id": 86,
    "ayah_number": 5,
    "global_ayah_id": 5936,
    "translation": "Let the human being reflect that from what he has been created."
  },
  {
    "surah_id": 86,
    "ayah_number": 6,
    "global_ayah_id": 5937,
    "translation": "He has been created from an ejected drop of fluid"
  },
  {
    "surah_id": 86,
    "ayah_number": 7,
    "global_ayah_id": 5938,
    "translation": "which comes out of the loins and ribs."
  },
  {
    "surah_id": 86,
    "ayah_number": 8,
    "global_ayah_id": 5939,
    "translation": "God has all power to resurrect him."
  },
  {
    "surah_id": 86,
    "ayah_number": 9,
    "global_ayah_id": 5940,
    "translation": "On the day when all secrets will be made public,"
  },
  {
    "surah_id": 86,
    "ayah_number": 10,
    "global_ayah_id": 5941,
    "translation": "he will have no power, nor anyone to help him."
  },
  {
    "surah_id": 86,
    "ayah_number": 11,
    "global_ayah_id": 5942,
    "translation": "By the rotating heavens"
  },
  {
    "surah_id": 86,
    "ayah_number": 12,
    "global_ayah_id": 5943,
    "translation": "and the replenishing earth,"
  },
  {
    "surah_id": 86,
    "ayah_number": 13,
    "global_ayah_id": 5944,
    "translation": "the Quran is the final word,"
  },
  {
    "surah_id": 86,
    "ayah_number": 14,
    "global_ayah_id": 5945,
    "translation": "and it is certainly not a jest."
  },
  {
    "surah_id": 86,
    "ayah_number": 15,
    "global_ayah_id": 5946,
    "translation": "They (disbelievers) plot every evil plan,"
  },
  {
    "surah_id": 86,
    "ayah_number": 16,
    "global_ayah_id": 5947,
    "translation": "but I too plan against them."
  },
  {
    "surah_id": 86,
    "ayah_number": 17,
    "global_ayah_id": 5948,
    "translation": "Give respite to the disbelievers and leave them alone for a while."
  }
]