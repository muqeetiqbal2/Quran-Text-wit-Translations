[
  {
    "surah_id": 86,
    "ayah_number": 1,
    "global_ayah_id": 5932,
    "translation": "하늘과 샛별을 두고 맹세하사"
  },
  {
    "surah_id": 86,
    "ayah_number": 2,
    "global_ayah_id": 5933,
    "translation": "샛별이 무엇인지 무엇이 그대 에게 설명하여 주리요"
  },
  {
    "surah_id": 86,
    "ayah_number": 3,
    "global_ayah_id": 5934,
    "translation": "그것은 빛나는 별이라"
  },
  {
    "surah_id": 86,
    "ayah_number": 4,
    "global_ayah_id": 5935,
    "translation": "모든 인간에게는 그를 감시하 는 자가 있나니"
  },
  {
    "surah_id": 86,
    "ayah_number": 5,
    "global_ayah_id": 5936,
    "translation": "그가 무엇으로부터 창조되었 는지 생각케 하라"
  },
  {
    "surah_id": 86,
    "ayah_number": 6,
    "global_ayah_id": 5937,
    "translation": "떨어지는 한 방울의 정액으로 창조되며"
  },
  {
    "surah_id": 86,
    "ayah_number": 7,
    "global_ayah_id": 5938,
    "translation": "그 정액은 등뼈와 늑골 사이 에서 나오는 것이라"
  },
  {
    "surah_id": 86,
    "ayah_number": 8,
    "global_ayah_id": 5939,
    "translation": "이렇듯 하나님은 그 인간을 부활케 하실 수 있으시며"
  },
  {
    "surah_id": 86,
    "ayah_number": 9,
    "global_ayah_id": 5940,
    "translation": "숨겨진 모든 것들이 명백하 게 드러나는 그날"
  },
  {
    "surah_id": 86,
    "ayah_number": 10,
    "global_ayah_id": 5941,
    "translation": "인간은 아무런 힘도 그리고구원자도 없노라"
  },
  {
    "surah_id": 86,
    "ayah_number": 11,
    "global_ayah_id": 5942,
    "translation": "비를 보내는 하늘을 두고 맹세하사"
  },
  {
    "surah_id": 86,
    "ayah_number": 12,
    "global_ayah_id": 5943,
    "translation": "식물을 싹트게 하는 대지를두고 맹세하나니"
  },
  {
    "surah_id": 86,
    "ayah_number": 13,
    "global_ayah_id": 5944,
    "translation": "실로 이것은 선악을 구별하는 말씀으로"
  },
  {
    "surah_id": 86,
    "ayah_number": 14,
    "global_ayah_id": 5945,
    "translation": "농담을 위한 것이 아니라"
  },
  {
    "surah_id": 86,
    "ayah_number": 15,
    "global_ayah_id": 5946,
    "translation": "음모하는 그들에게"
  },
  {
    "surah_id": 86,
    "ayah_number": 16,
    "global_ayah_id": 5947,
    "translation": "내가 방책을 세위 두었으니"
  },
  {
    "surah_id": 86,
    "ayah_number": 17,
    "global_ayah_id": 5948,
    "translation": "잠시 불신자들을 그대로 두라 얼마후에 그들을 벌하리라"
  }
]