  },
  {
    "surah_id": 86,
    "ayah_number": 15,
    "global_ayah_id": 5946,
    "translation": "बेशक ये कुफ्फ़ार अपनी तदबीर कर रहे हैं"
  },
  {
    "surah_id": 86,
    "ayah_number": 16,
    "global_ayah_id": 5947,
    "translation": "और मैं अपनी तद्बीर कर रहा हूँ"
  },
  {
    "surah_id": 86,
    "ayah_number": 17,
    "global_ayah_id": 5948,
    "translation": "तो काफ़िरों को मोहलत दो बस उनको थोड़ी सी मोहलत दो"
  }
