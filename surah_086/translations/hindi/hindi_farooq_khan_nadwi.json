    "global_ayah_id": 5932,
    "translation": "आसमान और रात को आने वाले की क़सम"
  },
  {
    "surah_id": 86,
    "ayah_number": 2,
    "global_ayah_id": 5933,
    "translation": "और तुमको क्या मालूम रात को आने वाला क्या है"
  },
  {
    "surah_id": 86,
    "ayah_number": 3,
    "global_ayah_id": 5934,
