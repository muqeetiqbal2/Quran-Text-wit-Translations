[
  {
    "surah_id": 86,
    "ayah_number": 0,
    "global_ayah_id": 6016,
    "translation": "अल्लाह के नाम से जो बड़ा कृपालु और अत्यन्त दयावान है।"
  },
  {
    "surah_id": 86,
    "ayah_number": 1,
    "global_ayah_id": 6017,
    "translation": "साक्षी है आकाश, और रात में प्रकट होने वाला -"
  },
  {
    "surah_id": 86,
    "ayah_number": 2,
    "global_ayah_id": 6018,
    "translation": "और तुम क्या जानो कि रात में प्रकट होने वाला क्या है?"
  },
  {
    "surah_id": 86,
    "ayah_number": 3,
    "global_ayah_id": 6019,
    "translation": "दमकता हुआ तारा! -"
  },
  {
    "surah_id": 86,
    "ayah_number": 4,
    "global_ayah_id": 6020,
    "translation": "कि हर एक व्यक्ति पर एक निगरानी करने वाला नियुक्त है"
  },
  {
    "surah_id": 86,
    "ayah_number": 5,
    "global_ayah_id": 6021,
    "translation": "अतः मनुष्य को चाहिए कि देखे कि वह किस चीज़ से पैदा किया गया है"
  },
  {
    "surah_id": 86,
    "ayah_number": 6,
    "global_ayah_id": 6022,
    "translation": "एक उछलते पानी से पैदा किया गया है,"
  },
  {
    "surah_id": 86,
    "ayah_number": 7,
    "global_ayah_id": 6023,
    "translation": "जो पीठ और पसलियों के मध्य से निकलता है"
  },
  {
    "surah_id": 86,
    "ayah_number": 8,
    "global_ayah_id": 6024,
    "translation": "निश्चय ही वह उस के लौटा देने की सामर्थ्य रखता है"
  },
  {
    "surah_id": 86,
    "ayah_number": 9,
    "global_ayah_id": 6025,
    "translation": "जिस दिन छिपी चीज़ें परखी जाएँगी,"
  },
  {
    "surah_id": 86,
    "ayah_number": 10,
    "global_ayah_id": 6026,
    "translation": "तो उस समय उस के पास न तो अपनी कोई शक्ति होगी और न कोई सहायक"
  },
  {
    "surah_id": 86,
    "ayah_number": 11,
    "global_ayah_id": 6027,
    "translation": "साक्षी है आवर्तन (उलट-फेर) वाला आकाश,"
  },
  {
    "surah_id": 86,
    "ayah_number": 12,
    "global_ayah_id": 6028,
    "translation": "और फट जाने वाली धरती"
  },
  {
    "surah_id": 86,
    "ayah_number": 13,
    "global_ayah_id": 6029,
    "translation": "वह दो-टूक बात है,"
  },
  {
    "surah_id": 86,
    "ayah_number": 14,
    "global_ayah_id": 6030,
    "translation": "वह कोई हँसी-मज़ाक नही है"
  },
  {
    "surah_id": 86,
    "ayah_number": 15,
    "global_ayah_id": 6031,
    "translation": "वे एक चाल चल रहे हैं,"
  },
  {
    "surah_id": 86,
    "ayah_number": 16,
    "global_ayah_id": 6032,
    "translation": "और मैं भी एक चाल चल रहा हूँ"
  },
  {
    "surah_id": 86,
    "ayah_number": 17,
    "global_ayah_id": 6033,
    "translation": "अत मुहलत दे दो उन इनकार करने वालों कोमुहलत दे दो उन्हें थोड़ी-सी"
  }
]