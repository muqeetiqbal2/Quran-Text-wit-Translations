[
  {
    "surah_id": 86,
    "ayah_number": 1,
    "global_ayah_id": 5932,
    "translation": "ভাবো আকাশের ও রাতের আগন্তুকের কথা!"
  },
  {
    "surah_id": 86,
    "ayah_number": 2,
    "global_ayah_id": 5933,
    "translation": "আর কী তোমাকে বুঝতে দেবে কে সেই রাতের আগন্তুক?"
  },
  {
    "surah_id": 86,
    "ayah_number": 3,
    "global_ayah_id": 5934,
    "translation": "একটি অত্যুজ্জ্বল নক্ষত্র।"
  },
  {
    "surah_id": 86,
    "ayah_number": 4,
    "global_ayah_id": 5935,
    "translation": "প্রত্যেক সার পক্ষেই -- তার উপরে একজন তত্ত্বাবধায়ক রয়েছে।"
  },
  {
    "surah_id": 86,
    "ayah_number": 5,
    "global_ayah_id": 5936,
    "translation": "সুতরাং মানুষ ভেবে দেখুক কিসে থেকে তাকে সৃষ্টি করা হয়েছে।"
  },
  {
    "surah_id": 86,
    "ayah_number": 6,
    "global_ayah_id": 5937,
    "translation": "তাকে সৃষ্টি করা হয়েছে সবেগে-স্খলিত পানি থেকে, --"
  },
  {
    "surah_id": 86,
    "ayah_number": 7,
    "global_ayah_id": 5938,
    "translation": "যা নির্গত হয় মেরুদন্ড ও বুকের পাঁজরের মধ্য হতে।"
  },
  {
    "surah_id": 86,
    "ayah_number": 8,
    "global_ayah_id": 5939,
    "translation": "নিঃসন্দেহ তিনি তার প্রত্যাবর্তনে অবশ্যই ক্ষমতাবান।"
  },
  {
    "surah_id": 86,
    "ayah_number": 9,
    "global_ayah_id": 5940,
    "translation": "সেইদিন লুকোনো সব-কিছুকে প্রকাশ করা হবে;"
  },
  {
    "surah_id": 86,
    "ayah_number": 10,
    "global_ayah_id": 5941,
    "translation": "তখন তার থাকবে না কোনো ক্ষমতা ও না কোনো সাহায্যকারী।"
  },
  {
    "surah_id": 86,
    "ayah_number": 11,
    "global_ayah_id": 5942,
    "translation": "ভাবো বর্ষণোন্নুখ আকাশের কথা,"
  },
  {
    "surah_id": 86,
    "ayah_number": 12,
    "global_ayah_id": 5943,
    "translation": "আর পৃথিবীর কথা যা বিদীর্ণ হয়।"
  },
  {
    "surah_id": 86,
    "ayah_number": 13,
    "global_ayah_id": 5944,
    "translation": "নিঃসন্দেহ এটি সুমীমাংসাকারী বক্তব্য,"
  },
  {
    "surah_id": 86,
    "ayah_number": 14,
    "global_ayah_id": 5945,
    "translation": "আর এটি কোনো তামাশার জিনিস নয়।"
  },
  {
    "surah_id": 86,
    "ayah_number": 15,
    "global_ayah_id": 5946,
    "translation": "নিঃসন্দেহ তারা চাল চালছে,"
  },
  {
    "surah_id": 86,
    "ayah_number": 16,
    "global_ayah_id": 5947,
    "translation": "আর আমিও পরিকল্পনা উদ্ভাবন করছি।"
  },
  {
    "surah_id": 86,
    "ayah_number": 17,
    "global_ayah_id": 5948,
    "translation": "অতএব তুমি অবিশ্বাসীদের অবকাশ দাও, তাদের অবকাশ দাও কিছুটা সময়।"
  }
]