[
  {
    "surah_id": 86,
    "ayah_number": 1,
    "global_ayah_id": 5932,
    "translation": "শপথ আকাশের এবং রাত্রিতে আগমনকারীর।"
  },
  {
    "surah_id": 86,
    "ayah_number": 2,
    "global_ayah_id": 5933,
    "translation": "আপনি জানেন, যে রাত্রিতে আসে সেটা কি?"
  },
  {
    "surah_id": 86,
    "ayah_number": 3,
    "global_ayah_id": 5934,
    "translation": "সেটা এক উজ্জ্বল নক্ষত্র।"
  },
  {
    "surah_id": 86,
    "ayah_number": 4,
    "global_ayah_id": 5935,
    "translation": "প্রত্যেকের উপর একজন তত্ত্বাবধায়ক রয়েছে।"
  },
  {
    "surah_id": 86,
    "ayah_number": 5,
    "global_ayah_id": 5936,
    "translation": "অতএব, মানুষের দেখা উচিত কি বস্তু থেকে সে সৃজিত হয়েছে।"
  },
  {
    "surah_id": 86,
    "ayah_number": 6,
    "global_ayah_id": 5937,
    "translation": "সে সৃজিত হয়েছে সবেগে স্খলিত পানি থেকে।"
  },
  {
    "surah_id": 86,
    "ayah_number": 7,
    "global_ayah_id": 5938,
    "translation": "এটা নির্গত হয় মেরুদন্ড ও বক্ষপাজরের মধ্য থেকে।"
  },
  {
    "surah_id": 86,
    "ayah_number": 8,
    "global_ayah_id": 5939,
    "translation": "নিশ্চয় তিনি তাকে ফিরিয়ে নিতে সক্ষম।"
  },
  {
    "surah_id": 86,
    "ayah_number": 9,
    "global_ayah_id": 5940,
    "translation": "যেদিন গোপন বিষয়াদি পরীক্ষিত হবে,"
  },
  {
    "surah_id": 86,
    "ayah_number": 10,
    "global_ayah_id": 5941,
    "translation": "সেদিন তার কোন শক্তি থাকবে না এবং সাহায্যকারীও থাকবে না।"
  },
  {
    "surah_id": 86,
    "ayah_number": 11,
    "global_ayah_id": 5942,
    "translation": "শপথ চক্রশীল আকাশের"
  },
  {
    "surah_id": 86,
    "ayah_number": 12,
    "global_ayah_id": 5943,
    "translation": "এবং বিদারনশীল পৃথিবীর"
  },
  {
    "surah_id": 86,
    "ayah_number": 13,
    "global_ayah_id": 5944,
    "translation": "নিশ্চয় কোরআন সত্য-মিথ্যার ফয়সালা।"
  },
  {
    "surah_id": 86,
    "ayah_number": 14,
    "global_ayah_id": 5945,
    "translation": "এবং এটা উপহাস নয়।"
  },
  {
    "surah_id": 86,
    "ayah_number": 15,
    "global_ayah_id": 5946,
    "translation": "তারা ভীষণ চক্রান্ত করে,"
  },
  {
    "surah_id": 86,
    "ayah_number": 16,
    "global_ayah_id": 5947,
    "translation": "আর আমিও কৌশল করি।"
  },
  {
    "surah_id": 86,
    "ayah_number": 17,
    "global_ayah_id": 5948,
    "translation": "অতএব, কাফেরদেরকে অবকাশ দিন, তাদেরকে অবকাশ দিন, কিছু দিনের জন্যে।"
  }
]