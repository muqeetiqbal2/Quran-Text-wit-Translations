[
  {
    "surah_id": 86,
    "ayah_number": 1,
    "global_ayah_id": 5932,
    "translation": "Eebe wuxuu ku dhaartay Samada iyo Xiddigga guura."
  },
  {
    "surah_id": 86,
    "ayah_number": 2,
    "global_ayah_id": 5933,
    "translation": "Ma taqaan Xiddigga guura."
  },
  {
    "surah_id": 86,
    "ayah_number": 3,
    "global_ayah_id": 5934,
    "translation": "Waa Xiddig ifa."
  },
  {
    "surah_id": 86,
    "ayah_number": 4,
    "global_ayah_id": 5935,
    "translation": "Ee Nafwalba waxaa kor jooga ilaaliye (Malag)."
  },
  {
    "surah_id": 86,
    "ayah_number": 5,
    "global_ayah_id": 5936,
    "translation": "Ee Dadku ha dayo waxa laga abuuray."
  },
  {
    "surah_id": 86,
    "ayah_number": 6,
    "global_ayah_id": 5937,
    "translation": "Waxaa laga abuuray Biyo booda."
  },
  {
    "surah_id": 86,
    "ayah_number": 7,
    "global_ayah_id": 5938,
    "translation": "Kana soobaxa Dhabar iyo laab dhexdood."
  },
  {
    "surah_id": 86,
    "ayah_number": 8,
    "global_ayah_id": 5939,
    "translation": "Eebana waa karaa soo celinta Dadka (qiyaamada)."
  },
  {
    "surah_id": 86,
    "ayah_number": 9,
    "global_ayah_id": 5940,
    "translation": "Maalinta la imtixaani waxa (Laabta) ku qarsoon."
  },
  {
    "surah_id": 86,
    "ayah_number": 10,
    "global_ayah_id": 5941,
    "translation": "Dadkuna Xoog ma leh (Maalintaas) iyo wax u gargaaara midna."
  },
  {
    "surah_id": 86,
    "ayah_number": 11,
    "global_ayah_id": 5942,
    "translation": "Eebana wuxuu ku dhaartay Samada Roobka leh."
  },
  {
    "surah_id": 86,
    "ayah_number": 12,
    "global_ayah_id": 5943,
    "translation": "Iyo Dhulka jeexma (waxna ka soo baxo)."
  },
  {
    "surah_id": 86,
    "ayah_number": 13,
    "global_ayah_id": 5944,
    "translation": "Ee Quraanku waa hadal wax kala bixiya (wanaagga iyo Xumaanta)."
  },
  {
    "surah_id": 86,
    "ayah_number": 14,
    "global_ayah_id": 5945,
    "translation": "Ciyaarra ma aha (ee waa dhab)."
  },
  {
    "surah_id": 86,
    "ayah_number": 15,
    "global_ayah_id": 5946,
    "translation": "Gaaladu waxbay dhakri."
  },
  {
    "surah_id": 86,
    "ayah_number": 16,
    "global_ayah_id": 5947,
    "translation": "Annaguna waanu kaydi (Abaalmarin)."
  },
  {
    "surah_id": 86,
    "ayah_number": 17,
    "global_ayah_id": 5948,
    "translation": "Ee u sug Gaalada wax yar."
  }
]