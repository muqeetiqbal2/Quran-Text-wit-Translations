[
  {
    "surah_id": 86,
    "ayah_number": 0,
    "global_ayah_id": 6016,
    "translation": "اللہ دے ناں نال ( شروع ) جیہڑا حدوں مہربان ، بوہت رحم والا اے ۔"
  },
  {
    "surah_id": 86,
    "ayah_number": 1,
    "global_ayah_id": 6017,
    "translation": "قسم اے اسمان دی تے رات نوں آؤن والے دی"
  },
  {
    "surah_id": 86,
    "ayah_number": 2,
    "global_ayah_id": 6018,
    "translation": "تے تہانوں کیس شے دسیا پئی اوہ رات نوں آؤن والا کیہہ اے ؟"
  },
  {
    "surah_id": 86,
    "ayah_number": 3,
    "global_ayah_id": 6019,
    "translation": "خوب روشن تارا اے"
  },
  {
    "surah_id": 86,
    "ayah_number": 4,
    "global_ayah_id": 6020,
    "translation": "نئیں ہر کوئی جان پر اوہدے اتے اک راکھا اے"
  },
  {
    "surah_id": 86,
    "ayah_number": 5,
    "global_ayah_id": 6021,
    "translation": "سو انسان تے لازم اے پئی اوہ ویکھے کاہدے توں بنایا گیا اے"
  },
  {
    "surah_id": 86,
    "ayah_number": 6,
    "global_ayah_id": 6022,
    "translation": "اوہ اک زور نال اچھل دے پانی وچوں پیدا کیتا گیا اے"
  },
  {
    "surah_id": 86,
    "ayah_number": 7,
    "global_ayah_id": 6023,
    "translation": "جیہڑا پِٹھ تے پسلیاں دے وچکاروں نکلدا اے"
  },
  {
    "surah_id": 86,
    "ayah_number": 8,
    "global_ayah_id": 6024,
    "translation": "بیشک اوہ ( اللہ ) اوہنوں لازمی پرتاؤن تے قادر اے"
  },
  {
    "surah_id": 86,
    "ayah_number": 9,
    "global_ayah_id": 6025,
    "translation": "جیس دیہاڑے بھیت پرکھے جان گے"
  },
  {
    "surah_id": 86,
    "ayah_number": 10,
    "global_ayah_id": 6026,
    "translation": "فیر انسان کول کوئی زور ہووے گا تے نہ کوئی امدادی ہووے گا"
  },
  {
    "surah_id": 86,
    "ayah_number": 11,
    "global_ayah_id": 6027,
    "translation": "قسم اے اسمان دی گھڑی مڑی مینہ ورھان والا"
  },
  {
    "surah_id": 86,
    "ayah_number": 12,
    "global_ayah_id": 6028,
    "translation": "تے پھٹن والی زمین دی"
  },
  {
    "surah_id": 86,
    "ayah_number": 13,
    "global_ayah_id": 6029,
    "translation": "بیشک ایہہ ( قرآن ) لازمی نتارا کرن والا کلام اے"
  },
  {
    "surah_id": 86,
    "ayah_number": 14,
    "global_ayah_id": 6030,
    "translation": "تے ایہہ ہاسا مخول نئیں"
  },
  {
    "surah_id": 86,
    "ayah_number": 15,
    "global_ayah_id": 6031,
    "translation": "بیشک اوہ ( کافر ) اک چال چال رہے نیں"
  },
  {
    "surah_id": 86,
    "ayah_number": 16,
    "global_ayah_id": 6032,
    "translation": "تے میں وی ( اک ) چال چلداں ہاں"
  },
  {
    "surah_id": 86,
    "ayah_number": 17,
    "global_ayah_id": 6033,
    "translation": "سو ( اے نبی ! ) ایہناں کافراں نوں ڈھل دیو ۔ تھوڑی جہی اوہناں کُو مہلت"
  }
]