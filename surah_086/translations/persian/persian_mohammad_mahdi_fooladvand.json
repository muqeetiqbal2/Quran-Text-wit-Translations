[
  {
    "surah_id": 86,
    "ayah_number": 1,
    "global_ayah_id": 5932,
    "translation": "سوگند به آسمان و آن اختر شبگرد."
  },
  {
    "surah_id": 86,
    "ayah_number": 2,
    "global_ayah_id": 5933,
    "translation": "و تو چه دانى كه اختر شبگرد چيست؟"
  },
  {
    "surah_id": 86,
    "ayah_number": 3,
    "global_ayah_id": 5934,
    "translation": "آن اختر فروزان."
  },
  {
    "surah_id": 86,
    "ayah_number": 4,
    "global_ayah_id": 5935,
    "translation": "هيچ كس نيست مگر اينكه نگاهبانى بر او [گماشته شده‌] است."
  },
  {
    "surah_id": 86,
    "ayah_number": 5,
    "global_ayah_id": 5936,
    "translation": "پس انسان بايد بنگرد كه از چه آفريده شده است؟"
  },
  {
    "surah_id": 86,
    "ayah_number": 6,
    "global_ayah_id": 5937,
    "translation": "از آب جهنده‌اى خلق شده،"
  },
  {
    "surah_id": 86,
    "ayah_number": 7,
    "global_ayah_id": 5938,
    "translation": "[كه‌] از صلب مرد و ميان استخوانهاى سينه زن بيرون مى‌آيد."
  },
  {
    "surah_id": 86,
    "ayah_number": 8,
    "global_ayah_id": 5939,
    "translation": "در حقيقت، او [= خدا] بر بازگردانيدن وى بخوبى تواناست."
  },
  {
    "surah_id": 86,
    "ayah_number": 9,
    "global_ayah_id": 5940,
    "translation": "آن روز كه رازها [همه‌] فاش شود،"
  },
  {
    "surah_id": 86,
    "ayah_number": 10,
    "global_ayah_id": 5941,
    "translation": "پس او را نه نيرويى ماند و نه يارى."
  },
  {
    "surah_id": 86,
    "ayah_number": 11,
    "global_ayah_id": 5942,
    "translation": "سوگند به آسمان بارش‌انگيز،"
  },
  {
    "surah_id": 86,
    "ayah_number": 12,
    "global_ayah_id": 5943,
    "translation": "سوگند به زمين شكافدار [آماده كشت‌]،"
  },
  {
    "surah_id": 86,
    "ayah_number": 13,
    "global_ayah_id": 5944,
    "translation": "[كه‌] در حقيقت، قرآن گفتارى قاطع و روشنگر است؛"
  },
  {
    "surah_id": 86,
    "ayah_number": 14,
    "global_ayah_id": 5945,
    "translation": "و آن شوخى نيست."
  },
  {
    "surah_id": 86,
    "ayah_number": 15,
    "global_ayah_id": 5946,
    "translation": "آنان دست به نيرنگ مى‌زنند."
  },
  {
    "surah_id": 86,
    "ayah_number": 16,
    "global_ayah_id": 5947,
    "translation": "و [من نيز] دست به نيرنگ مى‌زنم."
  },
  {
    "surah_id": 86,
    "ayah_number": 17,
    "global_ayah_id": 5948,
    "translation": "پس كافران را مهلت ده، و كمى آنان را به حال خود واگذار."
  }
]