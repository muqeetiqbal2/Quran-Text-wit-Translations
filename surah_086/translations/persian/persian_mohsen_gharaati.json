[
  {
    "surah_id": 86,
    "ayah_number": 1,
    "global_ayah_id": 5932,
    "translation": "سوگند به آسمان و ستاره طارِق!"
  },
  {
    "surah_id": 86,
    "ayah_number": 2,
    "global_ayah_id": 5933,
    "translation": "و چه می‌دانی که طارِق چیست؟"
  },
  {
    "surah_id": 86,
    "ayah_number": 3,
    "global_ayah_id": 5934,
    "translation": "ستاره‌ای است درخشنده."
  },
  {
    "surah_id": 86,
    "ayah_number": 4,
    "global_ayah_id": 5935,
    "translation": "[به اینها سوگند که] هر کس مراقب و نگهبانی دارد."
  },
  {
    "surah_id": 86,
    "ayah_number": 5,
    "global_ayah_id": 5936,
    "translation": "پس انسان بنگرد که از چه آفریده شده است؟"
  },
  {
    "surah_id": 86,
    "ayah_number": 6,
    "global_ayah_id": 5937,
    "translation": "از آبی جهنده آفریده شده است،"
  },
  {
    "surah_id": 86,
    "ayah_number": 7,
    "global_ayah_id": 5938,
    "translation": "[آبی] که از میان پشت و پیش بیرون می‌آید."
  },
  {
    "surah_id": 86,
    "ayah_number": 8,
    "global_ayah_id": 5939,
    "translation": "بی‌تردید او بر بازگرداندن انسان تواناست،"
  },
  {
    "surah_id": 86,
    "ayah_number": 9,
    "global_ayah_id": 5940,
    "translation": "روزی که رازها آشکار شود."
  },
  {
    "surah_id": 86,
    "ayah_number": 10,
    "global_ayah_id": 5941,
    "translation": "پس برای انسان، هیچ نیرویی [از درون] و یاوری [از بیرون] نیست."
  },
  {
    "surah_id": 86,
    "ayah_number": 11,
    "global_ayah_id": 5942,
    "translation": "سوگند به آسمان باران‌زا!"
  },
  {
    "surah_id": 86,
    "ayah_number": 12,
    "global_ayah_id": 5943,
    "translation": "سوگند به زمین که [برای رویش گیاهان] برشکافته است!"
  },
  {
    "surah_id": 86,
    "ayah_number": 13,
    "global_ayah_id": 5944,
    "translation": "که بی‌گمان این [قرآن] سخنی است قاطع و جداکننده"
  },
  {
    "surah_id": 86,
    "ayah_number": 14,
    "global_ayah_id": 5945,
    "translation": "و بیهوده و شوخی نیست."
  },
  {
    "surah_id": 86,
    "ayah_number": 15,
    "global_ayah_id": 5946,
    "translation": "کافران پیوسته نیرنگ می‌کنند."
  },
  {
    "surah_id": 86,
    "ayah_number": 16,
    "global_ayah_id": 5947,
    "translation": "و من نیز تدبیر می‌کنم."
  },
  {
    "surah_id": 86,
    "ayah_number": 17,
    "global_ayah_id": 5948,
    "translation": "پس کافران را مهلت بده و اندک زمانی آنان را به خود واگذار!"
  }
]