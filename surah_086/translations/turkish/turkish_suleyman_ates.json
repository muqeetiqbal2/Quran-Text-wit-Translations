[
  {
    "surah_id": 86,
    "ayah_number": 1,
    "global_ayah_id": 5932,
    "translation": "Göğe ve tarık'a andolsun."
  },
  {
    "surah_id": 86,
    "ayah_number": 2,
    "global_ayah_id": 5933,
    "translation": "Tarık'ın ne olduğunu sen nereden bileceksin?"
  },
  {
    "surah_id": 86,
    "ayah_number": 3,
    "global_ayah_id": 5934,
    "translation": "Parlayan yıldızdır."
  },
  {
    "surah_id": 86,
    "ayah_number": 4,
    "global_ayah_id": 5935,
    "translation": "Hiçbir can yoktur ki başında bir koruyucu (bekçi) olmasın."
  },
  {
    "surah_id": 86,
    "ayah_number": 5,
    "global_ayah_id": 5936,
    "translation": "İnsan neden yaratıldığına bir baksın:"
  },
  {
    "surah_id": 86,
    "ayah_number": 6,
    "global_ayah_id": 5937,
    "translation": "Atılan bir sudan yaratıldı."
  },
  {
    "surah_id": 86,
    "ayah_number": 7,
    "global_ayah_id": 5938,
    "translation": "Bel ile kaburga kemikleri arasından çıkan (bir sudan)."
  },
  {
    "surah_id": 86,
    "ayah_number": 8,
    "global_ayah_id": 5939,
    "translation": "O (Allah), onu tekrar döndür(üp yarat)mağa kadirdir."
  },
  {
    "surah_id": 86,
    "ayah_number": 9,
    "global_ayah_id": 5940,
    "translation": "Gizlilerin (ortaya dökülüp) yoklanacağı gün,"
  },
  {
    "surah_id": 86,
    "ayah_number": 10,
    "global_ayah_id": 5941,
    "translation": "İnsanın ne bir gücü, ne de bir yardımcısı vardır."
  },
  {
    "surah_id": 86,
    "ayah_number": 11,
    "global_ayah_id": 5942,
    "translation": "Dönüşlü göğe andolsun,"
  },
  {
    "surah_id": 86,
    "ayah_number": 12,
    "global_ayah_id": 5943,
    "translation": "(Bitkilerin çıkması için) Çatlayan yere andolsun ki,"
  },
  {
    "surah_id": 86,
    "ayah_number": 13,
    "global_ayah_id": 5944,
    "translation": "O (Kur'an), elbette (hak ile batılı) ayırdedici bir sözdür."
  },
  {
    "surah_id": 86,
    "ayah_number": 14,
    "global_ayah_id": 5945,
    "translation": "O, şaka değildir."
  },
  {
    "surah_id": 86,
    "ayah_number": 15,
    "global_ayah_id": 5946,
    "translation": "Onlar (onu iptal etmek için) bir tuzak kuruyorlar."
  },
  {
    "surah_id": 86,
    "ayah_number": 16,
    "global_ayah_id": 5947,
    "translation": "Ben de (onları yakalamak için) bir tuzak kuruyorum."
  },
  {
    "surah_id": 86,
    "ayah_number": 17,
    "global_ayah_id": 5948,
    "translation": "Hele sen o kafirlere mühlet ver, biraz bırak onları (bildiklerine gitsinler)."
  }
]