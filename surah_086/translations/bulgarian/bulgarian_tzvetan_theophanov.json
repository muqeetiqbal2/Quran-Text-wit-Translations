[
  {
    "surah_id": 86,
    "ayah_number": 1,
    "global_ayah_id": 5932,
    "translation": "Кълна се в небето и във Вечерницата!"
  },
  {
    "surah_id": 86,
    "ayah_number": 2,
    "global_ayah_id": 5933,
    "translation": "А откъде да знаеш ти какво е Вечерницата?"
  },
  {
    "surah_id": 86,
    "ayah_number": 3,
    "global_ayah_id": 5934,
    "translation": "Звездата с пронизваща светлина."
  },
  {
    "surah_id": 86,
    "ayah_number": 4,
    "global_ayah_id": 5935,
    "translation": "Над всяка душа има надзорник."
  },
  {
    "surah_id": 86,
    "ayah_number": 5,
    "global_ayah_id": 5936,
    "translation": "И да погледне човекът от какво бе сътворен!"
  },
  {
    "surah_id": 86,
    "ayah_number": 6,
    "global_ayah_id": 5937,
    "translation": "Бе сътворен от изтласкваща се вода,"
  },
  {
    "surah_id": 86,
    "ayah_number": 7,
    "global_ayah_id": 5938,
    "translation": "която излиза измежду гръбнака и ребрата."
  },
  {
    "surah_id": 86,
    "ayah_number": 8,
    "global_ayah_id": 5939,
    "translation": "Способен е Той да го върне -"
  },
  {
    "surah_id": 86,
    "ayah_number": 9,
    "global_ayah_id": 5940,
    "translation": "в Деня, когато ще бъдат изявени тайните"
  },
  {
    "surah_id": 86,
    "ayah_number": 10,
    "global_ayah_id": 5941,
    "translation": "и не ще има той нито сила, нито избавител."
  },
  {
    "surah_id": 86,
    "ayah_number": 11,
    "global_ayah_id": 5942,
    "translation": "Кълна се в небето, от което вали,"
  },
  {
    "surah_id": 86,
    "ayah_number": 12,
    "global_ayah_id": 5943,
    "translation": "и в земята, която се разпуква,"
  },
  {
    "surah_id": 86,
    "ayah_number": 13,
    "global_ayah_id": 5944,
    "translation": "че това е слово-разграничение."
  },
  {
    "surah_id": 86,
    "ayah_number": 14,
    "global_ayah_id": 5945,
    "translation": "А не е шега."
  },
  {
    "surah_id": 86,
    "ayah_number": 15,
    "global_ayah_id": 5946,
    "translation": "Те замислят с умисъл."
  },
  {
    "surah_id": 86,
    "ayah_number": 16,
    "global_ayah_id": 5947,
    "translation": "И Аз замислям с умисъл."
  },
  {
    "surah_id": 86,
    "ayah_number": 17,
    "global_ayah_id": 5948,
    "translation": "И дай отсрочка на неверниците, отсрочи ги за кратко!"
  }
]