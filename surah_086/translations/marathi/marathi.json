[
  {
    "surah_id": 86,
    "ayah_number": 0,
    "global_ayah_id": 6016,
    "translation": "﻿अल्लाहच्या नावाने, जो अत्यंत दयावंत व असीम कृपावंत आहे."
  },
  {
    "surah_id": 86,
    "ayah_number": 1,
    "global_ayah_id": 6017,
    "translation": "शपथ आहे आकाशाची आणि रात्री प्रकट होणार्‍याची."
  },
  {
    "surah_id": 86,
    "ayah_number": 2,
    "global_ayah_id": 6018,
    "translation": "तुम्हाला काय माहीत की तो रात्री प्रकट होणारा काय आहे?"
  },
  {
    "surah_id": 86,
    "ayah_number": 3,
    "global_ayah_id": 6019,
    "translation": "चमकत असलेला तारा,"
  },
  {
    "surah_id": 86,
    "ayah_number": 4,
    "global_ayah_id": 6020,
    "translation": "कोणताही जीव असा नाही ज्याच्यावर कोणी निगाह राखणारा नाही,"
  },
  {
    "surah_id": 86,
    "ayah_number": 5,
    "global_ayah_id": 6021,
    "translation": "मग जरा मानवाने हेच पाहून घ्यावे की तो कोणत्या वस्तूने निर्माण केला गेला आहे."
  },
  {
    "surah_id": 86,
    "ayah_number": 6,
    "global_ayah_id": 6022,
    "translation": "एका उसळणार्‍या पाण्यापासून निर्माण केला गेला आहे"
  },
  {
    "surah_id": 86,
    "ayah_number": 7,
    "global_ayah_id": 6023,
    "translation": "जे पाठीच्या आणि छातीच्या हाडांच्या मधून निघते."
  },
  {
    "surah_id": 86,
    "ayah_number": 8,
    "global_ayah_id": 6024,
    "translation": "खचितच तो (निर्माणकर्ता) त्याला पुन्हा निर्माण करण्यास समर्थ आहे."
  },
  {
    "surah_id": 86,
    "ayah_number": 9,
    "global_ayah_id": 6025,
    "translation": "ज्या दिवशी गुप्त रहस्यांची तपासणी होईल"
  },
  {
    "surah_id": 86,
    "ayah_number": 10,
    "global_ayah_id": 6026,
    "translation": "त्यावेळी मानवाजवळ न त्याच्या स्वत:चे बळ असेल आणि न कोणी त्याला सहाय्य करणारा असेल."
  },
  {
    "surah_id": 86,
    "ayah_number": 11,
    "global_ayah_id": 6027,
    "translation": "शपथ आहे पाऊस वर्षविणार्‍या आकाशाची"
  },
  {
    "surah_id": 86,
    "ayah_number": 12,
    "global_ayah_id": 6028,
    "translation": "आणि (वनस्पती उगविताना) भग्न होणार्‍या जमिनीची,"
  },
  {
    "surah_id": 86,
    "ayah_number": 13,
    "global_ayah_id": 6029,
    "translation": "ही एक तोलामोलाची प्रमाणित गोष्ट आहे"
  },
  {
    "surah_id": 86,
    "ayah_number": 14,
    "global_ayah_id": 6030,
    "translation": "थट्टामस्करी नव्हे."
  },
  {
    "surah_id": 86,
    "ayah_number": 15,
    "global_ayah_id": 6031,
    "translation": "हे लोक (अर्थात मक्कातील अश्रद्धावंत) काही चाली खेळत आहेत"
  },
  {
    "surah_id": 86,
    "ayah_number": 16,
    "global_ayah_id": 6032,
    "translation": "आणि मीसुद्धा एक चाल खेळत आहे."
  },
  {
    "surah_id": 86,
    "ayah_number": 17,
    "global_ayah_id": 6033,
    "translation": "म्हणून सोडून द्या हे पैगंबर (स.), या अश्रद्धावंतांना, किंचित, जराशा यांच्या स्थितीत सोडा."
  }
]