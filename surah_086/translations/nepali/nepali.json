[
  {
    "surah_id": 86,
    "ayah_number": 0,
    "global_ayah_id": 6016,
    "translation": "शुरु अत्यन्त करुणामय, परम दयालु अल्लाहको नामबाट ।"
  },
  {
    "surah_id": 86,
    "ayah_number": 1,
    "global_ayah_id": 6017,
    "translation": "आकाश र राति आउनेको कसम"
  },
  {
    "surah_id": 86,
    "ayah_number": 2,
    "global_ayah_id": 6018,
    "translation": "र, राति आउने के हो तिमीलाई के थाहा ?"
  },
  {
    "surah_id": 86,
    "ayah_number": 3,
    "global_ayah_id": 6019,
    "translation": "चम्किलो तारा हो ।"
  },
  {
    "surah_id": 86,
    "ayah_number": 4,
    "global_ayah_id": 6020,
    "translation": "निश्चय नै प्रत्येक व्यक्तिसंग निरिक्षक नियुक्त छ ।"
  },
  {
    "surah_id": 86,
    "ayah_number": 5,
    "global_ayah_id": 6021,
    "translation": "अतः आफूलाई कुन तत्वबाट सृष्टि गरिएको छ भन्ने मानिसले विचार गर्नुपर्ने हो ।"
  },
  {
    "surah_id": 86,
    "ayah_number": 6,
    "global_ayah_id": 6022,
    "translation": "एउटा छचल्कँदो पानीबाट मानिसलाई सृष्टि गरिएको छ ।"
  },
  {
    "surah_id": 86,
    "ayah_number": 7,
    "global_ayah_id": 6023,
    "translation": "जुन पानी पिठ्यूँ र छातीको हड्डीको बीचबाट निस्कन्छ ।"
  },
  {
    "surah_id": 86,
    "ayah_number": 8,
    "global_ayah_id": 6024,
    "translation": "निस्सन्देह अल्लाह उसलाई फर्काउन समर्थ छन् ।"
  },
  {
    "surah_id": 86,
    "ayah_number": 9,
    "global_ayah_id": 6025,
    "translation": "जुन दिन गुप्त भेदहरूको परीक्षण हुनेछ ।"
  },
  {
    "surah_id": 86,
    "ayah_number": 10,
    "global_ayah_id": 6026,
    "translation": "त्यस बेला उसको न कुनै शक्ति हुनेछ न कुनै सहयोगी नै ।"
  },
  {
    "surah_id": 86,
    "ayah_number": 11,
    "global_ayah_id": 6027,
    "translation": "पानी बर्साउने आकाशको कसम ।"
  },
  {
    "surah_id": 86,
    "ayah_number": 12,
    "global_ayah_id": 6028,
    "translation": "र, चर्किने धर्तीको कसम ।"
  },
  {
    "surah_id": 86,
    "ayah_number": 13,
    "global_ayah_id": 6029,
    "translation": "निस्सन्देह यो (कुरआन) निर्णायक वाणी हो ।"
  },
  {
    "surah_id": 86,
    "ayah_number": 14,
    "global_ayah_id": 6030,
    "translation": "यो कुनै ठट्यौली होइन ।"
  },
  {
    "surah_id": 86,
    "ayah_number": 15,
    "global_ayah_id": 6031,
    "translation": "निस्सन्देह काफिरहरू चाल चलिरहेका छन् ।"
  },
  {
    "surah_id": 86,
    "ayah_number": 16,
    "global_ayah_id": 6032,
    "translation": "र, म पनी एउटा योजना बनाइरहेको छु ।"
  },
  {
    "surah_id": 86,
    "ayah_number": 17,
    "global_ayah_id": 6033,
    "translation": "अतः (हे सन्देष्टा) काफिरहरूलाई अवसर देउ, केही दिनको लागि उनीहरुलाई छोडी देउ ।"
  }
]