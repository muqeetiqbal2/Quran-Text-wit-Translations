[
  {
    "surah_id": 86,
    "ayah_number": 0,
    "global_ayah_id": 6016,
    "translation": "అనంత కరుణామయుడు అపార కరుణాప్రదాత అయిన అల్లాహ్‌ పేరుతో"
  },
  {
    "surah_id": 86,
    "ayah_number": 1,
    "global_ayah_id": 6017,
    "translation": "ఆకాశం మరియు రాత్రివేళ వచ్చే నక్షత్రం (అ త్‌- తారిఖ్‌) సాక్షిగా!"
  },
  {
    "surah_id": 86,
    "ayah_number": 2,
    "global_ayah_id": 6018,
    "translation": "రాత్రి వేళ వచ్చేది (అ త్‌- తారిఖ్‌) అంటే ఏమిటో నీకు ఎలా తెలుస్తుంది?"
  },
  {
    "surah_id": 86,
    "ayah_number": 3,
    "global_ayah_id": 6019,
    "translation": "అదొక అత్యంత ప్రకాశవంతమైన నక్షత్రం."
  },
  {
    "surah_id": 86,
    "ayah_number": 4,
    "global_ayah_id": 6020,
    "translation": "కనిపెట్టుకొని ఉండేవాడు (దైవదూత) లేకుండా ఏ వ్యక్తి కూడా లేడు."
  },
  {
    "surah_id": 86,
    "ayah_number": 5,
    "global_ayah_id": 6021,
    "translation": "ఇక మానవుడు తాను దేనితో సృష్టించ బడ్డాడో గమనించాలి!"
  },
  {
    "surah_id": 86,
    "ayah_number": 6,
    "global_ayah_id": 6022,
    "translation": "అతడు విసర్జించబడే (చిమ్ముకుంటూ వెలువడే) ద్రవపదార్థంతో సృష్టించబడ్డాడు."
  },
  {
    "surah_id": 86,
    "ayah_number": 7,
    "global_ayah_id": 6023,
    "translation": "అది వెన్ను మరియు రొమ్ము ఎముకల మధ్య భాగం నుండి బయటికి వస్తుంది."
  },
  {
    "surah_id": 86,
    "ayah_number": 8,
    "global_ayah_id": 6024,
    "translation": "నిశ్చయంగా, ఆయన (సృష్టికర్త), అతనిని మరల బ్రతికించి తేగల సామర్థ్యం గలవాడు!"
  },
  {
    "surah_id": 86,
    "ayah_number": 9,
    "global_ayah_id": 6025,
    "translation": "ఏ రోజయితే రహస్య విషయాల విచారణ జరుగుతుందో!"
  },
  {
    "surah_id": 86,
    "ayah_number": 10,
    "global_ayah_id": 6026,
    "translation": "అప్పుడు అతనికి (మానవునికి) ఎలాంటి శక్తి ఉండదు మరియు ఏ సహాయకుడునూ ఉండడు."
  },
  {
    "surah_id": 86,
    "ayah_number": 11,
    "global_ayah_id": 6027,
    "translation": "వర్షం కురిపించే ఆకాశం సాక్షిగా!"
  },
  {
    "surah_id": 86,
    "ayah_number": 12,
    "global_ayah_id": 6028,
    "translation": "(చెట్లు మొలకెత్తేటప్పుడు) చీలిపోయే భూమి సాక్షిగా!"
  },
  {
    "surah_id": 86,
    "ayah_number": 13,
    "global_ayah_id": 6029,
    "translation": "నిశ్చయంగా, ఇది (ఈ ఖుర్‌ఆన్‌, సత్యా- సత్యాలను) వేరుపరచే వాక్కు (గీటురాయి)."
  },
  {
    "surah_id": 86,
    "ayah_number": 14,
    "global_ayah_id": 6030,
    "translation": "మరియు ఇది వృథా కాలక్షేపానికి వచ్చినది కాదు."
  },
  {
    "surah_id": 86,
    "ayah_number": 15,
    "global_ayah_id": 6031,
    "translation": "(ఓ ము హమ్మద్‌!) నిశ్చయంగా, వారు (నీకు విరుద్ధంగా) కుట్రలు పన్నుతున్నారు."
  },
  {
    "surah_id": 86,
    "ayah_number": 16,
    "global_ayah_id": 6032,
    "translation": "మరియు నేను కూడ పన్నాగం పన్నుతున్నాను."
  },
  {
    "surah_id": 86,
    "ayah_number": 17,
    "global_ayah_id": 6033,
    "translation": "కనుక నీవు సత్య-తిరస్కారులకు కొంత వ్యవధినివ్వు!   వారి పట్ల మృదువుగా వ్యవహరించు.(1/2)"
  }
]