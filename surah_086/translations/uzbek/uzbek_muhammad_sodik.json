[
  {
    "surah_id": 86,
    "ayah_number": 1,
    "global_ayah_id": 5932,
    "translation": "Осмон билан қасам ва ториқ билан қасам."
  },
  {
    "surah_id": 86,
    "ayah_number": 2,
    "global_ayah_id": 5933,
    "translation": "Ториқ нималигини сенга не билдирди?"
  },
  {
    "surah_id": 86,
    "ayah_number": 3,
    "global_ayah_id": 5934,
    "translation": "У нур сочиб турувчи юлдуздир."
  },
  {
    "surah_id": 86,
    "ayah_number": 4,
    "global_ayah_id": 5935,
    "translation": "Ҳеч бир жон йўқки, унинг ҳифз қилиб турувчиси бўлмаса."
  },
  {
    "surah_id": 86,
    "ayah_number": 5,
    "global_ayah_id": 5936,
    "translation": "Инсон нимадан яралганига назар солсин."
  },
  {
    "surah_id": 86,
    "ayah_number": 6,
    "global_ayah_id": 5937,
    "translation": "У отилиб чиқувчи сувдан яратилгандир."
  },
  {
    "surah_id": 86,
    "ayah_number": 7,
    "global_ayah_id": 5938,
    "translation": "У (сув) сулб (умуртқа) ва тароиб (кўкрак суяги) орасидан чиқадир."
  },
  {
    "surah_id": 86,
    "ayah_number": 8,
    "global_ayah_id": 5939,
    "translation": "Албатта У зот уни қайта тирилтиришга қодирдир."
  },
  {
    "surah_id": 86,
    "ayah_number": 9,
    "global_ayah_id": 5940,
    "translation": "Сирлар фош бўладиган кундадир."
  },
  {
    "surah_id": 86,
    "ayah_number": 10,
    "global_ayah_id": 5941,
    "translation": "Бас, (ўшанда) у(инсон)да қувват ҳам, нусрат берувчи ҳам бўлмайдир."
  },
  {
    "surah_id": 86,
    "ayah_number": 11,
    "global_ayah_id": 5942,
    "translation": "Қайтувчи (ёмғир) соҳиби бўлган осмон билан қасам."
  },
  {
    "surah_id": 86,
    "ayah_number": 12,
    "global_ayah_id": 5943,
    "translation": "Ёриб чиқувчи эгаси бўлган ер билан қасам."
  },
  {
    "surah_id": 86,
    "ayah_number": 13,
    "global_ayah_id": 5944,
    "translation": "Албатта у(Қуръон) ажратувчи сўздир."
  },
  {
    "surah_id": 86,
    "ayah_number": 14,
    "global_ayah_id": 5945,
    "translation": "Ва у ҳазил эмасдир."
  },
  {
    "surah_id": 86,
    "ayah_number": 15,
    "global_ayah_id": 5946,
    "translation": "Албатта улар ҳийла-найранг қиларлар."
  },
  {
    "surah_id": 86,
    "ayah_number": 16,
    "global_ayah_id": 5947,
    "translation": "Ва Мен ҳам ҳийла қилурман. (Яъни, ҳийласига яраша жазо берурман.)"
  },
  {
    "surah_id": 86,
    "ayah_number": 17,
    "global_ayah_id": 5948,
    "translation": "Муҳлат бер кофирларга, уларга озгина муҳлат бер. (Яъни, уларга азоб келмаётганидан шошилма, ҳаммасининг вақти, соати бор.)"
  }
]