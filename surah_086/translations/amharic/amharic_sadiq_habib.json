[
  {
    "surah_id": 86,
    "ayah_number": 1,
    "global_ayah_id": 5932,
    "translation": "በሰማዩ በሌሊት መጪውም እምላለሁ፡፡"
  },
  {
    "surah_id": 86,
    "ayah_number": 2,
    "global_ayah_id": 5933,
    "translation": "የሌሊት መጪውም ምን እንደ ኾነ ምን አሳወቀህ?"
  },
  {
    "surah_id": 86,
    "ayah_number": 3,
    "global_ayah_id": 5934,
    "translation": "ጨለማን ቀዳጁ ኮከብ ነው፡፡"
  },
  {
    "surah_id": 86,
    "ayah_number": 4,
    "global_ayah_id": 5935,
    "translation": "ነፍስ ሁሉ በእርሷ ላይ ጠባቂ ያለባት እንጅ ሌላ አይደለችም፡፡"
  },
  {
    "surah_id": 86,
    "ayah_number": 5,
    "global_ayah_id": 5936,
    "translation": "ሰውም ከምን እንደተፈጠረ ይመልከት፡፡"
  },
  {
    "surah_id": 86,
    "ayah_number": 6,
    "global_ayah_id": 5937,
    "translation": "ከተስፈንጣሪ ውሃ ተፈጠረ፡፡"
  },
  {
    "surah_id": 86,
    "ayah_number": 7,
    "global_ayah_id": 5938,
    "translation": "ከጀርባና ከእርግብግብቶች መካከል የሚወጣ ከኾነ (ውሃ)፡፡"
  },
  {
    "surah_id": 86,
    "ayah_number": 8,
    "global_ayah_id": 5939,
    "translation": "እርሱ (አላህ) በመመለሱ ላይ በእርግጥ ቻይ ነው፡፡"
  },
  {
    "surah_id": 86,
    "ayah_number": 9,
    "global_ayah_id": 5940,
    "translation": "ምስጢሮች በሚገለጡበት ቀን፡፡"
  },
  {
    "surah_id": 86,
    "ayah_number": 10,
    "global_ayah_id": 5941,
    "translation": "ለእርሱም (ለሰው) ኀይልና ረዳት ምንም የለውም፡፡"
  },
  {
    "surah_id": 86,
    "ayah_number": 11,
    "global_ayah_id": 5942,
    "translation": "የመመለስ ባለቤት በኾነችው ሰማይም እምላለሁ፡፡"
  },
  {
    "surah_id": 86,
    "ayah_number": 12,
    "global_ayah_id": 5943,
    "translation": "(በበቃይ) የመሰንጠቅ ባለቤት በኾነችው ምድርም፤"
  },
  {
    "surah_id": 86,
    "ayah_number": 13,
    "global_ayah_id": 5944,
    "translation": "እርሱ (እውነትን ከውሸት) የሚለይ ቃል ነው፡፡"
  },
  {
    "surah_id": 86,
    "ayah_number": 14,
    "global_ayah_id": 5945,
    "translation": "እርሱም ቀልድ አይደለም፡፡"
  },
  {
    "surah_id": 86,
    "ayah_number": 15,
    "global_ayah_id": 5946,
    "translation": "እነርሱ በእርግጥ ተንኮልን ይሠራሉ፡፡"
  },
  {
    "surah_id": 86,
    "ayah_number": 16,
    "global_ayah_id": 5947,
    "translation": "(እኔ) ተንኮልንም እመልሳለሁ፡፡"
  },
  {
    "surah_id": 86,
    "ayah_number": 17,
    "global_ayah_id": 5948,
    "translation": "ከሓዲዎችንም ቀን ስጣቸው፡፡ ጥቂትን ጊዜ አቆያቸው፡፡"
  }
]