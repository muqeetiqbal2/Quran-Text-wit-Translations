    "translation": "তুমি বলে যাও -- ''আমি আশ্রয় চাইছি মানুষের প্রভুর কাছে, --"
  },
  {
    "surah_id": 114,
    "ayah_number": 2,
    "global_ayah_id": 6232,
    "translation": "''মানুষের মালিকের, --"
  },
  {
    "surah_id": 114,
    "ayah_number": 3,
    "global_ayah_id": 6233,
    "translation": "''মানুষের উপাস্যের,"
  },
  {
    "surah_id": 114,
    "ayah_number": 4,
    "global_ayah_id": 6234,
    "translation": "''গোপনে আনাগোনাকারীর কুমন্ত্রণার অনিষ্ট থেকে, --"
  },
  {
    "surah_id": 114,
    "ayah_number": 5,
    "global_ayah_id": 6235,
    "translation": "''যে মানুষের বুকের ভেতরে কুমন্ত্রণা দেয়,"
  },
  {
    "surah_id": 114,
    "ayah_number": 6,
    "global_ayah_id": 6236,
    "translation": "''জিনের অথবা মানুষের মধ্যে থেকে।’’"
  }
]