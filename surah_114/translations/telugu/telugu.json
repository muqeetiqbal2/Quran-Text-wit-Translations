[
  {
    "surah_id": 114,
    "ayah_number": 0,
    "global_ayah_id": 6343,
    "translation": "అనంత కరుణామయుడు అపార కరుణాప్రదాత అయిన అల్లాహ్‌ పేరుతో"
  },
  {
    "surah_id": 114,
    "ayah_number": 1,
    "global_ayah_id": 6344,
    "translation": "ఇలా అను:  నేను మానవుల ప్రభువు (అల్లాహ్‌)ను శరణుకై వేడుకుంటున్నాను!"
  },
  {
    "surah_id": 114,
    "ayah_number": 2,
    "global_ayah_id": 6345,
    "translation": "మానవుల సార్వభౌముడు!"
  },
  {
    "surah_id": 114,
    "ayah_number": 3,
    "global_ayah_id": 6346,
    "translation": "మానవుల ఆరాధ్య దైవం (అయిన అల్లాహ్‌ యొక్క శరణు)!"
  },
  {
    "surah_id": 114,
    "ayah_number": 4,
    "global_ayah_id": 6347,
    "translation": "కలతలు రేకెత్తించి తొలగిపోయే వాడి కీడు నుండి"
  },
  {
    "surah_id": 114,
    "ayah_number": 5,
    "global_ayah_id": 6348,
    "translation": "ఎవడైతే మానవుల హృదయాలలో కలతలు రేకెత్తిస్తాడో!"
  },
  {
    "surah_id": 114,
    "ayah_number": 6,
    "global_ayah_id": 6349,
    "translation": "వాడు జిన్నాతులలోని వాడూ కావచ్చు లేదా మానవులలోని వాడూ కావచ్చు!"
  }
]