[
  {
    "surah_id": 26,
    "ayah_number": 1,
    "global_ayah_id": 2933,
    "translation": "똬 씬 밈"
  },
  {
    "surah_id": 26,
    "ayah_number": 2,
    "global_ayah_id": 2934,
    "translation": "그것은 성서의 분명한 말씀 으로"
  },
  {
    "surah_id": 26,
    "ayah_number": 3,
    "global_ayah_id": 2935,
    "translation": "아마도 그대는 그들이 믿지 아니하므로 그대 마음이 슬퍼지리라"
  },
  {
    "surah_id": 26,
    "ayah_number": 4,
    "global_ayah_id": 2936,
    "translation": "하나님이 원했다면 그분은 그들에게 하늘로부터 예증을 내려 그들로 하여금 순종케 하였으리 라"
  },
  {
    "surah_id": 26,
    "ayah_number": 5,
    "global_ayah_id": 2937,
    "translation": "그러나 하나님으로부터 새로 운 말씀이 그들에게 이르지 아니 했으니 그들은 등을 돌리었더라"
  },
  {
    "surah_id": 26,
    "ayah_number": 6,
    "global_ayah_id": 2938,
    "translation": "그들은 그 메세지를 부정하였으니 그들이 조롱했던 사실을 알 게 되리라"
  },
  {
    "surah_id": 26,
    "ayah_number": 7,
    "global_ayah_id": 2939,
    "translation": "그들은 대지를 바라보지 아니하느뇨 하나님이 그 안에 얼마나 많은 여러 종류의 좋은 것을 생성케 하느뇨"
  },
  {
    "surah_id": 26,
    "ayah_number": 8,
    "global_ayah_id": 2940,
    "translation": "실로 그 안에는 예증이 있거 늘 그러나 그들 대다수는 믿지 아 니하더라"
  },
  {
    "surah_id": 26,
    "ayah_number": 9,
    "global_ayah_id": 2941,
    "translation": "실로 그대의 주님은 권능과 자비로 충만하심이라"
  },
  {
    "surah_id": 26,
    "ayah_number": 10,
    "global_ayah_id": 2942,
    "translation": "그대의 주님이 모세를 불러 죄지은 백성에게로 가라 하셨으 니"
  },
  {
    "surah_id": 26,
    "ayah_number": 11,
    "global_ayah_id": 2943,
    "translation": "그들은 하나님을 두려워하지않는 파라오의 백성들이었더라"
  },
  {
    "surah_id": 26,
    "ayah_number": 12,
    "global_ayah_id": 2944,
    "translation": "그가 말하길 주여 실로 저 는 그들이 저를 거역하지 아니할 까 두렴나이다"
  },
  {
    "surah_id": 26,
    "ayah_number": 13,
    "global_ayah_id": 2945,
    "translation": "저의 가슴이 답답하고 제 혀가 굳어 말이 나오지 않습니다 아론을 보내어 주옵소서"
  },
  {
    "surah_id": 26,
    "ayah_number": 14,
    "global_ayah_id": 2946,
    "translation": "그들이 저에게로 죄를 돌려 나를 살해할까 두렵나이다 라고 하니"
  },
  {
    "surah_id": 26,
    "ayah_number": 15,
    "global_ayah_id": 2947,
    "translation": "이에 하나님께서 둘에게 이 르시길 결코 그렇지 아니 하거늘 우리의 예증을 가지고 가라 내가 너희와 함께 하여 너희의 부름에 웅하리라"
  },
  {
    "surah_id": 26,
    "ayah_number": 16,
    "global_ayah_id": 2948,
    "translation": "그리고 네 둘이서 파라오에 게 가서 말하라 실로 우리는 만유 의 주님이 보낸 선지자라"
  },
  {
    "surah_id": 26,
    "ayah_number": 17,
    "global_ayah_id": 2949,
    "translation": "저희와 함께 이스라엘 백성 을 보내어 주소서 라고 하니"
  },
  {
    "surah_id": 26,
    "ayah_number": 18,
    "global_ayah_id": 2950,
    "translation": "이때 파라오가 모세에게 말 하길 우리가 너를 자식으로 양육 하였고 너는 우리 가운데서 오랜 세월동안 거주하였으면서도"
  },
  {
    "surah_id": 26,
    "ayah_number": 19,
    "global_ayah_id": 2951,
    "translation": "네가 행한 너의 행위로 보아너는 은혜를 배반한 자 중 하나라 고 말하니"
  },
  {
    "surah_id": 26,
    "ayah_number": 20,
    "global_ayah_id": 2952,
    "translation": "모세가 이르길 내가 그것을 저질렀을 때는 내가 방황하는 자 들 가운데 있었습니다"
  },
  {
    "surah_id": 26,
    "ayah_number": 21,
    "global_ayah_id": 2953,
    "translation": "그리하여 나는 당신들이 두 려워 도주하였는데 나의 주님께 서 나에게 지혜를 주셨고 나를 선 지자들 중의 한 선지자로 선택하 셨습니다"
  },
  {
    "surah_id": 26,
    "ayah_number": 22,
    "global_ayah_id": 2954,
    "translation": "이스라엘 백성을 노예로 취 급하고 있으면서 그것이 내게 베 푸는 은혜입니까 라고 하니"
  },
  {
    "surah_id": 26,
    "ayah_number": 23,
    "global_ayah_id": 2955,
    "translation": "이에 파라오가 만유의 주님 이란 무엇이뇨 라고 물으매"
  },
  {
    "surah_id": 26,
    "ayah_number": 24,
    "global_ayah_id": 2956,
    "translation": "하늘과 대지와 그 사이에 있 는 모든 것은 주님이십니다 실로 당신께서 확신을 갖고자 합니까 라고 모세가 대답하니"
  },
  {
    "surah_id": 26,
    "ayah_number": 25,
    "global_ayah_id": 2957,
    "translation": "너희는 그가 말한 것을 듣지아니하였느뇨 라고 말하며"
  },
  {
    "surah_id": 26,
    "ayah_number": 26,
    "global_ayah_id": 2958,
    "translation": "모세가 말하길 태초부터 당 신들의 주님이었고 당신 선조들의주님이셨습니다"
  },
  {
    "surah_id": 26,
    "ayah_number": 27,
    "global_ayah_id": 2959,
    "translation": "파라오가 실로 너희에게 보 내어진 너희의 선지자는 미친자라고 말하자"
  },
  {
    "surah_id": 26,
    "ayah_number": 28,
    "global_ayah_id": 2960,
    "translation": "모세가 말하길 당신들이 정 신이 있는 사람들이라면 실로 그 분은 동쪽과 서쪽 그 사이에 있는모든 것의 주님이십니다"
  },
  {
    "surah_id": 26,
    "ayah_number": 29,
    "global_ayah_id": 2961,
    "translation": "과라오가 말하길 만일 네가 나 외의 신을 섬긴다면 실로 내가너를 투옥하리라"
  },
  {
    "surah_id": 26,
    "ayah_number": 30,
    "global_ayah_id": 2962,
    "translation": "내가 당신께 명백한 예중을 보예준다 해도 그렇습니까"
  },
  {
    "surah_id": 26,
    "ayah_number": 31,
    "global_ayah_id": 2963,
    "translation": "만일 네가 정직한 자라면 그예증을 보여달라고 하더라"
  },
  {
    "surah_id": 26,
    "ayah_number": 32,
    "global_ayah_id": 2964,
    "translation": "그리하여 그가 지팡이를 던 지니 보라 그것이 분명한 뱀으로 변했더라"
  },
  {
    "surah_id": 26,
    "ayah_number": 33,
    "global_ayah_id": 2965,
    "translation": "그가 그의 손을 내미니 보라그것은 보고 있는 사람들 앞에서 하얀색이 되었더라"
  },
  {
    "surah_id": 26,
    "ayah_number": 34,
    "global_ayah_id": 2966,
    "translation": "이때 파라오가 그의 주위에 있는 우두머리에게 말하길 실로 이 자는 숙련된 마술사라"
  },
  {
    "surah_id": 26,
    "ayah_number": 35,
    "global_ayah_id": 2967,
    "translation": "그가 그의 마술로써 너희를너희의 땅에서 추방하려 하니 지 금 내가 어찌하면 되겠느뇨 말하 니"
  },
  {
    "surah_id": 26,
    "ayah_number": 36,
    "global_ayah_id": 2968,
    "translation": "그들이 대답하길 그와 그리고 그의 형제에게 벌을 잠시 보류하고 여러 도시로 모든 마술사들 을 집합하도록 전령관을 파견하여"
  },
  {
    "surah_id": 26,
    "ayah_number": 37,
    "global_ayah_id": 2969,
    "translation": "능숙한 모든 마술사들을 데 려 오도록 하소서"
  },
  {
    "surah_id": 26,
    "ayah_number": 38,
    "global_ayah_id": 2970,
    "translation": "그리하여 정하여진 어느날 제 시각에 마술사들이 집합되니"
  },
  {
    "surah_id": 26,
    "ayah_number": 39,
    "global_ayah_id": 2971,
    "translation": "군중에게 다들 모였느뇨 라 고 소리치니"
  },
  {
    "surah_id": 26,
    "ayah_number": 40,
    "global_ayah_id": 2972,
    "translation": "만일 그들이 승리한다면 우 리는 이 마술사들을 따르게 됩니 까"
  },
  {
    "surah_id": 26,
    "ayah_number": 41,
    "global_ayah_id": 2973,
    "translation": "마술사들이 도착하여 파라오 에게 말하길 우리가 만일 승리한 다면 우리는 적절한 보상을 받을 수 있습니까 라고 하니"
  },
  {
    "surah_id": 26,
    "ayah_number": 42,
    "global_ayah_id": 2974,
    "translation": "물론이라 그렇게만 된다면 너희는 내 가까이 있을 것이라고 하자"
  },
  {
    "surah_id": 26,
    "ayah_number": 43,
    "global_ayah_id": 2975,
    "translation": "모세가 그들에게 말하길 너 희가 던지려하는 것을 던져보라"
  },
  {
    "surah_id": 26,
    "ayah_number": 44,
    "global_ayah_id": 2976,
    "translation": "그들이 밧줄과 지팡이를 던 지며 말하길 파라오의 권세로 우 리가 승리하리라"
  },
  {
    "surah_id": 26,
    "ayah_number": 45,
    "global_ayah_id": 2977,
    "translation": "그때 모세도 그의 지팡이를 던졌더라 보라 그때 그들이 던진 것을 삼켜 버렸더라"
  },
  {
    "surah_id": 26,
    "ayah_number": 46,
    "global_ayah_id": 2978,
    "translation": "그때 마술사들 모두가 땅에 부복하며"
  },
  {
    "surah_id": 26,
    "ayah_number": 47,
    "global_ayah_id": 2979,
    "translation": "말하길 저희는 실로 만유의 주님을 믿고"
  },
  {
    "surah_id": 26,
    "ayah_number": 48,
    "global_ayah_id": 2980,
    "translation": "모세의 주님이시며 아론의 주님을 믿나이다 라고 하자"
  },
  {
    "surah_id": 26,
    "ayah_number": 49,
    "global_ayah_id": 2981,
    "translation": "파라오가 말하길 내가 너희 에게 허락하기 전에 그를 믿는단 말이뇨 분명 그는 너희에게 마술 을 가르쳐 준 우두머리이거늘 너 희는 곧 알게 되리라 나는 너희의손과 발을 서로 다르게 절단하여 너희 모두를 십자가에 달아 놓으 리라"
  },
  {
    "surah_id": 26,
    "ayah_number": 50,
    "global_ayah_id": 2982,
    "translation": "이때 그들이 말하길 아무런 피해가 없나이다 저희는 분명 주 님께로 돌아가나이다"
  },
  {
    "surah_id": 26,
    "ayah_number": 51,
    "global_ayah_id": 2983,
    "translation": "진실로 저희는 주님께서 저 희의 죄를 사하여 주시어 저희가 최초로 믿는 자들이 되기를 바라 나이다"
  },
  {
    "surah_id": 26,
    "ayah_number": 52,
    "global_ayah_id": 2984,
    "translation": "하나님이 모세에게 계시하여나의 종들을 데리고 길을 떠나라 너희가 추적을 당하리라 하니"
  },
  {
    "surah_id": 26,
    "ayah_number": 53,
    "global_ayah_id": 2985,
    "translation": "파라오는 모든 도시로 심부 름 꾼들을 보내며 말하길"
  },
  {
    "surah_id": 26,
    "ayah_number": 54,
    "global_ayah_id": 2986,
    "translation": "실로 이들은 소수의 무리로"
  },
  {
    "surah_id": 26,
    "ayah_number": 55,
    "global_ayah_id": 2987,
    "translation": "우리들에게 격분하고 있으나"
  },
  {
    "surah_id": 26,
    "ayah_number": 56,
    "global_ayah_id": 2988,
    "translation": "우리 모두는 주의 깊게 감사하고 있노라"
  },
  {
    "surah_id": 26,
    "ayah_number": 57,
    "global_ayah_id": 2989,
    "translation": "그러나 하나님은 그들을 낙 원과 샘으로부터 추방하였고"
  },
  {
    "surah_id": 26,
    "ayah_number": 58,
    "global_ayah_id": 2990,
    "translation": "보물들과 명예로운 위치에서추방하고서"
  },
  {
    "surah_id": 26,
    "ayah_number": 59,
    "global_ayah_id": 2991,
    "translation": "이스라엘 자손들을 그러한 것들의 상속자로 하였더니"
  },
  {
    "surah_id": 26,
    "ayah_number": 60,
    "global_ayah_id": 2992,
    "translation": "그들은 동녘에 그들을 추적 하였으며"
  },
  {
    "surah_id": 26,
    "ayah_number": 61,
    "global_ayah_id": 2993,
    "translation": "쌍방이 서로 보았더라 이때 모세의 추종자들이 고함을 지르며 우리가 패배하고 있습니다"
  },
  {
    "surah_id": 26,
    "ayah_number": 62,
    "global_ayah_id": 2994,
    "translation": "결코 그렇지 아니하거늘 나 의 주님께서는 나와 같이 하시어 나를 인도하시니라"
  },
  {
    "surah_id": 26,
    "ayah_number": 63,
    "global_ayah_id": 2995,
    "translation": "하나님이 모세에게 계시하여너의 지광이로 바다를 때리라 하 니 바다가 두 갈래로 갈라져 양쪽부분이 거대한 산처럼 되었더라"
  },
  {
    "surah_id": 26,
    "ayah_number": 64,
    "global_ayah_id": 2996,
    "translation": "하나님은 상대편을 접근하 도록 하여 익사케 하고"
  },
  {
    "surah_id": 26,
    "ayah_number": 65,
    "global_ayah_id": 2997,
    "translation": "모세와 그리고 그를 동반한 모두를 구출한 후"
  },
  {
    "surah_id": 26,
    "ayah_number": 66,
    "global_ayah_id": 2998,
    "translation": "다른 편을 익사케 하였노라"
  },
  {
    "surah_id": 26,
    "ayah_number": 67,
    "global_ayah_id": 2999,
    "translation": "실로 그 안에는 예증이 있거늘 그래도 그들 대다수는 믿지 아니하더라"
  },
  {
    "surah_id": 26,
    "ayah_number": 68,
    "global_ayah_id": 3000,
    "translation": "진실로 주넘은 권능과 자비 로 충만하심이라"
  },
  {
    "surah_id": 26,
    "ayah_number": 69,
    "global_ayah_id": 3001,
    "translation": "그들에게 아브라함의 얘기를들려주라"
  },
  {
    "surah_id": 26,
    "ayah_number": 70,
    "global_ayah_id": 3002,
    "translation": "그가 그의 아버지와 그의 백성에게 무엇을 숭배하고 있습니까말했을 때"
  },
  {
    "surah_id": 26,
    "ayah_number": 71,
    "global_ayah_id": 3003,
    "translation": "그들이 대답하길 우리는 우 상들을 숭배하며 이에 헌신하니라"
  },
  {
    "surah_id": 26,
    "ayah_number": 72,
    "global_ayah_id": 3004,
    "translation": "그가 말하길 여러분이 기도 드릴때 그들이 여러분에게 귀를 기울이던가요"
  },
  {
    "surah_id": 26,
    "ayah_number": 73,
    "global_ayah_id": 3005,
    "translation": "아니면 유용하던가요 아니면해를 끼치던가요"
  },
  {
    "surah_id": 26,
    "ayah_number": 74,
    "global_ayah_id": 3006,
    "translation": "그들이 대답하길 그렇지 아 니하며 우리의 선조들이 그와 같 이 행함을 보았도다"
  },
  {
    "surah_id": 26,
    "ayah_number": 75,
    "global_ayah_id": 3007,
    "translation": "그가 말하길 여러분은 여러 분이 숭배하고 있는 것이 무엇인 지 알고 있느뇨"
  },
  {
    "surah_id": 26,
    "ayah_number": 76,
    "global_ayah_id": 3008,
    "translation": "여러분과 여러분의 옛조상들이 숭배한 것은 무엇입니까"
  },
  {
    "surah_id": 26,
    "ayah_number": 77,
    "global_ayah_id": 3009,
    "translation": "그것들은 나의 적으로 나는 만유의 주님만을 경배하니"
  },
  {
    "surah_id": 26,
    "ayah_number": 78,
    "global_ayah_id": 3010,
    "translation": "그분은 나를 창조하셨고 또 나를 인도하시며"
  },
  {
    "surah_id": 26,
    "ayah_number": 79,
    "global_ayah_id": 3011,
    "translation": "그분은 나에게 일용할 양식 을 주시고 마실 음료수를 주시며"
  },
  {
    "surah_id": 26,
    "ayah_number": 80,
    "global_ayah_id": 3012,
    "translation": "내가 병들었을 때 나를 치료하여 주시며"
  },
  {
    "surah_id": 26,
    "ayah_number": 81,
    "global_ayah_id": 3013,
    "translation": "나의 생명을 앗아가신 후 생명을 주시는 분이시며"
  },
  {
    "surah_id": 26,
    "ayah_number": 82,
    "global_ayah_id": 3014,
    "translation": "심판의 날 나의 잘못을 사하 여 주시기를 내가 기도하는 분이 십니다"
  },
  {
    "surah_id": 26,
    "ayah_number": 83,
    "global_ayah_id": 3015,
    "translation": "주여 저에게 지혜를 주옵시 고 의로운 사람 가운데 있게 하여 주소서"
  },
  {
    "surah_id": 26,
    "ayah_number": 84,
    "global_ayah_id": 3016,
    "translation": "다음 세대에서 제가 의로운 자로 입에 오르도록 하여 주소서"
  },
  {
    "surah_id": 26,
    "ayah_number": 85,
    "global_ayah_id": 3017,
    "translation": "축복받은 낙원의 상속자들 중에 한 상속자가 되게 하여 주옵 소서"
  },
  {
    "surah_id": 26,
    "ayah_number": 86,
    "global_ayah_id": 3018,
    "translation": "저의 아버지께 관용을 베풀 어 주옵소서 그분은 방황하는 자 가운데 있었나이다"
  },
  {
    "surah_id": 26,
    "ayah_number": 87,
    "global_ayah_id": 3019,
    "translation": "부활 되는 날 부끄럽지 않는 자가 되게 하여 주소서"
  },
  {
    "surah_id": 26,
    "ayah_number": 88,
    "global_ayah_id": 3020,
    "translation": "그날은 재산도 자신도 소용 이 없는 날입니다."
  },
  {
    "surah_id": 26,
    "ayah_number": 89,
    "global_ayah_id": 3021,
    "translation": "그러나 정직한 마음으로 하 나님께 오는 자는 제외이거늘"
  },
  {
    "surah_id": 26,
    "ayah_number": 90,
    "global_ayah_id": 3022,
    "translation": "정직하게 사는 자들을 위해 천국이 가까이 있을 것이며"
  },
  {
    "surah_id": 26,
    "ayah_number": 91,
    "global_ayah_id": 3023,
    "translation": "사악한 자들을 위해서는 지 옥이 나타날 것이니"
  },
  {
    "surah_id": 26,
    "ayah_number": 92,
    "global_ayah_id": 3024,
    "translation": "너희가 숭배하는 신들이 어 디 있느뇨 라고 그들은 질문을 받 으리라"
  },
  {
    "surah_id": 26,
    "ayah_number": 93,
    "global_ayah_id": 3025,
    "translation": "하나님 외에 그것들이 너희 를 돕거나 스스로를 도울 수 있느뇨"
  },
  {
    "surah_id": 26,
    "ayah_number": 94,
    "global_ayah_id": 3026,
    "translation": "이 우상들과 사악한 자들은 머리를 앞으로 하고 볼지옥으로 던져질 것이며"
  },
  {
    "surah_id": 26,
    "ayah_number": 95,
    "global_ayah_id": 3027,
    "translation": "이블리스의 군대 모두도 그 러하리라"
  },
  {
    "surah_id": 26,
    "ayah_number": 96,
    "global_ayah_id": 3028,
    "translation": "그들은 그 안에서 서로 싸우 면서 말하나니"
  },
  {
    "surah_id": 26,
    "ayah_number": 97,
    "global_ayah_id": 3029,
    "translation": "하나님이여 저희가 실로 잘 못 하였나이다"
  },
  {
    "surah_id": 26,
    "ayah_number": 98,
    "global_ayah_id": 3030,
    "translation": "그때 저희가 그것을 만유의 주님과 동등한 위치로 숭배하였나 이다"
  },
  {
    "surah_id": 26,
    "ayah_number": 99,
    "global_ayah_id": 3031,
    "translation": "저희를 잘못 인도한 자는 바 로 죄인들이었습니다"
  },
  {
    "surah_id": 26,
    "ayah_number": 100,
    "global_ayah_id": 3032,
    "translation": "그리하여 저희에게는 중재 자도 없으며"
  },
  {
    "surah_id": 26,
    "ayah_number": 101,
    "global_ayah_id": 3033,
    "translation": "가까운 친구도 없나이다"
  },
  {
    "surah_id": 26,
    "ayah_number": 102,
    "global_ayah_id": 3034,
    "translation": "지금 저희가 돌아갈 수 있 는 기희가 있다면 저희는 믿는자 들이 될텐데"
  },
  {
    "surah_id": 26,
    "ayah_number": 103,
    "global_ayah_id": 3035,
    "translation": "실로 그 안에는 예증이 있 으나 그들 대다수는 믿지 아니 하 였더라"
  },
  {
    "surah_id": 26,
    "ayah_number": 104,
    "global_ayah_id": 3036,
    "translation": "실로 그대의 주님은 권능과자비로 충만하심이라"
  },
  {
    "surah_id": 26,
    "ayah_number": 105,
    "global_ayah_id": 3037,
    "translation": "노아의 백성들도 선지자들 을 부정했으니"
  },
  {
    "surah_id": 26,
    "ayah_number": 106,
    "global_ayah_id": 3038,
    "translation": "그들의 형제 노아가 그들에게 말했더라 하나님을 두려워하지 않느뇨"
  },
  {
    "surah_id": 26,
    "ayah_number": 107,
    "global_ayah_id": 3039,
    "translation": "실로 내가 너희를 위한 믿 음의 선지자라"
  },
  {
    "surah_id": 26,
    "ayah_number": 108,
    "global_ayah_id": 3040,
    "translation": "그러므로 하나님을 두려워 하고 나에게 순종하라"
  },
  {
    "surah_id": 26,
    "ayah_number": 109,
    "global_ayah_id": 3041,
    "translation": "나는 너희에게 그에 대한 보상을 요구하지 아니하매 실로 나의 보상은 만유의 주님께서 주 시니라"
  },
  {
    "surah_id": 26,
    "ayah_number": 110,
    "global_ayah_id": 3042,
    "translation": "그러나 하나님을 두려워 하고 나에게 순종하라"
  },
  {
    "surah_id": 26,
    "ayah_number": 111,
    "global_ayah_id": 3043,
    "translation": "그들이 대답하길 가장 미 천한 자들이 따르고 있는 너를 믿 으란 말이뇨"
  },
  {
    "surah_id": 26,
    "ayah_number": 112,
    "global_ayah_id": 3044,
    "translation": "그가 말하길 그들이 행하 고 있는 것이 무엇인지 아는바 없 도다"
  },
  {
    "surah_id": 26,
    "ayah_number": 113,
    "global_ayah_id": 3045,
    "translation": "그들의 계산은 단지 주님께있음을 너희는 알고 있으리라"
  },
  {
    "surah_id": 26,
    "ayah_number": 114,
    "global_ayah_id": 3046,
    "translation": "내가 믿는 자들을 추방하는자가 아니며"
  },
  {
    "surah_id": 26,
    "ayah_number": 115,
    "global_ayah_id": 3047,
    "translation": "실로 나는 분명한 경고자라"
  },
  {
    "surah_id": 26,
    "ayah_number": 116,
    "global_ayah_id": 3048,
    "translation": "이때 그들이 말하길 노아여네가 만일 단념하지 않는다면 너 는 돌에 맞아 죽게 되리라"
  },
  {
    "surah_id": 26,
    "ayah_number": 117,
    "global_ayah_id": 3049,
    "translation": "그가 말하길 주여 저의 백 성들이 저를 거역하나이다"
  },
  {
    "surah_id": 26,
    "ayah_number": 118,
    "global_ayah_id": 3050,
    "translation": "저와 그들 사이를 판결하여주시고 저와 더불어 믿는 자들을 구하여 주소서"
  },
  {
    "surah_id": 26,
    "ayah_number": 119,
    "global_ayah_id": 3051,
    "translation": "하나님은 그와 함께 짐을 가득실은 배에 탄 자들을 구하였 노라"
  },
  {
    "surah_id": 26,
    "ayah_number": 120,
    "global_ayah_id": 3052,
    "translation": "그런 후 하나님은 뒤에 남 은 자들을 익사케 했으니"
  },
  {
    "surah_id": 26,
    "ayah_number": 121,
    "global_ayah_id": 3053,
    "translation": "실로 그 안에는 예증이 있 었으나 그들 대다수는 믿지 아니 하였더라"
  },
  {
    "surah_id": 26,
    "ayah_number": 122,
    "global_ayah_id": 3054,
    "translation": "실로 그대의 주님은 권능과자비로 충만하심이라"
  },
  {
    "surah_id": 26,
    "ayah_number": 123,
    "global_ayah_id": 3055,
    "translation": "아드의 백성도 선지자들을 부정했으니"
  },
  {
    "surah_id": 26,
    "ayah_number": 124,
    "global_ayah_id": 3056,
    "translation": "그들의 형제 후드가 말하길 너희는 하나님을 두려워 하지 않 느뇨"
  },
  {
    "surah_id": 26,
    "ayah_number": 125,
    "global_ayah_id": 3057,
    "translation": "실로 내가 너희를 위한 믿 음의 선지자라"
  },
  {
    "surah_id": 26,
    "ayah_number": 126,
    "global_ayah_id": 3058,
    "translation": "그러므로 하나님을 두려워 하고 나에게 순종하라"
  },
  {
    "surah_id": 26,
    "ayah_number": 127,
    "global_ayah_id": 3059,
    "translation": "그로 인하여 내가 보상을 요구하지 아니하니 나의 보상은 만유의 주님으로부터 있노라"
  },
  {
    "surah_id": 26,
    "ayah_number": 128,
    "global_ayah_id": 3060,
    "translation": "너희는 높은 곳마다 공허한향락을 위해 건물을 세우느뇨"
  },
  {
    "surah_id": 26,
    "ayah_number": 129,
    "global_ayah_id": 3061,
    "translation": "너희가 영생하고자 궁전 을 세우느뇨"
  },
  {
    "surah_id": 26,
    "ayah_number": 130,
    "global_ayah_id": 3062,
    "translation": "너희는 타인을 공격함에 폭 군처럼 공격했노라"
  },
  {
    "surah_id": 26,
    "ayah_number": 131,
    "global_ayah_id": 3063,
    "translation": "하나님을 두려워 하고 나에 게 순종하라"
  },
  {
    "surah_id": 26,
    "ayah_number": 132,
    "global_ayah_id": 3064,
    "translation": "너희가 알고 있는 모든 것 을 주신 분을 두려워 하라"
  },
  {
    "surah_id": 26,
    "ayah_number": 133,
    "global_ayah_id": 3065,
    "translation": "그분께서는 가축들과 자손 들을 너희에게 주셨으며"
  },
  {
    "surah_id": 26,
    "ayah_number": 134,
    "global_ayah_id": 3066,
    "translation": "낙원과 우물도 주셨노라"
  },
  {
    "surah_id": 26,
    "ayah_number": 135,
    "global_ayah_id": 3067,
    "translation": "실로 나는 심판의 날 너희 에게 내려질 벌이 두렵도다"
  },
  {
    "surah_id": 26,
    "ayah_number": 136,
    "global_ayah_id": 3068,
    "translation": "그들이 대답하길 네가 설교 하든 아니하든 우리에게는 마찬가 지라"
  },
  {
    "surah_id": 26,
    "ayah_number": 137,
    "global_ayah_id": 3069,
    "translation": "실로 이것은 옛 선조들의 관습에 불과하며"
  },
  {
    "surah_id": 26,
    "ayah_number": 138,
    "global_ayah_id": 3070,
    "translation": "우리는 벌을 받지 아니하도다"
  },
  {
    "surah_id": 26,
    "ayah_number": 139,
    "global_ayah_id": 3071,
    "translation": "이렇게 그들이 그를 부정 하매 하나님은 그들을 멸망시켰노 라 그 안에는 예증이 있으나 그들 대다수는 믿지 아니 하더라"
  },
  {
    "surah_id": 26,
    "ayah_number": 140,
    "global_ayah_id": 3072,
    "translation": "실로 그대의 주님은 전능과 자비로 충만하심이라"
  },
  {
    "surah_id": 26,
    "ayah_number": 141,
    "global_ayah_id": 3073,
    "translation": "사무드의 백성은 선지자들 을 부정했으니"
  },
  {
    "surah_id": 26,
    "ayah_number": 142,
    "global_ayah_id": 3074,
    "translation": "그들의 형제 살레가 그들에게 말했더라 하나님을 두려워하지 않느뇨"
  },
  {
    "surah_id": 26,
    "ayah_number": 143,
    "global_ayah_id": 3075,
    "translation": "실로 나는 너희를 위한 믿 음의 선지자라"
  },
  {
    "surah_id": 26,
    "ayah_number": 144,
    "global_ayah_id": 3076,
    "translation": "그러므로 하나님을 두려워 하고 나에게 순종하라"
  },
  {
    "surah_id": 26,
    "ayah_number": 145,
    "global_ayah_id": 3077,
    "translation": "그로인하여 내가 보상을 요구하지 않나니 실로 나의 보상은 만유의 주님으로 부터 있노라"
  },
  {
    "surah_id": 26,
    "ayah_number": 146,
    "global_ayah_id": 3078,
    "translation": "이곳에서 너희가 소유한 것들이 너희의 향락을 위해 남아 있으리라 생각하느뇨"
  },
  {
    "surah_id": 26,
    "ayah_number": 147,
    "global_ayah_id": 3079,
    "translation": "정원과 샘터가"
  },
  {
    "surah_id": 26,
    "ayah_number": 148,
    "global_ayah_id": 3080,
    "translation": "경작지와 무르익어가는 종 려나무와"
  },
  {
    "surah_id": 26,
    "ayah_number": 149,
    "global_ayah_id": 3081,
    "translation": "너희가 돌로 정교하게 세운 집들이 그대로 안전하리라 생각하 느뇨"
  },
  {
    "surah_id": 26,
    "ayah_number": 150,
    "global_ayah_id": 3082,
    "translation": "하나님을 두려워하고 내게 순종하라"
  },
  {
    "surah_id": 26,
    "ayah_number": 151,
    "global_ayah_id": 3083,
    "translation": "방탕한 자들의 명령을 따르지 말라"
  },
  {
    "surah_id": 26,
    "ayah_number": 152,
    "global_ayah_id": 3084,
    "translation": "그들은 지상에서 사악함을 행할 뿐 개선하지 않는 자들이라"
  },
  {
    "surah_id": 26,
    "ayah_number": 153,
    "global_ayah_id": 3085,
    "translation": "그들이 말하길 너는 마술에걸려 있는 자 중에 하나라"
  },
  {
    "surah_id": 26,
    "ayah_number": 154,
    "global_ayah_id": 3086,
    "translation": "너는 우리와 다를바 없는 한 인간에 불과하니 네가 진실한 자 중에 있다면 그 예증을 대라"
  },
  {
    "surah_id": 26,
    "ayah_number": 155,
    "global_ayah_id": 3087,
    "translation": "이때 그가 대답하길 여기 암컷의 낙타가 있나니 정하여진 어느 날 이 낙타가 물을 마실 권 리가 있을 것이요 그리고 너희가 물을 마실 권리가 있을 것이라"
  },
  {
    "surah_id": 26,
    "ayah_number": 156,
    "global_ayah_id": 3088,
    "translation": "그 낙타를 해치지 말라 그 렇지 아니하면 위대한 날 징벌이 너희를 엄습하리라"
  },
  {
    "surah_id": 26,
    "ayah_number": 157,
    "global_ayah_id": 3089,
    "translation": "그들은 그 낙타를 살해하고서 후회하였으나"
  },
  {
    "surah_id": 26,
    "ayah_number": 158,
    "global_ayah_id": 3090,
    "translation": "그들에게 징벌이 내려졌노 라 실로 그 안에는 예중이 있었으 니 그들 대다수가 믿지 아니 하였 더라"
  },
  {
    "surah_id": 26,
    "ayah_number": 159,
    "global_ayah_id": 3091,
    "translation": "실로 그대의 주님은 권능과자비로 충만하심이라"
  },
  {
    "surah_id": 26,
    "ayah_number": 160,
    "global_ayah_id": 3092,
    "translation": "롯의 백성도 선지자들을 부정했으니"
  },
  {
    "surah_id": 26,
    "ayah_number": 161,
    "global_ayah_id": 3093,
    "translation": "그들의 형제 롯이 그들에게말했더라 너희는 하나님이 두렵지 않느뇨"
  },
  {
    "surah_id": 26,
    "ayah_number": 162,
    "global_ayah_id": 3094,
    "translation": "나는 너희를 위한 믿음의 선지자라"
  },
  {
    "surah_id": 26,
    "ayah_number": 163,
    "global_ayah_id": 3095,
    "translation": "하나님을 두려워 하고 나에게 순종하라"
  },
  {
    "surah_id": 26,
    "ayah_number": 164,
    "global_ayah_id": 3096,
    "translation": "그로 인하여 내가 보상을 요구하지 않나니 실로 나의 보상 은 만유의 주님으로부터 있노라"
  },
  {
    "surah_id": 26,
    "ayah_number": 165,
    "global_ayah_id": 3097,
    "translation": "너희는 우주의 모든 피조물 가운데서 남성에게만 접근하려 하 느뇨"
  },
  {
    "surah_id": 26,
    "ayah_number": 166,
    "global_ayah_id": 3098,
    "translation": "하나님께서 너희를 위해 창조하신 너희 배우자들을 버려 두 려 하느뇨 실로 너희는 한계를 넘 어선 백성들이라"
  },
  {
    "surah_id": 26,
    "ayah_number": 167,
    "global_ayah_id": 3099,
    "translation": "그들이 대답하길 롯이여 네가 단념하지 않는다면 너는 추방 당하는자 중에 있게 되리라"
  },
  {
    "surah_id": 26,
    "ayah_number": 168,
    "global_ayah_id": 3100,
    "translation": "그가 대답하되 실로 나는 너희의 행위를 중오하노라"
  },
  {
    "surah_id": 26,
    "ayah_number": 169,
    "global_ayah_id": 3101,
    "translation": "주여 저와 저의 가족을 그 들이 행하는 것으로부터 구하여 주소서"
  },
  {
    "surah_id": 26,
    "ayah_number": 170,
    "global_ayah_id": 3102,
    "translation": "그리하여 하나님은 그와 그의 가족 모두를 구원하고"
  },
  {
    "surah_id": 26,
    "ayah_number": 171,
    "global_ayah_id": 3103,
    "translation": "뒤에 남아있던 늙은 한 여 인과"
  },
  {
    "surah_id": 26,
    "ayah_number": 172,
    "global_ayah_id": 3104,
    "translation": "다른 자들을 멸망케 했노라"
  },
  {
    "surah_id": 26,
    "ayah_number": 173,
    "global_ayah_id": 3105,
    "translation": "그들 외에 돌 우박을 퍼부 었으니 이 돌 우박은 경고를 거역 한 백성에게 내려진 것이라"
  },
  {
    "surah_id": 26,
    "ayah_number": 174,
    "global_ayah_id": 3106,
    "translation": "실로 이 안에는 하나의 예 증이 있으나 그들 대다수는 믿지 아니 하였더라"
  },
  {
    "surah_id": 26,
    "ayah_number": 175,
    "global_ayah_id": 3107,
    "translation": "실로 그대의 주님은 권능과자비로 충만하노라"
  },
  {
    "surah_id": 26,
    "ayah_number": 176,
    "global_ayah_id": 3108,
    "translation": "메디얀의 백성들도 선지 자들을 부정했으니"
  },
  {
    "surah_id": 26,
    "ayah_number": 177,
    "global_ayah_id": 3109,
    "translation": "슈아이브가 그들에게 말 했더라 하나님이 두렵지 않느뇨"
  },
  {
    "surah_id": 26,
    "ayah_number": 178,
    "global_ayah_id": 3110,
    "translation": "나는 실로 너희를 위한 믿 음의 선지자라"
  },
  {
    "surah_id": 26,
    "ayah_number": 179,
    "global_ayah_id": 3111,
    "translation": "하나님을 두려워하고 나에 게 순종하라"
  },
  {
    "surah_id": 26,
    "ayah_number": 180,
    "global_ayah_id": 3112,
    "translation": "그로 인하여 내가 보상을 요구하지 않나니 실로 나의 보상 은 만유의 주님으로부터 있노라"
  },
  {
    "surah_id": 26,
    "ayah_number": 181,
    "global_ayah_id": 3113,
    "translation": "저울을 공정하게 하여 부정 으로 타인에게 손실을 끼치지 말라"
  },
  {
    "surah_id": 26,
    "ayah_number": 182,
    "global_ayah_id": 3114,
    "translation": "균형이 되도록 무게를 달라"
  },
  {
    "surah_id": 26,
    "ayah_number": 183,
    "global_ayah_id": 3115,
    "translation": "사람의 정당한 권리를 보류 하지 말며 지상에 해악을 퍼뜨리 지 말라"
  },
  {
    "surah_id": 26,
    "ayah_number": 184,
    "global_ayah_id": 3116,
    "translation": "너희를 창조하셨고 너희 선 조들을 창조한 그분을 두려워 하라"
  },
  {
    "surah_id": 26,
    "ayah_number": 185,
    "global_ayah_id": 3117,
    "translation": "그들이 말하길 네가 마술에 걸려 있노라"
  },
  {
    "surah_id": 26,
    "ayah_number": 186,
    "global_ayah_id": 3118,
    "translation": "너는 우리와 같은 한 인간 에 불과하노라 우리는 네가 거짓 말장이라 믿노라"
  },
  {
    "surah_id": 26,
    "ayah_number": 187,
    "global_ayah_id": 3119,
    "translation": "네가 진실이라면 하늘로부터우리에게 벌을 내리게 하여 보라"
  },
  {
    "surah_id": 26,
    "ayah_number": 188,
    "global_ayah_id": 3120,
    "translation": "그가 대답하길 나의 주님 께서는 너희가 행하는 모든 것을 아시고 계시니라"
  },
  {
    "surah_id": 26,
    "ayah_number": 189,
    "global_ayah_id": 3121,
    "translation": "그들은 그를 거역했으니 어둠의 날의 벌이 그들을 엄습했 노라 실로 그것은 위대한 날의 벌 이었노라"
  },
  {
    "surah_id": 26,
    "ayah_number": 190,
    "global_ayah_id": 3122,
    "translation": "실로 그안에는 예증이 있으 나 그들 대다수는 믿지 아니하였 더라"
  },
  {
    "surah_id": 26,
    "ayah_number": 191,
    "global_ayah_id": 3123,
    "translation": "실로 그대의 주님은 권능과 자비로 충만하심이라"
  },
  {
    "surah_id": 26,
    "ayah_number": 192,
    "global_ayah_id": 3124,
    "translation": "실로 이것온 만유의 주님 으로부터 계시된 것이라"
  },
  {
    "surah_id": 26,
    "ayah_number": 193,
    "global_ayah_id": 3125,
    "translation": "믿음의 성령이 그것을 가 지고 오시어"
  },
  {
    "surah_id": 26,
    "ayah_number": 194,
    "global_ayah_id": 3126,
    "translation": "그대 마음에 내리어 그것으 로 그대가 경고자가 되도록 하였 으며"
  },
  {
    "surah_id": 26,
    "ayah_number": 195,
    "global_ayah_id": 3127,
    "translation": "명료한 아랍어로 계시했노라"
  },
  {
    "surah_id": 26,
    "ayah_number": 196,
    "global_ayah_id": 3128,
    "translation": "그것은 선조들의 성서에 서도 언급이 되었거늘"
  },
  {
    "surah_id": 26,
    "ayah_number": 197,
    "global_ayah_id": 3129,
    "translation": "이스라엘 자손들의 학자들 이 그것이 사실임을 알고 있는 것 만으로도 예중이 되지 않느뇨"
  },
  {
    "surah_id": 26,
    "ayah_number": 198,
    "global_ayah_id": 3130,
    "translation": "만일 하나님이 비아랍인에 게 계시하여"
  },
  {
    "surah_id": 26,
    "ayah_number": 199,
    "global_ayah_id": 3131,
    "translation": "그것을 그들에게 낭송했더 라도 그들은 믿지 아니했으리라"
  },
  {
    "surah_id": 26,
    "ayah_number": 200,
    "global_ayah_id": 3132,
    "translation": "이렇게 하나님은 죄인들의 마음속에도 그것이 스며들게 했 지만"
  },
  {
    "surah_id": 26,
    "ayah_number": 201,
    "global_ayah_id": 3133,
    "translation": "고통스러운 벌을 목격할 때 까지는 믿으려 하지 않을 것이라"
  },
  {
    "surah_id": 26,
    "ayah_number": 202,
    "global_ayah_id": 3134,
    "translation": "그벌은 그들이 알지 못하는 사이에 갑자기 그들에게 도래하니"
  },
  {
    "surah_id": 26,
    "ayah_number": 203,
    "global_ayah_id": 3135,
    "translation": "그들은 말하리라 저희가 유 예 될 수 없을까요"
  },
  {
    "surah_id": 26,
    "ayah_number": 204,
    "global_ayah_id": 3136,
    "translation": "그들은 아직도 하나님의 벌을 재촉하고 있노라"
  },
  {
    "surah_id": 26,
    "ayah_number": 205,
    "global_ayah_id": 3137,
    "translation": "하나님이 그들로 하여금 수 년간 향락 하도록 한 것을 그대는 아느뇨"
  },
  {
    "surah_id": 26,
    "ayah_number": 206,
    "global_ayah_id": 3138,
    "translation": "약속된 벌이 드디어 그들에 게 이르니"
  },
  {
    "surah_id": 26,
    "ayah_number": 207,
    "global_ayah_id": 3139,
    "translation": "현세에서 즐겼던 향락이 그 들에게 유용하지 아니하더라"
  },
  {
    "surah_id": 26,
    "ayah_number": 208,
    "global_ayah_id": 3140,
    "translation": "하나님이 경고자를 보냈던 고을들을 멸망케 하여"
  },
  {
    "surah_id": 26,
    "ayah_number": 209,
    "global_ayah_id": 3141,
    "translation": "교훈이 되도록 하였으되 우 리는 결코 그들을 벌함에 부당하 지 아니 했노라"
  },
  {
    "surah_id": 26,
    "ayah_number": 210,
    "global_ayah_id": 3142,
    "translation": "사탄이 그것을 가지고 오 지 아니 했으며"
  },
  {
    "surah_id": 26,
    "ayah_number": 211,
    "global_ayah_id": 3143,
    "translation": "그것은 그들에게 적합하 지 아니하고 그렇게 할 능력도 없 노라"
  },
  {
    "surah_id": 26,
    "ayah_number": 212,
    "global_ayah_id": 3144,
    "translation": "그들은 그것을 듣는 기 회조차도 제외되어 있었노라"
  },
  {
    "surah_id": 26,
    "ayah_number": 213,
    "global_ayah_id": 3145,
    "translation": "하나님 외에 다른 신을 숭 배하지 발라 그렇지 아니하면 너 희도 벌을 받는 자 중에 있게 되 리라"
  },
  {
    "surah_id": 26,
    "ayah_number": 214,
    "global_ayah_id": 3146,
    "translation": "그대의 친척들에게 경고하라"
  },
  {
    "surah_id": 26,
    "ayah_number": 215,
    "global_ayah_id": 3147,
    "translation": "믿는자 중에서 그대를 따르 는 자에게는 그대의 날개를 낮추라"
  },
  {
    "surah_id": 26,
    "ayah_number": 216,
    "global_ayah_id": 3148,
    "translation": "그들이 그대에게 거역한다 면 일러가로되 실로 나는 너희가 행하는 모든 일에 책임이 없노라"
  },
  {
    "surah_id": 26,
    "ayah_number": 217,
    "global_ayah_id": 3149,
    "translation": "전능과 자비로 충만하신 분 에게 의지하라"
  },
  {
    "surah_id": 26,
    "ayah_number": 218,
    "global_ayah_id": 3150,
    "translation": "그분은 예배하기 위해 홀로 서 있는 그대를 보고 계시며"
  },
  {
    "surah_id": 26,
    "ayah_number": 219,
    "global_ayah_id": 3151,
    "translation": "그대가 엎드려 예배하는 자 들 중에 있을 때도 보고 계시나니"
  },
  {
    "surah_id": 26,
    "ayah_number": 220,
    "global_ayah_id": 3152,
    "translation": "실로 그분은 들으심과 아심 으로 충만하심이라"
  },
  {
    "surah_id": 26,
    "ayah_number": 221,
    "global_ayah_id": 3153,
    "translation": "일러가로되 사탄들이 누구 에게 내려오는지 너희에게 일러주리요"
  },
  {
    "surah_id": 26,
    "ayah_number": 222,
    "global_ayah_id": 3154,
    "translation": "그들은 거짓하고 사악한 모든 자들에게 내려 올 뿐이라"
  },
  {
    "surah_id": 26,
    "ayah_number": 223,
    "global_ayah_id": 3155,
    "translation": "그들은 귀를 기울이나 그들대다수는 거짓하는 자들이라"
  },
  {
    "surah_id": 26,
    "ayah_number": 224,
    "global_ayah_id": 3156,
    "translation": "시인들은 사악속에서 방 황하며 그들을 따르는 자들이라"
  },
  {
    "surah_id": 26,
    "ayah_number": 225,
    "global_ayah_id": 3157,
    "translation": "그들이 모든 계곡에서 이성을 잃고 방황하는 것을 너희는 보지 않했느뇨"
  },
  {
    "surah_id": 26,
    "ayah_number": 226,
    "global_ayah_id": 3158,
    "translation": "그들은 그들이 행하지도 아니한 것을 말하고 있노라"
  },
  {
    "surah_id": 26,
    "ayah_number": 227,
    "global_ayah_id": 3159,
    "translation": "그러나 믿음을 갖고 선을 행하며 항상 하나님을 염원하고 박해를 받은 후에도 스스로를 보 호하는 자들은 제외라 사악한 행 위를 저지른 자들은 그들이 돌아 갈 최후의 운명이 무엇인지 알게 되니라"
  }
]