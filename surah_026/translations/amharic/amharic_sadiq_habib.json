    "translation": "«ምርመራቸው በጌታዬ ላይ እንጅ በሌላ ላይ አይደለም፡፡ ብታውቁ ኖሮ (ይህንን ትርረዱ ነበር)፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 114,
    "global_ayah_id": 3046,
    "translation": "«እኔም አማኞችን አባራሪ አይደለሁም፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 115,
    "global_ayah_id": 3047,
    "translation": "«እኔ ግልጽ አስፈራሪ እንጅ ሌላ አይደለሁም፡፡»"
  },
  {
    "surah_id": 26,
    "ayah_number": 116,
    "global_ayah_id": 3048,
    "translation": "«ኑሕ ሆይ! (ከምትለው) ባትከለከል በእርግጥ ከሚወገሩት ትኾናለህ» አሉት፡፡"
