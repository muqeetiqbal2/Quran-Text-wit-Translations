    "ayah_number": 112,
    "global_ayah_id": 3044,
    "translation": "(እርሱም) አላቸው «ይሠሩት በነበሩት ነገር ምን ዕውቀት አለኝ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 113,
