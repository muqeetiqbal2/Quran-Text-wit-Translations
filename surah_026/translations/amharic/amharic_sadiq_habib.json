[
  {
    "surah_id": 26,
    "ayah_number": 1,
    "global_ayah_id": 2933,
    "translation": "ጠ.ሰ.መ. (ጧ ሲን ሚም)፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 2,
    "global_ayah_id": 2934,
    "translation": "ይህች ግልጽ ከኾነው መጽሐፍ አንቀጾች ናት፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 3,
    "global_ayah_id": 2935,
    "translation": "አማኞች ባለመኾናቸው፤ (በቁጭት) ነፍስህን ገዳይ መኾን ይፈራልሃል፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 4,
    "global_ayah_id": 2936,
    "translation": "ብንሻ በእነሱ ላይ ከሰማይ ተዓምረን እናወርድና አንገቶቻቸው (መሪዎቻቸው) ለእርሷ ተዋራጆች ይኾናሉ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 5,
    "global_ayah_id": 2937,
    "translation": "ከአልረሕማንም ዘንድ ኣዲስ የተወረደ ቁርኣን አይመጣላቸውም፤ ከእርሱ የሚሸሹ ቢኾኑ እንጂ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 6,
    "global_ayah_id": 2938,
    "translation": "በእርግጥም አስተባበሉ፡፡ የዚያም በእርሱ ይሳለቁበት የነበሩት ወሬዎች (ፍጻሜ) ይመጣባቸዋል፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 7,
    "global_ayah_id": 2939,
    "translation": "ወደ ምድርም በውስጧ ከመልካም (በቃይ) ጎሳ ሁሉ ብዙን እንዳበቀልን አላዩምን፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 8,
    "global_ayah_id": 2940,
    "translation": "በዚህ አስደናቂ ምልክት አልለበት፡፡ አብዛኞቻቸውም አማኞች አልነበሩም፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 9,
    "global_ayah_id": 2941,
    "translation": "ጌታህም እርሱ በእርግጥ አሸናፊ አዛኝ ነው፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 10,
    "global_ayah_id": 2942,
    "translation": "ጌታህም ሙሳን «ወደ በደለኞቹ ሕዝቦች ኺድ» በማለት በጠራው ጊዜ (አስታውስ)፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 11,
    "global_ayah_id": 2943,
    "translation": "«ወደ ፈርዖን ሕዝቦች (ኺድ) አላህን አይፈሩምን» (አለው)፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 12,
    "global_ayah_id": 2944,
    "translation": "(ሙሳም) አለ «ጌታዬ ሆይ! እኔ ሊያስተባብሉኝ እፈራለሁ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 13,
    "global_ayah_id": 2945,
    "translation": "«ልቤም ይጠብባል፡፡ ምላሴም አይፈታም፡፡ ስለዚህ ወደ ሃሩን ላክ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 14,
    "global_ayah_id": 2946,
    "translation": "«ለእነርሱም በእኔ ላይ (የደም) ወንጀል አልለ፡፡ ስለዚህ እንዳይገድሉኝ እፈራለሁ፡፡»"
  },
  {
    "surah_id": 26,
    "ayah_number": 15,
    "global_ayah_id": 2947,
    "translation": "(አላህ) አለ «ተው! (አይነኩህም)፡፡ በተዓምራቶቻችንም ኺዱ፡፡ እኛ ከእናንተ ጋር ሰሚዎች ነንና፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 16,
    "global_ayah_id": 2948,
    "translation": "«ወደ ፈርዖንም ኺዱ፡፡ በሉትም፡- እኛ የዓለማት ጌታ መልክተኞች ነን፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 17,
    "global_ayah_id": 2949,
    "translation": "«የእስራኤልን ልጆች ከእኛ ጋር ልቀቅ፡፡»"
  },
  {
    "surah_id": 26,
    "ayah_number": 18,
    "global_ayah_id": 2950,
    "translation": "(ፈርዖንም) አለ «ልጅ ኾነህ በእኛ ውስጥ አላሳደግንህምን በእኛ ውስጥም ከዕድሜህ ብዙ ዓመታትን አልተቀመጥክምን"
  },
  {
    "surah_id": 26,
    "ayah_number": 19,
    "global_ayah_id": 2951,
    "translation": "«ያችንም የሠራሃትን ሥራህን አልሠራህምን አንተም ከውለታ ቢሶቹ ነህ» (አለ)፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 20,
    "global_ayah_id": 2952,
    "translation": "(ሙሳም) አለ «ያን ጊዜ እኔም ከተሳሳቱት ኾኜ ሠራኋት፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 21,
    "global_ayah_id": 2953,
    "translation": "«በፈራኋችሁም ጊዜ ከእንናተ ሸሸሁ፡፡ ጌታየም ለእኔ ጥበብን ሰጠኝ፡፡ ከመልክተኞቹም አደረገኝ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 22,
    "global_ayah_id": 2954,
    "translation": "«ይህችም የእስራኤልን ልጆች ባሪያ በማድረግህ በእኔ ላይ የምትመጻደቅባት ጸጋ ነት፡፡»"
  },
  {
    "surah_id": 26,
    "ayah_number": 23,
    "global_ayah_id": 2955,
    "translation": "ፈርዖን አለ «(ላከኝ የምትለው) የዓለማትም ጌታ ምንድነው»"
  },
  {
    "surah_id": 26,
    "ayah_number": 24,
    "global_ayah_id": 2956,
    "translation": "(ሙሳ) «የሰማያትና የምድር በመካከላቸውም ያለው ሁሉ ጌታ ነው፡፡ የምታረጋግጡ ብትኾኑ (ነገሩ ይህ ነው)፤» አለው፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 25,
    "global_ayah_id": 2957,
    "translation": "(ፈርዖንም) በዙሪያው ላሉት ሰዎች «አትሰሙምን» አለ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 26,
    "global_ayah_id": 2958,
    "translation": "(ሙሳ) «ጌታችሁና የመጀመሪያዎቹ አባቶቻችሁም ጌታ ነው» አለው፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 27,
    "global_ayah_id": 2959,
    "translation": "(ፈርዖን)\t«ያ ወደእናንተ የተላከው መልክተኛችሁ በእርግጥ ዕብድ ነው» አለ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 28,
    "global_ayah_id": 2960,
    "translation": "(ሙሳ) «የምሥራቅና የምዕራብ በመካከላቸውም ያለው ነገር ሁሉ ጌታ ነው፡፡ ታውቁ እንደኾናችሁ (እመኑበት)» አለው፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 29,
    "global_ayah_id": 2961,
    "translation": "(ፈርዖን) «ከእኔ ሌላ አምላክን ብትይዝ በውነቱ ከእስረኞቹ አደርግሃለሁ» አለ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 30,
    "global_ayah_id": 2962,
    "translation": "(ሙሳ) «በግልጽ አስረጅ ብመጣህም እንኳ» አለው፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 31,
    "global_ayah_id": 2963,
    "translation": "«እንግዲያውስ ከእውነተኞች እንደኾንክ (አስረጁን) አምጣው» አለ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 32,
    "global_ayah_id": 2964,
    "translation": "በትሩንም ጣለ፡፡ እርሷም ወዲያውኑ ግልጽ እባብ ኾነች፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 33,
    "global_ayah_id": 2965,
    "translation": "እጁንም አወጣ፡፡ ወዲያውም እርሷ ለተመልካቾች (የምታበራ) ነጭ ኾነች፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 34,
    "global_ayah_id": 2966,
    "translation": "(ፈርዖን) በዙሪያው ላሉት መማክርት «ይህ በእርግጥ ዐዋቂ ድግምተኛ ነው» አለ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 35,
    "global_ayah_id": 2967,
    "translation": "«ከምድራችሁ በድግምቱ ሊያወጣችሁ ይፈልጋልና ምንን ታዛላችሁ» (አላቸው)፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 36,
    "global_ayah_id": 2968,
    "translation": "አሉት «እርሱን ወንድሙንም አቆይና በየከተሞቹ ሰብሳቢዎችን ላክ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 37,
    "global_ayah_id": 2969,
    "translation": "«በጣም ዐዋቂ ድግምተኞችን ሁሉ ያመጡልሃልና፡፡»"
  },
  {
    "surah_id": 26,
    "ayah_number": 38,
    "global_ayah_id": 2970,
    "translation": "ድግምተኞቹም በታወቀ ቀን ቀጠሮ ተሰበሰቡ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 39,
    "global_ayah_id": 2971,
    "translation": "ለሰዎቹም «እናንተ ተሰብስባችኋልን» ተባለ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 40,
    "global_ayah_id": 2972,
    "translation": "«ድግምተኞቹን እነሱ አሸናፊዎች ቢኾኑ እንከተል ዘንድ» (ተባለ)፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 41,
    "global_ayah_id": 2973,
    "translation": "«ድግምተኞቹም በመጡ ጊዜ ለፈርዖን እኛ አሸናፊዎች ብንሆን ለእኛ በእርግጥ ዋጋ አለን» አሉት፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 42,
    "global_ayah_id": 2974,
    "translation": "«አዎን፤ እናንተም ያን ጊዜ ከባለሟሎቹ ትኾናላችሁ» አላቸው፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 43,
    "global_ayah_id": 2975,
    "translation": "ሙሳ «ለእነርሱ እናንተ የምትጥሉትን ጣሉ» አላቸው፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 44,
    "global_ayah_id": 2976,
    "translation": "ገመዶቻቸውንና በትሮቻቸውንም ጣሉ፡፡ «በፈርዖንም ክብር ይኹንብን፡፡ እኛ በእርግጥ አሸናፊዎቹ እኛ ነን» አሉ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 45,
    "global_ayah_id": 2977,
    "translation": "ሙሳም በትሩን ጣለ፡፡ ወዲያውም እርሷ የሚያስመስሉትን ሁሉ ትውጣለች፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 46,
    "global_ayah_id": 2978,
    "translation": "ድግምተኞቹም ሰጋጆች ኾነው ወደቁ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 47,
    "global_ayah_id": 2979,
    "translation": "(እነሱም) አሉ «በዓለማት ጌታ አመንን፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 48,
    "global_ayah_id": 2980,
    "translation": "«በሙሳና በሃሩን ጌታ፡፡»"
  },
  {
    "surah_id": 26,
    "ayah_number": 49,
    "global_ayah_id": 2981,
    "translation": "(ፈርዖንም) «ለእናንተ ሳልፈቅድላችሁ በፊት ለእርሱ አመናችሁን እርሱ ያ ድግምትን ያስተማራችሁ ታላቃችሁ ነው፡፡ ወደፊትም (የሚያገኛችሁን) በእርግጥ ታውቃላችሁ፡፡ እጆቻችሁንና እግሮቻችሁን (ቀኝና ግራን) በማናጋት እቆረርጣለሁ፡፡ ሁላችሁንም እሰቅላችኋለሁም» አለ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 50,
    "global_ayah_id": 2982,
    "translation": "(እነርሱም) አሉ «ጉዳት የለብንም፡፡ እኛ ወደ ጌታችን ተመላሾች ነን፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 51,
    "global_ayah_id": 2983,
    "translation": "«እኛ የምእምናን መጀመሪያ በመኾናችን ጌታችን ኀጢአቶቻችንን ለእኛ ሊምር እንከጅላለን፡፡»"
  },
  {
    "surah_id": 26,
    "ayah_number": 52,
    "global_ayah_id": 2984,
    "translation": "ወደ ሙሳም «ባሮቼን ይዘህ ሌሊት ኺድ፡፡ እናንተ የሚከተሉዋችሁ ናችሁና» ስንል ላክን፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 53,
    "global_ayah_id": 2985,
    "translation": "ፈርዖንም በየከተሞቹ ሰብሳቢዎችን (እንዲህ ሲል) ላከ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 54,
    "global_ayah_id": 2986,
    "translation": "«እነዚህ ጥቂቶች ጭፈሮች ናቸው፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 55,
    "global_ayah_id": 2987,
    "translation": "«እነርሱም ለእኛ አስቆጪዎች ናቸው፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 56,
    "global_ayah_id": 2988,
    "translation": "«እኛም ብዙዎች ጥንቁቆች ነን፤» (አለ)፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 57,
    "global_ayah_id": 2989,
    "translation": "አወጣናቸውም፡፡ ከአትክልቶችና ከምንጮች፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 58,
    "global_ayah_id": 2990,
    "translation": "ከድልቦችም ከመልካም መቀመጫዎችም፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 59,
    "global_ayah_id": 2991,
    "translation": "እንደዚሁ ለእስራኤል ልጆች አወረስናትም፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 60,
    "global_ayah_id": 2992,
    "translation": "ፀሐይዋ ስትወጣም ተከተሉዋቸው፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 61,
    "global_ayah_id": 2993,
    "translation": "ሁለቱ ጭፍሮችም በተያዩ ጊዜ የሙሳ ጓዶች «እኛ(የፈርዖን ሰዎች) የሚደርሱብን ነን» አሉ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 62,
    "global_ayah_id": 2994,
    "translation": "(ሙሳ) «ተዉዉ! ጌታዬ ከእኔ ጋር ነው፡፡ በእርግጥ ይመራኛል» አለ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 63,
    "global_ayah_id": 2995,
    "translation": "ወደ ሙሳም «ባሕሩን በበትርህ ምታው» ስንል ላክንበት፡፡ (መታውና) ተከፈለም፡፡ ክፍሉም ሁሉ እንደ ታላቅ ጋራ ኾነ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 64,
    "global_ayah_id": 2996,
    "translation": "እዚያም ዘንድ ሌሎችን አቀረብን፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 65,
    "global_ayah_id": 2997,
    "translation": "ሙሳንም ከእርሱ ገር ያሉትንም ሰዎች ሁሉንም አዳን፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 66,
    "global_ayah_id": 2998,
    "translation": "ከዚያም ሌሎቹን አሰጠምን፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 67,
    "global_ayah_id": 2999,
    "translation": "በዚህ ውስጥ ታላቅ ታምር አለበት፡፡ አብዛኞቻቸውም አማኞች አልነበሩም፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 68,
    "global_ayah_id": 3000,
    "translation": "ጌታህም እርሱ አሸናፊው አዛኙ ነው፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 69,
    "global_ayah_id": 3001,
    "translation": "በእነሱም (በሕዝቦችህ) ላይ የኢብራሂምን ወሬ አንብብላቸው፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 70,
    "global_ayah_id": 3002,
    "translation": "ለአባቱና ለሕዝቦቹ «ምንን ትግገዛላችሁ» ባለ ጊዜ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 71,
    "global_ayah_id": 3003,
    "translation": "«ጣዖታትን እንገዛለን፤ እርሷንም በመገዛት ላይ እንቆያለን» አሉ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 72,
    "global_ayah_id": 3004,
    "translation": "(እርሱም) አለ «በጠራችኋቸው ጊዜ ይሰሟችኋልን"
  },
  {
    "surah_id": 26,
    "ayah_number": 73,
    "global_ayah_id": 3005,
    "translation": "«ወይስ ይጠቅሟችኋልን ወይስ ይጎዷችኋልን»"
  },
  {
    "surah_id": 26,
    "ayah_number": 74,
    "global_ayah_id": 3006,
    "translation": "«የለም! አባቶቻችን እንደዚሁ ሲሠሩ አገኘን» አሉት፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 75,
    "global_ayah_id": 3007,
    "translation": "«ትግገዙት የነበራችሁትን አስተዋላችሁን"
  },
  {
    "surah_id": 26,
    "ayah_number": 76,
    "global_ayah_id": 3008,
    "translation": "«እናንተም የቀድሞዎቹ አባቶቻችሁም (የተግገዛችሁትን)፡፡»"
  },
  {
    "surah_id": 26,
    "ayah_number": 77,
    "global_ayah_id": 3009,
    "translation": "«እነሱም (ጣዖቶቹ) ለእኔ ጠላቶች ናቸው፡፡ ግን የዓለማት ጌታ ሲቀር (እርሱ ወዳጄ ነው)፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 78,
    "global_ayah_id": 3010,
    "translation": "«(እርሱ) ያ የፈጠረኝ ነው፡፡ እርሱም ይመራኛል፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 79,
    "global_ayah_id": 3011,
    "translation": "«ያም እርሱ የሚያበላኝና የሚያጠጣኝ ነው፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 80,
    "global_ayah_id": 3012,
    "translation": "«በታመምኩም ጊዜ እርሱ ያሽረኛል፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 81,
    "global_ayah_id": 3013,
    "translation": "«ያም የሚገድለኝ ከዚያም ሕያው የሚያደርገኝ ነው፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 82,
    "global_ayah_id": 3014,
    "translation": "ያም በፍርዱ ቀን ኀጢአቴን ለእኔ ሊምር የምከጅለው ነው፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 83,
    "global_ayah_id": 3015,
    "translation": "ጌታዬ ሆይ! ዕውቀትን ስጠኝ! በደጋጎቹም ሰዎች አስጠጋኝ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 84,
    "global_ayah_id": 3016,
    "translation": "በኋለኞቹም ሕዝቦች ውስጥ ለእኔ መልካም ዝናን አድርግልኝ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 85,
    "global_ayah_id": 3017,
    "translation": "የጸጋይቱን ገነት ከሚወርሱትም አድርገኝ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 86,
    "global_ayah_id": 3018,
    "translation": "ለአባቴም ማር፡፡ እርሱ ከተሳሳቱት ነበረና፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 87,
    "global_ayah_id": 3019,
    "translation": "በሚቀሰቀሱበት ቀንም አታዋርደኝ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 88,
    "global_ayah_id": 3020,
    "translation": "ገንዘብም ልጆችም በማይጠቅሙበት ቀን፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 89,
    "global_ayah_id": 3021,
    "translation": "ወደ አላህ በንጹህ ልብ የመጣ ሰው ቢኾን እንጅ፡፡»"
  },
  {
    "surah_id": 26,
    "ayah_number": 90,
    "global_ayah_id": 3022,
    "translation": "ገነትም ለፈሪዎች በምትቀረብበት (ቀን)፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 91,
    "global_ayah_id": 3023,
    "translation": "ገሀነምም ለጠመሞች በምትገለጽበት (ቀን)፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 92,
    "global_ayah_id": 3024,
    "translation": "ለእነሱም በሚባል ቀን «ትግገዟቸው የነበራችሁት የት ናቸው»"
  },
  {
    "surah_id": 26,
    "ayah_number": 93,
    "global_ayah_id": 3025,
    "translation": "«ከአላህ ሌላ ሲኾኑ ይረዱዋችኋልን ወይስ (ለራሳቸው) ይርረዳሉን»"
  },
  {
    "surah_id": 26,
    "ayah_number": 94,
    "global_ayah_id": 3026,
    "translation": "በውስጧም እነሱና ጠማሞቹ በፊቶቻቸው ተጥለው ይንከባለላሉ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 95,
    "global_ayah_id": 3027,
    "translation": "የሰይጣንም ሰራዊቶች መላውም (ይጣላሉ)፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 96,
    "global_ayah_id": 3028,
    "translation": "እነርሱም በእርሷ ውስጥ የሚከራከሩ ኾነው ይላሉ፡-"
  },
  {
    "surah_id": 26,
    "ayah_number": 97,
    "global_ayah_id": 3029,
    "translation": "በአላህ እንምላለን፤ እኛ በግልጽ መሳሳት ውስጥ ነበርን፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 98,
    "global_ayah_id": 3030,
    "translation": "(ጣዖቶቹን) በዓለማት ጌታ ባስተካከልናችሁ ጊዜ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 99,
    "global_ayah_id": 3031,
    "translation": "አመጸኞቹም እንጅ ሌላ አላሳሳተንም፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 100,
    "global_ayah_id": 3032,
    "translation": "ከአማላጆችም ለእኛ ምንም የለንም፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 101,
    "global_ayah_id": 3033,
    "translation": "አዛኝ ወዳጂም (የለንም)፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 102,
    "global_ayah_id": 3034,
    "translation": "ለእኛም አንዲት ጊዜ መመለስ በኖረችንና ከአማኞቹ በኾን እንመኛለን (ይላሉ)፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 103,
    "global_ayah_id": 3035,
    "translation": "በዚህ ውስጥ አስደናቂ ግሳጼ አልለበት፡፡ አብዛኞቻቸውም አማኞች አልነበሩም፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 104,
    "global_ayah_id": 3036,
    "translation": "ጌታህም እርሱ በእርግጥ አሸናፊው አዛኙ ነው፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 105,
    "global_ayah_id": 3037,
    "translation": "የኑሕ ሕዝቦች መልክተኞችን አስተባበሉ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 106,
    "global_ayah_id": 3038,
    "translation": "ወንድማቸው ኑሕ ለእነሱ ባላቸው ጊዜ «አትጠነቀቁምን"
  },
  {
