    "surah_id": 26,
    "ayah_number": 127,
    "global_ayah_id": 3059,
    "translation": "«በእርሱም ላይ ምንም ዋጋ አለምናችሁም፡፡ ዋጋዬ በዓለማት ጌታ ላይ እንጅ በሌላ ላይ አይደለም፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 128,
    "global_ayah_id": 3060,
    "translation": "«የምትጫወቱ ኾናችሁ በከፍተኛ ስፍራ ሁሉ ላይ ምልክትን ትገነባላችሁን"
