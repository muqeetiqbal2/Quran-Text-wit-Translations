    "ayah_number": 159,
    "global_ayah_id": 3091,
    "translation": "ጌታህም እርሱ በእርግጥ አሸናፊው አዛኙ ነው፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 160,
