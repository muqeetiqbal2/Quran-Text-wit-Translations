    "surah_id": 26,
    "ayah_number": 119,
    "global_ayah_id": 3051,
    "translation": "እርሱንም ከእርሱ ጋር ያለውንም ሁሉ በተመላው መርከብ ውስጥ አዳን፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 120,
    "global_ayah_id": 3052,
    "translation": "ከዚያም በኋላ ቀሪዎቹን አሰጠምን፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 121,
    "global_ayah_id": 3053,
    "translation": "በዚህ ውስጥ ታላቅ ግሳጼ አለበት፡፡ አብዛኞቻቸውም አማኞች አልነበሩም፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 122,
    "global_ayah_id": 3054,
    "translation": "ጌታህም እርሱ በእርግጥ አሸናፊው አዛኙ ነው፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 123,
    "global_ayah_id": 3055,
    "translation": "ዓድ መልክተኞችን አስተባበለች፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 124,
    "global_ayah_id": 3056,
    "translation": "ወንድማቸው ሁድ ለነርሱ ባላቸው ጊዜ «አትጠነቀቁምን"
  },
  {
    "surah_id": 26,
    "ayah_number": 125,
    "global_ayah_id": 3057,
    "translation": "«እኔ ለናንተ ታማኝ መልክተኛ ነኝ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 126,
    "global_ayah_id": 3058,
    "translation": "«አላህንም ፍሩ ታዘዙኝም፡፡"
  },
