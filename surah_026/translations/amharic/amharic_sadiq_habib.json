  },
  {
    "surah_id": 26,
    "ayah_number": 153,
    "global_ayah_id": 3085,
    "translation": "(እነሱም) አሉ «አንተ በብዙ ከተደገመባቸው ሰዎች ብቻ ነህ፡፡"
  },
