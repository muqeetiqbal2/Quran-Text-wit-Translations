    "ayah_number": 150,
    "global_ayah_id": 3082,
    "translation": "«አላህንም ፍሩ፤ ታዘዙኝም፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 151,
    "global_ayah_id": 3083,
    "translation": "«የወሰን አላፊዎችንም ትዕዛዝ አትከተሉ፡፡"
