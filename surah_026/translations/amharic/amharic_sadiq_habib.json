    "ayah_number": 162,
    "global_ayah_id": 3094,
    "translation": "«እኔ ለእናንተ ታማኝ መልክተኛ ነኝ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 163,
    "global_ayah_id": 3095,
    "translation": "«አላህንም ፍሩ፤ ታዘዙኝም፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 164,
    "global_ayah_id": 3096,
    "translation": "«በእርሱም ላይ ምንም ዋጋ አልለምናችሁም፡፡ ዋጋዬ በዓለማት ጌታ ላይ እንጅ በሌላ ላይ አይደለም፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 165,
    "global_ayah_id": 3097,
    "translation": "«ከዓለማት ሰዎች ወንዶችን ትመጣላችሁን"
  },
  {
    "surah_id": 26,
    "ayah_number": 166,
    "global_ayah_id": 3098,
    "translation": "«ከሚስቶቻችሁም ጌታችሁ ለናንተ የፈጠረላችሁን ትተዋላችሁን በእውነቱ እናንተ ወሰን አላፊዎች ሕዝቦ ናችሁ፡፡»"
  },
  {
    "surah_id": 26,
    "ayah_number": 167,
    "global_ayah_id": 3099,
    "translation": "(እነርሱም) አሉ «ሉጥ ሆይ! ባትከለከል በእርግጥ (ከአገር) ከሚወጡት ትኾናለህ፡፡»"
  },
  {
    "surah_id": 26,
    "ayah_number": 168,
    "global_ayah_id": 3100,
    "translation": "(እርሱም) አለ «እኔ ሥራችሁን ከሚጠሉት ሰዎች ነኝ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 169,
    "global_ayah_id": 3101,
    "translation": "«ጌታዬ ሆይ! እኔንም ቤተሰቦቼንም ከሚሠሩት ሥራ (ቅጣት) አድነን፡፡»"
  },
  {
    "surah_id": 26,
    "ayah_number": 170,
    "global_ayah_id": 3102,
    "translation": "እርሱንም ቤተሰቦቹንም በጠቅላላ አዳንናቸው፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 171,
    "global_ayah_id": 3103,
    "translation": "በቀሪዎቹ ውስጥ የኾነች አሮጊት ብቻ ስትቀር (እርሷ ጠፋች)፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 172,
    "global_ayah_id": 3104,
    "translation": "ከዚያም ሌሎቹን አጠፋን፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 173,
    "global_ayah_id": 3105,
    "translation": "በእነሱም ላይ (የድንጋይን) ዝናምን አዘነምንባቸው፡፡ የተስፈራሪዎቹም ዝናም (ምንኛ) ከፋ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 174,
    "global_ayah_id": 3106,
    "translation": "በዚህ ውስጥ አስደናቂ ተዓምር አልለበት፡፡ አብዛኞቻቸውም ምእመናን አልነበሩም፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 175,
    "global_ayah_id": 3107,
    "translation": "ጌታህም እርሱ በእርግጥ አሸናፊው አዛኙ ነው፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 176,
    "global_ayah_id": 3108,
    "translation": "የአይከት ሰዎች መልክተኞችን አስተባበሉ፤"
  },
  {
    "surah_id": 26,
    "ayah_number": 177,
    "global_ayah_id": 3109,
    "translation": "ሹዕይብ ለእነርሱ ባላቸው ጊዜ «አትጠነቀቁምን"
  },
  {
    "surah_id": 26,
    "ayah_number": 178,
    "global_ayah_id": 3110,
    "translation": "«እኔ ለእናንተ ታማኝ መልክተኛ ነኝ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 179,
    "global_ayah_id": 3111,
    "translation": "«አላህንም ፍሩ፤ ታዘዙኝም፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 180,
    "global_ayah_id": 3112,
    "translation": "«በርሱም ላይ ምንም ዋጋ አልጠይቃችሁም፡፡ ዋጋዬ በዓለማት ጌታ ላይ እንጅ በሌላ ላይ አይደለም፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 181,
    "global_ayah_id": 3113,
    "translation": "«ስፍርን ሙሉ፡፡ ከአጉዳዮቹም አትኹኑ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 182,
    "global_ayah_id": 3114,
    "translation": "«በትክክለኛ ሚዛንም መዝኑ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 183,
    "global_ayah_id": 3115,
    "translation": "«ሰዎችንም ነገሮቻቸውን አታጉድሉባቸው፡፡ በምድርም ላይ አጥፊዎች ኾናችሁ አታበላሹ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 184,
    "global_ayah_id": 3116,
    "translation": "«ያንንም የፈጠራችሁን የቀድሞዎቹንም ፍጡሮች (የፈጠረውን) ፍሩ፡፡»"
  },
  {
    "surah_id": 26,
    "ayah_number": 185,
    "global_ayah_id": 3117,
    "translation": "አሉ «አንተ በብዛት ከተደገመባቸው ሰዎች ነህ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 186,
    "global_ayah_id": 3118,
    "translation": "«አንተም ብጤያችን ሰው እንጅ ሌላ አይደለህም፡፡ እነሆ ከውሸታሞች ነህ ብለን እንጠረጥርሃለን፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 187,
    "global_ayah_id": 3119,
    "translation": "«ከእውነተኞቹም እንደኾንክ በእኛ ላይ ከሰማይ ቁራጭን ጣልብን፡፡»"
  },
  {
    "surah_id": 26,
    "ayah_number": 188,
    "global_ayah_id": 3120,
    "translation": "«ጌታዬ የምትሠሩትን ሁሉ ዐዋቂ ነው፤» አላቸው፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 189,
    "global_ayah_id": 3121,
    "translation": "አስተባበሉትም፡፡ የጥላይቷ ቀን ቅጣትም ያዛቸው፡፡ እርሱ የከባድ ቀን ቅጣት ነበርና፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 190,
    "global_ayah_id": 3122,
    "translation": "በዚህ ውስጥ አስደናቂ ተዓምር አልለበት፡፡ አብዛኞቻቸውም ምእምናን አልነበሩም፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 191,
    "global_ayah_id": 3123,
    "translation": "ጌታህም እርሱ በእርግጥ አሸናፊው አዛኙ ነው፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 192,
    "global_ayah_id": 3124,
    "translation": "እርሱም (ቁርኣን) በእርግጥ ከዓለማት ጌታ የተወረደ ነው፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 193,
    "global_ayah_id": 3125,
    "translation": "እርሱን ታማኙ መንፈስ (ጂብሪል) አወረደው፤"
  },
  {
    "surah_id": 26,
    "ayah_number": 194,
    "global_ayah_id": 3126,
    "translation": "ከአስፈራሪዎቹ (ነቢያት) ትኾን ዘንድ በልብህ ላይ (አወረደው)፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 195,
    "global_ayah_id": 3127,
    "translation": "ግልጽ በኾነ ዐረብኛ ቋንቋ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 196,
    "global_ayah_id": 3128,
    "translation": "እርሱም (ቁርኣን) በቀድሞዎቹ መጻሐፍት ውስጥ (የተወሳ ነው)፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 197,
    "global_ayah_id": 3129,
    "translation": "የእስራኤል ልጆች ሊቃውንት የሚያውቁት መኾኑ ለእነርሱ (ለመካ ከሓዲዎች) ምልክት አይኾናቸውምን"
  },
  {
    "surah_id": 26,
    "ayah_number": 198,
    "global_ayah_id": 3130,
    "translation": "ከአዕጀሞች ባንዱ ላይ ባወረድነውም ኖሮ፤"
  },
  {
    "surah_id": 26,
    "ayah_number": 199,
    "global_ayah_id": 3131,
    "translation": "በእነርሱ ላይ ባነበበውም በእርሱ አማኞች አይኾኑም ነበር፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 200,
    "global_ayah_id": 3132,
    "translation": "እንደዚሁ (ማስተባበልን) በተንኮለኞች ልቦች ውስጥ አስገባነው፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 201,
    "global_ayah_id": 3133,
    "translation": "አሳማሚ ቅጣትን እስከሚያዩ ድረስ በእርሱ አያምኑም፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 202,
    "global_ayah_id": 3134,
    "translation": "እነርሱ የማያውቁ ሲኾኑ (ቅጣቱ) ድንገት እስከሚመጣባቸውም ድረስ (አያምኑም)፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 203,
    "global_ayah_id": 3135,
    "translation": "(በመጣባቸው ጊዜ) «እኛ የምንቆይ ነን» እስከሚሉም (አያምኑም)፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 204,
    "global_ayah_id": 3136,
    "translation": "በቅጣታችን ያቻኩላሉን"
  },
  {
    "surah_id": 26,
    "ayah_number": 205,
    "global_ayah_id": 3137,
    "translation": "አየህን ብዙ ዓመታትን ብናጣቅማቸው፤"
  },
  {
    "surah_id": 26,
    "ayah_number": 206,
    "global_ayah_id": 3138,
    "translation": "ከዚያም ያ ይስፈራሩበት የነበሩት ቢመጣባቸው፤"
  },
  {
    "surah_id": 26,
    "ayah_number": 207,
    "global_ayah_id": 3139,
    "translation": "ይጣቀሙበት የነበሩት ሁሉ ከእነሱ ምንም አያብቃቃቸውም፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 208,
    "global_ayah_id": 3140,
    "translation": "አንዲትንም ከተማ ለእርሷ አስፈራሪዎች ያሏት (እና ያስተባበለች) ኾና እንጅ አላጠፋንም፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 209,
    "global_ayah_id": 3141,
    "translation": "(ይህች) ግሳፄ ናት፡፡ በዳዮችም አልነበርንም፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 210,
    "global_ayah_id": 3142,
    "translation": "ሰይጣናትም እርሱን (ቁርኣንን) አላወረዱትም፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 211,
    "global_ayah_id": 3143,
    "translation": "ለእነርሱም አይገባቸውም፤ አይችሉምም፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 212,
    "global_ayah_id": 3144,
    "translation": "እነርሱ (የመላእክትን ንግግር) ከመስማት ተከለከሉ ናቸው፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 213,
    "global_ayah_id": 3145,
    "translation": "ከአላህም ጋር ሌላን አምላክ አትግገዛ፤ ከሚቀጡት ትኾናለህና፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 214,
    "global_ayah_id": 3146,
    "translation": "ቅርቦች ዘመዶችህንም አስጠንቅቅ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 215,
    "global_ayah_id": 3147,
    "translation": "ከምእምናንም ለተከተሉህ ሰዎች ክንፍህን ዝቅ አድርግ፤ (ልዝብ ኹን)፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 216,
    "global_ayah_id": 3148,
    "translation": "«እንቢ» ቢሉህም «እኔ ከምትሠሩት ንጹሕ ነኝ» በላቸው፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 217,
    "global_ayah_id": 3149,
    "translation": "አሸናፊ አዛኝ በኾነው (ጌታህ) ላይም ተጠጋ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 218,
    "global_ayah_id": 3150,
    "translation": "በዚያ ለሶላት በምትቆም ጊዜ በሚያይህ፡፡"
  },
  {
