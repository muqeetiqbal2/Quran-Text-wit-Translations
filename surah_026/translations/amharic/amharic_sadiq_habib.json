    "surah_id": 26,
    "ayah_number": 156,
    "global_ayah_id": 3088,
    "translation": "«በክፉም አትንኳት፡፡ የታላቅ ቀን ቅጣት ይይዛችኋልና፡፡»"
  },
  {
    "surah_id": 26,
    "ayah_number": 157,
    "global_ayah_id": 3089,
    "translation": "ወጓትም፡፡ ወዲያውም ተጸጻቾች ኾነው አነጉ፡፡"
  },
  {
    "surah_id": 26,
    "ayah_number": 158,
    "global_ayah_id": 3090,
    "translation": "ቅጣቱም ያዛቸው፡፡ በዚህም ውስጥ ግሳፄ አልለበት፡፡ አብዛኞቻቸውም ምእመናን አልነበሩም፡፡"
  },
