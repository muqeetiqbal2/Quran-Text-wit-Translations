[
  {
    "surah_id": 95,
    "ayah_number": 0,
    "global_ayah_id": 6192,
    "translation": "﻿अल्लाहच्या नावाने,जो अत्यंत दयावंत व असीम कृपावंत आहे."
  },
  {
    "surah_id": 95,
    "ayah_number": 1,
    "global_ayah_id": 6193,
    "translation": "शपथ आहे अंजीर व जैतुनची,"
  },
  {
    "surah_id": 95,
    "ayah_number": 2,
    "global_ayah_id": 6194,
    "translation": "आणि तुर-ए-सीना"
  },
  {
    "surah_id": 95,
    "ayah_number": 3,
    "global_ayah_id": 6195,
    "translation": "आणि या शांततापूर्ण (मक्का) शहराची,"
  },
  {
    "surah_id": 95,
    "ayah_number": 4,
    "global_ayah_id": 6196,
    "translation": "आम्ही मानवाला उत्कृष्ट रचनेत निर्माण केले,"
  },
  {
    "surah_id": 95,
    "ayah_number": 5,
    "global_ayah_id": 6197,
    "translation": "मग उलट फिरवून आम्ही त्याला निकृष्टात निकृष्ट करून टाकले,"
  },
  {
    "surah_id": 95,
    "ayah_number": 6,
    "global_ayah_id": 6198,
    "translation": "त्या लोकांखेरीज ज्यांनी श्रद्धा ठेवली आणि सत्कृत्ये करीत राहिले की त्यांच्यासाठी कधी न संपणारा मोबदला आहे."
  },
  {
    "surah_id": 95,
    "ayah_number": 7,
    "global_ayah_id": 6199,
    "translation": "तर (हे पैगंबर (स.)) यानंतर कोण मोबदला व शिक्षेच्या बाबतीत तुम्हाला खोटे ठरवू शकतो?"
  },
  {
    "surah_id": 95,
    "ayah_number": 8,
    "global_ayah_id": 6200,
    "translation": "काय अल्लाह सर्व शासकांपेक्षा मोठा शासक नाही?"
  }
]