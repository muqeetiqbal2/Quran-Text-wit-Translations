    "translation": "och detta trygga land!"
  },
  {
    "surah_id": 95,
    "ayah_number": 4,
    "global_ayah_id": 6102,
    "translation": "Vi har sannerligen skapat människan i den bästa skepnad"
  },
  {
    "surah_id": 95,
    "ayah_number": 5,
    "global_ayah_id": 6103,
    "translation": "men därefter låtit henne sjunka lägre än de lägsta,"
  },
  {
    "surah_id": 95,
    "ayah_number": 6,
    "global_ayah_id": 6104,
    "translation": "utom dem som tror och lever ett rättskaffens liv; ja, deras lön skall vara utan ände!"
  },
  {
    "surah_id": 95,
    "ayah_number": 7,
    "global_ayah_id": 6105,
    "translation": "Vad kan hädanefter förmå dig [människa] att påstå att förkunnelsen [om uppståndelse, räkenskap och dom] är lögn?"
  },
  {
    "surah_id": 95,
    "ayah_number": 8,
    "global_ayah_id": 6106,
    "translation": "Är inte Gud den visaste av domare?"
  }
