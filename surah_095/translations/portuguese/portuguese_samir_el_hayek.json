    "translation": "Pelo monte Sinai,"
  },
  {
    "surah_id": 95,
    "ayah_number": 3,
    "global_ayah_id": 6101,
    "translation": "E por esta metrópole segura (Makka),"
  },
  {
    "surah_id": 95,
    "ayah_number": 4,
    "global_ayah_id": 6102,
    "translation": "Que criamos o homem na mais perfeita proporção."
  },
  {
    "surah_id": 95,
    "ayah_number": 5,
    "global_ayah_id": 6103,
    "translation": "Então, o reduzimos à mais baixa das escalas,"
  },
  {
    "surah_id": 95,
    "ayah_number": 6,
    "global_ayah_id": 6104,
    "translation": "Salvo os fiéis, que praticam o bem; estes terão uma recompensa infalível."
  },
  {
    "surah_id": 95,
    "ayah_number": 7,
    "global_ayah_id": 6105,
    "translation": "Quem, então, depois disso, te contradirá, quanto ao Dia do Juízo?"
  },
  {
    "surah_id": 95,
    "ayah_number": 8,
    "global_ayah_id": 6106,
    "translation": "Acaso, não é Deus o mais prudente dos juízes?"
  }
