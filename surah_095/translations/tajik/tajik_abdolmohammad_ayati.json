[
  {
    "surah_id": 95,
    "ayah_number": 1,
    "global_ayah_id": 6099,
    "translation": "Савганд ба анҷиру зайтун"
  },
  {
    "surah_id": 95,
    "ayah_number": 2,
    "global_ayah_id": 6100,
    "translation": "савганд ба Тури муборак,"
  },
  {
    "surah_id": 95,
    "ayah_number": 3,
    "global_ayah_id": 6101,
    "translation": "савганд ба ин шаҳри эмин,"
  },
  {
    "surah_id": 95,
    "ayah_number": 4,
    "global_ayah_id": 6102,
    "translation": "ки мо одамиро дар некӯтарин сурате биёфаридем."
  },
  {
    "surah_id": 95,
    "ayah_number": 5,
    "global_ayah_id": 6103,
    "translation": "Он гоҳ ӯро фурӯтар аз ҳамаи фурӯтарон гардонидем, (пасттар аз ҳамаи пастҳо)"
  },
  {
    "surah_id": 95,
    "ayah_number": 6,
    "global_ayah_id": 6104,
    "translation": "ғайри онон, ки имон овардаанд ва корҳои шоиста кардаанд, ки музде бепоён доранд."
  },
  {
    "surah_id": 95,
    "ayah_number": 7,
    "global_ayah_id": 6105,
    "translation": "Пас чист, ки бо ин ҳол туро ба дурӯғ шуморидани қиёмат вомедорад?"
  },
  {
    "surah_id": 95,
    "ayah_number": 8,
    "global_ayah_id": 6106,
    "translation": "Оё Худо довартарини доварон нест?"
  }
]