[
  {
    "surah_id": 95,
    "ayah_number": 1,
    "global_ayah_id": 6099,
    "translation": "Pasha fikun dhe ullirin!"
  },
  {
    "surah_id": 95,
    "ayah_number": 2,
    "global_ayah_id": 6100,
    "translation": "Dhe (kodrën) Turi Sina-en!"
  },
  {
    "surah_id": 95,
    "ayah_number": 3,
    "global_ayah_id": 6101,
    "translation": "Dhe këtë qytet të sigurisë!"
  },
  {
    "surah_id": 95,
    "ayah_number": 4,
    "global_ayah_id": 6102,
    "translation": "Vërtet, Ne e krijuam njerin në formën më të bukur."
  },
  {
    "surah_id": 95,
    "ayah_number": 5,
    "global_ayah_id": 6103,
    "translation": "Pastaj e zbritëm atë në më të ultin e të ultëve."
  },
  {
    "surah_id": 95,
    "ayah_number": 6,
    "global_ayah_id": 6104,
    "translation": "Përveç atyre që besuan dhe bënë vepra të mira; ata kanë shpërblim të pandërprerë."
  },
  {
    "surah_id": 95,
    "ayah_number": 7,
    "global_ayah_id": 6105,
    "translation": "E pas gjithë kësaj, ç’të shtyri të përgënjeshtrosh ditën e shpërblimit (përgjegjësisë)?"
  },
  {
    "surah_id": 95,
    "ayah_number": 8,
    "global_ayah_id": 6106,
    "translation": "A nuk është All-llahu më i urti gjykuesve?"
  }
]