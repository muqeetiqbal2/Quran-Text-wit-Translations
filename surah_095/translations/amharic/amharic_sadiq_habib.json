[
  {
    "surah_id": 95,
    "ayah_number": 1,
    "global_ayah_id": 6099,
    "translation": "በበለስና በዘይት ወይራ እምላለሁ፡፡"
  },
  {
    "surah_id": 95,
    "ayah_number": 2,
    "global_ayah_id": 6100,
    "translation": "በሲኒን ተራራም፤"
  },
  {
    "surah_id": 95,
    "ayah_number": 3,
    "global_ayah_id": 6101,
    "translation": "በዚህ በጸጥተኛው አገርም (እምላለሁ)፡፡"
  },
  {
    "surah_id": 95,
    "ayah_number": 4,
    "global_ayah_id": 6102,
    "translation": "ሰውን በጣም በአማረ አቋም ላይ ፈጠርነው፡፡"
  },
  {
    "surah_id": 95,
    "ayah_number": 5,
    "global_ayah_id": 6103,
    "translation": "ከዚያም (ከፊሉን) ከዝቅተኞች ሁሉ በታች አድርገን መለስነው፡፡"
  },
  {
    "surah_id": 95,
    "ayah_number": 6,
    "global_ayah_id": 6104,
    "translation": "ግን እነዚያ ያመኑት መልካሞችንም የሠሩት ለእነርሱ ተቆራጭ ያልኾነ ምንዳ አልላቸው፡፡"
  },
  {
    "surah_id": 95,
    "ayah_number": 7,
    "global_ayah_id": 6105,
    "translation": "ታዲያ ከዚህ በኋላ በፍርዱ ምን አስተባባይ አደረገህ?"
  },
  {
    "surah_id": 95,
    "ayah_number": 8,
    "global_ayah_id": 6106,
    "translation": "አላህ ከፈራጆች ሁሉ ይበልጥ ፈራጅ አይደለምን? (ነው)፡፡"
  }
]