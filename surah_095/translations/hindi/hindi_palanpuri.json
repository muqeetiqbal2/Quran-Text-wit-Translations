    "global_ayah_id": 6192,
    "translation": "अल्लाह के नाम से जो बड़ा कृपालु और अत्यन्त दयावान है।"
  },
  {
    "surah_id": 95,
    "ayah_number": 1,
    "global_ayah_id": 6193,
    "translation": "साक्षी है तीन और ज़ैतून"
  },
  {
    "surah_id": 95,
    "ayah_number": 2,
    "global_ayah_id": 6194,
    "translation": "और तूर सीनीन,"
  },
  {
    "surah_id": 95,
    "ayah_number": 3,
    "global_ayah_id": 6195,
    "translation": "और यह शान्तिपूर्ण भूमि (मक्का)"
  },
  {
    "surah_id": 95,
    "ayah_number": 4,
    "global_ayah_id": 6196,
    "translation": "निस्संदेह हम ने मनुष्य को सर्वोत्तम संरचना के साथ पैदा किया"
  },
  {
    "surah_id": 95,
    "ayah_number": 5,
    "global_ayah_id": 6197,
    "translation": "फिर हम ने उसे निकृष्टतम दशा की ओर लौटा दिया, जबकि वह स्वयं गिरने वाला बना"
  },
  {
    "surah_id": 95,
    "ayah_number": 6,
    "global_ayah_id": 6198,
    "translation": "सिवाय उन लोगों के जो ईमान लाए और जिन्होंने अच्छे कर्म किए, तो उन के लिए कभी न समाप्त होने वाला बदला है"
  },
  {
    "surah_id": 95,
    "ayah_number": 7,
    "global_ayah_id": 6199,
    "translation": "अब इस के बाद क्या है, जो बदले के विषय में तुम्हें झुठलाए?"
  },
  {
    "surah_id": 95,
    "ayah_number": 8,
    "global_ayah_id": 6200,
    "translation": "क्या अल्लाह सब हाकिमों से बड़ा हाकिम नहीं हैं?"
  }
]