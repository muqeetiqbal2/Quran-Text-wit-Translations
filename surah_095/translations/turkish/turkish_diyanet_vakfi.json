[
  {
    "surah_id": 95,
    "ayah_number": 1,
    "global_ayah_id": 6099,
    "translation": "İncire, zeytine,"
  },
  {
    "surah_id": 95,
    "ayah_number": 2,
    "global_ayah_id": 6100,
    "translation": "Sina dağına,"
  },
  {
    "surah_id": 95,
    "ayah_number": 3,
    "global_ayah_id": 6101,
    "translation": "Ve şu emin beldeye yemin ederim ki,"
  },
  {
    "surah_id": 95,
    "ayah_number": 4,
    "global_ayah_id": 6102,
    "translation": "Biz insanı en güzel biçimde yarattık."
  },
  {
    "surah_id": 95,
    "ayah_number": 5,
    "global_ayah_id": 6103,
    "translation": "Sonra da çevirdik aşağıların aşağısına attık."
  },
  {
    "surah_id": 95,
    "ayah_number": 6,
    "global_ayah_id": 6104,
    "translation": "Fakat iman edip salih amel işleyenler için eksilmeyen devamlı bir ecir vardır."
  },
  {
    "surah_id": 95,
    "ayah_number": 7,
    "global_ayah_id": 6105,
    "translation": "Artık bundan sonra, ceza günü konusunda seni kim yalanlayabilir?"
  },
  {
    "surah_id": 95,
    "ayah_number": 8,
    "global_ayah_id": 6106,
    "translation": "Allah, hüküm verenlerin en üstünü değil midir?"
  }
]