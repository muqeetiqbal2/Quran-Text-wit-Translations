  {
    "surah_id": 95,
    "ayah_number": 4,
    "global_ayah_id": 6102,
    "translation": "Biz insanı en güzel şekilde yarattık,"
  },
  {
    "surah_id": 95,
    "ayah_number": 5,
    "global_ayah_id": 6103,
    "translation": "Sonra onu aşağıların en aşağısı kıldık."
  },
  {
    "surah_id": 95,
    "ayah_number": 6,
    "global_ayah_id": 6104,
    "translation": "Yalnız, inanıp yararlı iş işleyenler bunun dışındadır. Onlara kesintisiz ecir vardır."
  },
  {
    "surah_id": 95,
    "ayah_number": 7,
    "global_ayah_id": 6105,
    "translation": "Öyleyken, sana dini yalan saydırtan nedir?"
  },
  {
    "surah_id": 95,
    "ayah_number": 8,
    "global_ayah_id": 6106,
    "translation": "Allah, hükmedenlerin en iyi hükmedeni değil midir?"
  }
