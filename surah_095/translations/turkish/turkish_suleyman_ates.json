[
  {
    "surah_id": 95,
    "ayah_number": 1,
    "global_ayah_id": 6099,
    "translation": "Tin'e ve Zeytun'a andolsun."
  },
  {
    "surah_id": 95,
    "ayah_number": 2,
    "global_ayah_id": 6100,
    "translation": "Sina Dağına andolsun."
  },
  {
    "surah_id": 95,
    "ayah_number": 3,
    "global_ayah_id": 6101,
    "translation": "Ve bu güvenli Şehre andolsun ki,"
  },
  {
    "surah_id": 95,
    "ayah_number": 4,
    "global_ayah_id": 6102,
    "translation": "Biz insanı en güzel biçimde yarattık."
  },
  {
    "surah_id": 95,
    "ayah_number": 5,
    "global_ayah_id": 6103,
    "translation": "Sonra onu aşağıların aşağısına çevirdik."
  },
  {
    "surah_id": 95,
    "ayah_number": 6,
    "global_ayah_id": 6104,
    "translation": "Yalnız inanıp iyi işler yapanlar hariç. Onlar için kesintisiz bir mükafat vardır."
  },
  {
    "surah_id": 95,
    "ayah_number": 7,
    "global_ayah_id": 6105,
    "translation": "Böyle iken sana ahiret cezasını yalanlatan nedir?"
  },
  {
    "surah_id": 95,
    "ayah_number": 8,
    "global_ayah_id": 6106,
    "translation": "Allah, hüküm verenlerin en iyisi değil midir?"
  }
]