    "ayah_number": 1,
    "global_ayah_id": 6099,
    "translation": "İncir ve zeytin hakkı için!"
  },
  {
    "surah_id": 95,
    "ayah_number": 2,
    "global_ayah_id": 6100,
    "translation": "Sina dağı, hakkı için!"
  },
  {
    "surah_id": 95,
    "ayah_number": 3,
    "global_ayah_id": 6101,
    "translation": "Bu emin belde hakkı için ki:"
  },
  {
    "surah_id": 95,
    "ayah_number": 4,
    "global_ayah_id": 6102,
    "translation": "Biz insanı en mükemmel sûrette yarattık. [30,30]"
  },
  {
    "surah_id": 95,
    "ayah_number": 5,
    "global_ayah_id": 6103,
    "translation": "Sonra da onu en aşağı derekeye düşürdük."
  },
  {
    "surah_id": 95,
    "ayah_number": 6,
    "global_ayah_id": 6104,
    "translation": "Ancak iman edip güzel ve makbul işler yapanlar müstesnadır. Onlara ise hiç eksilmeyen bir mükâfat vardır."
  },
  {
    "surah_id": 95,
    "ayah_number": 7,
    "global_ayah_id": 6105,
    "translation": "Bütün bunlardan sonra ey insan, senin mahşere ve hesaba inanmana hangi engel kalabilir?"
  },
  {
    "surah_id": 95,
    "ayah_number": 8,
    "global_ayah_id": 6106,
    "translation": "Allah hakimlerin hâkimi değil midir?"
  }
]