[
  {
    "surah_id": 95,
    "ayah_number": 1,
    "global_ayah_id": 6099,
    "translation": "¡CONSIDERA la higuera y el olivo,"
  },
  {
    "surah_id": 95,
    "ayah_number": 2,
    "global_ayah_id": 6100,
    "translation": "y el monte Sinaí,"
  },
  {
    "surah_id": 95,
    "ayah_number": 3,
    "global_ayah_id": 6101,
    "translation": "y esta tierra segura!"
  },
  {
    "surah_id": 95,
    "ayah_number": 4,
    "global_ayah_id": 6102,
    "translation": "En verdad, creamos al hombre en la mejor constitución,"
  },
  {
    "surah_id": 95,
    "ayah_number": 5,
    "global_ayah_id": 6103,
    "translation": "y luego lo reducimos a lo más abyecto --"
  },
  {
    "surah_id": 95,
    "ayah_number": 6,
    "global_ayah_id": 6104,
    "translation": "excepto los que llegan a creer y hacen buenas obras: ¡pues ésos tendrán una recompensa incesante!"
  },
  {
    "surah_id": 95,
    "ayah_number": 7,
    "global_ayah_id": 6105,
    "translation": "¿Qué podría, pues, [Oh hombre,] hacerte desmentir aún esta ley moral?"
  },
  {
    "surah_id": 95,
    "ayah_number": 8,
    "global_ayah_id": 6106,
    "translation": "¿No es Dios, acaso, el más justo de los jueces?"
  }
]