  },
  {
    "surah_id": 95,
    "ayah_number": 3,
    "global_ayah_id": 6101,
    "translation": "আর এই নিরাপদ নগরের কথা!"
  },
  {
    "surah_id": 95,
    "ayah_number": 4,
    "global_ayah_id": 6102,
    "translation": "সুনিশ্চয় আমরা মানুষকে সৃষ্টি করেছি শ্রেষ্ঠ-সুন্দর আকৃতিতে।"
  },
  {
    "surah_id": 95,
    "ayah_number": 5,
    "global_ayah_id": 6103,
    "translation": "তারপর আমরা তাকে পরিণত করি হীনদের মধ্যে হীনতমে, --"
  },
  {
    "surah_id": 95,
    "ayah_number": 6,
    "global_ayah_id": 6104,
    "translation": "তারা ব্যতীত যারা ঈমান এনেছে ও সৎকাজ করছে, তাদের জন্য তবে রয়েছে বাধা-বিরতিবিহীন প্রতিদান।"
  },
  {
    "surah_id": 95,
    "ayah_number": 7,
    "global_ayah_id": 6105,
    "translation": "তবে কী যা এরপরে তোমাকে বিচারসন্বন্ধে মিথ্যারোপ করতে দেয়?"
  },
  {
    "surah_id": 95,
    "ayah_number": 8,
    "global_ayah_id": 6106,
    "translation": "আল্লাহ্ কি বিচারকদের মধ্যে সর্বশ্রেষ্ঠ বিচারক নন?"
  }
