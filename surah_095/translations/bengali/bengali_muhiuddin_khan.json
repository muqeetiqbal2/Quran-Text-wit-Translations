    "ayah_number": 1,
    "global_ayah_id": 6099,
    "translation": "শপথ আঞ্জীর (ডুমুর) ও যয়তুনের,"
  },
  {
    "surah_id": 95,
    "ayah_number": 2,
    "global_ayah_id": 6100,
    "translation": "এবং সিনাই প্রান্তরস্থ তূর পর্বতের,"
  },
  {
    "surah_id": 95,
    "ayah_number": 3,
    "global_ayah_id": 6101,
    "translation": "এবং এই নিরাপদ নগরীর।"
  },
  {
    "surah_id": 95,
    "ayah_number": 4,
    "global_ayah_id": 6102,
    "translation": "আমি সৃষ্টি করেছি মানুষকে সুন্দরতর অবয়বে।"
  },
  {
    "surah_id": 95,
    "ayah_number": 5,
    "global_ayah_id": 6103,
    "translation": "অতঃপর তাকে ফিরিয়ে দিয়েছি নীচ থেকে নীচে।"
  },
  {
    "surah_id": 95,
    "ayah_number": 6,
    "global_ayah_id": 6104,
    "translation": "কিন্তু যারা বিশ্বাস স্থাপন করেছে ও সৎকর্ম করেছে, তাদের জন্যে রয়েছে অশেষ পুরস্কার।"
  },
  {
    "surah_id": 95,
    "ayah_number": 7,
    "global_ayah_id": 6105,
    "translation": "অতঃপর কেন তুমি অবিশ্বাস করছ কেয়ামতকে?"
  },
  {
    "surah_id": 95,
    "ayah_number": 8,
    "global_ayah_id": 6106,
    "translation": "আল্লাহ কি বিচারকদের মধ্যে শ্রেষ্টতম বিচারক নন?"
  }
]