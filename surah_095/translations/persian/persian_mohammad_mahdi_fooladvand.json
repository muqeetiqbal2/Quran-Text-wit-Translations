  },
  {
    "surah_id": 95,
    "ayah_number": 4,
    "global_ayah_id": 6102,
    "translation": "[كه‌] براستى انسان را در نيكوترين اعتدال آفريديم."
  },
  {
    "surah_id": 95,
    "ayah_number": 5,
    "global_ayah_id": 6103,
    "translation": "سپس او را به پست‌ترين [مراتب‌] پستى بازگردانيديم؛"
  },
  {
    "surah_id": 95,
    "ayah_number": 6,
    "global_ayah_id": 6104,
    "translation": "مگر كسانى را كه گرويده و كارهاى شايسته كرده‌اند، كه پاداشى بى‌منّت خواهند داشت."
  },
  {
    "surah_id": 95,
    "ayah_number": 7,
    "global_ayah_id": 6105,
