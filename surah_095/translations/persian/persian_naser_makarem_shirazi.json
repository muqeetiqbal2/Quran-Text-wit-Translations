  },
  {
    "surah_id": 95,
    "ayah_number": 3,
    "global_ayah_id": 6101,
    "translation": "و قسم به این شهر امن [= مکّه‌]،"
  },
  {
    "surah_id": 95,
    "ayah_number": 4,
