[
  {
    "surah_id": 107,
    "ayah_number": 1,
    "global_ayah_id": 6198,
    "translation": "Wat dunkt u van hem, die het toekomstige oordeel als eene valschheid loochent?"
  },
  {
    "surah_id": 107,
    "ayah_number": 2,
    "global_ayah_id": 6199,
    "translation": "Het is degeen, die den wees verstoot."
  },
  {
    "surah_id": 107,
    "ayah_number": 3,
    "global_ayah_id": 6200,
    "translation": "En anderen niet aanspoort den arme te voeden."
  },
  {
    "surah_id": 107,
    "ayah_number": 4,
    "global_ayah_id": 6201,
    "translation": "Wee over hen, die bidden,"
  },
  {
    "surah_id": 107,
    "ayah_number": 5,
    "global_ayah_id": 6202,
    "translation": "Maar die achteloos in hun gebed zijn;"
  },
  {
    "surah_id": 107,
    "ayah_number": 6,
    "global_ayah_id": 6203,
    "translation": "Die de huichelaars spelen."
  },
  {
    "surah_id": 107,
    "ayah_number": 7,
    "global_ayah_id": 6204,
    "translation": "En (den behoeftige) de noodige aalmoes (gereedschappen) onthouden."
  }
]