[
  {
    "surah_id": 107,
    "ayah_number": 1,
    "global_ayah_id": 6198,
    "translation": "তুমি কি তাকে দেখেছ যে ধর্মকর্মকে প্রত্যাখান করে?"
  },
  {
    "surah_id": 107,
    "ayah_number": 2,
    "global_ayah_id": 6199,
    "translation": "সে তো ঐ জন যে এতীমদের হাঁকিয়ে দেয়,"
  },
  {
    "surah_id": 107,
    "ayah_number": 3,
    "global_ayah_id": 6200,
    "translation": "আর গরীব-দুঃখীকে খাওয়ানোর ক্ষেত্রে উৎসাহ দেখায় না।"
  },
  {
    "surah_id": 107,
    "ayah_number": 4,
    "global_ayah_id": 6201,
    "translation": "অতএব ধিক্ সেইসব নামায-পড়ুয়াদের প্রতি --"
  },
  {
    "surah_id": 107,
    "ayah_number": 5,
    "global_ayah_id": 6202,
    "translation": "যারা স্বয়ং তাদের নামায সন্বন্ধে উদাসীন,"
  },
  {
    "surah_id": 107,
    "ayah_number": 6,
    "global_ayah_id": 6203,
    "translation": "যারা নিজেরাই হচ্ছে লোক-দেখিয়ে,"
  },
  {
    "surah_id": 107,
    "ayah_number": 7,
    "global_ayah_id": 6204,
    "translation": "আর যারা নিষেধ করে সাহায্য-সহায়তাকরণ।"
  }
]