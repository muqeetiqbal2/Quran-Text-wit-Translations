[
  {
    "surah_id": 107,
    "ayah_number": 1,
    "global_ayah_id": 6198,
    "translation": "আপনি কি দেখেছেন তাকে, যে বিচারদিবসকে মিথ্যা বলে?"
  },
  {
    "surah_id": 107,
    "ayah_number": 2,
    "global_ayah_id": 6199,
    "translation": "সে সেই ব্যক্তি, যে এতীমকে গলা ধাক্কা দেয়"
  },
  {
    "surah_id": 107,
    "ayah_number": 3,
    "global_ayah_id": 6200,
    "translation": "এবং মিসকীনকে অন্ন দিতে উৎসাহিত করে না।"
  },
  {
    "surah_id": 107,
    "ayah_number": 4,
    "global_ayah_id": 6201,
    "translation": "অতএব দুর্ভোগ সেসব নামাযীর,"
  },
  {
    "surah_id": 107,
    "ayah_number": 5,
    "global_ayah_id": 6202,
    "translation": "যারা তাদের নামায সম্বন্ধে বে-খবর;"
  },
  {
    "surah_id": 107,
    "ayah_number": 6,
    "global_ayah_id": 6203,
    "translation": "যারা তা লোক-দেখানোর জন্য করে"
  },
  {
    "surah_id": 107,
    "ayah_number": 7,
    "global_ayah_id": 6204,
    "translation": "এবং নিত্য ব্যবহার্য্য বস্তু অন্যকে দেয় না।"
  }
]