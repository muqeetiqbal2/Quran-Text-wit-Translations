    "global_ayah_id": 6303,
    "translation": "En el nombre de Dios, el Compasivo con toda la creación, el Misericordioso con los creyentes."
  },
  {
    "surah_id": 107,
    "ayah_number": 1,
    "global_ayah_id": 6304,
    "translation": "¿Acaso has observado a quien desmiente el Día del Juicio?"
  },
  {
    "surah_id": 107,
    "ayah_number": 2,
    "global_ayah_id": 6305,
    "translation": "Es quien rechaza al huérfano"
  },
  {
    "surah_id": 107,
    "ayah_number": 3,
    "global_ayah_id": 6306,
    "translation": "y no exhorta a alimentar al pobre."
  },
  {
    "surah_id": 107,
    "ayah_number": 4,
    "global_ayah_id": 6307,
    "translation": "¡Ay de los orantes"
  },
  {
    "surah_id": 107,
    "ayah_number": 5,
    "global_ayah_id": 6308,
    "translation": "que son negligentes en sus oraciones [realizándolas fuera de su horario],"
  },
  {
    "surah_id": 107,
    "ayah_number": 6,
    "global_ayah_id": 6309,
    "translation": "y solo las realizan para hacerse ver,"
  },
  {
    "surah_id": 107,
    "ayah_number": 7,
    "global_ayah_id": 6310,
    "translation": "y se niegan a prestar hasta la mínima ayuda!"
