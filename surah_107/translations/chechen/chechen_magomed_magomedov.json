  {
    "surah_id": 107,
    "ayah_number": 1,
    "global_ayah_id": 6198,
    "translation": "Хьуна гиний /хIай Мухьаммад/ и дин харцдеш верг?"
  },
  {
    "surah_id": 107,
    "ayah_number": 2,
    "global_ayah_id": 6199,
    "translation": "Иза ву бобер шен хьакъах духа тухуш верг."
  },
  {
    "surah_id": 107,
    "ayah_number": 3,
    "global_ayah_id": 6200,
    "translation": "Мискачунна даа хIума далан /нах/ меттах ца боху цо."
  },
  {
    "surah_id": 107,
    "ayah_number": 4,
    "global_ayah_id": 6201,
    "translation": "Боккха бала бу ламаз дечаьрна‚"
  },
  {
    "surah_id": 107,
    "ayah_number": 5,
    "global_ayah_id": 6202,
    "translation": "Шаьш дечу ламазах терго еш боцчу‚"
  },
  {
    "surah_id": 107,
    "ayah_number": 6,
    "global_ayah_id": 6203,
    "translation": "Шаьш /нахана/ гайтархьама /ламазаш деш/ болчу‚"
  },
  {
    "surah_id": 107,
    "ayah_number": 7,
    "global_ayah_id": 6204,
    "translation": "Шаьш /нахе ханна пайдаэца/ цIера салпал яла магош боцчу."
  }
]