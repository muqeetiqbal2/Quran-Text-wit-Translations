    "ayah_number": 2,
    "global_ayah_id": 6199,
    "translation": "پوءِ اُھو آھي جو ڇوري ٻار کي ڌِڪيندو آھي."
  },
  {
    "surah_id": 107,
    "ayah_number": 3,
    "global_ayah_id": 6200,
    "translation": "۽ (ڪنھن کي) مسڪين جي کارائڻ تي رغبت نه ڏياريندو آھي."
  },
  {
    "surah_id": 107,
    "ayah_number": 4,
