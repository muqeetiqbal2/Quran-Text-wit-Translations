[
  {
    "surah_id": 107,
    "ayah_number": 1,
    "global_ayah_id": 6198,
    "translation": "Оё онро, ки рӯзи ҷазоро дурӯғ мешумурад, дидӣ?"
  },
  {
    "surah_id": 107,
    "ayah_number": 2,
    "global_ayah_id": 6199,
    "translation": "Ӯ ҳамон касест, ки ятимро ба иҳонат (хорӣ) меронад"
  },
  {
    "surah_id": 107,
    "ayah_number": 3,
    "global_ayah_id": 6200,
    "translation": "ва мардумро ба таъом додан ба бенаво тарғиб намекунад."
  },
  {
    "surah_id": 107,
    "ayah_number": 4,
    "global_ayah_id": 6201,
    "translation": "Пас вой бар он намозгузороне,"
  },
  {
    "surah_id": 107,
    "ayah_number": 5,
    "global_ayah_id": 6202,
    "translation": "ки дар намози худ саҳл ангоранд (дар ғафлатанд),"
  },
  {
    "surah_id": 107,
    "ayah_number": 6,
    "global_ayah_id": 6203,
    "translation": "онон, ки риё мекунанд"
  },
  {
    "surah_id": 107,
    "ayah_number": 7,
    "global_ayah_id": 6204,
    "translation": "ва аз додани закот саркашӣ мекунанд."
  }
]