    "global_ayah_id": 6198,
    "translation": "آیا کسی که پیوسته [روزِ] جزا را انکار می‌کند، دیدی؟"
  },
  {
    "surah_id": 107,
    "ayah_number": 2,
    "global_ayah_id": 6199,
    "translation": "او همان کسی است که یتیم را با خشونت می‌راند."
  },
  {
    "surah_id": 107,
    "ayah_number": 3,
    "global_ayah_id": 6200,
    "translation": "و [دیگران را] بر غذا دادن به بینوا تشویق نمی‌کند."
  },
  {
    "surah_id": 107,
    "ayah_number": 4,
    "global_ayah_id": 6201,
    "translation": "پس وای به حال نمازگزاران!"
  },
  {
    "surah_id": 107,
    "ayah_number": 5,
    "global_ayah_id": 6202,
    "translation": "آنان که از نمازشان غافل و نسبت به آن سهل‌انگارند."
  },
  {
    "surah_id": 107,
    "ayah_number": 6,
    "global_ayah_id": 6203,
    "translation": "همانان که پیوسته ریا می‌کنند."
  },
  {
    "surah_id": 107,
    "ayah_number": 7,
    "global_ayah_id": 6204,
    "translation": "و از [دادن] زکات دریغ می‌کنند."
  }
]