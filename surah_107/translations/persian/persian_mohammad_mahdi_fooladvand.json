  {
    "surah_id": 107,
    "ayah_number": 1,
    "global_ayah_id": 6198,
    "translation": "آيا كسى را كه [روز] جزا را دروغ مى‌خواند، ديدى؟"
  },
  {
    "surah_id": 107,
    "ayah_number": 2,
    "global_ayah_id": 6199,
    "translation": "اين همان كس است كه يتيم را بسختى مى‌راند،"
  },
  {
    "surah_id": 107,
    "ayah_number": 3,
    "global_ayah_id": 6200,
    "translation": "و به خوراك‌دادن بينوا ترغيب نمى‌كند."
  },
  {
    "surah_id": 107,
    "ayah_number": 4,
    "global_ayah_id": 6201,
    "translation": "پس واى بر نمازگزارانى"
  },
  {
    "surah_id": 107,
    "ayah_number": 5,
    "global_ayah_id": 6202,
    "translation": "كه از نمازشان غافلند،"
  },
  {
    "surah_id": 107,
    "ayah_number": 6,
    "global_ayah_id": 6203,
    "translation": "آنان كه ريا مى‌كنند،"
  },
  {
    "surah_id": 107,
    "ayah_number": 7,
    "global_ayah_id": 6204,
    "translation": "و از [دادن‌] زكات [و وسايل و مايحتاج خانه‌] خوددارى مى‌ورزند."
  }
]