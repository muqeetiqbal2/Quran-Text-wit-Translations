[
  {
    "surah_id": 107,
    "ayah_number": 1,
    "global_ayah_id": 6198,
    "translation": "あなたは，審判を嘘であるとする者を見たか。"
  },
  {
    "surah_id": 107,
    "ayah_number": 2,
    "global_ayah_id": 6199,
    "translation": "かれは，孤児に手荒くする者であり，"
  },
  {
    "surah_id": 107,
    "ayah_number": 3,
    "global_ayah_id": 6200,
    "translation": "また貧者に食物を与えることを勧めない者である。"
  },
  {
    "surah_id": 107,
    "ayah_number": 4,
    "global_ayah_id": 6201,
    "translation": "災いなるかな，礼拝する者でありながら，"
  },
  {
    "surah_id": 107,
    "ayah_number": 5,
    "global_ayah_id": 6202,
    "translation": "自分の礼拝を忽せにする者。"
  },
  {
    "surah_id": 107,
    "ayah_number": 6,
    "global_ayah_id": 6203,
    "translation": "（人に）見られるための礼拝をし，"
  },
  {
    "surah_id": 107,
    "ayah_number": 7,
    "global_ayah_id": 6204,
    "translation": "慈善を断わる者に。"
  }
]