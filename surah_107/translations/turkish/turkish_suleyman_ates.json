[
  {
    "surah_id": 107,
    "ayah_number": 1,
    "global_ayah_id": 6198,
    "translation": "Din(ahiret cezasın)ı yalanlayan(adam)ı gördün mü?"
  },
  {
    "surah_id": 107,
    "ayah_number": 2,
    "global_ayah_id": 6199,
    "translation": "İşte o, öksüzü iter, kakar;"
  },
  {
    "surah_id": 107,
    "ayah_number": 3,
    "global_ayah_id": 6200,
    "translation": "Yoksulu doyurmağa önayak olmaz."
  },
  {
    "surah_id": 107,
    "ayah_number": 4,
    "global_ayah_id": 6201,
    "translation": "Şu namaz kılanların vay haline,"
  },
  {
    "surah_id": 107,
    "ayah_number": 5,
    "global_ayah_id": 6202,
    "translation": "Ki, onlar namazlarından gaflet ederler (kıldıkları namazın değerini bilmez, ona önem vermezler)."
  },
  {
    "surah_id": 107,
    "ayah_number": 6,
    "global_ayah_id": 6203,
    "translation": "Onlar gösteriş (için ibadet) yaparlar."
  },
  {
    "surah_id": 107,
    "ayah_number": 7,
    "global_ayah_id": 6204,
    "translation": "En ufak bir yardımı esirgerler."
  }
]