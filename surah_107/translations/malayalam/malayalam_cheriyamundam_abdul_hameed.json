[
  {
    "surah_id": 107,
    "ayah_number": 1,
    "global_ayah_id": 6198,
    "translation": "മതത്തെ വ്യാജമാക്കുന്നവന്‍ ആരെന്ന് നീ കണ്ടുവോ?"
  },
  {
    "surah_id": 107,
    "ayah_number": 2,
    "global_ayah_id": 6199,
    "translation": "അനാഥക്കുട്ടിയെ തള്ളിക്കളയുന്നവനത്രെ അത്‌."
  },
  {
    "surah_id": 107,
    "ayah_number": 3,
    "global_ayah_id": 6200,
    "translation": "പാവപ്പെട്ടവന്‍റെ ഭക്ഷണത്തിന്‍റെ കാര്യത്തില്‍ പ്രോത്സാഹനം നടത്താതിരിക്കുകയും ചെയ്യുന്നവന്‍."
  },
  {
    "surah_id": 107,
    "ayah_number": 4,
    "global_ayah_id": 6201,
    "translation": "എന്നാല്‍ നമസ്കാരക്കാര്‍ക്കാകുന്നു നാശം."
  },
  {
    "surah_id": 107,
    "ayah_number": 5,
    "global_ayah_id": 6202,
    "translation": "തങ്ങളുടെ നമസ്കാരത്തെപ്പറ്റി ശ്രദ്ധയില്ലാത്തവരായ"
  },
  {
    "surah_id": 107,
    "ayah_number": 6,
    "global_ayah_id": 6203,
    "translation": "ജനങ്ങളെ കാണിക്കാന്‍ വേണ്ടി പ്രവര്‍ത്തിക്കുന്നവരായ"
  },
  {
    "surah_id": 107,
    "ayah_number": 7,
    "global_ayah_id": 6204,
    "translation": "പരോപകാര വസ്തുക്കള്‍ മുടക്കുന്നവരുമായ"
  }
]