[
  {
    "surah_id": 107,
    "ayah_number": 0,
    "global_ayah_id": 6303,
    "translation": "అనంత కరుణామయుడు అపార కరుణాప్రదాత అయిన అల్లాహ్‌ పేరుతో"
  },
  {
    "surah_id": 107,
    "ayah_number": 1,
    "global_ayah_id": 6304,
    "translation": "తీర్పు దినాన్ని తిరస్కరించే వ్యక్తిని నీవు చూశావా?"
  },
  {
    "surah_id": 107,
    "ayah_number": 2,
    "global_ayah_id": 6305,
    "translation": "అతడే అనాథులను కసరికొట్టేవాడు"
  },
  {
    "surah_id": 107,
    "ayah_number": 3,
    "global_ayah_id": 6306,
    "translation": "మరియు పేద వాళ్ళకు అన్నం పెట్టమని ప్రోత్సహించని వాడు."
  },
  {
    "surah_id": 107,
    "ayah_number": 4,
    "global_ayah_id": 6307,
    "translation": "కావున, నమా జ్‌ చేసే, (ఇటువంటి) వారికి వినాశం తప్పదు!"
  },
  {
    "surah_id": 107,
    "ayah_number": 5,
    "global_ayah_id": 6308,
    "translation": "ఎవరైతే తమ నమా జ్‌ల పట్ల అశ్రధ్ధ వహిస్తారో!"
  },
  {
    "surah_id": 107,
    "ayah_number": 6,
    "global_ayah_id": 6309,
    "translation": "ఎవరైతే ప్రదర్శనా బుధ్ధితో వ్యవహరిస్తారో (నమా జ్‌  సలుపుతారో)!"
  },
  {
    "surah_id": 107,
    "ayah_number": 7,
    "global_ayah_id": 6310,
    "translation": "మరియు (ప్రజలకు) సామాన్య ఉపకారం (సహాయం) కూడా నిరాకరిస్తారో!"
  }
]