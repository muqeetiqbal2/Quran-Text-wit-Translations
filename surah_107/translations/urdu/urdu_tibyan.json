  {
    "surah_id": 107,
    "ayah_number": 5,
    "global_ayah_id": 6308,
    "translation": "جو اپنی نمازوں سے غفلت کرتے ہیں"
  },
  {
    "surah_id": 107,
    "ayah_number": 6,
    "global_ayah_id": 6309,
    "translation": "جو ریا کاری کرتے ہیں"
  },
  {
    "surah_id": 107,
    "ayah_number": 7,
    "global_ayah_id": 6310,
    "translation": "اور وہ استعمال کی معمولی چیز دینے سے منع کرتے ہیں"
  }
