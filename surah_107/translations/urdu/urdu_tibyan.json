  {
    "surah_id": 107,
    "ayah_number": 3,
    "global_ayah_id": 6306,
    "translation": "اور وہ مسکین کو «<a href=508> کھانا </a>» کھلانے پر کسی کو برانگیختہ نہیں کرتا"
  },
  {
    "surah_id": 107,
    "ayah_number": 4,
    "global_ayah_id": 6307,
    "translation": "سو ان نمازیوں کے لیے «<a href=645> ہلاکت </a>» ہے"
