    "global_ayah_id": 6303,
    "translation": "اللہ کے «<a href=614> نام </a>» سے جو بےحد رحم والا، نہایت «<a href=600> مہربان </a>» ہے۔ [1]"
  },
  {
    "surah_id": 107,
    "ayah_number": 1,
    "global_ayah_id": 6304,
    "translation": "کیا تونے اس شخص کو دیکھا جو جزا کو جھٹلاتا ہے۔ [1]"
  },
  {
    "surah_id": 107,
    "ayah_number": 2,
    "global_ayah_id": 6305,
    "translation": "تو یہی ہے جو یتیم کو دھکے دیتا ہے۔ [2]"
  },
  {
    "surah_id": 107,
    "ayah_number": 3,
    "global_ayah_id": 6306,
    "translation": "اور مسکین کو «<a href=508> کھانا </a>» دینے کی ترغیب نہیں دیتا۔ [3]"
  },
  {
    "surah_id": 107,
    "ayah_number": 4,
    "global_ayah_id": 6307,
    "translation": "پس ان نمازیوں کے لیے بڑی «<a href=645> ہلاکت </a>» ہے۔ [4]"
  },
  {
    "surah_id": 107,
    "ayah_number": 5,
    "global_ayah_id": 6308,
    "translation": "وہ جو اپنی نماز سے «<a href=446> غافل </a>» ہیں۔ [5]"
  },
  {
    "surah_id": 107,
    "ayah_number": 6,
    "global_ayah_id": 6309,
    "translation": "وہ جو دکھاوا کرتے ہیں۔ [6]"
  },
  {
    "surah_id": 107,
    "ayah_number": 7,
    "global_ayah_id": 6310,
    "translation": "اور عام برتنے کی چیزیں روکتے ہیں۔ [7]"
  }
]