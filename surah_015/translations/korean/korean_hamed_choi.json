[
  {
    "surah_id": 15,
    "ayah_number": 1,
    "global_ayah_id": 1803,
    "translation": "알리프 람 라 이것은 성서의말씀으로 진리를 밝혀주는 꾸란이라"
  },
  {
    "surah_id": 15,
    "ayah_number": 2,
    "global_ayah_id": 1804,
    "translation": "아마도 믿음이 없는 자들은 그 자신들이 일찌기 무슬림이 되 었을 것을 하고 원할 때가 오리라"
  },
  {
    "surah_id": 15,
    "ayah_number": 3,
    "global_ayah_id": 1805,
    "translation": "그들이 먹고 인생을 향락하여그들의 소망이 그들을 기쁘도록 두라 그들이 곧 알게 되리라"
  },
  {
    "surah_id": 15,
    "ayah_number": 4,
    "global_ayah_id": 1806,
    "translation": "이미 정하여진 계율이 이르지아니한 민족을 하나님이 멸망케 하지 아니 했으며"
  },
  {
    "surah_id": 15,
    "ayah_number": 5,
    "global_ayah_id": 1807,
    "translation": "어느 민족도 그들의 운명을 서두르거나 지연시킬 수 없노라"
  },
  {
    "surah_id": 15,
    "ayah_number": 6,
    "global_ayah_id": 1808,
    "translation": "이때 그들이 말하더라 그대 에게 꾸란이 계시되었다니 그대가미친자가 아니뇨"
  },
  {
    "surah_id": 15,
    "ayah_number": 7,
    "global_ayah_id": 1809,
    "translation": "그대가 진실한 자 중에 있다 면 왜 천사들을 이르게 하지 않느뇨 라고 하니"
  },
  {
    "surah_id": 15,
    "ayah_number": 8,
    "global_ayah_id": 1810,
    "translation": "하나님은 진리의 목적을 위하여 천사들을 보냈을 뿐이라 만일 천사들이 그들에게 왔다면 그들은유예되지 못했으리라"
  },
  {
    "surah_id": 15,
    "ayah_number": 9,
    "global_ayah_id": 1811,
    "translation": "하나님이 실로 그 메세지를 계시했으니 하나님이 그것을 보호하리라"
  },
  {
    "surah_id": 15,
    "ayah_number": 10,
    "global_ayah_id": 1812,
    "translation": "그대 이전 초기 민족에게도하나님은 선지자들을 보냈으나"
  },
  {
    "surah_id": 15,
    "ayah_number": 11,
    "global_ayah_id": 1813,
    "translation": "선지자가 그들에게 이르면 그들은 오허려 그를 조롱하였더 라"
  },
  {
    "surah_id": 15,
    "ayah_number": 12,
    "global_ayah_id": 1814,
    "translation": "하나님은 그것이 죄인들의 마음속에 들도록 하였으나"
  },
  {
    "surah_id": 15,
    "ayah_number": 13,
    "global_ayah_id": 1815,
    "translation": "그들은 그들 선조들이 멸망한 선례가 있음에도 그것을 믿지 않더라"
  },
  {
    "surah_id": 15,
    "ayah_number": 14,
    "global_ayah_id": 1816,
    "translation": "하나님이 그들에게 하늘의 문을 열어 그들이 그곳을 향하여 오르게 한다 하여도"
  },
  {
    "surah_id": 15,
    "ayah_number": 15,
    "global_ayah_id": 1817,
    "translation": "그들은 틀림없이 우리의 눈들이 도취되어 우리가 마술에 걸 려 있을 뿐이라고 말할 것이라"
  },
  {
    "surah_id": 15,
    "ayah_number": 16,
    "global_ayah_id": 1818,
    "translation": "그리하여 하나님은 하늘에 천도를 만들고 보는 자들을 위해 그것을 장식하였으며"
  },
  {
    "surah_id": 15,
    "ayah_number": 17,
    "global_ayah_id": 1819,
    "translation": "하나님은 그것을 저주받은 사탄으로부터 보호하였노라"
  },
  {
    "surah_id": 15,
    "ayah_number": 18,
    "global_ayah_id": 1820,
    "translation": "그러나 몰래 듣는자는 타오르는 선명한 불꽃을 따름이라"
  },
  {
    "surah_id": 15,
    "ayah_number": 19,
    "global_ayah_id": 1821,
    "translation": "하나님은 대지를 펼쳐 그안에 산들을 세워 고정시키고 모든 것이 그안에서 균형되게 생산케 함이라"
  },
  {
    "surah_id": 15,
    "ayah_number": 20,
    "global_ayah_id": 1822,
    "translation": "하나님은 너희들을 위하여 너희가 생성케 하지 못하는 일용 할 양식을 그안에 부여하였노라"
  },
  {
    "surah_id": 15,
    "ayah_number": 21,
    "global_ayah_id": 1823,
    "translation": "하나님에게는 모든 일용할 양식이 있으되 필요한 양 외에는 내려주지 아니 하시니라"
  },
  {
    "surah_id": 15,
    "ayah_number": 22,
    "global_ayah_id": 1824,
    "translation": "하나님은 비구름을 보내어 하늘로부터 비를 내리게 하사 그 것으로 너희를 충족시키나 너희는그것을 저장하지 못하며"
  },
  {
    "surah_id": 15,
    "ayah_number": 23,
    "global_ayah_id": 1825,
    "translation": "실로 생명을 부여하고 생명 을 앗아가는 것도 하나님께 있나 니 모든 것이 하나님에게 상속됨 이라"
  },
  {
    "surah_id": 15,
    "ayah_number": 24,
    "global_ayah_id": 1826,
    "translation": "하나님은 너희 가운데 앞서 온 자와 뒤에 온 자를 알고 계시 니라"
  },
  {
    "surah_id": 15,
    "ayah_number": 25,
    "global_ayah_id": 1827,
    "translation": "주님께서 그들 모두를 모이 게 하시니 실로 그분은 권능과 아심으로 충만하심이라"
  },
  {
    "surah_id": 15,
    "ayah_number": 26,
    "global_ayah_id": 1828,
    "translation": "하나님이 인간을 창조하사 검고 묽은 진흙으로 만드셨노라"
  },
  {
    "surah_id": 15,
    "ayah_number": 27,
    "global_ayah_id": 1829,
    "translation": "하나님이 또 영마를 창조하 사 그것은 뜨거운 살인의 불을 창조하기 이전이라"
  },
  {
    "surah_id": 15,
    "ayah_number": 28,
    "global_ayah_id": 1830,
    "translation": "보라 주님이 천사들에게 내가 검고 묽은 흙으로 인간을 창조하리라 말씀이 있었노라"
  },
  {
    "surah_id": 15,
    "ayah_number": 29,
    "global_ayah_id": 1831,
    "translation": "내가 형상을 만들어 그안에 나의 영혼을 불어넣을 때 너희가 그에게 부복 하라하니"
  },
  {
    "surah_id": 15,
    "ayah_number": 30,
    "global_ayah_id": 1832,
    "translation": "천사들 모두가 부복하더라"
  },
  {
    "surah_id": 15,
    "ayah_number": 31,
    "global_ayah_id": 1833,
    "translation": "그러나 이블리스는 부복하는 자중에 있기를 거절하였더라"
  },
  {
    "surah_id": 15,
    "ayah_number": 32,
    "global_ayah_id": 1834,
    "translation": "하나님이 이르시길 이블리스 여 네가 부복하는 자중에 있지 않 는 이유는 무엇이뇨 라고 물으니"
  },
  {
    "surah_id": 15,
    "ayah_number": 33,
    "global_ayah_id": 1835,
    "translation": "이블리스가 말하길 당신께서 묽고 검은 진흙으로 빛은 인간에 게 왜 내가 부복하여야 합니까 라 고 대답하더라"
  },
  {
    "surah_id": 15,
    "ayah_number": 34,
    "global_ayah_id": 1836,
    "translation": "그리하여 하나님은 명령하셨 나니 그곳 으로부터 나가라 너는 저주받았노라"
  },
  {
    "surah_id": 15,
    "ayah_number": 35,
    "global_ayah_id": 1837,
    "translation": "심판의 그날까지 너에게 저 주가 있으리라"
  },
  {
    "surah_id": 15,
    "ayah_number": 36,
    "global_ayah_id": 1838,
    "translation": "이때 이블리스가 주여 부활의그날까지 저를 유예하여 주소서"
  },
  {
    "surah_id": 15,
    "ayah_number": 37,
    "global_ayah_id": 1839,
    "translation": "하나님이 이르시길 네가 유 예되는자 가운데 있으되"
  },
  {
    "surah_id": 15,
    "ayah_number": 38,
    "global_ayah_id": 1840,
    "translation": "지정된 그 시간 그날 까지라 하시니"
  },
  {
    "surah_id": 15,
    "ayah_number": 39,
    "global_ayah_id": 1841,
    "translation": "이블리스 말하였더라 주여 당신이 나를 방황토록 하였기에 지상에서 내가 그들을 유혹하여 그들 모두를 방황케 하리요"
  },
  {
    "surah_id": 15,
    "ayah_number": 40,
    "global_ayah_id": 1842,
    "translation": "그러나 당신의 진실한 종복 들은 제외됨이라 하매"
  },
  {
    "surah_id": 15,
    "ayah_number": 41,
    "global_ayah_id": 1843,
    "translation": "하나님이 이르시길 나의 성 실한 중복이 가는 길이 내게로 이 르는 올바른 길이라"
  },
  {
    "surah_id": 15,
    "ayah_number": 42,
    "global_ayah_id": 1844,
    "translation": "실로 너 사탄은 탈선하여 너 를 따르는 자 외에는 나의 종 어느누구도 지배 할 수 없노라"
  },
  {
    "surah_id": 15,
    "ayah_number": 43,
    "global_ayah_id": 1845,
    "translation": "실로 지옥은 그들 모두를 위한 약속된 곳으로"
  },
  {
    "surah_id": 15,
    "ayah_number": 44,
    "global_ayah_id": 1846,
    "translation": "그곳에는 일곱개의 문이 있 으며 그것은 그들 죄인들에 배당 된 각각의 문이라"
  },
  {
    "surah_id": 15,
    "ayah_number": 45,
    "global_ayah_id": 1847,
    "translation": "그러나 실로 정의롭게 사는 자는 우물이 있는 천국으로"
  },
  {
    "surah_id": 15,
    "ayah_number": 46,
    "global_ayah_id": 1848,
    "translation": "평안하고 안전하게 그곳에 들게하여"
  },
  {
    "surah_id": 15,
    "ayah_number": 47,
    "global_ayah_id": 1849,
    "translation": "하나님이 그들 마음속에 있는증오를 제거하리니 그들은 형제 처럼 얼굴과 얼굴을 마주 대하더라"
  },
  {
    "surah_id": 15,
    "ayah_number": 48,
    "global_ayah_id": 1850,
    "translation": "그안에서 피곤함이 그들을 엄습하지 아니하며 또한 그들은 결코 그곳으로부터 추방되지 않노라"
  },
  {
    "surah_id": 15,
    "ayah_number": 49,
    "global_ayah_id": 1851,
    "translation": "나의 중복에게 일러가로되 실로 내가 관용과 은혜로 충만함 이라"
  },
  {
    "surah_id": 15,
    "ayah_number": 50,
    "global_ayah_id": 1852,
    "translation": "그러나 나의 벌은 고통스러 운 벌이라"
  },
  {
    "surah_id": 15,
    "ayah_number": 51,
    "global_ayah_id": 1853,
    "translation": "아브라함의 손님들에 관하 여 그들에게 일러주라"
  },
  {
    "surah_id": 15,
    "ayah_number": 52,
    "global_ayah_id": 1854,
    "translation": "이때 천사들이 그에게 들어 가 평안하소서 라고 인사하니 실 로 우리는 당신들이 두럽나이다 라고 아브라함이 대답하더라"
  },
  {
    "surah_id": 15,
    "ayah_number": 53,
    "global_ayah_id": 1855,
    "translation": "이에 천사들이 말하더라 두 려워 하지 말라 우리는 총명한 지혜를 가진 사내아이의 소식을 당 신께 전하려 왔나이다"
  },
  {
    "surah_id": 15,
    "ayah_number": 54,
    "global_ayah_id": 1856,
    "translation": "아브라함이 말하였더라 나이들은 저에게 사내 아이의 소식을 전하려 오셨다니 그 복음이 무엇 입니까 라고 물으매"
  },
  {
    "surah_id": 15,
    "ayah_number": 55,
    "global_ayah_id": 1857,
    "translation": "우리가 진실로 당신께 진리 의 복음을 전하였으니 실망하는 자중에 있지 말라"
  },
  {
    "surah_id": 15,
    "ayah_number": 56,
    "global_ayah_id": 1858,
    "translation": "아브라함이 대답하더라 방황하는자 외에는 누가 주님의 은혜 를 실망시키리요"
  },
  {
    "surah_id": 15,
    "ayah_number": 57,
    "global_ayah_id": 1859,
    "translation": "천사들이여 당신들의 사명이무엇이뇨 라고 물으니"
  },
  {
    "surah_id": 15,
    "ayah_number": 58,
    "global_ayah_id": 1860,
    "translation": "죄지은 롯의 백성에게 저희 를 보내셨습니다 라고 천사들이 대답하더라"
  },
  {
    "surah_id": 15,
    "ayah_number": 59,
    "global_ayah_id": 1861,
    "translation": "그러나 롯의 가족을 제외하 고 우리는 그들 모두를 구제하리 요"
  },
  {
    "surah_id": 15,
    "ayah_number": 60,
    "global_ayah_id": 1862,
    "translation": "그러나 롯의 아내는 구제 될수 없으매 그녀는 벌을 받게 되 리라"
  },
  {
    "surah_id": 15,
    "ayah_number": 61,
    "global_ayah_id": 1863,
    "translation": "사자들이 롯과 그의 추종자 들에게 이르렀을때"
  },
  {
    "surah_id": 15,
    "ayah_number": 62,
    "global_ayah_id": 1864,
    "translation": "룻이 내가 알지 못하는 당신들은 누구이뇨 라고 말하니"
  },
  {
    "surah_id": 15,
    "ayah_number": 63,
    "global_ayah_id": 1865,
    "translation": "우리는 사자로써 백성들이 의심하는 것을 완성하고자 당신 께 왔나이다"
  },
  {
    "surah_id": 15,
    "ayah_number": 64,
    "global_ayah_id": 1866,
    "translation": "우리는 진리로 당신께 이르 렀으매 우리가 말함이 진리라"
  },
  {
    "surah_id": 15,
    "ayah_number": 65,
    "global_ayah_id": 1867,
    "translation": "그러므로 당신 가족과 함께 밤중에 떠나라 그리고 그들 뒤를 따르되 너희 가운데 어느 누구도 뒤돌아보지 말라 너희가 명령받은그곳으로 떠나라"
  },
  {
    "surah_id": 15,
    "ayah_number": 66,
    "global_ayah_id": 1868,
    "translation": "그리고 아침이 될 때 죄인들모두에게 은혜가 단절되리라는 소식을 그에게 전하였더니"
  },
  {
    "surah_id": 15,
    "ayah_number": 67,
    "global_ayah_id": 1869,
    "translation": "그 도시의 백성들이 기뻐하 며 서둘러 오더라"
  },
  {
    "surah_id": 15,
    "ayah_number": 68,
    "global_ayah_id": 1870,
    "translation": "이때 롯이 말하길 이분들은 나의 손님들이니 나에게 욕되지 않게 하여 주시고"
  },
  {
    "surah_id": 15,
    "ayah_number": 69,
    "global_ayah_id": 1871,
    "translation": "하나님을 경외하여 나를 부 끄럽게 하지마소서 라고 말하니"
  },
  {
    "surah_id": 15,
    "ayah_number": 70,
    "global_ayah_id": 1872,
    "translation": "그들이 말하길 우리가 당신 께 저마다에게 말하는 것을 금하 지 아니하였소"
  },
  {
    "surah_id": 15,
    "ayah_number": 71,
    "global_ayah_id": 1873,
    "translation": "롯이 말하길 너희가 원한다 면 결혼할 나의 딸들이 있노라"
  },
  {
    "surah_id": 15,
    "ayah_number": 72,
    "global_ayah_id": 1874,
    "translation": "맹세하건대 실로 그들은 그들의 불신에 도취되어 방황하고 있노라"
  },
  {
    "surah_id": 15,
    "ayah_number": 73,
    "global_ayah_id": 1875,
    "translation": "그러나 폭풍은 동트기 직전그들을 멸망시켰더라"
  },
  {
    "surah_id": 15,
    "ayah_number": 74,
    "global_ayah_id": 1876,
    "translation": "그렇게하여 하나님은 그 도시를 뒤엎었고 열에 달구어진 돌 비를 그들에게 내렸으니"
  },
  {
    "surah_id": 15,
    "ayah_number": 75,
    "global_ayah_id": 1877,
    "translation": "실로 그 안에는 이해하는 자들을 위한 예증으로"
  },
  {
    "surah_id": 15,
    "ayah_number": 76,
    "global_ayah_id": 1878,
    "translation": "그 도시는 아직 지워지지 않는 길위에 있노라"
  },
  {
    "surah_id": 15,
    "ayah_number": 77,
    "global_ayah_id": 1879,
    "translation": "실로 그안에는 믿는 자들을 위한 예증도 있으되"
  },
  {
    "surah_id": 15,
    "ayah_number": 78,
    "global_ayah_id": 1880,
    "translation": "실로 그곳의 백성들은 죄인 들이였노라"
  },
  {
    "surah_id": 15,
    "ayah_number": 79,
    "global_ayah_id": 1881,
    "translation": "그래서 하나님이 그들에게 벌을 내리매 그 두 고을이 멸망 한 흔적이 아직도 길위에 있더라"
  },
  {
    "surah_id": 15,
    "ayah_number": 80,
    "global_ayah_id": 1882,
    "translation": "히즈르 백성들도 예언자들 을 불신하였으니"
  },
  {
    "surah_id": 15,
    "ayah_number": 81,
    "global_ayah_id": 1883,
    "translation": "하나님이 그들에게 예증을 보냈으나 그들은 그에 관하여 불 신하며"
  },
  {
    "surah_id": 15,
    "ayah_number": 82,
    "global_ayah_id": 1884,
    "translation": "그 산에 집을 세위 하나님의벌을 피하고 안전하게 살려고 하 였으나"
  },
  {
    "surah_id": 15,
    "ayah_number": 83,
    "global_ayah_id": 1885,
    "translation": "하늘의 천벌이 아침 직전에 그들을 멸망케 하였으니"
  },
  {
    "surah_id": 15,
    "ayah_number": 84,
    "global_ayah_id": 1886,
    "translation": "그들이 얻었던 모든 것이 그들에게 유용치 못하였더라"
  },
  {
    "surah_id": 15,
    "ayah_number": 85,
    "global_ayah_id": 1887,
    "translation": "하나님이 하늘과 대지와 그 사이의 모든 것을 진리로 창조하 였고 또한 심판의 날이 올것이라 그러므로 그대는 그들에게 너그 럽고 관대하라"
  },
  {
    "surah_id": 15,
    "ayah_number": 86,
    "global_ayah_id": 1888,
    "translation": "실로 그대의 주님은 창조주 이사 아시는 분이시라"
  },
  {
    "surah_id": 15,
    "ayah_number": 87,
    "global_ayah_id": 1889,
    "translation": "하나님은 그대에게 자주 낭 송하는 일곱절과 위대한 꾸란을 주었노라"
  },
  {
    "surah_id": 15,
    "ayah_number": 88,
    "global_ayah_id": 1890,
    "translation": "하나님이 일부 불신자들로하여 향락을 갖도록 한 것에 그대는눈을 크게 뜨지 말며 그들의 불 신으로 슬퍼하지 말고 믿는자들을위해 그대의 날개를 낮추라"
  },
  {
    "surah_id": 15,
    "ayah_number": 89,
    "global_ayah_id": 1891,
    "translation": "일러가로되 실로 내가 분명 한 경고자이라"
  },
  {
    "surah_id": 15,
    "ayah_number": 90,
    "global_ayah_id": 1892,
    "translation": "부분으로 분리한 백성들에게계시했듯이 그대에게 꾸란을 계시했으되"
  },
  {
    "surah_id": 15,
    "ayah_number": 91,
    "global_ayah_id": 1893,
    "translation": "꾸란을 부분으로 분리한 불 신자들이 있었으므로"
  },
  {
    "surah_id": 15,
    "ayah_number": 92,
    "global_ayah_id": 1894,
    "translation": "그대 주님의 이름으로 하나 님은 그들 모두에게 질문하시니라"
  },
  {
    "surah_id": 15,
    "ayah_number": 93,
    "global_ayah_id": 1895,
    "translation": "그들이 행하던 모든 것에 관한 것이라"
  },
  {
    "surah_id": 15,
    "ayah_number": 94,
    "global_ayah_id": 1896,
    "translation": "그러므로 그대가 명령받은 것을 선언하되 불신자들로부터 멀리하라"
  },
  {
    "surah_id": 15,
    "ayah_number": 95,
    "global_ayah_id": 1897,
    "translation": "하나님은 조롱하는 자들로부터 그대를 보호함에 충만함이라"
  },
  {
    "surah_id": 15,
    "ayah_number": 96,
    "global_ayah_id": 1898,
    "translation": "하나님께 다른 신을 비유하 는 자 그들은 곧 알게 되리라"
  },
  {
    "surah_id": 15,
    "ayah_number": 97,
    "global_ayah_id": 1899,
    "translation": "그들이 거짓하는 것으로 그 대의 마음이 근심됨을 알고 있나 니"
  },
  {
    "surah_id": 15,
    "ayah_number": 98,
    "global_ayah_id": 1900,
    "translation": "그러나 그대의 주님을 찬미 하고 엎드려 부복하는 자 중에 있으라"
  },
  {
    "surah_id": 15,
    "ayah_number": 99,
    "global_ayah_id": 1901,
    "translation": "그대의 주님을 경배하라 확 실한 그날이 그대에게 오리라"
  }
]