[
  {
    "surah_id": 75,
    "ayah_number": 1,
    "global_ayah_id": 5552,
    "translation": "I swear by the Day of Resurrection."
  },
  {
    "surah_id": 75,
    "ayah_number": 2,
    "global_ayah_id": 5553,
    "translation": "And I swear by the blaming soul."
  },
  {
    "surah_id": 75,
    "ayah_number": 3,
    "global_ayah_id": 5554,
    "translation": "Does man think that We will not reassemble his bones?"
  },
  {
    "surah_id": 75,
    "ayah_number": 4,
    "global_ayah_id": 5555,
    "translation": "Yes indeed; We are Able to reconstruct his fingertips."
  },
  {
    "surah_id": 75,
    "ayah_number": 5,
    "global_ayah_id": 5556,
    "translation": "But man wants to deny what is ahead of him."
  },
  {
    "surah_id": 75,
    "ayah_number": 6,
    "global_ayah_id": 5557,
    "translation": "He asks, “When is the Day of Resurrection?”"
  },
  {
    "surah_id": 75,
    "ayah_number": 7,
    "global_ayah_id": 5558,
    "translation": "When vision is dazzled."
  },
  {
    "surah_id": 75,
    "ayah_number": 8,
    "global_ayah_id": 5559,
    "translation": "And the moon is eclipsed."
  },
  {
    "surah_id": 75,
    "ayah_number": 9,
    "global_ayah_id": 5560,
    "translation": "And the sun and the moon are joined together."
  },
  {
    "surah_id": 75,
    "ayah_number": 10,
    "global_ayah_id": 5561,
    "translation": "On that Day, man will say, “Where is the escape?”"
  },
  {
    "surah_id": 75,
    "ayah_number": 11,
    "global_ayah_id": 5562,
    "translation": "No indeed! There is no refuge."
  },
  {
    "surah_id": 75,
    "ayah_number": 12,
    "global_ayah_id": 5563,
    "translation": "To your Lord on that Day is the settlement."
  },
  {
    "surah_id": 75,
    "ayah_number": 13,
    "global_ayah_id": 5564,
    "translation": "On that Day man will be informed of everything he put forward, and everything he left behind."
  },
  {
    "surah_id": 75,
    "ayah_number": 14,
    "global_ayah_id": 5565,
    "translation": "And man will be evidence against himself."
  },
  {
    "surah_id": 75,
    "ayah_number": 15,
    "global_ayah_id": 5566,
    "translation": "Even as he presents his excuses."
  },
  {
    "surah_id": 75,
    "ayah_number": 16,
    "global_ayah_id": 5567,
    "translation": "Do not wag your tongue with it, to hurry on with it."
  },
  {
    "surah_id": 75,
    "ayah_number": 17,
    "global_ayah_id": 5568,
    "translation": "Upon Us is its collection and its recitation."
  },
  {
    "surah_id": 75,
    "ayah_number": 18,
    "global_ayah_id": 5569,
    "translation": "Then, when We have recited it, follow its recitation."
  },
  {
    "surah_id": 75,
    "ayah_number": 19,
    "global_ayah_id": 5570,
    "translation": "Then upon Us is its explanation."
  },
  {
    "surah_id": 75,
    "ayah_number": 20,
    "global_ayah_id": 5571,
    "translation": "Alas, you love the fleeting life."
  },
  {
    "surah_id": 75,
    "ayah_number": 21,
    "global_ayah_id": 5572,
    "translation": "And you disregard the Hereafter."
  },
  {
    "surah_id": 75,
    "ayah_number": 22,
    "global_ayah_id": 5573,
    "translation": "Faces on that Day will be radiant."
  },
  {
    "surah_id": 75,
    "ayah_number": 23,
    "global_ayah_id": 5574,
    "translation": "Looking towards their Lord."
  },
  {
    "surah_id": 75,
    "ayah_number": 24,
    "global_ayah_id": 5575,
    "translation": "And faces on that Day will be gloomy."
  },
  {
    "surah_id": 75,
    "ayah_number": 25,
    "global_ayah_id": 5576,
    "translation": "Realizing that a back-breaker has befallen them."
  },
  {
    "surah_id": 75,
    "ayah_number": 26,
    "global_ayah_id": 5577,
    "translation": "Indeed, when it has reached the breast-bones."
  },
  {
    "surah_id": 75,
    "ayah_number": 27,
    "global_ayah_id": 5578,
    "translation": "And it is said, “Who is the healer?”"
  },
  {
    "surah_id": 75,
    "ayah_number": 28,
    "global_ayah_id": 5579,
    "translation": "And He realizes that it is the parting."
  },
  {
    "surah_id": 75,
    "ayah_number": 29,
    "global_ayah_id": 5580,
    "translation": "And leg is entwined with leg."
  },
  {
    "surah_id": 75,
    "ayah_number": 30,
    "global_ayah_id": 5581,
    "translation": "To your Lord on that Day is the drive."
  },
  {
    "surah_id": 75,
    "ayah_number": 31,
    "global_ayah_id": 5582,
    "translation": "He neither believed nor prayed."
  },
  {
    "surah_id": 75,
    "ayah_number": 32,
    "global_ayah_id": 5583,
    "translation": "But he denied and turned away."
  },
  {
    "surah_id": 75,
    "ayah_number": 33,
    "global_ayah_id": 5584,
    "translation": "Then he went to his family, full of pride."
  },
  {
    "surah_id": 75,
    "ayah_number": 34,
    "global_ayah_id": 5585,
    "translation": "Woe to you; and woe."
  },
  {
    "surah_id": 75,
    "ayah_number": 35,
    "global_ayah_id": 5586,
    "translation": "Then again: Woe to you; and woe."
  },
  {
    "surah_id": 75,
    "ayah_number": 36,
    "global_ayah_id": 5587,
    "translation": "Does man think that he will be left without purpose?"
  },
  {
    "surah_id": 75,
    "ayah_number": 37,
    "global_ayah_id": 5588,
    "translation": "Was he not a drop of ejaculated semen?"
  },
  {
    "surah_id": 75,
    "ayah_number": 38,
    "global_ayah_id": 5589,
    "translation": "Then he became a clot. And He created and proportioned?"
  },
  {
    "surah_id": 75,
    "ayah_number": 39,
    "global_ayah_id": 5590,
    "translation": "And made of him the two sexes, the male and the female?"
  },
  {
    "surah_id": 75,
    "ayah_number": 40,
    "global_ayah_id": 5591,
    "translation": "Is He not Able to revive the dead?"
  }
]