[
  {
    "surah_id": 75,
    "ayah_number": 1,
    "global_ayah_id": 5552,
    "translation": "Kunem se Kijametskim danom"
  },
  {
    "surah_id": 75,
    "ayah_number": 2,
    "global_ayah_id": 5553,
    "translation": "i kunem se dušom koja sebe kori."
  },
  {
    "surah_id": 75,
    "ayah_number": 3,
    "global_ayah_id": 5554,
    "translation": "Zar čovjek misli da kosti njegove nećemo sakupiti?!"
  },
  {
    "surah_id": 75,
    "ayah_number": 4,
    "global_ayah_id": 5555,
    "translation": "Svakako, a Mi možemo izravnati jagodice prstiju njegovih."
  },
  {
    "surah_id": 75,
    "ayah_number": 5,
    "global_ayah_id": 5556,
    "translation": "Ali, čovjek hoće da negira ono što pred njim je"
  },
  {
    "surah_id": 75,
    "ayah_number": 6,
    "global_ayah_id": 5557,
    "translation": "pa pita: \"Kada će Kijametski dan biti?\""
  },
  {
    "surah_id": 75,
    "ayah_number": 7,
    "global_ayah_id": 5558,
    "translation": "Kada se pogled zbuni"
  },
  {
    "surah_id": 75,
    "ayah_number": 8,
    "global_ayah_id": 5559,
    "translation": "i Mjesec pomrači"
  },
  {
    "surah_id": 75,
    "ayah_number": 9,
    "global_ayah_id": 5560,
    "translation": "i Sunce i Mjesec smotaju, pa sjaj izgube,"
  },
  {
    "surah_id": 75,
    "ayah_number": 10,
    "global_ayah_id": 5561,
    "translation": "taj dan čovjek će povikati: \"Gdje da se bježi?\""
  },
  {
    "surah_id": 75,
    "ayah_number": 11,
    "global_ayah_id": 5562,
    "translation": "Ne, nema pribježišta!"
  },
  {
    "surah_id": 75,
    "ayah_number": 12,
    "global_ayah_id": 5563,
    "translation": "Taj dan tvome je Gospodaru povratak,"
  },
  {
    "surah_id": 75,
    "ayah_number": 13,
    "global_ayah_id": 5564,
    "translation": "taj dan čovjek će o onome što je pripremio, a što je propustio, obaviješten biti."
  },
  {
    "surah_id": 75,
    "ayah_number": 14,
    "global_ayah_id": 5565,
    "translation": "Štaviše, čovjek sebe dobro zna - sam će protiv sebe svjedok biti,"
  },
  {
    "surah_id": 75,
    "ayah_number": 15,
    "global_ayah_id": 5566,
    "translation": "makar iznosio svoja opravdanja."
  },
  {
    "surah_id": 75,
    "ayah_number": 16,
    "global_ayah_id": 5567,
    "translation": "Ne izgovaraj Kur'an jezikom svojim da bi ga što prije zapamtio,"
  },
  {
    "surah_id": 75,
    "ayah_number": 17,
    "global_ayah_id": 5568,
    "translation": "Mi smo ga dužni sakupiti da bi ga ti čitao."
  },
  {
    "surah_id": 75,
    "ayah_number": 18,
    "global_ayah_id": 5569,
    "translation": "A kada ga čitamo, ti prati čitanje njegovo,"
  },
  {
    "surah_id": 75,
    "ayah_number": 19,
    "global_ayah_id": 5570,
    "translation": "a poslije, Mi smo ga dužni objasniti."
  },
  {
    "surah_id": 75,
    "ayah_number": 20,
    "global_ayah_id": 5571,
    "translation": "Ali, naprotiv, vi ovaj prolazni svijet volite,"
  },
  {
    "surah_id": 75,
    "ayah_number": 21,
    "global_ayah_id": 5572,
    "translation": "a onaj drugi - ahiret zapostavljate."
  },
  {
    "surah_id": 75,
    "ayah_number": 22,
    "global_ayah_id": 5573,
    "translation": "Taj dan neka lica blistava će biti,"
  },
  {
    "surah_id": 75,
    "ayah_number": 23,
    "global_ayah_id": 5574,
    "translation": "u Gospodara svoga će gledati."
  },
  {
    "surah_id": 75,
    "ayah_number": 24,
    "global_ayah_id": 5575,
    "translation": "Taj dan neka lica smrknuta će biti,"
  },
  {
    "surah_id": 75,
    "ayah_number": 25,
    "global_ayah_id": 5576,
    "translation": "znat će da će ih snaći velika nesreća!"
  },
  {
    "surah_id": 75,
    "ayah_number": 26,
    "global_ayah_id": 5577,
    "translation": "Pazi, kada duša dopre do ključnih kostiju"
  },
  {
    "surah_id": 75,
    "ayah_number": 27,
    "global_ayah_id": 5578,
    "translation": "i vikne se: \"Ko je vidar da vida?!\","
  },
  {
    "surah_id": 75,
    "ayah_number": 28,
    "global_ayah_id": 5579,
    "translation": "i on se uvjeri da je to čas rastanka"
  },
  {
    "surah_id": 75,
    "ayah_number": 29,
    "global_ayah_id": 5580,
    "translation": "i noga se uz nogu savije."
  },
  {
    "surah_id": 75,
    "ayah_number": 30,
    "global_ayah_id": 5581,
    "translation": "Taj dan će Gospodaru tvome privođenje biti."
  },
  {
    "surah_id": 75,
    "ayah_number": 31,
    "global_ayah_id": 5582,
    "translation": "Nije vjerovao i nije klanjao,"
  },
  {
    "surah_id": 75,
    "ayah_number": 32,
    "global_ayah_id": 5583,
    "translation": "nego je poricao i okretao se,"
  },
  {
    "surah_id": 75,
    "ayah_number": 33,
    "global_ayah_id": 5584,
    "translation": "a onda je svojim oholo odlazio."
  },
  {
    "surah_id": 75,
    "ayah_number": 34,
    "global_ayah_id": 5585,
    "translation": "Teško tebi! Teško tebi!,"
  },
  {
    "surah_id": 75,
    "ayah_number": 35,
    "global_ayah_id": 5586,
    "translation": "i još jednom: Teško tebi! Teško tebi!"
  },
  {
    "surah_id": 75,
    "ayah_number": 36,
    "global_ayah_id": 5587,
    "translation": "Zar čovjek misli da će zaludu ostavljen biti?!"
  },
  {
    "surah_id": 75,
    "ayah_number": 37,
    "global_ayah_id": 5588,
    "translation": "Zar nije bio kap sjemena koja se ubaci,"
  },
  {
    "surah_id": 75,
    "ayah_number": 38,
    "global_ayah_id": 5589,
    "translation": "zatim zakvačak kome On onda razmjer odredi i skladnim mu lik učini,"
  },
  {
    "surah_id": 75,
    "ayah_number": 39,
    "global_ayah_id": 5590,
    "translation": "i od njega dvije vrste, muškarca i ženu, stvori,"
  },
  {
    "surah_id": 75,
    "ayah_number": 40,
    "global_ayah_id": 5591,
    "translation": "i zar Taj nije kadar mrtve oživiti?!"
  }
]