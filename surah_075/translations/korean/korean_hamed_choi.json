[
  {
    "surah_id": 75,
    "ayah_number": 1,
    "global_ayah_id": 5552,
    "translation": "부활의 날을 두고 맹세하사"
  },
  {
    "surah_id": 75,
    "ayah_number": 2,
    "global_ayah_id": 5553,
    "translation": "스스로 책망하는 영혼을 두고맹세하나니"
  },
  {
    "surah_id": 75,
    "ayah_number": 3,
    "global_ayah_id": 5554,
    "translation": "인간은 하나님이 그의 뼈들을모을 수 없다고 생각하느뇨"
  },
  {
    "surah_id": 75,
    "ayah_number": 4,
    "global_ayah_id": 5555,
    "translation": "하나님에게는 인간의 손가락 끝의 뼈까지도 부활시킬 수 있는 권능이 있노라"
  },
  {
    "surah_id": 75,
    "ayah_number": 5,
    "global_ayah_id": 5556,
    "translation": "그래도 인간은 그의 앞에 남 아 있는 기간까지도 불신하려 하 며"
  },
  {
    "surah_id": 75,
    "ayah_number": 6,
    "global_ayah_id": 5557,
    "translation": "부활의 날이 언제이뇨 라고 묻더라"
  },
  {
    "surah_id": 75,
    "ayah_number": 7,
    "global_ayah_id": 5558,
    "translation": "그리하여 시야는 현혹되고"
  },
  {
    "surah_id": 75,
    "ayah_number": 8,
    "global_ayah_id": 5559,
    "translation": "달은 어둠속에 묻히며"
  },
  {
    "surah_id": 75,
    "ayah_number": 9,
    "global_ayah_id": 5560,
    "translation": "태양과 달이 함께 모이는 날"
  },
  {
    "surah_id": 75,
    "ayah_number": 10,
    "global_ayah_id": 5561,
    "translation": "은신처가 어디입니까 라고 그날 인간은 질문하나"
  },
  {
    "surah_id": 75,
    "ayah_number": 11,
    "global_ayah_id": 5562,
    "translation": "그들에게는 은신처가 없노라"
  },
  {
    "surah_id": 75,
    "ayah_number": 12,
    "global_ayah_id": 5563,
    "translation": "그날은 주님에게로만 돌아갈거처 뿐이라"
  },
  {
    "surah_id": 75,
    "ayah_number": 13,
    "global_ayah_id": 5564,
    "translation": "그날 인간은 그가 앞서 행한모든 것과 후에 미루어졌던 모든 것을 알게 되매"
  },
  {
    "surah_id": 75,
    "ayah_number": 14,
    "global_ayah_id": 5565,
    "translation": "그때 인간은 그가 스스로의 증인이 되노라"
  },
  {
    "surah_id": 75,
    "ayah_number": 15,
    "global_ayah_id": 5566,
    "translation": "어떤 변명도 그에게 유용하 지 않노라"
  },
  {
    "surah_id": 75,
    "ayah_number": 16,
    "global_ayah_id": 5567,
    "translation": "꾸란을 계시 받음에 서둘러 그대의 혀를 움직이지 말라"
  },
  {
    "surah_id": 75,
    "ayah_number": 17,
    "global_ayah_id": 5568,
    "translation": "하나님이 그것을 모아 그대 로 하여금 암송케 하리니"
  },
  {
    "surah_id": 75,
    "ayah_number": 18,
    "global_ayah_id": 5569,
    "translation": "하나님이 그것을 읽은 후에 그대가 따라 읽으라"
  },
  {
    "surah_id": 75,
    "ayah_number": 19,
    "global_ayah_id": 5570,
    "translation": "그런 후 하나님이 그것을 설명하여 주리라"
  },
  {
    "surah_id": 75,
    "ayah_number": 20,
    "global_ayah_id": 5571,
    "translation": "그러나 너희는 지나가는 현 세의 삶을 사랑하고"
  },
  {
    "surah_id": 75,
    "ayah_number": 21,
    "global_ayah_id": 5572,
    "translation": "내세를 게을리 하도다"
  },
  {
    "surah_id": 75,
    "ayah_number": 22,
    "global_ayah_id": 5573,
    "translation": "그날 일부는 그들의 얼굴에 빛을 발산하며"
  },
  {
    "surah_id": 75,
    "ayah_number": 23,
    "global_ayah_id": 5574,
    "translation": "그들의 주님을 향하여 있고"
  },
  {
    "surah_id": 75,
    "ayah_number": 24,
    "global_ayah_id": 5575,
    "translation": "그날 일부는 그들의 얼굴에 슬픔과 고뇌로 가득차며"
  },
  {
    "surah_id": 75,
    "ayah_number": 25,
    "global_ayah_id": 5576,
    "translation": "그들 위에 얼마의 큰 재앙이 임박했음을 알게 되도다"
  },
  {
    "surah_id": 75,
    "ayah_number": 26,
    "global_ayah_id": 5577,
    "translation": "그때 영혼이 목구멍까지 이 르매"
  },
  {
    "surah_id": 75,
    "ayah_number": 27,
    "global_ayah_id": 5578,
    "translation": "그를 구할 마술사가 누구이 뇨 라는 소리가 들리니"
  },
  {
    "surah_id": 75,
    "ayah_number": 28,
    "global_ayah_id": 5579,
    "translation": "그는 이별할 시간이라는 것 을 확신하고"
  },
  {
    "surah_id": 75,
    "ayah_number": 29,
    "global_ayah_id": 5580,
    "translation": "한 다리가 다른 것에 포개어 져"
  },
  {
    "surah_id": 75,
    "ayah_number": 30,
    "global_ayah_id": 5581,
    "translation": "그날 주님께로 운반되어 가 노라"
  },
  {
    "surah_id": 75,
    "ayah_number": 31,
    "global_ayah_id": 5582,
    "translation": "그것은 그가 확증하지 아니 하고 예배를 드리지 아니하며"
  },
  {
    "surah_id": 75,
    "ayah_number": 32,
    "global_ayah_id": 5583,
    "translation": "진리를 거역하고 외면했으며"
  },
  {
    "surah_id": 75,
    "ayah_number": 33,
    "global_ayah_id": 5584,
    "translation": "완전히 기만된 그의 무리를 오만하게 따랐기 때문이라"
  },
  {
    "surah_id": 75,
    "ayah_number": 34,
    "global_ayah_id": 5585,
    "translation": "너희에게 재앙이 있으리라"
  },
  {
    "surah_id": 75,
    "ayah_number": 35,
    "global_ayah_id": 5586,
    "translation": "더하여 너희에게 재앙이 있 으리라"
  },
  {
    "surah_id": 75,
    "ayah_number": 36,
    "global_ayah_id": 5587,
    "translation": "아무 목적없이 방황토록 내 버려 두리라 인간은 생각하느뇨"
  },
  {
    "surah_id": 75,
    "ayah_number": 37,
    "global_ayah_id": 5588,
    "translation": "그는 단지 흘러나온 정액의 한 방울에 불과하지 않느뇨"
  },
  {
    "surah_id": 75,
    "ayah_number": 38,
    "global_ayah_id": 5589,
    "translation": "그리하여 응혈이 되매 그분 은 그를 완전한 형상으로 지으시 고"
  },
  {
    "surah_id": 75,
    "ayah_number": 39,
    "global_ayah_id": 5590,
    "translation": "남성과 여성으로 자웅을 두 셨으매"
  },
  {
    "surah_id": 75,
    "ayah_number": 40,
    "global_ayah_id": 5591,
    "translation": "그러한 능력을 가진 그분이 죽은 자를 살게 할 수 없단 말이뇨"
  }
]