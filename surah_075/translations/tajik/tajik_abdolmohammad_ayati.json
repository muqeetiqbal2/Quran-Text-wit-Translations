[
  {
    "surah_id": 75,
    "ayah_number": 1,
    "global_ayah_id": 5552,
    "translation": "Қасам мехӯрам ба рӯзи қиёмат"
  },
  {
    "surah_id": 75,
    "ayah_number": 2,
    "global_ayah_id": 5553,
    "translation": "ва қасам мехӯрам ба нафси маломатгар!"
  },
  {
    "surah_id": 75,
    "ayah_number": 3,
    "global_ayah_id": 5554,
    "translation": "Оё одамӣ мепиндорад, ки Мо устухонҳояшро гирд нахоҳем овард?"
  },
  {
    "surah_id": 75,
    "ayah_number": 4,
    "global_ayah_id": 5555,
    "translation": "Оре, мо қодир ҳастем, ки сарангуштҳояшро баробар кунем."
  },
  {
    "surah_id": 75,
    "ayah_number": 5,
    "global_ayah_id": 5556,
    "translation": "Балки одамӣ мехоҳад, ки дар оянда низ ба корҳои ношоиста пардозад."
  },
  {
    "surah_id": 75,
    "ayah_number": 6,
    "global_ayah_id": 5557,
    "translation": "Мепурсад: «Рӯзи қиёмат чӣ вақт хоҳад буд?»"
  },
  {
    "surah_id": 75,
    "ayah_number": 7,
    "global_ayah_id": 5558,
    "translation": "Рӯзе, ки чашмҳо хира шавад"
  },
  {
    "surah_id": 75,
    "ayah_number": 8,
    "global_ayah_id": 5559,
    "translation": "ва моҳ тира шавад"
  },
  {
    "surah_id": 75,
    "ayah_number": 9,
    "global_ayah_id": 5560,
    "translation": "ва офтобу моҳ дар як ҷой ҷамъ оянд."
  },
  {
    "surah_id": 75,
    "ayah_number": 10,
    "global_ayah_id": 5561,
    "translation": "Инсон дар он рӯз мегӯяд: «Роҳи гурез куҷост?»"
  },
  {
    "surah_id": 75,
    "ayah_number": 11,
    "global_ayah_id": 5562,
    "translation": "Ҳаргиз паноҳгоҳе нест!"
  },
  {
    "surah_id": 75,
    "ayah_number": 12,
    "global_ayah_id": 5563,
    "translation": "Қароргоҳи ҳама дар ин рӯз назди Парвардигори туст!"
  },
  {
    "surah_id": 75,
    "ayah_number": 13,
    "global_ayah_id": 5564,
    "translation": "Дар ин рӯз одамиро аз ҳар чӣ пешопеш фиристода ва баъд аз худ гузоштааст, хабар медиҳанд."
  },
  {
    "surah_id": 75,
    "ayah_number": 14,
    "global_ayah_id": 5565,
    "translation": "Балки одамӣ худро нек мешиносад,"
  },
  {
    "surah_id": 75,
    "ayah_number": 15,
    "global_ayah_id": 5566,
    "translation": "ҳарчанд ба забон узрҳо оварад."
  },
  {
    "surah_id": 75,
    "ayah_number": 16,
    "global_ayah_id": 5567,
    "translation": "Ба шитоб забон ба хондани Қуръон наҷунбон,"
  },
  {
    "surah_id": 75,
    "ayah_number": 17,
    "global_ayah_id": 5568,
    "translation": "ки ҷамъ овардану хонданаш бар ӯҳдаи Мост,"
  },
  {
    "surah_id": 75,
    "ayah_number": 18,
    "global_ayah_id": 5569,
    "translation": "Чун хондемаш, ту он хонданро пайравӣ кун,"
  },
  {
    "surah_id": 75,
    "ayah_number": 19,
    "global_ayah_id": 5570,
    "translation": "Сипас баёни он бар ӯҳдаи Мост."
  },
  {
    "surah_id": 75,
    "ayah_number": 20,
    "global_ayah_id": 5571,
    "translation": "Оре, шумо ин ҷаҳони зудгузарро дӯст медоред"
  },
  {
    "surah_id": 75,
    "ayah_number": 21,
    "global_ayah_id": 5572,
    "translation": "ва охиратро тарк мекунед."
  },
  {
    "surah_id": 75,
    "ayah_number": 22,
    "global_ayah_id": 5573,
    "translation": "Дар он рӯз рӯйҳое ҳаст зебову дурахшон,"
  },
  {
    "surah_id": 75,
    "ayah_number": 23,
    "global_ayah_id": 5574,
    "translation": "ки сӯи Парвардигорашон назар мекунанд"
  },
  {
    "surah_id": 75,
    "ayah_number": 24,
    "global_ayah_id": 5575,
    "translation": "ва рӯйҳое ҳаст гирифтаву турш,"
  },
  {
    "surah_id": 75,
    "ayah_number": 25,
    "global_ayah_id": 5576,
    "translation": "ки медонад он азоби камаршикан бар ӯ фуруд ояд."
  },
  {
    "surah_id": 75,
    "ayah_number": 26,
    "global_ayah_id": 5577,
    "translation": "Оре, чун ҷон ба гулӯ расад"
  },
  {
    "surah_id": 75,
    "ayah_number": 27,
    "global_ayah_id": 5578,
    "translation": "ва гуфта шавад, ки чӣ касест, ки афсун бихонад?"
  },
  {
    "surah_id": 75,
    "ayah_number": 28,
    "global_ayah_id": 5579,
    "translation": "Ва яқин кунад, ки замони ҷудоӣ фаро расида"
  },
  {
    "surah_id": 75,
    "ayah_number": 29,
    "global_ayah_id": 5580,
    "translation": "ва соқҳои по дар ҳам печида шаванд,"
  },
  {
    "surah_id": 75,
    "ayah_number": 30,
    "global_ayah_id": 5581,
    "translation": "он рӯз рӯзи ронданаш ба сӯи Парвардигори туст."
  },
  {
    "surah_id": 75,
    "ayah_number": 31,
    "global_ayah_id": 5582,
    "translation": "На тасдиқ кардааст ва на намоз гузоридааст."
  },
  {
    "surah_id": 75,
    "ayah_number": 32,
    "global_ayah_id": 5583,
    "translation": "Аммо дурӯғ бароварда ва рӯй гардондааст."
  },
  {
    "surah_id": 75,
    "ayah_number": 33,
    "global_ayah_id": 5584,
    "translation": "Он гоҳ хиромон назди касонаш рафтааст."
  },
  {
    "surah_id": 75,
    "ayah_number": 34,
    "global_ayah_id": 5585,
    "translation": "Вой бар ту, пас вой бар ту!"
  },
  {
    "surah_id": 75,
    "ayah_number": 35,
    "global_ayah_id": 5586,
    "translation": "Боз ҳам вой бар ту, пас вой бар ту!"
  },
  {
    "surah_id": 75,
    "ayah_number": 36,
    "global_ayah_id": 5587,
    "translation": "Оё инсон мепиндорад, ки ӯро ба ҳоли худ, вогузоштаанд?"
  },
  {
    "surah_id": 75,
    "ayah_number": 37,
    "global_ayah_id": 5588,
    "translation": "Оё ӯ нутфае аз манӣ, ки дар раҳме рехта шуда, набудааст?"
  },
  {
    "surah_id": 75,
    "ayah_number": 38,
    "global_ayah_id": 5589,
    "translation": "Сипас лахтае хун? Он гоҳ ба андоми дурусташ биёфарид."
  },
  {
    "surah_id": 75,
    "ayah_number": 39,
    "global_ayah_id": 5590,
    "translation": "Ва онҳоро ду синф кард: нару мода."
  },
  {
    "surah_id": 75,
    "ayah_number": 40,
    "global_ayah_id": 5591,
    "translation": "Оё Худованд қодир нест, ки мурдагонро зинда созад?"
  }
]