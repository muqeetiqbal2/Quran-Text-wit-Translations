[
  {
    "surah_id": 75,
    "ayah_number": 1,
    "global_ayah_id": 5552,
    "translation": "Кълна се в Деня на възкресението."
  },
  {
    "surah_id": 75,
    "ayah_number": 2,
    "global_ayah_id": 5553,
    "translation": "И кълна се в многоукоряващата [се] душа."
  },
  {
    "surah_id": 75,
    "ayah_number": 3,
    "global_ayah_id": 5554,
    "translation": "Нима човек смята, че Ние не ще съберем костите му?"
  },
  {
    "surah_id": 75,
    "ayah_number": 4,
    "global_ayah_id": 5555,
    "translation": "Наистина Ние можем да възстановим и върховете на пръстите му."
  },
  {
    "surah_id": 75,
    "ayah_number": 5,
    "global_ayah_id": 5556,
    "translation": "Ала човек упорства в греха си"
  },
  {
    "surah_id": 75,
    "ayah_number": 6,
    "global_ayah_id": 5557,
    "translation": "и пита: “Кога е Денят на възкресението?”"
  },
  {
    "surah_id": 75,
    "ayah_number": 7,
    "global_ayah_id": 5558,
    "translation": "Тогава, когато погледът се заслепи"
  },
  {
    "surah_id": 75,
    "ayah_number": 8,
    "global_ayah_id": 5559,
    "translation": "и луната се затъмни,"
  },
  {
    "surah_id": 75,
    "ayah_number": 9,
    "global_ayah_id": 5560,
    "translation": "и слънцето, и луната се слеят,"
  },
  {
    "surah_id": 75,
    "ayah_number": 10,
    "global_ayah_id": 5561,
    "translation": "човекът ще каже в този Ден: “Накъде да се бяга?”"
  },
  {
    "surah_id": 75,
    "ayah_number": 11,
    "global_ayah_id": 5562,
    "translation": "Ала не! Няма убежище."
  },
  {
    "surah_id": 75,
    "ayah_number": 12,
    "global_ayah_id": 5563,
    "translation": "При твоя Господ в този Ден е местопребиванието."
  },
  {
    "surah_id": 75,
    "ayah_number": 13,
    "global_ayah_id": 5564,
    "translation": "Човекът в този Ден ще бъде известен за ранните си дела и за късните."
  },
  {
    "surah_id": 75,
    "ayah_number": 14,
    "global_ayah_id": 5565,
    "translation": "Да, човекът сам за себе си ще е свидетел,"
  },
  {
    "surah_id": 75,
    "ayah_number": 15,
    "global_ayah_id": 5566,
    "translation": "дори да дава извинения."
  },
  {
    "surah_id": 75,
    "ayah_number": 16,
    "global_ayah_id": 5567,
    "translation": "Не си движи езика с това Слово [о, Мухаммад], за да избързаш [да го запомниш]!"
  },
  {
    "surah_id": 75,
    "ayah_number": 17,
    "global_ayah_id": 5568,
    "translation": "Да бъде събрано [в твоите гърди] и четено [от теб] е Наша грижа."
  },
  {
    "surah_id": 75,
    "ayah_number": 18,
    "global_ayah_id": 5569,
    "translation": "И когато го четем, следвай неговото четене!"
  },
  {
    "surah_id": 75,
    "ayah_number": 19,
    "global_ayah_id": 5570,
    "translation": "После неговото разясняване е Наша грижа."
  },
  {
    "surah_id": 75,
    "ayah_number": 20,
    "global_ayah_id": 5571,
    "translation": "Ала не! Вие обичате преходността [на земния живот]"
  },
  {
    "surah_id": 75,
    "ayah_number": 21,
    "global_ayah_id": 5572,
    "translation": "и изоставяте отвъдния."
  },
  {
    "surah_id": 75,
    "ayah_number": 22,
    "global_ayah_id": 5573,
    "translation": "Едни лица в този Ден ще възсияят,"
  },
  {
    "surah_id": 75,
    "ayah_number": 23,
    "global_ayah_id": 5574,
    "translation": "към своя Господ ще гледат,"
  },
  {
    "surah_id": 75,
    "ayah_number": 24,
    "global_ayah_id": 5575,
    "translation": "а други в този Ден ще бъдат мрачни,"
  },
  {
    "surah_id": 75,
    "ayah_number": 25,
    "global_ayah_id": 5576,
    "translation": "ще се убедят, че ги е сполетяла беда, пречупваща гръбнака."
  },
  {
    "surah_id": 75,
    "ayah_number": 26,
    "global_ayah_id": 5577,
    "translation": "А когато душата стигне гръкляна"
  },
  {
    "surah_id": 75,
    "ayah_number": 27,
    "global_ayah_id": 5578,
    "translation": "и се рече: “Кой ще те избави?”,"
  },
  {
    "surah_id": 75,
    "ayah_number": 28,
    "global_ayah_id": 5579,
    "translation": "и той се убеди, че [това] е раздялата,"
  },
  {
    "surah_id": 75,
    "ayah_number": 29,
    "global_ayah_id": 5580,
    "translation": "и се преплете крак с крак -"
  },
  {
    "surah_id": 75,
    "ayah_number": 30,
    "global_ayah_id": 5581,
    "translation": "тогава към твоя Господ ще е отправянето."
  },
  {
    "surah_id": 75,
    "ayah_number": 31,
    "global_ayah_id": 5582,
    "translation": "тогава към твоя Господ ще е отправянето."
  },
  {
    "surah_id": 75,
    "ayah_number": 32,
    "global_ayah_id": 5583,
    "translation": "Той нито вярваше, нито отслужваше молитвата,"
  },
  {
    "surah_id": 75,
    "ayah_number": 33,
    "global_ayah_id": 5584,
    "translation": "а отричаше и се отвръщаше."
  },
  {
    "surah_id": 75,
    "ayah_number": 34,
    "global_ayah_id": 5585,
    "translation": "После отиваше при своите хора с горделива походка."
  },
  {
    "surah_id": 75,
    "ayah_number": 35,
    "global_ayah_id": 5586,
    "translation": "Горко ти, горко!"
  },
  {
    "surah_id": 75,
    "ayah_number": 36,
    "global_ayah_id": 5587,
    "translation": "И отново - горко ти, горко!"
  },
  {
    "surah_id": 75,
    "ayah_number": 37,
    "global_ayah_id": 5588,
    "translation": "Нима човек смята, че ще бъде оставен без надзор?"
  },
  {
    "surah_id": 75,
    "ayah_number": 38,
    "global_ayah_id": 5589,
    "translation": "После бе съсирек, а Той го сътвори и осъразмери."
  },
  {
    "surah_id": 75,
    "ayah_number": 39,
    "global_ayah_id": 5590,
    "translation": "И създаде от нея двата пола - мъжа и жената."
  },
  {
    "surah_id": 75,
    "ayah_number": 40,
    "global_ayah_id": 5591,
    "translation": "Нима Той не е способен да съживи мъртвите?"
  }
]