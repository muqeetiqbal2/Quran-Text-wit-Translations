[
  {
    "surah_id": 75,
    "ayah_number": 1,
    "global_ayah_id": 5552,
    "translation": "আমি শপথ করি কেয়ামত দিবসের,"
  },
  {
    "surah_id": 75,
    "ayah_number": 2,
    "global_ayah_id": 5553,
    "translation": "আরও শপথ করি সেই মনের, যে নিজেকে ধিক্কার দেয়-"
  },
  {
    "surah_id": 75,
    "ayah_number": 3,
    "global_ayah_id": 5554,
    "translation": "মানুষ কি মনে করে যে আমি তার অস্থিসমূহ একত্রিত করব না?"
  },
  {
    "surah_id": 75,
    "ayah_number": 4,
    "global_ayah_id": 5555,
    "translation": "পরন্ত আমি তার অংগুলিগুলো পর্যন্ত সঠিকভাবে সন্নিবেশিত করতে সক্ষম।"
  },
  {
    "surah_id": 75,
    "ayah_number": 5,
    "global_ayah_id": 5556,
    "translation": "বরং মানুষ তার ভবিষ্যত জীবনেও ধৃষ্টতা করতে চায়"
  },
  {
    "surah_id": 75,
    "ayah_number": 6,
    "global_ayah_id": 5557,
    "translation": "সে প্রশ্ন করে-কেয়ামত দিবস কবে?"
  },
  {
    "surah_id": 75,
    "ayah_number": 7,
    "global_ayah_id": 5558,
    "translation": "যখন দৃষ্টি চমকে যাবে,"
  },
  {
    "surah_id": 75,
    "ayah_number": 8,
    "global_ayah_id": 5559,
    "translation": "চন্দ্র জ্যোতিহীন হয়ে যাবে।"
  },
  {
    "surah_id": 75,
    "ayah_number": 9,
    "global_ayah_id": 5560,
    "translation": "এবং সূর্য ও চন্দ্রকে একত্রিত করা হবে-"
  },
  {
    "surah_id": 75,
    "ayah_number": 10,
    "global_ayah_id": 5561,
    "translation": "সে দিন মানুষ বলবেঃ পলায়নের জায়গা কোথায় ?"
  },
  {
    "surah_id": 75,
    "ayah_number": 11,
    "global_ayah_id": 5562,
    "translation": "না কোথাও আশ্রয়স্থল নেই।"
  },
  {
    "surah_id": 75,
    "ayah_number": 12,
    "global_ayah_id": 5563,
    "translation": "আপনার পালনকর্তার কাছেই সেদিন ঠাঁই হবে।"
  },
  {
    "surah_id": 75,
    "ayah_number": 13,
    "global_ayah_id": 5564,
    "translation": "সেদিন মানুষকে অবহিত করা হবে সে যা সামনে প্রেরণ করেছে ও পশ্চাতে ছেড়ে দিয়েছে।"
  },
  {
    "surah_id": 75,
    "ayah_number": 14,
    "global_ayah_id": 5565,
    "translation": "বরং মানুষ নিজেই তার নিজের সম্পর্কে চক্ষুমান।"
  },
  {
    "surah_id": 75,
    "ayah_number": 15,
    "global_ayah_id": 5566,
    "translation": "যদিও সে তার অজুহাত পেশ করতে চাইবে।"
  },
  {
    "surah_id": 75,
    "ayah_number": 16,
    "global_ayah_id": 5567,
    "translation": "তাড়াতাড়ি শিখে নেয়ার জন্যে আপনি দ্রুত ওহী আবৃত্তি করবেন না।"
  },
  {
    "surah_id": 75,
    "ayah_number": 17,
    "global_ayah_id": 5568,
    "translation": "এর সংরক্ষণ ও পাঠ আমারই দায়িত্ব।"
  },
  {
    "surah_id": 75,
    "ayah_number": 18,
    "global_ayah_id": 5569,
    "translation": "অতঃপর আমি যখন তা পাঠ করি, তখন আপনি সেই পাঠের অনুসরণ করুন।"
  },
  {
    "surah_id": 75,
    "ayah_number": 19,
    "global_ayah_id": 5570,
    "translation": "এরপর বিশদ বর্ণনা আমারই দায়িত্ব।"
  },
  {
    "surah_id": 75,
    "ayah_number": 20,
    "global_ayah_id": 5571,
    "translation": "কখনও না, বরং তোমরা পার্থিব জীবনকে ভালবাস"
  },
  {
    "surah_id": 75,
    "ayah_number": 21,
    "global_ayah_id": 5572,
    "translation": "এবং পরকালকে উপেক্ষা কর।"
  },
  {
    "surah_id": 75,
    "ayah_number": 22,
    "global_ayah_id": 5573,
    "translation": "সেদিন অনেক মুখমন্ডল উজ্জ্বল হবে।"
  },
  {
    "surah_id": 75,
    "ayah_number": 23,
    "global_ayah_id": 5574,
    "translation": "তারা তার পালনকর্তার দিকে তাকিয়ে থাকবে।"
  },
  {
    "surah_id": 75,
    "ayah_number": 24,
    "global_ayah_id": 5575,
    "translation": "আর অনেক মুখমন্ডল সেদিন উদাস হয়ে পড়বে।"
  },
  {
    "surah_id": 75,
    "ayah_number": 25,
    "global_ayah_id": 5576,
    "translation": "তারা ধারণা করবে যে, তাদের সাথে কোমর-ভাঙ্গা আচরণ করা হবে।"
  },
  {
    "surah_id": 75,
    "ayah_number": 26,
    "global_ayah_id": 5577,
    "translation": "কখনও না, যখন প্রাণ কন্ঠাগত হবে।"
  },
  {
    "surah_id": 75,
    "ayah_number": 27,
    "global_ayah_id": 5578,
    "translation": "এবং বলা হবে, কে ঝাড়বে"
  },
  {
    "surah_id": 75,
    "ayah_number": 28,
    "global_ayah_id": 5579,
    "translation": "এবং সে মনে করবে যে, বিদায়ের ক্ষণ এসে গেছে।"
  },
  {
    "surah_id": 75,
    "ayah_number": 29,
    "global_ayah_id": 5580,
    "translation": "এবং গোছা গোছার সাথে জড়িত হয়ে যাবে।"
  },
  {
    "surah_id": 75,
    "ayah_number": 30,
    "global_ayah_id": 5581,
    "translation": "সেদিন, আপনার পালনকর্তার নিকট সবকিছু নীত হবে।"
  },
  {
    "surah_id": 75,
    "ayah_number": 31,
    "global_ayah_id": 5582,
    "translation": "সে বিশ্বাস করেনি এবং নামায পড়েনি;"
  },
  {
    "surah_id": 75,
    "ayah_number": 32,
    "global_ayah_id": 5583,
    "translation": "পরন্ত মিথ্যারোপ করেছে ও পৃষ্ঠ প্রদর্শন করেছে।"
  },
  {
    "surah_id": 75,
    "ayah_number": 33,
    "global_ayah_id": 5584,
    "translation": "অতঃপর সে দম্ভভরে পরিবার-পরিজনের নিকট ফিরে গিয়েছে।"
  },
  {
    "surah_id": 75,
    "ayah_number": 34,
    "global_ayah_id": 5585,
    "translation": "তোমার দুর্ভোগের উপর দুর্ভোগ।"
  },
  {
    "surah_id": 75,
    "ayah_number": 35,
    "global_ayah_id": 5586,
    "translation": "অতঃপর, তোমার দুর্ভোগের উপর দূর্ভোগ।"
  },
  {
    "surah_id": 75,
    "ayah_number": 36,
    "global_ayah_id": 5587,
    "translation": "মানুষ কি মনে করে যে, তাকে এমনি ছেড়ে দেয়া হবে?"
  },
  {
    "surah_id": 75,
    "ayah_number": 37,
    "global_ayah_id": 5588,
    "translation": "সে কি স্খলিত বীর্য ছিল না?"
  },
  {
    "surah_id": 75,
    "ayah_number": 38,
    "global_ayah_id": 5589,
    "translation": "অতঃপর সে ছিল রক্তপিন্ড, অতঃপর আল্লাহ তাকে সৃষ্টি করেছেন এবং সুবিন্যস্ত করেছেন।"
  },
  {
    "surah_id": 75,
    "ayah_number": 39,
    "global_ayah_id": 5590,
    "translation": "অতঃপর তা থেকে সৃষ্টি করেছেন যুগল নর ও নারী।"
  },
  {
    "surah_id": 75,
    "ayah_number": 40,
    "global_ayah_id": 5591,
    "translation": "তবুও কি সেই আল্লাহ মৃতদেরকে জীবিত করতে সক্ষম নন?"
  }
]