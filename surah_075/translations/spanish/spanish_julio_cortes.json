[
  {
    "surah_id": 75,
    "ayah_number": 1,
    "global_ayah_id": 5552,
    "translation": "¡No! ¡Juro por el día de la Resurreción!"
  },
  {
    "surah_id": 75,
    "ayah_number": 2,
    "global_ayah_id": 5553,
    "translation": "¡Que no! ¡Juro por el alma que reprueba!"
  },
  {
    "surah_id": 75,
    "ayah_number": 3,
    "global_ayah_id": 5554,
    "translation": "¿Cree el hombre que no juntaremos sus huesos?"
  },
  {
    "surah_id": 75,
    "ayah_number": 4,
    "global_ayah_id": 5555,
    "translation": "¡Claro que sí! Somos capaces de recomponer sus dedos."
  },
  {
    "surah_id": 75,
    "ayah_number": 5,
    "global_ayah_id": 5556,
    "translation": "Pero el hombre preferiría continuar viviendo como un libertino."
  },
  {
    "surah_id": 75,
    "ayah_number": 6,
    "global_ayah_id": 5557,
    "translation": "Pregunta: «¿Cuándo será el día de la Resurrección?»"
  },
  {
    "surah_id": 75,
    "ayah_number": 7,
    "global_ayah_id": 5558,
    "translation": "Cuando se ofusque la vista,"
  },
  {
    "surah_id": 75,
    "ayah_number": 8,
    "global_ayah_id": 5559,
    "translation": "se eclipse la luna,"
  },
  {
    "surah_id": 75,
    "ayah_number": 9,
    "global_ayah_id": 5560,
    "translation": "se reúnan el sol y la luna,"
  },
  {
    "surah_id": 75,
    "ayah_number": 10,
    "global_ayah_id": 5561,
    "translation": "ese día, el hombre dirá: «Y ¿adónde escapar?»"
  },
  {
    "surah_id": 75,
    "ayah_number": 11,
    "global_ayah_id": 5562,
    "translation": "¡No! ¡No habrá escape!"
  },
  {
    "surah_id": 75,
    "ayah_number": 12,
    "global_ayah_id": 5563,
    "translation": "Ese día, el lugar de descanso estará junto a tu Señor."
  },
  {
    "surah_id": 75,
    "ayah_number": 13,
    "global_ayah_id": 5564,
    "translation": "Ese día, ya se le informará al hombre de lo que hizo y de lo que dejó de hacer."
  },
  {
    "surah_id": 75,
    "ayah_number": 14,
    "global_ayah_id": 5565,
    "translation": "¡Más aún! El hombre testificará contra sí mismo,"
  },
  {
    "surah_id": 75,
    "ayah_number": 15,
    "global_ayah_id": 5566,
    "translation": "aun cuando presente sus excusas."
  },
  {
    "surah_id": 75,
    "ayah_number": 16,
    "global_ayah_id": 5567,
    "translation": "No muevas la lengua al recitarlo para precipitarla!"
  },
  {
    "surah_id": 75,
    "ayah_number": 17,
    "global_ayah_id": 5568,
    "translation": "¡Somos Nosotros los encargados de juntarlo y de recitarlo!"
  },
  {
    "surah_id": 75,
    "ayah_number": 18,
    "global_ayah_id": 5569,
    "translation": "Y, cuando lo recitemos, ¡sigue la recitación!"
  },
  {
    "surah_id": 75,
    "ayah_number": 19,
    "global_ayah_id": 5570,
    "translation": "Luego, a Nosotros nos toca explicarlo."
  },
  {
    "surah_id": 75,
    "ayah_number": 20,
    "global_ayah_id": 5571,
    "translation": "Pero ¡no! En lugar de eso, amáis la vida fugaz"
  },
  {
    "surah_id": 75,
    "ayah_number": 21,
    "global_ayah_id": 5572,
    "translation": "y descuidáis la otra vida."
  },
  {
    "surah_id": 75,
    "ayah_number": 22,
    "global_ayah_id": 5573,
    "translation": "Ese día, unos rostros brillarán,"
  },
  {
    "surah_id": 75,
    "ayah_number": 23,
    "global_ayah_id": 5574,
    "translation": "mirando a su Señor,"
  },
  {
    "surah_id": 75,
    "ayah_number": 24,
    "global_ayah_id": 5575,
    "translation": "mientras que otros, ese día, estarán tristes,"
  },
  {
    "surah_id": 75,
    "ayah_number": 25,
    "global_ayah_id": 5576,
    "translation": "pensando que una calamidad les alcance."
  },
  {
    "surah_id": 75,
    "ayah_number": 26,
    "global_ayah_id": 5577,
    "translation": "¡No! Cuando suba hasta las clavículas,"
  },
  {
    "surah_id": 75,
    "ayah_number": 27,
    "global_ayah_id": 5578,
    "translation": "se diga: «¿quién es encantador?»,"
  },
  {
    "surah_id": 75,
    "ayah_number": 28,
    "global_ayah_id": 5579,
    "translation": "crea llegado el momento de la separación"
  },
  {
    "surah_id": 75,
    "ayah_number": 29,
    "global_ayah_id": 5580,
    "translation": "y se junte una pierna con otra,"
  },
  {
    "surah_id": 75,
    "ayah_number": 30,
    "global_ayah_id": 5581,
    "translation": "ese día la marcha será hacia tu Señor."
  },
  {
    "surah_id": 75,
    "ayah_number": 31,
    "global_ayah_id": 5582,
    "translation": "No creyó, ni oró,"
  },
  {
    "surah_id": 75,
    "ayah_number": 32,
    "global_ayah_id": 5583,
    "translation": "antes bien, desmintió y se desvió."
  },
  {
    "surah_id": 75,
    "ayah_number": 33,
    "global_ayah_id": 5584,
    "translation": "Luego, se volvió a los suyos con andar altanero."
  },
  {
    "surah_id": 75,
    "ayah_number": 34,
    "global_ayah_id": 5585,
    "translation": "¡Ay de ti! ¡Ay!"
  },
  {
    "surah_id": 75,
    "ayah_number": 35,
    "global_ayah_id": 5586,
    "translation": "¡Sí! ¡Ay de ti! ¡Ay!"
  },
  {
    "surah_id": 75,
    "ayah_number": 36,
    "global_ayah_id": 5587,
    "translation": "¿Cree el hombre que no van a ocuparse de él?"
  },
  {
    "surah_id": 75,
    "ayah_number": 37,
    "global_ayah_id": 5588,
    "translation": "¿No fue una gota de esperma eyaculada"
  },
  {
    "surah_id": 75,
    "ayah_number": 38,
    "global_ayah_id": 5589,
    "translation": "y, luego, un coágulo de sangre? Él lo creó y le dio forma armoniosa."
  },
  {
    "surah_id": 75,
    "ayah_number": 39,
    "global_ayah_id": 5590,
    "translation": "E hizo de él una pareja: varón y hembra."
  },
  {
    "surah_id": 75,
    "ayah_number": 40,
    "global_ayah_id": 5591,
    "translation": "Ese tal ¿no será capaz de devolver la vida a los muertos?"
  }
]