[
  {
    "surah_id": 75,
    "ayah_number": 1,
    "global_ayah_id": 5552,
    "translation": "(ነገሩ ከሓዲዎች እንደሚሉት) አይደለም፡፡ በትንሣኤ ቀን እምላለሁ፡፡"
  },
  {
    "surah_id": 75,
    "ayah_number": 2,
    "global_ayah_id": 5553,
    "translation": "(ራሷን) ወቃሽ በኾነች ነፍስም እምላለሁ፡፡ (በእርግጥ ትቀሰቀሳላችሁ)፡፡"
  },
  {
    "surah_id": 75,
    "ayah_number": 3,
    "global_ayah_id": 5554,
    "translation": "ሰው አጥንቶቹን አለመሰብሰባችንን ያስባልን?"
  },
  {
    "surah_id": 75,
    "ayah_number": 4,
    "global_ayah_id": 5555,
    "translation": "አይደለም ጣቶቹን (ፊት እንደ ነበሩ) በማስተካከል ላይ ቻዮች ስንኾን (እንሰበስባቸዋለን)፡፡"
  },
  {
    "surah_id": 75,
    "ayah_number": 5,
    "global_ayah_id": 5556,
    "translation": "ይልቁንም ሰው በፊቱ ባለው ነገር (በትንሣኤ) ሊያስተባብል ይፈልጋል፡፡"
  },
  {
    "surah_id": 75,
    "ayah_number": 6,
    "global_ayah_id": 5557,
    "translation": "«የትንሣኤው ቀን መቼ ነው?» ሲል ይጠይቃል፡፡"
  },
  {
    "surah_id": 75,
    "ayah_number": 7,
    "global_ayah_id": 5558,
    "translation": "ዓይንም በዋለለ ጊዜ፡፡"
  },
  {
    "surah_id": 75,
    "ayah_number": 8,
    "global_ayah_id": 5559,
    "translation": "ጨረቃም በጨለመ ጊዜ፡፡"
  },
  {
    "surah_id": 75,
    "ayah_number": 9,
    "global_ayah_id": 5560,
    "translation": "ፀሐይና ጨረቃም በተሰበሰቡ ጊዜ፡፡"
  },
  {
    "surah_id": 75,
    "ayah_number": 10,
    "global_ayah_id": 5561,
    "translation": "«ሰው በዚያ ቀን መሸሻው የት ነው?» ይላል፡፡"
  },
  {
    "surah_id": 75,
    "ayah_number": 11,
    "global_ayah_id": 5562,
    "translation": "ይከልከል፤ ምንም መጠጊያ የለም፡፡"
  },
  {
    "surah_id": 75,
    "ayah_number": 12,
    "global_ayah_id": 5563,
    "translation": "በዚያ ቀን መርጊያው ወደ ጌታህ ብቻ ነው፡፡"
  },
  {
    "surah_id": 75,
    "ayah_number": 13,
    "global_ayah_id": 5564,
    "translation": "ሰው በዚያ ቀን ባስቀደመውና ባስቆየው ሁሉ ይነገራል፡፡"
  },
  {
    "surah_id": 75,
    "ayah_number": 14,
    "global_ayah_id": 5565,
    "translation": "በእርግጥም ሰው በነፍሱ ላይ አስረጅ ነው፡፡ (አካሎቹ ይመሰክሩበታል)፡፡"
  },
  {
    "surah_id": 75,
    "ayah_number": 15,
    "global_ayah_id": 5566,
    "translation": "ምክንያቶቹን ሁሉ ቢያመጣም እንኳ (አይሰማም)፡፡"
  },
  {
    "surah_id": 75,
    "ayah_number": 16,
    "global_ayah_id": 5567,
    "translation": "በእርሱ (በቁርኣን ንባብ) ልትቸኩል ምላስህን በእርሱ አታላውስ፡፡"
  },
  {
    "surah_id": 75,
    "ayah_number": 17,
    "global_ayah_id": 5568,
    "translation": "(በልብህ ውስጥ) መሰብሰቡና ማንበቡ በእኛ ላይ ነውና፡፡"
  },
  {
    "surah_id": 75,
    "ayah_number": 18,
    "global_ayah_id": 5569,
    "translation": "ባነበብነውም ጊዜ (ካለቀ በኋላ) ንባቡን ተከተል፡፡"
  },
  {
    "surah_id": 75,
    "ayah_number": 19,
    "global_ayah_id": 5570,
    "translation": "ከዚያም ማብራራቱ በእኛ ላይ ነው፡፡"
  },
  {
    "surah_id": 75,
    "ayah_number": 20,
    "global_ayah_id": 5571,
    "translation": "(ከመጣደፍ) ተከልከል፡፡ ይልቁንም (ሰዎች) ፈጣኒቱን (ዓለም) ትወዳላችሁ፡፡"
  },
  {
    "surah_id": 75,
    "ayah_number": 21,
    "global_ayah_id": 5572,
    "translation": "መጨረሻይቱንም (ዓለም) ትተዋላችሁ፡፡ (አትዘጋጁላትም)፡፡"
  },
  {
    "surah_id": 75,
    "ayah_number": 22,
    "global_ayah_id": 5573,
    "translation": "ፊቶች በዚያ ቀን አብሪዎች ናቸው፡፡"
  },
  {
    "surah_id": 75,
    "ayah_number": 23,
    "global_ayah_id": 5574,
    "translation": "ወደ ጌታቸው ተመልካቾች ናቸው፡፡"
  },
  {
    "surah_id": 75,
    "ayah_number": 24,
    "global_ayah_id": 5575,
    "translation": "ፊቶችም በዚያ ቀን ጨፍጋጊዎች ናቸው፡፡"
  },
  {
    "surah_id": 75,
    "ayah_number": 25,
    "global_ayah_id": 5576,
    "translation": "በርሳቸውም ዐደጋ እንደሚሠራባቸው ያረጋግጣሉ፡፡"
  },
  {
    "surah_id": 75,
    "ayah_number": 26,
    "global_ayah_id": 5577,
    "translation": "ንቁ (ነፍስ) ብሪዎችን በደረሰች ጊዜ፤"
  },
  {
    "surah_id": 75,
    "ayah_number": 27,
    "global_ayah_id": 5578,
    "translation": "«አሻሪው ማነው?» በተባለም ጊዜ፡፡"
  },
  {
    "surah_id": 75,
    "ayah_number": 28,
    "global_ayah_id": 5579,
    "translation": "(ሕመምተኛው) እርሱ (የሰፈረበት ነገር ከዚህ ዓለም) መልለየት መኾኑን ባረጋገጠም ጊዜ፡፡"
  },
  {
    "surah_id": 75,
    "ayah_number": 29,
    "global_ayah_id": 5580,
    "translation": "ባትም በባት በተጣበቀች ጊዜ፡፡"
  },
  {
    "surah_id": 75,
    "ayah_number": 30,
    "global_ayah_id": 5581,
    "translation": "በዚያ ቀን መነዳቱ ወደ ጌታህ (ፍርድ) ነው፡፡"
  },
  {
    "surah_id": 75,
    "ayah_number": 31,
    "global_ayah_id": 5582,
    "translation": "አላመነምም አልሰገደምም፡፡"
  },
  {
    "surah_id": 75,
    "ayah_number": 32,
    "global_ayah_id": 5583,
    "translation": "ግን አስተባበለ፤ (ከእምነት) ዞረም፡፡"
  },
  {
    "surah_id": 75,
    "ayah_number": 33,
    "global_ayah_id": 5584,
    "translation": "ከዚያም እየተንጎባለለ ወደ ቤተሰቡ ኼደ፡፡"
  },
  {
    "surah_id": 75,
    "ayah_number": 34,
    "global_ayah_id": 5585,
    "translation": "የምትጠላውን ነገር (አላህ) ያስከትልህ፡፡ ለአንተ ተገቢህም ነው፡፡"
  },
  {
    "surah_id": 75,
    "ayah_number": 35,
    "global_ayah_id": 5586,
    "translation": "ከዚያም ጥፋት ይጠጋህ ለአንተ የተገባህም ነው፡፡"
  },
  {
    "surah_id": 75,
    "ayah_number": 36,
    "global_ayah_id": 5587,
    "translation": "ሰው ስድ ኾኖ መትተውን ይጠረጥራልን?"
  },
  {
    "surah_id": 75,
    "ayah_number": 37,
    "global_ayah_id": 5588,
    "translation": "የሚፈሰስ ከኾነ የፍትወት ጠብታ አልነበረምን?"
  },
  {
    "surah_id": 75,
    "ayah_number": 38,
    "global_ayah_id": 5589,
    "translation": "ከዚያም የረጋ ደም ኾነ (አላህ ሰው አድርጎ) ፈጠረውም፡፡ አስተካከለውም፡፡"
  },
  {
    "surah_id": 75,
    "ayah_number": 39,
    "global_ayah_id": 5590,
    "translation": "ከእርሱም ሁለት ዓይነቶችን ወንድና ሴትን አደረገ፡፡"
  },
  {
    "surah_id": 75,
    "ayah_number": 40,
    "global_ayah_id": 5591,
    "translation": "ይህ (ጌታ) ሙታንን ሕያው በማድረግ ላይ ቻይ አይደለምን?"
  }
]