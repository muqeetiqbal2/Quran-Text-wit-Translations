[
  {
    "surah_id": 75,
    "ayah_number": 0,
    "global_ayah_id": 5625,
    "translation": " «<a href=416> شروع </a>» کرتا ہوں اللہ تعا لٰی کے «<a href=614> نام\n</a>» سے جو بڑا «<a href=600> مہربان </a>» نہایت رحم والا ہے ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 1,
    "global_ayah_id": 5626,
    "translation": " میں «<a href=472> قسم </a>» کھاتا ہوں «<a href=476> قیامت </a>» کے «<a\n  href=326> دن </a>» کی ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 2,
    "global_ayah_id": 5627,
    "translation": " اور «<a href=472> قسم </a>» کھاتا ہوں اس نفس کی جو ملامت کرنے والا ہو\n۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 3,
    "global_ayah_id": 5628,
    "translation": " کیا «<a href=3> انسان </a>» یہ خیال کرتا ہے کہ ہم اس کی ہڈیاں جمع کریں\nگے ہی نہیں ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 4,
    "global_ayah_id": 5629,
    "translation": " ہاں ضرور کریں گے ہم تو قادر ہیں کہ اس کی پور پور تک «<a href=320> درست\n</a>» کر دیں ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 5,
    "global_ayah_id": 5630,
    "translation": " بلکہ «<a href=3> انسان </a>» تو چاہتا ہے کہ آگے آگے نافرمانیاں کرتا\nجائے ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 6,
    "global_ayah_id": 5631,
    "translation": " پوچھتا ہے کہ «<a href=476> قیامت </a>» کا «<a href=326> دن </a>» کب\nآئے گا ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 7,
    "global_ayah_id": 5632,
    "translation": " پس جس «<a href=639> وقت </a>» کہ «<a href=627> نگاہ </a>» پتھرا جائے\nگی ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 8,
    "global_ayah_id": 5633,
    "translation": " اور «<a href=254> چاند </a>» بے نور ہو جائے گا ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 9,
    "global_ayah_id": 5634,
    "translation": " اور سورج اور «<a href=254> چاند </a>» جمع کر دیئے جائیں گے ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 10,
    "global_ayah_id": 5635,
    "translation": " اس «<a href=326> دن </a>» «<a href=3> انسان </a>» کہے گا کہ آج بھاگنے\nکی «<a href=232> جگہ </a>» کہاں ہے؟ "
  },
  {
    "surah_id": 75,
    "ayah_number": 11,
    "global_ayah_id": 5636,
    "translation": " نہیں نہیں کوئی «<a href=156> پناہ </a>» گاہ نہیں ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 12,
    "global_ayah_id": 5637,
    "translation": " آج تو تیرے پروردگار کی طرف ہی «<a href=469> قرار </a>» گاہ ہے ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 13,
    "global_ayah_id": 5638,
    "translation": " آج «<a href=3> انسان </a>» کو اس کے آگے بھیجے ہوئے اور «<a href=179>\n  پیچھے </a>» چھوڑے ہوئے سے «<a href=13> آگاہ </a>» کیا جائے گا ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 14,
    "global_ayah_id": 5639,
    "translation": " بلکہ «<a href=3> انسان </a>» خود اپنے اوپر آپ حجت ہے ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 15,
    "global_ayah_id": 5640,
    "translation": " اگرچہ کتنے ہی بہانے «<a href=181> پیش </a>» کرے ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 16,
    "global_ayah_id": 5641,
    "translation": " ۔ ( اے نبی ) آپ «<a href=470> قرآن </a>» کو «<a href=234> جلدی </a>» (\n«<a href=657> یاد </a>» کرنے ) کے لئے اپنی زبان کو حرکت نہ دیں ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 17,
    "global_ayah_id": 5642,
    "translation": " اسکا جمع کرنا اور ( آپ کی زبان سے ) «<a href=152> پڑھنا </a>» ہمارے\nذمہ ہے ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 18,
    "global_ayah_id": 5643,
    "translation": " ہم جب اسے پڑھ لیں تو آپ اس کے پڑھنے کی پیروی کریں ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 19,
    "global_ayah_id": 5644,
    "translation": " پھر اس کا واضح کر «<a href=341> دینا </a>» ہمارا ذمہ ہے ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 20,
    "global_ayah_id": 5645,
    "translation": " نہیں نہیں تم «<a href=234> جلدی </a>» ملنے والی ( «<a href=327> دنیا\n</a>» ) کی «<a href=571> محبت </a>» رکھتے ہو ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 21,
    "global_ayah_id": 5646,
    "translation": " اور «<a href=2> آخرت </a>» کو چھوڑ بیٹھے ہو ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 22,
    "global_ayah_id": 5647,
    "translation": " اس روز بہت سے چہرے ترو «<a href=187> تازہ </a>» اور بارونق ہوں گے ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 23,
    "global_ayah_id": 5648,
    "translation": " اپنے رب کی طرف دیکھتے ہونگے ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 24,
    "global_ayah_id": 5649,
    "translation": " اور کتنے چہرے اس «<a href=326> دن </a>» ( بد «<a href=373> رونق </a>»\nاور ) اداس ہونگے ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 25,
    "global_ayah_id": 5650,
    "translation": " سمجھتے ہونگے کہ ان کے ساتھ کمر توڑ دینے والا معاملہ کیا جائے گا ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 26,
    "global_ayah_id": 5651,
    "translation": " نہیں نہیں جب روح ہنسلی تک پہنچے گی ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 27,
    "global_ayah_id": 5652,
    "translation": " اور کہا جائے گا کہ کوئی جھاڑ «<a href=171> پھونک </a>» کرنے والا ہے؟ "
  },
  {
    "surah_id": 75,
    "ayah_number": 28,
    "global_ayah_id": 5653,
    "translation": " اور جان لیا اس نے کہ یہ «<a href=639> وقت </a>» جدائی ہے ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 29,
    "global_ayah_id": 5654,
    "translation": " اور پنڈلی سے پنڈلی لپٹ جائے گی ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 30,
    "global_ayah_id": 5655,
    "translation": " آج تیرے پروردگار کی طرف «<a href=261> چلنا </a>» ہے ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 31,
    "global_ayah_id": 5656,
    "translation": " اس نے نہ تو تصدیق کی نہ نماز ادا کی ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 32,
    "global_ayah_id": 5657,
    "translation": " بلکہ جھٹلایا اور روگردانی کی ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 33,
    "global_ayah_id": 5658,
    "translation": " پھر اپنے «<a href=539> گھر </a>» والوں کے «<a href=141> پاس </a>»\nاتراتا «<a href=654> ہوا </a>» گیا ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 34,
    "global_ayah_id": 5659,
    "translation": " «<a href=43> افسوس </a>» ہے تجھ پر حسرت ہے تجھ پر ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 35,
    "global_ayah_id": 5660,
    "translation": " وائے ہے اور «<a href=296> خرابی </a>» ہے تیرے لئے ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 36,
    "global_ayah_id": 5661,
    "translation": " کیا «<a href=3> انسان </a>» یہ سمجھتا ہے کے اسے بیکار چھوڑ دیا جائے گا\n۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 37,
    "global_ayah_id": 5662,
    "translation": " کیا وہ ایک گاڑھے «<a href=144> پانی </a>» کا قطرہ نہ تھا جو ٹپکایا گیا\nتھا؟ "
  },
  {
    "surah_id": 75,
    "ayah_number": 38,
    "global_ayah_id": 5663,
    "translation": " پھر لہو کا لوتھڑا ہوگیا پھر اللہ نے اسے «<a href=180> پیدا </a>» کیا\nاور «<a href=320> درست </a>» بنا دیا ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 39,
    "global_ayah_id": 5664,
    "translation": " پھر اس سے جوڑے یعنی نر مادہ بنائے ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 40,
    "global_ayah_id": 5665,
    "translation": " کیا ( اللہ تعالیٰ ) اس ( امر ) پر قادر نہیں کہ مردے کو «<a href=381>\n  زندہ </a>» کر دے ۔ "
  }
]