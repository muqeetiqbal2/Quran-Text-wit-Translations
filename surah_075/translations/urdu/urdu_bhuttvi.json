  {
    "surah_id": 75,
    "ayah_number": 21,
    "global_ayah_id": 5646,
    "translation": " اور تم «<a href=2> آخرت </a>» کو چھوڑ دیتے ہو ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 22,
    "global_ayah_id": 5647,
    "translation": " بعض چہرے اُس «<a href=326> دن </a>» تروتازہ ہوں گے ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 23,
    "global_ayah_id": 5648,
    "translation": " اپنے رب کی طرف دیکھنے والے ہوں گے ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 24,
    "global_ayah_id": 5649,
    "translation": " اور کچھ چہرے اُس «<a href=326> دن </a>» بگڑے ہوئے ہوں گے ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 25,
    "global_ayah_id": 5650,
    "translation": " گمان کر رہے ہوں گے کہ اُن کے ساتھ کمر توڑ معاملہ کیا جائے گا ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 26,
    "global_ayah_id": 5651,
    "translation": " ہرگز نہیں ! جب جان ہنسلیوں تک پہنچ جائے گی ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 27,
    "global_ayah_id": 5652,
    "translation": " اور کہا جائے گا : کون ہے دم کرنے والا ؟ "
  },
  {
    "surah_id": 75,
    "ayah_number": 28,
    "global_ayah_id": 5653,
    "translation": " اور وہ «<a href=658> یقین </a>» کرے گا کہ یقیناً اب جدائی کا «<a href=639> وقت\n</a>» ہے ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 29,
    "global_ayah_id": 5654,
    "translation": " اور پنڈلی سے پنڈلی «<a href=229> جڑ </a>» جائے گی ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 30,
    "global_ayah_id": 5655,
    "translation": " اُس «<a href=326> دن </a>» تیرے رب کی طرف روانگی ہے ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 31,
    "global_ayah_id": 5656,
    "translation": " سو نہ اُس نے «<a href=390> سچ </a>» مانا اور نہ نماز پڑھی ۔ "
