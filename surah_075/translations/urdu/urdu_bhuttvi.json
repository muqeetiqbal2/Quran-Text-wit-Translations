  {
    "surah_id": 75,
    "ayah_number": 4,
    "global_ayah_id": 5629,
    "translation": " کیوں نہیں ! ہم اس پر قادر ہیں کہ اُس کی پور پور تک کو «<a href=320> درست </a>» کر\nدیں ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 5,
    "global_ayah_id": 5630,
    "translation": " بلکہ «<a href=3> انسان </a>» یہ «<a href=36> ارادہ </a>» رکھتا ہے کہ وہ آئندہ بھی\n«<a href=612> نافرمانی </a>» کرتا رہے ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 6,
    "global_ayah_id": 5631,
    "translation": " وہ پوچھتا ہے کب ہو گا «<a href=476> قیامت </a>» کا «<a href=326> دن </a>» ؟ "
  },
  {
    "surah_id": 75,
    "ayah_number": 7,
