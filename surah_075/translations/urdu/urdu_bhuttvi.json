  {
    "surah_id": 75,
    "ayah_number": 17,
    "global_ayah_id": 5642,
    "translation": " یقیناً اس کا جمع کرنا اور اس کا پڑھانا ہمارے ذمے ہے ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 18,
    "global_ayah_id": 5643,
    "translation": " تو جب ہم اس کو پڑھ چکیں تو آپ اُس کے پڑھنے کی پیروی کرو ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 19,
    "global_ayah_id": 5644,
    "translation": " پھر یقیناً ہم ہی پر ہے اس کا «<a href=126> بیان </a>» کرنا بھی ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 20,
    "global_ayah_id": 5645,
    "translation": " ہرگز نہیں ! بلکہ تم جلد حاصل ہونے والی ( «<a href=327> دنیا </a>» ) سے «<a\n  href=571> محبت </a>» رکھتے ہو ۔ "
