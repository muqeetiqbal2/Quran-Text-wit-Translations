  {
    "surah_id": 75,
    "ayah_number": 33,
    "global_ayah_id": 5658,
    "translation": " پھر اکڑتا «<a href=654> ہوا </a>» اپنے «<a href=539> گھر </a>» والوں کی طرف چلا\nگیا ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 34,
    "global_ayah_id": 5659,
    "translation": " تیرے لیے یہی «<a href=547> لائق </a>» ہے ، پھر یہی «<a href=547> لائق </a>» ہے ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 35,
    "global_ayah_id": 5660,
    "translation": " پھر تیرے لیے یہی «<a href=547> لائق </a>» ہے ، پھر یہی «<a href=547> لائق </a>» ہے\n۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 36,
    "global_ayah_id": 5661,
    "translation": " کیا «<a href=3> انسان </a>» یہ «<a href=530> گمان </a>» کرتا ہے کہ اُسے یونہی بغیر\nپوچھے چھوڑ دیا جائے گا ؟ "
