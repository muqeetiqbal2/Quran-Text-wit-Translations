  {
    "surah_id": 75,
    "ayah_number": 9,
    "global_ayah_id": 5634,
    "translation": " اور سورج اور «<a href=254> چاند </a>» کو جمع کر دیا جائے گا ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 10,
    "global_ayah_id": 5635,
    "translation": " اُس «<a href=326> دن </a>» «<a href=3> انسان </a>» کہے گا : بھاگنے کی «<a\n  href=232> جگہ </a>» کہاں ہے ؟ "
  },
  {
    "surah_id": 75,
    "ayah_number": 11,
    "global_ayah_id": 5636,
    "translation": " ہرگز نہیں ، کوئی «<a href=156> پناہ </a>» کی «<a href=232> جگہ </a>» نہیں ہے ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 12,
    "global_ayah_id": 5637,
    "translation": " اُس «<a href=326> دن </a>» تیرے رب کے «<a href=141> پاس </a>» ہی ٹھہرنے کی «<a\n  href=232> جگہ </a>» ہے ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 13,
    "global_ayah_id": 5638,
    "translation": " اُس «<a href=326> دن </a>» «<a href=3> انسان </a>» کو بتایا جائے گا جو کچھ اُس نے\nآگے بھیجا اور جو اُس نے «<a href=179> پیچھے </a>» چھوڑا ہے ۔ "
  },
  {
    "surah_id": 75,
    "ayah_number": 14,
    "global_ayah_id": 5639,
    "translation": " بلکہ «<a href=3> انسان </a>» اپنے آپ کو خوب دیکھنے والا ہے ۔ "
