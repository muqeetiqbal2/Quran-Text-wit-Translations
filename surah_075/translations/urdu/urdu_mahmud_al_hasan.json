[
  {
    "surah_id": 75,
    "ayah_number": 0,
    "global_ayah_id": 5625,
    "translation": "اللہ کے نام سے جو رحمان و رحیم ہے"
  },
  {
    "surah_id": 75,
    "ayah_number": 1,
    "global_ayah_id": 5626,
    "translation": "قسم کھاتا ہوں قیامت کے دن کی"
  },
  {
    "surah_id": 75,
    "ayah_number": 2,
    "global_ayah_id": 5627,
    "translation": "اور قسم کھاتا ہوں جی کی کہ جو ملامت کرے برائی پر"
  },
  {
    "surah_id": 75,
    "ayah_number": 3,
    "global_ayah_id": 5628,
    "translation": "کیا خیال رکھتا ہے آدمی کہ جمع نہ کریں گے ہم اُسکی ہڈیاں"
  },
  {
    "surah_id": 75,
    "ayah_number": 4,
    "global_ayah_id": 5629,
    "translation": "کیوں نہیں ہم ٹھیک کر سکتے ہیں اُسکی پوریاں"
  },
  {
    "surah_id": 75,
    "ayah_number": 5,
    "global_ayah_id": 5630,
    "translation": "بلکہ چاہتا ہے آدمی کہ ڈھٹائی کرے اُسکے سامنے"
  },
  {
    "surah_id": 75,
    "ayah_number": 6,
    "global_ayah_id": 5631,
    "translation": "پوچھتا ہے کب ہو گا دن قیامت کا"
  },
  {
    "surah_id": 75,
    "ayah_number": 7,
    "global_ayah_id": 5632,
    "translation": "پھر جب چندھیانے لگے آنکھ"
  },
  {
    "surah_id": 75,
    "ayah_number": 8,
    "global_ayah_id": 5633,
    "translation": "اور گہہ جائے چاند"
  },
  {
    "surah_id": 75,
    "ayah_number": 9,
    "global_ayah_id": 5634,
    "translation": "اور اکٹھے ہوں سورج اور چاند"
  },
  {
    "surah_id": 75,
    "ayah_number": 10,
    "global_ayah_id": 5635,
    "translation": "کہے گا آدمی اُس دن کہاں چلا جاؤں بھاگ کر"
  },
  {
    "surah_id": 75,
    "ayah_number": 11,
    "global_ayah_id": 5636,
    "translation": "کوئی نہیں کہیں نہیں ہے بچاؤ"
  },
  {
    "surah_id": 75,
    "ayah_number": 12,
    "global_ayah_id": 5637,
    "translation": "تیرے رب تک ہے اُس دن جا ٹھہرنا"
  },
  {
    "surah_id": 75,
    "ayah_number": 13,
    "global_ayah_id": 5638,
    "translation": "جتلا دیں گے انسان کو اُس دن جو اُس نے آگے بھیجا اور پیچھے چھوڑا"
  },
  {
    "surah_id": 75,
    "ayah_number": 14,
    "global_ayah_id": 5639,
    "translation": "بلکہ آدمی اپنے واسطے آپ دلیل ہے"
  },
  {
    "surah_id": 75,
    "ayah_number": 15,
    "global_ayah_id": 5640,
    "translation": "اور پڑالا ڈالے اپنے بہانے"
  },
  {
    "surah_id": 75,
    "ayah_number": 16,
    "global_ayah_id": 5641,
    "translation": "نہ چلا تو اُسکے پڑھنے پر اپنی زبان تاکہ جلدی اُسکو سیکھ لے"
  },
  {
    "surah_id": 75,
    "ayah_number": 17,
    "global_ayah_id": 5642,
    "translation": "وہ تو ہمارا ذمہ ہے اُسکو جمع رکھنا تیرے سینہ میں اور پڑھنا تیری زبان سے"
  },
  {
    "surah_id": 75,
    "ayah_number": 18,
    "global_ayah_id": 5643,
    "translation": "پھر جب ہم پڑھنے لگیں فرشتہ کی زبانی تو ساتھ رہ اُسکے پڑھنے کے"
  },
  {
    "surah_id": 75,
    "ayah_number": 19,
    "global_ayah_id": 5644,
    "translation": "پھر مقرر ہمارا ذمہ ہے اُسکو کھول کر بتلانا"
  },
  {
    "surah_id": 75,
    "ayah_number": 20,
    "global_ayah_id": 5645,
    "translation": "کوئی نہیں پر تم چاہتے ہو جو جلد آئے"
  },
  {
    "surah_id": 75,
    "ayah_number": 21,
    "global_ayah_id": 5646,
    "translation": "اور چھوڑتے ہو جو دیر میں آئے"
  },
  {
    "surah_id": 75,
    "ayah_number": 22,
    "global_ayah_id": 5647,
    "translation": "کتنے منہ اس دن تازہ ہیں"
  },
  {
    "surah_id": 75,
    "ayah_number": 23,
    "global_ayah_id": 5648,
    "translation": "اپنے رب کی طرف دیکھنے والے"
  },
  {
    "surah_id": 75,
    "ayah_number": 24,
    "global_ayah_id": 5649,
    "translation": "اور کتنے منہ اُس دن اداس ہیں"
  },
  {
    "surah_id": 75,
    "ayah_number": 25,
    "global_ayah_id": 5650,
    "translation": "خیال کرتے ہیں کہ اُن پر وہ آئے جس سے ٹوٹے کمر"
  },
  {
    "surah_id": 75,
    "ayah_number": 26,
    "global_ayah_id": 5651,
    "translation": "ہرگز نہیں جس وقت جان پہنچے ہانس تک"
  },
  {
    "surah_id": 75,
    "ayah_number": 27,
    "global_ayah_id": 5652,
    "translation": "اور لوگ کہیں کون ہے جھاڑنے والا"
  },
  {
    "surah_id": 75,
    "ayah_number": 28,
    "global_ayah_id": 5653,
    "translation": "اور وہ سمجھا کہ اب آیا وقت جدائی کا"
  },
  {
    "surah_id": 75,
    "ayah_number": 29,
    "global_ayah_id": 5654,
    "translation": "اور لپٹ گئ پنڈلی پر پنڈلی"
  },
  {
    "surah_id": 75,
    "ayah_number": 30,
    "global_ayah_id": 5655,
    "translation": "تیرے رب کی طرف ہے اُس دن کھنچ کر چلا جانا"
  },
  {
    "surah_id": 75,
    "ayah_number": 31,
    "global_ayah_id": 5656,
    "translation": "پھر نہ یقین لایا اور نہ نماز پڑھی"
  },
  {
    "surah_id": 75,
    "ayah_number": 32,
    "global_ayah_id": 5657,
    "translation": "پھر جھٹلایا اور منہ موڑا"
  },
  {
    "surah_id": 75,
    "ayah_number": 33,
    "global_ayah_id": 5658,
    "translation": "پھر گیا اپنے گھر کو اکڑتا ہوا"
  },
  {
    "surah_id": 75,
    "ayah_number": 34,
    "global_ayah_id": 5659,
    "translation": "خرابی تیری خرابی پر خرابی تیری"
  },
  {
    "surah_id": 75,
    "ayah_number": 35,
    "global_ayah_id": 5660,
    "translation": "پھر خرابی تیری خرابی پر خرابی تیری"
  },
  {
    "surah_id": 75,
    "ayah_number": 36,
    "global_ayah_id": 5661,
    "translation": "کیا خیال رکھتا ہے آدمی کہ چھوٹا رہے گا بے قید"
  },
  {
    "surah_id": 75,
    "ayah_number": 37,
    "global_ayah_id": 5662,
    "translation": "بھلا نہ تھا وہ ایک بوند منی کی جو ٹپکی"
  },
  {
    "surah_id": 75,
    "ayah_number": 38,
    "global_ayah_id": 5663,
    "translation": "پھر تھا لہو جما ہوا پھر اُس نے بنایا اور ٹھیک کر اٹھایا"
  },
  {
    "surah_id": 75,
    "ayah_number": 39,
    "global_ayah_id": 5664,
    "translation": "پھر کیا اُس میں جوڑا نر اور مادہ"
  },
  {
    "surah_id": 75,
    "ayah_number": 40,
    "global_ayah_id": 5665,
    "translation": "کیا یہ خدا زندہ نہیں کر سکتا مردوں کو"
  }
]