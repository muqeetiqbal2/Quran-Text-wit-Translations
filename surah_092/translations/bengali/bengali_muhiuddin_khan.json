[
  {
    "surah_id": 92,
    "ayah_number": 1,
    "global_ayah_id": 6059,
    "translation": "শপথ রাত্রির, যখন সে আচ্ছন্ন করে,"
  },
  {
    "surah_id": 92,
    "ayah_number": 2,
    "global_ayah_id": 6060,
    "translation": "শপথ দিনের, যখন সে আলোকিত হয়"
  },
  {
    "surah_id": 92,
    "ayah_number": 3,
    "global_ayah_id": 6061,
    "translation": "এবং তাঁর, যিনি নর ও নারী সৃষ্টি করেছেন,"
  },
  {
    "surah_id": 92,
    "ayah_number": 4,
    "global_ayah_id": 6062,
    "translation": "নিশ্চয় তোমাদের কর্ম প্রচেষ্টা বিভিন্ন ধরনের।"
  },
  {
    "surah_id": 92,
    "ayah_number": 5,
    "global_ayah_id": 6063,
    "translation": "অতএব, যে দান করে এবং খোদাভীরু হয়,"
  },
  {
    "surah_id": 92,
    "ayah_number": 6,
    "global_ayah_id": 6064,
    "translation": "এবং উত্তম বিষয়কে সত্য মনে করে,"
  },
  {
    "surah_id": 92,
    "ayah_number": 7,
    "global_ayah_id": 6065,
    "translation": "আমি তাকে সুখের বিষয়ের জন্যে সহজ পথ দান করব।"
  },
  {
    "surah_id": 92,
    "ayah_number": 8,
    "global_ayah_id": 6066,
    "translation": "আর যে কৃপণতা করে ও বেপরওয়া হয়"
  },
  {
    "surah_id": 92,
    "ayah_number": 9,
    "global_ayah_id": 6067,
    "translation": "এবং উত্তম বিষয়কে মিথ্যা মনে করে,"
  },
  {
    "surah_id": 92,
    "ayah_number": 10,
    "global_ayah_id": 6068,
    "translation": "আমি তাকে কষ্টের বিষয়ের জন্যে সহজ পথ দান করব।"
  },
  {
    "surah_id": 92,
    "ayah_number": 11,
    "global_ayah_id": 6069,
    "translation": "যখন সে অধঃপতিত হবে, তখন তার সম্পদ তার কোনই কাজে আসবে না।"
  },
  {
    "surah_id": 92,
    "ayah_number": 12,
    "global_ayah_id": 6070,
    "translation": "আমার দায়িত্ব পথ প্রদর্শন করা।"
  },
  {
    "surah_id": 92,
    "ayah_number": 13,
    "global_ayah_id": 6071,
    "translation": "আর আমি মালিক ইহকালের ও পরকালের।"
  },
  {
    "surah_id": 92,
    "ayah_number": 14,
    "global_ayah_id": 6072,
    "translation": "অতএব, আমি তোমাদেরকে প্রজ্বলিত অগ্নি সম্পর্কে সতর্ক করে দিয়েছি।"
  },
  {
    "surah_id": 92,
    "ayah_number": 15,
    "global_ayah_id": 6073,
    "translation": "এতে নিতান্ত হতভাগ্য ব্যক্তিই প্রবেশ করবে,"
  },
  {
    "surah_id": 92,
    "ayah_number": 16,
    "global_ayah_id": 6074,
    "translation": "যে মিথ্যারোপ করে ও মুখ ফিরিয়ে নেয়।"
  },
  {
    "surah_id": 92,
    "ayah_number": 17,
    "global_ayah_id": 6075,
    "translation": "এ থেকে দূরে রাখা হবে খোদাভীরু ব্যক্তিকে,"
  },
  {
    "surah_id": 92,
    "ayah_number": 18,
    "global_ayah_id": 6076,
    "translation": "যে আত্নশুদ্ধির জন্যে তার ধন-সম্পদ দান করে।"
  },
  {
    "surah_id": 92,
    "ayah_number": 19,
    "global_ayah_id": 6077,
    "translation": "এবং তার উপর কারও কোন প্রতিদানযোগ্য অনুগ্রহ থাকে না।"
  },
  {
    "surah_id": 92,
    "ayah_number": 20,
    "global_ayah_id": 6078,
    "translation": "তার মহান পালনকর্তার সন্তুষ্টি অন্বেষণ ব্যতীত।"
  },
  {
    "surah_id": 92,
    "ayah_number": 21,
    "global_ayah_id": 6079,
    "translation": "সে সত্বরই সন্তুষ্টি লাভ করবে।"
  }
]