[
  {
    "surah_id": 92,
    "ayah_number": 1,
    "global_ayah_id": 6059,
    "translation": "By the night when it envelops,"
  },
  {
    "surah_id": 92,
    "ayah_number": 2,
    "global_ayah_id": 6060,
    "translation": "by the day when it brightens,"
  },
  {
    "surah_id": 92,
    "ayah_number": 3,
    "global_ayah_id": 6061,
    "translation": "by Him who created the male and the female:"
  },
  {
    "surah_id": 92,
    "ayah_number": 4,
    "global_ayah_id": 6062,
    "translation": "your endeavours are indeed diverse."
  },
  {
    "surah_id": 92,
    "ayah_number": 5,
    "global_ayah_id": 6063,
    "translation": "As for him who gives and is Godwary"
  },
  {
    "surah_id": 92,
    "ayah_number": 6,
    "global_ayah_id": 6064,
    "translation": "and confirms the best promise,"
  },
  {
    "surah_id": 92,
    "ayah_number": 7,
    "global_ayah_id": 6065,
    "translation": "We will surely ease him toward facility."
  },
  {
    "surah_id": 92,
    "ayah_number": 8,
    "global_ayah_id": 6066,
    "translation": "But as for him, who is stingy and self-complacent,"
  },
  {
    "surah_id": 92,
    "ayah_number": 9,
    "global_ayah_id": 6067,
    "translation": "and denies the best promise,"
  },
  {
    "surah_id": 92,
    "ayah_number": 10,
    "global_ayah_id": 6068,
    "translation": "We will surely ease him toward hardship."
  },
  {
    "surah_id": 92,
    "ayah_number": 11,
    "global_ayah_id": 6069,
    "translation": "His wealth will not avail him when he perishes."
  },
  {
    "surah_id": 92,
    "ayah_number": 12,
    "global_ayah_id": 6070,
    "translation": "Indeed guidance rests with Us,"
  },
  {
    "surah_id": 92,
    "ayah_number": 13,
    "global_ayah_id": 6071,
    "translation": "and to Us belong the world and the Hereafter."
  },
  {
    "surah_id": 92,
    "ayah_number": 14,
    "global_ayah_id": 6072,
    "translation": "So I warn you of a blazing fire,"
  },
  {
    "surah_id": 92,
    "ayah_number": 15,
    "global_ayah_id": 6073,
    "translation": "which none shall enter except the most wretched [of persons]"
  },
  {
    "surah_id": 92,
    "ayah_number": 16,
    "global_ayah_id": 6074,
    "translation": "—he who impugns [God’s prophets] and turns his back."
  },
  {
    "surah_id": 92,
    "ayah_number": 17,
    "global_ayah_id": 6075,
    "translation": "The Godwary [person] will be spared of that"
  },
  {
    "surah_id": 92,
    "ayah_number": 18,
    "global_ayah_id": 6076,
    "translation": "—he who gives his wealth to purify himself"
  },
  {
    "surah_id": 92,
    "ayah_number": 19,
    "global_ayah_id": 6077,
    "translation": "and does not expect any reward from anyone,"
  },
  {
    "surah_id": 92,
    "ayah_number": 20,
    "global_ayah_id": 6078,
    "translation": "but seek only the pleasure of their Lord, the Most Exalted,"
  },
  {
    "surah_id": 92,
    "ayah_number": 21,
    "global_ayah_id": 6079,
    "translation": "and, surely, soon they will be well-pleased."
  }
]