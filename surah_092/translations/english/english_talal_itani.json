[
  {
    "surah_id": 92,
    "ayah_number": 1,
    "global_ayah_id": 6059,
    "translation": "By the night as it covers."
  },
  {
    "surah_id": 92,
    "ayah_number": 2,
    "global_ayah_id": 6060,
    "translation": "And the day as it reveals."
  },
  {
    "surah_id": 92,
    "ayah_number": 3,
    "global_ayah_id": 6061,
    "translation": "And He who created the male and the female."
  },
  {
    "surah_id": 92,
    "ayah_number": 4,
    "global_ayah_id": 6062,
    "translation": "Your endeavors are indeed diverse."
  },
  {
    "surah_id": 92,
    "ayah_number": 5,
    "global_ayah_id": 6063,
    "translation": "As for him who gives and is righteous."
  },
  {
    "surah_id": 92,
    "ayah_number": 6,
    "global_ayah_id": 6064,
    "translation": "And confirms goodness."
  },
  {
    "surah_id": 92,
    "ayah_number": 7,
    "global_ayah_id": 6065,
    "translation": "We will ease his way towards ease."
  },
  {
    "surah_id": 92,
    "ayah_number": 8,
    "global_ayah_id": 6066,
    "translation": "But as for him who is stingy and complacent."
  },
  {
    "surah_id": 92,
    "ayah_number": 9,
    "global_ayah_id": 6067,
    "translation": "And denies goodness."
  },
  {
    "surah_id": 92,
    "ayah_number": 10,
    "global_ayah_id": 6068,
    "translation": "We will ease his way towards difficulty."
  },
  {
    "surah_id": 92,
    "ayah_number": 11,
    "global_ayah_id": 6069,
    "translation": "And his money will not avail him when he plummets."
  },
  {
    "surah_id": 92,
    "ayah_number": 12,
    "global_ayah_id": 6070,
    "translation": "It is upon Us to guide."
  },
  {
    "surah_id": 92,
    "ayah_number": 13,
    "global_ayah_id": 6071,
    "translation": "And to Us belong the Last and the First."
  },
  {
    "surah_id": 92,
    "ayah_number": 14,
    "global_ayah_id": 6072,
    "translation": "I have warned you of a Fierce Blaze."
  },
  {
    "surah_id": 92,
    "ayah_number": 15,
    "global_ayah_id": 6073,
    "translation": "None will burn in it except the very wicked."
  },
  {
    "surah_id": 92,
    "ayah_number": 16,
    "global_ayah_id": 6074,
    "translation": "He who denies and turns away."
  },
  {
    "surah_id": 92,
    "ayah_number": 17,
    "global_ayah_id": 6075,
    "translation": "But the devout will avoid it."
  },
  {
    "surah_id": 92,
    "ayah_number": 18,
    "global_ayah_id": 6076,
    "translation": "He who gives his money to become pure."
  },
  {
    "surah_id": 92,
    "ayah_number": 19,
    "global_ayah_id": 6077,
    "translation": "Seeking no favor in return."
  },
  {
    "surah_id": 92,
    "ayah_number": 20,
    "global_ayah_id": 6078,
    "translation": "Only seeking the acceptance of his Lord, the Most High."
  },
  {
    "surah_id": 92,
    "ayah_number": 21,
    "global_ayah_id": 6079,
    "translation": "And he will be satisfied."
  }
]