[
  {
    "surah_id": 92,
    "ayah_number": 1,
    "global_ayah_id": 6059,
    "translation": "سوگند به شب چون پرده افكند،"
  },
  {
    "surah_id": 92,
    "ayah_number": 2,
    "global_ayah_id": 6060,
    "translation": "سوگند به روز چون جلوه‌گرى آغازد،"
  },
  {
    "surah_id": 92,
    "ayah_number": 3,
    "global_ayah_id": 6061,
    "translation": "و [سوگند به‌] آنكه نر و ماده را آفريد،"
  },
  {
    "surah_id": 92,
    "ayah_number": 4,
    "global_ayah_id": 6062,
    "translation": "كه همانا تلاش شما پراكنده است."
  },
  {
    "surah_id": 92,
    "ayah_number": 5,
    "global_ayah_id": 6063,
    "translation": "اما آنكه [حق خدا را] داد و پروا داشت،"
  },
  {
    "surah_id": 92,
    "ayah_number": 6,
    "global_ayah_id": 6064,
    "translation": "و [پاداش‌] نيكوتر را تصديق كرد،"
  },
  {
    "surah_id": 92,
    "ayah_number": 7,
    "global_ayah_id": 6065,
    "translation": "بزودى راه آسانى پيش پاى او خواهيم گذاشت."
  },
  {
    "surah_id": 92,
    "ayah_number": 8,
    "global_ayah_id": 6066,
    "translation": "و اما آنكه بخل ورزيد و خود را بى‌نياز ديد،"
  },
  {
    "surah_id": 92,
    "ayah_number": 9,
    "global_ayah_id": 6067,
    "translation": "و [پاداش‌] نيكوتر را به دروغ گرفت،"
  },
  {
    "surah_id": 92,
    "ayah_number": 10,
    "global_ayah_id": 6068,
    "translation": "بزودى راه دشوارى به او خواهيم نمود."
  },
  {
    "surah_id": 92,
    "ayah_number": 11,
    "global_ayah_id": 6069,
    "translation": "و چون هلاك شد، [ديگر] مال او به كارش نمى‌آيد."
  },
  {
    "surah_id": 92,
    "ayah_number": 12,
    "global_ayah_id": 6070,
    "translation": "همانا هدايت بر ماست."
  },
  {
    "surah_id": 92,
    "ayah_number": 13,
    "global_ayah_id": 6071,
    "translation": "و در حقيقت، دنيا و آخرت از آن ماست."
  },
  {
    "surah_id": 92,
    "ayah_number": 14,
    "global_ayah_id": 6072,
    "translation": "پس شما را به آتشى كه زبانه مى‌كشد هشدار دادم."
  },
  {
    "surah_id": 92,
    "ayah_number": 15,
    "global_ayah_id": 6073,
    "translation": "جز نگون‌بخت‌تر[ين مردم‌] در آن درنيايد:"
  },
  {
    "surah_id": 92,
    "ayah_number": 16,
    "global_ayah_id": 6074,
    "translation": "همان كه تكذيب كرد و رخ برتافت."
  },
  {
    "surah_id": 92,
    "ayah_number": 17,
    "global_ayah_id": 6075,
    "translation": "و پاك‌رفتارتر[ين مردم‌] از آن دور داشته خواهد شد:"
  },
  {
    "surah_id": 92,
    "ayah_number": 18,
    "global_ayah_id": 6076,
    "translation": "همان كه مال خود را مى‌دهد [براى آنكه‌] پاك شود،"
  },
  {
    "surah_id": 92,
    "ayah_number": 19,
    "global_ayah_id": 6077,
    "translation": "و هيچ كس را به قصد پاداش‌يافتن نعمت نمى‌بخشد،"
  },
  {
    "surah_id": 92,
    "ayah_number": 20,
    "global_ayah_id": 6078,
    "translation": "جز خواستن رضاى پروردگارش كه بسى برتر است [منظورى ندارد]."
  },
  {
    "surah_id": 92,
    "ayah_number": 21,
    "global_ayah_id": 6079,
    "translation": "و قطعاً بزودى خشنود خواهد شد."
  }
]