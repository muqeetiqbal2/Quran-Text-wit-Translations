[
  {
    "surah_id": 92,
    "ayah_number": 1,
    "global_ayah_id": 6059,
    "translation": "രാവിനെതന്നെയാണ സത്യം ; അത് മൂടികൊണ്ടിരിക്കുമ്പോള്‍"
  },
  {
    "surah_id": 92,
    "ayah_number": 2,
    "global_ayah_id": 6060,
    "translation": "പകലിനെ തന്നെയാണ സത്യം ; അത് പ്രത്യക്ഷപ്പെടുമ്പോള്‍"
  },
  {
    "surah_id": 92,
    "ayah_number": 3,
    "global_ayah_id": 6061,
    "translation": "ആണിനെയും പെണ്ണിനെയും സൃഷ്ടിച്ച രീതിയെ തന്നെയാണ സത്യം;"
  },
  {
    "surah_id": 92,
    "ayah_number": 4,
    "global_ayah_id": 6062,
    "translation": "തീര്‍ച്ചയായും നിങ്ങളുടെ പരിശ്രമം വിഭിന്ന രൂപത്തിലുള്ളതാകുന്നു."
  },
  {
    "surah_id": 92,
    "ayah_number": 5,
    "global_ayah_id": 6063,
    "translation": "എന്നാല്‍ ഏതൊരാള്‍ ദാനം നല്‍കുകയും, സൂക്ഷ്മത പാലിക്കുകയും"
  },
  {
    "surah_id": 92,
    "ayah_number": 6,
    "global_ayah_id": 6064,
    "translation": "ഏറ്റവും ഉത്തമമായതിനെ സത്യപ്പെടുത്തുകയും ചെയ്തുവോ"
  },
  {
    "surah_id": 92,
    "ayah_number": 7,
    "global_ayah_id": 6065,
    "translation": "അവന്നു നാം ഏറ്റവും എളുപ്പമായതിലേക്ക് സൌകര്യപ്പെടുത്തി കൊടുക്കുന്നതാണ്‌."
  },
  {
    "surah_id": 92,
    "ayah_number": 8,
    "global_ayah_id": 6066,
    "translation": "എന്നാല്‍ ആര്‍ പിശുക്കു കാണിക്കുകയും, സ്വയം പര്യാപ്തത നടിക്കുകയും,"
  },
  {
    "surah_id": 92,
    "ayah_number": 9,
    "global_ayah_id": 6067,
    "translation": "ഏറ്റവും ഉത്തമമായതിനെ നിഷേധിച്ചു തള്ളുകയും ചെയ്തുവോ"
  },
  {
    "surah_id": 92,
    "ayah_number": 10,
    "global_ayah_id": 6068,
    "translation": "അവന്നു നാം ഏറ്റവും ഞെരുക്കമുള്ളതിലേക്ക് സൌകര്യമൊരുക്കികൊടുക്കുന്നതാണ്‌."
  },
  {
    "surah_id": 92,
    "ayah_number": 11,
    "global_ayah_id": 6069,
    "translation": "അവന്‍ നാശത്തില്‍ പതിക്കുമ്പോള്‍ അവന്‍റെ ധനം അവന്ന് പ്രയോജനപ്പെടുന്നതല്ല."
  },
  {
    "surah_id": 92,
    "ayah_number": 12,
    "global_ayah_id": 6070,
    "translation": "തീര്‍ച്ചയായും മാര്‍ഗദര്‍ശനം നമ്മുടെ ബാധ്യതയാകുന്നു."
  },
  {
    "surah_id": 92,
    "ayah_number": 13,
    "global_ayah_id": 6071,
    "translation": "തീര്‍ച്ചയായും നമുക്കുള്ളതാകുന്നു പരലോകവും ഇഹലോകവും."
  },
  {
    "surah_id": 92,
    "ayah_number": 14,
    "global_ayah_id": 6072,
    "translation": "അതിനാല്‍ ആളിക്കത്തിക്കൊണ്ടിരിക്കുന്ന അഗ്നിയെപ്പറ്റി ഞാന്‍ നിങ്ങള്‍ക്ക് താക്കീത് നല്‍കിയിരിക്കുന്നു."
  },
  {
    "surah_id": 92,
    "ayah_number": 15,
    "global_ayah_id": 6073,
    "translation": "ഏറ്റവും ദുഷ്ടനായ വ്യക്തിയല്ലാതെ അതില്‍ പ്രവേശിക്കുകയില്ല."
  },
  {
    "surah_id": 92,
    "ayah_number": 16,
    "global_ayah_id": 6074,
    "translation": "നിഷേധിച്ചു തള്ളുകയും, പിന്തിരിഞ്ഞു കളയുകയും (വ്യക്തി)"
  },
  {
    "surah_id": 92,
    "ayah_number": 17,
    "global_ayah_id": 6075,
    "translation": "ഏറ്റവും സൂക്ഷ്മതയുള്ള വ്യക്തി അതില്‍ നിന്ന് അകറ്റി നിര്‍ത്തപ്പെടുന്നതാണ്‌."
  },
  {
    "surah_id": 92,
    "ayah_number": 18,
    "global_ayah_id": 6076,
    "translation": "പരിശുദ്ധിനേടുവാനായി തന്‍റെ ധനം നല്‍കുന്ന (വ്യക്തി)"
  },
  {
    "surah_id": 92,
    "ayah_number": 19,
    "global_ayah_id": 6077,
    "translation": "പ്രത്യുപകാരം നല്‍കപ്പെടേണ്ടതായ യാതൊരു അനുഗ്രഹവും അവന്‍റെ പക്കല്‍ ഒരാള്‍ക്കുമില്ല."
  },
  {
    "surah_id": 92,
    "ayah_number": 20,
    "global_ayah_id": 6078,
    "translation": "തന്‍റെ അത്യുന്നതനായ രക്ഷിതാവിന്‍റെ പ്രീതി തേടുക എന്നതല്ലാതെ."
  },
  {
    "surah_id": 92,
    "ayah_number": 21,
    "global_ayah_id": 6079,
    "translation": "വഴിയെ അവന്‍ തൃപ്തിപ്പെടുന്നതാണ്‌."
  }
]