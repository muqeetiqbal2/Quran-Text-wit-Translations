[
  {
    "surah_id": 92,
    "ayah_number": 1,
    "global_ayah_id": 6059,
    "translation": "Tako mi noći kada tmine razastre,"
  },
  {
    "surah_id": 92,
    "ayah_number": 2,
    "global_ayah_id": 6060,
    "translation": "i dana kad svane,"
  },
  {
    "surah_id": 92,
    "ayah_number": 3,
    "global_ayah_id": 6061,
    "translation": "i Onoga koji muško i žensko stvara –"
  },
  {
    "surah_id": 92,
    "ayah_number": 4,
    "global_ayah_id": 6062,
    "translation": "vaš trud je, zaista, različit:"
  },
  {
    "surah_id": 92,
    "ayah_number": 5,
    "global_ayah_id": 6063,
    "translation": "onome koji udjeljuje i ne griješi"
  },
  {
    "surah_id": 92,
    "ayah_number": 6,
    "global_ayah_id": 6064,
    "translation": "i ono najljepše smatra istinitim –"
  },
  {
    "surah_id": 92,
    "ayah_number": 7,
    "global_ayah_id": 6065,
    "translation": "njemu ćemo Džennet pripremiti;"
  },
  {
    "surah_id": 92,
    "ayah_number": 8,
    "global_ayah_id": 6066,
    "translation": "a onome koji tvrdiči i osjeća se neovisnim"
  },
  {
    "surah_id": 92,
    "ayah_number": 9,
    "global_ayah_id": 6067,
    "translation": "i ono najljepše smatra lažnim –"
  },
  {
    "surah_id": 92,
    "ayah_number": 10,
    "global_ayah_id": 6068,
    "translation": "njemu ćemo Džehennem pripremiti,"
  },
  {
    "surah_id": 92,
    "ayah_number": 11,
    "global_ayah_id": 6069,
    "translation": "i bogatstvo njegovo mu, kad se strovali, neće koristiti."
  },
  {
    "surah_id": 92,
    "ayah_number": 12,
    "global_ayah_id": 6070,
    "translation": "Mi smo dužni ukazati na Pravi put,"
  },
  {
    "surah_id": 92,
    "ayah_number": 13,
    "global_ayah_id": 6071,
    "translation": "i jedino Nama pripada i onaj i ovaj svijet!"
  },
  {
    "surah_id": 92,
    "ayah_number": 14,
    "global_ayah_id": 6072,
    "translation": "Zato vas opominjem razbuktalom vatrom,"
  },
  {
    "surah_id": 92,
    "ayah_number": 15,
    "global_ayah_id": 6073,
    "translation": "u koju će ući samo nesretnik,"
  },
  {
    "surah_id": 92,
    "ayah_number": 16,
    "global_ayah_id": 6074,
    "translation": "onaj koji bude poricao i glavu okretao,"
  },
  {
    "surah_id": 92,
    "ayah_number": 17,
    "global_ayah_id": 6075,
    "translation": "a od nje će daleko biti onaj koji se bude Allaha bojao,"
  },
  {
    "surah_id": 92,
    "ayah_number": 18,
    "global_ayah_id": 6076,
    "translation": "onaj koji bude dio imetka svoga udjeljivao, da bi se očistio,"
  },
  {
    "surah_id": 92,
    "ayah_number": 19,
    "global_ayah_id": 6077,
    "translation": "ne očekujući da mu se zahvalnošću uzvrati,"
  },
  {
    "surah_id": 92,
    "ayah_number": 20,
    "global_ayah_id": 6078,
    "translation": "već jedino da bi naklonost Gospodara svoga Svevišnjeg stekao,"
  },
  {
    "surah_id": 92,
    "ayah_number": 21,
    "global_ayah_id": 6079,
    "translation": "i on će, zbilja, zadovoljan biti!"
  }
]