[
  {
    "surah_id": 92,
    "ayah_number": 1,
    "global_ayah_id": 6059,
    "translation": "Eebe wuxuu ku dhaartay Habeenku markuu wax qariyo."
  },
  {
    "surah_id": 92,
    "ayah_number": 2,
    "global_ayah_id": 6060,
    "translation": "Iyo markay Maalintu Muuqato (ifto)."
  },
  {
    "surah_id": 92,
    "ayah_number": 3,
    "global_ayah_id": 6061,
    "translation": "Iyo Abuuridda Dadka Lab iyo dhaddigba."
  },
  {
    "surah_id": 92,
    "ayah_number": 4,
    "global_ayah_id": 6062,
    "translation": "In Camalkiinnu (dadow) kala duwanyahay."
  },
  {
    "surah_id": 92,
    "ayah_number": 5,
    "global_ayah_id": 6063,
    "translation": "Ruuxiise bixiya (xuquuqda) Eebana ka dhawrsada."
  },
  {
    "surah_id": 92,
    "ayah_number": 6,
    "global_ayah_id": 6064,
    "translation": "Rumeeyana tii wanaaga badnayd (ciwal)."
  },
  {
    "surah_id": 92,
    "ayah_number": 7,
    "global_ayah_id": 6065,
    "translation": "Waxaanni u fududaynaa wanaagga (iyo Jidka fiican)."
  },
  {
    "surah_id": 92,
    "ayah_number": 8,
    "global_ayah_id": 6066,
    "translation": "Ruuxiise ku bakhayla Xoolaha isna deeqtoonaysiiya «iskibriya»."
  },
  {
    "surah_id": 92,
    "ayah_number": 9,
    "global_ayah_id": 6067,
    "translation": "Reeniyana Tii wanaaga badnayd (ciwal)."
  },
  {
    "surah_id": 92,
    "ayah_number": 10,
    "global_ayah_id": 6068,
    "translation": "Waxaan u fududaynaa Jidka xun."
  },
  {
    "surah_id": 92,
    "ayah_number": 11,
    "global_ayah_id": 6069,
    "translation": "Xoolihiisuna wax uma taraan markuu halaagsamo."
  },
  {
    "surah_id": 92,
    "ayah_number": 12,
    "global_ayah_id": 6070,
    "translation": "Annagaa wax hanuuninna."
  },
  {
    "surah_id": 92,
    "ayah_number": 13,
    "global_ayah_id": 6071,
    "translation": "Aakhariyo Addunbana Annagaa iska leh."
  },
  {
    "surah_id": 92,
    "ayah_number": 14,
    "global_ayah_id": 6072,
    "translation": "Waxana idiinka digaynaa Naar kulayl daran."
  },
  {
    "surah_id": 92,
    "ayah_number": 15,
    "global_ayah_id": 6073,
    "translation": "Oosan galaynin Ruux xun mooyeen."
  },
  {
    "surah_id": 92,
    "ayah_number": 16,
    "global_ayah_id": 6074,
    "translation": "Oo xaqa beeniyay jeedsadayna."
  },
  {
    "surah_id": 92,
    "ayah_number": 17,
    "global_ayah_id": 6075,
    "translation": "Waxaana ka fogaada (galidda naarta) Ruuxii Eeba ka dhawrsada."
  },
  {
    "surah_id": 92,
    "ayah_number": 18,
    "global_ayah_id": 6076,
    "translation": "Ee bixiya Xoolihiisa si uu u daahirnoqdo."
  },
  {
    "surah_id": 92,
    "ayah_number": 19,
    "global_ayah_id": 6077,
    "translation": "Ruux wax ugu nicmeeyayna oo abaalmarinna ma uusanjirin."
  },
  {
    "surah_id": 92,
    "ayah_number": 20,
    "global_ayah_id": 6078,
    "translation": "Ee Wuxuu u bixin dar Eebaha sareeya."
  },
  {
    "surah_id": 92,
    "ayah_number": 21,
    "global_ayah_id": 6079,
    "translation": "Wuuna raalli noqondoonaa Ruuxaasi."
  }
]