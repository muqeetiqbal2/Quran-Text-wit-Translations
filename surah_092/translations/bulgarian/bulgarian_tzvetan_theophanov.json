[
  {
    "surah_id": 92,
    "ayah_number": 1,
    "global_ayah_id": 6059,
    "translation": "Кълна се в нощта, когато се спуска"
  },
  {
    "surah_id": 92,
    "ayah_number": 2,
    "global_ayah_id": 6060,
    "translation": "и в деня, когато засиява,"
  },
  {
    "surah_id": 92,
    "ayah_number": 3,
    "global_ayah_id": 6061,
    "translation": "и в Онзи, Който е сътворил мъжа и жената, -"
  },
  {
    "surah_id": 92,
    "ayah_number": 4,
    "global_ayah_id": 6062,
    "translation": "вашите стремежи са различни!"
  },
  {
    "surah_id": 92,
    "ayah_number": 5,
    "global_ayah_id": 6063,
    "translation": "Който раздава и се бои,"
  },
  {
    "surah_id": 92,
    "ayah_number": 6,
    "global_ayah_id": 6064,
    "translation": "и вярва в Най-прекрасното,"
  },
  {
    "surah_id": 92,
    "ayah_number": 7,
    "global_ayah_id": 6065,
    "translation": "ще го улесним към лесното."
  },
  {
    "surah_id": 92,
    "ayah_number": 8,
    "global_ayah_id": 6066,
    "translation": "А който е скъперник и пренебрегва,"
  },
  {
    "surah_id": 92,
    "ayah_number": 9,
    "global_ayah_id": 6067,
    "translation": "и взима за лъжа Най-прекрасното,"
  },
  {
    "surah_id": 92,
    "ayah_number": 10,
    "global_ayah_id": 6068,
    "translation": "ще го улесним към трудното"
  },
  {
    "surah_id": 92,
    "ayah_number": 11,
    "global_ayah_id": 6069,
    "translation": "и не ще го избави неговото богатство, когато пропадне."
  },
  {
    "surah_id": 92,
    "ayah_number": 12,
    "global_ayah_id": 6070,
    "translation": "Наша грижа е напътването."
  },
  {
    "surah_id": 92,
    "ayah_number": 13,
    "global_ayah_id": 6071,
    "translation": "На Нас принадлежи и отвъдното, и настоящето."
  },
  {
    "surah_id": 92,
    "ayah_number": 14,
    "global_ayah_id": 6072,
    "translation": "И ви предупредих за Огъня пламтящ."
  },
  {
    "surah_id": 92,
    "ayah_number": 15,
    "global_ayah_id": 6073,
    "translation": "Ще гори в него само злият,"
  },
  {
    "surah_id": 92,
    "ayah_number": 16,
    "global_ayah_id": 6074,
    "translation": "който отрича и се отвръща."
  },
  {
    "surah_id": 92,
    "ayah_number": 17,
    "global_ayah_id": 6075,
    "translation": "И ще бъде предпазен от него богобоязливият,"
  },
  {
    "surah_id": 92,
    "ayah_number": 18,
    "global_ayah_id": 6076,
    "translation": "който раздава своето богатство, за да се пречисти,"
  },
  {
    "surah_id": 92,
    "ayah_number": 19,
    "global_ayah_id": 6077,
    "translation": "на никого не прави благодеяние, за да бъде възнаграден,"
  },
  {
    "surah_id": 92,
    "ayah_number": 20,
    "global_ayah_id": 6078,
    "translation": "а само в стремеж към Лика на своя Господ, Върховния."
  },
  {
    "surah_id": 92,
    "ayah_number": 21,
    "global_ayah_id": 6079,
    "translation": "И непременно ще е доволен."
  }
]