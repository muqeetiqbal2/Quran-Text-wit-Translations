    "ayah_number": 0,
    "global_ayah_id": 6149,
    "translation": "شروع اللہ کے «<a href=614> نام </a>» سے جو بڑا «<a href=600> مہربان </a>» اور نہایت رحم کرنے والا ہے"
  },
  {
    "surah_id": 92,
    "ayah_number": 1,
    "global_ayah_id": 6150,
    "translation": "رات کی «<a href=472> قسم </a>» جب وہ چھاجائے"
  },
  {
    "surah_id": 92,
    "ayah_number": 2,
    "global_ayah_id": 6151,
    "translation": "اور «<a href=326> دن </a>» کی جبکہ وہ روشن ہو"
  },
  {
    "surah_id": 92,
    "ayah_number": 3,
    "global_ayah_id": 6152,
    "translation": "اوراس ذات کی جس نے نراور مادہ پیداکئے"
  },
  {
    "surah_id": 92,
    "ayah_number": 4,
    "global_ayah_id": 6153,
    "translation": "بیشک تمہاری کو ششیں «<a href=575> مختلف </a>» ہوتی ہیں"
  },
  {
    "surah_id": 92,
    "ayah_number": 5,
    "global_ayah_id": 6154,
    "translation": "پس جس نے  ( اللہ کی راہ میں اپنامال )  دیا اور تقویٰ «<a href=34> اختیار </a>» کیا"
  },
  {
    "surah_id": 92,
    "ayah_number": 6,
    "global_ayah_id": 6155,
    "translation": "اور بھلی باتوں کی تصدیق کی"
  },
  {
    "surah_id": 92,
    "ayah_number": 7,
    "global_ayah_id": 6156,
    "translation": "تو ہم اسے «<a href=9> آسان </a>» راہ پر چلنے کی سہولت دینگے"
  },
  {
    "surah_id": 92,
    "ayah_number": 8,
    "global_ayah_id": 6157,
    "translation": "اور جس نے کنجوسی کی اور  ( اللہ سے )  بے پر واہ بنارہا"
  },
  {
    "surah_id": 92,
    "ayah_number": 9,
    "global_ayah_id": 6158,
    "translation": "اور بھلائی کو جھٹلایا"
  },
  {
    "surah_id": 92,
    "ayah_number": 10,
    "global_ayah_id": 6159,
    "translation": "توہم اسے «<a href=205> تنگی </a>» کی راہ پر چلنے کی سہولت دینگے"
  },
  {
    "surah_id": 92,
    "ayah_number": 11,
    "global_ayah_id": 6160,
    "translation": "اور جب وہ  ( جہنم کے )  گڑھے میں گرے گاتواس کا «<a href=563> مال </a>» اس کے کسی «<a href=481> کام </a>» نہ آئیگا"
  },
  {
    "surah_id": 92,
    "ayah_number": 12,
    "global_ayah_id": 6161,
    "translation": "بلاشبہ راہ دکھلاناہمارے ذمے ہے"
  },
  {
    "surah_id": 92,
    "ayah_number": 13,
    "global_ayah_id": 6162,
    "translation": "اورآخرت اور دنیاکے «<a href=564> مالک </a>» ہم ہی ہیں"
  },
  {
    "surah_id": 92,
    "ayah_number": 14,
    "global_ayah_id": 6163,
    "translation": "پس لوگو!میں نے تمہیں بھڑتی «<a href=12> آگ </a>» سے ڈرادیا ہے"
  },
  {
    "surah_id": 92,
    "ayah_number": 15,
    "global_ayah_id": 6164,
    "translation": "اس میں وہی گرے گاجو بڑابدبخت ہوگا"
  },
  {
    "surah_id": 92,
    "ayah_number": 16,
    "global_ayah_id": 6165,
    "translation": "جس نے جھٹلایا اور «<a href=597> منہ </a>» پھیرا"
  },
  {
    "surah_id": 92,
    "ayah_number": 17,
    "global_ayah_id": 6166,
    "translation": "اور جو بڑا پرہیزگار ہوگااسے اس سے دوررکھاجائے گا"
  },
  {
    "surah_id": 92,
    "ayah_number": 18,
    "global_ayah_id": 6167,
    "translation": "جوشخص اپنامال  ( اللہ کی راہ میں  )  دیتا ہے تاکہ اپنے نفس کو «<a href=142> پاک </a>» کرے"
  },
  {
    "surah_id": 92,
    "ayah_number": 19,
    "global_ayah_id": 6168,
    "translation": "اس پر کسی کاکوئی «<a href=33> احسان </a>» نہ تھاجس کاوہ «<a href=95> بدلہ </a>» چکاتا"
  },
  {
    "surah_id": 92,
    "ayah_number": 20,
    "global_ayah_id": 6169,
    "translation": "بلکہ اس نے تومحض اپنے رب «<a href=101> بزرگ </a>» وبلندکی رضاکے لئے  ( «<a href=563> مال </a>» «<a href=298> خرچ </a>» کیا  )"
  },
  {
    "surah_id": 92,
    "ayah_number": 21,
    "global_ayah_id": 6170,
    "translation": "اور جلدہی وہ  ( آدمی «<a href=237> جنت </a>» میں اللہ کی نعمتوں کو دیکھ کر )  «<a href=308> خوش </a>» ہوجائے گا"
  }
]