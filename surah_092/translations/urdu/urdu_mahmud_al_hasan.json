[
  {
    "surah_id": 92,
    "ayah_number": 0,
    "global_ayah_id": 6149,
    "translation": "اللہ کے نام سے جو رحمان و رحیم ہے"
  },
  {
    "surah_id": 92,
    "ayah_number": 1,
    "global_ayah_id": 6150,
    "translation": "قسم رات کی جب چھا جائے"
  },
  {
    "surah_id": 92,
    "ayah_number": 2,
    "global_ayah_id": 6151,
    "translation": "اور دن کی جب روشن ہو"
  },
  {
    "surah_id": 92,
    "ayah_number": 3,
    "global_ayah_id": 6152,
    "translation": "اور اُسکی جو اُس نے پیدا کئے نر اور مادہ"
  },
  {
    "surah_id": 92,
    "ayah_number": 4,
    "global_ayah_id": 6153,
    "translation": "تمہاری کمائی طرح طرح پر ہے"
  },
  {
    "surah_id": 92,
    "ayah_number": 5,
    "global_ayah_id": 6154,
    "translation": "سو جس نے دیا اور ڈرتا رہا"
  },
  {
    "surah_id": 92,
    "ayah_number": 6,
    "global_ayah_id": 6155,
    "translation": "اور سچ جانا بھلی بات کو"
  },
  {
    "surah_id": 92,
    "ayah_number": 7,
    "global_ayah_id": 6156,
    "translation": "تو اُسکو ہم سہج سہج پہنچا دیں گے آسانی میں"
  },
  {
    "surah_id": 92,
    "ayah_number": 8,
    "global_ayah_id": 6157,
    "translation": "اور جس نے نہ دیا اور بے پروا رہا"
  },
  {
    "surah_id": 92,
    "ayah_number": 9,
    "global_ayah_id": 6158,
    "translation": "اور جھوٹ جانا بھلی بات کو"
  },
  {
    "surah_id": 92,
    "ayah_number": 10,
    "global_ayah_id": 6159,
    "translation": "سو اُسکو ہم سہج سہج پہنچا دیں گے سختی میں"
  },
  {
    "surah_id": 92,
    "ayah_number": 11,
    "global_ayah_id": 6160,
    "translation": "اور کام نہ آئے گا اُسکے مال اُس کا جب گڑھے میں گرے گا"
  },
  {
    "surah_id": 92,
    "ayah_number": 12,
    "global_ayah_id": 6161,
    "translation": "ہمارا ذمہ ہے راہ سجھا دینا"
  },
  {
    "surah_id": 92,
    "ayah_number": 13,
    "global_ayah_id": 6162,
    "translation": "اور ہمارے ہاتھ میں ہے آخرت اور دنیا"
  },
  {
    "surah_id": 92,
    "ayah_number": 14,
    "global_ayah_id": 6163,
    "translation": "سو میں نے سنا دی تم کو خبر ایک بھڑکتی ہوئی آگ کی"
  },
  {
    "surah_id": 92,
    "ayah_number": 15,
    "global_ayah_id": 6164,
    "translation": "اُس میں وہی گرے گا جو بڑا بدبخت ہے"
  },
  {
    "surah_id": 92,
    "ayah_number": 16,
    "global_ayah_id": 6165,
    "translation": "جس نے جھٹلایا اور منہ پھیرا"
  },
  {
    "surah_id": 92,
    "ayah_number": 17,
    "global_ayah_id": 6166,
    "translation": "اور بچا دیں گے اُس سے بڑے ڈرنے والے کو"
  },
  {
    "surah_id": 92,
    "ayah_number": 18,
    "global_ayah_id": 6167,
    "translation": "جو دیتا ہے اپنا مال دل پاک کرنے کو"
  },
  {
    "surah_id": 92,
    "ayah_number": 19,
    "global_ayah_id": 6168,
    "translation": "اور نہیں کسی کا اُس پر احسان جس کا بدلا دے"
  },
  {
    "surah_id": 92,
    "ayah_number": 20,
    "global_ayah_id": 6169,
    "translation": "مگر واسطے چاہنے مرضی اپنے رب کی جو سب سے برتر ہے"
  },
  {
    "surah_id": 92,
    "ayah_number": 21,
    "global_ayah_id": 6170,
    "translation": "اور آگے وہ راضی ہو گا"
  }
]