[
  {
    "surah_id": 92,
    "ayah_number": 1,
    "global_ayah_id": 6059,
    "translation": "Клянусь спустившимся покровом ночи,"
  },
  {
    "surah_id": 92,
    "ayah_number": 2,
    "global_ayah_id": 6060,
    "translation": "И красотой проснувшегося дня,"
  },
  {
    "surah_id": 92,
    "ayah_number": 3,
    "global_ayah_id": 6061,
    "translation": "И тайною созданья двух полов, -"
  },
  {
    "surah_id": 92,
    "ayah_number": 4,
    "global_ayah_id": 6062,
    "translation": "Поистине, различны ваши устремленья!"
  },
  {
    "surah_id": 92,
    "ayah_number": 5,
    "global_ayah_id": 6063,
    "translation": "И для того, кто щедростью дарит, и почитает Бога,"
  },
  {
    "surah_id": 92,
    "ayah_number": 6,
    "global_ayah_id": 6064,
    "translation": "И принял (Откровение Его),"
  },
  {
    "surah_id": 92,
    "ayah_number": 7,
    "global_ayah_id": 6065,
    "translation": "Разгладим путь Мы к (вечному) блаженству."
  },
  {
    "surah_id": 92,
    "ayah_number": 8,
    "global_ayah_id": 6066,
    "translation": "Но тот, кто скуп и думает, что он всевластен,"
  },
  {
    "surah_id": 92,
    "ayah_number": 9,
    "global_ayah_id": 6067,
    "translation": "И отвергает (Откровения Его), -"
  },
  {
    "surah_id": 92,
    "ayah_number": 10,
    "global_ayah_id": 6068,
    "translation": "Мы для него разгладим путь для (вечного) страданья;"
  },
  {
    "surah_id": 92,
    "ayah_number": 11,
    "global_ayah_id": 6069,
    "translation": "И вот когда он будет брошен в Ров, Ему добро накопленное не поможет."
  },
  {
    "surah_id": 92,
    "ayah_number": 12,
    "global_ayah_id": 6070,
    "translation": "Поистине, Мы направляем все земное,"
  },
  {
    "surah_id": 92,
    "ayah_number": 13,
    "global_ayah_id": 6071,
    "translation": "И Нам принадлежит Начало и конец (сей жизненной стези)."
  },
  {
    "surah_id": 92,
    "ayah_number": 14,
    "global_ayah_id": 6072,
    "translation": "Предостерег Я вас об адовом огне,"
  },
  {
    "surah_id": 92,
    "ayah_number": 15,
    "global_ayah_id": 6073,
    "translation": "В кой будут брошены лишь жалкие невежды,"
  },
  {
    "surah_id": 92,
    "ayah_number": 16,
    "global_ayah_id": 6074,
    "translation": "Кто к Истине великой глух И воротит к ней спину."
  },
  {
    "surah_id": 92,
    "ayah_number": 17,
    "global_ayah_id": 6075,
    "translation": "Но кто страшился гнева Бога, Избавлен будет от Огня (навечно),"
  },
  {
    "surah_id": 92,
    "ayah_number": 18,
    "global_ayah_id": 6076,
    "translation": "А кто расходует свое добро на самоочищенье"
  },
  {
    "surah_id": 92,
    "ayah_number": 19,
    "global_ayah_id": 6077,
    "translation": "И не для почестей благодеяет,"
  },
  {
    "surah_id": 92,
    "ayah_number": 20,
    "global_ayah_id": 6078,
    "translation": "А из желанья зрить Господень лик,"
  },
  {
    "surah_id": 92,
    "ayah_number": 21,
    "global_ayah_id": 6079,
    "translation": "Сполна познает Его щедрость."
  }
]