[
  {
    "surah_id": 92,
    "ayah_number": 1,
    "global_ayah_id": 6059,
    "translation": "በሌሊቱ እምላለሁ (በጨለማው) በሚሸፍን ጊዜ፡፡"
  },
  {
    "surah_id": 92,
    "ayah_number": 2,
    "global_ayah_id": 6060,
    "translation": "በቀኑም፤ በተገለጸ ጊዜ፡፡"
  },
  {
    "surah_id": 92,
    "ayah_number": 3,
    "global_ayah_id": 6061,
    "translation": "ወንድንና ሴትን በፈጠረውም (አምላክ እምላለሁ)፡፡"
  },
  {
    "surah_id": 92,
    "ayah_number": 4,
    "global_ayah_id": 6062,
    "translation": "ሥራችሁ በእርግጥ የተለያየ ነው፡፡"
  },
  {
    "surah_id": 92,
    "ayah_number": 5,
    "global_ayah_id": 6063,
    "translation": "የሰጠ ሰውማ ጌታውን የፈራም፡፡"
  },
  {
    "surah_id": 92,
    "ayah_number": 6,
    "global_ayah_id": 6064,
    "translation": "በመልካሚቱም (እምነት) ያረጋገጠ፤"
  },
  {
    "surah_id": 92,
    "ayah_number": 7,
    "global_ayah_id": 6065,
    "translation": "ለገሪቱ ሥራ እናዘጋጀዋለን፡፡"
  },
  {
    "surah_id": 92,
    "ayah_number": 8,
    "global_ayah_id": 6066,
    "translation": "የሰሰተ ሰውማ የተብቃቃም፤ (በራሱ የተመካ)፤"
  },
  {
    "surah_id": 92,
    "ayah_number": 9,
    "global_ayah_id": 6067,
    "translation": "በመልካሚቱ (እምነት) ያሰተባበለም፤"
  },
  {
    "surah_id": 92,
    "ayah_number": 10,
    "global_ayah_id": 6068,
    "translation": "ለክፉይቱ ሥራ እናዘጋጀዋለን፡፡"
  },
  {
    "surah_id": 92,
    "ayah_number": 11,
    "global_ayah_id": 6069,
    "translation": "በወደቀም ጊዜ ገንዘቡ ከእርሱ ምንም አይጠቅመውም፡፡"
  },
  {
    "surah_id": 92,
    "ayah_number": 12,
    "global_ayah_id": 6070,
    "translation": "ቅኑን መንገድ መግለጽ በእኛ ላይ አለብን፡፡"
  },
  {
    "surah_id": 92,
    "ayah_number": 13,
    "global_ayah_id": 6071,
    "translation": "መጨረሻይቱም መጀመሪያይቱም ዓለም የእኛ ናቸው፡፡"
  },
  {
    "surah_id": 92,
    "ayah_number": 14,
    "global_ayah_id": 6072,
    "translation": "የምትንቀለቀልንም እሳት አስጠነቀቅኳችሁ (በላቸው)፡፡"
  },
  {
    "surah_id": 92,
    "ayah_number": 15,
    "global_ayah_id": 6073,
    "translation": "ከጠማማ በቀር ሌላ የማይገባት የኾነችን፡፡"
  },
  {
    "surah_id": 92,
    "ayah_number": 16,
    "global_ayah_id": 6074,
    "translation": "ያ ያስተባበለና ከትዕዛዝ የሸሸው፡፡"
  },
  {
    "surah_id": 92,
    "ayah_number": 17,
    "global_ayah_id": 6075,
    "translation": "አላህን በጣም ፈሪውም በእርግጥ ይርቃታል፡፡"
  },
  {
    "surah_id": 92,
    "ayah_number": 18,
    "global_ayah_id": 6076,
    "translation": "ያ የሚጥራራ ኾኖ ገንዘቡን (ለድኾች) የሚሰጠው፡፡"
  },
  {
    "surah_id": 92,
    "ayah_number": 19,
    "global_ayah_id": 6077,
    "translation": "ለአንድም ሰው እርሱ ዘንድ የምትመለስ ውለታ የለችም፡፡"
  },
  {
    "surah_id": 92,
    "ayah_number": 20,
    "global_ayah_id": 6078,
    "translation": "ግን የታላቅ ጌታውን ውዴታ ለመፈለግ (ይህንን ሠራ)፡፡"
  },
  {
    "surah_id": 92,
    "ayah_number": 21,
    "global_ayah_id": 6079,
    "translation": "ወደፊትም በእርግጥ ይደሰታል፡፡"
  }
]