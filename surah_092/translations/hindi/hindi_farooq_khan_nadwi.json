[
  {
    "surah_id": 92,
    "ayah_number": 1,
    "global_ayah_id": 6059,
    "translation": "रात की क़सम जब (सूरज को) छिपा ले"
  },
  {
    "surah_id": 92,
    "ayah_number": 2,
    "global_ayah_id": 6060,
    "translation": "और दिन की क़सम जब ख़ूब रौशन हो"
  },
  {
    "surah_id": 92,
    "ayah_number": 3,
    "global_ayah_id": 6061,
    "translation": "और उस (ज़ात) की जिसने नर व मादा को पैदा किया"
  },
  {
    "surah_id": 92,
    "ayah_number": 4,
    "global_ayah_id": 6062,
    "translation": "कि बेशक तुम्हारी कोशिश तरह तरह की है"
  },
  {
    "surah_id": 92,
    "ayah_number": 5,
    "global_ayah_id": 6063,
    "translation": "तो जिसने सख़ावत की और अच्छी बात (इस्लाम) की तस्दीक़ की"
  },
  {
    "surah_id": 92,
    "ayah_number": 6,
    "global_ayah_id": 6064,
    "translation": "तो हम उसके लिए राहत व आसानी"
  },
  {
    "surah_id": 92,
    "ayah_number": 7,
    "global_ayah_id": 6065,
    "translation": "(जन्नत) के असबाब मुहय्या कर देंगे"
  },
  {
    "surah_id": 92,
    "ayah_number": 8,
    "global_ayah_id": 6066,
    "translation": "और जिसने बुख्ल किया, और बेपरवाई की"
  },
  {
    "surah_id": 92,
    "ayah_number": 9,
    "global_ayah_id": 6067,
    "translation": "और अच्छी बात को झुठलाया"
  },
  {
    "surah_id": 92,
    "ayah_number": 10,
    "global_ayah_id": 6068,
    "translation": "तो हम उसे सख्ती (जहन्नुम) में पहुँचा देंगे,"
  },
  {
    "surah_id": 92,
    "ayah_number": 11,
    "global_ayah_id": 6069,
    "translation": "और जब वह हलाक होगा तो उसका माल उसके कुछ भी काम न आएगा"
  },
  {
    "surah_id": 92,
    "ayah_number": 12,
    "global_ayah_id": 6070,
    "translation": "हमें राह दिखा देना ज़रूर है"
  },
  {
    "surah_id": 92,
    "ayah_number": 13,
    "global_ayah_id": 6071,
    "translation": "और आख़ेरत और दुनिया (दोनों) ख़ास हमारी चीज़े हैं"
  },
  {
    "surah_id": 92,
    "ayah_number": 14,
    "global_ayah_id": 6072,
    "translation": "तो हमने तुम्हें भड़कती हुई आग से डरा दिया"
  },
  {
    "surah_id": 92,
    "ayah_number": 15,
    "global_ayah_id": 6073,
    "translation": "उसमें बस वही दाख़िल होगा जो बड़ा बदबख्त है"
  },
  {
    "surah_id": 92,
    "ayah_number": 16,
    "global_ayah_id": 6074,
    "translation": "जिसने झुठलाया और मुँह फेर लिया और जो बड़ा परहेज़गार है"
  },
  {
    "surah_id": 92,
    "ayah_number": 17,
    "global_ayah_id": 6075,
    "translation": "वह उससे बचा लिया जाएगा"
  },
  {
    "surah_id": 92,
    "ayah_number": 18,
    "global_ayah_id": 6076,
    "translation": "जो अपना माल (ख़ुदा की राह) में देता है ताकि पाक हो जाए"
  },
  {
    "surah_id": 92,
    "ayah_number": 19,
    "global_ayah_id": 6077,
    "translation": "और लुत्फ ये है कि किसी का उस पर कोई एहसान नहीं जिसका उसे बदला दिया जाता है"
  },
  {
    "surah_id": 92,
    "ayah_number": 20,
    "global_ayah_id": 6078,
    "translation": "बल्कि (वह तो) सिर्फ अपने आलीशान परवरदिगार की ख़ुशनूदी हासिल करने के लिए (देता है)"
  },
  {
    "surah_id": 92,
    "ayah_number": 21,
    "global_ayah_id": 6079,
    "translation": "और वह अनक़रीब भी ख़ुश हो जाएगा"
  }
]